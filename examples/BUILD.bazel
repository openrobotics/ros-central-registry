load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rosidl_core_generators//:defs.bzl", "core_generators")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

## Messages

core_generators(
    deps = [
        "//msg:ExampleMessage",
    ],
)

## Tests

C_DEPENDENCIES = {
    "@rclc//:rclc": "@rclc//:rclc_library",
    ":cc_shared": ":cc",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_c",
    dynamic_deps = C_DEPENDENCIES.keys(),
)

cc_binary(
    name = "example_ros_publisher_c",
    srcs = ["src/example_ros_publisher.c"],
    dynamic_deps = [":transitive_dynamic_deps_c"],
    deps = C_DEPENDENCIES.values(),
)

cc_binary(
    name = "example_ros_subscriber_c",
    srcs = ["src/example_ros_subscriber.c"],
    dynamic_deps = [":transitive_dynamic_deps_c"],
    deps = C_DEPENDENCIES.values(),
)

CPP_DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    ":c_shared": ":c",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_cc",
    dynamic_deps = CPP_DEPENDENCIES.keys(),
)

cc_binary(
    name = "example_ros_publisher_cc",
    srcs = ["src/example_ros_publisher.cc"],
    dynamic_deps = [":transitive_dynamic_deps_cc"],
    deps = CPP_DEPENDENCIES.values(),
)

cc_binary(
    name = "example_ros_subscriber_cc",
    srcs = ["src/example_ros_subscriber.cc"],
    dynamic_deps = [":transitive_dynamic_deps_cc"],
    deps = CPP_DEPENDENCIES.values(),
)

py_binary(
    name = "example_ros_publisher_py",
    srcs = ["src/example_ros_publisher.py"],
    main = "src/example_ros_publisher.py",
    deps = [
        ":py",
        "@rclpy",
    ],
)

py_binary(
    name = "example_ros_subscriber_py",
    srcs = ["src/example_ros_subscriber.py"],
    main = "src/example_ros_subscriber.py",
    deps = [
        ":py",
        "@rclpy",
    ],
)

PROTO_DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    ":proto_shared": ":proto",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_proto",
    dynamic_deps = PROTO_DEPENDENCIES.keys(),
)

cc_binary(
    name = "example_proto_publisher_cc",
    srcs = ["src/example_proto_publisher.cc"],
    dynamic_deps = [":transitive_dynamic_deps_proto"],
    deps = PROTO_DEPENDENCIES.values(),
)

cc_binary(
    name = "example_proto_subscriber_cc",
    srcs = ["src/example_proto_subscriber.cc"],
    dynamic_deps = [":transitive_dynamic_deps_proto"],
    deps = PROTO_DEPENDENCIES.values(),
)
