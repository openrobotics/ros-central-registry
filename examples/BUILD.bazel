# Python examples - please note  you must use the py_library, py_binary,
# py_test etc. rules from rules_aspect_py and not rules_python. This is
# because we use namespaced packages and a sitecustomize to route imports
# to the correct package, which is not supported by rules_python.

py_ros_library(
    name = "example_ros_py_msgs",
    deps = ["//msg:ExampleMessage"],
)

py_binary(
    name = "example_ros_publisher_py",
    srcs = ["src/example_ros_publisher.py"],
    main = "src/example_ros_publisher.py",
    deps = [
        ":example_ros_py_msgs",
        "@rclpy",
    ],
)

py_binary(
    name = "example_ros_subscriber_py",
    srcs = ["src/example_ros_subscriber.py"],
    main = "src/example_ros_subscriber.py",
    deps = [
        ":example_ros_py_msgs",
        "@rclpy",
    ],
)

# Protobuf pipeline example - the "cc_proto_ros_library" is a special
# rule that provides a ProtoInfo, CcInfo and DefaultInfo. The ProtoInfo
# allows you to list the target in the deps of other proto rules (eg.
# py_proto_library) to use ROS messages in a protocol buffer context.
# The CcInfo provides ROS and Protobuf C++ bindings, and a typeadapter
# that enables you to send protocol buffer messages directly through
# ROS; under the hood it takes care of conversion for you. The last
# DefaultInfo provider are the typesupport shared objects that need to
# be present in the runfiles in order for ROS typesupport.

PROTO_DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_proto",
    dynamic_deps = PROTO_DEPENDENCIES.keys(),
)

cc_proto_ros_library(
    name = "example_cc_proto",
    deps = ["//msg:ExampleMessage"],
)

cc_binary(
    name = "example_proto_publisher_cc",
    srcs = ["src/example_proto_publisher.cc"],
    dynamic_deps = select({
        ":dynamic_mode_off": [],
        ":rmw_dynamic": [":transitive_dynamic_deps_proto"],
        "//conditions:default": [],
    }),
    deps = PROTO_DEPENDENCIES.values() + [
        ":example_cc_proto",
    ],
)

cc_binary(
    name = "example_proto_subscriber_cc",
    srcs = ["src/example_proto_subscriber.cc"],
    dynamic_deps = select({
        ":dynamic_mode_off": [],
        ":rmw_dynamic": [":transitive_dynamic_deps_proto"],
        "//conditions:default": [],
    }),
    deps = PROTO_DEPENDENCIES.values() + [
        ":example_cc_proto",
    ],
)
