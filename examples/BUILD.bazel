load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rosidl_core_generators//:defs.bzl", "c_ros_library", "cc_proto_ros_library", "cc_ros_library", "py_ros_library")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

config_setting(
    name = "dynamic_mode_off",
    values = {
        "dynamic_mode": "off",
    },
)

config_setting(
    name = "rmw_dynamic",
    flag_values = {"@rosdistro//:rmw": "dynamic"},
)

# C examples - the more traditional pipeline

C_DEPENDENCIES = {
    "@rclc//:rclc": "@rclc//:rclc_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_c",
    dynamic_deps = C_DEPENDENCIES.keys(),
)

c_ros_library(
    name = "example_ros_c_msgs",
    deps = ["//msg:ExampleMessage"],
)

cc_binary(
    name = "example_ros_publisher_c",
    srcs = ["src/example_ros_publisher.c"],
    dynamic_deps = select({
        ":dynamic_mode_off": [],
        ":rmw_dynamic": [":transitive_dynamic_deps_c"],
        "//conditions:default": [],
    }),
    deps = C_DEPENDENCIES.values() + [
        ":example_ros_c_msgs",
    ],
)

cc_binary(
    name = "example_ros_subscriber_c",
    srcs = ["src/example_ros_subscriber.c"],
    dynamic_deps = select({
        ":dynamic_mode_off": [],
        ":rmw_dynamic": [":transitive_dynamic_deps_c"],
        "//conditions:default": [],
    }),
    deps = C_DEPENDENCIES.values() + [
        ":example_ros_c_msgs",
    ],
)

