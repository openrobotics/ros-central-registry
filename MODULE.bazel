# We strongly advise that any project that uses the ROS Central Registry
# declares itself as a module. Even though bazel's naming allows for
# more flexibility you should only use lower-case characters and
# underscores, per REP-0144 (https://ros.org/reps/rep-0144.html).

module(
    name = "rcr",
    version = "0.0.2",
    bazel_compatibility = [">=7.2.1"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_python", version = "2.4.5")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

uv = use_extension("@rules_python//python/uv:uv.bzl", "uv")
uv.configure(version = "0.9.7")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip_ros_central_registry",
    python_version = "3.11",
    requirements_lock = "//:requirements.txt",
    target_platforms = [
        "linux_aarch64",
        "linux_x86_64",
        "osx_aarch64",
        "osx_x86_64",
        "windows_x86_64",
    ],
)
use_repo(pip, "pip_ros_central_registry")
