load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library", "py_test")
load("@pip_ros_central_registry//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

# Shared plumbing for every sweep: BFS scheduling, reporting, MODULE.bazel /
# package.xml helpers, guarded writes and the common command line.
py_library(
    name = "vendor_lib",
    srcs = ["vendor_lib.py"],
    imports = ["../.."],
    deps = [requirement("tqdm")],
)

py_test(
    name = "vendor_lib_test",
    srcs = ["vendor_lib_test.py"],
    deps = [":vendor_lib"],
)

py_library(
    name = "fix_interfaces_lib",
    srcs = ["fix_interfaces.py"],
    imports = ["../.."],
    deps = [":vendor_lib"],
)

py_binary(
    name = "fix_interfaces",
    srcs = ["fix_interfaces.py"],
    deps = [":fix_interfaces_lib"],
)

py_test(
    name = "fix_interfaces_test",
    srcs = ["fix_interfaces_test.py"],
    deps = [":fix_interfaces_lib"],
)

py_library(
    name = "fix_dependencies_lib",
    srcs = ["fix_dependencies.py"],
    imports = ["../.."],
    deps = [":vendor_lib"],
)

py_binary(
    name = "fix_dependencies",
    srcs = ["fix_dependencies.py"],
    deps = [":fix_dependencies_lib"],
)

py_test(
    name = "fix_dependencies_test",
    srcs = ["fix_dependencies_test.py"],
    deps = [":fix_dependencies_lib"],
)
