@@ -34,7 +34,7 @@
 #  support library is itself covered by the above license.
 
 load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
-load("@rules_cc//cc:defs.bzl", "cc_library")
+load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
 load("@rules_license//rules:license.bzl", "license")
 
 package(
@@ -133,3 +133,23 @@
     actual = ":z",
     visibility = ["//visibility:public"],
 )
+
+# zlib as a shared library, for builds that link several cc_shared_library
+# targets into one process. `:z` is a static library without the
+# LINKABLE_MORE_THAN_ONCE tag, so at most one shared library may contain it;
+# depending on this target (via `dynamic_deps`) lets every library share the
+# single exported copy instead of each embedding its own.
+cc_shared_library(
+    name = "zlib_shared",
+    # A root is linked --whole-archive, so the complete zlib API is exported,
+    # not just the parts the first consumer happens to reference.
+    deps = [":z"],
+    # MinGW-style toolchains link dynamic deps with -l<name>, which only
+    # resolves a DLL named lib<name>.dll.
+    shared_lib_name = select({
+        "@platforms//os:windows": "libzlib_shared.dll",
+        "//conditions:default": "",
+    }),
+    win_def_file = "win32/zlib.def",
+    visibility = ["//visibility:public"],
+)
