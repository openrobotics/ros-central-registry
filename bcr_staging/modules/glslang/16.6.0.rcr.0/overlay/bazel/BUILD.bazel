load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:py_binary.bzl", "py_binary")

package(default_applicable_licenses = ["//:license"])

# gen_extension_headers.py, for glslang.bzl's glsl_intrinsic_header.
py_binary(
    name = "gen_extension_headers",
    srcs = ["//:gen_extension_headers.py"],
    main = "//:gen_extension_headers.py",
    tags = ["manual"],
    visibility = ["//:__pkg__"],
)

# //:glslc (see glslc.cpp).
cc_binary(
    name = "glslc",
    srcs = ["glslc.cpp"],
    copts = ["-std=c++17"],
    visibility = ["//:__pkg__"],
    deps = ["//:standalone_main"],
)
