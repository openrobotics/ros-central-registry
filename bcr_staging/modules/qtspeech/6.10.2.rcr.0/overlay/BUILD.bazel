load("@qt//:qt.bzl", "QT_VERSION", "common_defines", "qt_internal_library", "qt_qml_plugin_cpp", "qt_static_plugin", "qt_sync_headers")
load("@qt//:qt_tools.bzl", "qt_write_file")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load(":qtspeech_config.bzl", "declare_qtspeech_config_targets")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:LGPL-3.0-only",
        "@rules_license//licenses/spdx:GPL-2.0-only",
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
    license_text = "LICENSES/LGPL-3.0-only.txt",
)

license(
    name = "license_speechd",
    license_kinds = [
        "@rules_license//licenses/spdx:LGPL-2.1-or-later",
    ],
    license_text = "libspeechd.h",
)

_COMMON_DEFINES = common_defines + [
    "QT_NO_QASCONST=1",
    "QT_NO_CONTEXTLESS_CONNECT=1",
    "QT_NO_FOREACH=1",
]

declare_qtspeech_config_targets()

qt_sync_headers(
    name = "tts_sync_headers",
    srcs = glob([
        "src/tts/*.h",
    ]),
    generated_private_hdrs = [
        ":gen_qttexttospeech_config_p_h",
    ],
    generated_public_hdrs = [
        ":gen_qttexttospeech_config_h",
    ],
    module_name = "QtTextToSpeech",
    version = QT_VERSION,
)

qt_internal_library(
    name = "tts",
    srcs = [
        "src/tts/qtexttospeech.cpp",
        "src/tts/qtexttospeechengine.cpp",
        "src/tts/qtexttospeechplugin.cpp",
        "src/tts/qvoice.cpp",
    ],
    hdrs = glob([
        "src/tts/*.h",
    ]) + [":tts_sync_headers"],
    defines = ["QT_TEXTTOSPEECH_LIB"],
    dynamic_deps = [
        "@qtbase//:concurrent_shared",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:network_shared",
        "@qtmultimedia//:multimedia_shared",
    ] + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@qtbase//:dbus_shared"],
    }),
    includes = ["src/tts"],
    local_defines = _COMMON_DEFINES + ["QTEXTTOSPEECH_LIBRARY"],
    moc_hdrs = [
        "src/tts/qtexttospeech.h",
        "src/tts/qtexttospeechengine.h",
        "src/tts/qvoice.h",
    ],
    moc_unity = True,
    deps = [
        "@qtbase//:core",
        "@qtmultimedia//:multimedia",
    ],
)

qt_sync_headers(
    name = "ttsqml_sync_headers",
    srcs = glob([
        "src/tts/qml/*.h",
    ]),
    module_name = "QtTextToSpeechQml",
    version = QT_VERSION,
)

qt_internal_library(
    name = "ttsqml",
    srcs = [
        "src/tts/qml/qdeclarativetexttospeech.cpp",
        "src/tts/qml/qvoiceselectorattached.cpp",
    ],
    hdrs = glob([
        "src/tts/qml/*.h",
    ]) + [":ttsqml_sync_headers"],
    defines = ["QT_TEXTTOSPEECHQML_LIB"],
    dynamic_deps = [
        ":tts_shared",
        "@qtbase//:concurrent_shared",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:network_shared",
        "@qtdeclarative//:qml_shared",
        "@qtmultimedia//:multimedia_shared",
    ] + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@qtbase//:dbus_shared"],
    }),
    includes = ["src/tts/qml"],
    local_defines = _COMMON_DEFINES + ["QT_BUILD_TEXTTOSPEECHQML_LIB"],
    moc_hdrs = [
        "src/tts/qml/qdeclarativetexttospeech_p.h",
        "src/tts/qml/qtexttospeech_qmltypes_p.h",
        "src/tts/qml/qvoiceselectorattached_p.h",
    ],
    moc_unity = True,
    qml_args = {
        "uri": "QtTextToSpeech",
        "version": "6.10",
        "foreign_types": [
            ":tts_moc_hdrs",
            "@qtbase//:core_moc_hdrs",
            "@qtdeclarative//:qml_moc_hdrs",
        ],
        "qmldir_content": """module QtTextToSpeech
linktarget ttsqmlplugin
plugin ttsqmlplugin
classname QtTextToSpeechPlugin
typeinfo plugins.qmltypes
prefer :/qt-project.org/imports/QtTextToSpeech/
""",
    },
    deps = [
        ":tts",
        "@qtbase//:core",
        "@qtdeclarative//:qml",
    ],
)

qt_qml_plugin_cpp(
    name = "ttsqmlplugin_gen",
    out = "ttsqmlplugin_QtTextToSpeechPlugin.cpp",
    plugin_class_name = "QtTextToSpeechPlugin",
    uri = "QtTextToSpeech",
)

qt_static_plugin(
    name = "ttsqmlplugin",
    srcs = [":ttsqmlplugin_gen"],
    local_defines = _COMMON_DEFINES,
    moc_srcs = [":ttsqmlplugin_gen"],
    plugin_class_name = "QtTextToSpeechPlugin",
    deps = [
        ":tts",
        ":ttsqml",
        "@qtbase//:core",
        "@qtdeclarative//:qml",
    ],
)

qt_static_plugin(
    name = "qtexttospeech_mock",
    srcs = [
        "src/plugins/tts/mock/qtexttospeech_mock.cpp",
        "src/plugins/tts/mock/qtexttospeech_mock_plugin.cpp",
    ],
    hdrs = [
        "src/plugins/tts/mock/qtexttospeech_mock.h",
        "src/plugins/tts/mock/qtexttospeech_mock_plugin.h",
    ],
    includes = ["src/plugins/tts/mock"],
    local_defines = _COMMON_DEFINES,
    moc_hdrs = [
        "src/plugins/tts/mock/qtexttospeech_mock.h",
        "src/plugins/tts/mock/qtexttospeech_mock_plugin.h",
    ],
    plugin_class_name = "QTextToSpeechMockPlugin",
    textual_hdrs = ["src/plugins/tts/mock/mock_plugin.json"],
    deps = [
        ":tts",
        "@qtbase//:core",
    ],
)

qt_static_plugin(
    name = "qtexttospeech_speechd",
    srcs = [
        "qtexttospeech_speechd_symbolloader.cpp",
        "src/plugins/tts/speechdispatcher/qtexttospeech_speechd.cpp",
        "src/plugins/tts/speechdispatcher/qtexttospeech_speechd_plugin.cpp",
    ],
    hdrs = [
        "libspeechd.h",
        "src/plugins/tts/speechdispatcher/qtexttospeech_speechd.h",
        "src/plugins/tts/speechdispatcher/qtexttospeech_speechd_plugin.h",
    ],
    applicable_licenses = [
        ":license",
        ":license_speechd",
    ],
    includes = [
        ".",
        "src/plugins/tts/speechdispatcher",
    ],
    local_defines = _COMMON_DEFINES,
    moc_hdrs = [
        "src/plugins/tts/speechdispatcher/qtexttospeech_speechd.h",
        "src/plugins/tts/speechdispatcher/qtexttospeech_speechd_plugin.h",
    ],
    plugin_class_name = "QTextToSpeechSpeechdPlugin",
    target_compatible_with = ["@platforms//os:linux"],
    textual_hdrs = ["src/plugins/tts/speechdispatcher/speechd_plugin.json"],
    deps = [
        ":tts",
        "@qtbase//:core",
    ],
)

qt_static_plugin(
    name = "qtexttospeech_speechdarwin",
    srcs = [
        "src/plugins/tts/darwin/qtexttospeech_darwin.mm",
        "src/plugins/tts/darwin/qtexttospeech_darwin_plugin.cpp",
    ],
    hdrs = [
        "src/plugins/tts/darwin/qtexttospeech_darwin.h",
        "src/plugins/tts/darwin/qtexttospeech_darwin_plugin.h",
    ],
    includes = ["src/plugins/tts/darwin"],
    linkopts = [
        "-framework",
        "AVFoundation",
        "-framework",
        "Foundation",
    ],
    local_defines = _COMMON_DEFINES,
    moc_hdrs = [
        "src/plugins/tts/darwin/qtexttospeech_darwin.h",
        "src/plugins/tts/darwin/qtexttospeech_darwin_plugin.h",
    ],
    plugin_class_name = "QTextToSpeechDarwinPlugin",
    target_compatible_with = ["@platforms//os:macos"],
    textual_hdrs = ["src/plugins/tts/darwin/darwin_plugin.json"],
    deps = [
        ":tts",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtmultimedia//:multimedia",
    ],
)

# SAPI CLSIDs/IIDs are not in MinGW's libsapi/libuuid; compile sapi.h under
# <initguid.h> to emit the definitions.
qt_write_file(
    name = "sapi_win_guids_src",
    out = "generated_win_hdrs/sapi_win_guids.cpp",
    content = """\
#include <windows.h>
#include <initguid.h>
#include <sapi.h>
""",
)

qt_static_plugin(
    name = "qtexttospeech_sapi",
    srcs = [
        "src/plugins/tts/sapi/qtexttospeech_sapi.cpp",
        "src/plugins/tts/sapi/qtexttospeech_sapi_plugin.cpp",
        ":sapi_win_guids_src",
    ],
    hdrs = [
        "src/plugins/tts/sapi/qtexttospeech_sapi.h",
        "src/plugins/tts/sapi/qtexttospeech_sapi_plugin.h",
    ],
    # CLSID_SpVoice-style constant defined but unused by upstream.
    copts = ["-Wno-unused-const-variable"],
    includes = ["src/plugins/tts/sapi"],
    # No -lsapi: sapi.dll only exports COM registration entry points (and
    # MinGW ships sapi.def for x86_64 only). SAPI objects are created through
    # CoCreateInstance (ole32) with the GUIDs from :sapi_win_guids_src.
    linkopts = [
        "-lole32",
        "-luuid",
    ],
    local_defines = _COMMON_DEFINES,
    moc_hdrs = [
        "src/plugins/tts/sapi/qtexttospeech_sapi.h",
        "src/plugins/tts/sapi/qtexttospeech_sapi_plugin.h",
    ],
    plugin_class_name = "QTextToSpeechSapiPlugin",
    target_compatible_with = ["@platforms//os:windows"],
    textual_hdrs = ["src/plugins/tts/sapi/sapi_plugin.json"],
    deps = [
        ":tts",
        "@qtbase//:core",
        "@qtmultimedia//:multimedia",
    ],
)

cc_library(
    name = "tts_plugins",
    deps = [
        ":qtexttospeech_mock",
    ] + select({
        "@platforms//os:linux": [":qtexttospeech_speechd"],
        "@platforms//os:macos": [":qtexttospeech_speechdarwin"],
        "@platforms//os:windows": [":qtexttospeech_sapi"],
        "//conditions:default": [],
    }),
)
