glog >= 0.7 makes google::GLOG_INFO a LogSeverity enum rather than an int, so
std::min(int, LogSeverity) no longer deduces a single type. The ROS Central
Registry pins glog 0.7.1 (with a compatibility shim for
glog_internal_namespace_::IsGoogleLoggingInitialized, see its staged module).

--- a/c10/util/Logging.cpp
+++ b/c10/util/Logging.cpp
@@ -452,7 +452,7 @@
 
 void ShowLogInfoToStderr() {
   FLAGS_logtostderr = 1;
-  FLAGS_minloglevel = std::min(FLAGS_minloglevel, google::GLOG_INFO);
+  FLAGS_minloglevel = std::min<int>(FLAGS_minloglevel, google::GLOG_INFO);
 }
 } // namespace c10
 
