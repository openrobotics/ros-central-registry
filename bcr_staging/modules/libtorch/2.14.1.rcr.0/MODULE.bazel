module(
    name = "libtorch",
    version = "2.14.1.rcr.0",
    bazel_compatibility = [">=9.0.0"],
    compatibility_level = 2,
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "cpp-httplib", version = "0.50.1.rcr.0")
bazel_dep(name = "cpuinfo", version = "0.0.0-20260312-7607ca5")
bazel_dep(name = "cutlass", version = "4.6.1.rcr.0")
bazel_dep(name = "fbgemm", version = "0.0.0-20260514-bf6dce3.rcr.0")
bazel_dep(name = "flatbuffers", version = "25.12.19.bcr.1")
bazel_dep(name = "fmt", version = "12.2.0.bcr.1.rcr.0")
bazel_dep(name = "gflags", version = "2.3.1")
bazel_dep(name = "glog", version = "0.7.1.bcr.1.rcr.0")
bazel_dep(name = "gloo", version = "0.0.0-20260610-74cc005.rcr.0")
bazel_dep(name = "glslang", version = "16.6.0.rcr.0")
bazel_dep(name = "hip-stub", version = "7.14.1.rcr.0")
bazel_dep(name = "ittapi", version = "3.26.3.rcr.0")
bazel_dep(name = "kineto", version = "0.0.0-20260805-15f4784.rcr.0")
bazel_dep(name = "level-zero", version = "1.35.0.rcr.0")
bazel_dep(name = "llvm", version = "0.8.25.rcr.0")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "pocketfft", version = "0.0.2.bcr.1")
bazel_dep(name = "rocm-libraries-stub", version = "7.14.1.rcr.0")
bazel_dep(name = "rules_cc", version = "0.2.26.rcr.0")
bazel_dep(name = "rules_cuda", version = "0.3.0.rcr.0")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_python", version = "1.8.5")
bazel_dep(name = "sleef", version = "3.8.0.rcr.0")
bazel_dep(name = "sycl-stub", version = "7.2.0.rcr.0")
bazel_dep(name = "volk", version = "1.4.341.0.rcr.0")
bazel_dep(name = "vulkan-memory-allocator", version = "3.3.0.rcr.0")

# The CUDA toolkit (@cuda), as configured by the root module's
# cuda.redist_json()/cuda.toolkit() (see README.md).
cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
use_repo(cuda, "cuda")

# Hermetic Python for the build-time code generators (torchgen and
# tools/setup_helpers/generate_code.py), which run on the exec platform.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")

# Their only third-party dependencies, both pure Python.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "pyyaml",
    build_file = "//bazel:pyyaml.BUILD.bazel",
    integrity = "sha256-k3fDgaw/zK2N9z2WtROe+LGixXoNkT6VqwoiddZrXKo=",
    strip_prefix = "pyyaml-6.0.2",
    urls = ["https://github.com/yaml/pyyaml/archive/refs/tags/6.0.2.tar.gz"],
)

http_archive(
    name = "typing_extensions",
    build_file = "//bazel:typing_extensions.BUILD.bazel",
    integrity = "sha256-v29Ws22LyRVuUY6xzDehRihAgvpTUiAz93Ku++z9Ffw=",
    strip_prefix = "typing_extensions-4.12.2",
    urls = ["https://github.com/python/typing_extensions/archive/refs/tags/4.12.2.tar.gz"],
)
