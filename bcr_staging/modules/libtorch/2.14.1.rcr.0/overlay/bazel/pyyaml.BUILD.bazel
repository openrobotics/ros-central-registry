load("@rules_python//python:py_library.bzl", "py_library")

# Pure-Python PyYAML (without the optional libyaml C extension), used by the
# torchgen code generators at build time.
py_library(
    name = "pyyaml",
    srcs = glob(["lib/yaml/*.py"]),
    imports = ["lib"],
    visibility = ["//visibility:public"],
)
