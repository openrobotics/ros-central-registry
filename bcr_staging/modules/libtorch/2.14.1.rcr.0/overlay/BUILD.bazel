# Force-included into c10_hip's and torch_hip's sources (see there).
cc_library(
    name = "hip_compat",
    hdrs = ["rocm/libtorch_hip_compat.h"],
    includes = ["rocm"],
    target_compatible_with = _ROCM_COMPATIBLE,
