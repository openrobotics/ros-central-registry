    ],
    # c10/xpu/impl/XPUGuardImpl.cpp registers the device guard at static
    # initialization (C10_REGISTER_GUARD_IMPL).
    alwayslink = True,
)

cc_library(
    name = "torch_xpu",
    # ATen's XPU runtime (xpu_cpp) and Caffe2_XPU_SRCS's AOTInductor sources.
    srcs = glob([
        "aten/src/ATen/xpu/*.cpp",
        "aten/src/ATen/xpu/detail/*.cpp",
    ]) + [
        "torch/csrc/inductor/aoti_runner/model_container_runner_xpu.cpp",
        "torch/csrc/inductor/aoti_torch/shim_xpu.cpp",
    ],
    copts = LIBTORCH_COPTS,
    local_defines = TORCH_CPU_LOCAL_DEFINES + _XPU_DEFINES + ["TORCH_XPU_BUILD_MAIN_LIB"],
    target_compatible_with = _XPU_COMPATIBLE,
    visibility = ["//visibility:public"],
    deps = [
        ":c10_xpu",
        ":torch_cpu",
        # <level_zero/ze_api.h> (ATen/xpu/level_zero_stub); the Level Zero
        # loader is loaded at runtime (ATen/xpu/detail/LazyLevelZero.cpp).
        "@level-zero//:headers",
        "@sycl-stub//:sycl",
    ],
    # XPUHooks registers itself at static initialization (REGISTER_XPU_HOOKS).
    alwayslink = True,
)

# libtorch: torch_cpu, plus the GPU backend that --@libtorch//:gpu selects.
cc_library(
    name = "torch",
    visibility = ["//visibility:public"],
    deps = [":torch_cpu"] + select({
        ":cuda_enabled": [":torch_cuda"],
        ":rocm_enabled": [":torch_hip"],
        ":xpu_enabled": [":torch_xpu"],
        "//conditions:default": [],
    }),
)
