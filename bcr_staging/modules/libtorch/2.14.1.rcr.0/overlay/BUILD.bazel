# at runtime, so binaries start on machines without ROCm).
_ROCM_LIBRARIES = [
    "@hip-stub//:amd_smi_headers",
    "@hip-stub//:amdhip64",
    "@hip-stub//:hiprtc",
    "@hip-stub//:rocm_core_headers",
