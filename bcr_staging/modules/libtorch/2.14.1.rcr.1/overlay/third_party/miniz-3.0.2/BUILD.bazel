# Replaces upstream's third_party/miniz-3.0.2/BUILD.bazel, which uses the
# native cc_library that Bazel 9 removed (so `@libtorch//...` failed to load).
# Same target, plus the load().
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_applicable_licenses = ["//:license"])

cc_library(
    name = "miniz",
    srcs = [
        "miniz.c",
    ],
    hdrs = [
        "miniz.h",
    ],
    # Like upstream's CMake build: torch_cpu provides mz_crc32()
    # (caffe2/serialize/crc.cc).
    local_defines = [
        "MINIZ_DISABLE_ZIP_READER_CRC32_CHECKS",
        "USE_EXTERNAL_MZCRC",
    ],
    strip_include_prefix = ".",
    visibility = ["//visibility:public"],
)
