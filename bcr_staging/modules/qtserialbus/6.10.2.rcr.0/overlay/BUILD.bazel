    includes = ["src/serialbus"],
    local_defines = _COMMON_DEFINES + ["QT_BUILD_SERIALBUS_LIB"],
    moc_hdrs = [
        "src/serialbus/qcanbus.h",
        "src/serialbus/qcanbusdevice.h",
        "src/serialbus/qcanbusframe.h",
        "src/serialbus/qcanframeprocessor.h",
        "src/serialbus/qmodbusclient.h",
        "src/serialbus/qmodbusdevice.h",
        "src/serialbus/qmodbusreply.h",
        "src/serialbus/qmodbusrtuserialclient.h",
        "src/serialbus/qmodbusrtuserialclient_p.h",
        "src/serialbus/qmodbusrtuserialserver.h",
        "src/serialbus/qmodbusserver.h",
        "src/serialbus/qmodbustcpclient.h",
        "src/serialbus/qmodbustcpserver.h",
    ],
    moc_unity = True,
    deps = [
        ":serialbus_cfg",
        "@qtbase//:core",
        "@qtbase//:network",
        "@qtserialport//:serialport",
    ],
)

