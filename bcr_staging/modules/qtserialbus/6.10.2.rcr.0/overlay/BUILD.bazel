    name = "serialbus",
    srcs = [
        "src/serialbus/qcanbus.cpp",
        "src/serialbus/qcanbusdevice.cpp",
        "src/serialbus/qcanbusdeviceinfo.cpp",
        "src/serialbus/qcanbusfactory.cpp",
        "src/serialbus/qcanbusframe.cpp",
        "src/serialbus/qcancommondefinitions.cpp",
        "src/serialbus/qcandbcfileparser.cpp",
        "src/serialbus/qcanframeprocessor.cpp",
