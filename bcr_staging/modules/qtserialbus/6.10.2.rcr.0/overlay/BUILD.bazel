qt_write_file(
    name = "gen_serialbus_exports",
    out = "generated_cfg/include/QtSerialBus/qtserialbusexports.h",
    content = """// Generated by Bazel
#ifndef QTSERIALBUSEXPORTS_H
#define QTSERIALBUSEXPORTS_H

#include <QtCore/qcompilerdetection.h>
#include <QtCore/qtconfigmacros.h>
#include <QtCore/qtdeprecationmarkers.h>

#if defined(QT_SHARED) || !defined(QT_STATIC)
#  if defined(QT_BUILD_SERIALBUS_LIB)
#    define Q_SERIALBUS_EXPORT Q_DECL_EXPORT
#  else
#    define Q_SERIALBUS_EXPORT Q_DECL_IMPORT
#  endif
#else
#  define Q_SERIALBUS_EXPORT
#endif

#define QT_SERIALBUS_REMOVED_SINCE(major, minor) 0

#endif // QTSERIALBUSEXPORTS_H
""",
)

qt_write_file(
    name = "gen_serialbus_config",
    out = "generated_cfg/include/QtSerialBus/qtserialbus-config.h",
    content = """// Generated by Bazel
#ifndef QTSERIALBUS_CONFIG_H
#define QTSERIALBUS_CONFIG_H

#define QT_FEATURE_modbus_serialport 1

#endif // QTSERIALBUS_CONFIG_H
""",
)

qt_write_file(
    name = "gen_serialbus_config_p",
    out = "generated_cfg/include/QtSerialBus/6.10.2/QtSerialBus/private/qtserialbus-config_p.h",
    content = """// Generated by Bazel
#ifndef QTSERIALBUS_CONFIG_P_H
#define QTSERIALBUS_CONFIG_P_H

#ifdef __linux__
#define QT_FEATURE_socketcan 1
#define QT_FEATURE_socketcan_fd 1
#else
#define QT_FEATURE_socketcan -1
#define QT_FEATURE_socketcan_fd -1
#endif

#endif // QTSERIALBUS_CONFIG_P_H
""",
)

cc_library(
    name = "serialbus_cfg",
    hdrs = [
        ":gen_serialbus_config",
        ":gen_serialbus_config_p",
        ":gen_serialbus_exports",
    ],
    includes = [
        "generated_cfg/include",
        "generated_cfg/include/QtSerialBus",
        "generated_cfg/include/QtSerialBus/6.10.2",
        "generated_cfg/include/QtSerialBus/6.10.2/QtSerialBus",
    ],
)

qt_sync_headers(
    name = "serialbus_sync_headers",
    srcs = glob(["src/serialbus/*.h"]),
    dep_modules = [
        "QtCore",
        "QtNetwork",
        "QtSerialPort",
    ],
    module_name = "QtSerialBus",
    source_dir = "src/serialbus",
)

