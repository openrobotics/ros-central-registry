module(
    name = "kineto",
    version = "0.0.0-20260805-15f4784.rcr.0",
    bazel_compatibility = [">=7.2.1"],
    compatibility_level = 1,
)

bazel_dep(name = "fmt", version = "12.2.0.bcr.1.rcr.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.26.rcr.0")
bazel_dep(name = "rules_cuda", version = "0.3.0.rcr.0")
bazel_dep(name = "rules_license", version = "1.0.0")

# The CUDA toolkit (@cuda, for CUPTI), as configured by the root module's
# cuda.redist_json()/cuda.toolkit().
cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
use_repo(cuda, "cuda")
