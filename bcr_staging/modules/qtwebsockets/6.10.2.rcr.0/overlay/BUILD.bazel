load("@qt//:qt.bzl", "common_copts")
load("@qt//:qt_internal_library.bzl", "qt_internal_library", "qt_static_plugin")
load("@qt//:qt_tools.bzl", "qt_qml_plugin_gen", "qt_sync_headers", "qt_write_file")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:LGPL-3.0-only"],
    license_text = "LICENSES/LGPL-3.0-only.txt",
)

exports_files(["MODULE.bazel"])

_COMMON_DEFINES = [
    "QT_ASCII_CAST_WARNINGS",
    "QT_BUILDING_QT",
    "QT_DEPRECATED_WARNINGS",
    "QT_EXPLICIT_QFILE_CONSTRUCTION_FROM_PATH",
    "QT_MOC_COMPAT",
    "QT_NO_CAST_TO_ASCII",
    "QT_NO_CONTEXTLESS_CONNECT=1",
    "QT_NO_DEBUG",
    "QT_NO_EXCEPTIONS",
    "QT_NO_FOREACH=1",
    "QT_NO_JAVA_STYLE_ITERATORS",
    "QT_NO_NARROWING_CONVERSIONS_IN_CONNECT",
    "QT_NO_QASCONST=1",
    "QT_NO_QEXCHANGE",
    "QT_NO_QSNPRINTF",
    "QT_USE_NODISCARD_FILE_OPEN=1",
    "QT_USE_QSTRINGBUILDER",
    "_GLIBCXX_ASSERTIONS",
    "_LARGEFILE64_SOURCE",
    "_LARGEFILE_SOURCE",
]

qt_write_file(
    name = "gen_websockets_exports",
    out = "generated_cfg/include/QtWebSockets/qtwebsocketsexports.h",
    content = """// Generated by Bazel
#ifndef QTWEBSOCKETSEXPORTS_H
#define QTWEBSOCKETSEXPORTS_H

#include <QtCore/qcompilerdetection.h>
#include <QtCore/qtconfigmacros.h>
#include <QtCore/qtdeprecationmarkers.h>

#if defined(QT_SHARED) || !defined(QT_STATIC)
#  if defined(QT_BUILD_WEBSOCKETS_LIB)
#    define Q_WEBSOCKETS_EXPORT Q_DECL_EXPORT
#  else
#    define Q_WEBSOCKETS_EXPORT Q_DECL_IMPORT
#  endif
#else
#  define Q_WEBSOCKETS_EXPORT
#endif

#define QT_WEBSOCKETS_REMOVED_SINCE(major, minor) 0

#endif // QTWEBSOCKETSEXPORTS_H
""",
)

cc_library(
    name = "websockets_cfg",
    hdrs = [":gen_websockets_exports"],
    includes = [
        "generated_cfg/include",
        "generated_cfg/include/QtWebSockets",
    ],
)

qt_sync_headers(
    name = "websockets_sync_headers",
    srcs = glob(["src/websockets/*.h"]),
    dep_modules = [
        "QtCore",
        "QtNetwork",
    ],
    module_name = "QtWebSockets",
    source_dir = "src/websockets",
)

qt_internal_library(
    name = "websockets",
    srcs = [
        "src/websockets/qdefaultmaskgenerator_p.cpp",
        "src/websockets/qmaskgenerator.cpp",
        "src/websockets/qwebsocket.cpp",
        "src/websockets/qwebsocket_p.cpp",
        "src/websockets/qwebsocketcorsauthenticator.cpp",
        "src/websockets/qwebsocketdataprocessor.cpp",
        "src/websockets/qwebsocketframe.cpp",
        "src/websockets/qwebsockethandshakeoptions.cpp",
        "src/websockets/qwebsockethandshakerequest.cpp",
        "src/websockets/qwebsockethandshakeresponse.cpp",
        "src/websockets/qwebsocketprotocol.cpp",
        "src/websockets/qwebsocketserver.cpp",
        "src/websockets/qwebsocketserver_p.cpp",
    ],
    hdrs = glob(["src/websockets/*.h"]) + [":websockets_sync_headers"],
    copts = common_copts + ["-std=gnu++20"],
    create_shared = True,
    defines = ["QT_WEBSOCKETS_LIB"],
    dynamic_deps = [
        "@qtbase//:core_shared",
        "@qtbase//:network_shared",
    ],
    includes = ["src/websockets"],
    local_defines = _COMMON_DEFINES + ["QT_BUILD_WEBSOCKETS_LIB"],
    moc_hdrs = [
        "src/websockets/qwebsocket.h",
        "src/websockets/qwebsocketdataprocessor_p.h",
        "src/websockets/qwebsockethandshakeresponse_p.h",
        "src/websockets/qwebsocketserver.h",
    ],
    moc_unity = True,
    deps = [
        ":websockets_cfg",
        "@qtbase//:core",
        "@qtbase//:network",
    ],
)

alias(
    name = "websocket",
    actual = ":websockets",
)

alias(
    name = "websocket_shared",
    actual = ":websockets_shared",
)

qt_internal_library(
    name = "qmlwebsockets_lib",
    srcs = [
        "src/imports/qmlwebsockets/qqmlwebsocket.cpp",
        "src/imports/qmlwebsockets/qqmlwebsocketserver.cpp",
    ],
    hdrs = glob(["src/imports/qmlwebsockets/*.h"]),
    copts = common_copts + ["-std=gnu++20"],
    create_shared = False,
    includes = ["src/imports/qmlwebsockets"],
    local_defines = _COMMON_DEFINES,
    moc_hdrs = [
        "src/imports/qmlwebsockets/qqmlwebsocket.h",
        "src/imports/qmlwebsockets/qqmlwebsocketserver.h",
    ],
    moc_unity = True,
    qml_args = {
        "foreign_types": [
            "@qtbase//:core_moc_hdrs",
            "@qtdeclarative//:qml_moc_hdrs",
            ":websockets_moc_hdrs",
        ],
        "import_name": "QtWebSockets",
        "past_major_versions": ["1"],
        "qmldir": """module QtWebSockets
linktarget qmlwebsockets
optional plugin qmlwebsockets
classname QtWebSocketsDeclarativeModule
typeinfo plugins.qmltypes
prefer :/qt-project.org/imports/QtWebSockets/
""",
    },
    deps = [
        ":websockets",
        "@qtbase//:core",
        "@qtbase//:network",
        "@qtdeclarative//:qml",
    ],
)

qt_qml_plugin_gen(
    name = "qmlwebsockets_gen",
    class_name = "QtWebSocketsDeclarativeModule",
    plugin_name = "qmlwebsockets",
    uri = "QtWebSockets",
)

qt_static_plugin(
    name = "qmlwebsockets",
    srcs = [":qmlwebsockets_gen"],
    copts = common_copts + ["-std=gnu++20"],
    local_defines = _COMMON_DEFINES + ["QT_PLUGIN"],
    moc_srcs = [":qmlwebsockets_gen"],
    moc_unity = True,
    plugin_class_name = "QtWebSocketsDeclarativeModule",
    deps = [
        ":qmlwebsockets_lib",
        ":websockets",
        "@qtbase//:core",
        "@qtdeclarative//:qml",
    ],
)
