load(
    "@qt//:qt.bzl",
    "qt_cc_library",
    "qt_config_header",
    "qt_export_header",
    "qt_generate_qrc",
    "qt_module_headers",
    "qt_plugin",
    "qt_qml_module",
)
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:LGPL-3.0-only",
        "@rules_license//licenses/spdx:GPL-2.0-only",
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
    license_text = "LICENSES/LGPL-3.0-only.txt",
)

# ============================================================================
# ScxmlGlobalPrivate config header
# ============================================================================

qt_config_header(
    name = "scxmlglobal_private_config",
    out = "qtscxmlglobal-config_p.h",
    content = """#pragma once
#define QT_FEATURE_scxml 1
#define QT_FEATURE_scxml_qml 1
#define QT_FEATURE_scxml_ecmascriptdatamodel 1
#define QT_FEATURE_statemachine 1
#define QT_FEATURE_statemachine_qml 1
#define QT_FEATURE_qeventtransition 1
""",
)

qt_module_headers(
    name = "scxmlglobal_headers",
    hdrs = [],
    extra_deps = [":scxmlglobal_private_config"],
    extra_private_hdrs = [":scxmlglobal_private_config"],
    module_name = "ScxmlGlobal",
)

