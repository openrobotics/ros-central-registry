qt_cc_library(
    name = "scxml",
    srcs = [
        "src/scxml/qscxmlcompiler.cpp",
        "src/scxml/qscxmlcppdatamodel.cpp",
        "src/scxml/qscxmldatamodel.cpp",
        "src/scxml/qscxmldatamodelplugin.cpp",
