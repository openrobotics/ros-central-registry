        ":scxml_export",
        ":scxml_headers",
        ":scxmlglobal_headers",
        "@qtbase//:core",
    ],
)

qt_generate_qrc(
    name = "qscxmlc_templates_qrc",
    srcs = [
        "tools/qscxmlc/cppdatamodel.t",
        "tools/qscxmlc/data.t",
        "tools/qscxmlc/decl.t",
    ],
    prefix = "/",
    rcc_options = ["--no-compress"],
    strip_prefix = "tools/qscxmlc",
)

cc_binary(
    name = "qscxmlc",
    srcs = [
        "src/scxml/qscxmlcompiler.cpp",
        "src/scxml/qscxmlcompiler.h",
        "src/scxml/qscxmlcompiler_p.h",
        "src/scxml/qscxmlerror.cpp",
        "src/scxml/qscxmlerror.h",
        "src/scxml/qscxmlexecutablecontent.cpp",
        "src/scxml/qscxmlexecutablecontent.h",
        "src/scxml/qscxmlexecutablecontent_p.h",
        "src/scxml/qscxmlglobals.h",
        "src/scxml/qscxmltabledata.cpp",
        "src/scxml/qscxmltabledata.h",
        "tools/qscxmlc/generator.cpp",
        "tools/qscxmlc/generator.h",
        "tools/qscxmlc/main.cpp",
        "tools/qscxmlc/moc.cpp",
        "tools/qscxmlc/moc.h",
        "tools/qscxmlc/outputrevision.h",
        "tools/qscxmlc/qscxmlc.cpp",
        "tools/qscxmlc/qscxmlc.h",
        "tools/qscxmlc/scxmlcppdumper.cpp",
        "tools/qscxmlc/scxmlcppdumper.h",
        "tools/qscxmlc/utils.h",
        ":qscxmlc_templates_qrc",
    ],
    includes = [
        "src/scxml",
        "tools/qscxmlc",
    ],
    local_defines = [
        "BUILD_QSCXMLC",
        "QT_NO_CAST_FROM_ASCII",
        "QT_NO_CAST_TO_ASCII",
    ],
    deps = [
        ":scxml_export",
        ":scxml_headers",
        ":scxmlglobal_headers",
        "@qtbase//:core",
    ],
)

