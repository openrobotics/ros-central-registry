load("@qt//:qt.bzl", "common_copts")
load("@qt//:qt_internal_library.bzl", "qt_internal_library")
load("@qt//:qt_tools.bzl", "qt_export_header", "qt_sync_headers")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
    license_text = "LICENSES/GPL-3.0-only.txt",
)

exports_files(["MODULE.bazel"])

_COMMON_DEFINES = [
    "QT_ASCII_CAST_WARNINGS",
    "QT_BUILDING_QT",
    "QT_DEPRECATED_WARNINGS",
    "QT_EXPLICIT_QFILE_CONSTRUCTION_FROM_PATH",
    "QT_MOC_COMPAT",
    "QT_NO_CAST_TO_ASCII",
    "QT_NO_CONTEXTLESS_CONNECT=1",
    "QT_NO_DEBUG",
    "QT_NO_EXCEPTIONS",
    "QT_NO_FOREACH=1",
    "QT_NO_JAVA_STYLE_ITERATORS",
    "QT_NO_NARROWING_CONVERSIONS_IN_CONNECT",
    "QT_NO_QASCONST=1",
    "QT_NO_QEXCHANGE",
    "QT_NO_QSNPRINTF",
    "QT_USE_NODISCARD_FILE_OPEN=1",
    "QT_USE_QSTRINGBUILDER",
    "_GLIBCXX_ASSERTIONS",
    "_LARGEFILE64_SOURCE",
    "_LARGEFILE_SOURCE",
]

qt_export_header(
    name = "coap_exports_h",
    out = "generated_exports/qtcoapexports.h",
    module_infix = "COAP",
)

qt_sync_headers(
    name = "coap_sync_headers",
    hdrs = glob(["src/coap/*.h"]),
    dep_modules = ["QtCore"],
    generated_public_hdrs = [":coap_exports_h"],
    module_name = "QtCoap",
    source_dir = "src/coap",
)

qt_internal_library(
    name = "coap",
    srcs = glob(["src/coap/*.cpp"]),
    hdrs = glob(["src/coap/*.h"]),
    copts = common_copts + ["-std=gnu++20"],
    create_shared = True,
    defines = ["QT_COAP_LIB"],
    dynamic_deps = [
        "@qtbase//:core_shared",
        "@qtbase//:network_shared",
    ],
    includes = ["src/coap"],
    local_defines = _COMMON_DEFINES + ["QT_BUILD_COAP_LIB"],
    moc_hdrs = [
        "src/coap/qcoapclient.h",
        "src/coap/qcoapconnection_p.h",
        "src/coap/qcoapinternalmessage_p.h",
        "src/coap/qcoapinternalreply_p.h",
        "src/coap/qcoapinternalrequest_p.h",
        "src/coap/qcoapnamespace.h",
        "src/coap/qcoapprotocol_p.h",
        "src/coap/qcoapqudpconnection_p.h",
        "src/coap/qcoapreply.h",
        "src/coap/qcoapresourcediscoveryreply.h",
    ],
    moc_unity = True,
    deps = [
        ":coap_sync_headers",
        "@qtbase//:core",
        "@qtbase//:network",
    ],
)
