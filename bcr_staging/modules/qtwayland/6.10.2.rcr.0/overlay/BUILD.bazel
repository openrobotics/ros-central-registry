"""Bazel build for @qtwayland (QtWaylandCompositor, QML extensions, and plugins)."""

load("@qt//:qt_internal_library.bzl", "qt_internal_library", "qt_static_plugin")
load(
    "@qt//:qt_tools.bzl",
    "qt_export_header",
    "qt_generate_qrc",
    "qt_qml_plugin_gen",
    "qt_qmldir",
    "qt_rcc_internal",
    "qt_sync_headers",
    "qt_write_file",
)
load("@qt//:qt_wayland.bzl", "qt_wayland_client_protocol", "qt_wayland_server_protocol")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:LGPL-3.0-only",
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
    license_text = "LICENSES/LGPL-3.0-only.txt",
)

license(
    name = "license_wayland_ivi_protocol",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
    license_text = "src/3rdparty/protocol/ivi/MIT.txt",
)

exports_files([
    "LICENSES/LGPL-3.0-only.txt",
    "src/3rdparty/protocol/ivi/MIT.txt",
])

QT_VERSION = "6.10.2"

common_copts = [
    "-w",
    "-fPIC",
    "-DQT_NO_CAST_TO_ASCII",
    "-DQT_BUILDING_QT",
]

_COMMON_DEFINES = [
    "QT_ASCII_CAST_WARNINGS",
    "QT_BUILDING_QT",
    "QT_DEPRECATED_WARNINGS",
    "QT_EXPLICIT_QFILE_CONSTRUCTION_FROM_PATH",
    "QT_MOC_COMPAT",
    "QT_NO_CAST_TO_ASCII",
    "QT_NO_DEBUG",
    "QT_NO_EXCEPTIONS",
    "QT_NO_FOREACH",
    "QT_NO_JAVA_STYLE_ITERATORS",
    "QT_NO_NARROWING_CONVERSIONS_IN_CONNECT",
    "QT_NO_QASCONST",
    "QT_NO_QEXCHANGE",
    "QT_NO_QSNPRINTF",
    "QT_USE_QSTRINGBUILDER",
    "_GLIBCXX_ASSERTIONS",
    "_LARGEFILE64_SOURCE",
    "_LARGEFILE_SOURCE",
]

# =============================================================================
# Generated Config & Version Headers
# =============================================================================

qt_write_file(
    name = "gen_qtwaylandclient_features_config_h",
    out = "generated_cfg/QtWaylandClientFeatures/qtwaylandclientfeatures-config.h",
    content = """#ifndef QTWAYLANDCLIENTFEATURES_CONFIG_H
#define QTWAYLANDCLIENTFEATURES_CONFIG_H

#endif // QTWAYLANDCLIENTFEATURES_CONFIG_H
""",
)

qt_write_file(
    name = "gen_qtwaylandclient_features_config_p_h",
    out = "generated_cfg/QtWaylandClientFeatures/private/qtwaylandclientfeatures-config_p.h",
    content = """#ifndef QTWAYLANDCLIENTFEATURES_CONFIG_P_H
#define QTWAYLANDCLIENTFEATURES_CONFIG_P_H

#define QT_FEATURE_wayland_client_ivi_shell 1
#define QT_FEATURE_wayland_client_qt_shell 1

#endif // QTWAYLANDCLIENTFEATURES_CONFIG_P_H
""",
)

qt_write_file(
    name = "gen_qtwaylandcompositor_config_h",
    out = "generated_cfg/QtWaylandCompositor/qtwaylandcompositor-config.h",
    content = """#ifndef QTWAYLANDCOMPOSITOR_CONFIG_H
#define QTWAYLANDCOMPOSITOR_CONFIG_H

#define QT_FEATURE_wayland_server 1
#define QT_FEATURE_wayland_compositor_quick 1

#endif // QTWAYLANDCOMPOSITOR_CONFIG_H
""",
)

qt_write_file(
    name = "gen_qtwaylandcompositor_config_p_h",
    out = "generated_cfg/QtWaylandCompositor/private/qtwaylandcompositor-config_p.h",
    content = """#ifndef QTWAYLANDCOMPOSITOR_CONFIG_P_H
#define QTWAYLANDCOMPOSITOR_CONFIG_P_H

#include <QtWaylandCompositor/qtwaylandcompositor-config.h>
#include <QtWaylandGlobal/private/qtwaylandglobal-config_p.h>

#endif // QTWAYLANDCOMPOSITOR_CONFIG_P_H
""",
)

qt_export_header(
    name = "qtwaylandcompositorexports_h",
    out = "generated_exports/qtwaylandcompositorexports.h",
    module_infix = "WAYLANDCOMPOSITOR",
)

# =============================================================================
# QtWaylandClientFeaturesPrivate (:wayland_client_features_private)
# =============================================================================

qt_sync_headers(
    name = "wayland_client_features_sync_headers",
    hdrs = [],
    dep_modules = ["QtCore"],
    generated_private_hdrs = [":gen_qtwaylandclient_features_config_p_h"],
    generated_public_hdrs = [":gen_qtwaylandclient_features_config_h"],
    internal_module = True,
    module_name = "QtWaylandClientFeatures",
    source_dir = "src/client",
    version = QT_VERSION,
    deps = ["@qtbase//:core_sync_headers"],
)

cc_library(
    name = "wayland_client_features_private",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":wayland_client_features_sync_headers",
        "@qtbase//:core",
    ],
)

