load("@qt//:qt.bzl", "common_copts")
load("@qt//:qt_internal_library.bzl", "qt_internal_library")
load("@qt//:qt_tools.bzl", "qt_sync_headers", "qt_write_file")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:LGPL-3.0-only"],
    license_text = "LICENSES/LGPL-3.0-only.txt",
)

exports_files(["MODULE.bazel"])

_COMMON_DEFINES = [
    "QT_ASCII_CAST_WARNINGS",
    "QT_BUILDING_QT",
    "QT_DEPRECATED_WARNINGS",
    "QT_EXPLICIT_QFILE_CONSTRUCTION_FROM_PATH",
    "QT_MOC_COMPAT",
    "QT_NO_CAST_TO_ASCII",
    "QT_NO_CONTEXTLESS_CONNECT=1",
    "QT_NO_DEBUG",
    "QT_NO_EXCEPTIONS",
    "QT_NO_FOREACH=1",
    "QT_NO_JAVA_STYLE_ITERATORS",
    "QT_NO_NARROWING_CONVERSIONS_IN_CONNECT",
    "QT_NO_QASCONST=1",
    "QT_NO_QEXCHANGE",
    "QT_NO_QSNPRINTF",
    "QT_USE_QSTRINGBUILDER",
    "_GLIBCXX_ASSERTIONS",
    "_LARGEFILE64_SOURCE",
    "_LARGEFILE_SOURCE",
]

qt_write_file(
    name = "gen_serialport_exports",
    out = "generated_cfg/include/QtSerialPort/qtserialportexports.h",
    content = """// Generated by Bazel
#ifndef QTSERIALPORTEXPORTS_H
#define QTSERIALPORTEXPORTS_H

#include <QtCore/qcompilerdetection.h>
#include <QtCore/qtconfigmacros.h>
#include <QtCore/qtdeprecationmarkers.h>

#if defined(QT_SHARED) || !defined(QT_STATIC)
#  if defined(QT_BUILD_SERIALPORT_LIB)
#    define Q_SERIALPORT_EXPORT Q_DECL_EXPORT
#  else
#    define Q_SERIALPORT_EXPORT Q_DECL_IMPORT
#  endif
#else
#  define Q_SERIALPORT_EXPORT
#endif

#define QT_SERIALPORT_REMOVED_SINCE(major, minor) 0

#endif // QTSERIALPORTEXPORTS_H
""",
)

cc_library(
    name = "serialport_cfg",
    hdrs = [":gen_serialport_exports"],
    includes = [
        "generated_cfg/include",
        "generated_cfg/include/QtSerialPort",
    ],
)

qt_sync_headers(
    name = "serialport_sync_headers",
    srcs = glob(["src/serialport/*.h"]),
    dep_modules = ["QtCore"],
    module_name = "QtSerialPort",
    source_dir = "src/serialport",
)

_SERIALPORT_LINKOPTS = select({
    "@platforms//os:macos": [
        "-framework",
        "CoreFoundation",
        "-framework",
        "IOKit",
    ],
    "@platforms//os:windows": [
        "-ladvapi32",
        "-lsetupapi",
    ],
    "//conditions:default": [],
})

qt_internal_library(
    name = "serialport",
    srcs = [
        "src/serialport/qserialport.cpp",
        "src/serialport/qserialportinfo.cpp",
        "src/serialport/removed_api.cpp",
    ] + select({
        "@platforms//os:linux": [
            "src/serialport/qserialport_unix.cpp",
            "src/serialport/qserialportinfo_unix.cpp",
        ],
        "@platforms//os:macos": [
            "src/serialport/qserialport_unix.cpp",
            "src/serialport/qserialportinfo_osx.cpp",
        ],
        "@platforms//os:windows": [
            "src/serialport/qserialport_win.cpp",
            "src/serialport/qserialportinfo_win.cpp",
            "src/serialport/qwinoverlappedionotifier.cpp",
        ],
        "//conditions:default": [],
    }),
    hdrs = glob(["src/serialport/*.h"]) + [":serialport_sync_headers"],
    copts = common_copts + ["-std=gnu++20"],
    create_shared = True,
    defines = ["QT_SERIALPORT_LIB"],
    dynamic_deps = [
        "@qtbase//:core_shared",
    ],
    includes = ["src/serialport"],
    linkopts = _SERIALPORT_LINKOPTS,
    local_defines = _COMMON_DEFINES + ["QT_BUILD_SERIALPORT_LIB"],
    moc_hdrs = [
        "src/serialport/qserialport.h",
    ] + select({
        "@platforms//os:windows": [
            "src/serialport/qwinoverlappedionotifier_p.h",
        ],
        "//conditions:default": [],
    }),
    moc_unity = True,
    deps = [
        ":serialport_cfg",
        "@qtbase//:core",
    ],
)
