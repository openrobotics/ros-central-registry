load("@qt//:qt.bzl", "common_copts")
load("@qt//:qt_internal_library.bzl", "qt_internal_library", "qt_static_plugin")
load("@qt//:qt_tools.bzl", "qt_generate_qrc", "qt_qml_plugin_gen", "qt_rcc_internal", "qt_sync_headers", "qt_write_file")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:LGPL-3.0-only"],
    license_text = "LICENSES/LGPL-3.0-only.txt",
)

exports_files(["MODULE.bazel"])

_COMMON_DEFINES = [
    "QT_ASCII_CAST_WARNINGS",
    "QT_BUILDING_QT",
    "QT_DEPRECATED_WARNINGS",
    "QT_EXPLICIT_QFILE_CONSTRUCTION_FROM_PATH",
    "QT_LEAN_HEADERS=1",
    "QT_MOC_COMPAT",
    "QT_NO_AS_CONST=1",
    "QT_NO_CAST_TO_ASCII",
    "QT_NO_CONTEXTLESS_CONNECT=1",
    "QT_NO_DEBUG",
    "QT_NO_EXCEPTIONS",
    "QT_NO_FOREACH=1",
    "QT_NO_JAVA_STYLE_ITERATORS",
    "QT_NO_NARROWING_CONVERSIONS_IN_CONNECT",
    "QT_NO_QASCONST=1",
    "QT_NO_QEXCHANGE",
    "QT_NO_QSNPRINTF",
    "QT_USE_FAST_OPERATOR_PLUS",
    "QT_USE_QSTRINGBUILDER",
    "_GLIBCXX_ASSERTIONS",
    "_LARGEFILE64_SOURCE",
    "_LARGEFILE_SOURCE",
]

qt_write_file(
    name = "gen_core5compat_exports",
    out = "generated_cfg/include/QtCore5Compat/qtcore5compatexports.h",
    content = """// Generated by Bazel
#ifndef QTCORE5COMPATEXPORTS_H
#define QTCORE5COMPATEXPORTS_H

#include <QtCore/qcompilerdetection.h>
#include <QtCore/qtconfigmacros.h>
#include <QtCore/qtdeprecationmarkers.h>

#if defined(QT_SHARED) || !defined(QT_STATIC)
#  if defined(QT_BUILD_CORE5COMPAT_LIB)
#    define Q_CORE5COMPAT_EXPORT Q_DECL_EXPORT
#  else
#    define Q_CORE5COMPAT_EXPORT Q_DECL_IMPORT
#  endif
#else
#  define Q_CORE5COMPAT_EXPORT
#endif

#define QT_CORE5COMPAT_REMOVED_SINCE(major, minor) 0

#endif // QTCORE5COMPATEXPORTS_H
""",
)

qt_write_file(
    name = "gen_core5compat_config",
    out = "generated_cfg/include/QtCore5Compat/qtcore5compat-config.h",
    content = """// Generated by Bazel
#ifndef QTCORE5COMPAT_CONFIG_H
#define QTCORE5COMPAT_CONFIG_H

#define QT_FEATURE_textcodec 1
#define QT_FEATURE_codecs 1
#define QT_FEATURE_big_codecs 1
#define QT_FEATURE_iconv -1
#define QT_NO_ICONV 1

#endif // QTCORE5COMPAT_CONFIG_H
""",
)

qt_write_file(
    name = "gen_core5compat_config_p",
    out = "generated_cfg/include/QtCore5Compat/6.10.2/QtCore5Compat/private/qtcore5compat-config_p.h",
    content = """// Generated by Bazel
#ifndef QTCORE5COMPAT_CONFIG_P_H
#define QTCORE5COMPAT_CONFIG_P_H

#define QT_FEATURE_iconv -1

#endif // QTCORE5COMPAT_CONFIG_P_H
""",
)

cc_library(
    name = "core5compat_cfg",
    hdrs = [
        ":gen_core5compat_config",
        ":gen_core5compat_config_p",
        ":gen_core5compat_exports",
    ],
    includes = [
        "generated_cfg/include",
        "generated_cfg/include/QtCore5Compat",
        "generated_cfg/include/QtCore5Compat/6.10.2",
        "generated_cfg/include/QtCore5Compat/6.10.2/QtCore5Compat",
    ],
)

qt_sync_headers(
    name = "core5compat_sync_headers",
    srcs = glob(["src/core5/**/*.h"]),
    dep_modules = ["QtCore"],
    module_name = "QtCore5Compat",
    source_dir = "src/core5",
)

qt_internal_library(
    name = "core5compat",
    # Codec backend selection mirrors src/core5/CMakeLists.txt: with
    # QT_FEATURE_icu (as @qtbase//:core is built on Linux) QTextCodec is
    # backed by qicucodec.cpp and the big/iconv/windows codecs are NOT compiled.
    srcs = [
        "src/core5/codecs/qisciicodec.cpp",
        "src/core5/codecs/qlatincodec.cpp",
        "src/core5/codecs/qsimplecodec.cpp",
        "src/core5/codecs/qtextcodec.cpp",
        "src/core5/codecs/qtsciicodec.cpp",
        "src/core5/codecs/qutfcodec.cpp",
        "src/core5/sax/qxml.cpp",
        "src/core5/serialization/qbinaryjson.cpp",
        "src/core5/serialization/qbinaryjsonarray.cpp",
        "src/core5/serialization/qbinaryjsonobject.cpp",
        "src/core5/serialization/qbinaryjsonvalue.cpp",
        "src/core5/text/qregexp.cpp",
        "src/core5/text/qstringref.cpp",
        "src/core5/tools/qlinkedlist.cpp",
    ] + select({
        "@platforms//os:linux": ["src/core5/codecs/qicucodec.cpp"],
        "@platforms//os:windows": [
            "src/core5/codecs/qbig5codec.cpp",
            "src/core5/codecs/qeucjpcodec.cpp",
            "src/core5/codecs/qeuckrcodec.cpp",
            "src/core5/codecs/qgb18030codec.cpp",
            "src/core5/codecs/qjiscodec.cpp",
            "src/core5/codecs/qjpunicode.cpp",
            "src/core5/codecs/qsjiscodec.cpp",
            "src/core5/codecs/qwindowscodec.cpp",
        ],
        "//conditions:default": [
            "src/core5/codecs/qbig5codec.cpp",
            "src/core5/codecs/qeucjpcodec.cpp",
            "src/core5/codecs/qeuckrcodec.cpp",
            "src/core5/codecs/qgb18030codec.cpp",
            "src/core5/codecs/qjiscodec.cpp",
            "src/core5/codecs/qjpunicode.cpp",
            "src/core5/codecs/qsjiscodec.cpp",
        ],
    }),
    hdrs = glob(["src/core5/**/*.h"]) + [":core5compat_sync_headers"],
    copts = common_copts + ["-std=gnu++20"],
    create_shared = True,
    defines = ["QT_CORE5COMPAT_LIB"],
    dynamic_deps = ["@qtbase//:core_shared"],
    includes = [
        "src/core5",
        "src/core5/codecs",
        "src/core5/sax",
        "src/core5/serialization",
        "src/core5/text",
        "src/core5/tools",
    ],
    local_defines = _COMMON_DEFINES + ["QT_BUILD_CORE5COMPAT_LIB"],
    moc_unity = True,
    deps = [
        ":core5compat_cfg",
        "@qtbase//:core",
    ] + select({
        "@platforms//os:linux": [
            "@icu//icu4c/source/common:platform",
            "@icu//icu4c/source/common:uset_props",
            "@icu//icu4c/source/i18n:collation",
        ],
        "//conditions:default": [],
    }),
)

