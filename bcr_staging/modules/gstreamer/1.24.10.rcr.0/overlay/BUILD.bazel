# ---------------------------------------------------------------------------
# Bison & Flex parser generation for gst/parse
# ---------------------------------------------------------------------------

expand_template(
    name = "grammar_y",
    out = "subprojects/gstreamer/gst/parse/grammar.y",
    substitutions = {
        "@BISON_PURE_PARSER@": "%define api.pure full",
    },
    template = "subprojects/gstreamer/gst/parse/grammar.y.in",
)

flex(
    name = "parse_lex",
    srcs = ["subprojects/gstreamer/gst/parse/parse.l"],
    outs = [
        "subprojects/gstreamer/gst/parse/lex.priv_gst_parse_yy.c",
        "subprojects/gstreamer/gst/parse/parse_lex.h",
    ],
    args = [
        "--header-file=$(execpath subprojects/gstreamer/gst/parse/parse_lex.h)",
        "-o",
        "$(execpath subprojects/gstreamer/gst/parse/lex.priv_gst_parse_yy.c)",
        "-Ppriv_gst_parse_yy",
        "$(execpath subprojects/gstreamer/gst/parse/parse.l)",
    ],
)

bison(
    name = "parse_grammar",
    srcs = [":grammar_y"],
    outs = [
        "subprojects/gstreamer/gst/parse/grammar.tab.c",
        "subprojects/gstreamer/gst/parse/grammar.tab.h",
    ],
    args = [
        "-d",
        "-ppriv_gst_parse_yy",
        "-o",
        "$(execpath subprojects/gstreamer/gst/parse/grammar.tab.c)",
        "$(execpath :grammar_y)",
    ],
)

