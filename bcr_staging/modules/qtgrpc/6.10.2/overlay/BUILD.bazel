"""Bazel build for @qtgrpc (QtProtobuf, QtProtobufWellKnownTypes, QtProtobufQtCoreTypes, QtProtobufQtGuiTypes, QtProtobufQuick, QtGrpc, QtGrpcQuick, and protoc plugins)."""

load("@qt//:qt_internal_library.bzl", "qt_internal_library", "qt_static_plugin")
load("@qt//:qt_protobuf.bzl", "qt_protobuf_gen")
load(
    "@qt//:qt_tools.bzl",
    "qt_export_header",
    "qt_qml_plugin_gen",
    "qt_sync_headers",
)
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load(":qtgrpc_config.bzl", "declare_qtgrpc_config_targets")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
    license_text = "LICENSES/GPL-3.0-only.txt",
)

exports_files([
    "LICENSES/GPL-3.0-only.txt",
    "LICENSES/Qt-GPL-exception-1.0.txt",
])

QT_VERSION = "6.10.2"

common_copts = [
    "-w",
    "-fPIC",
    "-O2",
    "-DNDEBUG",
    "-DQT_NO_CAST_TO_ASCII",
    "-DQT_BUILDING_QT",
]

common_local_defines = [
    "QT_ASCII_CAST_WARNINGS",
    "QT_BUILDING_QT",
    "QT_DEPRECATED_WARNINGS",
    "QT_EXPLICIT_QFILE_CONSTRUCTION_FROM_PATH",
    "QT_MOC_COMPAT",
    "QT_NO_CAST_TO_ASCII",
    "QT_NO_CONTEXTLESS_CONNECT=1",
    "QT_NO_DEBUG",
    "QT_NO_EXCEPTIONS",
    "QT_NO_FOREACH=1",
    "QT_NO_JAVA_STYLE_ITERATORS",
    "QT_NO_NARROWING_CONVERSIONS_IN_CONNECT",
    "QT_NO_QASCONST=1",
    "QT_NO_QEXCHANGE",
    "QT_NO_QSNPRINTF",
    "QT_USE_QSTRINGBUILDER",
]

declare_qtgrpc_config_targets()

