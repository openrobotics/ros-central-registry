 #endif
 
 }  // namespace google
+
+// Until glog 0.6.0, IsGoogleLoggingInitialized() lived in the internal
+// namespace, and some projects (e.g. PyTorch's c10/util/Logging.cpp) still
+// declare and call google::glog_internal_namespace_::IsGoogleLoggingInitialized.
+// Keep that symbol for compatibility. The forwarding helper is defined before
+// the internal overload is declared, so that its call to the public function
+// is not ambiguous.
+namespace {
+bool PublicIsGoogleLoggingInitialized() {
+  return google::IsGoogleLoggingInitialized();
+}
+}  // namespace
+
+namespace google {
+inline namespace glog_internal_namespace_ {
+GLOG_EXPORT bool IsGoogleLoggingInitialized();
+bool IsGoogleLoggingInitialized() { return PublicIsGoogleLoggingInitialized(); }
+}  // namespace glog_internal_namespace_
+}  // namespace google
