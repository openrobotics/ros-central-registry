# Bazel build of LibSerial, mirroring upstream src/CMakeLists.txt
# (libserial_static/libserial_shared: SerialPort.cpp, SerialStream.cpp,
# SerialStreamBuf.cpp linked against Threads::Threads). Headers are installed
# upstream under <prefix>/include/libserial/, so consumers write
# `#include <libserial/SerialPort.h>`.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
    license_text = "LICENSE.txt",
)

exports_files(["LICENSE.txt"])

cc_library(
    name = "libserial",
    srcs = [
        "src/SerialPort.cpp",
        "src/SerialStream.cpp",
        "src/SerialStreamBuf.cpp",
    ],
    hdrs = [
        "src/libserial/SerialPort.h",
        "src/libserial/SerialPortConstants.h",
        "src/libserial/SerialStream.h",
        "src/libserial/SerialStreamBuf.h",
    ],
    defines = ["_LIBCPP_ENABLE_CXX20_REMOVED_TYPE_TRAITS=1"],
    linkopts = ["-pthread"],
    strip_include_prefix = "src",
)

alias(
    name = "serial",
    actual = ":libserial",
)
