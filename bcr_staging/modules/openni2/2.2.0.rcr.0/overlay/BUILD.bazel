load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
    license_text = "LICENSE",
)

genrule(
    name = "libusb_compat_header",
    outs = ["_libusb_compat/libusb-1.0/libusb.h"],
    cmd = "printf '#pragma once\\n#include <libusb.h>\\n' > $@",
)

cc_library(
    name = "libusb_prefixed_headers",
    hdrs = [":libusb_compat_header"],
    includes = ["_libusb_compat"],
)

cc_library(
    name = "prefixed_headers",
    hdrs = glob(["Include/**/*.h"]),
    include_prefix = "openni2",
    strip_include_prefix = "Include",
)

cc_library(
    name = "openni2",
    srcs = glob([
        "Source/Core/*.cpp",
        "Source/Drivers/OniFile/Formats/XnCodec.cpp",
        "Source/Drivers/OniFile/Formats/XnStreamCompression.cpp",
        "ThirdParty/LibJPEG/*.c",
        "ThirdParty/PSCommon/XnLib/Source/*.cpp",
        "ThirdParty/PSCommon/XnLib/Source/Linux/*.cpp",
    ]),
    hdrs = glob(["Include/**/*.h"]),
    copts = [
        "-Wno-register",
        "-Wno-narrowing",
    ],
    includes = [
        "Include",
        "Source/Core",
        "Source/Drivers/OniFile/Formats",
        "ThirdParty/LibJPEG",
        "ThirdParty/PSCommon/XnLib/Include",
        "ThirdParty/PSCommon/XnLib/Source",
    ],
    linkopts = [
        "-ldl",
        "-lpthread",
    ] + select({
        "@platforms//os:linux": ["-lrt"],
        "//conditions:default": [],
    }),
    local_defines = [
        "OPENNI2_EXPORT",
        "LINUX=1",
        "linux=1",
    ],
    textual_hdrs = glob([
        "Source/Core/*.h",
        "Source/Drivers/OniFile/Formats/*.h",
        "ThirdParty/LibJPEG/*.h",
        "ThirdParty/LibJPEG/jconfig.*",
        "ThirdParty/PSCommon/XnLib/Include/**/*.h",
        "ThirdParty/PSCommon/XnLib/Source/**/*.h",
    ]),
    deps = [
        ":libusb_prefixed_headers",
        ":prefixed_headers",
        "@libusb",
    ],
)
