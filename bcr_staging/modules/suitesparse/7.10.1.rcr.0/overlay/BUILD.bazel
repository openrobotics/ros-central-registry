load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
        "@rules_license//licenses/spdx:LGPL-2.1-or-later",
        "@rules_license//licenses/spdx:GPL-2.0-or-later",
    ],
    license_text = "LICENSE.txt",
)

cc_library(
    name = "prefixed_headers",
    hdrs = [
        "AMD/Include/amd.h",
        "BTF/Include/btf.h",
        "CAMD/Include/camd.h",
        "CCOLAMD/Include/ccolamd.h",
        "CHOLMOD/Include/cholmod.h",
        "CHOLMOD/Include/cholmod_types.h",
        "COLAMD/Include/colamd.h",
        "CXSparse/Include/cs.h",
        "KLU/Include/klu.h",
        "KLU/Include/klu_version.h",
        "LDL/Include/ldl.h",
        "SuiteSparse_config/SuiteSparse_config.h",
    ],
    include_prefix = "suitesparse",
    strip_include_prefix = "",
)

cc_library(
    name = "config",
    srcs = ["SuiteSparse_config/SuiteSparse_config.c"],
    hdrs = ["SuiteSparse_config/SuiteSparse_config.h"],
    defines = select({
        "@platforms//os:windows": ["NTIMER"],
        "//conditions:default": [],
    }),
    includes = ["SuiteSparse_config"],
    linkopts = ["-lm"],
    strip_include_prefix = "SuiteSparse_config",
)

alias(
    name = "suitesparse_config",
    actual = ":config",
)

cc_library(
    name = "amd",
    srcs = glob(["AMD/Source/*.c"]),
    hdrs = ["AMD/Include/amd.h"],
    includes = [
        "AMD/Include",
        "AMD/Source",
    ],
    strip_include_prefix = "AMD/Include",
    textual_hdrs = glob([
        "AMD/Include/*.h",
        "AMD/Source/*.c",
    ]),
    deps = [":config"],
)

cc_library(
    name = "camd",
    srcs = glob(["CAMD/Source/*.c"]),
    hdrs = ["CAMD/Include/camd.h"],
    includes = [
        "CAMD/Include",
        "CAMD/Source",
    ],
    strip_include_prefix = "CAMD/Include",
    textual_hdrs = glob([
        "CAMD/Include/*.h",
        "CAMD/Source/*.c",
    ]),
    deps = [":config"],
)

cc_library(
    name = "colamd",
    srcs = glob(["COLAMD/Source/*.c"]),
    hdrs = ["COLAMD/Include/colamd.h"],
    includes = [
        "COLAMD/Include",
        "COLAMD/Source",
    ],
    strip_include_prefix = "COLAMD/Include",
    textual_hdrs = glob([
        "COLAMD/Include/*.h",
        "COLAMD/Source/*.c",
    ]),
    deps = [":config"],
)

cc_library(
    name = "ccolamd",
    srcs = glob(["CCOLAMD/Source/*.c"]),
    hdrs = ["CCOLAMD/Include/ccolamd.h"],
    includes = [
        "CCOLAMD/Include",
        "CCOLAMD/Source",
    ],
    strip_include_prefix = "CCOLAMD/Include",
    textual_hdrs = glob([
        "CCOLAMD/Include/*.h",
        "CCOLAMD/Source/*.c",
    ]),
    deps = [":config"],
)

cc_library(
    name = "btf",
    srcs = glob(["BTF/Source/*.c"]),
    hdrs = ["BTF/Include/btf.h"],
    includes = [
        "BTF/Include",
        "BTF/Source",
    ],
    strip_include_prefix = "BTF/Include",
    textual_hdrs = glob([
        "BTF/Include/*.h",
        "BTF/Source/*.c",
    ]),
    deps = [":config"],
)

cc_library(
    name = "ldl",
    srcs = glob(["LDL/Source/*.c"]),
    hdrs = ["LDL/Include/ldl.h"],
    includes = [
        "LDL/Include",
        "LDL/Source",
    ],
    strip_include_prefix = "LDL/Include",
    textual_hdrs = glob([
        "LDL/Include/*.h",
        "LDL/Source/*.c",
    ]),
    deps = [":config"],
)

cc_library(
    name = "klu",
    srcs = glob(["KLU/Source/*.c"]),
    hdrs = [
        "KLU/Include/klu.h",
        "KLU/Include/klu_version.h",
    ],
    includes = [
        "KLU/Include",
        "KLU/Source",
    ],
    strip_include_prefix = "KLU/Include",
    textual_hdrs = glob([
        "KLU/Include/*.h",
        "KLU/Source/*.c",
    ]),
    deps = [
        ":amd",
        ":btf",
        ":colamd",
        ":config",
    ],
)

cc_library(
    name = "cxsparse",
    srcs = glob(["CXSparse/Source/*.c"]),
    hdrs = ["CXSparse/Include/cs.h"],
    includes = [
        "CXSparse/Include",
        "CXSparse/Source",
    ],
    strip_include_prefix = "CXSparse/Include",
    textual_hdrs = glob([
        "CXSparse/Include/*.h",
        "CXSparse/Source/*.c",
    ]),
    deps = [":config"],
)

cc_library(
    name = "cholmod",
    srcs = glob([
        "CHOLMOD/Check/cholmod_*.c",
        "CHOLMOD/Cholesky/cholmod_*.c",
        "CHOLMOD/MatrixOps/cholmod_*.c",
        "CHOLMOD/Modify/cholmod_*.c",
        "CHOLMOD/Utility/cholmod_*.c",
    ]),
    hdrs = [
        "CHOLMOD/Include/cholmod.h",
        "CHOLMOD/Include/cholmod_types.h",
    ],
    defines = [
        "NPARTITION",
        "NSUPERNODAL",
    ],
    includes = [
        "CHOLMOD/Check",
        "CHOLMOD/Cholesky",
        "CHOLMOD/Include",
        "CHOLMOD/MatrixOps",
        "CHOLMOD/Modify",
        "CHOLMOD/Utility",
    ],
    strip_include_prefix = "CHOLMOD/Include",
    textual_hdrs = glob([
        "CHOLMOD/Include/*.h",
        "CHOLMOD/Check/*.c",
        "CHOLMOD/Cholesky/*.c",
        "CHOLMOD/MatrixOps/*.c",
        "CHOLMOD/Modify/*.c",
        "CHOLMOD/Utility/*.c",
    ]),
    deps = [
        ":amd",
        ":camd",
        ":ccolamd",
        ":colamd",
        ":config",
    ],
)

cc_library(
    name = "suitesparse",
    deps = [
        ":amd",
        ":btf",
        ":camd",
        ":ccolamd",
        ":cholmod",
        ":colamd",
        ":config",
        ":cxsparse",
        ":klu",
        ":ldl",
    ],
)
