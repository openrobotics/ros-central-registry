load("@qt//:qt.bzl", "common_copts")
load("@qt//:qt_internal_library.bzl", "qt_internal_library", "qt_static_plugin")
load("@qt//:qt_tools.bzl", "qt_dbus_interface", "qt_qml_plugin_gen", "qt_sync_headers", "qt_write_file")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:LGPL-3.0-only"],
    license_text = "LICENSES/LGPL-3.0-only.txt",
)

exports_files(["MODULE.bazel"])

_COMMON_DEFINES = [
    "QT_ASCII_CAST_WARNINGS",
    "QT_BUILDING_QT",
    "QT_DEPRECATED_WARNINGS",
    "QT_EXPLICIT_QFILE_CONSTRUCTION_FROM_PATH",
    "QT_MOC_COMPAT",
    "QT_NO_CAST_TO_ASCII",
    "QT_NO_CONTEXTLESS_CONNECT=1",
    "QT_NO_DEBUG",
    "QT_NO_EXCEPTIONS",
    "QT_NO_FOREACH=1",
    "QT_NO_JAVA_STYLE_ITERATORS",
    "QT_NO_NARROWING_CONVERSIONS_IN_CONNECT",
    "QT_NO_QASCONST=1",
    "QT_NO_QEXCHANGE",
    "QT_NO_QSNPRINTF",
    "QT_USE_QSTRINGBUILDER",
    "_GLIBCXX_ASSERTIONS",
    "_LARGEFILE64_SOURCE",
    "_LARGEFILE_SOURCE",
]

qt_write_file(
    name = "gen_sensors_exports",
    out = "generated_cfg/include/QtSensors/qtsensorsexports.h",
    content = """// Generated by Bazel
#ifndef QTSENSORSEXPORTS_H
#define QTSENSORSEXPORTS_H

#include <QtCore/qcompilerdetection.h>
#include <QtCore/qtconfigmacros.h>
#include <QtCore/qtdeprecationmarkers.h>

#if defined(QT_SHARED) || !defined(QT_STATIC)
#  if defined(QT_BUILD_SENSORS_LIB)
#    define Q_SENSORS_EXPORT Q_DECL_EXPORT
#  else
#    define Q_SENSORS_EXPORT Q_DECL_IMPORT
#  endif
#else
#  define Q_SENSORS_EXPORT
#endif

#define QT_SENSORS_REMOVED_SINCE(major, minor) 0

#endif // QTSENSORSEXPORTS_H
""",
)

qt_write_file(
    name = "gen_sensorsquick_exports",
    out = "generated_cfg/include/QtSensorsQuick/qtsensorsquickexports.h",
    content = """// Generated by Bazel
#ifndef QTSENSORSQUICKEXPORTS_H
#define QTSENSORSQUICKEXPORTS_H

#include <QtCore/qcompilerdetection.h>
#include <QtCore/qtconfigmacros.h>
#include <QtCore/qtdeprecationmarkers.h>

#if defined(QT_SHARED) || !defined(QT_STATIC)
#  if defined(QT_BUILD_SENSORSQUICK_LIB)
#    define Q_SENSORSQUICK_EXPORT Q_DECL_EXPORT
#  else
#    define Q_SENSORSQUICK_EXPORT Q_DECL_IMPORT
#  endif
#else
#  define Q_SENSORSQUICK_EXPORT
#endif

#define QT_SENSORSQUICK_REMOVED_SINCE(major, minor) 0

#endif // QTSENSORSQUICKEXPORTS_H
""",
)

cc_library(
    name = "sensors_cfg",
    hdrs = [
        ":gen_sensors_exports",
        ":gen_sensorsquick_exports",
    ],
    includes = [
        "generated_cfg/include",
        "generated_cfg/include/QtSensors",
        "generated_cfg/include/QtSensorsQuick",
    ],
)

qt_sync_headers(
    name = "sensors_sync_headers",
    srcs = glob(["src/sensors/*.h"]),
    dep_modules = ["QtCore"],
    module_name = "QtSensors",
    source_dir = "src/sensors",
)

qt_internal_library(
    name = "sensors",
    srcs = glob(["src/sensors/*.cpp"]),
    hdrs = glob(["src/sensors/*.h"]) + [":sensors_sync_headers"],
    copts = common_copts + ["-std=gnu++20"],
    create_shared = True,
    defines = ["QT_SENSORS_LIB"],
    dynamic_deps = ["@qtbase//:core_shared"],
    includes = ["src/sensors"],
    local_defines = _COMMON_DEFINES + ["QT_BUILD_SENSORS_LIB"],
    moc_hdrs = [
        "src/sensors/qaccelerometer.h",
        "src/sensors/qambientlightsensor.h",
        "src/sensors/qambienttemperaturesensor.h",
        "src/sensors/qcompass.h",
        "src/sensors/qgyroscope.h",
        "src/sensors/qhumiditysensor.h",
        "src/sensors/qirproximitysensor.h",
        "src/sensors/qlidsensor.h",
        "src/sensors/qlightsensor.h",
        "src/sensors/qmagnetometer.h",
        "src/sensors/qorientationsensor.h",
        "src/sensors/qpressuresensor.h",
        "src/sensors/qproximitysensor.h",
        "src/sensors/qrotationsensor.h",
        "src/sensors/qsensor.h",
        "src/sensors/qsensorbackend.h",
        "src/sensors/qtapsensor.h",
        "src/sensors/qtiltsensor.h",
    ],
    moc_srcs = ["src/sensors/qsensormanager.cpp"],
    moc_unity = True,
    deps = [
        ":sensors_cfg",
        "@qtbase//:core",
    ],
)

qt_sync_headers(
    name = "sensorsquick_sync_headers",
    srcs = glob(["src/sensorsquick/*.h"]),
    dep_modules = [
        "QtCore",
        "QtSensors",
        "QtQml",
    ],
    module_name = "QtSensorsQuick",
    source_dir = "src/sensorsquick",
)

qt_internal_library(
    name = "sensorsquick",
    srcs = glob(["src/sensorsquick/*.cpp"]),
    hdrs = glob(["src/sensorsquick/*.h"]) + [":sensorsquick_sync_headers"],
    copts = common_copts + ["-std=gnu++20"],
    create_shared = True,
    defines = ["QT_SENSORSQUICK_LIB"],
    dynamic_deps = [
        ":sensors_shared",
        "@qtbase//:core_shared",
        "@qtdeclarative//:qml_shared",
    ],
    includes = ["src/sensorsquick"],
    local_defines = _COMMON_DEFINES + ["QT_BUILD_SENSORSQUICK_LIB"],
    moc_hdrs = [
        "src/sensorsquick/qmlaccelerometer_p.h",
        "src/sensorsquick/qmlambientlightsensor_p.h",
        "src/sensorsquick/qmlambienttemperaturesensor_p.h",
        "src/sensorsquick/qmlcompass_p.h",
        "src/sensorsquick/qmlgyroscope_p.h",
        "src/sensorsquick/qmlhumiditysensor_p.h",
        "src/sensorsquick/qmlirproximitysensor_p.h",
        "src/sensorsquick/qmllidsensor_p.h",
        "src/sensorsquick/qmllightsensor_p.h",
        "src/sensorsquick/qmlmagnetometer_p.h",
        "src/sensorsquick/qmlorientationsensor_p.h",
        "src/sensorsquick/qmlpressuresensor_p.h",
        "src/sensorsquick/qmlproximitysensor_p.h",
        "src/sensorsquick/qmlrotationsensor_p.h",
        "src/sensorsquick/qmlsensor_p.h",
        "src/sensorsquick/qmlsensorglobal_p.h",
        "src/sensorsquick/qmlsensorrange_p.h",
        "src/sensorsquick/qmltapsensor_p.h",
        "src/sensorsquick/qmltiltsensor_p.h",
    ],
    moc_unity = True,
    qml_args = {
        "foreign_types": [
            ":sensors_moc_hdrs",
            "@qtbase//:core_moc_hdrs",
            "@qtdeclarative//:qml_moc_hdrs",
        ],
        "import_name": "QtSensors",
        "qmldir": """module QtSensors
linktarget sensorsquickplugin
optional plugin sensorsquickplugin
classname QtSensorsQuickPlugin
typeinfo plugins.qmltypes
prefer :/qt-project.org/imports/QtSensors/
""",
    },
    deps = [
        ":sensors",
        ":sensors_cfg",
        "@qtbase//:core",
        "@qtdeclarative//:qml",
    ],
)

qt_qml_plugin_gen(
    name = "sensorsquickplugin_gen",
    class_name = "QtSensorsQuickPlugin",
    plugin_name = "sensorsquickplugin",
    uri = "QtSensors",
)

qt_static_plugin(
    name = "sensorsquickplugin",
    srcs = [":sensorsquickplugin_gen"],
    copts = common_copts + ["-std=gnu++20"],
    local_defines = _COMMON_DEFINES + ["QT_PLUGIN"],
    moc_srcs = [":sensorsquickplugin_gen"],
    moc_unity = True,
    plugin_class_name = "QtSensorsQuickPlugin",
    deps = [
        ":sensors",
        ":sensorsquick",
        "@qtbase//:core",
        "@qtdeclarative//:qml",
    ],
)

qt_static_plugin(
    name = "qtsensors_generic",
    srcs = glob(["src/plugins/sensors/generic/*.cpp"]),
    hdrs = glob(["src/plugins/sensors/generic/*.h"]),
    copts = common_copts + ["-std=gnu++20"],
    includes = ["src/plugins/sensors/generic"],
    local_defines = _COMMON_DEFINES + [
        "QT_PLUGIN",
        "QTSENSORS_GENERICALSSENSOR",
        "QTSENSORS_GENERICORIENTATIONSENSOR",
        "QTSENSORS_GENERICROTATIONSENSOR",
        "QTSENSORS_GENERICTILTSENSOR",
    ],
    moc_hdrs = ["src/plugins/sensors/generic/generictiltsensor.h"],
    moc_srcs = ["src/plugins/sensors/generic/main.cpp"],
    moc_unity = True,
    plugin_class_name = "genericSensorPlugin",
    textual_hdrs = ["src/plugins/sensors/generic/plugin.json"],
    deps = [
        ":sensors",
        "@qtbase//:core",
    ],
)

qt_static_plugin(
    name = "qtsensors_dummy",
    srcs = glob(["src/plugins/sensors/dummy/*.cpp"]),
    hdrs = glob(["src/plugins/sensors/dummy/*.h"]),
    copts = common_copts + ["-std=gnu++20"],
    includes = ["src/plugins/sensors/dummy"],
    local_defines = _COMMON_DEFINES + ["QT_PLUGIN"],
    moc_srcs = ["src/plugins/sensors/dummy/main.cpp"],
    moc_unity = True,
    plugin_class_name = "dummySensorPlugin",
    textual_hdrs = ["src/plugins/sensors/dummy/plugin.json"],
    deps = [
        ":sensors",
        "@qtbase//:core",
    ],
)

qt_dbus_interface(
    name = "iio_sensor_proxy_dbus",
    srcs = [
        "src/plugins/sensors/iio-sensor-proxy/net.hadess.SensorProxy.Compass.xml",
        "src/plugins/sensors/iio-sensor-proxy/net.hadess.SensorProxy.xml",
        "src/plugins/sensors/iio-sensor-proxy/org.freedesktop.DBus.Properties.xml",
    ],
    flags = [
        "-N",
        "--namespace",
        "QtSensorsPrivate",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

filegroup(
    name = "iio_sensor_proxy_dbus_hdrs",
    srcs = [":iio_sensor_proxy_dbus"],
    output_group = "headers",
    target_compatible_with = ["@platforms//os:linux"],
)

qt_static_plugin(
    name = "qtsensors_iio_sensor_proxy",
    srcs = glob(["src/plugins/sensors/iio-sensor-proxy/*.cpp"]) + [":iio_sensor_proxy_dbus"],
    hdrs = glob(["src/plugins/sensors/iio-sensor-proxy/*.h"]) + [":iio_sensor_proxy_dbus_hdrs"],
    copts = common_copts + ["-std=gnu++20"],
    includes = ["src/plugins/sensors/iio-sensor-proxy"],
    local_defines = _COMMON_DEFINES + ["QT_PLUGIN"],
    moc_hdrs = [
        "src/plugins/sensors/iio-sensor-proxy/iiosensorproxycompass.h",
        "src/plugins/sensors/iio-sensor-proxy/iiosensorproxylightsensor.h",
        "src/plugins/sensors/iio-sensor-proxy/iiosensorproxyorientationsensor.h",
        "src/plugins/sensors/iio-sensor-proxy/iiosensorproxyproximitysensor.h",
        "src/plugins/sensors/iio-sensor-proxy/iiosensorproxysensorbase.h",
        ":iio_sensor_proxy_dbus_hdrs",
    ],
    moc_srcs = ["src/plugins/sensors/iio-sensor-proxy/main.cpp"],
    moc_unity = True,
    plugin_class_name = "IIOSensorProxySensorPlugin",
    target_compatible_with = ["@platforms//os:linux"],
    textual_hdrs = ["src/plugins/sensors/iio-sensor-proxy/plugin.json"],
    deps = [
        ":iio_sensor_proxy_dbus",
        ":sensors",
        "@qtbase//:core",
        "@qtbase//:dbus",
    ],
)

cc_library(
    name = "sensors_plugins",
    deps = [
        ":qtsensors_dummy",
        ":qtsensors_generic",
    ] + select({
        "@platforms//os:linux": [":qtsensors_iio_sensor_proxy"],
        "//conditions:default": [],
    }),
)
