--- a/testing/src/BazelTestPaths.cc
+++ b/testing/src/BazelTestPaths.cc
@@ -33,6 +33,14 @@
 
   if (common::env("TEST_SRCDIR", test_srcdir))
   {
+    // GZ_BAZEL_PATH: this project's directory under TEST_SRCDIR. Set it when
+    // the project is consumed as an external module (its runfiles live in
+    // their own directory there, not _main); see gz-sim's test targets.
+    if (common::env("GZ_BAZEL_PATH", bazel_path) && !bazel_path.empty())
+    {
+      _sourceDir = gz::common::joinPaths(test_srcdir, bazel_path);
+      return true;
+    }
     // bzlmod puts run files in _main instead of workspace name
     _sourceDir = gz::common::joinPaths(test_srcdir, "_main");
     return true;
