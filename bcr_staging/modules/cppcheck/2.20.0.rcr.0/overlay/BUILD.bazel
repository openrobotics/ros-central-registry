load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

# Dependencies

cc_library(
    name = "picojson",
    hdrs = glob(["externals/picojson/*.h"]),
    includes = ["externals/picojson"],
)

cc_library(
    name = "simplecpp",
    srcs = glob(["externals/simplecpp/*.cpp"]),
    hdrs = glob(["externals/simplecpp/*.h"]),
    defines = select({
        "@platforms//os:windows": ["_WIN32_WINNT=0x0602"],
        "//conditions:default": [],
    }),
    includes = ["externals/simplecpp"],
)

# Core library

cc_library(
    name = "cppcheck_core",
    srcs = glob(["lib/*.cpp"]),
    hdrs = glob(["lib/*.h"]),
    strip_include_prefix = "lib",
    deps = [
        ":picojson",
        ":simplecpp",
        "@tinyxml2",
    ],
)

# Frontend library

cc_library(
    name = "frontend",
    srcs = glob(["frontend/*.cpp"]),
    hdrs = glob(["frontend/*.h"]),
    strip_include_prefix = "frontend",
    deps = [":cppcheck_core"],
)

# CLI library

cc_library(
    name = "cli_lib",
    srcs = glob(
        [
            "cli/*.cpp",
        ],
        exclude = ["cli/main.cpp"],
    ),
    hdrs = glob(["cli/*.h"]),
    copts = [
        "-DFILESDIR=\\\".\\\"",
    ],
    strip_include_prefix = "cli",
    deps = [
        ":cppcheck_core",
        ":frontend",
    ],
)

# Executable

cc_binary(
    name = "cppcheck",
    srcs = ["cli/main.cpp"],
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-lpthread"],
    }),
    deps = [
        ":cli_lib",
        ":cppcheck_core",
    ],
)

# The binary plus its library configuration files (std.cfg, qt.cfg, ...). It is
# built with FILESDIR=".", so it looks for these in a cfg/ directory next to its
# own executable, resolved through /proc/self/exe (i.e. its real location under
# bazel-bin, not a runfiles symlink). So build a second copy of the binary under
# bin/ (keeping its RPATH valid) and generate bin/cfg/ right next to it.

CFG_FILES = glob(["cfg/*.cfg"])

cc_binary(
    name = "bin/cppcheck",
    srcs = ["cli/main.cpp"],
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-lpthread"],
    }),
    deps = [
        ":cli_lib",
        ":cppcheck_core",
    ],
)

genrule(
    name = "bin_cfg",
    srcs = CFG_FILES,
    outs = ["bin/" + f for f in CFG_FILES],
    cmd = " && ".join(["cp $(location {}) $(location bin/{})".format(f, f) for f in CFG_FILES]),
)

filegroup(
    name = "dist",
    srcs = [
        ":bin/cppcheck",
        ":bin_cfg",
    ],
)
