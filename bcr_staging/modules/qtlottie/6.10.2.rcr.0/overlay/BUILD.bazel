load(
    "@qt//:qt.bzl",
    "qt_export_header",
    "qt_generate_qrc",
    "qt_internal_library",
    "qt_module_headers",
    "qt_qml_module",
    "qt_static_plugin",
)
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
    license_text = "LICENSES/GPL-3.0-only.txt",
)

# ============================================================================
# Qt6Lottie + lottieqtplugin
# ============================================================================

qt_export_header(
    name = "lottie_export",
    module_Header = "Lottie",
    module_name = "lottie",
)

LOTTIE_HEADERS = [
    "src/lottie/qbeziereasing_p.h",
