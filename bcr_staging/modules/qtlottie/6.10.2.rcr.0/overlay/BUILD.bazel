    "src/lottie/renderer/qbatchrenderer_p.h",
    "src/lottie/renderer/qlottierasterrenderer_p.h",
    "src/lottie/renderer/qlottierenderer_p.h",
    "src/qml/qlottieanimation_p.h",
]

qt_module_headers(
    name = "lottie_headers",
    hdrs = LOTTIE_HEADERS,
    extra_deps = [":lottie_export"],
    module_name = "Lottie",
)

qt_qml_module(
    name = "lottie",
    srcs = [
        "src/lottie/qbeziereasing.cpp",
        "src/lottie/qlottiebase.cpp",
        "src/lottie/qlottiebasictransform.cpp",
        "src/lottie/qlottieellipse.cpp",
        "src/lottie/qlottiefill.cpp",
        "src/lottie/qlottiefilleffect.cpp",
        "src/lottie/qlottieflatlayers.cpp",
        "src/lottie/qlottiefreeformshape.cpp",
        "src/lottie/qlottiegfill.cpp",
        "src/lottie/qlottiegroup.cpp",
        "src/lottie/qlottieimage.cpp",
        "src/lottie/qlottielayer.cpp",
        "src/lottie/qlottiepolystar.cpp",
        "src/lottie/qlottieprecomplayer.cpp",
        "src/lottie/qlottierect.cpp",
        "src/lottie/qlottierepeater.cpp",
        "src/lottie/qlottierepeatertransform.cpp",
        "src/lottie/qlottieroot.cpp",
        "src/lottie/qlottieround.cpp",
        "src/lottie/qlottieshape.cpp",
        "src/lottie/qlottieshapelayer.cpp",
        "src/lottie/qlottieshapetransform.cpp",
        "src/lottie/qlottiestroke.cpp",
        "src/lottie/qlottietrimpath.cpp",
        "src/lottie/renderer/qbatchrenderer.cpp",
        "src/lottie/renderer/qlottierasterrenderer.cpp",
        "src/lottie/renderer/qlottierenderer.cpp",
        "src/qml/qlottieanimation.cpp",
    ],
    hdrs = LOTTIE_HEADERS,
    create_shared = True,
    dynamic_deps = [
        "@qtdeclarative//:quick_shared",
        "@qtdeclarative//:qmlmeta_shared",
        "@qtdeclarative//:qmlmodels_shared",
        "@qtdeclarative//:qmlworkerscript_shared",
        "@qtdeclarative//:qml_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:network_shared",
        "@qtbase//:core_shared",
    ] + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@qtbase//:dbus_shared"],
    }),
    import_name = "Qt.labs.lottieqt",
    import_version = "6.10",
    includes = [
        "src/lottie",
        "src/lottie/renderer",
        "src/qml",
    ],
    local_defines = [
        "QT_BUILD_LOTTIE_LIB",
    ],
    plugin_class_name = "Qt_labs_lottieqtPlugin",
    plugin_target = "lottieqtplugin",
    qml_depends = ["QtQuick auto"],
    deps = [
        ":lottie_export",
        ":lottie_headers",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtdeclarative//:qml",
        "@qtdeclarative//:quick",
    ],
)

