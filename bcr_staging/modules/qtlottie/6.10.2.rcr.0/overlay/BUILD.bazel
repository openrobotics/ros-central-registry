# ============================================================================
# QLottieVectorImagePlugin (:qlottievectorimage)
# ============================================================================

qt_static_plugin(
    name = "qlottievectorimage",
    srcs = ["src/plugins/vectorimageformats/lottie/main.cpp"],
    includes = ["src/plugins/vectorimageformats/lottie"],
    moc_srcs = ["src/plugins/vectorimageformats/lottie/main.cpp"],
    plugin_class_name = "QLottieVectorImagePlugin",
    deps = [
        ":lottie",
        ":lottievectorimagegenerator",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtdeclarative//:qml",
        "@qtdeclarative//:quick",
        "@qtdeclarative//:quickvectorimagegenerator",
    ],
)

# ============================================================================
# lottietoqml tool (:lottietoqml)
# ============================================================================

qt_generate_qrc(
    name = "lottietoqml_qrc",
    srcs = ["tools/lottietoqml/main.qml"],
    prefix = "/",
    qrc_name = "qml",
    strip_prefix = "tools/lottietoqml",
)

cc_binary(
    name = "lottietoqml",
    srcs = [
        "tools/lottietoqml/main.cpp",
        ":lottietoqml_qrc",
    ],
    deps = [
        ":lottie",
        ":lottievectorimagegenerator",
        ":lottievectorimagehelpersplugin",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtbase//:offscreen",
        "@qtdeclarative//:qml",
        "@qtdeclarative//:qquickvectorimageplugin",
        "@qtdeclarative//:quick",
        "@qtdeclarative//:quickvectorimagegenerator",
    ],
)
