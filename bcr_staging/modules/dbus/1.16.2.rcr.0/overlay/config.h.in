/* config.h.in for the Bazel build of dbus.
 *
 * Hand-written autoheader-style template: upstream only ships
 * cmake/config.h.cmake (#cmakedefine syntax), which rules_cc_autoconf does not
 * parse. Slots mirror that file; values come from dbus_config_checks.bzl.
 */
#ifndef _DBUS_CONFIG_H
#define _DBUS_CONFIG_H

#undef VERSION

#ifndef _GNU_SOURCE
#undef _GNU_SOURCE
#endif

/* Byte order */
#undef WORDS_BIGENDIAN

/* Installation layout and defaults */
#undef DBUS_DATADIR
#undef DBUS_BINDIR
#undef DBUS_PREFIX
#undef DBUS_SYSTEM_CONFIG_FILE
#undef DBUS_SESSION_CONFIG_FILE
#undef DBUS_SESSION_SOCKET_DIR
#undef DBUS_DAEMON_NAME
#undef DBUS_SYSTEM_BUS_DEFAULT_ADDRESS
#undef DBUS_SESSION_BUS_CONNECT_ADDRESS
#undef DBUS_MACHINE_UUID_FILE
#undef DBUS_DAEMONDIR
#undef DBUS_RUNSTATEDIR
#undef DBUS_USER
#undef DBUS_TEST_USER
#undef DBUS_EXEEXT
#undef DBUS_CONSOLE_OWNER_FILE

/* Build options */
#undef DBUS_DISABLE_ASSERT
#undef DBUS_DISABLE_CHECKS
#ifndef DBUS_DISABLE_CHECKS
#define DBUS_ENABLE_CHECKS 1
#endif
#undef DBUS_USE_SYNC

/* Headers */
#undef HAVE_AFUNIX_H
#undef HAVE_ALLOCA_H
#undef HAVE_BYTESWAP_H
#undef HAVE_CRT_EXTERNS_H
#undef HAVE_DIRENT_H
#undef HAVE_ERRNO_H
#undef HAVE_INTTYPES_H
#undef HAVE_IO_H
#undef HAVE_LOCALE_H
#undef HAVE_SIGNAL_H
#undef HAVE_STDIO_H
#undef HAVE_STDATOMIC_H
#undef HAVE_SYSLOG_H
#undef HAVE_SYS_EVENTS_H
#undef HAVE_SYS_INOTIFY_H
#undef HAVE_LINUX_MAGIC_H
#undef HAVE_SYS_PRCTL_H
#undef HAVE_SYS_RANDOM_H
#undef HAVE_SYS_RESOURCE_H
#undef HAVE_SYS_SYSCALL_H
#undef HAVE_SYS_VFS_H
#undef HAVE_SYS_TIME_H
#undef HAVE_UNISTD_H
#undef HAVE_WS2TCPIP_H

/* Functions */
#undef HAVE_ACCEPT4
#undef HAVE_BACKTRACE
#undef HAVE_CLEARENV
#undef HAVE_CLOSEFROM
#undef HAVE_CLOSE_RANGE
#undef HAVE_FSTATFS
#undef HAVE_GETGROUPLIST
#undef HAVE_GETPEERUCRED
#undef HAVE_GETPWNAM_R
#undef HAVE_GETRANDOM
#undef HAVE_GETRESUID
#undef HAVE_GETRLIMIT
#undef HAVE_INOTIFY_INIT1
#undef HAVE_LOCALECONV
#undef HAVE_NANOSLEEP
#undef HAVE_PIPE2
#undef HAVE_POLL
#undef HAVE_PRCTL
#undef HAVE_PRLIMIT
#undef HAVE_RAISE
#undef HAVE_SETENV
#undef HAVE_SETLOCALE
#undef HAVE_SETRESUID
#undef HAVE_SETRLIMIT
#undef HAVE_SOCKETPAIR
#undef HAVE_UNSETENV
#undef HAVE_WRITEV

/* Types, members and platform features */
#undef HAVE_SOCKLEN_T
#undef HAVE_CMSGCRED
#undef HAVE_UNIX_FD_PASSING
#undef DBUS_HAVE_LINUX_EPOLL

/* Declarations (always 0 or 1) */
#undef HAVE_DECL_ENVIRON
#undef HAVE_DECL_LOG_PERROR
#undef HAVE_DECL_MSG_NOSIGNAL
#undef HAVE_DECL_SYS_PIDFD_OPEN

#if defined(_WIN32) || defined(_WIN64)
#define DBUS_WIN
#define DBUS_WIN32
#define _WIN32_WINNT 0x0600
#else
#define DBUS_UNIX
#endif

#endif /* _DBUS_CONFIG_H */
