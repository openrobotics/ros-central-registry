# Bazel build of libspnav, mirroring upstream's default `./configure`
# (X11=yes): objects src/spnav.o src/proto.o src/util.o plus
# src/spnav_magellan.o, linked with -lX11 -lm. Headers are installed flat
# into <prefix>/include, so consumers write `#include <spnav.h>`.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
    license_text = "LICENSE",
)

exports_files(["LICENSE"])

# What `./configure` (default: X11=yes) writes to src/spnav_config.h.
genrule(
    name = "spnav_config_h",
    outs = ["src/spnav_config.h"],
    cmd = select({
        "@platforms//os:linux": "printf '%s\\n' " + " ".join([
            "'#ifndef SPNAV_CONFIG_H_'",
            "'#define SPNAV_CONFIG_H_'",
            "''",
            "'#define SPNAV_USE_X11'",
            "''",
            "'#endif\t/* SPNAV_CONFIG_H_ */'",
        ]) + " > $@",
        "//conditions:default": "printf '%s\\n' " + " ".join([
            "'#ifndef SPNAV_CONFIG_H_'",
            "'#define SPNAV_CONFIG_H_'",
            "''",
            "'#endif\t/* SPNAV_CONFIG_H_ */'",
        ]) + " > $@",
    }),
)

cc_library(
    name = "spnav",
    srcs = [
        "src/proto.c",
        "src/proto.h",
        "src/spnav.c",
        "src/util.c",
    ] + select({
        "@platforms//os:linux": ["src/spnav_magellan.c"],
        "//conditions:default": [],
    }),
    hdrs = [
        "src/spnav.h",
        "src/spnav_magellan.h",
        ":spnav_config_h",
    ],
    copts = ["-fno-strict-aliasing"],
    linkopts = ["-lm"],
    strip_include_prefix = "src",
    deps = select({
        "@platforms//os:linux": ["@libx11"],
        "//conditions:default": [],
    }),
)

alias(
    name = "libspnav",
    actual = ":spnav",
)
