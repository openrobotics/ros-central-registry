load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT-open-group",
    ],
    license_text = "COPYING",
)

exports_files(["COPYING"])

_UNIX_COMPATIBLE = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "@platforms//os:freebsd": [],
    "@platforms//os:openbsd": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_library(
    name = "renderutil_prefixed_hdrs",
    hdrs = ["renderutil/xcb_renderutil.h"],
    include_prefix = "xcb",
    strip_include_prefix = "renderutil",
    target_compatible_with = _UNIX_COMPATIBLE,
)

cc_library(
    name = "xcb-renderutil",
    srcs = [
        "renderutil/cache.c",
        "renderutil/glyph.c",
        "renderutil/util.c",
    ],
    hdrs = ["renderutil/xcb_renderutil.h"],
    includes = ["renderutil"],
    target_compatible_with = _UNIX_COMPATIBLE,
    visibility = ["//visibility:public"],
    deps = [
        ":renderutil_prefixed_hdrs",
        "@libxcb",
        "@xorgproto",
    ],
)

alias(
    name = "libxcb-render-util",
    actual = ":xcb-renderutil",
    visibility = ["//visibility:public"],
)

alias(
    name = "renderutil",
    actual = ":xcb-renderutil",
    visibility = ["//visibility:public"],
)
