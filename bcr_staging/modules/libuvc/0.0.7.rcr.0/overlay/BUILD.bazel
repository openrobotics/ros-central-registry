# Bazel build of libuvc, mirroring upstream CMakeLists.txt with libusb-1.0
# and libjpeg found (JPEG_FOUND -> LIBUVC_HAS_JPEG + src/frame-mjpeg.c),
# which is the configuration distro packages ship. Consumers write
# `#include <libuvc/libuvc.h>`.

load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
    license_text = "LICENSE.txt",
)

exports_files(["LICENSE.txt"])

# configure_file(include/libuvc/libuvc_config.h.in ... @ONLY) for
# project(libuvc VERSION 0.0.7) with JPEG support.
expand_template(
    name = "libuvc_config_h",
    out = "generated/libuvc/libuvc_config.h",
    substitutions = {
        "@libuvc_VERSION_MAJOR@": "0",
        "@libuvc_VERSION_MINOR@": "0",
        "@libuvc_VERSION_PATCH@": "7",
        "@libuvc_VERSION@": "0.0.7",
        "#cmakedefine LIBUVC_HAS_JPEG 1": "#define LIBUVC_HAS_JPEG 1",
    },
    template = "include/libuvc/libuvc_config.h.in",
)

cc_library(
    name = "libuvc_config",
    hdrs = [":libuvc_config_h"],
    strip_include_prefix = "generated",
    visibility = ["//visibility:private"],
)

# Private headers: sources include "libuvc/libuvc_internal.h", which in turn
# includes "utlist.h" from the top-level include/ directory.
cc_library(
    name = "libuvc_internal_hdrs",
    hdrs = [
        "include/libuvc/libuvc_internal.h",
        "include/utlist.h",
    ],
    strip_include_prefix = "include",
    visibility = ["//visibility:private"],
    deps = ["@libusb"],
)

cc_library(
    name = "uvc",
    srcs = [
        "src/ctrl.c",
        "src/ctrl-gen.c",
        "src/device.c",
        "src/diag.c",
        "src/frame.c",
        "src/frame-mjpeg.c",
        "src/init.c",
        "src/misc.c",
        "src/stream.c",
    ],
    hdrs = ["include/libuvc/libuvc.h"],
    implementation_deps = [
        ":libuvc_internal_hdrs",
        "@libjpeg_turbo//:jpeg",
        "@libusb",
    ],
    linkopts = ["-pthread"],
    strip_include_prefix = "include",
    deps = [":libuvc_config"],
)

alias(
    name = "libuvc",
    actual = ":uvc",
)

# BUILD_EXAMPLE is ON by default upstream.
cc_binary(
    name = "example",
    srcs = ["src/example.c"],
    deps = [":uvc"],
)
