# Bazel build of AsmJit (CMakeLists.txt), a static library (ASMJIT_STATIC)
# with its x86 and AArch64 backends, as FBGEMM builds it.
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(default_applicable_licenses = [":license"])

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Zlib"],
    license_text = "LICENSE.md",
)

exports_files(["LICENSE.md"])

cc_library(
    name = "asmjit",
    srcs = glob(["src/asmjit/**/*.cpp"]),
    hdrs = glob(["src/asmjit/**/*.h"]),
    copts = ["-std=c++17"],
    defines = ["ASMJIT_STATIC"],
    includes = ["src"],
    linkopts = select({
        "@platforms//os:linux": [
            "-lpthread",
            "-lrt",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
