# Bazel build of libzbar (the core barcode decoder library), mirroring
# zbar/Makefile.am for upstream's Linux configuration with the default
# symbology set, pthreads, V4L2 video (kernel headers only, no libv4l), JPEG
# conversions (libjpeg-turbo) and no X11/GTK/Qt/Python/Java/DBus front-ends.
# The resulting config header is checked in as bazel/config.h.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:LGPL-2.1-or-later"],
    license_text = "LICENSE.md",
)

exports_files(["LICENSE.md"])

cc_library(
    name = "config",
    hdrs = ["bazel/config.h"],
    strip_include_prefix = "bazel",
    visibility = ["//visibility:private"],
)

cc_library(
    name = "zbar",
    srcs = [
        "zbar/config.c",
        "zbar/convert.c",
        "zbar/debug.h",
        "zbar/decoder.c",
        "zbar/decoder.h",
        "zbar/error.c",
        "zbar/error.h",
        "zbar/event.h",
        "zbar/image.c",
        "zbar/image.h",
        "zbar/img_scanner.c",
        "zbar/img_scanner.h",
        "zbar/misc.c",
        "zbar/misc.h",
        "zbar/mutex.h",
        "zbar/processor.c",
        "zbar/processor.h",
        "zbar/processor/lock.c",
        "zbar/refcnt.c",
        "zbar/refcnt.h",
        "zbar/scanner.c",
        "zbar/symbol.c",
        "zbar/symbol.h",
        "zbar/thread.h",
        "zbar/timer.h",
        "zbar/video.c",
        "zbar/video.h",
        "zbar/window.c",
        "zbar/window.h",
        # ENABLE_EAN
        "zbar/decoder/ean.c",
        "zbar/decoder/ean.h",
        # ENABLE_DATABAR
        "zbar/decoder/databar.c",
        "zbar/decoder/databar.h",
        # ENABLE_CODE128
        "zbar/decoder/code128.c",
        "zbar/decoder/code128.h",
        # ENABLE_CODE93
        "zbar/decoder/code93.c",
        "zbar/decoder/code93.h",
        # ENABLE_CODE39
        "zbar/decoder/code39.c",
        "zbar/decoder/code39.h",
        # ENABLE_CODABAR
        "zbar/decoder/codabar.c",
        "zbar/decoder/codabar.h",
        # ENABLE_I25
        "zbar/decoder/i25.c",
        "zbar/decoder/i25.h",
        # ENABLE_QRCODE
        "zbar/decoder/qr_finder.c",
        "zbar/decoder/qr_finder.h",
        "zbar/qrcode.h",
        "zbar/qrcode/bch15_5.c",
        "zbar/qrcode/bch15_5.h",
        "zbar/qrcode/binarize.c",
        "zbar/qrcode/binarize.h",
        "zbar/qrcode/isaac.c",
        "zbar/qrcode/isaac.h",
        "zbar/qrcode/qrdec.c",
        "zbar/qrcode/qrdec.h",
        "zbar/qrcode/qrdectxt.c",
        "zbar/qrcode/rs.c",
        "zbar/qrcode/rs.h",
        "zbar/qrcode/util.c",
        "zbar/qrcode/util.h",
        # ENABLE_SQCODE
        "zbar/decoder/sq_finder.c",
        "zbar/decoder/sq_finder.h",
        "zbar/sqcode.c",
        "zbar/sqcode.h",
        # !WIN32
        "zbar/processor/posix.c",
        "zbar/processor/posix.h",
        # HAVE_V4L2
        "zbar/video/v4l.c",
        "zbar/video/v4l2.c",
        # HAVE_JPEG
        "zbar/jpeg.c",
        # !HAVE_X && !WIN32
        "zbar/processor/null.c",
        "zbar/svg.h",
        "zbar/window/null.c",
    ],
    hdrs = [
        "include/zbar.h",
        "include/zbar/Decoder.h",
        "include/zbar/Exception.h",
        "include/zbar/Image.h",
        "include/zbar/ImageScanner.h",
        "include/zbar/Processor.h",
        "include/zbar/Scanner.h",
        "include/zbar/Symbol.h",
        "include/zbar/Video.h",
        "include/zbar/Window.h",
    ],
    copts = [
        "-Wno-parentheses",
        "-pthread",
    ],
    implementation_deps = [":config"],
    includes = [
        "include",
        "zbar",
    ],
    linkopts = ["-pthread"],
    deps = ["@libjpeg_turbo//:jpeg"],
)
