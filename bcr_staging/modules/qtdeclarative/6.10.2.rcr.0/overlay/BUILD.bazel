# =============================================================================
# 1. QmlIntegration (header-only module)
# =============================================================================

qt_depends_header(
    name = "qtqmlintegration_depends_h",
    out = "generated_exports/QtQmlIntegrationDepends",
    dep_modules = ["QtCore"],
)

qt_sync_headers(
    name = "qmlintegration_sync_headers",
    hdrs = ["src/qmlintegration/qqmlintegration.h"],
    generated_public_hdrs = [
        ":qtqmlintegration_depends_h",
    ],
    module_name = "QtQmlIntegration",
    source_dir = "src/qmlintegration",
    version = QT_VERSION,
    deps = [
        "@qtbase//:core_sync_headers",
    ],
)

cc_library(
    name = "qmlintegration",
    hdrs = ["src/qmlintegration/qqmlintegration.h"],
    deps = [
        ":qmlintegration_sync_headers",
        "@qtbase//:core",
    ],
)

# =============================================================================
# 2. QmlToolingSettingsPrivate (static internal module)
# =============================================================================

qt_export_header(
    name = "qtqmltoolingsettingsexports_h",
    out = "generated_exports/qtqmltoolingsettingsexports.h",
    module_infix = "QMLTOOLINGSETTINGS",
)

qt_depends_header(
    name = "qtqmltoolingsettings_depends_h",
    out = "generated_exports/QtQmlToolingSettingsPrivateDepends",
    dep_modules = ["QtCore"],
)

qt_sync_headers(
    name = "qmltoolingsettings_sync_headers",
    hdrs = glob(["src/qmltoolingsettings/**/*.h"]),
    generated_public_hdrs = [
        ":qtqmltoolingsettingsexports_h",
        ":qtqmltoolingsettings_depends_h",
    ],
    internal_module = True,
    module_name = "QtQmlToolingSettings",
    source_dir = "src/qmltoolingsettings",
    version = QT_VERSION,
    deps = [
        "@qtbase//:core_sync_headers",
    ],
)

qt_internal_library(
    name = "qmltoolingsettings",
    srcs = [
        "src/qmltoolingsettings/qqmltoolingsettings.cpp",
        "src/qmltoolingsettings/qqmltoolingutils.cpp",
    ],
    hdrs = glob(["src/qmltoolingsettings/**/*.h"]),
    copts = common_copts,
    create_shared = False,
    local_defines = common_local_defines + [
        "QT_BUILD_QMLTOOLINGSETTINGS_LIB",
        "QT_STATIC",
    ],
    deps = [
        ":qmltoolingsettings_sync_headers",
        "@qtbase//:core",
    ],
)

# =============================================================================
# 3. QmlTypeRegistrarPrivate + qmltyperegistrar (host tool)
# =============================================================================

qt_export_header(
