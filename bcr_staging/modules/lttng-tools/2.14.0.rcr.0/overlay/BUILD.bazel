load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-2.0-only",
        "@rules_license//licenses/spdx:LGPL-2.1-only",
    ],
)

_COMMON_COPTS = [
    "-include",
    "lttng_tools_config.h",
    "-Wno-unused-parameter",
    "-Wno-sign-compare",
    "-Wno-missing-field-initializers",
    "-Wno-deprecated-declarations",
    "-Wno-null-dereference",
    "-Wno-deprecated-volatile",
]

_COMMON_INCLUDES = [
    "include",
    "src",
    "src/common",
    "src/common/filter",
    "src/vendor",
]

cc_library(
    name = "internal_headers",
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.hpp",
        "include/**/*.i",
        "src/**/*.h",
        "src/**/*.hpp",
    ]),
    includes = _COMMON_INCLUDES,
    visibility = ["//visibility:private"],
)

cc_library(
    name = "filter_lib",
    srcs = glob(["src/common/filter/*.cpp"]),
    copts = _COMMON_COPTS + [
        "-include",
        "src/common/filter/filter-symbols.hpp",
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":internal_headers",
        "@libuuid",
        "@libxml2",
        "@lttng-ust//:lttng-ust-ctl",
        "@popt",
        "@userspace_rcu",
        "@userspace_rcu//:urcu-cds",
    ],
)

cc_library(
    name = "lttng-ctl",
    srcs = glob(
        [
            "src/common/actions/*.cpp",
            "src/common/argpar-utils/*.cpp",
            "src/common/bytecode/*.cpp",
            "src/common/compat/*.cpp",
            "src/common/conditions/*.cpp",
            "src/common/config/*.cpp",
            "src/common/event-expr/*.cpp",
            "src/common/event-rule/*.cpp",
            "src/common/ini-config/*.cpp",
            "src/common/sessiond-comm/*.cpp",
            "src/common/string-utils/*.cpp",
            "src/lib/lttng-ctl/*.cpp",
            "src/vendor/argpar/*.c",
            "src/vendor/msgpack/*.c",
        ],
    ) + [
        "src/common/buffer-view.cpp",
        "src/common/channel.cpp",
        "src/common/credentials.cpp",
        "src/common/defaults.cpp",
        "src/common/domain.cpp",
        "src/common/dynamic-array.cpp",
        "src/common/dynamic-buffer.cpp",
        "src/common/endpoint.cpp",
        "src/common/error.cpp",
        "src/common/error-query.cpp",
        "src/common/evaluation.cpp",
        "src/common/event.cpp",
        "src/common/event-field-value.cpp",
        "src/common/eventfd.cpp",
        "src/common/exception.cpp",
        "src/common/fd-handle.cpp",
        "src/common/file-descriptor.cpp",
        "src/common/hashtable/seed.cpp",
        "src/common/hashtable/utils.cpp",
        "src/common/io-hint.cpp",
        "src/common/kernel-probe.cpp",
        "src/common/location.cpp",
        "src/common/lockfile.cpp",
        "src/common/log-level-rule.cpp",
        "src/common/logging-utils.cpp",
        "src/common/lttng-elf.cpp",
        "src/common/mi-lttng.cpp",
        "src/common/notification.cpp",
        "src/common/payload.cpp",
        "src/common/payload-view.cpp",
        "src/common/random.cpp",
        "src/common/readwrite.cpp",
        "src/common/runas.cpp",
        "src/common/session-descriptor.cpp",
        "src/common/snapshot.cpp",
        "src/common/spawn-viewer.cpp",
        "src/common/thread.cpp",
        "src/common/time.cpp",
        "src/common/tracker.cpp",
        "src/common/trigger.cpp",
        "src/common/unix.cpp",
        "src/common/uri.cpp",
        "src/common/userspace-probe.cpp",
        "src/common/utils.cpp",
        "src/vendor/fmt/format.cc",
        "src/vendor/fmt/os.cc",
    ],
    hdrs = glob([
        "include/lttng/**/*.h",
    ]),
    copts = _COMMON_COPTS,
    includes = ["include"],
    linkopts = [
        "-ldl",
        "-lpthread",
        "-lrt",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":filter_lib",
        ":internal_headers",
        "@libuuid",
        "@libxml2",
        "@lttng-ust//:lttng-ust-ctl",
        "@popt",
        "@userspace_rcu",
        "@userspace_rcu//:urcu-cds",
    ],
)

cc_library(
    name = "common_gpl_lib",
    srcs = glob([
        "src/common/consumer/*.cpp",
        "src/common/fd-tracker/*.cpp",
        "src/common/health/*.cpp",
        "src/common/index/*.cpp",
        "src/common/kernel-consumer/*.cpp",
        "src/common/kernel-ctl/*.cpp",
        "src/common/relayd/*.cpp",
        "src/common/testpoint/*.cpp",
        "src/common/ust-consumer/*.cpp",
    ]) + [
        "src/common/context.cpp",
        "src/common/daemonize.cpp",
        "src/common/filter.cpp",
        "src/common/fs-handle.cpp",
        "src/common/futex.cpp",
        "src/common/hashtable/hashtable.cpp",
        "src/common/index-allocator.cpp",
        "src/common/path.cpp",
        "src/common/pipe.cpp",
        "src/common/shm.cpp",
        "src/common/trace-chunk.cpp",
        "src/common/uuid.cpp",
        "src/common/waiter.cpp",
    ],
    copts = _COMMON_COPTS,
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:private"],
    deps = [
        ":internal_headers",
        ":lttng-ctl",
        "@libuuid",
        "@libxml2",
        "@lttng-ust//:lttng-ust-ctl",
        "@popt",
        "@userspace_rcu",
        "@userspace_rcu//:urcu-cds",
    ],
)

cc_binary(
    name = "lttng-consumerd",
    srcs = glob([
        "src/bin/lttng-consumerd/*.cpp",
        "src/bin/lttng-consumerd/*.hpp",
    ]),
    copts = _COMMON_COPTS,
    linkopts = [
        "-rdynamic",
        "-ldl",
        "-lpthread",
        "-lrt",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":common_gpl_lib",
        ":internal_headers",
        ":lttng-ctl",
        "@libuuid",
        "@libxml2",
        "@lttng-ust//:lttng-ust-ctl",
        "@popt",
        "@userspace_rcu",
        "@userspace_rcu//:urcu-cds",
    ],
)

cc_binary(
    name = "lttng-sessiond",
    srcs = glob([
        "src/bin/lttng-sessiond/*.cpp",
        "src/bin/lttng-sessiond/*.hpp",
    ]),
    copts = _COMMON_COPTS,
    data = [":lttng-consumerd"],
    linkopts = [
        "-rdynamic",
        "-ldl",
        "-lpthread",
        "-lrt",
    ],
    local_defines = [
        'INSTALL_BIN_PATH=\\"bin\\"',
        'INSTALL_LIB_PATH=\\"lib\\"',
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":common_gpl_lib",
        ":internal_headers",
        ":lttng-ctl",
        "@libuuid",
        "@libxml2",
        "@lttng-ust//:lttng-ust-ctl",
        "@popt",
        "@userspace_rcu",
        "@userspace_rcu//:urcu-cds",
    ],
)
