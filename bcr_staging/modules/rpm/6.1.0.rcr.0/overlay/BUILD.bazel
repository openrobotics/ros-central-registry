# Mirrors the probes in upstream CMakeLists.txt (OPTFUNCS/REQFUNCS, OPTINCS,
# check_symbol_exists), evaluated against Bazel's configured cc_toolchain.
# Features that are compiled out of this build (WITH_*, ENABLE_PLUGINS, NLS,
# OpenMP, readline, libelf/libdw, ...) are intentionally left undefined.
autoconf(
    name = "config_checks",
    checks = [
        checks.AC_DEFINE("_GNU_SOURCE", 1),

        # project(rpm VERSION 6.1.0 HOMEPAGE_URL "http://rpm.org")
        checks.AC_DEFINE("PACKAGE", '"rpm"'),
        checks.AC_DEFINE("VERSION", '"6.1.0"'),
        checks.AC_DEFINE("PACKAGE_BUGREPORT", '"http://rpm.org"'),
        checks.AC_DEFINE("RPM_VENDOR", '"vendor"'),
        checks.AC_DEFINE("RUNDIR", "/run"),

        # id0name() falls back to "root"; ENABLE_CUTF8 defaults ON.
        checks.AC_DEFINE("UID_0_USER", '"root"'),
        checks.AC_DEFINE("GID_0_GROUP", '"root"'),
        checks.AC_DEFINE("C_LOCALE", '"C.UTF-8"'),

        # Database backends built here.
        checks.AC_DEFINE("ENABLE_NDB", 1),
        checks.AC_DEFINE("ENABLE_SQLITE", 1),

        # Set by CMake from find_package() results; the matching libraries
        # are unconditional bazel_deps of this module.
        checks.AC_DEFINE("HAVE_BZLIB_H", 1),
        checks.AC_DEFINE("HAVE_ICONV", 1),
        checks.AC_DEFINE("HAVE_LZMA_H", 1),
        checks.AC_DEFINE("HAVE_ZSTD", 1),

        # check_symbol_exists(GLOB_ONLYDIR "glob.h" ...) and
        # check_symbol_exists(major "sys/sysmacros.h" ...).
        # rpm tests these with #ifdef, so a failed probe must leave them
        # undefined (AC_CHECK_DECL would emit "#define X 0" instead).
        checks.AC_TRY_COMPILE(
            name = "rpm_cv_glob_onlydir",
            code = "#include <glob.h>\nint main(void) { int x = GLOB_ONLYDIR; (void)x; return 0; }\n",
            compile_defines = ["_GNU_SOURCE"],
            define = "HAVE_GLOB_ONLYDIR",
        ),
        checks.AC_TRY_COMPILE(
            name = "rpm_cv_major_in_sysmacros",
            code = "#include <sys/sysmacros.h>\nint main(void) { return (int) major(0); }\n",
            compile_defines = ["_GNU_SOURCE"],
            define = "MAJOR_IN_SYSMACROS",
        ),
    ] + macros.AC_CHECK_HEADERS([
        # OPTINCS
        "getopt.h",
        "limits.h",
        "sys/auxv.h",
        "sys/param.h",
        "sys/systemcfg.h",
        "sys/utsname.h",
        "unistd.h",
    ]) + macros.AC_CHECK_FUNCS([
        # OPTFUNCS
        "__progname",
        "__secure_getenv",
        "close_range",
        "fdatasync",
        "getauxval",
        "lutimes",
        "mempcpy",
        "mergesort",
        "mremap",
        "putenv",
        "sched_getaffinity",
        "secure_getenv",
        "setprogname",
        "strchrnul",
        "syncfs",
        "unshare",
        # REQFUNCS (stpcpy/stpncpy appear in both lists upstream)
        "basename",
        "dirname",
        "fchmodat",
        "fchownat",
        "fstatat",
        "getaddrinfo",
        "getcwd",
        "getline",
        "linkat",
        "localtime_r",
        "mkdirat",
        "mkfifoat",
        "mknodat",
        "mkstemp",
        "openat",
        "realpath",
        "regcomp",
        "renameat",
        "setenv",
        "statvfs",
        "stpcpy",
        "stpncpy",
        "symlinkat",
        "unlinkat",
        "unsetenv",
        "utimensat",
        "utimes",
    ]),
)

# Upstream's config.h.in uses #cmakedefine, which rules_cc_autoconf cannot
# consume, so the overlay carries an equivalent autoheader-style template.
autoconf_hdr(
    name = "config_h",
    out = "misc/config.h",
    template = "config.h.in",
    deps = [":config_checks"],
)

genrule(
    name = "tagtbl_inc",
    srcs = [
        "include/rpm/rpmtag.h",
        "lib/gentagtbl.sh",
    ],
    outs = ["lib/tagtbl.inc"],
    cmd = "AWK=awk $(location lib/gentagtbl.sh) $(location include/rpm/rpmtag.h) > $@",
)

COMMON_COPTS = [
    "-Wall",
    "-Wpointer-arith",
    "-Wempty-body",
    "-Wformat-security",
    "-fno-strict-overflow",
    "-fno-delete-null-pointer-checks",
]

CXX_COPTS = COMMON_COPTS + [
    "-std=gnu++20",
]

C_COPTS = COMMON_COPTS + [
    "-std=gnu99",
]

COMMON_DEFINES = [
    "_GNU_SOURCE",
    "_FILE_OFFSET_BITS=64",
    "HAVE_CONFIG_H",
]

cc_library(
    name = "rpm_headers",
    hdrs = glob([
        "include/rpm/*.h",
        "misc/*.h",
    ]) + [":misc/config.h"],
    defines = COMMON_DEFINES,
    includes = [
        "include",
        "misc",
    ],
)

