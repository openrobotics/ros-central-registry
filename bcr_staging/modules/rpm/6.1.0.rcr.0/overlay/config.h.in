/* config.h.in for the Bazel build of rpm 6.1.0.
 *
 * Mechanically derived from upstream's top-level config.h.in, which uses
 * CMake's #cmakedefine syntax that rules_cc_autoconf does not parse: every
 * "#cmakedefine X @X@" / "#define X \"@X@\"" slot is rewritten as an
 * autoheader-style "#undef X". Values come from the checks in BUILD.bazel.
 */
