load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load(
    ":wx_files.bzl",
    "WX_AUI_SRCS",
    "WX_BASE_SRCS",
    "WX_CORE_SRCS",
    "WX_GL_SRCS",
    "WX_HTML_SRCS",
    "WX_XML_SRCS",
)

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:LGPL-2.0-or-later",
    ],
    license_text = "docs/licence.txt",
)

cc_library(
    name = "headers",
    hdrs = glob([
        "include/**/*.h",
    ]),
    defines = [
        "_FILE_OFFSET_BITS=64",
        "__WXQT__",
    ],
    includes = ["include"],
    textual_hdrs = glob([
        "include/**/*.cpp",
    ]),
)

alias(
    name = "wxregex",
    actual = "//3rdparty/pcre:wxregex",
)

cc_library(
    name = "wxbase",
    srcs = WX_BASE_SRCS,
    copts = ["-Wno-deprecated-declarations"],
    linkopts = [
        "-ldl",
        "-lpthread",
    ],
    local_defines = [
        "WXBUILDING",
        "__WX__",
        "wxUSE_BASE=1",
        "wxUSE_GUI=0",
    ],
    textual_hdrs = glob([
        "src/**/*.inc",
        "src/**/*.h",
        "src/**/*.cpp",
    ]),
    deps = [
        ":headers",
        ":wxregex",
        "@qtbase//:core",
        "@zlib",
    ],
)

cc_library(
    name = "wxcore",
    srcs = WX_CORE_SRCS,
    copts = ["-Wno-deprecated-declarations"],
    includes = ["3rdparty/nanosvg/src"],
    local_defines = [
        "WXBUILDING",
        "__WX__",
        "wxUSE_BASE=0",
        "wxUSE_GUI=1",
    ],
    textual_hdrs = glob(
        [
            "3rdparty/nanosvg/src/*.h",
            "art/**/*.cpp",
            "art/**/*.h",
            "art/**/*.xpm",
            "src/**/*.inc",
            "src/**/*.h",
            "src/**/*.cpp",
            "src/**/*.xbm",
            "src/**/*.xpm",
        ],
        allow_empty = True,
    ),
    deps = [
        ":headers",
        ":wxbase",
        "@libjpeg_turbo//:jpeg",
        "@libpng",
        "@libtiff//:tiff",
        "@libwebp",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtbase//:opengl",
        "@qtbase//:openglwidgets",
        "@qtbase//:printsupport",
        "@qtbase//:test",
        "@qtbase//:widgets",
    ],
)

cc_library(
    name = "wxgl",
    srcs = WX_GL_SRCS,
    local_defines = [
        "WXBUILDING",
        "__WX__",
        "wxUSE_BASE=0",
        "wxUSE_GUI=1",
    ],
    deps = [
        ":wxbase",
        ":wxcore",
        "@glu",
        "@libglvnd//:glx_headers",
        "@qtbase//:opengl",
        "@qtbase//:openglwidgets",
    ],
)

cc_library(
    name = "wxaui",
    srcs = WX_AUI_SRCS,
    local_defines = [
        "WXBUILDING",
        "__WX__",
        "wxUSE_BASE=0",
        "wxUSE_GUI=1",
    ],
    deps = [
        ":wxbase",
        ":wxcore",
    ],
)

cc_library(
    name = "wxhtml",
    srcs = WX_HTML_SRCS,
    local_defines = [
        "WXBUILDING",
        "__WX__",
        "wxUSE_BASE=0",
        "wxUSE_GUI=1",
    ],
    deps = [
        ":wxbase",
        ":wxcore",
    ],
)

cc_library(
    name = "wxxml",
    srcs = WX_XML_SRCS,
    local_defines = [
        "WXBUILDING",
        "__WX__",
        "wxUSE_BASE=1",
        "wxUSE_GUI=0",
    ],
    deps = [
        ":wxbase",
        "@libexpat",
    ],
)

cc_library(
    name = "wxwidgets",
    deps = [
        ":headers",
        ":wxaui",
        ":wxbase",
        ":wxcore",
        ":wxgl",
        ":wxhtml",
        ":wxxml",
    ],
)
