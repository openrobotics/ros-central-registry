load("@qt//:qt.bzl", "common_copts")
load("@qt//:qt_internal_library.bzl", "qt_internal_library", "qt_static_plugin")
load("@qt//:qt_tools.bzl", "qt_generate_qrc", "qt_qml_plugin_gen", "qt_rcc_internal", "qt_sync_headers", "qt_write_file")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:LGPL-3.0-only"],
    license_text = "LICENSES/LGPL-3.0-only.txt",
)

exports_files(["MODULE.bazel"])

_COMMON_DEFINES = [
    "QT_ASCII_CAST_WARNINGS",
    "QT_BUILDING_QT",
    "QT_DEPRECATED_WARNINGS",
    "QT_EXPLICIT_QFILE_CONSTRUCTION_FROM_PATH",
    "QT_MOC_COMPAT",
    "QT_NO_CAST_TO_ASCII",
    "QT_NO_CONTEXTLESS_CONNECT=1",
    "QT_NO_DEBUG",
    "QT_NO_EXCEPTIONS",
    "QT_NO_FOREACH=1",
    "QT_NO_JAVA_STYLE_ITERATORS",
    "QT_NO_NARROWING_CONVERSIONS_IN_CONNECT",
    "QT_NO_QASCONST=1",
    "QT_NO_QEXCHANGE",
    "QT_NO_QSNPRINTF",
    "QT_USE_QSTRINGBUILDER",
    "_GLIBCXX_ASSERTIONS",
    "_LARGEFILE64_SOURCE",
    "_LARGEFILE_SOURCE",
]

qt_write_file(
    name = "gen_webchannel_exports",
    out = "generated_cfg/include/QtWebChannel/qtwebchannelexports.h",
    content = """// Generated by Bazel
#ifndef QTWEBCHANNELEXPORTS_H
#define QTWEBCHANNELEXPORTS_H

#include <QtCore/qcompilerdetection.h>
#include <QtCore/qtconfigmacros.h>
#include <QtCore/qtdeprecationmarkers.h>

#if defined(QT_SHARED) || !defined(QT_STATIC)
#  if defined(QT_BUILD_WEBCHANNEL_LIB)
#    define Q_WEBCHANNEL_EXPORT Q_DECL_EXPORT
#  else
#    define Q_WEBCHANNEL_EXPORT Q_DECL_IMPORT
#  endif
#else
#  define Q_WEBCHANNEL_EXPORT
#endif

#define QT_WEBCHANNEL_REMOVED_SINCE(major, minor) 0

#endif // QTWEBCHANNELEXPORTS_H
""",
)

qt_write_file(
    name = "gen_webchannelquick_exports",
    out = "generated_cfg/include/QtWebChannelQuick/qtwebchannelquickexports.h",
    content = """// Generated by Bazel
#ifndef QTWEBCHANNELQUICKEXPORTS_H
#define QTWEBCHANNELQUICKEXPORTS_H

#include <QtCore/qcompilerdetection.h>
#include <QtCore/qtconfigmacros.h>
#include <QtCore/qtdeprecationmarkers.h>

#if defined(QT_SHARED) || !defined(QT_STATIC)
#  if defined(QT_BUILD_WEBCHANNELQUICK_LIB)
#    define Q_WEBCHANNELQUICK_EXPORT Q_DECL_EXPORT
#  else
#    define Q_WEBCHANNELQUICK_EXPORT Q_DECL_IMPORT
#  endif
#else
#  define Q_WEBCHANNELQUICK_EXPORT
#endif

#define QT_WEBCHANNELQUICK_REMOVED_SINCE(major, minor) 0

#endif // QTWEBCHANNELQUICKEXPORTS_H
""",
)

cc_library(
    name = "webchannel_cfg",
    hdrs = [
        ":gen_webchannel_exports",
        ":gen_webchannelquick_exports",
    ],
    includes = [
        "generated_cfg/include",
        "generated_cfg/include/QtWebChannel",
        "generated_cfg/include/QtWebChannelQuick",
    ],
)

qt_sync_headers(
    name = "webchannel_sync_headers",
    srcs = glob(["src/webchannel/*.h"]),
    dep_modules = ["QtCore"],
    module_name = "QtWebChannel",
    source_dir = "src/webchannel",
)

qt_generate_qrc(
    name = "webchannel_resources_qrc",
    srcs = ["examples/webchannel/shared/qwebchannel.js"],
    out = "webchannel_resources.qrc",
    prefix = "/qtwebchannel/",
)

qt_rcc_internal(
    name = "webchannel_resources_rcc",
    data = ["examples/webchannel/shared/qwebchannel.js"],
    qrc = ":webchannel_resources_qrc",
    qrc_name = "resources",
)

qt_internal_library(
    name = "webchannel",
    srcs = [
        "src/webchannel/qmetaobjectpublisher.cpp",
        "src/webchannel/qwebchannel.cpp",
        "src/webchannel/qwebchannelabstracttransport.cpp",
        ":webchannel_resources_rcc",
    ],
    hdrs = glob(["src/webchannel/*.h"]) + [":webchannel_sync_headers"],
    copts = common_copts + ["-std=gnu++20"],
    create_shared = True,
    defines = ["QT_WEBCHANNEL_LIB"],
    dynamic_deps = [
        "@qtbase//:core_shared",
        "@qtdeclarative//:qml_shared",
    ],
    includes = ["src/webchannel"],
    local_defines = _COMMON_DEFINES + ["QT_BUILD_WEBCHANNEL_LIB"],
    moc_hdrs = [
        "src/webchannel/qmetaobjectpublisher_p.h",
        "src/webchannel/qwebchannel.h",
        "src/webchannel/qwebchannelabstracttransport.h",
    ],
    moc_unity = True,
    deps = [
        ":webchannel_cfg",
        "@qtbase//:core",
        "@qtdeclarative//:qml",
    ],
)

qt_sync_headers(
    name = "webchannelquick_sync_headers",
    srcs = glob(["src/webchannelquick/*.h"]),
    dep_modules = [
        "QtCore",
        "QtWebChannel",
        "QtQml",
    ],
    module_name = "QtWebChannelQuick",
    source_dir = "src/webchannelquick",
)

qt_internal_library(
    name = "webchannelquick",
    srcs = [
        "src/webchannelquick/qqmlwebchannel.cpp",
        "src/webchannelquick/qqmlwebchannelattached.cpp",
    ],
    hdrs = glob(["src/webchannelquick/*.h"]) + [":webchannelquick_sync_headers"],
    copts = common_copts + ["-std=gnu++20"],
    create_shared = True,
    defines = ["QT_WEBCHANNELQUICK_LIB"],
    dynamic_deps = [
        ":webchannel_shared",
        "@qtbase//:core_shared",
        "@qtdeclarative//:qml_shared",
    ],
    includes = ["src/webchannelquick"],
    local_defines = _COMMON_DEFINES + ["QT_BUILD_WEBCHANNELQUICK_LIB"],
    moc_hdrs = [
        "src/webchannelquick/qqmlwebchannel.h",
        "src/webchannelquick/qqmlwebchannelattached_p.h",
    ],
    moc_unity = True,
    qml_args = {
        "foreign_types": [
            "@qtbase//:core_moc_hdrs",
            "@qtdeclarative//:qml_moc_hdrs",
            ":webchannel_moc_hdrs",
        ],
        "import_name": "QtWebChannel",
        "past_major_versions": ["1"],
        "qmldir": """module QtWebChannel
linktarget webchannelquickplugin
optional plugin webchannelquickplugin
classname QtWebChannelQuickPlugin
typeinfo plugins.qmltypes
prefer :/qt-project.org/imports/QtWebChannel/
""",
    },
    deps = [
        ":webchannel",
        ":webchannel_cfg",
        "@qtbase//:core",
        "@qtdeclarative//:qml",
    ],
)

qt_qml_plugin_gen(
    name = "webchannelquickplugin_gen",
    class_name = "QtWebChannelQuickPlugin",
    plugin_name = "webchannelquickplugin",
    uri = "QtWebChannel",
)

qt_static_plugin(
    name = "webchannelquickplugin",
    srcs = [":webchannelquickplugin_gen"],
    copts = common_copts + ["-std=gnu++20"],
    local_defines = _COMMON_DEFINES + ["QT_PLUGIN"],
    moc_srcs = [":webchannelquickplugin_gen"],
    moc_unity = True,
    plugin_class_name = "QtWebChannelQuickPlugin",
    deps = [
        ":webchannel",
        ":webchannelquick",
        "@qtbase//:core",
        "@qtdeclarative//:qml",
    ],
)
