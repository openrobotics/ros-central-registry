OpenSSL 4.0 changed X509_get_subject_name() to return `const X509_NAME *`.
Every use of the result here is already const-correct (X509_NAME_oneline,
X509_NAME_digest and X509_NAME_print_ex all take `const X509_NAME *`), so
holding the pointer as const is source-compatible with OpenSSL 1.1, 3.x and 4.x.

diff -ru a/src/cpp/security/artifact_providers/FileProvider.cpp b/src/cpp/security/artifact_providers/FileProvider.cpp
--- a/src/cpp/security/artifact_providers/FileProvider.cpp
+++ b/src/cpp/security/artifact_providers/FileProvider.cpp
@@ -77,7 +77,7 @@
                             // Retrieve subject name for future use.
                             if (ca_sn.empty())
                             {
-                                X509_NAME* ca_subject_name = X509_get_subject_name(itmp->x509);
+                                const X509_NAME* ca_subject_name = X509_get_subject_name(itmp->x509);
                                 assert(ca_subject_name != nullptr);
                                 char* ca_subject_name_str = X509_NAME_oneline(ca_subject_name, 0, 0);
                                 assert(ca_subject_name_str != nullptr);
