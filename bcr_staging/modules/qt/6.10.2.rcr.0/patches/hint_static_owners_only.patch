@@ -115,6 +123,11 @@ def _qt_linkable_more_than_once_hint_impl(ctx):
             owners.append(d.label)
         if CcInfo in d:
             for li in d[CcInfo].linking_context.linker_inputs.to_list():
+                # Dynamic-only inputs and inputs from other repositories (e.g.
+                # the toolchain's C++ runtime, present in every CcInfo) must
+                # not be claimed here, as that would clash across hints.
