"""Bazel build for @qttranslations (compiles all .ts catalogs to .qm via @qttools//:lrelease)."""

load("@qt//:qt_tools.bzl", "qt_translation", "qt_write_file")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
    license_text = "LICENSES/BSD-3-Clause.txt",
)

exports_files([
    "LICENSES/BSD-3-Clause.txt",
])

_EN_CATALOGS = [
    "assistant",
    "designer",
    "linguist",
    "qt",
    "qt_help",
    "qtbase",
    "qtconnectivity",
    "qtdeclarative",
    "qtlocation",
    "qtmultimedia",
    "qtserialport",
    "qtwebengine",
    "qtwebsockets",
]

[
    qt_write_file(
        name = "gen_" + catalog + "_en_ts",
        out = "translations/" + catalog + "_en.ts",
        content = '<TS language="en_US"></TS>\n',
    )
    for catalog in _EN_CATALOGS
]

qt_translation(
    name = "translations",
    srcs = glob(["translations/*.ts"]) + [
        ":gen_" + catalog + "_en_ts"
        for catalog in _EN_CATALOGS
    ],
)

filegroup(
    name = "qm_files",
    srcs = [":translations"],
)
