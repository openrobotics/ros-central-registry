load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:LGPL-2.1-or-later",
    ],
    license_text = "COPYING.txt",
)

genrule(
    name = "libusb_compat_header",
    outs = ["_libusb_compat/libusb-1.0/libusb.h"],
    cmd = "printf '#pragma once\\n#include <libusb.h>\\n' > $@",
)

cc_library(
    name = "libusb_prefixed_headers",
    hdrs = [":libusb_compat_header"],
    includes = ["_libusb_compat"],
)

cc_library(
    name = "libiio",
    srcs = [
        "backend.c",
        "buffer.c",
        "channel.c",
        "context.c",
        "deps/libini/libini.c",
        "device.c",
        "dns_sd.c",
        "dns_sd_avahi.c",
        "iiod-client.c",
        "local.c",
        "lock.c",
        "network.c",
        "network-unix.c",
        "scan.c",
        "sort.c",
        "usb.c",
        "utilities.c",
        "xml.c",
    ],
    hdrs = [
        "bindings/cpp/iiopp.h",
        "iio.h",
    ],
    includes = [
        ".",
        "bindings/cpp",
    ],
    linkopts = [
        "-lpthread",
        "-lrt",
    ],
    local_defines = ["_GNU_SOURCE=1"],
    textual_hdrs = glob([
        "*.h",
        "deps/libini/*.h",
    ]),
    deps = [
        ":libusb_prefixed_headers",
        "@avahi",
        "@libusb",
        "@libxml2",
    ],
)
