bazel_dep(name = "apple_support", version = "2.3.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "opencv")
bazel_dep(name = "qt", version = "6.10.2.rcr.0")
bazel_dep(name = "qtbase", version = "6.10.2.rcr.0")

local_path_override(
    module_name = "opencv",
    path = "..",
)

new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_local_repository(
    name = "ubuntu-gtk-deps",
    build_file = "//:ubuntu-gtk-deps.BUILD.bazel",
    path = "/",
)
