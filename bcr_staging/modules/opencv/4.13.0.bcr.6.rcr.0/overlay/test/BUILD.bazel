load("@qt//:qt.bzl", "qt_cc_test")

# Exercises the Qt6 highgui backend; build/run with --@opencv//:with_qt=True.
qt_cc_test(
    name = "qt6_smoke_test",
    srcs = ["qt6_smoke_test.cpp"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    target_compatible_with = select({
        "@opencv//:have_qt": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@opencv//:core",
        "@opencv//:highgui",
        "@qtbase//:offscreen",
    ],
)
