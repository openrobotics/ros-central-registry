-  strcpy(WEBOTS_HOME, getenv("WEBOTS_HOME"));
-  return true;
+static bool get_webots_home(const char *argv0) {
+  const char *env_home = getenv("WEBOTS_HOME");
+  if (env_home && env_home[0] != '\0') {
+    WEBOTS_HOME = strdup(env_home);
+    return true;
+  }
+  char candidate[4096];
+  char version_file[4096];
+  const char *runfiles_dir = getenv("RUNFILES_DIR");
+  const char *test_srcdir = getenv("TEST_SRCDIR");
+  const char *suffixes[] = {"webots+", "_main"};
+  if (argv0 && argv0[0] != '\0') {
+    for (int i = 0; i < 2; ++i) {
+      snprintf(candidate, sizeof(candidate), "%s.runfiles/%s", argv0, suffixes[i]);
+      snprintf(version_file, sizeof(version_file), "%s/resources/version.txt", candidate);
+      if (access(version_file, F_OK) == 0) {
+        WEBOTS_HOME = strdup(candidate);
+        return true;
+      }
+    }
+  }
+  const char *env_dirs[] = {runfiles_dir, test_srcdir};
+  for (int d = 0; d < 2; ++d) {
+    if (!env_dirs[d] || env_dirs[d][0] == '\0')
+      continue;
+    for (int i = 0; i < 2; ++i) {
+      snprintf(candidate, sizeof(candidate), "%s/%s", env_dirs[d], suffixes[i]);
+      snprintf(version_file, sizeof(version_file), "%s/resources/version.txt", candidate);
+      if (access(version_file, F_OK) == 0) {
+        WEBOTS_HOME = strdup(candidate);
+        return true;
+      }
+    }
+  }
+  if (argv0 && argv0[0] != '\0') {
+    char *dir = strdup(argv0);
+    char *slash = strrchr(dir, PATH_SEPARATOR[0]);
+    if (slash) {
+      *slash = '\0';
+      snprintf(version_file, sizeof(version_file), "%s/resources/version.txt", dir);
+      if (access(version_file, F_OK) == 0) {
+        WEBOTS_HOME = dir;
+        return true;
+      }
+    }
+    free(dir);
+  }
+  fprintf(stderr, "Set the path to your webots installation folder in WEBOTS_HOME environment variable.\n");
+  return false;
 }
 
