load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

_RPATH_FLAGS = select({
    "@platforms//os:linux": ["-Wl,-rpath,$ORIGIN"],
    "@platforms//os:macos": ["-Wl,-rpath,@loader_path"],
    "//conditions:default": [],
})

cc_shared_library(
    name = "Controller",
    user_link_flags = _RPATH_FLAGS,
    deps = ["//:Controller"],
)

cc_shared_library(
    name = "CppController",
    dynamic_deps = [":Controller"],
    user_link_flags = _RPATH_FLAGS,
    deps = ["//:CppController"],
)

cc_shared_library(
    name = "car",
    dynamic_deps = [":Controller"],
    user_link_flags = _RPATH_FLAGS,
    deps = ["//:car"],
)

cc_shared_library(
    name = "driver",
    dynamic_deps = [
        ":Controller",
        ":car",
    ],
    user_link_flags = _RPATH_FLAGS,
    deps = ["//:driver"],
)

cc_shared_library(
    name = "CppDriver",
    dynamic_deps = [
        ":Controller",
        ":CppController",
        ":car",
        ":driver",
    ],
    user_link_flags = _RPATH_FLAGS,
    deps = ["//:CppDriver"],
)

cc_shared_library(
    name = "CppCar",
    dynamic_deps = [
        ":Controller",
        ":CppController",
        ":CppDriver",
        ":car",
        ":driver",
    ],
    user_link_flags = _RPATH_FLAGS,
    deps = ["//:CppCar"],
)

cc_shared_library(
    name = "generic_robot_window",
    dynamic_deps = [":Controller"],
    user_link_flags = _RPATH_FLAGS,
    deps = ["//:generic_robot_window"],
)

py_library(
    name = "controller_py",
    srcs = [
        "python/controller/__init__.py",
        "python/controller/accelerometer.py",
        "python/controller/altimeter.py",
        "python/controller/ansi_codes.py",
        "python/controller/brake.py",
        "python/controller/camera.py",
        "python/controller/compass.py",
        "python/controller/connector.py",
        "python/controller/constants.py",
        "python/controller/device.py",
        "python/controller/display.py",
        "python/controller/distance_sensor.py",
        "python/controller/emitter.py",
        "python/controller/field.py",
        "python/controller/gps.py",
        "python/controller/gyro.py",
        "python/controller/inertial_unit.py",
        "python/controller/joystick.py",
        "python/controller/keyboard.py",
        "python/controller/led.py",
        "python/controller/lidar.py",
        "python/controller/lidar_point.py",
        "python/controller/light_sensor.py",
        "python/controller/motion.py",
        "python/controller/motor.py",
        "python/controller/mouse.py",
        "python/controller/node.py",
        "python/controller/pen.py",
        "python/controller/position_sensor.py",
        "python/controller/proto.py",
        "python/controller/radar.py",
        "python/controller/radar_target.py",
        "python/controller/range_finder.py",
        "python/controller/receiver.py",
        "python/controller/robot.py",
        "python/controller/sensor.py",
        "python/controller/skin.py",
        "python/controller/speaker.py",
        "python/controller/supervisor.py",
        "python/controller/touch_sensor.py",
        "python/controller/vacuum_gripper.py",
        "python/controller/wb.py",
    ],
    data = [
        ":Controller",
        ":generic_robot_window",
    ],
    imports = ["python"],
)

py_library(
    name = "vehicle_py",
    srcs = [
        "python/vehicle/__init__.py",
        "python/vehicle/car.py",
        "python/vehicle/driver.py",
    ],
    data = [
        ":Controller",
        ":car",
        ":driver",
    ],
    imports = ["python"],
    deps = [":controller_py"],
)
