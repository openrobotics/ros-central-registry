    ],
    outs = [
        "resources/translations/qt_de.qm",
        "resources/translations/qt_es.qm",
        "resources/translations/qt_fr.qm",
        "resources/translations/qt_it.qm",
        "resources/translations/qt_ja_JP.qm",
        "resources/translations/qt_zh_CN.qm",
        "resources/translations/wb_de.qm",
        "resources/translations/wb_es.qm",
