py_binary(
    name = "generate_proto_list",
    srcs = ["scripts/packaging/generate_proto_list.py"],
    main = "scripts/packaging/generate_proto_list.py",
    visibility = ["//visibility:private"],
)

genrule(
    name = "proto_list_xml",
    srcs = glob([
        "projects/**/*.proto",
        "resources/nodes/*.wrl",
    ]),
    outs = ["resources/proto-list.xml"],
    cmd = """
        TMP_WH=$$(mktemp -d)
        mkdir -p "$$TMP_WH/resources"
        for f in $(SRCS); do
            case "$$f" in
                */projects/*)
                    SRC_ROOT="$${f%%/projects/*}"
                    break
                    ;;
                projects/*)
                    SRC_ROOT="."
                    break
                    ;;
            esac
        done
        ln -sf "$$PWD/$$SRC_ROOT/projects" "$$TMP_WH/projects"
        ln -sf "$$PWD/$$SRC_ROOT/resources/nodes" "$$TMP_WH/resources/nodes"
        WEBOTS_HOME="$$TMP_WH" $(execpath :generate_proto_list)
        cp "$$TMP_WH/resources/proto-list.xml" "$@"
        rm -rf "$$TMP_WH"
    """,
    tools = [":generate_proto_list"],
)

