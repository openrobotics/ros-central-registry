        "resources/pico/lang/en-US_lh0_sg.bin",
        "resources/pico/lang/en-US_ta.bin",
        "resources/pico/lang/es-ES_ta.bin",
        "resources/pico/lang/es-ES_zl0_sg.bin",
        "resources/pico/lang/fr-FR_nk0_sg.bin",
        "resources/pico/lang/fr-FR_ta.bin",
        "resources/pico/lang/it-IT_cm0_sg.bin",
        "resources/pico/lang/it-IT_ta.bin",
    ],
    cmd = """
        mkdir -p "$(RULEDIR)/resources/pico/lang"
        for src in $(SRCS); do
            cp "$$src" "$(RULEDIR)/resources/pico/lang/$$(basename "$$src")"
        done
    """,
)

