load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

cc_library(
    name = "generic_lib",
    srcs = ["generic.c"],
    deps = [
        "//:Controller",
        "//:generic_robot_window",
    ],
)

cc_shared_library(
    name = "generic",
    dynamic_deps = [
        "//lib/controller:Controller",
        "//lib/controller:generic_robot_window",
    ],
    user_link_flags = select({
        "@platforms//os:linux": ["-Wl,-rpath,$ORIGIN/../../../../../lib/controller"],
        "@platforms//os:macos": ["-Wl,-rpath,@loader_path/../../../../../lib/controller"],
        "//conditions:default": [],
    }),
    deps = [":generic_lib"],
)

filegroup(
    name = "runtime_files",
    srcs = [
        "canvas.js",
        "device_widget.js",
        "generic.css",
        "generic.html",
        "generic.js",
        "plot_widget.js",
        "radar_widget.js",
        "timeplot_line.js",
        "timeplot_widget.js",
        "window_manager.js",
        ":generic",
    ],
)
