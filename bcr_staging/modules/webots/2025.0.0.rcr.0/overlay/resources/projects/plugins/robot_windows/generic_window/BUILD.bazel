load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

cc_library(
    name = "generic_window_lib",
    srcs = [
        "entry_points.cpp",
        "entry_points.hpp",
    ],
    deps = [
        "//:Controller",
        "//resources/projects/libraries/qt_utils:qt_utils_lib",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtbase//:widgets",
    ],
)

cc_shared_library(
    name = "generic_window",
    dynamic_deps = [
        "//lib/controller:Controller",
        "//resources/projects/libraries/qt_utils",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:widgets_shared",
    ] + select({
        "@platforms//os:linux": [
            "@qtbase//:dbus_shared",
            "@qtbase//:x11_shared",
        ],
        "//conditions:default": [],
    }),
    user_link_flags = select({
        "@platforms//os:linux": [
            "-Wl,-rpath,$ORIGIN/../../../libraries/qt_utils",
            "-Wl,-rpath,$ORIGIN/../../../../../lib/controller",
        ],
        "@platforms//os:macos": [
            "-Wl,-rpath,@loader_path/../../../libraries/qt_utils",
            "-Wl,-rpath,@loader_path/../../../../../lib/controller",
        ],
        "//conditions:default": [],
    }),
    deps = [":generic_window_lib"],
)
