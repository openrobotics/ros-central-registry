load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

_MOC_FLAG = select({
    "@platforms//os:linux": "-D__linux__",
    "@platforms//os:macos": "-D__APPLE__",
    "@platforms//os:windows": "-D_WIN32",
})

genrule(
    name = "qt_utils_moc",
    srcs = [
        "core/MainApplication.hpp",
        "gui/GenericWindow.hpp",
        "motion_editor/AddStateDialog.hpp",
        "motion_editor/ListWidget.hpp",
        "motion_editor/Motion.hpp",
        "motion_editor/MotionEditor.hpp",
        "motion_editor/MotionPlayer.hpp",
        "motion_editor/MotionWidget.hpp",
        "motion_editor/MotorTargetState.hpp",
        "motion_editor/MotorTargetStateWidget.hpp",
        "motion_editor/Pose.hpp",
        "motion_editor/PoseEditor.hpp",
        "motion_editor/PoseWidget.hpp",
        "widgets/AccelerometerWidget.hpp",
        "widgets/CameraWidget.hpp",
        "widgets/CompassWidget.hpp",
        "widgets/DistanceSensorWidget.hpp",
        "widgets/GPSWidget.hpp",
        "widgets/GyroWidget.hpp",
        "widgets/InertialUnitWidget.hpp",
        "widgets/LidarWidget.hpp",
        "widgets/LightSensorWidget.hpp",
        "widgets/MotorWidget.hpp",
        "widgets/PositionSensorWidget.hpp",
        "widgets/RadarWidget.hpp",
        "widgets/RangeFinderWidget.hpp",
        "widgets/SensorWidget.hpp",
        "widgets/TouchSensorScalarWidget.hpp",
        "widgets/TouchSensorVectorialWidget.hpp",
        "widgets/VectorialSensorWidget.hpp",
    ],
    outs = [
        "AddStateDialog.moc.cpp",
        "AccelerometerWidget.moc.cpp",
        "CameraWidget.moc.cpp",
        "CompassWidget.moc.cpp",
        "DistanceSensorWidget.moc.cpp",
        "GPSWidget.moc.cpp",
        "GenericWindow.moc.cpp",
        "GyroWidget.moc.cpp",
        "InertialUnitWidget.moc.cpp",
        "LidarWidget.moc.cpp",
        "LightSensorWidget.moc.cpp",
        "ListWidget.moc.cpp",
        "MainApplication.moc.cpp",
        "Motion.moc.cpp",
        "MotionEditor.moc.cpp",
        "MotionPlayer.moc.cpp",
        "MotionWidget.moc.cpp",
        "MotorTargetState.moc.cpp",
        "MotorTargetStateWidget.moc.cpp",
        "MotorWidget.moc.cpp",
        "Pose.moc.cpp",
        "PoseEditor.moc.cpp",
        "PoseWidget.moc.cpp",
        "PositionSensorWidget.moc.cpp",
        "RadarWidget.moc.cpp",
        "RangeFinderWidget.moc.cpp",
        "SensorWidget.moc.cpp",
        "TouchSensorScalarWidget.moc.cpp",
        "TouchSensorVectorialWidget.moc.cpp",
        "VectorialSensorWidget.moc.cpp",
    ],
    cmd = """
        for src in $(SRCS); do
            base=$$(basename "$$src" .hpp)
            $(execpath @qtbase//:moc) """ + _MOC_FLAG + """ -f "$$base.hpp" "$$src" -o "$(RULEDIR)/$$base.moc.cpp"
        done
    """,
    tools = ["@qtbase//:moc"],
)

