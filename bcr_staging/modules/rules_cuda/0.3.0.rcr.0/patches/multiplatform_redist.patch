+# The redistrib_<version>.json platforms that cuda_component repos are created
+# for, so that CUDA targets can be cross-compiled between them.
+_REDIST_PLATFORMS = ["linux-x86_64", "linux-sbsa", "windows-x86_64"]
+
+def _get_host_platform(ctx):
+    """Returns the redistrib_<version>.json platform of the host, or None.
+
+    NVIDIA does not publish host tools for macOS, so there is no platform for
+    darwin hosts. Windows on Arm hosts run the windows-x86_64 tools under
+    emulation.
+    """
+    if _is_linux(ctx):
+        if ctx.os.arch in ("aarch64", "arm64"):
+            return "linux-sbsa"
+        return "linux-x86_64"
+    if _is_windows(ctx):
+        return "windows-x86_64"
+    return None
+
