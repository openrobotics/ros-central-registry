Tags the CUDA runtime's static archives (libcudadevrt.a, libculibos.a) that
@cuda//:cuda_runtime links with LINKABLE_MORE_THAN_ONCE, so several
cc_shared_librarys in one process (e.g. cuda_buffer and cuda_buffer_backend
in the ROS Central Registry) may each link them, as CMake does.

--- a/cuda/private/templates/BUILD.cudart
+++ b/cuda/private/templates/BUILD.cudart
@@ -6,6 +6,8 @@
 cc_library(
     name = "cudadevrt_a",
     srcs = ["%{component_name}/%{libpath}/libcudadevrt.a"],
+    # Linked into every cc_shared_library that uses the CUDA runtime.
+    tags = ["LINKABLE_MORE_THAN_ONCE"],
     target_compatible_with = ["@platforms//os:linux"],
 )
 
@@ -14,6 +16,8 @@
     cc_library(
         name = "culibos_a",
         srcs = ["%{component_name}/%{libpath}/libculibos.a"],
+        # Linked into every cc_shared_library that uses the CUDA runtime.
+        tags = ["LINKABLE_MORE_THAN_ONCE"],
         target_compatible_with = ["@platforms//os:linux"],
     )
     for name in if_cuda_toolkit_version_ge((13,0), [], ["culibos"])
