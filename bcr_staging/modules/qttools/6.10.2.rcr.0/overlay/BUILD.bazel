        "src/uitools/quiloader_p.h",
        ":uitools_sync_headers",
    ],
    copts = common_copts,
    cxxopts = ["-std=gnu++20"],
    defines = ["QT_UITOOLS_LIB"],
    dynamic_deps = [
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:opengl_shared",
        "@qtbase//:openglwidgets_shared",
        "@qtbase//:widgets_shared",
    ] + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@qtbase//:dbus_shared"],
    }),
    includes = [
        "src/designer/src/lib/uilib",
        "src/uitools",
    ],
    local_defines = COMMON_LOCAL_DEFINES + [
        "QFORMINTERNAL_NAMESPACE",
        "QT_BUILD_UITOOLS_LIB",
        "QT_DESIGNER",
        "QT_DESIGNER_STATIC",
        "QT_NO_CAST_FROM_ASCII",
        "QT_NO_CAST_TO_ASCII",
        "QT_USE_QSTRINGBUILDER",
        "UiTools_EXPORTS",
    ],
    moc_hdrs = [
        "src/designer/src/lib/uilib/properties_p.h",
        "src/uitools/quiloader.h",
    ],
    moc_opts = [
        "-DQFORMINTERNAL_NAMESPACE",
        "-DQT_DESIGNER",
        "-DQT_DESIGNER_STATIC",
    ],
    moc_srcs = [
        "src/uitools/quiloader.cpp",
    ],
    moc_unity = True,
    textual_hdrs = [
        "src/designer/src/lib/uilib/widgets.table",
    ],
    deps = [
        ":uiplugin",
        ":uitools_sync_headers",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtbase//:opengl",
        "@qtbase//:openglwidgets",
        "@qtbase//:widgets",
    ],
)

