        "src/designer/src/lib/uilib/textbuilder.cpp",
        "src/designer/src/lib/uilib/ui4.cpp",
        "src/uitools/quiloader.cpp",
    ],
    hdrs = [
        "src/designer/src/lib/uilib/abstractformbuilder.h",
        "src/designer/src/lib/uilib/formbuilder.h",
        "src/designer/src/lib/uilib/formbuilderextra_p.h",
