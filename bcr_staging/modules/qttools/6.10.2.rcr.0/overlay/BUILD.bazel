"""Bazel build for @qttools (Qt 6.10.2 Tools, Designer, UiTools, Help, Linguist, QDoc)."""

load(
    "@qt//:qt.bzl",
    "qt_cc_binary",
    "qt_generate_qrc",
    "qt_ui_library",
)
load("@qt//:qt_internal_library.bzl", "qt_internal_library", "qt_static_plugin")
load("@qt//:qt_tools.bzl", "qt_sync_headers")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load(":qttools_config.bzl", "declare_qttools_config_targets")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-only",
        "@rules_license//licenses/spdx:LGPL-3.0-only",
    ],
    license_text = "LICENSES/LGPL-3.0-only.txt",
)

license(
    name = "license_llvm_clang_ast",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
    license_text = "src/qdoc/qdoc/src/qdoc/clang/AST/LICENSE.LLVM.txt",
)

license(
    name = "license_gumbo",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
    license_text = "src/assistant/qlitehtml/src/3rdparty/litehtml/src/gumbo/LICENSE",
)

license(
    name = "license_litehtml",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
    license_text = "src/assistant/qlitehtml/src/3rdparty/litehtml/LICENSE",
)

exports_files([
    "LICENSES/LGPL-3.0-only.txt",
    "src/assistant/qlitehtml/src/3rdparty/litehtml/LICENSE",
    "src/assistant/qlitehtml/src/3rdparty/litehtml/src/gumbo/LICENSE",
    "src/qdoc/qdoc/src/qdoc/clang/AST/LICENSE.LLVM.txt",
])

QT_VERSION = "6.10.2"

common_copts = [
    "-w",
    "-fPIC",
    "-DQT_BUILDING_QT",
]

COMMON_LOCAL_DEFINES = [
    "QT_ASCII_CAST_WARNINGS",
    "QT_BUILDING_QT",
    "QT_DEPRECATED_WARNINGS",
    "QT_EXPLICIT_QFILE_CONSTRUCTION_FROM_PATH",
    "QT_MOC_COMPAT",
    "QT_NO_CONTEXTLESS_CONNECT=1",
    "QT_NO_DEBUG",
    "QT_NO_EXCEPTIONS",
    "QT_NO_FOREACH",
    "QT_NO_FOREACH=1",
    "QT_NO_JAVA_STYLE_ITERATORS",
    "QT_NO_NARROWING_CONVERSIONS_IN_CONNECT",
    "QT_NO_QASCONST",
    "QT_NO_QASCONST=1",
    "QT_NO_QEXCHANGE",
    "QT_NO_QSNPRINTF",
    "QT_USE_QSTRINGBUILDER",
    "_GLIBCXX_ASSERTIONS",
    "_LARGEFILE64_SOURCE",
    "_LARGEFILE_SOURCE",
]

declare_qttools_config_targets()

qt_sync_headers(
    name = "tools_private_sync_headers",
    hdrs = [],
    generated_private_hdrs = [
        ":gen_qttools_config_p_h",
    ],
    generated_public_hdrs = [
        ":gen_qttools_config_h",
    ],
    module_name = "QtTools",
    source_dir = "src",
    version = QT_VERSION,
)

cc_library(
    name = "tools_private",
    hdrs = [":tools_private_sync_headers"],
    deps = [":tools_private_sync_headers"],
)

# ============================================================================
# 1. QtUiPlugin (:uiplugin) — header-only module
# ============================================================================

qt_sync_headers(
    name = "uiplugin_sync_headers",
    hdrs = [
        "src/uiplugin/customwidget.h",
        "src/uiplugin/qdesignerexportwidget.h",
    ],
    module_name = "QtUiPlugin",
    source_dir = "src/uiplugin",
    version = QT_VERSION,
    deps = [
        "@qtbase//:core_sync_headers",
        "@qtbase//:gui_sync_headers",
        "@qtbase//:widgets_sync_headers",
    ],
)

qt_internal_library(
    name = "uiplugin",
    hdrs = [
        "src/uiplugin/customwidget.h",
        "src/uiplugin/qdesignerexportwidget.h",
        ":uiplugin_sync_headers",
    ],
    create_shared = False,
    defines = ["QT_UIPLUGIN_LIB"],
    includes = ["src/uiplugin"],
    deps = [
        ":uiplugin_sync_headers",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtbase//:widgets",
    ],
)

# ============================================================================
# 2. QtUiTools (:uitools)
# ============================================================================

qt_sync_headers(
    name = "uitools_sync_headers",
    hdrs = [
        "src/uitools/qtuitoolsglobal.h",
        "src/uitools/quiloader.h",
        "src/uitools/quiloader_p.h",
    ],
    module_name = "QtUiTools",
    source_dir = "src/uitools",
    version = QT_VERSION,
    deps = [
        ":uiplugin_sync_headers",
