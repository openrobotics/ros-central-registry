)

qt_internal_library(
    name = "uitools",
    srcs = [
        "src/designer/src/lib/uilib/abstractformbuilder.cpp",
        "src/designer/src/lib/uilib/formbuilder.cpp",
        "src/designer/src/lib/uilib/formbuilderextra.cpp",
