load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(default_applicable_licenses = [":license"])

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
    license_text = "LICENSE.txt",
)

exports_files(["LICENSE.txt"])

# The single-header Vulkan Memory Allocator. Users include it as
# <vk_mem_alloc.h> or <include/vk_mem_alloc.h> (as PyTorch does), and compile
# its implementation in one translation unit (VMA_IMPLEMENTATION). Without a
# Vulkan headers dependency, so users can pick theirs (e.g. with
# VK_NO_PROTOTYPES for a meta-loader).
cc_library(
    name = "vulkan_memory_allocator",
    hdrs = ["include/vk_mem_alloc.h"],
    includes = [
        ".",
        "include",
    ],
    visibility = ["//visibility:public"],
)
