qt_export_header(
    name = "qtguiexports_h",
    out = "generated_exports/qtguiexports.h",
    module_infix = "GUI",
)

qt_depends_header(
    name = "qtgui_depends_h",
    out = "generated_exports/QtGuiDepends",
    dep_modules = ["QtCore"],
)

qt_sync_headers(
    name = "gui_sync_headers",
    hdrs = glob(["src/gui/**/*.h"]),
    generated_private_hdrs = [
        ":gen_qtgui_config_p_h",
        ":qvulkanfunctions_p_h",
    ],
    generated_public_hdrs = [
        ":gen_qtgui_config_h",
        ":qtguiexports_h",
        ":qtgui_depends_h",
        ":qvulkanfunctions_h",
    ],
    module_name = "QtGui",
    qpa_filter = "^qplatform.+\\.h|^qwindowsystem.+\\.h$",
    # Upstream RHI_HEADER_FILTERS (exact names; the _p.h variants stay in private/).
    rhi_filter = "^(qrhi|qrhi_platform|qshader|qshaderdescription)\\.h$",
    source_dir = "src/gui",
    version = QT_VERSION,
    deps = [
        ":core_sync_headers",
        ":dbus_sync_headers",
        "@egl-registry//:EGL_headers",
        "@opengl-registry//:OpenGL_headers",
        "@vulkan_headers//:vulkan_headers_no_prototypes",
