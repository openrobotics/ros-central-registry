    "//conditions:default": [],
})

common_copts = [
    "-w",
    "-fPIC",
    "-DQT_NO_CAST_TO_ASCII",
    "-DQT_BUILDING_QT",
]

common_defines = [
    "QT_NO_VERSION_TAGGING",
    "QT_VERSION_MAJOR=6",
    "QT_VERSION_MINOR=10",
    "QT_VERSION_PATCH=2",
    'QT_VERSION_STR=\\"' + QT_VERSION + '\\"',
    "_LARGEFILE64_SOURCE",
    "_LARGEFILE_SOURCE",
    "_REENTRANT",
] + select({
    "@qt//:debug_build": [],
    "//conditions:default": ["QT_NO_DEBUG"],
}) + select({
    "@platforms//os:windows": [
        "UNICODE",
        "_UNICODE",
        "WIN32",
        "_ENABLE_EXTENDED_ALIGNED_STORAGE",
        "WIN64",
        "_WIN64",
        "NOMINMAX",
        "_WIN32_WINNT=0x0A00",
        "WINVER=0x0A00",
    ],
    "//conditions:default": [],
})

# Build-time tool (runs on the execution platform) used by qt_mime_database in
# qtbase_config.bzl to gzip the shared-mime-info XML into a C array. Replaces the
# host python3 that Qt's CMake build uses, so no system interpreter is needed.
cc_binary(
    name = "qt_mime_database_gen",
    srcs = ["qt_mime_database_gen.cc"],
    visibility = ["//visibility:private"],
    deps = ["@zlib"],
)

declare_qtbase_config_targets()

# =============================================================================
# Export & Depends Headers + syncqt Header Trees
# =============================================================================

qt_export_header(
    name = "qtcoreexports_h",
    out = "generated_exports/qtcoreexports.h",
    module_infix = "CORE",
)

qt_depends_header(
    name = "qtcore_depends_h",
    out = "generated_exports/QtCoreDepends",
    dep_modules = [],
)

qt_sync_headers(
    name = "core_sync_headers",
    hdrs = glob(
        include = ["src/corelib/**/*.h"],
        exclude = ["src/corelib/platform/wasm/**"],
    ),
    generated_private_hdrs = [
        ":gen_qconfig_p_h",
        ":gen_qtcore_config_p_h",
    ],
    generated_public_hdrs = [
        ":gen_qconfig_h",
        ":gen_qtcore_config_h",
        ":gen_qtdeprecationdefinitions_h",
        ":qtcoreexports_h",
        ":qtcore_depends_h",
    ],
    module_name = "QtCore",
    source_dir = "src/corelib",
    version = QT_VERSION,
)

qt_export_header(
    name = "qtconcurrentexports_h",
    out = "generated_exports/qtconcurrentexports.h",
    module_infix = "CONCURRENT",
)

qt_depends_header(
    name = "qtconcurrent_depends_h",
    out = "generated_exports/QtConcurrentDepends",
    dep_modules = ["QtCore"],
)

qt_sync_headers(
    name = "concurrent_sync_headers",
    hdrs = glob(["src/concurrent/**/*.h"]),
    generated_public_hdrs = [
        ":qtconcurrentexports_h",
        ":qtconcurrent_depends_h",
