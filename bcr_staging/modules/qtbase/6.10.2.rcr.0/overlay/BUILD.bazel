# The BCR `sqlite3` module builds the amalgamation without SQLITE_ENABLE_COLUMN_METADATA
# (and offers no way to set it), but QSQLiteResult needs sqlite3_column_table_name16().
cc_library(
    name = "sqlite3_bundled",
    srcs = ["src/3rdparty/sqlite/sqlite3.c"],
    hdrs = ["src/3rdparty/sqlite/sqlite3.h"],
    copts = [
        "-fPIC",
        "-O2",
        "-w",  # qt_disable_warnings(QSQLiteDriverPlugin)
    ],
    includes = ["src/3rdparty/sqlite"],
    linkopts = select({
        "@qt//:unix": [
            "-ldl",
            "-lpthread",
        ],
        "//conditions:default": [],
    }),
    local_defines = [
        "SQLITE_ENABLE_COLUMN_METADATA",
        "SQLITE_ENABLE_FTS3",
        "SQLITE_ENABLE_FTS3_PARENTHESIS",
        "SQLITE_ENABLE_FTS4",
        "SQLITE_ENABLE_FTS5",
        "SQLITE_ENABLE_GEOPOLY",
        "SQLITE_ENABLE_JSON1",
        "SQLITE_ENABLE_MATH_FUNCTIONS",
        "SQLITE_ENABLE_RTREE",
        "SQLITE_OMIT_COMPLETE",
        "NDEBUG",
    ] + select({
        "@qt//:unix": [
            "HAVE_LOCALTIME_R=1",
            "HAVE_USLEEP=1",
        ],
        "//conditions:default": [],
    }),
)

qt_static_plugin(
    name = "qsqlite",
    srcs = [
        "src/plugins/sqldrivers/sqlite/qsql_sqlite.cpp",
        "src/plugins/sqldrivers/sqlite/qsql_sqlite_vfs.cpp",
        "src/plugins/sqldrivers/sqlite/smain.cpp",
    ],
    hdrs = [
        "src/plugins/sqldrivers/sqlite/qsql_sqlite_p.h",
        "src/plugins/sqldrivers/sqlite/qsql_sqlite_vfs_p.h",
    ],
    copts = common_copts + ["-std=gnu++20"],
    includes = ["src/plugins/sqldrivers/sqlite"],
    local_defines = _SQL_LOCAL_DEFINES + ["QT_SQL_LIB"],
    moc_hdrs = ["src/plugins/sqldrivers/sqlite/qsql_sqlite_p.h"],
    moc_srcs = ["src/plugins/sqldrivers/sqlite/smain.cpp"],
    plugin_class_name = "QSQLiteDriverPlugin",
    textual_hdrs = ["src/plugins/sqldrivers/sqlite/sqlite.json"],
    deps = [
        ":core",
        ":core_internal_cfg",
        ":sql",
        ":sql_internal_cfg",
        ":sqlite3_bundled",
    ],
)

qt_static_plugin(
    name = "qsqlodbc",
    srcs = [
        "src/plugins/sqldrivers/odbc/main.cpp",
        "src/plugins/sqldrivers/odbc/qsql_odbc.cpp",
