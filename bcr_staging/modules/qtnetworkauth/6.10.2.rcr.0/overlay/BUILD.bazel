load("@qt//:qt.bzl", "common_copts")
load("@qt//:qt_internal_library.bzl", "qt_internal_library")
load("@qt//:qt_tools.bzl", "qt_sync_headers", "qt_write_file")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
    license_text = "LICENSES/GPL-3.0-only.txt",
)

exports_files(["MODULE.bazel"])

_COMMON_DEFINES = [
    "QT_ASCII_CAST_WARNINGS",
    "QT_BUILDING_QT",
    "QT_DEPRECATED_WARNINGS",
    "QT_EXPLICIT_QFILE_CONSTRUCTION_FROM_PATH",
    "QT_MOC_COMPAT",
    "QT_NO_CAST_TO_ASCII",
    "QT_NO_CONTEXTLESS_CONNECT=1",
    "QT_NO_DEBUG",
    "QT_NO_EXCEPTIONS",
    "QT_NO_FOREACH=1",
    "QT_NO_JAVA_STYLE_ITERATORS",
    "QT_NO_NARROWING_CONVERSIONS_IN_CONNECT",
    "QT_NO_QASCONST=1",
    "QT_NO_QEXCHANGE",
    "QT_NO_QSNPRINTF",
    "QT_USE_QSTRINGBUILDER",
    "_GLIBCXX_ASSERTIONS",
    "_LARGEFILE64_SOURCE",
    "_LARGEFILE_SOURCE",
]

qt_write_file(
    name = "gen_networkauth_exports",
    out = "generated_cfg/include/QtNetworkAuth/qtnetworkauthexports.h",
    content = """// Generated by Bazel
#ifndef QTNETWORKAUTHEXPORTS_H
#define QTNETWORKAUTHEXPORTS_H

#include <QtCore/qcompilerdetection.h>
#include <QtCore/qtconfigmacros.h>
#include <QtCore/qtdeprecationmarkers.h>

#if defined(QT_SHARED) || !defined(QT_STATIC)
#  if defined(QT_BUILD_NETWORKAUTH_LIB)
#    define Q_OAUTH_EXPORT Q_DECL_EXPORT
#  else
#    define Q_OAUTH_EXPORT Q_DECL_IMPORT
#  endif
#else
#  define Q_OAUTH_EXPORT
#endif

#define QT_NETWORKAUTH_REMOVED_SINCE(major, minor) 0

#endif // QTNETWORKAUTHEXPORTS_H
""",
)

qt_write_file(
    name = "gen_networkauth_config_p",
    out = "generated_cfg/include/QtNetworkAuth/6.10.2/QtNetworkAuth/private/qtnetworkauth-config_p.h",
    content = """// Generated by Bazel
#ifndef QTNETWORKAUTH_CONFIG_P_H
#define QTNETWORKAUTH_CONFIG_P_H

#define QT_FEATURE_urischeme_replyhandler 1

#endif // QTNETWORKAUTH_CONFIG_P_H
""",
)

cc_library(
    name = "networkauth_cfg",
    hdrs = [
        ":gen_networkauth_config_p",
        ":gen_networkauth_exports",
    ],
    includes = [
        "generated_cfg/include",
        "generated_cfg/include/QtNetworkAuth",
        "generated_cfg/include/QtNetworkAuth/6.10.2",
        "generated_cfg/include/QtNetworkAuth/6.10.2/QtNetworkAuth",
    ],
)

qt_sync_headers(
    name = "networkauth_sync_headers",
    srcs = glob(["src/oauth/*.h"]),
    dep_modules = [
        "QtCore",
        "QtNetwork",
    ],
    module_name = "QtNetworkAuth",
    source_dir = "src/oauth",
)

qt_internal_library(
    name = "networkauth",
    srcs = [
        "src/oauth/qabstractoauth.cpp",
        "src/oauth/qabstractoauth2.cpp",
        "src/oauth/qabstractoauthreplyhandler.cpp",
        "src/oauth/qoauth1.cpp",
        "src/oauth/qoauth1signature.cpp",
        "src/oauth/qoauth2authorizationcodeflow.cpp",
        "src/oauth/qoauth2deviceauthorizationflow.cpp",
        "src/oauth/qoauthhttpserverreplyhandler.cpp",
        "src/oauth/qoauthoobreplyhandler.cpp",
        "src/oauth/qoauthurischemereplyhandler.cpp",
    ],
    hdrs = glob(["src/oauth/*.h"]) + [":networkauth_sync_headers"],
    copts = common_copts + ["-std=gnu++20"],
    create_shared = True,
    defines = ["QT_NETWORKAUTH_LIB"],
    dynamic_deps = [
        "@qtbase//:core_shared",
        "@qtbase//:dbus_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:network_shared",
    ],
    includes = ["src/oauth"],
    local_defines = _COMMON_DEFINES + ["QT_BUILD_NETWORKAUTH_LIB"],
    moc_hdrs = [
        "src/oauth/qabstractoauth.h",
        "src/oauth/qabstractoauth2.h",
        "src/oauth/qabstractoauthreplyhandler.h",
        "src/oauth/qoauth1.h",
        "src/oauth/qoauth2authorizationcodeflow.h",
        "src/oauth/qoauth2deviceauthorizationflow.h",
        "src/oauth/qoauthhttpserverreplyhandler.h",
        "src/oauth/qoauthoobreplyhandler.h",
        "src/oauth/qoauthurischemereplyhandler.h",
    ],
    moc_unity = True,
    deps = [
        ":networkauth_cfg",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtbase//:network",
    ],
)
