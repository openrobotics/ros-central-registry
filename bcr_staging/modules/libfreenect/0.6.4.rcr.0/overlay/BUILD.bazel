load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

# libfreenect is dual-licensed Apache-2.0 / GPL-2.0 (see APACHE20, GPL2).
license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
    license_text = "APACHE20",
)

exports_files([
    "APACHE20",
    "GPL2",
])

# Mirrors src/CMakeLists.txt: the core "freenect" library (no examples,
# fakenect, c_sync or language wrappers, which are separate targets upstream).
# Audio firmware is not bundled (BUILD_REDIST_PACKAGE=ON, upstream default).
cc_library(
    name = "libfreenect",
    srcs = [
        "src/audio.c",
        "src/cameras.c",
        "src/cameras.h",
        "src/core.c",
        "src/flags.c",
        "src/flags.h",
        "src/freenect_internal.h",
        "src/loader.c",
        "src/loader.h",
        "src/registration.c",
        "src/registration.h",
        "src/tilt.c",
        "src/usb_libusb10.c",
        "src/usb_libusb10.h",
    ],
    hdrs = [
        "include/libfreenect.h",
        "include/libfreenect_audio.h",
        "include/libfreenect_registration.h",
    ],
    copts = ["-w"],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:linux": ["-lm"],
        "//conditions:default": [],
    }),
    deps = ["@libusb"],
)

# wrappers/c_sync: the synchronous convenience API (BUILD_C_SYNC, default ON).
cc_library(
    name = "libfreenect_sync",
    srcs = ["wrappers/c_sync/libfreenect_sync.c"],
    hdrs = ["wrappers/c_sync/libfreenect_sync.h"],
    copts = ["-w"],
    includes = ["wrappers/c_sync"],
    linkopts = select({
        "@platforms//os:linux": ["-lpthread"],
        "//conditions:default": [],
    }),
    deps = [":libfreenect"],
)
