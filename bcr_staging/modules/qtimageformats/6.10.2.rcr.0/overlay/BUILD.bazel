load("@qt//:qt_internal_library.bzl", "qt_static_plugin")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:LGPL-3.0-only",
    ],
    license_text = "LICENSES/LGPL-3.0-only.txt",
)

exports_files(["LICENSES/LGPL-3.0-only.txt"])

common_copts = [
    "-w",
    "-fPIC",
    "-O2",
    "-DNDEBUG",
    "-DQT_NO_CAST_TO_ASCII",
    "-DQT_BUILDING_QT",
    "-std=gnu++20",
]

# From .cmake.conf QT_EXTRA_INTERNAL_TARGET_DEFINES plus the usual Qt module set.
common_local_defines = [
    "QT_ASCII_CAST_WARNINGS",
    "QT_BUILDING_QT",
    "QT_CORE_LIB",
    "QT_DEPRECATED_WARNINGS",
    "QT_EXPLICIT_QFILE_CONSTRUCTION_FROM_PATH",
    "QT_GUI_LIB",
    "QT_MOC_COMPAT",
    "QT_NO_CAST_TO_ASCII",
    "QT_NO_DEBUG",
    "QT_NO_FOREACH=1",
    "QT_NO_JAVA_STYLE_ITERATORS",
    "QT_NO_NARROWING_CONVERSIONS_IN_CONNECT",
    "QT_NO_QASCONST=1",
    "QT_NO_QEXCHANGE",
    "QT_NO_QSNPRINTF",
    "QT_NO_USING_NAMESPACE",
    "QT_USE_NODISCARD_FILE_OPEN",
    "QT_USE_QSTRINGBUILDER",
    "_GLIBCXX_ASSERTIONS",
    "_LARGEFILE64_SOURCE",
    "_LARGEFILE_SOURCE",
]

_QTBASE_DEPS = [
    "@qtbase//:core",
    "@qtbase//:core_internal_cfg",
    "@qtbase//:gui",
    "@qtbase//:gui_internal_cfg",
]

# The upstream build set (src/plugins/imageformats/CMakeLists.txt) for Linux:
# tga, wbmp, tiff, webp, icns. mng/jp2 need libmng/jasper (not in BCR) and
# macheif/macjp2 are Apple-only; `dds` is unreferenced upstream.

# =============================================================================
# imageformats plugins (statically linked via Q_IMPORT_PLUGIN)
# =============================================================================

qt_static_plugin(
    name = "qtga",
    srcs = [
        "src/plugins/imageformats/tga/main.cpp",
        "src/plugins/imageformats/tga/qtgafile.cpp",
        "src/plugins/imageformats/tga/qtgahandler.cpp",
    ],
    hdrs = [
        "src/plugins/imageformats/tga/qtgafile.h",
        "src/plugins/imageformats/tga/qtgahandler.h",
    ],
    copts = common_copts,
    includes = ["src/plugins/imageformats/tga"],
    local_defines = common_local_defines,
    moc_srcs = ["src/plugins/imageformats/tga/main.cpp"],
    plugin_class_name = "QTgaPlugin",
    textual_hdrs = ["src/plugins/imageformats/tga/tga.json"],
    deps = _QTBASE_DEPS,
)

qt_static_plugin(
    name = "qwbmp",
    srcs = [
        "src/plugins/imageformats/wbmp/main.cpp",
        "src/plugins/imageformats/wbmp/qwbmphandler.cpp",
    ],
    hdrs = ["src/plugins/imageformats/wbmp/qwbmphandler_p.h"],
    copts = common_copts,
    includes = ["src/plugins/imageformats/wbmp"],
    local_defines = common_local_defines,
    moc_srcs = ["src/plugins/imageformats/wbmp/main.cpp"],
    plugin_class_name = "QWbmpPlugin",
    textual_hdrs = ["src/plugins/imageformats/wbmp/wbmp.json"],
    deps = _QTBASE_DEPS,
)

# QT_FEATURE_regularexpression is enabled in @qtbase.
qt_static_plugin(
    name = "qicns",
    srcs = [
        "src/plugins/imageformats/icns/main.cpp",
        "src/plugins/imageformats/icns/qicnshandler.cpp",
    ],
    hdrs = ["src/plugins/imageformats/icns/qicnshandler_p.h"],
    copts = common_copts,
    includes = ["src/plugins/imageformats/icns"],
    local_defines = common_local_defines,
    moc_srcs = ["src/plugins/imageformats/icns/main.cpp"],
    plugin_class_name = "QICNSPlugin",
    textual_hdrs = ["src/plugins/imageformats/icns/icns.json"],
    deps = _QTBASE_DEPS,
)

# QT_FEATURE_system_tiff: links BCR libtiff rather than src/3rdparty/libtiff.
qt_static_plugin(
    name = "qtiff",
    srcs = [
        "src/plugins/imageformats/tiff/main.cpp",
        "src/plugins/imageformats/tiff/qtiffhandler.cpp",
    ],
    hdrs = ["src/plugins/imageformats/tiff/qtiffhandler_p.h"],
    copts = common_copts,
    includes = ["src/plugins/imageformats/tiff"],
    local_defines = common_local_defines,
    moc_srcs = ["src/plugins/imageformats/tiff/main.cpp"],
    plugin_class_name = "QTiffPlugin",
    textual_hdrs = ["src/plugins/imageformats/tiff/tiff.json"],
    deps = _QTBASE_DEPS + ["@libtiff//:tiff"],
)

# QT_FEATURE_system_webp: links BCR libwebp rather than src/3rdparty/libwebp.
qt_static_plugin(
    name = "qwebp",
    srcs = [
        "src/plugins/imageformats/webp/main.cpp",
        "src/plugins/imageformats/webp/qwebphandler.cpp",
    ],
    hdrs = ["src/plugins/imageformats/webp/qwebphandler_p.h"],
    copts = common_copts,
    includes = ["src/plugins/imageformats/webp"],
    local_defines = common_local_defines,
    moc_srcs = ["src/plugins/imageformats/webp/main.cpp"],
    plugin_class_name = "QWebpPlugin",
    textual_hdrs = ["src/plugins/imageformats/webp/webp.json"],
    deps = _QTBASE_DEPS + ["@libwebp"],
)

# Apple ImageIO-backed HEIF and JPEG-2000 plugins on macOS.
qt_static_plugin(
    name = "qmacheif",
    srcs = [
        "src/plugins/imageformats/macheif/main.cpp",
        "src/plugins/imageformats/macheif/qmacheifhandler.cpp",
        "src/plugins/imageformats/shared/qiiofhelpers.mm",
    ],
    hdrs = [
        "src/plugins/imageformats/macheif/qmacheifhandler.h",
        "src/plugins/imageformats/shared/qiiofhelpers_p.h",
    ],
    copts = common_copts + [
        "-x",
        "objective-c++",
    ],
    includes = [
        "src/plugins/imageformats/macheif",
        "src/plugins/imageformats/shared",
    ],
    linkopts = [
        "-framework",
        "CoreFoundation",
        "-framework",
        "CoreGraphics",
        "-framework",
        "ImageIO",
    ],
    local_defines = common_local_defines + [
        "NS_IIOF_HELPERS=QMacHeif",
    ],
    moc_srcs = ["src/plugins/imageformats/macheif/main.cpp"],
    plugin_class_name = "QMacHeifPlugin",
    target_compatible_with = ["@platforms//os:macos"],
    textual_hdrs = ["src/plugins/imageformats/macheif/macheif.json"],
    deps = _QTBASE_DEPS,
)

qt_static_plugin(
    name = "qmacjp2",
    srcs = [
        "src/plugins/imageformats/macjp2/main.cpp",
        "src/plugins/imageformats/macjp2/qmacjp2handler.cpp",
        "src/plugins/imageformats/shared/qiiofhelpers.mm",
    ],
    hdrs = [
        "src/plugins/imageformats/macjp2/qmacjp2handler.h",
        "src/plugins/imageformats/shared/qiiofhelpers_p.h",
    ],
    copts = common_copts + [
        "-x",
        "objective-c++",
    ],
    includes = [
        "src/plugins/imageformats/macjp2",
        "src/plugins/imageformats/shared",
    ],
    linkopts = [
        "-framework",
        "CoreFoundation",
        "-framework",
        "CoreGraphics",
        "-framework",
        "ImageIO",
    ],
    local_defines = common_local_defines + [
        "NS_IIOF_HELPERS=QMacJp2",
    ],
    moc_srcs = ["src/plugins/imageformats/macjp2/main.cpp"],
    plugin_class_name = "QMacJp2Plugin",
    target_compatible_with = ["@platforms//os:macos"],
    textual_hdrs = ["src/plugins/imageformats/macjp2/macjp2.json"],
    deps = _QTBASE_DEPS,
)

# Convenience: all platform image format plugins at once.
cc_library(
    name = "imageformats",
    deps = [
        ":qicns",
        ":qtga",
        ":qtiff",
        ":qwbmp",
        ":qwebp",
        "@qtbase//:qgif",
        "@qtbase//:qico",
        "@qtbase//:qjpeg",
    ] + select({
        "@platforms//os:macos": [
            ":qmacheif",
            ":qmacjp2",
        ],
        "//conditions:default": [],
    }),
)
