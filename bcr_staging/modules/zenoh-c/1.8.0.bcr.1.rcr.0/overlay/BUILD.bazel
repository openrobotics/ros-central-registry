load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("@crates_zenoh_c//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_shared_library")
load("//:features.bzl", "rust_build_script_archive", "zenoh_c_crate_features")
load("//cbindgen:cbindgen.bzl", "rust_cbindgen_library")

# Transform the opaque types from a .txt to a .rs file.

rust_binary(
    name = "bazel_generate_opaque_types",
    srcs = ["bazel_generate_opaque_types.rs"],
    edition = "2021",
    deps = ["@crates_zenoh_c//:regex"],
)

run_binary(
    name = "generate_opaque_types",
    srcs = [
        "//build-resources/opaque-types:opaque_types",
        "//build-resources/opaque-types:src/lib.rs",
    ],
    outs = ["src/opaque_types/mod.rs"],
    args = [
        "$(location //build-resources/opaque-types:src/lib.rs)",
        "$(location //build-resources/opaque-types:opaque_types)",
        "$(location src/opaque_types/mod.rs)",
    ],
    tool = ":bazel_generate_opaque_types",
)

# Generate the rust library (name must match the [lib] in Cargo.toml)

rust_shared_library(
    name = "zenohc",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/opaque_types/mod.rs"],
    ) + [
        ":generate_opaque_types",
    ],
    aliases = aliases(),
    crate_features = zenoh_c_crate_features(),
    rustc_flags = select({
        "@platforms//os:macos": [
            "-Clink-arg=-Wl,-install_name,@rpath/libzenohc.dylib",
        ],
        "//conditions:default": [],
    }),
    deps = all_crate_deps(
        normal = True,
    ),
)

# A static counterpart to :zenohc, using rust_library (rlib) rather than
# rust_static_library (staticlib) so that rules_rust propagates individual
# crate rlibs and LTO compilation contexts to C++ link actions (required when
# linking with --features=thin_lto / --config=portable).

rust_library(
    name = "zenohc_static",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/opaque_types/mod.rs"],
    ) + [
        ":generate_opaque_types",
    ],
    aliases = aliases(),
    crate_features = zenoh_c_crate_features(),
    deps = all_crate_deps(
        normal = True,
    ),
)

# When ThinLTO is enabled (--features=thin_lto), rules_rust links each crate's
# emitted .rlib.o bitcode object rather than its .rlib archive, which omits
# native C/assembly objects bundled into ring's .rlib by its cargo_build_script.
# Expose libring_core_*.a from ring's build script out_dir as a cc_library dep.
rust_build_script_archive(
    name = "ring_core_archive",
    archive_glob = "libring_core_*[0-9]_.a",
    crate = ":zenohc_static",
    crate_filter = "ring-",
)

cc_library(
    name = "ring_core",
    srcs = [":ring_core_archive"],
)

# Run cbindgen

rust_cbindgen_library(
    name = "zenohc-cbindgen",
    config = "cbindgen.toml",
    header_name = "include/zenoh-gen-buggy.h",
    lang = "c",
    lib = ":zenohc",
)

cargo_build_script(
    name = "build_script",
    srcs = glob([
        "build.rs",
        "buildrs/**",
    ]),
    aliases = aliases(),
    build_script_env = {
        "BUGGY_GENERATION_PATH": "$(locations :zenohc-cbindgen)",
        "OUT_DIR": ".",
        "CARGO_PKG_NAME": "zenoh-c",
    },
    crate_features = zenoh_c_crate_features(),
    crate_root = "build.rs",
    data = [":zenohc-cbindgen"] + glob([
        "cbindgen.toml",
        "Cargo.toml",
        "include/zenoh.h",
        "include/zenoh_memory.h",
        "include/zenoh_constants.h",
        "splitguide.yaml",
        "version.txt",
        "src/**",
    ]),
    deps = all_crate_deps(
        build = True,
    ),
)

filegroup(
    name = "output_dir",
    srcs = [":build_script"],
    output_group = "out_dir",
)

[
    genrule(
        name = "extract_{}".format(file.replace("/", "_").replace(".", "_")),
        srcs = [":output_dir"],
        outs = [file],
        cmd = "cp $(location :output_dir)/{} $@".format(file),
    )
    for file in [
        "include/zenoh_commons.h",
        "include/zenoh_concrete.h",
        "include/zenoh_configure.h",
        "include/zenoh_macros.h",
        "include/zenoh_opaque.h",
    ]
]

# Package up the rust library and c headers as a cc_library

config_setting(
    name = "dynamic_mode_off",
    values = {
        "dynamic_mode": "off",
    },
)

cc_library(
    name = "zenoh-c",
    srcs = select({
        ":dynamic_mode_off": [],
        "//conditions:default": [":zenohc"],
    }),
    hdrs = [
        "include/zenoh.h",
        "include/zenoh_commons.h",
        "include/zenoh_concrete.h",
        "include/zenoh_configure.h",
        "include/zenoh_constants.h",
        "include/zenoh_macros.h",
        "include/zenoh_memory.h",
        "include/zenoh_opaque.h",
    ],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:linux": [
            "-lpthread",
            "-lrt",
        ],
        "//conditions:default": [],
    }),
    local_defines = select({
        ":dynamic_mode_off": [],
        "//conditions:default": ["ZENOHC_DYN_LIB"],
    }),
    visibility = ["//visibility:public"],
    deps = select({
        ":dynamic_mode_off": [
            ":ring_core",
            ":zenohc_static",
        ],
        "//conditions:default": [],
    }),
)
