-fragment float4 main_metal
+uint pack(float4 color)
+{
+  int rgba = (int(color.x * 255.0) << 24) +
+             (int(color.y * 255.0) << 16) +
+             (int(color.z * 255.0) << 8) +
+             int(color.w * 255.0);
+  return as_type<uint>(rgba);
+}
+
+float4 unpack(uint packed)
+{
+  int rgba = as_type<int>(packed);
+  int r = rgba >> 24 & 0xFF;
+  int g = rgba >> 16 & 0xFF;
+  int b = rgba >> 8 & 0xFF;
+  int a = rgba & 0xFF;
+  return float4(r/255.0, g/255.0, b/255.0, a/255.0);
+}
