+// This fragment shader adds Gaussian noise to a depth camera image.
+// It is the Metal port of gaussian_noise_depth_fs.glsl: the input texture is
+// the depth camera's PFG_RGBA32_UINT target, holding the float bit patterns
+// of [x, y, z] in .xyz and an RGBA8 colour packed into .w.  It must therefore
+// read a uint texture and write uint4 -- a float4 output is rejected by the
+// Metal pipeline validation ("output of type float4 is not compatible with
+// MTLPixelFormatRGBA32Uint").
+
 #include <metal_stdlib>
 using namespace metal;
 
