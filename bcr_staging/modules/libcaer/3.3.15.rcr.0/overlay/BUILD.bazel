load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-2-Clause",
    ],
    license_text = "COPYING",
)

genrule(
    name = "libusb_compat_header",
    outs = ["_libusb_compat/libusb-1.0/libusb.h"],
    cmd = "printf '#pragma once\\n#include <libusb.h>\\n' > $@",
)

cc_library(
    name = "libusb_prefixed_headers",
    hdrs = [":libusb_compat_header"],
    includes = ["_libusb_compat"],
)

cc_library(
    name = "libcaer",
    srcs = [
        "src/autoexposure.c",
        "src/davis.c",
        "src/device.c",
        "src/device_discover.c",
        "src/dvs128.c",
        "src/dvs132s.c",
        "src/dvxplorer.c",
        "src/dynapse.c",
        "src/filters_dvs_noise.c",
        "src/frame_utils.c",
        "src/log.c",
        "src/ringbuffer.c",
        "src/samsung_evk.c",
        "src/usb_utils.c",
    ],
    hdrs = glob([
        "include/libcaer/**/*.h",
        "include/libcaercpp/**/*.hpp",
    ]),
    copts = [
        "-Wno-unused-function",
    ],
    includes = ["include"],
    linkopts = [
        "-lm",
        "-lpthread",
    ],
    textual_hdrs = glob(["src/*.h"]),
    deps = [
        ":libusb_prefixed_headers",
        "@libusb",
    ],
)
