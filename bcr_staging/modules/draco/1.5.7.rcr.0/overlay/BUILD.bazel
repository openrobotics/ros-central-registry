# Upstream installs every header under src/draco (draco_install.cmake globs
# them), so expose the same set minus test-only helpers.
DRACO_HDRS = glob(
    ["src/draco/**/*.h"],
    exclude = [
        "src/draco/core/draco_test_base.h",
        "src/draco/core/draco_test_utils.h",
        "src/draco/javascript/**",
        "src/draco/maya/**",
        "src/draco/tools/**",
        "src/draco/unity/**",
    ],
)

cc_library(
    name = "draco",
    srcs = DRACO_SRCS,
    hdrs = DRACO_HDRS + [":draco_features_h"],
    copts = [
        "-include",
        "algorithm",
    ],
    includes = ["src"],
)

cc_binary(
    name = "draco_encoder",
    srcs = ["src/draco/tools/draco_encoder.cc"],
    deps = [":draco"],
)

cc_binary(
    name = "draco_decoder",
    srcs = ["src/draco/tools/draco_decoder.cc"],
    deps = [":draco"],
)
