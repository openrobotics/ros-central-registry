load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
    license_text = "LICENSE.txt",
)

exports_files(["LICENSE.txt"])

# The header-only CUTLASS and CuTe templates (include/), plus the host-side
# utilities (tools/util/include, e.g. <cutlass/util/packed_stride.hpp>).
cc_library(
    name = "cutlass",
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.hpp",
        "include/**/*.inl",
        "tools/util/include/**/*.h",
        "tools/util/include/**/*.hpp",
    ]),
    includes = [
        "include",
        "tools/util/include",
    ],
)
