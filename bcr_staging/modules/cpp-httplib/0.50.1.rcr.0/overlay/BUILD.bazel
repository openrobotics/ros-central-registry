# cpp-httplib, the header-only HTTP library, without TLS (OpenSSL) and zlib
# support: PyTorch's c10d control plane serves plain HTTP on a Unix socket.
# The target names are the BCR module's.
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(default_applicable_licenses = [":license"])

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
    license_text = "LICENSE",
)

exports_files(["LICENSE"])

cc_library(
    name = "httplib",
    hdrs = ["httplib.h"],
    includes = ["."],
    linkopts = select({
        "@platforms//os:windows": ["-lws2_32"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "cpp-httplib",
    actual = ":httplib",
    visibility = ["//visibility:public"],
)
