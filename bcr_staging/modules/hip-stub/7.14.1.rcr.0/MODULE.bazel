module(
    name = "hip-stub",
    version = "7.14.1.rcr.0",
    bazel_compatibility = [">=7.2.1"],
    compatibility_level = 7,
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "llvm", version = "0.8.25.rcr.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rocm-device-libs", version = "7.14.1.rcr.0")
bazel_dep(name = "rules_cc", version = "0.2.26.rcr.0")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_python", version = "1.8.5")

# Clang's offloading tools (clang-linker-wrapper, clang-offload-bundler,
# llvm-offload-binary, lld) for :hip_sdk, built from the llvm-project sources
# that @llvm provides: the prebuilt @llvm toolchain does not include them.
llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
use_repo(llvm, "llvm-project")
