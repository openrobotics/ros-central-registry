--- a/src/rendering/RenderUtil.cc
+++ b/src/rendering/RenderUtil.cc
@@ -2628,6 +2628,15 @@
 
   if (this->dataPtr->isHeadlessRendering)
     params["headless"] = "1";
+#if defined(__linux__)
+  // The ogre-next GL3Plus render system in this distribution is built with
+  // headless EGL support only (no GLX). Without a caller-provided GL context
+  // (as the GUI supplies), gz-rendering would otherwise try to set up a
+  // windowed GLX context whenever DISPLAY is set and fail ("Option named Full
+  // Screen does not exist"), leaving server-side sensors without a scene.
+  else if (params.find("useCurrentGLContext") == params.end())
+    params["headless"] = "1";
+#endif
   params["winID"] = this->dataPtr->winID;
 
   this->dataPtr->engine = rendering::engine(this->dataPtr->engineName, params);
