--- a/src/bazel/InstallationDirectories.cc
+++ b/src/bazel/InstallationDirectories.cc
@@ -17,15 +17,27 @@
 
 #include <gz/sim/InstallationDirectories.hh>
 
+#include <cstdlib>
+#include <string>
+
 namespace gz
 {
 namespace sim
 {
 inline namespace GZ_SIM_VERSION_NAMESPACE {
 
-// Generate an install prefix specifically for bazel build.
+// Generate an install prefix specifically for bazel build. Like the CMake
+// build (gz_add_get_install_prefix_impl with
+// OVERRIDE_INSTALL_PREFIX_ENV_VARIABLE GZ_SIM_INSTALL_PREFIX), honor
+// GZ_SIM_INSTALL_PREFIX so packagers can point gz-sim at the tree where its
+// data (e.g. media/gazebo.material) is installed.
 std::string getInstallPrefix()
 {
+  const char * env = std::getenv("GZ_SIM_INSTALL_PREFIX");
+  if (env != nullptr && env[0] != '\0')
+  {
+    return std::string(env);
+  }
   return ".";
 }
 }
