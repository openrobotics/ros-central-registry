+
+static void discoverWorldNames(gz::gui::MainWindow *_mainWin)
+{
+  if (!_mainWin)
+    return;
+  gz::transport::Node node;
+  gz::msgs::StringMsg_V worldsMsg;
+  bool result = false;
+  for (int i = 0; i < 50; ++i)
+  {
+    if (node.Request("/gazebo/worlds", 200u, worldsMsg, result) && result &&
+        worldsMsg.data_size() > 0)
+    {
+      QStringList names;
+      for (int w = 0; w < worldsMsg.data_size(); ++w)
+        names.append(QString::fromStdString(worldsMsg.data(w)));
+      _mainWin->setProperty("worldNames", names);
+      break;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+  }
+}
