        "@platforms//os:macos": [
            'SHARED_LIBRARY_PREFIX=\\"lib\\"',
            'SHARED_LIBRARY_SUFFIX=\\".dylib\\"',
        ],
        "//conditions:default": [
            'SHARED_LIBRARY_PREFIX=\\"lib\\"',
            'SHARED_LIBRARY_SUFFIX=\\".so\\"',
        ],
    }),
    includes = ["include"],
    local_defines = [
        'GZ_GUI_PLUGIN_RELATIVE_INSTALL_DIR=\\"\\"',
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@gz-common",
        "@gz-common//events",
        "@gz-common//profiler",
        "@gz-math",
        "@gz-msgs",
        "@gz-plugin//:loader",
