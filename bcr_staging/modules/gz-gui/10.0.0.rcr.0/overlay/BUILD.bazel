load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_gazebo//gazebo:headers.bzl", "gz_configure_header", "gz_export_header")
load("@rules_license//rules:license.bzl", "license")
load(":gui_plugins.bzl", "GZ_GUI_QT_SHARED_DEPS", "gz_gui_plugin")

package(
    default_applicable_licenses = [":license"],
)

license(
    name = "license",
    package_name = "gz-gui",
)

licenses(["notice"])

exports_files([
    "gui_plugins.bzl",
    "package.xml",
    "LICENSE",
])

gz_export_header(
    name = "Export",
    out = "include/gz/gui/Export.hh",
    export_base = "GZ_GUI",
    lib_name = "gz-gui",
)

gz_configure_header(
    name = "config",
    src = "include/gz/gui/config.hh.in",
    package_xml = "package.xml",
)

moc_headers = [
    ("moc_Application", "include/gz/gui/Application.hh"),
    ("moc_Dialog", "include/gz/gui/Dialog.hh"),
    ("moc_MainWindow", "include/gz/gui/MainWindow.hh"),
    ("moc_PlottingInterface", "include/gz/gui/PlottingInterface.hh"),
    ("moc_Plugin", "include/gz/gui/Plugin.hh"),
]

[
    genrule(
        name = name,
        srcs = [hdr],
        outs = ["moc_" + hdr.split("/")[-1].replace(".hh", "").replace(".h", "") + ".cpp"],
        cmd = "$(execpath @qtbase//:moc) $< -o $@",
        tools = ["@qtbase//:moc"],
    )
    for name, hdr in moc_headers
]

moc_files = [":" + name for name, _ in moc_headers]

genrule(
    name = "resources_rcc",
    srcs = [
        "include/gz/gui/resources.qrc",
        "include/gz/gui/qtquickcontrols2.conf",
        "include/gz/gui/qml/qmldir",
    ] + glob([
        "include/gz/gui/qml/**/*.qml",
        "include/gz/gui/qml/images/*",
    ]),
    outs = ["resources_rcc.cpp"],
    cmd = "ROOT=$$PWD && cd $$(dirname $(location include/gz/gui/resources.qrc)) && $$ROOT/$(execpath @qtbase//:rcc) --name gz_gui --output $$ROOT/$@ resources.qrc",
    tools = ["@qtbase//:rcc"],
)

genrule(
    name = "bazel_installation_directories",
    outs = ["src/bazel/InstallationDirectories.cc"],
    cmd = """cat << 'EOF' > $@
#include <gz/gui/InstallationDirectories.hh>
namespace gz {
namespace gui {
inline namespace GZ_GUI_VERSION_NAMESPACE {
std::string getInstallPrefix() {
  return ".";
}
}
}
}
EOF
""",
)

sources = [
    "src/Application.cc",
    "src/Conversions.cc",
    "src/Dialog.cc",
    "src/DragDropModel.cc",
    "src/GuiEvents.cc",
    "src/Helpers.cc",
    "src/gz.cc",
    "src/InstallationDirectories.cc",
    "src/MainWindow.cc",
    "src/PlottingInterface.cc",
    "src/Plugin.cc",
    "src/SearchModel.cc",
    ":bazel_installation_directories",
]

public_headers = glob([
    "include/gz/gui/**/*.hh",
    "include/gz/gui/**/*.h",
]) + [
    "include/gz/gui/config.hh",
    "include/gz/gui/Export.hh",
]

cc_library(
    name = "gz-gui-headers",
    hdrs = public_headers,
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "@gz-common",
        "@gz-math",
        "@gz-msgs",
        "@gz-plugin//:loader",
        "@gz-rendering",
        "@gz-transport",
