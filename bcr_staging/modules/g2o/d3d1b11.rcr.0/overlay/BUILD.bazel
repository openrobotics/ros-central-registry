# dquat2mat.{h,cpp} is split out from types_slam3d because it's used two
# ways at once: upstream's own CMakeLists.txt compiles it as an ordinary
# translation unit (providing the linkable g2o::internal::compute_dq_dR
# that isometry3d_gradients.h's inline functions call), while
# isometry3d_gradients.cpp *also* textually #includes dquat2mat.cpp inside
# an extra namespace g2o::internal nesting -- which shadows rather than
# redefines compute_dq_dR (a nested `namespace g2o` reopened inside
# `g2o::internal` is a distinct namespace, not the same one), so that copy
# is inert and only needs to parse, not actually be reachable. A single
# Bazel target can't list the same file in both `srcs` (compiled as its
# own action) and `textual_hdrs` (made available to sibling compiles) --
# only one registration wins -- so the compiled copy lives here and
# types_slam3d pulls in dquat2mat.cpp/dquat2mat_maxima_generated.cpp only
# as textual_hdrs, for that inert inline copy to compile against.
cc_library(
    name = "dquat2mat",
    srcs = ["g2o/types/slam3d/dquat2mat.cpp"],
    hdrs = [
        "g2o/config.h",
        "g2o/types/slam3d/dquat2mat.h",
        "g2o/types/slam3d/g2o_types_slam3d_api.h",
    ],
    includes = ["."],
    textual_hdrs = ["g2o/types/slam3d/dquat2mat_maxima_generated.cpp"],
    deps = ["@eigen"],
)

