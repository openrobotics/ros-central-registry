# This overlay only vendors g2o's core graph-optimization library, its
# built-in vertex/edge types, and the solver backends that need nothing
# beyond Eigen (mirrors g2o/CMakeLists.txt's option defaults, minus the
# pieces that pull in dependencies or licenses we don't want):
#
#  - No CHOLMOD/CSparse solvers (g2o/solvers/cholmod, g2o/solvers/csparse):
#    both need external sparse-Cholesky libraries; solver_eigen already
#    gives us a sparse direct solver (Eigen::SimplicialLDLT) with no extra
#    dependency, and csparse_extension is LGPL (see README.md's License
#    section) whereas everything vendored here is plain BSD.
#  - No OpenGL/Qt (g2o_viewer, g2o_incremental, the *_addons draw actions):
#    GUI-only, and g2o_viewer/g2o_incremental are GPL3+ (see README.md).
#  - No apps/examples/unit_test: not needed to consume g2o as a library.
#  - No spdlog logging (G2O_HAVE_LOGGING): optional, not a hard dependency.
#
# g2o/config.h (normally CMake-generated from config.h.in) is vendored as a
# static overlay file instead -- see its own comment for why that's safe
# here.

# g2o/autodiff is a vendored, header-only extract of Ceres Solver's jet.h
# autodiff machinery (BSD, see g2o/autodiff/LICENSE) -- g2o's own
# CMakeLists.txt builds it as an INTERFACE library (g2o_ceres_ad) with no
# sources of its own, just headers.
cc_library(
    name = "g2o_ceres_ad",
    hdrs = glob(["g2o/autodiff/*.h"]),
    includes = ["."],
    deps = ["@eigen"],
)

