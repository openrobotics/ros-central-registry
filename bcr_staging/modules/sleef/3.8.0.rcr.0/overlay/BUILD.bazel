_ARCHS = {
    "aarch64": (_AARCH64_EXTENSIONS, _AARCH64_HEADER_SECTIONS),
    "x86_64": (_X86_64_EXTENSIONS, _X86_64_HEADER_SECTIONS),
}

[
    config_setting(
        name = arch,
        constraint_values = ["@platforms//cpu:" + arch],
    )
    for arch in _ARCHS
]

# -----------------------------------------------------------------------------
# Generated headers
# -----------------------------------------------------------------------------

expand_template(
    name = "sleeflibm_header",
    out = "gen/sleeflibm_header.h.org",
    substitutions = {
        "@SLEEF_VERSION_MAJOR@": "3",
        "@SLEEF_VERSION_MINOR@": "8",
        "@SLEEF_VERSION_PATCH@": "0",
    },
    template = "src/libm/sleeflibm_header.h.org.in",
)

# The sections of sleef.h, per architecture.
[
    sleef_generate(
        name = "sleeflibm_{}_{}".format(arch, section),
        out = "gen/{}/sleeflibm_{}.h.tmp".format(arch, section),
        arguments = arguments or extensions[section][0],
        tool = ":mkrename",
    )
    for arch, (extensions, sections) in _ARCHS.items()
    for section, arguments in sections
]

sleef_concat(
    name = "sleef_h",
    srcs = [":sleeflibm_header"] + select({
        ":" + arch: [
            ":sleeflibm_{}_{}".format(arch, section)
            for section, _ in sections
        ]
        for arch, (_, sections) in _ARCHS.items()
    }) + ["src/libm/sleeflibm_footer.h.org"],
    out = "include/sleef.h",
)

# rename<extension>.h for every extension, and the headers renaming the
# dispatchers' functions.
[
    sleef_generate(
        name = "rename" + extension.lower(),
        out = "gen/rename{}.h".format(extension.lower()),
        arguments = rename_arguments,
        tool = ":mkrename",
    )
    for extension, (_, rename_arguments, _, _) in (_X86_64_EXTENSIONS | _AARCH64_EXTENSIONS).items()
]

[
    sleef_generate(
        name = "renamed" + name,
        out = "gen/renamed{}.h".format(name),
        arguments = arguments,
        tool = ":mkrename",
    )
    for name, arguments in {
        "sp128": [
            "-",
            "2",
            "4",
        ],
        "sp256": [
            "-",
            "4",
            "8",
        ],
        "spscalar": [
            "-",
            "1",
            "1",
        ],
    }.items()
]

# alias_<extension>.h: functions without the extension suffix (e.g.
# Sleef_expf4_u10 for Sleef_expf4_u10advsimd), for the extensions that have
# no dispatcher.
[
    [
        sleef_generate(
            name = "alias_{}_{}".format(extension, precision),
            out = "gen/alias_{}_{}.h.tmp".format(extension, precision),
            arguments = arguments,
            tool = ":mkalias",
        )
        for precision, arguments in [
            (
                "dp",
                alias[0],
            ),
            (
                "sp",
                alias[1],
            ),
        ]
    ] + [
        sleef_concat(
            name = "alias_" + extension.lower(),
            srcs = [
                ":alias_{}_sp".format(extension),
                ":alias_{}_dp".format(extension),
            ],
            out = "gen/alias_{}.h".format(extension.lower()),
        ),
    ]
    for extension, (_, _, _, alias) in (_X86_64_EXTENSIONS | _AARCH64_EXTENSIONS).items()
    if alias
]

# The private headers of the library: its sources' and the generated ones.
cc_library(
    name = "internal_headers",
    hdrs = glob([
        "src/arch/*.h",
        "src/common/*.h",
        "src/libm/*.h",
    ]) + [
        ":rename" + extension.lower()
        for extension in (_X86_64_EXTENSIONS | _AARCH64_EXTENSIONS)
    ] + [
        ":alias_advsimd",
        ":alias_avx512f",
        ":renamedsp128",
        ":renamedsp256",
        ":renamedspscalar",
    ],
    includes = [
        "gen",
        "src/arch",
        "src/common",
        "src/libm",
    ],
    deps = [":headers"],
)

cc_library(
    name = "headers",
    hdrs = [":sleef_h"],
    # Without it, MinGW builds declare the functions __declspec(dllimport).
    defines = ["SLEEF_STATIC_LIBS=1"],
    includes = ["include"],
)

# -----------------------------------------------------------------------------
# libsleef
# -----------------------------------------------------------------------------

_COPTS = [
    "-std=gnu99",
    # Always compile sleef with -ffp-contract=off (Configure.cmake).
    "-ffp-contract=off",
] + select({
    "@platforms//os:windows": ["-fno-asynchronous-unwind-tables"],
    "//conditions:default": [],
})

# COMMON_TARGET_DEFINITIONS. Weak aliases (ENABLE_ALIAS) are an ELF feature.
_DEFINES = [
    "ENABLE_BUILTIN_MATH=1",
    "SLEEF_STATIC_LIBS=1",
] + select({
    "@platforms//os:linux": [
        "ENABLE_ALIAS=1",
        "ENABLE_SYS_getrandom=1",
    ],
    "//conditions:default": [],
})

# The functions of every extension of the target architecture, in their
# regular and DETERMINISTIC variants.
[
    cc_library(
        name = "sleef_{}_{}{}".format(
            arch,
            extension.lower(),
            "_det" if deterministic else "",
        ),
        srcs = [
            "src/libm/sleefsimddp.c",
            "src/libm/sleefsimdsp.c",
        ] + ([":alias_" + extension.lower()] if alias else []),
        copts = _COPTS + flags,
        local_defines = _DEFINES + [
            "DORENAME=1",
            "ENABLE_{}=1".format(extension),
        ] + (["DETERMINISTIC=1"] if deterministic else []) + (
            # Bazel tokenizes defines like a shell, so the quotes are escaped.
            ['ALIAS_NO_EXT_SUFFIX=\\"alias_{}.h\\"'.format(extension.lower())] if alias else []
        ),
        target_compatible_with = ["@platforms//cpu:" + arch],
        deps = [":internal_headers"],
    )
    for arch, (extensions, _) in _ARCHS.items()
    for extension, (_, _, flags, alias) in extensions.items()
    for deterministic in [
        False,
        True,
    ]
]

# The dispatchers, which pick the best extension of a vector width at runtime.
sleef_generate(
    name = "dispscalar_body",
    out = "gen/dispscalar.c.body",
    arguments = [
        "1",
        "1",
        "double",
        "float",
        "int32_t",
        "purec",
        "purecfma",
        "x",
    ],
    tool = ":mkdisp",
)

sleef_concat(
    name = "dispscalar_c",
    srcs = [
        "src/libm/dispscalar.c.org",
        "src/libm/dispscalar_footer.c.org",
        ":dispscalar_body",
    ],
    out = "gen/dispscalar.c",
)

[
    [
        sleef_generate(
            name = "disp{}_body".format(name),
            out = "gen/disp{}.c.tmp".format(name),
            arguments = arguments,
            tool = ":mkdisp",
        ),
        sleef_concat(
            name = "disp{}_c".format(name),
            srcs = [
                "src/libm/disp{}.c.org".format(name),
                ":disp{}_body".format(name),
            ],
            out = "gen/disp{}.c".format(name),
        ),
        cc_library(
            name = "disp" + name,
            srcs = [":disp{}_c".format(name)],
            copts = _COPTS + flags,
            local_defines = _DEFINES + [
                "ENABLE_AVX2=1",
                "ENABLE_FMA4=1",
            ],
            target_compatible_with = ["@platforms//cpu:x86_64"],
            deps = [":internal_headers"],
        ),
    ]
    for name, arguments, flags in [
        (
            "sse",
            [
                "2",
                "4",
                "__m128d",
                "__m128",
                "__m128i",
                "sse2",
                "sse4",
                "avx2128",
            ],
            ["-msse2"],
        ),
        (
            "avx",
            [
                "4",
                "8",
                "__m256d",
                "__m256",
                "__m128i",
                "avx",
                "fma4",
                "avx2",
            ],
            ["-mavx"],
        ),
    ]
]

cc_library(
    name = "sleef",
    srcs = [
        "src/common/common.c",
        "src/libm/rempitab.c",
        "src/libm/sleefld.c",
        ":dispscalar_c",
    ],
    copts = _COPTS,
    local_defines = _DEFINES + ["DORENAME=1"],
    visibility = ["//visibility:public"],
    deps = [
        ":headers",
        ":internal_headers",
    ] + select({
        ":" + arch: [
            ":sleef_{}_{}{}".format(
                arch,
                extension.lower(),
                suffix,
            )
            for extension in extensions
            for suffix in [
                "",
                "_det",
            ]
        ] + ([
            ":dispavx",
            ":dispsse",
        ] if arch == "x86_64" else [])
        for arch, (extensions, _) in _ARCHS.items()
    }),
    alwayslink = True,
)
