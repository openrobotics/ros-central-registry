# Bazel build of SLEEF's vectorized math library (libsleef), following
# src/libm/CMakeLists.txt and Configure.cmake for x86_64 and aarch64 targets.
#
# The code generators (mkrename, mkalias, mkdisp) are host tools, so
# cross-compiling works between any (host, target) pair. The GNU ABI, quad
# precision, DFT and inline-header libraries are not built.
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load(":sleef.bzl", "sleef_concat", "sleef_generate")

package(default_applicable_licenses = [":license"])

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSL-1.0"],
    license_text = "LICENSE.txt",
)

exports_files(["LICENSE.txt"])

# -----------------------------------------------------------------------------
# Host code generators
# -----------------------------------------------------------------------------

[
    cc_binary(
        name = tool,
        srcs = [
            "src/libm/funcproto.h",
            "src/libm/{}.c".format(tool),
        ],
        # Its main() is called by bazel/tool_main.c, which redirects stdout.
        local_defines = ["main=sleef_tool_main"],
        deps = ["//bazel:tool_main"],
    )
    for tool in [
        "mkalias",
        "mkdisp",
        "mkrename",
    ]
]

# -----------------------------------------------------------------------------
# Vector extensions (Configure.cmake, src/libm/CMakeLists.txt)
# -----------------------------------------------------------------------------

