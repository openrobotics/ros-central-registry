# Bazel build of lely-core, matching how ros2_canopen's lely_core_libraries
# builds it upstream (ExternalProject_Add + `configure --disable-cython
# --disable-doc --disable-tests --disable-static --disable-diag`). Per-library
# source lists and inter-library links mirror src/<lib>/Makefile.am for that
# configuration.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc_autoconf//autoconf:autoconf.bzl", "autoconf")
load("@rules_cc_autoconf//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:py_library.bzl", "py_library")
load(":lely_config_checks.bzl", "LELY_CONFIG_CHECKS")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
    license_text = "LICENSE",
)

exports_files([
    "LICENSE",
    # Entry point for @rosdistro//python:dcfgen (dcfgen = dcfgen.cli:main).
    "python/dcf-tools/dcfgen/cli.py",
])

