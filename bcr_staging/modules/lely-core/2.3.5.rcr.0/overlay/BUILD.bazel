# The GitLab source archive has no autoheader output, so the overlay carries
# config.h.in as produced by `autoreconf -i` for this commit.
autoconf_hdr(
    name = "config_h",
    out = "generated/config.h",
    template = "config.h.in",
    deps = [
        ":config_checks",
        "@rules_cc_autoconf//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "@rules_cc_autoconf//autoconf/macros/AC_USE_SYSTEM_EXTENSIONS",
    ],
)

cc_library(
    name = "config",
    hdrs = [":config_h"],
    includes = ["generated"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "headers",
    hdrs = PUBLIC_HDRS,
    includes = ["include"],
)

