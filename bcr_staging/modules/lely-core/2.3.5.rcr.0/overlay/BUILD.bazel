# python/dcf-tools (dcfgen, dcfchk, dcf2dev) at the same commit, so DCF
# generation matches upstream exactly. Runtime deps (PyYAML, empy) are attached
# by the consumer (see @rosdistro//python:dcf_tools).
py_library(
    name = "dcf_tools",
    srcs = [
        "python/dcf-tools/dcf/__init__.py",
        "python/dcf-tools/dcf/cli.py",
        "python/dcf-tools/dcf/device.py",
        "python/dcf-tools/dcf/lint.py",
        "python/dcf-tools/dcf/parse.py",
        "python/dcf-tools/dcf/print.py",
        "python/dcf-tools/dcf2dev/__init__.py",
        "python/dcf-tools/dcf2dev/cdevice.py",
        "python/dcf-tools/dcf2dev/cli.py",
        "python/dcf-tools/dcfgen/__init__.py",
        "python/dcf-tools/dcfgen/cli.py",
    ],
    data = [
        "python/dcf-tools/dcf2dev/data/dev.c.em",
        "python/dcf-tools/dcf2dev/data/dev.h.em",
        "python/dcf-tools/dcfgen/data/master.dcf.em",
    ],
    imports = ["python/dcf-tools"],
)
