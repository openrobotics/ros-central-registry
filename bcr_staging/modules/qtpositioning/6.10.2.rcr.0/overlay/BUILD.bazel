    applicable_licenses = [":license_poly2tri"],
    copts = ["-w"],
    includes = ["src/3rdparty/poly2tri"],
)

cc_library(
    name = "clipper",
    srcs = ["src/3rdparty/clipper/clipper.cpp"],
    hdrs = ["src/3rdparty/clipper/clipper.h"],
    applicable_licenses = [":license_clipper"],
    copts = ["-w"],
    includes = ["src/3rdparty/clipper"],
)

cc_library(
    name = "clip2tri",
    srcs = ["src/3rdparty/clip2tri/clip2tri.cpp"],
    hdrs = ["src/3rdparty/clip2tri/clip2tri.h"],
    applicable_licenses = [":license_clip2tri"],
    copts = ["-w"],
    includes = ["src/3rdparty/clip2tri"],
    deps = [
        ":clipper",
        ":poly2tri",
    ],
)

