    ],
    license_text = "LICENSES/LGPL-3.0-only.txt",
)

license(
    name = "license_poly2tri",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
    license_text = "src/3rdparty/poly2tri/LICENSE",
)

license(
    name = "license_clipper",
    license_kinds = ["@rules_license//licenses/spdx:BSL-1.0"],
    license_text = "src/3rdparty/clipper/LICENSE",
)

license(
    name = "license_clip2tri",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
    license_text = "src/3rdparty/clip2tri/LICENSE",
)

cc_library(
    name = "poly2tri",
