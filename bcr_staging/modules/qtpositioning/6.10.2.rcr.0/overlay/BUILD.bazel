qt_dbus_interface(
    name = "geoclue2_dbus",
    srcs = [
        "src/plugins/position/geoclue2/org.freedesktop.GeoClue2.Client.xml",
        "src/plugins/position/geoclue2/org.freedesktop.GeoClue2.Location.xml",
        "src/plugins/position/geoclue2/org.freedesktop.GeoClue2.Manager.xml",
    ],
    flags = [
        "-N",
        "-i",
        "geocluetypes.h",
        "--namespace",
        "QtPositioningPrivate",
    ],
)

filegroup(
    name = "geoclue2_dbus_hdrs",
    srcs = [":geoclue2_dbus"],
    output_group = "headers",
)

filegroup(
    name = "geoclue2_dbus_srcs",
    srcs = [":geoclue2_dbus"],
    output_group = "sources",
)

qt_plugin(
    name = "qtposition_geoclue2",
    srcs = [
        "src/plugins/position/geoclue2/geocluetypes.cpp",
        "src/plugins/position/geoclue2/qgeopositioninfosource_geoclue2.cpp",
        "src/plugins/position/geoclue2/qgeopositioninfosourcefactory_geoclue2.cpp",
        ":geoclue2_dbus_srcs",
    ],
    hdrs = [
        "src/plugins/position/geoclue2/geocluetypes.h",
        "src/plugins/position/geoclue2/qgeopositioninfosource_geoclue2_p.h",
        "src/plugins/position/geoclue2/qgeopositioninfosourcefactory_geoclue2.h",
        ":geoclue2_dbus_hdrs",
    ],
    included_moc_hdrs = [
        "src/plugins/position/geoclue2/qgeopositioninfosource_geoclue2_p.h",
        "src/plugins/position/geoclue2/qgeopositioninfosourcefactory_geoclue2.h",
        ":geoclue2_dbus_hdrs",
    ],
    includes = ["src/plugins/position/geoclue2"],
    plugin_class_name = "QGeoPositionInfoSourceFactoryGeoclue2",
    target_compatible_with = ["@platforms//os:linux"],
    textual_hdrs = ["src/plugins/position/geoclue2/plugin.json"],
    deps = [
        ":geoclue2_dbus",
        ":positioning",
        "@qtbase//:core",
        "@qtbase//:dbus",
    ],
)

qt_plugin(
    name = "qtposition_cl",
    srcs = [
        "src/plugins/position/corelocation/qgeopositioninfosource_cl.mm",
        "src/plugins/position/corelocation/qgeopositioninfosourcefactory_cl.mm",
    ],
    hdrs = [
        "src/plugins/position/corelocation/qgeopositioninfosource_cl_p.h",
        "src/plugins/position/corelocation/qgeopositioninfosourcefactory_cl.h",
    ],
    included_moc_hdrs = [
        "src/plugins/position/corelocation/qgeopositioninfosource_cl_p.h",
        "src/plugins/position/corelocation/qgeopositioninfosourcefactory_cl.h",
    ],
    includes = ["src/plugins/position/corelocation"],
    linkopts = [
        "-framework",
        "CoreLocation",
        "-framework",
        "Foundation",
    ],
    plugin_class_name = "QGeoPositionInfoSourceFactoryCL",
    target_compatible_with = ["@platforms//os:macos"],
    textual_hdrs = ["src/plugins/position/corelocation/plugin.json"],
    deps = [
        ":positioning",
        "@qtbase//:core",
    ],
)

cc_library(
    name = "position_plugins",
    deps = [
        ":qtposition_nmea",
        ":qtposition_positionpoll",
    ] + select({
        "@platforms//os:linux": [":qtposition_geoclue2"],
        "@platforms//os:macos": [":qtposition_cl"],
        "//conditions:default": [],
    }),
)
