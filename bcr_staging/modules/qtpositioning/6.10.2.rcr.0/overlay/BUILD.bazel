qt_plugin(
    name = "positioningquickplugin",
    srcs = ["src/positioningquick/positioningplugin.cpp"],
    moc_opts = ["-Muri=QtPositioning"],
    plugin_class_name = "QtPositioningDeclarativeModule",
    deps = [
        ":positioning",
        ":positioningquick",
        "@qtbase//:core",
        "@qtdeclarative//:qml",
        "@qtdeclarative//:quick",
    ],
)

