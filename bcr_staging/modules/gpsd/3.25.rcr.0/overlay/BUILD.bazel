load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-2-Clause",
    ],
    license_text = "COPYING",
)

cc_library(
    name = "gpsd",
    srcs = [
        "libgps/ais_json.c",
        "libgps/bits.c",
        "libgps/gps_maskdump.c",
        "libgps/gpsdclient.c",
        "libgps/gpsutils.c",
        "libgps/hex.c",
        "libgps/json.c",
        "libgps/libgps_core.c",
        "libgps/libgps_dbus.c",
        "libgps/libgps_json.c",
        "libgps/libgps_shm.c",
        "libgps/libgps_sock.c",
        "libgps/libgpsmm.cpp",
        "libgps/netlib.c",
        "libgps/ntpshmread.c",
        "libgps/os_compat.c",
        "libgps/rtcm2_json.c",
        "libgps/rtcm3_json.c",
        "libgps/shared_json.c",
        "libgps/timespec_str.c",
    ],
    hdrs = [
        "include/gps.h",
        "include/libgpsmm.h",
    ],
    includes = [
        "include",
        "libgps",
    ],
    linkopts = [
        "-lm",
        "-lpthread",
        "-lrt",
    ],
    local_defines = ["MAX_DEVICES=4"],
    textual_hdrs = glob(
        ["include/*.h"],
        exclude = [
            "include/gps.h",
            "include/libgpsmm.h",
        ],
    ) + [
        "libgps/ais_json.i",
    ],
)
