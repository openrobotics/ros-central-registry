# The OpenGL rendering stack here is written for X11/GLX (vtkXRenderWindow*,
# the libglvnd link-time stubs, GLX headers), none of which exist on macOS or
# Windows. Rather than making every VTK consumer incompatible there, confine
# that stack -- and the modules that depend on it -- to Linux. The non-rendering
# modules (Common*, Filters*, IO*, Imaging*, ...) are what PCL's io/surface need
# and build everywhere.
_LINUX_ONLY = select({
    "@platforms//os:linux": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

