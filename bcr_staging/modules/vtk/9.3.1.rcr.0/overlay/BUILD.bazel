py_binary(
    name = "vtk_gen",
    srcs = ["vtk_gen.py"],
    legacy_create_init = 0,
)

genrule(
    name = "vtk_generated_files",
    srcs = glob([
        "CMake/*.in",
        "Common/Core/*.in",
        "Rendering/Core/*.in",
        "Rendering/OpenGL2/*.in",
        "Rendering/OpenGL2/glsl/*.glsl",
        "Rendering/VolumeOpenGL2/shaders/*.glsl",
        "ThirdParty/**/*.in",
        "Utilities/DICOMParser/*.in",
        "Utilities/KWIML/vtkkwiml/include/kwiml/*.h",
        "Utilities/KWIML/vtkkwiml/src/*.in",
        "Utilities/KWSys/vtksys/*.in",
        "Utilities/MetaIO/vtkmetaio/*.in",
    ]) + [
        "Parallel/Core/vtkSocketCommunicator.cxx",
        "Rendering/OpenGL2/textures/BlueNoiseTexture64x64.jpg",
    ],
    outs = _GEN_INCLUDES + _COMMON_CORE_GEN_SRCS + _OTHER_GEN_SRCS,
    cmd = "$(execpath :vtk_gen) $(execpath Common/Core/vtkBuild.h.in) $(RULEDIR)",
    tools = [":vtk_gen"],
)

cc_library(
    name = "vtk_gen_hdrs",
    hdrs = _GEN_INCLUDES,
    includes = [
        "gen_include",
        "gen_include/vtkdoubleconversion/double-conversion",
        "gen_include/vtkmetaio",
        "gen_include/vtkverdict",
    ],
)

