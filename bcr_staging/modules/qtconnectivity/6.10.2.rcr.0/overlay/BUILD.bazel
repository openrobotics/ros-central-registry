# ============================================================================
# Qt6Nfc (Neard on Linux, PCSCLite on macOS/Windows)
# ============================================================================

qt_export_header(
    name = "nfc_export",
    module_Header = "Nfc",
    module_name = "nfc",
)

qt_config_header(
    name = "nfc_config",
    out = "qtnfc-config.h",
    content = """#pragma once
#if defined(__linux__)
#define QT_FEATURE_pcsclite -1
#define QT_FEATURE_neard 1
#elif defined(__APPLE__) || defined(_WIN32)
#define QT_FEATURE_pcsclite 1
#define QT_FEATURE_neard -1
#else
#define QT_FEATURE_pcsclite -1
#define QT_FEATURE_neard -1
#endif
""",
)

qt_config_header(
    name = "nfc_private_config",
    out = "qtnfc-config_p.h",
    content = """#pragma once
#include "qtnfc-config.h"
""",
)

qt_dbus_interface(
    name = "nfc_neard_dbus",
    srcs = [
        "src/nfc/neard/org.freedesktop.dbus.objectmanager.xml",
        "src/nfc/neard/org.freedesktop.dbus.properties.xml",
        "src/nfc/neard/org.neard.Adapter.xml",
        "src/nfc/neard/org.neard.Tag.xml",
    ],
    flags = [
        "-i",
        "neard/neard_dbus_types_p.h",
        "--namespace",
        "QtNfcPrivate",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

filegroup(
    name = "nfc_neard_dbus_hdrs",
    srcs = [":nfc_neard_dbus"],
    output_group = "headers",
    target_compatible_with = ["@platforms//os:linux"],
)

filegroup(
    name = "nfc_neard_dbus_srcs",
    srcs = [":nfc_neard_dbus"],
    output_group = "sources",
    target_compatible_with = ["@platforms//os:linux"],
)

