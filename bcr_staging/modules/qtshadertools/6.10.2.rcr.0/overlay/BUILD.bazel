)

# =============================================================================
# SPIRV-Cross (src/SPIRV-Cross/CMakeLists.txt: BundledSpirv_Cross)
# =============================================================================

cc_library(
    name = "spirv_cross",
    srcs = [
        "src/3rdparty/SPIRV-Cross/spirv_cfg.cpp",
        "src/3rdparty/SPIRV-Cross/spirv_cpp.cpp",
        "src/3rdparty/SPIRV-Cross/spirv_cross.cpp",
        "src/3rdparty/SPIRV-Cross/spirv_cross_c.cpp",
        "src/3rdparty/SPIRV-Cross/spirv_cross_parsed_ir.cpp",
        "src/3rdparty/SPIRV-Cross/spirv_cross_util.cpp",
        "src/3rdparty/SPIRV-Cross/spirv_glsl.cpp",
        "src/3rdparty/SPIRV-Cross/spirv_hlsl.cpp",
        "src/3rdparty/SPIRV-Cross/spirv_msl.cpp",
        "src/3rdparty/SPIRV-Cross/spirv_parser.cpp",
        "src/3rdparty/SPIRV-Cross/spirv_reflect.cpp",
