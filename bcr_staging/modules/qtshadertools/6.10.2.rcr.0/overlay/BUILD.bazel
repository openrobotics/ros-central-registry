        "src/3rdparty/glslang/glslang/MachineIndependent/ParseHelper.cpp",
        "src/3rdparty/glslang/glslang/MachineIndependent/PoolAlloc.cpp",
        "src/3rdparty/glslang/glslang/MachineIndependent/RemoveTree.cpp",
        "src/3rdparty/glslang/glslang/MachineIndependent/Scan.cpp",
        "src/3rdparty/glslang/glslang/MachineIndependent/ShaderLang.cpp",
        "src/3rdparty/glslang/glslang/MachineIndependent/SpirvIntrinsics.cpp",
        "src/3rdparty/glslang/glslang/MachineIndependent/SymbolTable.cpp",
        "src/3rdparty/glslang/glslang/MachineIndependent/Versions.cpp",
        "src/3rdparty/glslang/glslang/MachineIndependent/attribute.cpp",
        "src/3rdparty/glslang/glslang/MachineIndependent/glslang_tab.cpp",
        "src/3rdparty/glslang/glslang/MachineIndependent/intermOut.cpp",
        "src/3rdparty/glslang/glslang/MachineIndependent/iomapper.cpp",
