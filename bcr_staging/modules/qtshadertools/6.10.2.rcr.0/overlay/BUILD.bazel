cc_library(
    name = "glslang_spirv",
    srcs = [
        "src/3rdparty/glslang/SPIRV/GlslangToSpv.cpp",
        "src/3rdparty/glslang/SPIRV/InReadableOrder.cpp",
        "src/3rdparty/glslang/SPIRV/Logger.cpp",
        "src/3rdparty/glslang/SPIRV/SPVRemapper.cpp",
        "src/3rdparty/glslang/SPIRV/SpvBuilder.cpp",
        "src/3rdparty/glslang/SPIRV/SpvPostProcess.cpp",
        "src/3rdparty/glslang/SPIRV/SpvTools.cpp",
        "src/3rdparty/glslang/SPIRV/disassemble.cpp",
        "src/3rdparty/glslang/SPIRV/doc.cpp",
    ],
    hdrs = GLSLANG_HDRS,
    applicable_licenses = [":glslang_license"],
    copts = third_party_copts,
    includes = ["src/3rdparty/glslang"],
    local_defines = GLSLANG_OS_DEFINES,
    visibility = ["//visibility:private"],
