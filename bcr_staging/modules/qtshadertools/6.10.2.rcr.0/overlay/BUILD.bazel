load("@qt//:qt_internal_library.bzl", "qt_internal_library")
load(
    "@qt//:qt_tools.bzl",
    "qt_depends_header",
    "qt_export_header",
    "qt_sync_headers",
)
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:LGPL-3.0-only",
    ],
    license_text = "LICENSES/LGPL-3.0-only.txt",
)

# src/3rdparty/glslang/qt_attribution.json: "BSD-3-Clause AND LicenseRef-MIT-Khronos-old
# AND Apache-2.0 AND GPL-3.0-or-later WITH Bison-exception-2.2 AND AML-glslang".
# The GPL component is the Bison-generated parser (glslang_tab.cpp), covered by the
# Bison exception, so it does not propagate to linked code.
license(
    name = "glslang_license",
    package_name = "glslang 15.1.0 (Qt vendored)",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
        "@rules_license//licenses/spdx:Apache-2.0",
        "@rules_license//licenses/spdx:MIT",
    ],
    license_text = "src/3rdparty/glslang/LICENSE.txt",
)

# src/3rdparty/SPIRV-Cross/qt_attribution.json: "Apache-2.0 AND LicenseRef-MIT-Khronos-old".
license(
    name = "spirv_cross_license",
    package_name = "SPIRV-Cross ebe2aa0c (Qt vendored)",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
        "@rules_license//licenses/spdx:MIT",
    ],
    license_text = "src/3rdparty/SPIRV-Cross/LICENSE",
)

exports_files([
    "LICENSES/LGPL-3.0-only.txt",
    "src/3rdparty/glslang/LICENSE.txt",
    "src/3rdparty/SPIRV-Cross/LICENSE",
])

QT_VERSION = "6.10.2"

common_copts = [
    "-w",
    "-fPIC",
    "-O2",
    "-DNDEBUG",
    "-DQT_NO_CAST_TO_ASCII",
    "-DQT_BUILDING_QT",
]

# From .cmake.conf QT_EXTRA_INTERNAL_TARGET_DEFINES (this repo *does* opt into
# QT_LEAN_HEADERS) plus the usual Qt module set.
common_local_defines = [
    "QT_ASCII_CAST_WARNINGS",
    "QT_BUILDING_QT",
    "QT_CORE_LIB",
    "QT_DEPRECATED_WARNINGS",
    "QT_EXPLICIT_QFILE_CONSTRUCTION_FROM_PATH",
    "QT_GUI_LIB",
    "QT_LEAN_HEADERS=1",
    "QT_MOC_COMPAT",
    "QT_NO_AS_CONST=1",
    "QT_NO_CAST_TO_ASCII",
    "QT_NO_DEBUG",
    "QT_NO_FOREACH=1",
    "QT_NO_JAVA_STYLE_ITERATORS",
    "QT_NO_NARROWING_CONVERSIONS_IN_CONNECT",
    "QT_NO_QEXCHANGE",
    "QT_NO_QSNPRINTF",
    "QT_NO_USING_NAMESPACE",
    "QT_USE_NODISCARD_FILE_OPEN",
    "QT_USE_QSTRINGBUILDER",
    "_GLIBCXX_ASSERTIONS",
    "_LARGEFILE64_SOURCE",
    "_LARGEFILE_SOURCE",
]

# Bundled third-party libraries are hidden-visibility static libs (as upstream:
# qt_set_symbol_visibility_hidden); they only ever link into libshadertools_shared.so.
third_party_copts = [
    "-w",
    "-fPIC",
    "-O2",
    "-DNDEBUG",
    "-fvisibility=hidden",
    "-fvisibility-inlines-hidden",
    "-std=gnu++20",
]

# =============================================================================
# glslang (src/glslang/CMakeLists.txt: BundledGlslang_{Spirv,Osdependent,Glslang})
# =============================================================================

GLSLANG_HDRS = glob([
    "src/3rdparty/glslang/glslang/**/*.h",
    "src/3rdparty/glslang/SPIRV/**/*.h",
    "src/3rdparty/glslang/SPIRV/**/*.hpp",
])

GLSLANG_OS_DEFINES = select({
    "@platforms//os:windows": ["GLSLANG_OSINCLUDE_WIN32"],
    "//conditions:default": ["GLSLANG_OSINCLUDE_UNIX"],
})

cc_library(
    name = "glslang_osdependent",
    srcs = select({
        "@platforms//os:windows": ["src/3rdparty/glslang/glslang/OSDependent/Windows/ossource.cpp"],
        "//conditions:default": ["src/3rdparty/glslang/glslang/OSDependent/Unix/ossource.cpp"],
    }),
    hdrs = GLSLANG_HDRS,
    applicable_licenses = [":glslang_license"],
    copts = third_party_copts,
    includes = ["src/3rdparty/glslang"],
    linkopts = select({
        "@platforms//os:linux": ["-lpthread"],
        "//conditions:default": [],
    }),
    local_defines = GLSLANG_OS_DEFINES,
    visibility = ["//visibility:private"],
)

cc_library(
    name = "glslang_glslang",
    srcs = [
        "src/3rdparty/glslang/glslang/GenericCodeGen/CodeGen.cpp",
