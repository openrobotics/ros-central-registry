# =============================================================================
# QtShaderTools (:shadertools + :shadertools_shared)
# =============================================================================

qt_export_header(
    name = "qtshadertoolsexports_h",
    out = "generated_exports/qtshadertoolsexports.h",
    module_infix = "SHADERTOOLS",
)

qt_depends_header(
    name = "qtshadertools_depends_h",
    out = "generated_exports/QtShaderToolsDepends",
    dep_modules = [
        "QtCore",
        "QtGui",
    ],
)

qt_sync_headers(
    name = "shadertools_sync_headers",
    hdrs = glob(["src/shadertools/*.h"]),
    generated_public_hdrs = [
        ":qtshadertoolsexports_h",
        ":qtshadertools_depends_h",
    ],
    module_name = "QtShaderTools",
    # Upstream RHI_HEADER_FILTERS "(^|/)qshaderbaker\\.h$": installed as <rhi/qshaderbaker.h>.
    rhi_filter = "^qshaderbaker\\.h$",
    source_dir = "src/shadertools",
    version = QT_VERSION,
    deps = [
        "@qtbase//:core_sync_headers",
        "@qtbase//:gui_sync_headers",
    ],
)

qt_internal_library(
    name = "shadertools",
    srcs = [
        "src/shadertools/qshaderbaker.cpp",
        "src/shadertools/qshaderrewriter.cpp",
        "src/shadertools/qspirvcompiler.cpp",
        "src/shadertools/qspirvshader.cpp",
        "src/shadertools/qspirvshaderremap.cpp",
    ],
    hdrs = glob(["src/shadertools/*.h"]),
    copts = common_copts + ["-fexceptions"],
    cxxopts = ["-std=gnu++20"],
    defines = ["QT_SHADERTOOLS_LIB"],
    dynamic_deps = [
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
    ],
    includes = ["src/shadertools"],
    local_defines = common_local_defines + [
        "QT_BUILD_SHADERTOOLS_LIB",
        "ShaderTools_EXPORTS",
    ],
    deps = [
        ":glslang_spirv",
        ":shadertools_sync_headers",
        ":spirv_cross",
        "@qtbase//:core",
        "@qtbase//:core_internal_cfg",
        "@qtbase//:gui",
        "@qtbase//:gui_internal_cfg",
    ],
)

# =============================================================================
# qsb (tools/qsb): the Qt Shader Baker host tool
# =============================================================================

cc_binary(
    name = "qsb",
    srcs = ["tools/qsb/qsb.cpp"],
    copts = common_copts + ["-std=gnu++20"],
    linkstatic = True,
    local_defines = common_local_defines + [
        "QT_NO_VERSION_TAGGING",
        "QT_SHADERTOOLS_LIB",
    ],
    deps = [
        ":shadertools",
        "@qtbase//:core",
        "@qtbase//:core_internal_cfg",
        "@qtbase//:gui",
        "@qtbase//:gui_internal_cfg",
    ],
)
