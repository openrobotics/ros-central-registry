load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load(":glvnd_stubs.bzl", "glvnd_stubs")

package(
    default_applicable_licenses = [":license"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
    license_text = "README.md",
)

exports_files(["README.md"])

_UNIX_GL_COMPATIBLE = select({
    "@platforms//os:linux": [],
    "@platforms//os:freebsd": [],
    "@platforms//os:openbsd": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# <GL/glx.h>, the GLX client API header that distributions install from
# libglvnd. Only glx.h is exported: libglvnd's copies of the Khronos headers
# (GL/gl.h, GL/glext.h, GL/glxext.h, EGL/, GLES*/, KHR/) come from
# @opengl-registry and @egl-registry instead, so there is a single copy of
# each on the include path.
cc_library(
    name = "glx_headers",
    hdrs = ["include/GL/glx.h"],
    strip_include_prefix = "include",
    target_compatible_with = _UNIX_GL_COMPATIBLE,
    visibility = ["//visibility:public"],
    deps = [
        "@libx11",
        "@opengl-registry//:OpenGL_headers",
    ],
)

cc_binary(
    name = "gl_stub_gen",
    srcs = ["gl_stub_gen.cc"],
    linkstatic = True,
    visibility = ["//visibility:private"],
)

# Link-time-only libglvnd stub shared libraries (libGL.so.1, libGLX.so.0,
# libOpenGL.so.0, libEGL.so.1) generated from Khronos registry headers.
glvnd_stubs(
    name = "glvnd_stubs",
    hdr_deps = [
        ":glx_headers",
        "@egl-registry//:EGL_headers",
        "@opengl-registry//:GLES2_headers",
        "@opengl-registry//:GLES3_headers",
        "@opengl-registry//:OpenGL_headers",
    ],
    tags = ["__CC_SHARED_LIBRARY_DO_NOT_CHECK_LINK_ONCE__"],
    target_compatible_with = _UNIX_GL_COMPATIBLE,
    visibility = ["//visibility:public"],
)
