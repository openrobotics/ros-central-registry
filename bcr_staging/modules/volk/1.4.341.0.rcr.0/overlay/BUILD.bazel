load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(default_applicable_licenses = [":license"])

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
    license_text = "LICENSE.md",
)

exports_files(["LICENSE.md"])

# volk, the Vulkan meta-loader: volkInitialize() loads the Vulkan loader
# (libvulkan.so.1, vulkan-1.dll, libvulkan.dylib/MoltenVK) at runtime, so
# programs need no Vulkan library at link time and run without one.
cc_library(
    name = "volk",
    srcs = ["volk.c"],
    hdrs = ["volk.h"],
    includes = ["."],
    linkopts = select({
        "@platforms//os:linux": ["-ldl"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = ["@vulkan_headers//:vulkan_headers_no_prototypes"],
)
