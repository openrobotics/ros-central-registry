    "src/timeline/blendtrees/qtimelineanimationnode_p.h",
    "src/timeline/blendtrees/qtquicktimelineblendtreesglobal.h",
    "src/timeline/blendtrees/qtquicktimelineblendtreesglobal_p.h",
]

qt_module_headers(
    name = "quicktimelineblendtrees_headers",
    hdrs = QUICKTIMELINEBLENDTREES_HEADERS,
    extra_deps = [":quicktimelineblendtrees_export"],
    module_name = "QuickTimelineBlendTrees",
)

qt_qml_module(
    name = "quicktimelineblendtrees",
    srcs = [
        "src/timeline/blendtrees/qblendanimationnode.cpp",
        "src/timeline/blendtrees/qblendtreenode.cpp",
        "src/timeline/blendtrees/qtimelineanimationnode.cpp",
    ],
    hdrs = QUICKTIMELINEBLENDTREES_HEADERS,
    create_shared = True,
    dynamic_deps = [
        ":quicktimeline_shared",
        "@qtdeclarative//:quick_shared",
        "@qtdeclarative//:qmlmeta_shared",
        "@qtdeclarative//:qmlmodels_shared",
        "@qtdeclarative//:qmlworkerscript_shared",
        "@qtdeclarative//:qml_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:network_shared",
        "@qtbase//:core_shared",
    ] + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@qtbase//:dbus_shared"],
    }),
    import_name = "QtQuick.Timeline.BlendTrees",
    import_version = "6.10",
    includes = ["src/timeline/blendtrees"],
    local_defines = [
        "QT_BUILD_QUICKTIMELINEBLENDTREES_LIB",
    ],
    plugin_class_name = "QtQuickTimelineBlendTreesPlugin",
    plugin_target = "qtquicktimelineblendtreesplugin",
    deps = [
        ":quicktimeline",
        ":quicktimelineblendtrees_export",
        ":quicktimelineblendtrees_headers",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtdeclarative//:qml",
        "@qtdeclarative//:quick",
    ],
)
