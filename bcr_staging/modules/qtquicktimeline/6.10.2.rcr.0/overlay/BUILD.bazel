load(
    "@qt//:qt.bzl",
    "qt_export_header",
    "qt_module_headers",
    "qt_qml_module",
)
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
    license_text = "LICENSES/GPL-3.0-only.txt",
)

# ============================================================================
# Qt6QuickTimeline + qtquicktimelineplugin
# ============================================================================

qt_export_header(
    name = "quicktimeline_export",
    module_Header = "QuickTimeline",
    module_name = "quicktimeline",
)

QUICKTIMELINE_HEADERS = [
    "src/timeline/qquickkeyframe_p.h",
    "src/timeline/qquickkeyframedatautils_p.h",
    "src/timeline/qquicktimeline_p.h",
    "src/timeline/qquicktimelineanimation_p.h",
    "src/timeline/qtquicktimelineglobal.h",
    "src/timeline/qtquicktimelineglobal_p.h",
]

qt_module_headers(
    name = "quicktimeline_headers",
    hdrs = QUICKTIMELINE_HEADERS,
    extra_deps = [":quicktimeline_export"],
    module_name = "QuickTimeline",
)

qt_qml_module(
    name = "quicktimeline",
    srcs = [
        "src/timeline/qquickkeyframe.cpp",
        "src/timeline/qquicktimeline.cpp",
        "src/timeline/qquicktimelineanimation.cpp",
    ],
    hdrs = QUICKTIMELINE_HEADERS,
    create_shared = True,
    dynamic_deps = [
        "@qtdeclarative//:quick_shared",
        "@qtdeclarative//:qmlmeta_shared",
        "@qtdeclarative//:qmlmodels_shared",
        "@qtdeclarative//:qmlworkerscript_shared",
        "@qtdeclarative//:qml_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:network_shared",
        "@qtbase//:core_shared",
    ] + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@qtbase//:dbus_shared"],
    }),
    import_name = "QtQuick.Timeline",
    import_version = "6.10",
    includes = ["src/timeline"],
    local_defines = [
        "QT_BUILD_QUICKTIMELINE_LIB",
        "QT_BUILD_QUICK_TIMELINE_LIB",
    ],
    plugin_class_name = "QtQuickTimelinePlugin",
    plugin_target = "qtquicktimelineplugin",
    deps = [
        ":quicktimeline_export",
        ":quicktimeline_headers",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtdeclarative//:qml",
        "@qtdeclarative//:quick",
    ],
)

# ============================================================================
