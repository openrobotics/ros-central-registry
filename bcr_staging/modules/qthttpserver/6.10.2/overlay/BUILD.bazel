load("@qt//:qt.bzl", "common_copts")
load("@qt//:qt_internal_library.bzl", "qt_internal_library")
load("@qt//:qt_tools.bzl", "qt_sync_headers", "qt_write_file")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
    license_text = "LICENSES/GPL-3.0-only.txt",
)

exports_files(["MODULE.bazel"])

_COMMON_DEFINES = [
    "QT_ASCII_CAST_WARNINGS",
    "QT_BUILDING_QT",
    "QT_DEPRECATED_WARNINGS",
    "QT_EXPLICIT_QFILE_CONSTRUCTION_FROM_PATH",
    "QT_MOC_COMPAT",
    "QT_NO_CAST_TO_ASCII",
    "QT_NO_CONTEXTLESS_CONNECT=1",
    "QT_NO_DEBUG",
    "QT_NO_EXCEPTIONS",
    "QT_NO_FOREACH=1",
    "QT_NO_JAVA_STYLE_ITERATORS",
    "QT_NO_NARROWING_CONVERSIONS_IN_CONNECT",
    "QT_NO_QASCONST=1",
    "QT_NO_QEXCHANGE",
    "QT_NO_QSNPRINTF",
    "QT_USE_QSTRINGBUILDER",
    "_GLIBCXX_ASSERTIONS",
    "_LARGEFILE64_SOURCE",
    "_LARGEFILE_SOURCE",
]

qt_write_file(
    name = "gen_httpserver_exports",
    out = "generated_cfg/include/QtHttpServer/qthttpserverexports.h",
    content = """// Generated by Bazel
#ifndef QTHTTPSERVEREXPORTS_H
#define QTHTTPSERVEREXPORTS_H

#include <QtCore/qcompilerdetection.h>
#include <QtCore/qtconfigmacros.h>
#include <QtCore/qtdeprecationmarkers.h>

#if defined(QT_SHARED) || !defined(QT_STATIC)
#  if defined(QT_BUILD_HTTPSERVER_LIB)
#    define Q_HTTPSERVER_EXPORT Q_DECL_EXPORT
#  else
#    define Q_HTTPSERVER_EXPORT Q_DECL_IMPORT
#  endif
#else
#  define Q_HTTPSERVER_EXPORT
#endif

#define QT_HTTPSERVER_REMOVED_SINCE(major, minor) 0

#endif // QTHTTPSERVEREXPORTS_H
""",
)

cc_library(
    name = "httpserver_cfg",
    hdrs = [":gen_httpserver_exports"],
    includes = [
        "generated_cfg/include",
        "generated_cfg/include/QtHttpServer",
    ],
)

qt_sync_headers(
    name = "httpserver_sync_headers",
    srcs = glob(["src/httpserver/*.h"]),
    dep_modules = [
        "QtCore",
        "QtNetwork",
    ],
    module_name = "QtHttpServer",
    source_dir = "src/httpserver",
)

qt_internal_library(
    name = "httpserver",
    srcs = [
        "src/httpserver/qabstracthttpserver.cpp",
        "src/httpserver/qhttpserver.cpp",
        "src/httpserver/qhttpserverconfiguration.cpp",
        "src/httpserver/qhttpserverhttp1protocolhandler.cpp",
        "src/httpserver/qhttpserverhttp2protocolhandler.cpp",
        "src/httpserver/qhttpserverliterals.cpp",
        "src/httpserver/qhttpserverparser.cpp",
        "src/httpserver/qhttpserverrequest.cpp",
        "src/httpserver/qhttpserverrequestfilter.cpp",
        "src/httpserver/qhttpserverresponder.cpp",
        "src/httpserver/qhttpserverresponse.cpp",
        "src/httpserver/qhttpserverrouter.cpp",
        "src/httpserver/qhttpserverrouterrule.cpp",
        "src/httpserver/qhttpserverstream.cpp",
        "src/httpserver/qhttpserverwebsocketupgraderesponse.cpp",
    ],
    hdrs = glob(["src/httpserver/*.h"]) + [":httpserver_sync_headers"],
    copts = common_copts + ["-std=gnu++20"],
    create_shared = True,
    defines = ["QT_HTTPSERVER_LIB"],
    dynamic_deps = [
        "@qtbase//:core_shared",
        "@qtbase//:network_shared",
        "@qtwebsockets//:websockets_shared",
    ],
    includes = ["src/httpserver"],
    local_defines = _COMMON_DEFINES + ["QT_BUILD_HTTPSERVER_LIB"],
    moc_hdrs = [
        "src/httpserver/qabstracthttpserver.h",
        "src/httpserver/qhttpserver.h",
        "src/httpserver/qhttpserverhttp1protocolhandler_p.h",
        "src/httpserver/qhttpserverhttp2protocolhandler_p.h",
        "src/httpserver/qhttpserverrequest.h",
        "src/httpserver/qhttpserverstream_p.h",
    ],
    moc_unity = True,
    deps = [
        ":httpserver_cfg",
        "@qtbase//:core",
        "@qtbase//:network",
        "@qtwebsockets//:websockets",
    ],
)
