load("@rules_license//rules:license.bzl", "license")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(
    default_applicable_licenses = [":license"],
)

license(
    name = "license",
    package_name = "gz-tools",
)

licenses(["notice"])

genrule(
    name = "gz_ruby_script",
    srcs = ["src/gz.in"],
    outs = ["gz.rb"],
    cmd = "sed -e 's|@CMAKE_INSTALL_PREFIX@/share/gz/|/dev/null|g' " +
          "-e 's|@ENV_PATH_DELIMITER@|:|g' " +
          "-e 's|@backward_library_name@||g' $< > $@",
)

sh_binary(
    name = "gz",
    srcs = ["gz_launcher.sh"],
    data = [
        "cmdsim.rb",
        "sim.yaml",
        "sim_gui.config",
        ":gz_ruby_script",
        "@gz-gui//:cmdgui_ruby_script",
        "@gz-gui//:gui_yaml",
        "@gz-gui//:gz-gui",
        "@gz-gui//:libCameraTracking.so",
        "@gz-gui//:libInteractiveViewControl.so",
        "@gz-gui//:libMarkerManager.so",
        "@gz-gui//:libMinimalScene.so",
        "@gz-gui//:libScreenshot.so",
        "@gz-gui//:libTransportSceneManager.so",
        "@gz-gui//:libWorldControl.so",
        "@gz-gui//:libWorldStats.so",
        "@gz-gui//:libgz-gui-shared.so",
        "@gz-sim//:gz-sim-gui-client",
        "@gz-sim//:gzsim_qml_module_plugin",
        "@gz-sim//:gzsim_qml_module_qmldir",
        "@gz-sim//:libComponentInspector.so",
        "@gz-sim//:libCopyPaste.so",
        "@gz-sim//:libEntityContextMenuPlugin.so",
        "@gz-sim//:libEntityTree.so",
        "@gz-sim//:libGzSceneManager.so",
        "@gz-sim//:libLights.so",
        "@gz-sim//:libSelectEntities.so",
        "@gz-sim//:libShapes.so",
        "@gz-sim//:libSpawn.so",
        "@gz-sim//:libTransformControl.so",
        "@gz-sim//:libVisualizationCapabilities.so",
        "@gz-sim//:libgz-sim-gui-shared.so",
        "@gz-sim//:src/gui/gui.config",
        "@gz-sim//:src/gui/playback_gui.config",
        "@gz-sim//:worlds",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@bazel_tools//tools/bash/runfiles",
    ],
)
