# MIOpen (include/miopen/).
expand_template(
    name = "miopen_version",
    out = "miopen/include/miopen/version.h",
    substitutions = rocm_version_substitutions(
        "MIOpen",
        VERSIONS["miopen"],
    ),
    template = "miopen/include/miopen/version.h.in",
)

# Of config.h.in's build options, miopen.h only reads the backend.
write_file(
    name = "miopen_config",
    out = "miopen/include/miopen/config.h",
    content = [
        "// The build options of MIOpen's HIP backend that miopen.h reads",
        "// (include/miopen/config.h.in).",
        "#ifndef GUARD_CONFIG_H_IN",
        "#define GUARD_CONFIG_H_IN",
        "#define MIOPEN_BACKEND_OPENCL 0",
        "#define MIOPEN_BACKEND_HIP 1",
        "#endif",
        "",
    ],
)

cmake_export_header(
    name = "miopen_export",
    out = "miopen/include/miopen/export.h",
    base_name = "MIOPEN",
)

cc_library(
    name = "miopen_headers",
    hdrs = [
        "miopen/include/miopen/miopen.h",
        ":miopen_config",
        ":miopen_export",
        ":miopen_version",
    ],
    strip_include_prefix = "miopen/include",
    deps = ["@hip-stub//:hip_headers"],
)

rocm_shim_library(
    name = "miopen",
    error = "6",  # miopenStatusNotImplemented
    export_macro = "MIOPEN_EXPORT",
    headers = ["miopen/include/miopen/miopen.h"],
    soname = "libMIOpen.so.1",
    visibility = ["//visibility:public"],
    deps = [":miopen_headers"],
)
