load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@rosidl_default_generators//:defs.bzl", "ros_action")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

cmake_configure_file(
    name = "plan_footsteps_action_gen",
    src = "PlanFootsteps.action.in",
    out = "PlanFootsteps.action",
    defines = ["DURATION_TYPE=builtin_interfaces/Duration"],
)

ros_action(
    name = "ExecFootsteps",
    src = "ExecFootsteps.action",
    deps = [
        "//msg:FootstepArray",
    ],
)

ros_action(
    name = "PlanFootsteps",
    src = "PlanFootsteps.action",
    deps = [
        "//msg:FootstepArray",
        "@builtin_interfaces//msg:Duration",
    ],
)
