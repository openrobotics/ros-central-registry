load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@rosidl_default_generators//:defs.bzl", "ros_message")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

cmake_configure_file(
    name = "footstep_msg_gen",
    src = "Footstep.msg.in",
    out = "Footstep.msg",
    defines = ["DURATION_TYPE=builtin_interfaces/Duration"],
)

ros_message(
    name = "Footstep",
    src = "Footstep.msg",
    deps = [
        "@builtin_interfaces//msg:Duration",
        "@geometry_msgs//msg:Pose",
        "@geometry_msgs//msg:Vector3",
    ],
)

ros_message(
    name = "FootstepArray",
    src = "FootstepArray.msg",
    deps = [
        ":Footstep",
        "@std_msgs//msg:Header",
    ],
)
