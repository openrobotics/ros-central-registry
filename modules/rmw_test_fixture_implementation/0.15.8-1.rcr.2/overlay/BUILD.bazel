load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
}

cc_library(
    name = "rmw_test_fixture_implementation_library",
    srcs = [
        "src/rmw_test_fixture_default/rmw_test_fixture_default.c",
        "src/rmw_test_fixture_default/rmw_test_fixture_default.h",
        "src/rmw_test_fixture_implementation.cpp",
    ],
    includes = ["src"],
    local_defines = ros_local_defines() + [
        "DEFAULT_RMW_IMPLEMENTATION=rmw_fastrtps_cpp",
        "RMW_TEST_FIXTURE_BUILDING_DLL",
    ],
    deps = DEPENDENCIES.values() + [
        "@rmw_test_fixture//:rmw_test_fixture_library",
    ],
)

cc_shared_library(
    name = "rmw_test_fixture_implementation",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rmw_test_fixture_implementation_library"],
    deps = [":rmw_test_fixture_implementation_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rmw_test_fixture_implementation"],
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "run_rmw_isolated",
    srcs = ["src/run_rmw_isolated.c"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        ":rmw_test_fixture_implementation_library",
        "@rmw_test_fixture//:rmw_test_fixture_library",
    ],
)

cc_library(
    name = "rmw_test_fixture_implementation_py_library",
    srcs = ["src/rmw_test_fixture_implementation_py.c"],
    deps = DEPENDENCIES.values() + [
        ":rmw_test_fixture_implementation_library",
        "@rmw_test_fixture//:rmw_test_fixture_library",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_shared_library(
    name = "rmw_test_fixture_implementation_py_ext",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":rmw_test_fixture_implementation",
    ],
    exports_filter = [":rmw_test_fixture_implementation_py_library"],
    shared_lib_name = "rmw_test_fixture_implementation/_rmw_test_fixture_implementation.so",
    user_link_flags = select({
        "@platforms//os:osx": [
            "-undefined",
            "dynamic_lookup",
        ],
        "//conditions:default": [],
    }),
    deps = [":rmw_test_fixture_implementation_py_library"],
)

py_library(
    name = "rmw_test_fixture_implementation_py",
    srcs = glob(["rmw_test_fixture_implementation/*.py"]),
    data = [":rmw_test_fixture_implementation_py_ext"],
    imports = ["."],
    deps = ["@rpyutils"],
)

### TESTING

cc_library(
    name = "rmw_mockmock_test_fixture_library",
    srcs = ["test/rmw_mockmock_test_fixture.c"],
    local_defines = ["RMW_TEST_FIXTURE_BUILDING_DLL"],
    deps = [
        "@rcutils//:rcutils_library",
        "@rmw//:rmw_library",
        "@rmw_test_fixture//:rmw_test_fixture_library",
    ],
)

cc_shared_library(
    name = "rmw_mockmock_test_fixture",
    dynamic_deps = [
        "@rcutils",
        "@rmw",
    ],
    exports_filter = [":rmw_mockmock_test_fixture_library"],
    deps = [":rmw_mockmock_test_fixture_library"],
)

collect_transitive_dynamic_deps(
    name = "test_transitive_dynamic_deps",
    dynamic_deps = [
        ":rmw_mockmock_test_fixture",
        ":rmw_test_fixture_implementation",
    ],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_fixture_start_stop",
    srcs = ["test/test_fixture_start_stop.cpp"],
    data = [":rmw_mockmock_test_fixture"],
    dynamic_deps = [":test_transitive_dynamic_deps"],
    env = {"RMW_IMPLEMENTATION": "rmw_mockmock"},
    linkopts = ["-Wl,--no-as-needed"],
    deps = DEPENDENCIES.values() + [
        ":rmw_mockmock_test_fixture_library",
        ":rmw_test_fixture_implementation_library",
        "@rmw_test_fixture//:rmw_test_fixture_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_library(
    name = "rmw_test_fixture_implementation_py_test_lib",
    srcs = ["src/rmw_test_fixture_implementation_py.c"],
    deps = DEPENDENCIES.values() + [
        ":rmw_mockmock_test_fixture_library",
        ":rmw_test_fixture_implementation_library",
        "@rmw_test_fixture//:rmw_test_fixture_library",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_shared_library(
    name = "rmw_test_fixture_implementation_py_test_ext",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":rmw_mockmock_test_fixture",
        ":rmw_test_fixture_implementation",
    ],
    exports_filter = [":rmw_test_fixture_implementation_py_test_lib"],
    shared_lib_name = "_rmw_test_fixture_implementation.so",
    user_link_flags = ["-Wl,--no-as-needed"] + select({
        "@platforms//os:osx": [
            "-undefined",
            "dynamic_lookup",
        ],
        "//conditions:default": [],
    }),
    deps = [":rmw_test_fixture_implementation_py_test_lib"],
)

py_pytest(
    name = "test_fixture_start_stop_py",
    srcs = ["test/test_fixture_start_stop.py"],
    data = [":rmw_test_fixture_implementation_py_test_ext"],
    env = {"RMW_IMPLEMENTATION": "rmw_mockmock"},
    deps = [":rmw_test_fixture_implementation_py"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_libraries = False,
    executables = [":run_rmw_isolated"],
    libraries = [":rmw_test_fixture_implementation"],
    package_xml = "package.xml",
    python = glob(["rmw_test_fixture_implementation/*.py"]) + [":rmw_test_fixture_implementation_py_ext"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_ros_core//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rmw_implementation//:ament_package",
        "@rmw_implementation_cmake//:ament_package",
        "@rmw_test_fixture//:ament_package",
        "@rosdistro//:ament_package",
        "@rpyutils//:ament_package",
    ],
)
