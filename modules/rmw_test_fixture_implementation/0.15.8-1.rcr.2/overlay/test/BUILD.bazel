load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
}

exports_files([
    "CMakeLists.txt",
    "rmw_mockmock_test_fixture.c",
    "test_fixture_start_stop.cpp",
    "test_fixture_start_stop.py",
])

cc_test(
    name = "test_fixture_start_stop",
    srcs = ["test_fixture_start_stop.cpp"],
    data = ["//:rmw_mockmock_test_fixture"],
    dynamic_deps = ["//:test_transitive_dynamic_deps"],
    env = {"RMW_IMPLEMENTATION": "rmw_mockmock"},
    linkopts = select({
        "@platforms//os:linux": ["-Wl,--no-as-needed"],
        "//conditions:default": [],
    }),
    deps = DEPENDENCIES.values() + [
        "//:rmw_mockmock_test_fixture_library",
        "//:rmw_test_fixture_implementation_library",
        "@rmw_test_fixture//:rmw_test_fixture_library",
        "@rosdistro//cc:googletest",
    ],
)

py_pytest(
    name = "test_fixture_start_stop_py",
    srcs = ["test_fixture_start_stop.py"],
    data = ["//:rmw_test_fixture_implementation_py_test_ext"],
    env = {"RMW_IMPLEMENTATION": "rmw_mockmock"},
    deps = ["//:rmw_test_fixture_implementation_py"],
)
