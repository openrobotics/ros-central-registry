load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

[py_pytest(
    name = name,
    srcs = srcs,
    data = [
        "__init__.py",
        "test_code_format.py",
        "unit/__init__.py",
        "unit/test_cli_utils/__init__.py",
        "unit/test_cli_utils/test_common.py",
        "unit/test_cli_utils/test_verb_pattern.py",
        "unit/test_process_utils/__init__.py",
        "unit/test_process_utils/fixtures/execute_process/stdout_stderr_ordering.py",
        "unit/test_process_utils/fixtures/impl_which/bin/bin_only.exe",
        "unit/test_process_utils/fixtures/impl_which/bin/exc1.exe",
        "unit/test_process_utils/fixtures/impl_which/bin/exc2.exe",
        "unit/test_process_utils/fixtures/impl_which/usr/bin/exc1.exe",
        "unit/test_process_utils/fixtures/impl_which/usr/bin/exc2.exe",
        "unit/test_process_utils/fixtures/impl_which/usr/local/bin/exc2",
        "unit/test_process_utils/impl_aep_asyncio.py",
        "unit/test_process_utils/impl_aep_protocol.py",
        "unit/test_process_utils/test_async_execute_process.py",
        "unit/test_process_utils/test_execute_process_nopty.py",
        "unit/test_process_utils/test_execute_process_pty.py",
        "unit/test_process_utils/test_impl.py",
        "unit/test_terminal_color/__init__.py",
        "unit/test_terminal_color/test_ansi_re.py",
        "unit/test_terminal_color/test_impl.py",
        "unit/test_terminal_utils.py",
    ],
    deps = ["//:osrf_pycommon"],
) for name, srcs in {
    "test_common": ["unit/test_cli_utils/test_common.py"],
    "test_verb_pattern": ["unit/test_cli_utils/test_verb_pattern.py"],
    "test_process_utils_async_execute_process": ["unit/test_process_utils/test_async_execute_process.py"],
    "test_process_utils_execute_process_nopty": ["unit/test_process_utils/test_execute_process_nopty.py"],
    "test_process_utils_execute_process_pty": ["unit/test_process_utils/test_execute_process_pty.py"],
    "test_process_utils_impl": ["unit/test_process_utils/test_impl.py"],
    "test_test_terminal_color_ansi_re": ["unit/test_terminal_color/test_ansi_re.py"],
    "test_test_terminal_color_impl": ["unit/test_terminal_color/test_impl.py"],
    "test_terminal_utils": ["unit/test_terminal_utils.py"],
}.items()]
