load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

ament_index(
    name = "ament_index",
    data = [
        "urdf/base_descr.urdf.xacro",
        "urdf/depthai_descr.urdf.xacro",
        "urdf/include/base_macro.urdf.xacro",
        "urdf/include/depthai_macro.urdf.xacro",
        "urdf/models/OAK-1.stl",
        "urdf/models/OAK-D.stl",
        "urdf/models/OAK-D-CM4-POE.stl",
        "urdf/models/OAK-D-IOT-75.stl",
        "urdf/models/OAK-D-LITE.stl",
        "urdf/models/OAK-D-LR.stl",
        "urdf/models/OAK-D-POE.stl",
        "urdf/models/OAK-D-PRO.stl",
        "urdf/models/OAK-D-PRO-W.stl",
        "urdf/models/OAK-D-S2.stl",
        "urdf/models/OAK-D-S2-POE.stl",
        "urdf/models/OAK-D-SR.stl",
        "urdf/models/OAK-D-SR-POE.stl",
        "urdf/models/OAK-T.stl",
        "urdf/models/OAK4-D.stl",
        "urdf/models/OAK4-S.stl",
    ] + ["//launch:launch_files"],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    env_hooks = [
        "env-hooks/depthai_descriptions.dsv.in",
        "env-hooks/depthai_descriptions.sh.in",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@xacro//:ament_package",
    ],
)
