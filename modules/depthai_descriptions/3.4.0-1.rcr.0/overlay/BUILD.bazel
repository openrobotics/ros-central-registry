load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

write_file(
    name = "_env_file_0",
    out = "_gen_env/share/depthai_descriptions/environment/depthai_descriptions.dsv",
    content = [
        "prepend-non-duplicate;GAZEBO_MODEL_PATH;share",
        "prepend-non-duplicate;GAZEBO_RESOURCE_PATH;share",
        "prepend-non-duplicate;IGN_GAZEBO_MODEL_PATH;share",
        "prepend-non-duplicate;IGN_GAZEBO_RESOURCE_PATH;share",
    ],
    is_executable = False,
)

write_file(
    name = "_env_file_1",
    out = "_gen_env/share/depthai_descriptions/environment/depthai_descriptions.sh",
    content = [
        "",
        "ament_prepend_unique_value GAZEBO_MODEL_PATH \"$AMENT_CURRENT_PREFIX\"",
        "ament_prepend_unique_value GAZEBO_RESOURCE_PATH \"$AMENT_CURRENT_PREFIX\"",
        "ament_prepend_unique_value IGN_GAZEBO_MODEL_PATH \"$AMENT_CURRENT_PREFIX\"",
        "ament_prepend_unique_value IGN_GAZEBO_RESOURCE_PATH \"$AMENT_CURRENT_PREFIX\"",
    ],
    is_executable = False,
)

pkg_files(
    name = "env_files_0",
    srcs = [
        ":_env_file_0",
        ":_env_file_1",
    ],
    prefix = "share/depthai_descriptions/environment",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    data = glob([
        "launch/*.py",
        "urdf/**",
    ]),
    env_hooks = [
        "env-hooks/depthai_descriptions.dsv.in",
        "env-hooks/depthai_descriptions.sh.in",
    ],
    install = [":env_files_0"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@xacro//:ament_package",
    ],
)
