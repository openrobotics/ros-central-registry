load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

ament_index(
    name = "ament_index",
    data = glob([
        "launch/*.py",
        "urdf/**",
    ]),
    package_xml = "package.xml",
)

launch_ros_binary(
    name = "urdf_launch.py",
    src = "launch/urdf_launch.py",
    data = [":ament_index"],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    data = glob([
        "launch/*.py",
        "urdf/**",
    ]),
    env_hooks = [
        "env-hooks/depthai_descriptions.dsv.in",
        "env-hooks/depthai_descriptions.sh.in",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@xacro//:ament_package",
    ],
)
