load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@dynamixel_workbench_toolbox//:dynamixel_workbench_toolbox": "@dynamixel_workbench_toolbox//:dynamixel_workbench_toolbox_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@hardware_interface//:hardware_interface_library",
    "@lifecycle_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:fmt",
]

cc_library(
    name = "dynamixel_hardware_library",
    srcs = ["src/dynamixel_hardware.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/dynamixel_hardware",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "dynamixel_hardware",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":dynamixel_hardware_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":dynamixel_hardware"],
    package_xml = "package.xml",
    plugin_category = "hardware_interface",
    plugins = ["dynamixel_hardware.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@dynamixel_workbench_toolbox//:ament_package",
        "@hardware_interface//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "hardware_interface",
        "pluginlib",
        "dynamixel_workbench_toolbox",
    ],
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [":dynamixel_hardware"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@dynamixel_workbench_toolbox//:ament_package",
        "@hardware_interface//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
    ],
)
