load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@mrpt_viz//:mrpt_viz": "@mrpt_viz//:mrpt_viz_library",
}

CC_DEPS = [
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
]

cc_library(
    name = "mrpt_kinematics_library",
    srcs = [
        "src/CKinematicChain.cpp",
        "src/CVehicleSimulVirtualBase.cpp",
        "src/CVehicleSimul_DiffDriven.cpp",
        "src/CVehicleSimul_Holo.cpp",
        "src/CVehicleVelCmd.cpp",
        "src/CVehicleVelCmd_DiffDriven.cpp",
        "src/CVehicleVelCmd_Holo.cpp",
        "src/registerAllClasses.cpp",
    ],
    hdrs = [
        "include/mrpt/kinematics.h",
        "include/mrpt/kinematics/CKinematicChain.h",
        "include/mrpt/kinematics/CVehicleSimulVirtualBase.h",
        "include/mrpt/kinematics/CVehicleSimul_DiffDriven.h",
        "include/mrpt/kinematics/CVehicleSimul_Holo.h",
        "include/mrpt/kinematics/CVehicleVelCmd.h",
        "include/mrpt/kinematics/CVehicleVelCmd_DiffDriven.h",
        "include/mrpt/kinematics/CVehicleVelCmd_Holo.h",
        "include/mrpt/kinematics/registerAllClasses.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_kinematics",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mrpt_kinematics_library"],
)

cc_library(
    name = "_bindings_library",
    srcs = ["python_bindings/mrpt_kinematics_py.cpp"],
    hdrs = [
        "include/mrpt/kinematics.h",
        "include/mrpt/kinematics/CKinematicChain.h",
        "include/mrpt/kinematics/CVehicleSimulVirtualBase.h",
        "include/mrpt/kinematics/CVehicleSimul_DiffDriven.h",
        "include/mrpt/kinematics/CVehicleSimul_Holo.h",
        "include/mrpt/kinematics/CVehicleVelCmd.h",
        "include/mrpt/kinematics/CVehicleVelCmd_DiffDriven.h",
        "include/mrpt/kinematics/CVehicleVelCmd_Holo.h",
        "include/mrpt/kinematics/registerAllClasses.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":mrpt_kinematics_library"],
)

cc_shared_library(
    name = "_bindings",
    dynamic_deps = DEPENDENCIES.keys() + [":mrpt_kinematics"],
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "mrpt/kinematics/_bindings.so",
    deps = [":_bindings_library"],
)

py_library(
    name = "mrpt",
    srcs = ["python/mrpt/kinematics/__init__.py"],
    imports = ["python"],
    deps = ["@mrpt_viz//:mrpt"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_kinematics",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_kinematics": [
            "libmrpt_kinematics.so.3.3",
            "libmrpt_kinematics.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_common//:ament_package",
        "@mrpt_viz//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    egg_info = False,
    headers = [
        "include/mrpt/kinematics.h",
        "include/mrpt/kinematics/CKinematicChain.h",
        "include/mrpt/kinematics/CVehicleSimulVirtualBase.h",
        "include/mrpt/kinematics/CVehicleSimul_DiffDriven.h",
        "include/mrpt/kinematics/CVehicleSimul_Holo.h",
        "include/mrpt/kinematics/CVehicleVelCmd.h",
        "include/mrpt/kinematics/CVehicleVelCmd_DiffDriven.h",
        "include/mrpt/kinematics/CVehicleVelCmd_Holo.h",
        "include/mrpt/kinematics/registerAllClasses.h",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mrpt_kinematics",
    ],
    package_xml = "package.xml",
    python = [
        ":mrpt",
        ":_bindings",
    ],
    python_strip_prefix = "python",
    sonames = {
        "mrpt_kinematics": [
            "libmrpt_kinematics.so.3.3",
            "libmrpt_kinematics.so.3.3.1",
        ],
    },
    deps = [":ament_index"] + [
        "@mrpt_common//:ament_package",
        "@mrpt_viz//:ament_package",
    ],
)
