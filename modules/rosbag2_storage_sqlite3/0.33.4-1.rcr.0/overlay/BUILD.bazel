load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

exports_files([
    "plugin_description.xml",
    "package.xml",
])

HEADERS = [
    "include/rosbag2_storage_sqlite3/sqlite_exception.hpp",
    "include/rosbag2_storage_sqlite3/sqlite_pragmas.hpp",
    "include/rosbag2_storage_sqlite3/sqlite_statement_wrapper.hpp",
    "include/rosbag2_storage_sqlite3/sqlite_storage.hpp",
    "include/rosbag2_storage_sqlite3/sqlite_wrapper.hpp",
    "include/rosbag2_storage_sqlite3/visibility_control.hpp",
]

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:sqlite3": "@rosdistro//cc:sqlite3_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

cc_library(
    name = "rosbag2_storage_sqlite3_library",
    srcs = [
        "src/rosbag2_storage_sqlite3/logging.hpp",
        "src/rosbag2_storage_sqlite3/sqlite_statement_wrapper.cpp",
        "src/rosbag2_storage_sqlite3/sqlite_storage.cpp",
        "src/rosbag2_storage_sqlite3/sqlite_wrapper.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["ROSBAG2_STORAGE_DEFAULT_PLUGINS_BUILDING_DLL"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rosbag2_storage_sqlite3",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rosbag2_storage_sqlite3_library"],
)

collect_transitive_dynamic_deps(
    name = "rosbag2_storage_sqlite3_with_all_deps",
    dynamic_deps = [":rosbag2_storage_sqlite3"],
)

ament_index(
    name = "ament_index",
    libraries = [":rosbag2_storage_sqlite3_with_all_deps"],
    package_xml = "package.xml",
    plugin_category = "rosbag2_storage",
    plugins = ["plugin_description.xml"],
    deps = ["@rosbag2_storage//:ament_index"],
)

ament_index(
    name = "ament_index_package",
    libraries = [":rosbag2_storage_sqlite3"],
    package_xml = "package.xml",
    plugin_category = "rosbag2_storage",
    plugins = ["plugin_description.xml"],
)

_EGG_INFO_DIR = "ros2bag_sqlite3_cli-0.33.4-py3.egg-info"

write_file(
    name = "ros2bag_sqlite3_cli_pkg_info",
    out = _EGG_INFO_DIR + "/PKG-INFO",
    content = [
        "Metadata-Version: 2.1",
        "Name: ros2bag_sqlite3_cli",
        "Version: 0.33.4",
    ],
)

write_file(
    name = "ros2bag_sqlite3_cli_sources",
    out = _EGG_INFO_DIR + "/SOURCES.txt",
    content = ["setup.cfg"],
)

write_file(
    name = "ros2bag_sqlite3_cli_dependency_links",
    out = _EGG_INFO_DIR + "/dependency_links.txt",
    content = [""],
)

write_file(
    name = "ros2bag_sqlite3_cli_entry_points",
    out = _EGG_INFO_DIR + "/entry_points.txt",
    content = [
        "[ros2bag.storage_plugin_cli_extension]",
        "sqlite3 = ros2bag_sqlite3_cli",
    ],
)

write_file(
    name = "ros2bag_sqlite3_cli_top_level",
    out = _EGG_INFO_DIR + "/top_level.txt",
    content = ["ros2bag_sqlite3_cli"],
)

_EGG_INFO_FILES = [
    ":ros2bag_sqlite3_cli_dependency_links",
    ":ros2bag_sqlite3_cli_entry_points",
    ":ros2bag_sqlite3_cli_pkg_info",
    ":ros2bag_sqlite3_cli_sources",
    ":ros2bag_sqlite3_cli_top_level",
]

py_library(
    name = "ros2bag_sqlite3_cli",
    srcs = ["ros2bag_sqlite3_cli/__init__.py"],
    data = _EGG_INFO_FILES,
    imports = ["."],
)

TEST_DEPENDENCIES = DEPENDENCIES | {
    ":rosbag2_storage_sqlite3": ":rosbag2_storage_sqlite3_library",
    "@rosbag2_test_common": "@rosbag2_test_common//:rosbag2_test_common_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_test",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
)

ament_package(
    name = "ament_package",
    cmake_export_targets = False,
    egg_info = False,
    headers = HEADERS,
    libraries = [":rosbag2_storage_sqlite3"],
    package_xml = "package.xml",
    python = [":ros2bag_sqlite3_cli"] + _EGG_INFO_FILES,
    deps = [
        ":ament_index_package",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@pluginlib//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_test_common//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
