load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "plugin_description.xml",
    "package.xml",
])

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@pluginlib": "@pluginlib//:pluginlib_library",
    "@rcutils": "@rcutils//:rcutils_library",
    "@rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosdistro//cc:sqlite3": "@rosdistro//cc:sqlite3_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

cc_library(
    name = "rosbag2_storage_sqlite3_library",
    srcs = glob([
        "src/**/*.cpp",
        "src/**/*.hpp",
    ]),
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + [
        "ROSBAG2_STORAGE_DEFAULT_PLUGINS_BUILDING_DLL",
    ],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rosbag2_storage_sqlite3",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rosbag2_storage_sqlite3_library"],
    deps = [":rosbag2_storage_sqlite3_library"],
)

### AMENT INDEX

collect_transitive_dynamic_deps(
    name = "rosbag2_storage_sqlite3_with_all_deps",
    dynamic_deps = [":rosbag2_storage_sqlite3"],
    visibility = ["//visibility:private"],
)

# Runtime index for tests: the plugin plus every library it links against,
# so pluginlib's dlopen() of the plugin resolves from lib/.
ament_index(
    name = "ament_index",
    libraries = [":rosbag2_storage_sqlite3_with_all_deps"],
    package_xml = "package.xml",
    plugin_category = "rosbag2_storage",
    plugins = ["plugin_description.xml"],
    deps = ["@rosbag2_storage//:ament_index"],
)

# Install-tree contribution: only this package's own plugin library, as
# `install(TARGETS rosbag2_storage_sqlite3 ...)` does upstream.
ament_index(
    name = "ament_index_package",
    libraries = [":rosbag2_storage_sqlite3"],
    package_xml = "package.xml",
    plugin_category = "rosbag2_storage",
    plugins = ["plugin_description.xml"],
    visibility = ["//visibility:private"],
)

### PYTHON MODULE

# ament_python_install_package(ros2bag_sqlite3_cli); setup.cfg registers the module as a
# `ros2bag.storage_plugin_cli_extension` entry point, which `ros2 bag` looks up
# through importlib.metadata, so render the egg-info next to the module.
_EGG_INFO_DIR = "ros2bag_sqlite3_cli-0.33.4-py3.egg-info"

write_file(
    name = "ros2bag_sqlite3_cli_pkg_info",
    out = _EGG_INFO_DIR + "/PKG-INFO",
    content = [
        "Metadata-Version: 2.1",
        "Name: ros2bag_sqlite3_cli",
        "Version: 0.33.4",
    ],
)

write_file(
    name = "ros2bag_sqlite3_cli_sources",
    out = _EGG_INFO_DIR + "/SOURCES.txt",
    content = ["setup.cfg"],
)

write_file(
    name = "ros2bag_sqlite3_cli_dependency_links",
    out = _EGG_INFO_DIR + "/dependency_links.txt",
    content = [""],
)

write_file(
    name = "ros2bag_sqlite3_cli_entry_points",
    out = _EGG_INFO_DIR + "/entry_points.txt",
    content = [
        "[ros2bag.storage_plugin_cli_extension]",
        "sqlite3 = ros2bag_sqlite3_cli",
    ],
)

write_file(
    name = "ros2bag_sqlite3_cli_top_level",
    out = _EGG_INFO_DIR + "/top_level.txt",
    content = ["ros2bag_sqlite3_cli"],
)

_EGG_INFO_FILES = [
    ":ros2bag_sqlite3_cli_dependency_links",
    ":ros2bag_sqlite3_cli_entry_points",
    ":ros2bag_sqlite3_cli_pkg_info",
    ":ros2bag_sqlite3_cli_sources",
    ":ros2bag_sqlite3_cli_top_level",
]

py_library(
    name = "ros2bag_sqlite3_cli",
    srcs = glob(["ros2bag_sqlite3_cli/**/*.py"]),
    data = _EGG_INFO_FILES,
    imports = ["."],
)

### TESTS

TEST_DEPENDENCIES = DEPENDENCIES | {
    ":rosbag2_storage_sqlite3": ":rosbag2_storage_sqlite3_library",
    "@rosbag2_test_common": "@rosbag2_test_common//:rosbag2_test_common_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_test",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

[
    cc_test(
        name = test,
        srcs = [
            "test/rosbag2_storage_sqlite3/storage_test_fixture.hpp",
            "test/rosbag2_storage_sqlite3/{0}.cpp".format(test),
        ],
        data = [":ament_index"],
        dynamic_deps = [":transitive_dynamic_deps_test"],
        local_defines = ros_local_defines() + [
            '_TEST_RESOURCES_DIR_PATH=\\"test/rosbag2_storage_sqlite3\\"',
        ],
        deps = TEST_DEPENDENCIES.values() + [
            "@rosdistro//cc:googletest",
            "@std_msgs//:cc",
        ],
    )
    for test in [
        "test_sqlite_storage",
        "test_sqlite_topic_filter",
        "test_sqlite_wrapper",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_targets = False,
    egg_info = False,
    headers = HEADERS,
    libraries = [":rosbag2_storage_sqlite3"],
    package_xml = "package.xml",
    python = [":ros2bag_sqlite3_cli"] + _EGG_INFO_FILES,
    deps = [
        ":ament_index_package",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@pluginlib//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_test_common//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
