load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@pluginlib": "@pluginlib//:pluginlib_library",
    "@rcutils": "@rcutils//:rcutils_library",
    "@rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosdistro//cc:sqlite3": "@rosdistro//cc:sqlite3_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

TEST_DEPENDENCIES = DEPENDENCIES | {
    "//:rosbag2_storage_sqlite3": "//:rosbag2_storage_sqlite3_library",
    "@rosbag2_test_common": "@rosbag2_test_common//:rosbag2_test_common_library",
}

[cc_test(
    name = test.removesuffix(".py"),
    srcs = [
        "rosbag2_storage_sqlite3/storage_test_fixture.hpp",
        "rosbag2_storage_sqlite3/{0}.cpp".format(test),
    ],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps_test"],
    local_defines = ros_local_defines() + ['_TEST_RESOURCES_DIR_PATH=\\"test/rosbag2_storage_sqlite3\\"'],
    deps = TEST_DEPENDENCIES.values() + [
        "@rosdistro//cc:googletest",
    ],
) for test in [
    "test_sqlite_storage",
    "test_sqlite_topic_filter",
    "test_sqlite_wrapper",
]]
