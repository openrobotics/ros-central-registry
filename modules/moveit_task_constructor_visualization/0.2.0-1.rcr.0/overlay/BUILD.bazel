# CMAKE_AUTOMOC: run moc over every header declaring Q_OBJECT. Sources that
# `#include "moc_<name>.cpp"` themselves get the output as a textual header
# (found via the "_gen/moc" include dir); the rest are compiled directly.
MOC_HEADERS = {
    "flat_merge_proxy_model": "motion_planning_tasks/utils/flat_merge_proxy_model.h",
    "job_queue": "motion_planning_tasks/src/job_queue.h",
    "local_task_model": "motion_planning_tasks/src/local_task_model.h",
    "marker_visualization": "visualization_tools/include/moveit/visualization_tools/marker_visualization.h",
    "meta_task_list_model": "motion_planning_tasks/src/meta_task_list_model.h",
    "remote_task_model": "motion_planning_tasks/src/remote_task_model.h",
    "task_display": "motion_planning_tasks/src/task_display.h",
    "task_list_model": "motion_planning_tasks/src/task_list_model.h",
    "task_panel": "motion_planning_tasks/src/task_panel.h",
    "task_solution_panel": "visualization_tools/include/moveit/visualization_tools/task_solution_panel.h",
    "task_solution_visualization": "visualization_tools/include/moveit/visualization_tools/task_solution_visualization.h",
    "tree_merge_proxy_model": "motion_planning_tasks/utils/tree_merge_proxy_model.h",
}

[
    genrule(
        name = "moc_" + name,
        srcs = [hdr],
        outs = ["_gen/moc/moc_" + name + ".cpp"],
        cmd = "$(execpath @qtbase//:moc) $< -o $@",
        tools = ["@qtbase//:moc"],
    )
    for name, hdr in MOC_HEADERS.items()
]

