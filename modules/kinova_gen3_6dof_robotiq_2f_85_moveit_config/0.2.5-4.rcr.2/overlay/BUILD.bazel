load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

ament_index(
    name = "ament_index",
    data = [
        ".setup_assistant",
        "//launch:launch_files",
    ] + [
        "config/gen3.srdf",
        "config/initial_positions.yaml",
        "config/joint_limits.yaml",
        "config/kinematics.yaml",
        "config/moveit.rviz",
        "config/moveit_controllers.yaml",
        "config/ompl_planning.yaml",
        "config/pilz_cartesian_limits.yaml",
        "config/ros2_controllers.yaml",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_index_python//:ament_package",
        "@controller_manager//:ament_package",
        "@joint_state_publisher//:ament_package",
        "@joint_state_publisher_gui//:ament_package",
        "@joint_trajectory_controller//:ament_package",
        "@kortex_description//:ament_package",
        "@launch_ros//:ament_package",
        "@moveit_configs_utils//:ament_package",
        "@moveit_kinematics//:ament_package",
        "@moveit_planners//:ament_package",
        "@moveit_ros_move_group//:ament_package",
        "@moveit_ros_visualization//:ament_package",
        "@moveit_ros_warehouse//:ament_package",
        "@moveit_setup_assistant//:ament_package",
        "@moveit_simple_controller_manager//:ament_package",
        "@picknik_reset_fault_controller//:ament_package",
        "@picknik_twist_controller//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_default_plugins//:ament_package",
        "@tf2_ros//:ament_package",
        "@xacro//:ament_package",
    ],
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_index_python//:ament_package",
        "@controller_manager//:ament_package",
        "@joint_state_publisher//:ament_package",
        "@joint_state_publisher_gui//:ament_package",
        "@joint_trajectory_controller//:ament_package",
        "@kortex_description//:ament_package",
        "@launch_ros//:ament_package",
        "@moveit_configs_utils//:ament_package",
        "@moveit_kinematics//:ament_package",
        "@moveit_planners//:ament_package",
        "@moveit_ros_move_group//:ament_package",
        "@moveit_ros_visualization//:ament_package",
        "@moveit_ros_warehouse//:ament_package",
        "@moveit_setup_assistant//:ament_package",
        "@moveit_simple_controller_manager//:ament_package",
        "@picknik_reset_fault_controller//:ament_package",
        "@picknik_twist_controller//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_default_plugins//:ament_package",
        "@tf2_ros//:ament_package",
        "@xacro//:ament_package",
    ],
)
