cc_test(
    name = "test_canopen_driver",
    srcs = ["test_canopen_driver.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "CMakeLists.txt",
        "bus_configs/bad_driver_duplicate.yml",
        "bus_configs/bad_driver_no_driver.yml",
        "bus_configs/bad_driver_no_id.yml",
        "bus_configs/bad_driver_no_package.yml",
        "bus_configs/bad_master_no_driver.yml",
        "bus_configs/bad_master_no_id.yml",
        "bus_configs/bad_master_no_package.yml",
        "bus_configs/bad_no_master.yml",
        "bus_configs/good_driver.yml",
        "bus_configs/good_master.yml",
        "bus_configs/good_master_and_two_driver.yml",
        "master.dcf",
        "simple.eds",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["GTEST_HAS_PTHREAD=1"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:node_canopen_driver_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

