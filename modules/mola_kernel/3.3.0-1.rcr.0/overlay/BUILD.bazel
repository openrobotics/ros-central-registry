load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@mola_yaml//:mola_yaml_library",
    "@mrpt_maps//:mrpt_maps_library",
    "@mrpt_obs//:mrpt_obs_library",
    "@mrpt_topography//:mrpt_topography_library",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "mola_kernel_library",
    srcs = [":gen_mola_kernel_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_tbb_blocked_range2d_h",
        ":gen_tbb_blocked_range_h",
        ":gen_tbb_global_control_h",
        ":gen_tbb_parallel_for_each_h",
        ":gen_tbb_parallel_for_h",
        ":gen_tbb_parallel_reduce_h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/mola_kernel",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=3",
        "MOLA_PATCH_VERSION=0",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_kernel",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mola_kernel_library"],
)

write_file(
    name = "gen_mola_kernel_stub_cpp",
    out = "_gen/mola_kernel_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

write_file(
    name = "gen_tbb_blocked_range_h",
    out = "_gen/include/tbb/blocked_range.h",
    content = ["#ifndef RCR_TBB_BLOCKED_RANGE_H_\n#define RCR_TBB_BLOCKED_RANGE_H_\n#include <cstddef>\nnamespace tbb {\nstruct split {};\ntemplate <typename Value>\nclass blocked_range {\n public:\n  blocked_range(Value begin, Value end, std::size_t grainsize = 1)\n      : begin_(begin), end_(end), grainsize_(grainsize) {}\n  blocked_range(blocked_range & r, split)\n      : begin_(r.begin_), end_(r.end_), grainsize_(r.grainsize_) {}\n  Value begin() const { return begin_; }\n  Value end() const { return end_; }\n  std::size_t size() const { return static_cast<std::size_t>(end_ - begin_); }\n  std::size_t grainsize() const { return grainsize_; }\n  bool empty() const { return !(begin_ < end_); }\n private:\n  Value begin_, end_;\n  std::size_t grainsize_;\n};\n}  // namespace tbb\n#endif\n"],
)

write_file(
    name = "gen_tbb_parallel_for_h",
    out = "_gen/include/tbb/parallel_for.h",
    content = ["#ifndef RCR_TBB_PARALLEL_FOR_H_\n#define RCR_TBB_PARALLEL_FOR_H_\n#include \"tbb/blocked_range.h\"\nnamespace tbb {\ntemplate <typename Range, typename Body>\ninline void parallel_for(const Range & range, const Body & body) {\n  body(range);\n}\ntemplate <typename Index, typename Func>\ninline void parallel_for(Index first, Index last, const Func & f) {\n  for (Index i = first; i < last; ++i) f(i);\n}\n}  // namespace tbb\n#endif\n"],
)

write_file(
    name = "gen_tbb_parallel_for_each_h",
    out = "_gen/include/tbb/parallel_for_each.h",
    content = ["#ifndef RCR_TBB_PARALLEL_FOR_EACH_H_\n#define RCR_TBB_PARALLEL_FOR_EACH_H_\nnamespace tbb {\ntemplate <typename Iterator, typename Body>\ninline void parallel_for_each(Iterator first, Iterator last, const Body & body) {\n  for (; first != last; ++first) body(*first);\n}\ntemplate <typename Container, typename Body>\ninline void parallel_for_each(Container & c, const Body & body) {\n  for (auto & item : c) body(item);\n}\ntemplate <typename Container, typename Body>\ninline void parallel_for_each(const Container & c, const Body & body) {\n  for (const auto & item : c) body(item);\n}\n}  // namespace tbb\n#endif\n"],
)

write_file(
    name = "gen_tbb_blocked_range2d_h",
    out = "_gen/include/tbb/blocked_range2d.h",
    content = ["#pragma once\n#include \"tbb/blocked_range.h\"\nnamespace tbb {\ntemplate <typename RowValue, typename ColValue = RowValue>\nclass blocked_range2d {\npublic:\n  using row_range_type = blocked_range<RowValue>;\n  using col_range_type = blocked_range<ColValue>;\n  blocked_range2d(RowValue rbegin, RowValue rend, std::size_t rgrain, ColValue cbegin, ColValue cend, std::size_t cgrain = 1)\n    : rows_(rbegin, rend, rgrain), cols_(cbegin, cend, cgrain) {}\n  blocked_range2d(RowValue rbegin, RowValue rend, ColValue cbegin, ColValue cend)\n    : rows_(rbegin, rend), cols_(cbegin, cend) {}\n  blocked_range2d(blocked_range2d & r, split) : rows_(r.rows_, split()), cols_(r.cols_, split()) {}\n  const row_range_type & rows() const { return rows_; }\n  const col_range_type & cols() const { return cols_; }\nprivate:\n  row_range_type rows_;\n  col_range_type cols_;\n};\n}  // namespace tbb\n"],
)

write_file(
    name = "gen_tbb_parallel_reduce_h",
    out = "_gen/include/tbb/parallel_reduce.h",
    content = ["#pragma once\n#include \"tbb/blocked_range.h\"\nnamespace tbb {\ntemplate <typename Range, typename Body>\nvoid parallel_reduce(const Range & range, Body & body) { body(range); }\ntemplate <typename Range, typename Value, typename RealBody, typename Reduction>\nValue parallel_reduce(const Range & range, const Value & identity, const RealBody & real_body, const Reduction &) {\n  return real_body(range, identity);\n}\n}  // namespace tbb\n"],
)

write_file(
    name = "gen_tbb_global_control_h",
    out = "_gen/include/tbb/global_control.h",
    content = ["#pragma once\n#include <cstddef>\nnamespace tbb {\nclass global_control {\npublic:\n  enum parameter { max_allowed_parallelism, thread_stack_size };\n  global_control(parameter, std::size_t) {}\n  static std::size_t active_value(parameter) { return 1; }\n};\n}  // namespace tbb\n"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mola_kernel",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_kernel": [
            "libmola_kernel.so.3.3",
            "libmola_kernel.so.3.3.0",
        ],
    },
    deps = [
        "@mola_common//:ament_package",
        "@mola_yaml//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_obs//:ament_package",
        "@mrpt_topography//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mola_kernel",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_kernel": [
            "libmola_kernel.so.3.3",
            "libmola_kernel.so.3.3.0",
        ],
    },
    deps = [":ament_index"] + [
        "@mola_common//:ament_package",
        "@mola_yaml//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_obs//:ament_package",
        "@mrpt_topography//:ament_package",
    ],
)
