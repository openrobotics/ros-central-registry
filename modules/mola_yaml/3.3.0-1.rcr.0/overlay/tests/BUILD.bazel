load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {}

CC_DEPS = [
    "@mrpt_containers//:mrpt_containers_library",
    "@mrpt_system//:mrpt_system_library",
]

cc_test(
    name = "run_test-mola_yaml-parser",
    srcs = ["test-yaml-parser.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = ["//:ament_index"] + [
        "CMakeLists.txt",
        "d1/d2/test4.yaml",
        "d1/test3.yaml",
        "d1/test3b.yaml",
        "test1.yaml",
        "test2.yaml",
        "test_define_base.yaml",
        "test_define_chain_middle.yaml",
        "test_define_nested.yaml",
        "test_import_base.yaml",
        "test_import_novars.yaml",
        "test_import_o2.yaml",
        "test_import_top.yaml",
        "test_include1.yaml",
        "test_include2.yaml",
        "test_include3.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines() + ['MOLA_MODULE_SOURCE_DIR=\\"../mola_yaml+/tests\\"'],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:mola_yaml_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
