load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@mrpt_containers//:mrpt_containers": "@mrpt_containers//:mrpt_containers_library",
    "@mrpt_containers//:mrpt_core": "@mrpt_containers//:mrpt_core_library",
    "@mrpt_system//:mrpt_system": "@mrpt_system//:mrpt_system_library",
}

CC_DEPS = [
]

cc_library(
    name = "mola_yaml_library",
    srcs = ["src/yaml_helpers.cpp"],
    hdrs = [
        "include/mola_yaml/macro_helpers.h",
        "include/mola_yaml/yaml_helpers.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/mola_yaml",
        "src",
    ],
    local_defines = ros_local_defines() + ["STD_FS_IS_EXPERIMENTAL=0"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_yaml",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mola_yaml_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":mola_yaml"],
)

ament_index(
    name = "ament_index",
    libraries = [":mola_yaml"],
    package_xml = "package.xml",
    sonames = {"mola_yaml": [
        "libmola_yaml.so.3.3",
        "libmola_yaml.so.3.3.0",
    ]},
    deps = [
        "@mola_common//:ament_package",
        "@mrpt_containers//:ament_package",
        "@mrpt_system//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/mola_yaml/macro_helpers.h",
        "include/mola_yaml/yaml_helpers.h",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [":mola_yaml"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@mola_common//:ament_package",
        "@mrpt_containers//:ament_package",
        "@mrpt_system//:ament_package",
    ],
)
