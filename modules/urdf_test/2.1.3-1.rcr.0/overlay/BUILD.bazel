load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

py_library(
    name = "urdf_test",
    srcs = glob(["urdf_test/**/*.py"]),
    imports = ["."],
    deps = [
        "@launch",
        "@rclpy",
        "@xacro",
    ],
)

ament_index(
    name = "ament_index",
    executables = ["scripts/test_urdf.py"],
    package_xml = "package.xml",
)

py_pytest(
    name = "test_xacro_test",
    srcs = ["tests/test_xacro_test.py"],
    data = [
        ":ament_index",
        "@urdfdom//:check_urdf",
    ],
    deps = [
        ":urdf_test",
        "@launch",
        "@xacro",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    executables = ["scripts/test_urdf.py"],
    package_xml = "package.xml",
    python = [":urdf_test"],
    deps = [
        ":ament_index",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@launch//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@urdfdom//:ament_package",
        "@xacro//:ament_package",
    ],
)
