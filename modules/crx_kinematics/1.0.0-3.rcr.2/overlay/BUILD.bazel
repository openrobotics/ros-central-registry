load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

DEPENDENCIES = {
    "@moveit_core//:moveit_exceptions": "@moveit_core//:moveit_exceptions_library",
    "@moveit_core//:moveit_kinematics_base": "@moveit_core//:moveit_kinematics_base_library",
    "@moveit_core//:moveit_robot_model": "@moveit_core//:moveit_robot_model_library",
    "@moveit_core//:moveit_robot_state": "@moveit_core//:moveit_robot_state_library",
    "@moveit_core//:moveit_test_utils": "@moveit_core//:moveit_test_utils_library",
    "@moveit_core//:moveit_transforms": "@moveit_core//:moveit_transforms_library",
    "@moveit_core//:moveit_utils": "@moveit_core//:moveit_utils_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rosdistro//cc:boost.chrono_shared": "@rosdistro//cc:boost.chrono",
    "@rosdistro//cc:boost.container_shared": "@rosdistro//cc:boost.container",
    "@rosdistro//cc:boost.filesystem_shared": "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.iostreams_shared": "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:boost.thread_shared": "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:bullet-BulletCollision": "@rosdistro//cc:bullet-BulletCollision_library",
    "@rosdistro//cc:bullet-LinearMath": "@rosdistro//cc:bullet-LinearMath_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:curl": "@rosdistro//cc:curl_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
}

CC_DEPS = [
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
]

cc_library(
    name = "robot_library",
    srcs = ["src/robot.cpp"],
    hdrs = [
        "include/crx_kinematics/crx_kinematics_plugin.hpp",
        "include/crx_kinematics/robot.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/crx_kinematics",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_library(
    name = "crx_kinematics_plugin_library",
    srcs = ["src/crx_kinematics_plugin.cpp"],
    hdrs = [
        "include/crx_kinematics/crx_kinematics_plugin.hpp",
        "include/crx_kinematics/robot.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/crx_kinematics",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":robot_library"],
)

cc_shared_library(
    name = "crx_kinematics_plugin",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":crx_kinematics_plugin_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":crx_kinematics_plugin"],
)

ament_index(
    name = "ament_index",
    libraries = [":crx_kinematics_plugin"],
    package_xml = "package.xml",
    plugin_category = "moveit_core",
    plugins = ["crx_kinematics_plugin_description.xml"],
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@moveit_core//:ament_package",
        "@pluginlib//:ament_package",
        "@tf2_eigen//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "moveit_core",
        "pluginlibv3",
        "rclcpp",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_crx_kinematics",
    headers = [
        "include/crx_kinematics/crx_kinematics_plugin.hpp",
        "include/crx_kinematics/robot.hpp",
    ],
    libraries = [":crx_kinematics_plugin"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@moveit_core//:ament_package",
        "@pluginlib//:ament_package",
        "@tf2_eigen//:ament_package",
    ],
)
