load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@moveit_core//:moveit_exceptions": "@moveit_core//:moveit_exceptions_library",
    "@moveit_core//:moveit_kinematics_base": "@moveit_core//:moveit_kinematics_base_library",
    "@moveit_core//:moveit_robot_model": "@moveit_core//:moveit_robot_model_library",
    "@moveit_core//:moveit_robot_state": "@moveit_core//:moveit_robot_state_library",
    "@moveit_core//:moveit_test_utils": "@moveit_core//:moveit_test_utils_library",
    "@moveit_core//:moveit_transforms": "@moveit_core//:moveit_transforms_library",
    "@moveit_core//:moveit_utils": "@moveit_core//:moveit_utils_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
}

CC_DEPS = [
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
]

cc_test(
    name = "test_crx_kinematics_plugin",
    srcs = ["test_crx_kinematics_plugin.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
        "-ffile-prefix-map=external/crx_kinematics+/=../crx_kinematics+/",
    ],
    data = ["//:ament_index"] + [
        "crx10ia.srdf",
        "crx10ia.urdf",
        "crx10ia_l_paolofrance.srdf",
        "crx10ia_l_paolofrance.urdf",
        "crx30ia.srdf",
        "crx30ia.urdf",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:crx_kinematics_plugin_library",
        "//:robot_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_fk_ik",
    srcs = ["test_fk_ik.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "crx10ia.srdf",
        "crx10ia.urdf",
        "crx10ia_l_paolofrance.srdf",
        "crx10ia_l_paolofrance.urdf",
        "crx30ia.srdf",
        "crx30ia.urdf",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:crx_kinematics_plugin_library",
        "//:robot_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
