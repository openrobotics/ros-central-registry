load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@mrpt_containers//:mrpt_containers_library",
    "@mrpt_obs//:mrpt_obs_library",
    "@mrpt_poses//:mrpt_poses_library",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "mola_imu_preintegration_library",
    srcs = [
        "src/ImuInitialCalibrator.cpp",
        "src/ImuIntegrationParams.cpp",
        "src/ImuIntegrator.cpp",
        "src/ImuPreintegrator.cpp",
        "src/ImuTransformer.cpp",
        "src/LocalVelocityBuffer.cpp",
        "src/MapGravityEstimator.cpp",
        "src/register.cpp",
        "src/so3_jacobians.cpp",
        "src/trajectory_from_buffer.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/mola_imu_preintegration",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_imu_preintegration",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":mola_imu_preintegration_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mola_imu_preintegration",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_imu_preintegration": [
            "libmola_imu_preintegration.so.3.0",
            "libmola_imu_preintegration.so.3.0.0",
        ],
    },
    deps = [
        "@mola_common//:ament_package",
        "@mrpt_containers//:ament_package",
        "@mrpt_obs//:ament_package",
        "@mrpt_poses//:ament_package",
    ],
)

cc_test(
    name = "run_test-imu-initial-calibrator",
    srcs = ["tests/test-imu-initial-calibrator.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        ":ament_index",
    ] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/mola_imu_preintegration",
        "src",
    ],
    local_defines = ros_local_defines() + ["MOLA_MODULE_SOURCE_DIR=\\\"tests\\\""],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":mola_imu_preintegration_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

