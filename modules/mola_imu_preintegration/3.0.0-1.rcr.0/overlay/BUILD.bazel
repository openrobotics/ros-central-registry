load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
)

DEPENDENCIES = {
    "@mrpt_containers//:mrpt_containers": "@mrpt_containers//:mrpt_containers_library",
    "@mrpt_obs//:mrpt_obs": "@mrpt_obs//:mrpt_obs_library",
    "@mrpt_poses//:mrpt_poses": "@mrpt_poses//:mrpt_poses_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "mola_imu_preintegration_library",
    srcs = [
        "src/ImuInitialCalibrator.cpp",
        "src/ImuIntegrationParams.cpp",
        "src/ImuIntegrator.cpp",
        "src/ImuPreintegrator.cpp",
        "src/ImuTransformer.cpp",
        "src/LocalVelocityBuffer.cpp",
        "src/MapGravityEstimator.cpp",
        "src/register.cpp",
        "src/so3_jacobians.cpp",
        "src/trajectory_from_buffer.cpp",
    ],
    hdrs = [
        "include/mola_imu_preintegration/ImuInitialCalibrator.h",
        "include/mola_imu_preintegration/ImuIntegrationParams.h",
        "include/mola_imu_preintegration/ImuIntegrator.h",
        "include/mola_imu_preintegration/ImuPreintegrator.h",
        "include/mola_imu_preintegration/ImuTransformer.h",
        "include/mola_imu_preintegration/LocalVelocityBuffer.h",
        "include/mola_imu_preintegration/MapGravityEstimator.h",
        "include/mola_imu_preintegration/so3_jacobians.h",
        "include/mola_imu_preintegration/trajectory_from_buffer.h",
        "include/mola_imu_preintegration/types.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/mola_imu_preintegration",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_imu_preintegration",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mola_imu_preintegration_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":mola_imu_preintegration"],
)

ament_index(
    name = "ament_index",
    libraries = [":mola_imu_preintegration"],
    package_xml = "package.xml",
    sonames = {"mola_imu_preintegration": [
        "libmola_imu_preintegration.so.3.0",
        "libmola_imu_preintegration.so.3.0.0",
    ]},
    deps = [
        "@mola_common//:ament_package",
        "@mrpt_containers//:ament_package",
        "@mrpt_obs//:ament_package",
        "@mrpt_poses//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/mola_imu_preintegration/ImuInitialCalibrator.h",
        "include/mola_imu_preintegration/ImuIntegrationParams.h",
        "include/mola_imu_preintegration/ImuIntegrator.h",
        "include/mola_imu_preintegration/ImuPreintegrator.h",
        "include/mola_imu_preintegration/ImuTransformer.h",
        "include/mola_imu_preintegration/LocalVelocityBuffer.h",
        "include/mola_imu_preintegration/MapGravityEstimator.h",
        "include/mola_imu_preintegration/so3_jacobians.h",
        "include/mola_imu_preintegration/trajectory_from_buffer.h",
        "include/mola_imu_preintegration/types.h",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [":mola_imu_preintegration"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@mola_common//:ament_package",
        "@mrpt_containers//:ament_package",
        "@mrpt_obs//:ament_package",
        "@mrpt_poses//:ament_package",
    ],
)
