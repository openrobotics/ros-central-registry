load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

filegroup(
    name = "package_xml",
    srcs = ["package.xml"],
)

filegroup(
    name = "headers",
    srcs = glob([
        "include/vision_msgs_layers/*.h",
        "include/vision_msgs_layers/*.hpp",
    ]),
)

filegroup(
    name = "share_files",
    srcs = ["plugins.xml"],
)

cc_library(
    name = "bounding_box_2d_library",
    srcs = ["src/bounding_box_2d.cpp"],
    hdrs = [":headers"],
    includes = ["include"],
    deps = [
        "@rqt_image_overlay_layer",
        "@vision_msgs//:cc",
    ],
)

cc_shared_library(
    name = "bounding_box_2d",
    shared_lib_name = "libbounding_box_2d.so",
    deps = [":bounding_box_2d_library"],
)

ament_index(
    name = "ament_index",
    data = [":share_files"],
    libraries = [":bounding_box_2d"],
    package_xml = ":package_xml",
    plugin_category = "rqt_image_overlay_layer",
    plugins = ["plugins.xml"],
)

ament_package(
    cmake_export_name = "export_vision_msgs_layers",
    data = [":share_files"],
    headers = [":headers"],
    include_prefix = "",
    libraries = [":bounding_box_2d"],
    package_xml = ":package_xml",
    plugin_category = "rqt_image_overlay_layer",
    plugins = ["plugins.xml"],
    deps = [
        "@rqt_image_overlay_layer//:ament_package",
        "@vision_msgs//:ament_package",
    ],
)
