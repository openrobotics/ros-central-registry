load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "http_server",
    srcs = [":gen_system_webview_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

write_file(
    name = "gen_system_webview_stub_cpp",
    out = "_gen/system_webview_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    data = [
        "launch/main.launch.py",
        "web/index.html",
        "web/out/404.html",
        "web/out/_next/static/1_i3QoKOIUELFOi1_-ij6/_buildManifest.js",
        "web/out/_next/static/1_i3QoKOIUELFOi1_-ij6/_ssgManifest.js",
        "web/out/_next/static/chunks/255-54d3085ce94738a4.js",
        "web/out/_next/static/chunks/304-9855fa5866af6bdf.js",
        "web/out/_next/static/chunks/4bd1b696-c023c6e3521b1417.js",
        "web/out/_next/static/chunks/app/_not-found/page-81421ed710c536ad.js",
        "web/out/_next/static/chunks/app/layout-3bc230b1a2925b77.js",
        "web/out/_next/static/chunks/app/page-7c2a2dff52c5c2ad.js",
        "web/out/_next/static/chunks/framework-de98b93a850cfc71.js",
        "web/out/_next/static/chunks/main-49fd204fc9037ea3.js",
        "web/out/_next/static/chunks/main-app-2d7119504300156a.js",
        "web/out/_next/static/chunks/pages/_app-7d307437aca18ad4.js",
        "web/out/_next/static/chunks/pages/_error-cb2a52f75f2162e2.js",
        "web/out/_next/static/chunks/polyfills-42372ed130431b0a.js",
        "web/out/_next/static/chunks/webpack-3844d017889aa547.js",
        "web/out/_next/static/css/170d205a92d1c0fe.css",
        "web/out/index.txt",
    ],
    data_strip_prefixes = [
        "web/out->web",
    ],
    lib_data = [
        ":http_server",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rosbridge_server//:ament_package",
    ],
)

launch_ros_binary(
    name = "main.launch.py",
    src = "launch/main.launch.py",
    data = [":ament_index"],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rosbridge_server//:ament_package",
    ],
)
