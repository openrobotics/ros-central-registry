load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

cc_library(
    name = "tuw_geometry_library",
    srcs = [
        "src/tuw_geometry/command2d.cpp",
        "src/tuw_geometry/figure.cpp",
        "src/tuw_geometry/layered_figure.cpp",
        "src/tuw_geometry/layered_maps.cpp",
        "src/tuw_geometry/line2d.cpp",
        "src/tuw_geometry/linesegment2d.cpp",
        "src/tuw_geometry/linesegment2d_detector.cpp",
        "src/tuw_geometry/map_handler.cpp",
        "src/tuw_geometry/plane3d.cpp",
        "src/tuw_geometry/point2d.cpp",
        "src/tuw_geometry/polar2d.cpp",
        "src/tuw_geometry/pose2d.cpp",
        "src/tuw_geometry/tuw_geometry.cpp",
        "src/tuw_geometry/utils.cpp",
        "src/tuw_geometry/world_scoped_maps.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        ".",
        "include",
        "include/tuw_geometry",
        "src",
    ],
    local_defines = ros_local_defines() + ["TUW_GEOMETRY_BUILDING_LIBRARY"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "tuw_geometry",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":tuw_geometry_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":tuw_geometry"],
)

cc_binary(
    name = "example_figure",
    srcs = ["src/examples/main_example_figure.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/tuw_geometry",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":tuw_geometry_library"],
)

cc_binary(
    name = "_bin/test_geometry",
    srcs = ["test/test_geometry.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/tuw_geometry",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":tuw_geometry_library",
        "@rosdistro//cc:googletest",
    ],
)

ament_index(
    name = "ament_index",
    lib_data = [
        ":example_figure",
        ":_bin/test_geometry",
    ],
    libraries = [":tuw_geometry"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@gtest_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

cc_test(
    name = "test_geometry",
    srcs = ["test/test_geometry.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/tuw_geometry",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":tuw_geometry_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "rclcpp_components",
        "sensor_msgs",
        "std_msgs",
        "OpenCV",
    ],
    cmake_export_name = "export_tuw_geometry",
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [":tuw_geometry"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@gtest_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
