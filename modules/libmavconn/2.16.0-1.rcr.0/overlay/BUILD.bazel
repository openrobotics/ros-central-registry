load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
)

DEPENDENCIES = {
    "@rosdistro//cc:asio": "@rosdistro//cc:asio_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
}

CC_DEPS = [
]

cc_library(
    name = "mavconn_library",
    srcs = [":gen_libmavconn_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_extra_3",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mavconn",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["@@//:__subpackages__"],
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":mavconn_library"],
)

cc_library(
    name = "mavconn_e2e_shim_library",
    srcs = [":gen_libmavconn_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_extra_3",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":mavconn_library"],
)

cc_shared_library(
    name = "mavconn_e2e_shim",
    dynamic_deps = DEPENDENCIES.keys() + [":mavconn"],
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":mavconn_e2e_shim_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":mavconn"],
)

write_file(
    name = "gen_libmavconn_stub_cpp",
    out = "_gen/libmavconn_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

write_file(
    name = "gen_extra_3",
    out = "_gen/include/mavconn/mavlink_dialect.hpp",
    content = ["//\n// libmavconn\n// Copyright 2014,2015,2016,2021 Vladimir Ermakov, All rights reserved.\n//\n// This file is part of the mavros package and subject to the license terms\n// in the top-level LICENSE file of the mavros repository.\n// https://github.com/mavlink/mavros/tree/master/LICENSE.md\n//\n/**\n * @brief MAVConn mavlink.h selector\n * @file mavlink_dialect.hpp\n * @author Vladimir Ermakov <vooon341@gmail.com>\n *\n * @addtogroup mavconn\n * @{\n */\n\n#pragma once\n#ifndef MAVCONN__MAVLINK_DIALECT_HPP_\n#define MAVCONN__MAVLINK_DIALECT_HPP_\n\n// AUTOMATIC GENERATED FILE!\n// from include/mavconn/mavlink_dialect.hpp.em\n\nnamespace mavlink\n{\n#ifndef MAVLINK_VERSION\n#include <mavlink/config.h>\nconstexpr auto version = MAVLINK_VERSION;\n#undef MAVLINK_VERSION\n#else\nconstexpr auto version = \"unknown\";\n#endif\n}  // namespace mavlink\n\n#define MAVLINK_START_SIGN_STREAM(link_id)\n#define MAVLINK_END_SIGN_STREAM(link_id)\n\n// NOTE(vooon): ignore warning\n// warning: ISO C++ prohibits anonymous structs\n#pragma GCC diagnostic push\n#pragma GCC diagnostic ignored \"-Wpedantic\"\n\n#include <mavlink/v2.0/common/common.hpp>\n#include <mavlink/v2.0/ardupilotmega/ardupilotmega.hpp>\n#include <mavlink/v2.0/ASLUAV/ASLUAV.hpp>\n#include <mavlink/v2.0/AVSSUAS/AVSSUAS.hpp>\n#include <mavlink/v2.0/all/all.hpp>\n#include <mavlink/v2.0/csAirLink/csAirLink.hpp>\n#include <mavlink/v2.0/cubepilot/cubepilot.hpp>\n#include <mavlink/v2.0/development/development.hpp>\n#include <mavlink/v2.0/icarous/icarous.hpp>\n#include <mavlink/v2.0/loweheiser/loweheiser.hpp>\n#include <mavlink/v2.0/marsh/marsh.hpp>\n#include <mavlink/v2.0/paparazzi/paparazzi.hpp>\n#include <mavlink/v2.0/standard/standard.hpp>\n#include <mavlink/v2.0/stemstudios/stemstudios.hpp>\n#include <mavlink/v2.0/storm32/storm32.hpp>\n#include <mavlink/v2.0/uAvionix/uAvionix.hpp>\n\n\n#pragma GCC diagnostic pop\n\n#endif  // MAVCONN__MAVLINK_DIALECT_HPP_\n"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mavconn",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_google_benchmark//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@mavlink//:ament_package",
    ],
)

cc_test(
    name = "test_mavconn",
    srcs = [":gen_libmavconn_stub_cpp"],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        ":ament_index",
        ":mavconn_e2e_shim",
    ] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "_gen/include",
        "include",
    ],
    local_defines = ros_local_defines() + ["GTEST_HAS_PTHREAD=1"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":mavconn_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake = [
        "cmake/Modules/CheckGeographicLibDatasets.cmake",
        "cmake/Modules/FindASIO.cmake",
        "cmake/Modules/em_expand.cmake",
        "libmavconn-extras.cmake",
    ],
    cmake_export_dependencies_list = ["console_bridge"],
    cmake_export_include_directories = False,
    cmake_export_targets = False,
    cmake_extras = ["libmavconn-extras.cmake"],
    cmake_strip_prefix = "",
    headers = [
        ":gen_extra_3",
    ] + glob(["include/**"]),
    include_prefix = "",
    libraries = [
        ":mavconn",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_google_benchmark//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@mavlink//:ament_package",
    ],
)
