load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
]

cc_library(
    name = "pfs_library",
    srcs = [
        "src/block.cpp",
        "src/block_queue.cpp",
        "src/fd.cpp",
        "src/mem.cpp",
        "src/net.cpp",
        "src/parsers/block_stat.cpp",
        "src/parsers/buddyinfo.cpp",
        "src/parsers/cgroup.cpp",
        "src/parsers/cgroup_controller.cpp",
        "src/parsers/common.cpp",
        "src/parsers/filesystems.cpp",
        "src/parsers/loadavg.cpp",
        "src/parsers/maps.cpp",
        "src/parsers/meminfo.cpp",
        "src/parsers/modules.cpp",
        "src/parsers/mountinfo.cpp",
        "src/parsers/net_arp.cpp",
        "src/parsers/net_device.cpp",
        "src/parsers/net_route.cpp",
        "src/parsers/net_socket.cpp",
        "src/parsers/netlink_socket.cpp",
        "src/parsers/proc_stat.cpp",
        "src/parsers/syscall.cpp",
        "src/parsers/task_io.cpp",
        "src/parsers/task_status.cpp",
        "src/parsers/unix_socket.cpp",
        "src/parsers/uptime.cpp",
        "src/procfs.cpp",
        "src/smaps.cpp",
        "src/sysfs.cpp",
        "src/task.cpp",
        "src/types.cpp",
        "src/utils.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    includes = [
        "include",
        "include/pfs",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

genrule(
    name = "static_pfs_a",
    srcs = [":pfs_library"],
    outs = ["libpfs.a"],
    cmd = "for f in $(SRCS); do case $$f in *.a) cp $$f $@; break;; esac; done",
)

ament_index(
    name = "ament_index",
    libraries = [
        ":static_pfs_a",
    ],
    package_xml = "package.xml",
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [
        ":static_pfs_a",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
    ],
)
