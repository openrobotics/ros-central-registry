        "sample/format.hpp",
        "sample/log.hpp",
        "sample/menu.hpp",
        "sample/tool.hpp",
        "test/catch.hpp",
        "test/test_utils.hpp",
    ],
    includes = [
        "include",
        "include/pfs",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

genrule(
    name = "static_pfs_a",
    srcs = [":pfs_library"],
    outs = ["libpfs.a"],
    cmd = "for f in $(SRCS); do case $$f in *.a) cp $$f $@; break;; esac; done",
)

ament_index(
    name = "ament_index",
    libraries = [
        ":static_pfs_a",
    ],
    package_xml = "package.xml",
)

ament_package(
