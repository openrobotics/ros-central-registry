    name = name,
    timeout = "moderate",
    srcs = srcs,
    cxxopts = ["-Wno-unused-result"],
    data = [
        "resources/test_node/load_complicated_parameters.yaml",
        "resources/test_node/load_parameters.yaml",
        "resources/test_node/no_valid_parameters.yaml",
        "resources/test_node/test_parameters.yaml",
        "resources/test_node_parameters/complicated_wildcards.yaml",
        "resources/test_node_parameters/params_by_order.yaml",
        "resources/test_node_parameters/wildcards.yaml",
    ] + ["@test_msgs//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    flaky = name in ["test_executors_busy_waiting"],
    local_defines = [
        'ROS_PACKAGE_NAME=\\"rclcpp\\"',
        'TEST_RESOURCES_DIRECTORY=\\".\\"',
    ],
    deps = TEST_DEPENDENCIES.values() + [
        ":test_utils_headers",
        "//test/msg:cc",
        "@rosdistro//cc:googletest",
        "@rosdistro//cc:mimick",
