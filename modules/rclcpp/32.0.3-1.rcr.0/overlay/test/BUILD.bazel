# Local helper headers #included by the tests via relative paths.
cc_library(
    name = "test_utils_headers",
    testonly = True,
    hdrs = [
        "locate_test_assets.hpp",
        "mocking_utils/patch.hpp",
        "rclcpp/executors/executor_types.hpp",
        "rclcpp/executors/test_waitable.hpp",
        "rclcpp/node_interfaces/node_wrapper.hpp",
