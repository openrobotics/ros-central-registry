[cc_test(
    name = name,
    timeout = "moderate",
    srcs = ["benchmark/{}.cpp".format(name)],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    tags = ["manual"],
    deps = TEST_DEPENDENCIES.values() + [
        "@google_benchmark//:benchmark_main",
        "@performance_test_fixture",
        "@rcl_interfaces//:cc",
        "@test_msgs//:test_msgs_cc",
    ],
) for name in [
    "benchmark_client",
    "benchmark_executor",
    "benchmark_init_shutdown",
    "benchmark_node",
    "benchmark_node_parameters_interface",
    "benchmark_parameter_client",
    "benchmark_service",
]]
