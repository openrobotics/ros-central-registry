 namespace
 {
+
+// Cross-platform way of obtaining the full path to the current executable.
+// Runfiles::Create()'s argv0 parameter is only consulted as a fallback when
+// neither RUNFILES_DIR nor RUNFILES_MANIFEST_FILE are set in the environment
+// -- which is exactly the case under `bazel run` (its runner script
+// explicitly unsets both, unlike `bazel test`, which populates them). The
+// fallback derives the runfiles directory as "<argv0>.runfiles", so argv0
+// needs to be a real, usable path here, not a placeholder. Mirrors
+// ament_index_cpp's own get_executable_path() in get_search_paths.cpp.
+static std::string
+get_executable_path()
+{
+#if defined(_WIN32)
+  char result[MAX_PATH + 1] = {'\0'};
+  auto path_len = GetModuleFileNameA(NULL, result, MAX_PATH);
+#elif defined(__APPLE__)
+  char result[PATH_MAX + 1] = {'\0'};
+  uint32_t path_len = PATH_MAX;
+  if (_NSGetExecutablePath(result, &path_len) != 0) {
+    return "ignore-argv[0]";
+  }
+  path_len = std::string(result).length();
+#else
+  char result[PATH_MAX + 1] = {'\0'};
+  ssize_t path_len = readlink("/proc/self/exe", result, PATH_MAX);
+#endif
+  if (path_len > 0) {
+    return std::string(result, path_len);
+  }
+  return "ignore-argv[0]";
+}
+
+// Try to get the value of an environment variable, and optionally return the result.
+static std::optional<std::string>
+get_env_variable(const char * env_var)
+{
+  char * ament_prefix_path = nullptr;
+#ifndef _WIN32
+  ament_prefix_path = getenv(env_var);
+#else
+  size_t ament_prefix_path_size;
+  _dupenv_s(&ament_prefix_path, &ament_prefix_path_size, env_var);
+#endif
+  if (!ament_prefix_path || std::string(ament_prefix_path).empty())
+  {
+      return {};
+  }
+  return std::string(ament_prefix_path);
+}
 
