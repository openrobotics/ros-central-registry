CC_DEPS = [
    "@nav2_core//:nav2_core_library",
    "@nav2_ros_common//:nav2_ros_common",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "dwb_core_library",
    srcs = [
        "src/dwb_local_planner.cpp",
        "src/illegal_trajectory_tracker.cpp",
        "src/publisher.cpp",
        "src/trajectory_utils.cpp",
    ],
    hdrs = [
        "include/dwb_core/dwb_local_planner.hpp",
        "include/dwb_core/exceptions.hpp",
        "include/dwb_core/illegal_trajectory_tracker.hpp",
        "include/dwb_core/publisher.hpp",
        "include/dwb_core/trajectory_critic.hpp",
        "include/dwb_core/trajectory_generator.hpp",
        "include/dwb_core/trajectory_utils.hpp",
    ],
    includes = [
        "include",
        "include/dwb_core",
        "test",
    ],
    local_defines = ros_local_defines() + [
        'BTCPP_LIBRARY_VERSION=\\"4.10.0\\"',
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "dwb_core",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":dwb_core_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":dwb_core"],
)

ament_index(
    name = "ament_index",
    libraries = [":dwb_core"],
    package_xml = "package.xml",
    plugin_category = "nav2_core",
    plugins = ["local_planner_plugin.xml"],
    deps = [
