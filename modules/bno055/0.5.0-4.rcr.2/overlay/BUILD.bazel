load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

py_library(
    name = "bno055",
    srcs = glob(["bno055/**/*.py"]),
    imports = ["."],
    deps = [
        "@example_interfaces//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

pkg_files(
    name = "config_files",
    srcs = glob(["bno055/params/*.yaml"]),
    prefix = "share/bno055/config",
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"bno055": "bno055.bno055:main"},
    data = glob(["launch/*.launch.py"]),
    install = [":config_files"],
    package_xml = "package.xml",
    python = [":bno055"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@example_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
