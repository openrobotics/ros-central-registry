load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "bno055",
    srcs = [
        "bno055/__init__.py",
        "bno055/bno055.py",
        "bno055/connectors/Connector.py",
        "bno055/connectors/__init__.py",
        "bno055/connectors/i2c.py",
        "bno055/connectors/uart.py",
        "bno055/error_handling/__init__.py",
        "bno055/error_handling/exceptions.py",
        "bno055/params/NodeParameters.py",
        "bno055/params/__init__.py",
        "bno055/registers.py",
        "bno055/sensor/SensorService.py",
        "bno055/sensor/__init__.py",
    ],
    imports = ["."],
    deps = [
        "@example_interfaces//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

ament_index(
    name = "ament_index",
    data = ["//launch:launch_files"] + [
        "bno055/params/bno055_params.yaml",
        "bno055/params/bno055_params_i2c.yaml",
        "bno055/params/bno055_params_test.yaml",
    ],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    console_scripts = {"bno055": "bno055.bno055:main"},
    data = ["//launch:launch_files"],
    package_xml = "package.xml",
    python = [":bno055"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@example_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
