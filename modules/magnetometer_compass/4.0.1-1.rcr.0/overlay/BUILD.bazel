    "@tf2_sensor_msgs//:tf2_sensor_msgs": "@tf2_sensor_msgs//:tf2_sensor_msgs_library",
}

CC_DEPS = [
    "@angles//:angles",
    "@builtin_interfaces//:cc",
    "@compass_interfaces//:cc",
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
    "@rosdistro//cc:tl_expected",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

_HDRS = [
    "include/magnetometer_compass/magnetometer_compass.hpp",
    "include/magnetometer_compass/magnetometer_compass_nodelet.hpp",
    "include/magnetometer_compass/tf2_sensor_msgs.hpp",
    "include/magnetometer_compass/visualize_azimuth_nodelet.hpp",
    ":version_h",
]

cc_library(
    name = "magnetometer_compass_library",
    srcs = ["src/magnetometer_compass.cpp"],
    hdrs = _HDRS,
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/magnetometer_compass",
        "_gen/include/magnetometer_compass/magnetometer_compass",
        "include",
        "include/magnetometer_compass",
    ],
    local_defines = ros_local_defines() + [
        "MESSAGE_FILTERS_VERSION_SUBSCRIBER_USES_NODE_INTERFACES=1",
        "TF2_SENSOR_MSGS_HAS_IMU=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "magnetometer_compass",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":magnetometer_compass_library"],
)

cc_library(
    name = "magnetometer_compass_nodelet_lib_library",
    srcs = ["nodelets/magnetometer_compass_nodelet.cpp"],
    hdrs = _HDRS,
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/magnetometer_compass",
        "_gen/include/magnetometer_compass/magnetometer_compass",
        "include",
        "include/magnetometer_compass",
    ],
    local_defines = ros_local_defines() + [
        "MESSAGE_FILTERS_VERSION_SUBSCRIBER_USES_NODE_INTERFACES=1",
        "TF2_ROS_HAS_NODE_INTERFACES=1",
        "TF2_SENSOR_MSGS_HAS_IMU=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":magnetometer_compass_library"],
)

cc_shared_library(
    name = "magnetometer_compass_nodelet_lib",
    dynamic_deps = DEPENDENCIES.keys() + [":magnetometer_compass"],
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":magnetometer_compass_nodelet_lib_library"],
)

cc_library(
    name = "visualize_azimuth_nodelet_lib_library",
    srcs = ["nodelets/visualize_azimuth_nodelet.cpp"],
    hdrs = _HDRS,
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/magnetometer_compass",
        "_gen/include/magnetometer_compass/magnetometer_compass",
        "include",
        "include/magnetometer_compass",
    ],
    local_defines = ros_local_defines() + ["MESSAGE_FILTERS_VERSION_SUBSCRIBER_USES_NODE_INTERFACES=1"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "visualize_azimuth_nodelet_lib",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":visualize_azimuth_nodelet_lib_library"],
)

rclcpp_components_register_node(
    name = "magnetometer_compass_nodelet",
    component = ":magnetometer_compass_nodelet_lib",
    node_name = "magnetometer_compass_nodelet",
    plugin = "magnetometer_compass::MagnetometerCompassNodelet",
)

rclcpp_components_register_node(
    name = "visualize_azimuth_nodelet",
    component = ":visualize_azimuth_nodelet_lib",
    node_name = "visualize_azimuth_nodelet",
    plugin = "magnetometer_compass::VisualizeAzimuthNodelet",
)

rclcpp_components_register_nodes(
    name = "visualize_azimuth_nodelet_lib_components",
    component = ":visualize_azimuth_nodelet_lib",
    plugins = ["magnetometer_compass::VisualizeAzimuthNodelet"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ros_version_header(
    name = "version_h",
    out = "_gen/include/magnetometer_compass/magnetometer_compass/version.h",
)

ament_index(
    name = "ament_index",
    components = [
        ":magnetometer_compass_nodelet_record",
        ":visualize_azimuth_nodelet_record",
        ":visualize_azimuth_nodelet_lib_components",
    ],
    data = ["//launch:launch_files"],
    lib_data = [
        ":magnetometer_compass_nodelet",
        ":visualize_azimuth_nodelet",
    ],
    libraries = [
        ":magnetometer_compass",
        ":magnetometer_compass_nodelet_lib",
        ":visualize_azimuth_nodelet_lib",
    ],
    package_xml = "package.xml",
    plugin_category = "rclcpp",
    plugins = ["plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@angles//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@compass_conversions//:ament_package",
        "@compass_interfaces//:ament_package",
        "@cras_cpp_common//:ament_package",
        "@cras_lint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch_ros//:ament_package",
        "@magnetometer_pipeline//:ament_package",
        "@message_filters//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@tf2_sensor_msgs//:ament_package",
    ],
)

