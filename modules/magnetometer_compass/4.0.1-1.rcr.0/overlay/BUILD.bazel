package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@compass_conversions//:compass_converter": "@compass_conversions//:compass_converter_library",
    "@compass_conversions//:compass_message_filter": "@compass_conversions//:compass_message_filter_library",
    "@compass_conversions//:compass_topic_names": "@compass_conversions//:compass_topic_names_library",
    "@compass_conversions//:tf2_compass_msgs": "@compass_conversions//:tf2_compass_msgs_library",
    "@compass_interfaces//:compass_interfaces_string_utils": "@compass_interfaces//:compass_interfaces_string_utils_library",
    "@cras_cpp_common//:cras_log_utils": "@cras_cpp_common//:cras_log_utils_library",
    "@cras_cpp_common//:cras_rate_limiter": "@cras_cpp_common//:cras_rate_limiter_library",
    "@cras_cpp_common//:cras_string_utils": "@cras_cpp_common//:cras_string_utils_library",
    "@cras_cpp_common//:cras_tf2_utils": "@cras_cpp_common//:cras_tf2_utils_library",
    "@cras_cpp_common//:cras_time_utils": "@cras_cpp_common//:cras_time_utils_library",
    "@magnetometer_pipeline//:magnetometer_bias_remover": "@magnetometer_pipeline//:magnetometer_bias_remover_library",
    "@magnetometer_pipeline//:magnetometer_bias_remover_filter": "@magnetometer_pipeline//:magnetometer_bias_remover_filter_library",
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
