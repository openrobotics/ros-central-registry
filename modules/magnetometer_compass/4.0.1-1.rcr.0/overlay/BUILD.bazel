    name = "gen_extra_3",
    out = "_gen/include/magnetometer_compass/magnetometer_compass/version.h",
    content = ["// Copyright 2015 Open Source Robotics Foundation, Inc.\n//\n// Licensed under the Apache License, Version 2.0 (the \"License\");\n// you may not use this file except in compliance with the License.\n// You may obtain a copy of the License at\n//\n//     http://www.apache.org/licenses/LICENSE-2.0\n//\n// Unless required by applicable law or agreed to in writing, software\n// distributed under the License is distributed on an \"AS IS\" BASIS,\n// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n// See the License for the specific language governing permissions and\n// limitations under the License.\n\n#ifndef MAGNETOMETER_COMPASS__VERSION_H_\n#define MAGNETOMETER_COMPASS__VERSION_H_\n\n/// \\def MAGNETOMETER_COMPASS_VERSION_MAJOR\n/// Defines MAGNETOMETER_COMPASS major version number\n#define MAGNETOMETER_COMPASS_VERSION_MAJOR (4)\n\n/// \\def MAGNETOMETER_COMPASS_VERSION_MINOR\n/// Defines MAGNETOMETER_COMPASS minor version number\n#define MAGNETOMETER_COMPASS_VERSION_MINOR (0)\n\n/// \\def MAGNETOMETER_COMPASS_VERSION_PATCH\n/// Defines MAGNETOMETER_COMPASS version patch number\n#define MAGNETOMETER_COMPASS_VERSION_PATCH (1)\n\n/// \\def MAGNETOMETER_COMPASS_VERSION_STR\n/// Defines MAGNETOMETER_COMPASS version string\n#define MAGNETOMETER_COMPASS_VERSION_STR \"4.0.1\"\n\n/// \\def MAGNETOMETER_COMPASS_VERSION_GTE\n/// Defines a macro to check whether the version of MAGNETOMETER_COMPASS is greater than or equal to\n/// the given version triple.\n#define MAGNETOMETER_COMPASS_VERSION_GTE(major, minor, patch) ( \\\n     (major < MAGNETOMETER_COMPASS_VERSION_MAJOR) ? true \\\n     : ((major > MAGNETOMETER_COMPASS_VERSION_MAJOR) ? false \\\n     : ((minor < MAGNETOMETER_COMPASS_VERSION_MINOR) ? true \\\n     : ((minor > MAGNETOMETER_COMPASS_VERSION_MINOR) ? false \\\n     : ((patch < MAGNETOMETER_COMPASS_VERSION_PATCH) ? true \\\n     : ((patch > MAGNETOMETER_COMPASS_VERSION_PATCH) ? false \\\n     : true))))))\n\n#endif  // MAGNETOMETER_COMPASS__VERSION_H_\n"],
)

