load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "demo.launch.py",
        "move_group.launch.py",
        "moveit_rviz.launch.py",
        "robot.launch.py",
        "rsp.launch.py",
        "setup_assistant.launch.py",
        "sim.launch.py",
        "spawn_controllers.launch.py",
        "static_virtual_joint_tfs.launch.py",
        "warehouse_db.launch.py",
    ],
)

launch_ros_binary(
    name = "demo_launch",
    src = "demo.launch.py",
    data = ["//:ament_index"],
    deps = ["@moveit_configs_utils"],
)

launch_ros_binary(
    name = "move_group_launch",
    src = "move_group.launch.py",
    data = ["//:ament_index"],
    deps = ["@moveit_configs_utils"],
)

launch_ros_binary(
    name = "moveit_rviz_launch",
    src = "moveit_rviz.launch.py",
    data = ["//:ament_index"],
    deps = ["@moveit_configs_utils"],
)

launch_ros_binary(
    name = "robot_launch",
    src = "robot.launch.py",
    data = [
        "//:ament_index",
        "@controller_manager//:ament_index",
        "@controller_manager//:ros2_control_node",
        "@moveit_ros_move_group//:ament_index",
        "@moveit_ros_move_group//:move_group",
        "@robot_state_publisher",
        "@robot_state_publisher//:ament_index",
        "@rviz2",
        "@rviz2//:ament_index",
        "@tf2_ros//:ament_index",
        "@tf2_ros//:static_transform_publisher",
    ],
    deps = [
        "@ament_index_python",
        "@moveit_configs_utils",
    ],
)

launch_ros_binary(
    name = "rsp_launch",
    src = "rsp.launch.py",
    data = ["//:ament_index"],
    deps = ["@moveit_configs_utils"],
)

launch_ros_binary(
    name = "setup_assistant_launch",
    src = "setup_assistant.launch.py",
    data = ["//:ament_index"],
    deps = ["@moveit_configs_utils"],
)

launch_ros_binary(
    name = "sim_launch",
    src = "sim.launch.py",
    data = [
        "//:ament_index",
        "@moveit_ros_move_group//:ament_index",
        "@moveit_ros_move_group//:move_group",
        "@rviz2",
        "@rviz2//:ament_index",
    ],
    deps = [
        "@ament_index_python",
        "@moveit_configs_utils",
    ],
)

launch_ros_binary(
    name = "spawn_controllers_launch",
    src = "spawn_controllers.launch.py",
    data = ["//:ament_index"],
    deps = ["@moveit_configs_utils"],
)

launch_ros_binary(
    name = "static_virtual_joint_tfs_launch",
    src = "static_virtual_joint_tfs.launch.py",
    data = ["//:ament_index"],
    deps = ["@moveit_configs_utils"],
)

launch_ros_binary(
    name = "warehouse_db_launch",
    src = "warehouse_db.launch.py",
    data = ["//:ament_index"],
    deps = ["@moveit_configs_utils"],
)
