load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@tuw_airskin_msgs//:cc_shared": "@tuw_airskin_msgs//:cc",
    "@tuw_geometry_msgs//:cc_shared": "@tuw_geometry_msgs//:cc",
    "@tuw_graph_msgs//:cc_shared": "@tuw_graph_msgs//:cc",
    "@tuw_multi_robot_msgs//:cc_shared": "@tuw_multi_robot_msgs//:cc",
    "@tuw_nav_msgs//:cc_shared": "@tuw_nav_msgs//:cc",
    "@tuw_object_map_msgs//:cc_shared": "@tuw_object_map_msgs//:cc",
    "@tuw_object_msgs//:cc_shared": "@tuw_object_msgs//:cc",
    "@tuw_std_msgs//:cc_shared": "@tuw_std_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@tuw_object_msgs//:tuw_object_msgs_headers",
    "@tuw_std_msgs//:tuw_std_msgs_headers",
]

cc_library(
    name = "tuw_msgs_library",
    srcs = ["src/utils.cpp"],
    hdrs = [
        "include/tuw_msgs/geo_point.hpp",
        "include/tuw_msgs/geo_point_json.hpp",
        "include/tuw_msgs/utils.hpp",
    ],
    includes = [
        "include",
        "include/tuw_msgs",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "tuw_msgs",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":tuw_msgs_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":tuw_msgs"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@tuw_airskin_msgs//:ament_package",
        "@tuw_geometry_msgs//:ament_package",
        "@tuw_graph_msgs//:ament_package",
        "@tuw_multi_robot_msgs//:ament_package",
        "@tuw_nav_msgs//:ament_package",
        "@tuw_object_map_msgs//:ament_package",
        "@tuw_object_msgs//:ament_package",
        "@tuw_std_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_name = "export_tuw_msgs",
    headers = [
        "include/tuw_msgs/geo_point.hpp",
        "include/tuw_msgs/geo_point_json.hpp",
        "include/tuw_msgs/utils.hpp",
    ],
    include_prefix = "",
    libraries = [":tuw_msgs"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@tuw_airskin_msgs//:ament_package",
        "@tuw_geometry_msgs//:ament_package",
        "@tuw_graph_msgs//:ament_package",
        "@tuw_multi_robot_msgs//:ament_package",
        "@tuw_nav_msgs//:ament_package",
        "@tuw_object_map_msgs//:ament_package",
        "@tuw_object_msgs//:ament_package",
        "@tuw_std_msgs//:ament_package",
    ],
)
