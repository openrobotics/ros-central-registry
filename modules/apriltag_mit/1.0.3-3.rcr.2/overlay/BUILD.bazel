load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
}

CC_DEPS = [
    "@rosdistro//cc:boost.smart_ptr",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "apriltag_mit_library",
    srcs = [":gen_apriltag_mit_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/apriltag_mit",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "apriltag_mit",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":apriltag_mit_library"],
)

write_file(
    name = "gen_apriltag_mit_stub_cpp",
    out = "_gen/apriltag_mit_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    libraries = [":apriltag_mit"],
    package_xml = "package.xml",
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(["include/**"]),
    include_prefix = "",
    install_package_xml = False,
    libraries = [":apriltag_mit"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
    ],
)
