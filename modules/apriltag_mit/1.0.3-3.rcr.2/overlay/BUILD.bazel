load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
}

CC_DEPS = [
    "@rosdistro//cc:boost.smart_ptr",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "apriltag_mit_library",
    srcs = [
        "src/DisjointSets.cc",
        "src/Edge.cc",
        "src/FloatImage.cc",
        "src/GrayModel.cc",
        "src/Line2D.cc",
        "src/LineSegment2D.cc",
        "src/Quad.cc",
        "src/Segment.cc",
        "src/TagDetection.cc",
        "src/TagDetector.cc",
        "src/TagFamily.cc",
    ],
    hdrs = [
        "include/apriltag_mit/AprilTags/DisjointSets.h",
        "include/apriltag_mit/AprilTags/Edge.h",
        "include/apriltag_mit/AprilTags/FloatImage.h",
        "include/apriltag_mit/AprilTags/GrayModel.h",
        "include/apriltag_mit/AprilTags/Gridder.h",
        "include/apriltag_mit/AprilTags/Line2D.h",
        "include/apriltag_mit/AprilTags/LineSegment2D.h",
        "include/apriltag_mit/AprilTags/MathUtil.h",
        "include/apriltag_mit/AprilTags/Quad.h",
        "include/apriltag_mit/AprilTags/Segment.h",
        "include/apriltag_mit/AprilTags/Tag16h5.h",
        "include/apriltag_mit/AprilTags/Tag25h9.h",
        "include/apriltag_mit/AprilTags/Tag36h11.h",
        "include/apriltag_mit/AprilTags/TagCodes.h",
        "include/apriltag_mit/AprilTags/TagDetection.h",
        "include/apriltag_mit/AprilTags/TagDetector.h",
        "include/apriltag_mit/AprilTags/TagFamily.h",
        "include/apriltag_mit/AprilTags/timer.h",
        "include/apriltag_mit/apriltag_mit.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/apriltag_mit",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "apriltag_mit",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":apriltag_mit_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":apriltag_mit"],
    package_xml = "package.xml",
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/apriltag_mit/AprilTags/DisjointSets.h",
        "include/apriltag_mit/AprilTags/Edge.h",
        "include/apriltag_mit/AprilTags/FloatImage.h",
        "include/apriltag_mit/AprilTags/GrayModel.h",
        "include/apriltag_mit/AprilTags/Gridder.h",
        "include/apriltag_mit/AprilTags/Line2D.h",
        "include/apriltag_mit/AprilTags/LineSegment2D.h",
        "include/apriltag_mit/AprilTags/MathUtil.h",
        "include/apriltag_mit/AprilTags/Quad.h",
        "include/apriltag_mit/AprilTags/Segment.h",
        "include/apriltag_mit/AprilTags/Tag16h5.h",
        "include/apriltag_mit/AprilTags/Tag16h5.other",
        "include/apriltag_mit/AprilTags/Tag25h7.disable",
        "include/apriltag_mit/AprilTags/Tag25h9.h",
        "include/apriltag_mit/AprilTags/Tag36h11.h",
        "include/apriltag_mit/AprilTags/Tag36h11.other",
        "include/apriltag_mit/AprilTags/Tag36h9.disable",
        "include/apriltag_mit/AprilTags/TagCodes.h",
        "include/apriltag_mit/AprilTags/TagDetection.h",
        "include/apriltag_mit/AprilTags/TagDetector.h",
        "include/apriltag_mit/AprilTags/TagFamily.h",
        "include/apriltag_mit/AprilTags/timer.h",
        "include/apriltag_mit/apriltag_mit.h",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [":apriltag_mit"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
    ],
)
