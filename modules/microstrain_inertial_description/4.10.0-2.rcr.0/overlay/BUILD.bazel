load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = [
        "meshes/cv5.stl",
        "meshes/cv7.stl",
        "meshes/gq7.stl",
        "meshes/gv7.stl",
        "meshes/gx5_15.stl",
        "meshes/gx5_25.stl",
        "meshes/gx5_45.stl",
        "meshes/rtk.stl",
        "urdf/cv5.urdf.xacro",
        "urdf/cv7.urdf.xacro",
        "urdf/gq7.urdf.xacro",
        "urdf/gv7.urdf.xacro",
        "urdf/gx5_15.urdf.xacro",
        "urdf/gx5_25.urdf.xacro",
        "urdf/gx5_45.urdf.xacro",
        "urdf/rtk.urdf.xacro",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@rosdistro//:ament_package",
        "@xacro//:ament_package",
    ],
)
