load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### DATA

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@rosbag2_storage_mcap//:ament_index",
        "@rosbag2_storage_sqlite3//:ament_index",
    ],
)

### LIBRARIES

DEPENDENCIES = {
    "@rosbag2_storage_mcap//:rosbag2_storage_mcap": "@rosbag2_storage_mcap//:rosbag2_storage_mcap_library",
    "@rosbag2_storage_sqlite3//:rosbag2_storage_sqlite3": "@rosbag2_storage_sqlite3//:rosbag2_storage_sqlite3_library",
}

cc_library(
    name = "rosbag2_storage_default_plugins_library",
    data = [":ament_index"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rosbag2_storage_default_plugins",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rosbag2_storage_default_plugins_library"],
    deps = [":rosbag2_storage_default_plugins_library"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@rosbag2_storage_mcap//:ament_package",
        "@rosbag2_storage_sqlite3//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
