load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

ament_index(
    name = "ament_index",
    data = [
        "CHANGELOG.rst",
        "LICENSE",
        "README.md",
        "config/controllers.yaml",
        "description/robstride_example.urdf.xacro",
        "description/robstride_motor_profiles.xacro",
        "//launch:launch_files",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_index_python//:ament_package",
        "@controller_manager//:ament_package",
        "@forward_command_controller//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@robstride_ros2_control//:ament_package",
        "@ros2_socketcan//:ament_package",
        "@xacro//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_index_python//:ament_package",
        "@controller_manager//:ament_package",
        "@forward_command_controller//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@robstride_ros2_control//:ament_package",
        "@ros2_socketcan//:ament_package",
        "@xacro//:ament_package",
    ],
)
