load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "CHANGELOG.rst",
        "LICENSE",
        "README.md",
        "config/controllers.yaml",
        "description/robstride_example.urdf.xacro",
        "description/robstride_motor_profiles.xacro",
        "launch/robstride_example.launch.py",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_index_python//:ament_package",
        "@controller_manager//:ament_package",
        "@forward_command_controller//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@robstride_ros2_control//:ament_package",
        "@ros2_socketcan//:ament_package",
        "@xacro//:ament_package",
    ],
)

py_pytest(
    name = "test_motor_profile_gains",
    srcs = ["test/test_motor_profile_gains.py"],
    data = [":ament_index"],
    deps = [
        "@ament_index_python",
        "@controller_manager//:controller_manager_py",
        "@launch",
        "@launch//:test_support",
        "@launch_ros",
    ],
)

launch_ros_binary(
    name = "robstride_example.launch.py",
    src = "launch/robstride_example.launch.py",
    data = [":ament_index"],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_index_python//:ament_package",
        "@controller_manager//:ament_package",
        "@forward_command_controller//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@robstride_ros2_control//:ament_package",
        "@ros2_socketcan//:ament_package",
        "@xacro//:ament_package",
    ],
)
