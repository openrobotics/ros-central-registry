load("@qt//:qt.bzl", "qt_cc_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/tile_map/bing_source.hpp",
        "include/tile_map/image_cache.hpp",
        "include/tile_map/stadia_source.hpp",
        "include/tile_map/texture_cache.hpp",
        "include/tile_map/tile_map_plugin.hpp",
        "include/tile_map/tile_map_view.hpp",
        "include/tile_map/tile_source.hpp",
        "include/tile_map/wmts_source.hpp",
    ],
    includes = [],
)

DEPENDENCIES = {
    "@mapviz//:mapviz_core": "@mapviz//:mapviz_core_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:curl": "@rosdistro//cc:curl_library",
    "@rosdistro//cc:geographiclib": "@rosdistro//cc:geographiclib_library",
    "@rosdistro//cc:jsoncpp": "@rosdistro//cc:jsoncpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:proj": "@rosdistro//cc:proj_library",
    "@rosdistro//cc:sqlite3": "@rosdistro//cc:sqlite3_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@swri_math_util//:swri_math_util": "@swri_math_util//:swri_math_util_library",
    "@swri_transform_util//:swri_transform_util": "@swri_transform_util//:swri_transform_util_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
}

CC_DEPS = [
    ":_gen_textual_hdrs",
    "@geometry_msgs//:cc",
    "@qtbase//:core",
    "@qtbase//:gui",
    "@qtbase//:network",
    "@qtbase//:opengl",
    "@qtbase//:openglwidgets",
    "@qtbase//:widgets",
    "@qtsvg//:svg",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

genrule(
    name = "uic_tile_map_config",
    srcs = ["src/tile_map_config.ui"],
    outs = ["ui_tile_map_config.h"],
    cmd = "$(execpath @qtbase//:uic) $< -o $@",
    tools = ["@qtbase//:uic"],
)

cc_library(
    name = "_gen_textual_hdrs",
    includes = ["_gen/include"],
    textual_hdrs = [
    ],
)

qt_cc_library(
    name = "tile_map_library",
    srcs = [
        "src/bing_source.cpp",
        "src/image_cache.cpp",
        "src/stadia_source.cpp",
        "src/texture_cache.cpp",
        "src/tile_map_view.cpp",
        "src/tile_source.cpp",
        "src/wmts_source.cpp",
    ],
    hdrs = [
        "include/tile_map/bing_source.hpp",
        "include/tile_map/image_cache.hpp",
        "include/tile_map/stadia_source.hpp",
        "include/tile_map/tile_source.hpp",
        "include/tile_map/wmts_source.hpp",
    ] + [
        "include/tile_map/texture_cache.hpp",
        "include/tile_map/tile_map_plugin.hpp",
        "include/tile_map/tile_map_view.hpp",
        ":ui_tile_map_config.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/tile_map",
    ],
    local_defines = ros_local_defines() + [
        "TILE_MAP_HAVE_TRANSFORM_EQUALITY",
        "USE_NEW_TF2_ROS_CTORS=0",
        "USE_NEW_TF2_TOMSG=1",
    ],
    moc_hdrs = [
        "include/tile_map/bing_source.hpp",
        "include/tile_map/image_cache.hpp",
        "include/tile_map/stadia_source.hpp",
        "include/tile_map/tile_source.hpp",
        "include/tile_map/wmts_source.hpp",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "tile_map",
    dynamic_deps = DEPENDENCIES.keys() + [
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtsvg//:svg_shared",
        "@qtbase//:widgets_shared",
        "@qtbase//:opengl_shared",
        "@qtbase//:openglwidgets_shared",
        "@qtbase//:network_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":tile_map_library"],
)

qt_cc_library(
    name = "tile_map_plugin_library",
    srcs = ["src/tile_map_plugin.cpp"],
    hdrs = ["include/tile_map/tile_map_plugin.hpp"] + [
        "include/tile_map/bing_source.hpp",
        "include/tile_map/image_cache.hpp",
        "include/tile_map/stadia_source.hpp",
        "include/tile_map/texture_cache.hpp",
        "include/tile_map/tile_map_view.hpp",
        "include/tile_map/tile_source.hpp",
        "include/tile_map/wmts_source.hpp",
        ":ui_tile_map_config.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/tile_map",
    ],
    local_defines = ros_local_defines() + [
        "USE_NEW_TF2_ROS_CTORS=0",
        "USE_NEW_TF2_TOMSG=1",
        "_FILE_OFFSET_BITS=64",
    ],
    moc_hdrs = ["include/tile_map/tile_map_plugin.hpp"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":tile_map_library"],
)

cc_shared_library(
    name = "tile_map_plugin",
    dynamic_deps = DEPENDENCIES.keys() + [":tile_map"] + [
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtsvg//:svg_shared",
        "@qtbase//:widgets_shared",
        "@qtbase//:opengl_shared",
        "@qtbase//:openglwidgets_shared",
        "@qtbase//:network_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":tile_map_plugin_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":tile_map",
        ":tile_map_plugin",
    ],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mapviz//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@swri_math_util//:ament_package",
        "@swri_transform_util//:ament_package",
        "@tf2//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    colcon_hooks = False,
    install_package_xml = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mapviz//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@swri_math_util//:ament_package",
        "@swri_transform_util//:ament_package",
        "@tf2//:ament_package",
    ],
)
