genrule(
    name = "tar",
    srcs = [":raw_tar"],
    outs = ["tar.tar.gz"],
    cmd = "tmpdir=$$(mktemp -d) && tar -xzf $(location :raw_tar) -C $$tmpdir && rm -rf $$tmpdir/opt/ros/lyrical/tile_map/share/tile_map/hook && tar -czf $@ -C $$tmpdir opt && rm -rf $$tmpdir",
)

