load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@mapviz//:mapviz_core": "@mapviz//:mapviz_core_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@swri_math_util//:swri_math_util": "@swri_math_util//:swri_math_util_library",
    "@swri_transform_util//:swri_transform_util": "@swri_transform_util//:swri_transform_util_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
}

CC_DEPS = [
    "//:_gen_textual_hdrs",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@qtbase//:core",
    "@qtbase//:gui",
    "@qtsvg//:svg",
    "@qtbase//:widgets",
    "@qtbase//:opengl",
    "@qtbase//:openglwidgets",
    "@qtbase//:network",
]

cc_test(
    name = "test_tile_map_plugin",
    srcs = ["test_tile_map_plugin.cpp"] + [] + ["//:ui_tile_map_config.h"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        "//:ament_index",
        "//:tile_map",
        "//:tile_map_plugin",
    ],
    dynamic_deps = [
        "//:transitive_dynamic_deps",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtsvg//:svg_shared",
        "@qtbase//:widgets_shared",
        "@qtbase//:opengl_shared",
        "@qtbase//:openglwidgets_shared",
        "@qtbase//:network_shared",
    ],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "USE_NEW_TF2_ROS_CTORS=0",
        "USE_NEW_TF2_TOMSG=1",
        "_FILE_OFFSET_BITS=64",
    ],
    # GUI test: needs a Qt platform plugin / OpenGL context, which the hermetic\ntest environment does not provide.
    tags = ["manual"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:tile_map_library",
        "//:tile_map_plugin_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

