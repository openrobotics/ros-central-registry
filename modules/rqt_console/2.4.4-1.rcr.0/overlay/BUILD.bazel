load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### DATA

ament_index(
    name = "ament_index",
    data = [
        "resource/console_settings_dialog.ui",
        "resource/console_widget.ui",
        "resource/filters/custom_filter_widget.ui",
        "resource/filters/filter_wrapper_widget.ui",
        "resource/filters/list_filter_widget.ui",
        "resource/filters/text_filter_widget.ui",
        "resource/filters/time_filter_widget.ui",
        "resource/text_browse_dialog.ui",
    ] + ["plugin.xml"],
    package_xml = "package.xml",
    deps = ["@rqt_gui_py//:ament_index"],
)

### LIBRARIES

py_library(
    name = "rqt_console",
    srcs = [
        "src/rqt_console/__init__.py",
        "src/rqt_console/console.py",
        "src/rqt_console/console_settings_dialog.py",
        "src/rqt_console/console_widget.py",
        "src/rqt_console/filters/__init__.py",
        "src/rqt_console/filters/base_filter.py",
        "src/rqt_console/filters/custom_filter.py",
        "src/rqt_console/filters/custom_filter_widget.py",
        "src/rqt_console/filters/filter_collection.py",
        "src/rqt_console/filters/filter_wrapper_widget.py",
        "src/rqt_console/filters/list_filter_widget.py",
        "src/rqt_console/filters/location_filter.py",
        "src/rqt_console/filters/message_filter.py",
        "src/rqt_console/filters/node_filter.py",
        "src/rqt_console/filters/severity_filter.py",
        "src/rqt_console/filters/text_filter_widget.py",
        "src/rqt_console/filters/time_filter.py",
        "src/rqt_console/filters/time_filter_widget.py",
        "src/rqt_console/main.py",
        "src/rqt_console/message.py",
        "src/rqt_console/message_data_model.py",
        "src/rqt_console/message_list.py",
        "src/rqt_console/message_proxy_model.py",
        "src/rqt_console/text_browse_dialog.py",
    ],
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@python_qt_binding",
        "@rclpy",
        "@rqt_gui",
        "@rqt_gui_py",
        "@rqt_py_common",
    ],
)

### EXECUTABLES

py_binary(
    name = "gui",
    srcs = ["src/rqt_console/main.py"],
    main = "src/rqt_console/main.py",
    deps = [":rqt_console"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"rqt_console": "rqt_console.main:main"},
    package_xml = "package.xml",
    python = [":rqt_console"],
    python_strip_prefix = "src",
    setup_cfg = "setup.cfg",
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@python_qt_binding//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@rqt_py_common//:ament_package",
    ],
)
