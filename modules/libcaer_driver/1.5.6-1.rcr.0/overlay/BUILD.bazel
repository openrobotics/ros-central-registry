load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@camera_info_manager//:camera_info_manager": "@camera_info_manager//:camera_info_manager_library",
    "@event_camera_msgs//:cc_shared": "@event_camera_msgs//:cc",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@libcaer_vendor//:caer": "@libcaer_vendor//:caer_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@std_srvs//:cc_shared": "@std_srvs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "driver_library",
    srcs = [
        "src/device/davis.cpp",
        "src/device/device.cpp",
        "src/device/dvxplorer.cpp",
        "src/driver.cpp",
        "src/libcaer_wrapper.cpp",
        "src/message_converter.cpp",
    ],
    hdrs = [
        "include/libcaer_driver/callback_handler.hpp",
        "include/libcaer_driver/check_endian.hpp",
        "include/libcaer_driver/compression_tokens.hpp",
        "include/libcaer_driver/device/davis.hpp",
        "include/libcaer_driver/device/device.hpp",
        "include/libcaer_driver/device/dvxplorer.hpp",
        "include/libcaer_driver/device_info.hpp",
        "include/libcaer_driver/driver.hpp",
        "include/libcaer_driver/libcaer_wrapper.hpp",
        "include/libcaer_driver/logging.hpp",
        "include/libcaer_driver/message_converter.hpp",
        "include/libcaer_driver/parameter/boolean_parameter.hpp",
        "include/libcaer_driver/parameter/coarse_fine_parameter.hpp",
        "include/libcaer_driver/parameter/integer_parameter.hpp",
        "include/libcaer_driver/parameter/parameter.hpp",
        "include/libcaer_driver/parameter/ros_parameter.hpp",
        "include/libcaer_driver/parameter/shifted_source_parameter.hpp",
        "include/libcaer_driver/parameter/vdac_parameter.hpp",
        "include/libcaer_driver/resize_hack.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/libcaer_driver",
    ],
    local_defines = ros_local_defines() + [
        "IMAGE_TRANSPORT_USE_NODEINTERFACE",
        "IMAGE_TRANSPORT_USE_QOS",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "driver",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":driver_library"],
)

rclcpp_components_register_nodes(
    name = "driver_components",
    component = ":driver",
    plugins = ["libcaer_driver::Driver"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":driver"],
)

cc_binary(
    name = "driver_node",
    srcs = ["src/driver_node.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/libcaer_driver",
    ],
    local_defines = ros_local_defines() + [
        "IMAGE_TRANSPORT_USE_NODEINTERFACE",
        "IMAGE_TRANSPORT_USE_QOS",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":driver_library"],
)

ament_index(
    name = "ament_index",
    components = [":driver_components"],
    data = ["//launch:launch_files"],
    lib_data = [
        ":driver_node",
        "src/stop_recording.py",
    ],
    libraries = [":driver"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_flake8//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@camera_info_manager//:ament_package",
        "@event_camera_msgs//:ament_package",
        "@image_transport//:ament_package",
        "@libcaer_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@ros_environment//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    libraries = [":driver"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_flake8//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@camera_info_manager//:ament_package",
        "@event_camera_msgs//:ament_package",
        "@image_transport//:ament_package",
        "@libcaer_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@ros_environment//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
