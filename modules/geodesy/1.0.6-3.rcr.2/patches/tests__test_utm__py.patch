 ## A sample python unit test
 class TestUTMPoint(unittest.TestCase):
+
+    def assertGeoPointAlmostEqual(self, actual, expected, msg=None):
+        # The UTM round trip goes through PROJ, whose last-ulp results differ
+        # between platforms/libms (e.g. 30.385315000000006 vs 30.385315 on
+        # arm64), so compare the coordinates numerically rather than by str().
+        self.assertAlmostEqual(actual.latitude, expected.latitude, places=9, msg=msg)
+        self.assertAlmostEqual(actual.longitude, expected.longitude, places=9, msg=msg)
+        if math.isnan(expected.altitude):
+            self.assertTrue(math.isnan(actual.altitude), msg=msg)
+        else:
+            self.assertAlmostEqual(actual.altitude, expected.altitude, places=6, msg=msg)
 
     def test_null_constructor(self):
         pt = UTMPoint()
