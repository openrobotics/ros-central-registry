load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.h"])

cc_library(
    name = "geoconv_library",
    srcs = ["src/conv/utm_conversions.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    deps = [
        "@angles",
        "@geographic_msgs//:cc",
        "@geometry_msgs//:cc",
        "@sensor_msgs//:cc",
        "@unique_identifier_msgs//:cc",
    ],
)

cc_shared_library(
    name = "geoconv",
    exports_filter = [":geoconv_library"],
    deps = [":geoconv_library"],
)

# Upstream installs geoconv as a static archive (lib/libgeoconv.a).
filegroup(
    name = "geoconv_archive",
    srcs = [":geoconv_library"],
    output_group = "archive",
)

pkg_files(
    name = "static_library",
    srcs = [":geoconv_archive"],
    prefix = "lib",
    renames = {":geoconv_archive": "libgeoconv.a"},
)

### PYTHON MODULE

py_library(
    name = "geodesy",
    srcs = glob(["src/geodesy/**/*.py"]),
    imports = ["src"],
    deps = [
        requirement("pyproj"),
        "@geographic_msgs//:py",
        "@geometry_msgs//:py",
        "@unique_identifier_msgs//:py",
    ],
)

### TESTS

# tests/test_utm.cpp and tests/test_wgs84.cpp are not built by upstream's
# CMakeLists.txt and still target the ROS 1 message API
# (geographic_msgs::GeoPoint), so they are not ported.

[
    py_pytest(
        name = "{}_py".format(test),
        srcs = ["tests/{}.py".format(test)],
        deps = [":geodesy"],
    )
    for test in [
        "test_bounding_box",
        "test_props",
        "test_utm",
        "test_wu_point",
    ]
]

### PACKAGING

write_file(
    name = "_meta_file_0",
    out = "_gen_meta/share/geodesy/cmake/ament_cmake_export_libraries-extras.cmake",
    content = [
        "# generated from ament_cmake_export_libraries/cmake/template/ament_cmake_export_libraries.cmake.in",
        "",
        "set(_exported_libraries \"geoconv\")",
        "set(_exported_library_names \"\")",
        "",
        "# populate geodesy_LIBRARIES",
        "if(NOT _exported_libraries STREQUAL \"\")",
        "  # loop over libraries, either target names or absolute paths",
        "  list(LENGTH _exported_libraries _length)",
        "  set(_i 0)",
        "  while(_i LESS _length)",
        "    list(GET _exported_libraries ${_i} _arg)",
        "",
        "    # pass linker flags along",
        "    if(\"${_arg}\" MATCHES \"^-\" AND NOT \"${_arg}\" MATCHES \"^-[l|framework]\")",
        "      list(APPEND geodesy_LIBRARIES \"${_arg}\")",
        "      math(EXPR _i \"${_i} + 1\")",
        "      continue()",
        "    endif()",
        "",
        "    if(\"${_arg}\" MATCHES \"^(debug|optimized|general)$\")",
        "      # remember build configuration keyword",
        "      # and get following library",
        "      set(_cfg \"${_arg}\")",
        "      math(EXPR _i \"${_i} + 1\")",
        "      if(_i EQUAL _length)",
        "        message(FATAL_ERROR \"Package 'geodesy' passes the build configuration keyword '${_cfg}' as the last exported library\")",
        "      endif()",
        "      list(GET _exported_libraries ${_i} _library)",
        "    else()",
        "      # the value is a library without a build configuration keyword",
        "      set(_cfg \"\")",
        "      set(_library \"${_arg}\")",
        "    endif()",
        "    math(EXPR _i \"${_i} + 1\")",
        "",
        "    if(NOT IS_ABSOLUTE \"${_library}\")",
        "      # search for library target relative to this CMake file",
        "      set(_lib \"NOTFOUND\")",
        "      find_library(",
        "        _lib NAMES \"${_library}\"",
        "        PATHS",
        "        # This is for packages that install libraries to destinations using GNUInstallDirs variables.",
        "        \"${geodesy_DIR}/../../../lib\"",
        "        # Historically ROS packages have installed libraries to this hardcoded lib directory.",
        "        \"${geodesy_DIR}/../../../lib\"",
        "        NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH",
        "      )",
        "",
        "      if(NOT _lib)",
        "        # warn about not existing library and ignore it",
        "        message(FATAL_ERROR \"Package 'geodesy' exports the library '${_library}' which couldn't be found\")",
        "      elseif(NOT IS_ABSOLUTE \"${_lib}\")",
        "        # the found library must be an absolute path",
        "        message(FATAL_ERROR \"Package 'geodesy' found the library '${_library}' at '${_lib}' which is not an absolute path\")",
        "      elseif(NOT EXISTS \"${_lib}\")",
        "        # the found library must exist",
        "        message(FATAL_ERROR \"Package 'geodesy' found the library '${_lib}' which doesn't exist\")",
        "      else()",
        "        list(APPEND geodesy_LIBRARIES ${_cfg} \"${_lib}\")",
        "      endif()",
        "",
        "    else()",
        "      if(NOT EXISTS \"${_library}\")",
        "        # the found library must exist",
        "        message(WARNING \"Package 'geodesy' exports the library '${_library}' which doesn't exist\")",
        "      else()",
        "        list(APPEND geodesy_LIBRARIES ${_cfg} \"${_library}\")",
        "      endif()",
        "    endif()",
        "  endwhile()",
        "endif()",
        "",
        "# find_library() library names with optional LIBRARY_DIRS",
        "# and add the libraries to geodesy_LIBRARIES",
        "if(NOT _exported_library_names STREQUAL \"\")",
        "  # loop over library names",
        "  # but remember related build configuration keyword if available",
        "  list(LENGTH _exported_library_names _length)",
        "  set(_i 0)",
        "  while(_i LESS _length)",
        "    list(GET _exported_library_names ${_i} _arg)",
        "    # pass linker flags along",
        "    if(\"${_arg}\" MATCHES \"^-\" AND NOT \"${_arg}\" MATCHES \"^-[l|framework]\")",
        "      list(APPEND geodesy_LIBRARIES \"${_arg}\")",
        "      math(EXPR _i \"${_i} + 1\")",
        "      continue()",
        "    endif()",
        "",
        "    if(\"${_arg}\" MATCHES \"^(debug|optimized|general)$\")",
        "      # remember build configuration keyword",
        "      # and get following library name",
        "      set(_cfg \"${_arg}\")",
        "      math(EXPR _i \"${_i} + 1\")",
        "      if(_i EQUAL _length)",
        "        message(FATAL_ERROR \"Package 'geodesy' passes the build configuration keyword '${_cfg}' as the last exported target\")",
        "      endif()",
        "      list(GET _exported_library_names ${_i} _library)",
        "    else()",
        "      # the value is a library target without a build configuration keyword",
        "      set(_cfg \"\")",
        "      set(_library \"${_arg}\")",
        "    endif()",
        "    math(EXPR _i \"${_i} + 1\")",
        "",
        "    # extract optional LIBRARY_DIRS from library name",
        "    string(REPLACE \":\" \";\" _library_dirs \"${_library}\")",
        "    list(GET _library_dirs 0 _library_name)",
        "    list(REMOVE_AT _library_dirs 0)",
        "",
        "    set(_lib \"NOTFOUND\")",
        "    if(NOT _library_dirs)",
        "      # search for library in the common locations",
        "      find_library(",
        "        _lib",
        "        NAMES \"${_library_name}\"",
        "      )",
        "      if(NOT _lib)",
        "        # warn about not existing library and later ignore it",
        "        message(WARNING \"Package 'geodesy' exports library '${_library_name}' which couldn't be found\")",
        "      endif()",
        "    else()",
        "      # search for library in the specified directories",
        "      find_library(",
        "        _lib",
        "        NAMES \"${_library_name}\"",
        "        PATHS ${_library_dirs}",
        "        NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH",
        "      )",
        "      if(NOT _lib)",
        "        # warn about not existing library and later ignore it",
        "        message(WARNING",
        "          \"Package 'geodesy' exports library '${_library_name}' with LIBRARY_DIRS '${_library_dirs}' which couldn't be found\")",
        "      endif()",
        "    endif()",
        "    if(_lib)",
        "      list(APPEND geodesy_LIBRARIES ${_cfg} \"${_lib}\")",
        "    endif()",
        "  endwhile()",
        "endif()",
        "",
        "# TODO(dirk-thomas) deduplicate geodesy_LIBRARIES",
        "# while maintaining library order",
        "# as well as build configuration keywords",
        "# as well as linker flags",
    ],
    is_executable = False,
)

pkg_files(
    name = "meta_files_0",
    srcs = [":_meta_file_0"],
    prefix = "share/geodesy/cmake",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "angles",
        "geographic_msgs",
        "geometry_msgs",
        "sensor_msgs",
        "unique_identifier_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_targets = False,
    cmake_extras = ["ament_cmake_export_libraries-extras.cmake"],
    headers = HEADERS,
    include_prefix = "",
    install = [":static_library"] + [":meta_files_0"],
    package_xml = "package.xml",
    python = [":geodesy"],
    python_strip_prefix = "src",
    deps = [
        "@ament_cmake//:ament_package",
        "@angles//:ament_package",
        "@geographic_msgs//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@unique_identifier_msgs//:ament_package",
    ],
)
