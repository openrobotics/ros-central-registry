load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = [
    "include/geodesy/utm.h",
    "include/geodesy/wgs84.h",
]

cc_library(
    name = "geoconv_library",
    srcs = ["src/conv/utm_conversions.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    deps = [
        "@angles",
        "@geographic_msgs//:cc",
        "@geometry_msgs//:cc",
        "@sensor_msgs//:cc",
        "@unique_identifier_msgs//:cc",
    ],
)

cc_shared_library(
    name = "geoconv",
    exports_filter = ["//:__subpackages__"],
    deps = [":geoconv_library"],
)

filegroup(
    name = "geoconv_archive",
    srcs = [":geoconv_library"],
    output_group = "archive",
)

py_library(
    name = "geodesy",
    srcs = [
        "src/geodesy/__init__.py",
        "src/geodesy/bounding_box.py",
        "src/geodesy/props.py",
        "src/geodesy/utm.py",
        "src/geodesy/wu_point.py",
    ],
    imports = ["src"],
    deps = [
        requirement("pyproj"),
        "@geographic_msgs//:py",
        "@geometry_msgs//:py",
        "@unique_identifier_msgs//:py",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "angles",
        "geographic_msgs",
        "geometry_msgs",
        "sensor_msgs",
        "unique_identifier_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_targets = False,
    cmake_extras = ["ament_cmake_export_libraries-extras.cmake"],
    headers = HEADERS,
    include_prefix = "",
    package_xml = "package.xml",
    python = [":geodesy"],
    python_strip_prefix = "src",
    sonames = {"geoconv_archive": ["libgeoconv.a"]},
    deps = [
        "@ament_cmake//:ament_package",
        "@angles//:ament_package",
        "@geographic_msgs//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@unique_identifier_msgs//:ament_package",
    ],
)
