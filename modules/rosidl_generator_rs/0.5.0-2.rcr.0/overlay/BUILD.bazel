load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

exports_files(glob(["*.bzl"]))

filegroup(
    name = "interface_templates",
    srcs = glob(["resource/**/*.em"]),
)

py_library(
    name = "rosidl_generator_rs",
    srcs = glob(["rosidl_generator_rs/**/*.py"]),
    deps = [
        "@rosidl_parser",
        "@rosidl_pycommon",
    ],
)

genrule(
    name = "cli_rename",
    srcs = ["bin/rosidl_generator_rs"],
    outs = ["bin/rosidl_generator_rs.py"],
    cmd = "cp $(location :bin/rosidl_generator_rs) $(location :bin/rosidl_generator_rs.py)",
)

py_binary(
    name = "cli",
    srcs = [":bin/rosidl_generator_rs.py"],
    main = ":bin/rosidl_generator_rs.py",
    deps = [":rosidl_generator_rs"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ros_environment//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_cmake//:ament_package",
        "@rosidl_generator_c//:ament_package",
        "@rosidl_parser//:ament_package",
        "@rosidl_pycommon//:ament_package",
        "@rosidl_typesupport_c//:ament_package",
        "@rosidl_typesupport_interface//:ament_package",
    ],
)
