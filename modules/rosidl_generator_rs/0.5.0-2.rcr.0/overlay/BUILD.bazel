load("@rosdistro//ament:defs.bzl", "ament_package", "register_ament_resource")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

exports_files([
    "aspects.bzl",
    "defs.bzl",
    "types.bzl",
])

filegroup(
    name = "interface_templates",
    srcs = [
        "resource/Cargo.toml.em",
        "resource/action.rs.em",
        "resource/action/rmw.rs.em",
        "resource/build.rs.em",
        "resource/lib.rs.em",
        "resource/msg.rs.em",
        "resource/msg/rmw.rs.em",
        "resource/srv.rs.em",
        "resource/srv/rmw.rs.em",
        "resource/templates/msg_idiomatic.rs.em",
        "resource/templates/msg_rmw.rs.em",
        "resource/templates/srv_idiomatic.rs.em",
        "resource/templates/srv_rmw.rs.em",
    ],
)

py_library(
    name = "rosidl_generator_rs",
    srcs = ["rosidl_generator_rs/__init__.py"],
    deps = [
        "@rosidl_parser",
        "@rosidl_pycommon",
    ],
)

genrule(
    name = "cli_rename",
    srcs = ["bin/rosidl_generator_rs"],
    outs = ["bin/rosidl_generator_rs.py"],
    cmd = "cp $(location :bin/rosidl_generator_rs) $(location :bin/rosidl_generator_rs.py)",
)

py_binary(
    name = "cli",
    srcs = [":bin/rosidl_generator_rs.py"],
    main = ":bin/rosidl_generator_rs.py",
    deps = [":rosidl_generator_rs"],
)

# Mirrors ament_package(CONFIG_EXTRAS "rosidl_generator_rs-extras.cmake.in"): configure_file(@ONLY) of the template.
genrule(
    name = "extras_cmake",
    srcs = ["rosidl_generator_rs-extras.cmake.in"],
    outs = ["rosidl_generator_rs-extras.cmake"],
    cmd = "sed -e 's|@PROJECT_NAME@|rosidl_generator_rs|g' -e 's|@PYTHON_INSTALL_DIR@|lib/python3.14/site-packages|g' $< > $@",
)

# ament_index_register_resource() registrations, as ament_cmake installs them.

### PACKAGING

register_ament_resource(
    name = "res_rosidl_generator_packages",
    category = "rosidl_generator_packages",
    content = "",
)

ament_package(
    name = "ament_package",
    cmake = [
        ":extras_cmake",
    ] + [
        "cmake/custom_command.cmake",
        "cmake/register_rs.cmake",
        "cmake/rosidl_generator_rs_generate_interfaces.cmake",
    ],
    cmake_extras = [
        "register_rs.cmake",
        "rosidl_generator_rs-extras.cmake",
    ],
    data = [
        ":res_rosidl_generator_packages",
    ] + [
        "resource/Cargo.toml.em",
        "resource/action.rs.em",
        "resource/action/rmw.rs.em",
        "resource/build.rs.em",
        "resource/lib.rs.em",
        "resource/msg.rs.em",
        "resource/msg/rmw.rs.em",
        "resource/srv.rs.em",
        "resource/srv/rmw.rs.em",
        "resource/templates/msg_idiomatic.rs.em",
        "resource/templates/msg_rmw.rs.em",
        "resource/templates/srv_idiomatic.rs.em",
        "resource/templates/srv_rmw.rs.em",
    ],
    lib_data = ["bin/rosidl_generator_rs"],
    package_xml = "package.xml",
    python = ["rosidl_generator_rs/__init__.py"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ros_environment//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_cmake//:ament_package",
        "@rosidl_generator_c//:ament_package",
        "@rosidl_parser//:ament_package",
        "@rosidl_pycommon//:ament_package",
        "@rosidl_typesupport_c//:ament_package",
        "@rosidl_typesupport_interface//:ament_package",
    ],
)
