load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

exports_files(glob(["*.bzl"]))

filegroup(
    name = "interface_templates",
    srcs = glob(["resource/**/*.em"]),
)

py_library(
    name = "rosidl_generator_rs",
    srcs = glob(["rosidl_generator_rs/**/*.py"]),
    deps = [
        "@rosidl_parser",
        "@rosidl_pycommon",
    ],
)

genrule(
    name = "cli_rename",
    srcs = ["bin/rosidl_generator_rs"],
    outs = ["bin/rosidl_generator_rs.py"],
    cmd = "cp $(location :bin/rosidl_generator_rs) $(location :bin/rosidl_generator_rs.py)",
)

py_binary(
    name = "cli",
    srcs = [":bin/rosidl_generator_rs.py"],
    main = ":bin/rosidl_generator_rs.py",
    deps = [":rosidl_generator_rs"],
)

# Mirrors ament_package(CONFIG_EXTRAS "rosidl_generator_rs-extras.cmake.in"): configure_file(@ONLY) of the template.
genrule(
    name = "extras_cmake",
    srcs = ["rosidl_generator_rs-extras.cmake.in"],
    outs = ["rosidl_generator_rs-extras.cmake"],
    cmd = "sed -e 's|@PROJECT_NAME@|rosidl_generator_rs|g' -e 's|@PYTHON_INSTALL_DIR@|lib/python3.14/site-packages|g' $< > $@",
)

write_file(
    name = "resource_index_rosidl_generator_packages",
    out = "_resource_index/rosidl_generator_packages",
    content = [""],
)

# ament_index_register_resource() registrations, as ament_cmake installs them.
pkg_files(
    name = "resource_index",
    srcs = [
        ":resource_index_rosidl_generator_packages",
    ],
    renames = {
        ":resource_index_rosidl_generator_packages": "share/ament_index/resource_index/rosidl_generator_packages/rosidl_generator_rs",
    },
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = glob(["cmake/**"]) + [":extras_cmake"],
    cmake_extras = [
        "register_rs.cmake",
        "rosidl_generator_rs-extras.cmake",
    ],
    data = glob(["resource/**"]),
    install = [":resource_index"],
    lib_data = ["bin/rosidl_generator_rs"],
    package_xml = "package.xml",
    python = glob(["rosidl_generator_rs/**"]),
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ros_environment//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_cmake//:ament_package",
        "@rosidl_generator_c//:ament_package",
        "@rosidl_parser//:ament_package",
        "@rosidl_pycommon//:ament_package",
        "@rosidl_typesupport_c//:ament_package",
        "@rosidl_typesupport_interface//:ament_package",
    ],
)
