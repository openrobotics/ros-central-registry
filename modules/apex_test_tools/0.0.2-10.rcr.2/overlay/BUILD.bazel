load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

HEADERS = ["include/apex_test_tools/apex_test_tools.hpp"]

cc_library(
    name = "apex_test_tools",
    hdrs = HEADERS,
    includes = ["include"],
    deps = [
        "@osrf_testing_tools_cpp//:memory_tools",
        "@rosdistro//cc:googletest",
    ],
)

# Re-exported so downstream test packages (e.g. test_apex_test_tools) can
# preload memory_tools without depending on osrf_testing_tools_cpp directly,
# mirroring what apex_test_tools_add_gtest() does in CMake.
alias(
    name = "memory_tools_interpose",
    actual = "@osrf_testing_tools_cpp//:memory_tools_interpose",
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = ["cmake/apex_test_tools.cmake"] + ["apex_test_tools-extras.cmake"],
    cmake_export_interface = False,
    cmake_export_targets = False,
    cmake_extras = ["apex_test_tools-extras.cmake"],
    headers = HEADERS,
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pclint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@osrf_testing_tools_cpp//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
