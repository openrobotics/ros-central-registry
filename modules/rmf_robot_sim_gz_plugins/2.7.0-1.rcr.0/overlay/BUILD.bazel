load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
]

cc_library(
    name = "readonly_library",
    srcs = ["src/readonly.cpp"],
    hdrs = [],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines() + ["HAVE_PYBIND11"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "readonly",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":readonly_library"],
)

cc_library(
    name = "slotcar_library",
    srcs = ["src/slotcar.cpp"],
    hdrs = [],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines() + ["HAVE_PYBIND11"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "slotcar",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":slotcar_library"],
)

cc_library(
    name = "teleport_dispenser_library",
    srcs = ["src/TeleportDispenser.cpp"],
    hdrs = [],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines() + ["HAVE_PYBIND11"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "teleport_dispenser",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":teleport_dispenser_library"],
)

cc_library(
    name = "teleport_ingestor_library",
    srcs = ["src/TeleportIngestor.cpp"],
    hdrs = [],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines() + ["HAVE_PYBIND11"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "teleport_ingestor",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":teleport_ingestor_library"],
)

ament_index(
    name = "ament_index",
    lib_data = [
        ":readonly",
        ":slotcar",
        ":teleport_dispenser",
        ":teleport_ingestor",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@gz_msgs_vendor//:ament_package",
        "@gz_plugin_vendor//:ament_package",
        "@gz_rendering_vendor//:ament_package",
        "@gz_sim_vendor//:ament_package",
        "@gz_transport_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rmf_building_map_msgs//:ament_package",
        "@rmf_building_sim_gz_plugins//:ament_package",
        "@rmf_dispenser_msgs//:ament_package",
        "@rmf_fleet_msgs//:ament_package",
        "@rmf_ingestor_msgs//:ament_package",
        "@rmf_robot_sim_common//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
