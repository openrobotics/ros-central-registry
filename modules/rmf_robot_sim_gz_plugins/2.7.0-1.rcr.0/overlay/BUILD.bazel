load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@gz_msgs_vendor//:gz_msgs": "@gz_msgs_vendor//:gz_msgs_library",
    "@gz_plugin_vendor//:gz_plugin": "@gz_plugin_vendor//:gz_plugin_library",
    "@gz_rendering_vendor//:gz_rendering": "@gz_rendering_vendor//:gz_rendering_library",
    "@gz_sim_vendor//:gz_sim": "@gz_sim_vendor//:gz_sim_library",
    "@gz_transport_vendor//:gz_transport": "@gz_transport_vendor//:gz_transport_library",
    "@gz_transport_vendor//:gz_transport_log": "@gz_transport_vendor//:gz_transport_log_library",
    "@gz_transport_vendor//:gz_transport_parameters": "@gz_transport_vendor//:gz_transport_parameters_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rmf_building_map_msgs//:cc_shared": "@rmf_building_map_msgs//:cc",
    "@rmf_dispenser_msgs//:cc_shared": "@rmf_dispenser_msgs//:cc",
    "@rmf_fleet_msgs//:cc_shared": "@rmf_fleet_msgs//:cc",
    "@rmf_ingestor_msgs//:cc_shared": "@rmf_ingestor_msgs//:cc",
    "@rmf_robot_sim_common//:readonly_common": "@rmf_robot_sim_common//:readonly_common_library",
    "@rmf_robot_sim_common//:rmf_robot_sim_utils": "@rmf_robot_sim_common//:rmf_robot_sim_utils_library",
    "@rmf_robot_sim_common//:slotcar_common": "@rmf_robot_sim_common//:slotcar_common_library",
    "@rosdistro//cc:protobuf": "@rosdistro//cc:protobuf_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@gz_plugin_vendor//:gz_plugin_register_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rmf_building_sim_gz_plugins//:headers",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
    "@rosdistro//cc:spdlog",
    "@rosdistro//cc/gz:gz-math-eigen3_library",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_library(
    name = "readonly_library",
    srcs = ["src/readonly.cpp"],
    hdrs = [],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines() + ["HAVE_PYBIND11"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "readonly",
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@rmf_building_map_msgs//:cc_shared",
        "@rmf_dispenser_msgs//:cc_shared",
        "@rmf_fleet_msgs//:cc_shared",
        "@rmf_ingestor_msgs//:cc_shared",
    ],
    deps = [":readonly_library"],
)

cc_library(
    name = "slotcar_library",
    srcs = ["src/slotcar.cpp"],
    hdrs = [],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines() + ["HAVE_PYBIND11"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "slotcar",
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@rmf_building_map_msgs//:cc_shared",
        "@rmf_dispenser_msgs//:cc_shared",
        "@rmf_fleet_msgs//:cc_shared",
        "@rmf_ingestor_msgs//:cc_shared",
    ],
    deps = [":slotcar_library"],
)

cc_library(
    name = "teleport_dispenser_library",
    srcs = ["src/TeleportDispenser.cpp"],
    hdrs = [],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines() + ["HAVE_PYBIND11"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "teleport_dispenser",
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@rmf_building_map_msgs//:cc_shared",
        "@rmf_dispenser_msgs//:cc_shared",
        "@rmf_fleet_msgs//:cc_shared",
        "@rmf_ingestor_msgs//:cc_shared",
    ],
    deps = [":teleport_dispenser_library"],
)

cc_library(
    name = "teleport_ingestor_library",
    srcs = ["src/TeleportIngestor.cpp"],
    hdrs = [],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines() + ["HAVE_PYBIND11"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "teleport_ingestor",
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@rmf_building_map_msgs//:cc_shared",
        "@rmf_dispenser_msgs//:cc_shared",
        "@rmf_fleet_msgs//:cc_shared",
        "@rmf_ingestor_msgs//:cc_shared",
    ],
    deps = [":teleport_ingestor_library"],
)

ament_index(
    name = "ament_index",
    lib_data = [
        ":readonly",
        ":slotcar",
        ":teleport_dispenser",
        ":teleport_ingestor",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@gz_msgs_vendor//:ament_package",
        "@gz_plugin_vendor//:ament_package",
        "@gz_rendering_vendor//:ament_package",
        "@gz_sim_vendor//:ament_package",
        "@gz_transport_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rmf_building_map_msgs//:ament_package",
        "@rmf_building_sim_gz_plugins//:ament_package",
        "@rmf_dispenser_msgs//:ament_package",
        "@rmf_fleet_msgs//:ament_package",
        "@rmf_ingestor_msgs//:ament_package",
        "@rmf_robot_sim_common//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@gz_msgs_vendor//:ament_package",
        "@gz_plugin_vendor//:ament_package",
        "@gz_rendering_vendor//:ament_package",
        "@gz_sim_vendor//:ament_package",
        "@gz_transport_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rmf_building_map_msgs//:ament_package",
        "@rmf_building_sim_gz_plugins//:ament_package",
