load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

write_file(
    name = "gen_extra_0",
    out = "_gen/share/rqt/hook/ament_prefix_path.dsv",
    content = ["prepend-non-duplicate;AMENT_PREFIX_PATH;\n"],
)

write_file(
    name = "gen_extra_1",
    out = "_gen/share/rqt/hook/ament_prefix_path.ps1",
    content = ["# generated from colcon_powershell/shell/template/hook_prepend_value.ps1.em\n\ncolcon_prepend_unique_value AMENT_PREFIX_PATH \"$env:COLCON_CURRENT_PREFIX\"\n"],
)

write_file(
    name = "gen_extra_2",
    out = "_gen/share/rqt/hook/ament_prefix_path.sh",
    content = ["# generated from colcon_core/shell/template/hook_prepend_value.sh.em\n\n_colcon_prepend_unique_value AMENT_PREFIX_PATH \"$COLCON_CURRENT_PREFIX\"\n"],
)

pkg_files(
    name = "pkg_files_extra_0",
    srcs = [":gen_extra_0"],
    prefix = "share/rqt/hook",
)

pkg_files(
    name = "pkg_files_extra_1",
    srcs = [":gen_extra_1"],
    prefix = "share/rqt/hook",
)

pkg_files(
    name = "pkg_files_extra_2",
    srcs = [":gen_extra_2"],
    prefix = "share/rqt/hook",
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@rqt_gui//:ament_package",
        "@rqt_gui_cpp//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@rqt_py_common//:ament_package",
    ],
)

genrule(
    name = "tar",
    srcs = [":raw_tar"],
    outs = ["tar.tar.gz"],
    cmd = "tmpdir=$$(mktemp -d) && tar -xzf $(location :raw_tar) -C $$tmpdir && rm -rf $$tmpdir/opt/ros/lyrical/rqt/share/rqt/environment $$tmpdir/opt/ros/lyrical/rqt/share/rqt/hook/cmake_prefix_path* && tar -czf $@ -C $$tmpdir opt && rm -rf $$tmpdir",
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    install = [
        ":pkg_files_extra_0",
        ":pkg_files_extra_1",
        ":pkg_files_extra_2",
    ],
    package_xml = "package.xml",
    tar_name = "raw_tar",
    deps = [":ament_index"] + [
        "@rqt_gui//:ament_package",
        "@rqt_gui_cpp//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@rqt_py_common//:ament_package",
    ],
)
