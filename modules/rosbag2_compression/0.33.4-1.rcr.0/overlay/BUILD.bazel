load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/rosbag2_compression/base_compressor_interface.hpp",
        "include/rosbag2_compression/base_decompressor_interface.hpp",
        "include/rosbag2_compression/compression_factory.hpp",
        "include/rosbag2_compression/compression_options.hpp",
        "include/rosbag2_compression/sequential_compression_reader.hpp",
        "include/rosbag2_compression/sequential_compression_writer.hpp",
        "include/rosbag2_compression/visibility_control.hpp",
        "src/rosbag2_compression/compression_factory_impl.hpp",
        "src/rosbag2_compression/logging.hpp",
    ],
    includes = ["include"],
)

HEADERS = [
    "include/rosbag2_compression/base_compressor_interface.hpp",
    "include/rosbag2_compression/base_decompressor_interface.hpp",
    "include/rosbag2_compression/compression_factory.hpp",
    "include/rosbag2_compression/compression_options.hpp",
    "include/rosbag2_compression/sequential_compression_reader.hpp",
    "include/rosbag2_compression/sequential_compression_writer.hpp",
    "include/rosbag2_compression/visibility_control.hpp",
]

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

cc_library(
    name = "rosbag2_compression_library",
    srcs = [
        "src/rosbag2_compression/compression_factory.cpp",
        "src/rosbag2_compression/compression_factory_impl.hpp",
        "src/rosbag2_compression/compression_options.cpp",
        "src/rosbag2_compression/logging.hpp",
        "src/rosbag2_compression/sequential_compression_reader.cpp",
        "src/rosbag2_compression/sequential_compression_writer.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rosbag2_compression",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rosbag2_compression_library"],
)

TEST_DEPENDENCIES = DEPENDENCIES | {
    ":rosbag2_compression": ":rosbag2_compression_library",
    "@rosbag2_test_common": "@rosbag2_test_common//:rosbag2_test_common_library",
}

ament_index(
    name = "ament_index",
    export_name = "rosbag2_compression",
    libraries = ["//test:fake_plugin"],
    package_xml = "package.xml",
    plugins = ["//test:rosbag2_compression/fake_plugin.xml"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
)

ament_package(
    name = "ament_package",
    cmake_export_name = "export_rosbag2_compression",
    headers = HEADERS,
    libraries = [
        ":rosbag2_compression",
        "//test:fake_plugin",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_test_common//:ament_package",
        "@rosdistro//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
