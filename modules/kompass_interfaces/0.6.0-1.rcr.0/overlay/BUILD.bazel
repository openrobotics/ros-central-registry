load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

### PACKAGING

default_generators(
    dependencies = [
        "@geometry_msgs",
        "@nav_msgs",
        "@std_msgs",
    ],
    package_xml = "package.xml",
    deps = [
        "//action:ControlPath",
        "//action:FollowPath",
        "//action:IntelligentRest",
        "//action:MotionRecording",
        "//action:PlanPath",
        "//action:TrackPath",
        "//action:TrackVisionTarget",
        "//msg/map:Obstacles",
        "//msg/motion:FollowPathRequest",
        "//msg/motion:MotionStatus",
        "//msg/motion:PathTrackingError",
        "//msg/motion:PathTrackingErrorArray",
        "//msg/motion:TwistArray",
        "//msg/motion:VectorArray",
        "//msg/prediction:PredictedOccupancies",
        "//msg/prediction:PredictedTrajectories",
        "//srv/control:StopVisionTracking",
        "//srv/mapping:Save2dMapToFile",
        "//srv/mapping:Save3dMapToFile",
        "//srv/motion:GetCmdList",
        "//srv/motion:PathFromToFile",
        "//srv/motion:PlanPath",
        "//srv/motion:StartPathRecording",
        "//srv/prediction:GetPredictedOccupancies",
        "//srv/prediction:GetPredictedTrajectories",
    ],
)

rosidl_ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@action_msgs//:ament_package",
        "@ament_cmake//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
