load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

exports_files([
    "resources/empty_bag/empty_bag_0.db3",
    "resources/empty_bag/empty_bag_0.db3-shm",
    "resources/empty_bag/empty_bag_0.db3-wal",
    "resources/empty_bag/metadata.yaml",
    "resources/incomplete_qos_duration.yaml",
    "resources/incomplete_qos_profile.yaml",
    "resources/qos_profile.yaml",
    "test_api.py",
    "test_burst.py",
    "test_cli_extension.py",
    "test_copyright.py",
    "test_flake8.py",
    "test_info.py",
    "test_pep257.py",
    "test_play_qos_profiles.py",
    "test_record.py",
    "test_record_qos_profiles.py",
    "test_record_with_compression_thread_priority.py",
    "test_recorder_args_parser.py",
    "test_xmllint.py",
])

[py_pytest(
    name = test.removesuffix(".py"),
    srcs = ["{0}.py".format(test)],
    data = [
        "resources/empty_bag/empty_bag_0.db3",
        "resources/empty_bag/empty_bag_0.db3-shm",
        "resources/empty_bag/empty_bag_0.db3-wal",
        "resources/empty_bag/metadata.yaml",
        "resources/incomplete_qos_duration.yaml",
        "resources/incomplete_qos_profile.yaml",
        "resources/qos_profile.yaml",
    ],
    deps = [
        "//:ros2",
        "//:ros2bag",
        "@rclpy",
    ],
) for test in [
    "test_api",
    "test_recorder_args_parser",
]]

launch_ros_test(
    name = "test_burst",
    src = "test_burst.py",
    data = [
        "resources/empty_bag/empty_bag_0.db3",
        "resources/empty_bag/empty_bag_0.db3-shm",
        "resources/empty_bag/empty_bag_0.db3-wal",
        "resources/empty_bag/metadata.yaml",
        "resources/incomplete_qos_duration.yaml",
        "resources/incomplete_qos_profile.yaml",
        "resources/qos_profile.yaml",
    ] + ["//:ament_index"],
    env = {"PATH": "../ros2bag+:/usr/local/bin:/usr/bin:/bin"},
    deps = [
        "//:ros2",
        "//:ros2bag",
        "@rclpy",
        "@rosbag2_test_common//:rosbag2_test_common_py",
    ],
)

