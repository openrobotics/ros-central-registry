load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = ["@rosbag2_storage_default_plugins//:ament_index"],
)

py_binary(
    name = "setup",
    srcs = ["setup.py"],
    deps = [requirement("setuptools")],
)

genrule(
    name = "entry_points",
    srcs = [
        "CHANGELOG.rst",
        "package.xml",
        "pytest.ini",
        "resource/ros2bag",
        "ros2bag/__init__.py",
        "ros2bag/api/__init__.py",
        "ros2bag/command/__init__.py",
        "ros2bag/command/bag.py",
        "ros2bag/verb/__init__.py",
        "ros2bag/verb/burst.py",
        "ros2bag/verb/convert.py",
        "ros2bag/verb/info.py",
        "ros2bag/verb/list.py",
        "ros2bag/verb/play.py",
        "ros2bag/verb/record.py",
        "ros2bag/verb/reindex.py",
        "setup.py",
    ],
    outs = [
        "ros2bag.egg-info/PKG-INFO",
        "ros2bag.egg-info/entry_points.txt",
        "ros2bag.egg-info/top_level.txt",
    ],
    cmd = "$(location :setup) egg_info --egg-base=. && mkdir -p $(@D)/ros2bag.egg-info && cp -r ros2bag.egg-info/* $(@D)/ros2bag.egg-info/",
    tools = [":setup"],
)

py_library(
    name = "ros2bag",
    srcs = [
        "ros2bag/__init__.py",
        "ros2bag/api/__init__.py",
        "ros2bag/command/__init__.py",
        "ros2bag/command/bag.py",
        "ros2bag/verb/__init__.py",
        "ros2bag/verb/burst.py",
        "ros2bag/verb/convert.py",
        "ros2bag/verb/info.py",
        "ros2bag/verb/list.py",
        "ros2bag/verb/play.py",
        "ros2bag/verb/record.py",
        "ros2bag/verb/reindex.py",
    ],
    data = [
        ":ament_index",
        ":entry_points",
    ],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@rclpy",
        "@ros2cli",
        "@rosbag2_py",
        "@rosbag2_storage_default_plugins//:rosbag2_storage_default_plugins_py",
        requirement("pyyaml"),
    ],
)

write_file(
    name = "ros2_main",
    out = "ros2_main.py",
    content = [
        "import sys",
        "from ros2cli.cli import main",
        "if __name__ == '__main__':",
        "    sys.argv[0] = 'ros2'",
        "    sys.exit(main())",
    ],
)

py_binary(
    name = "ros2",
    srcs = [":ros2_main"],
    main = ":ros2_main.py",
    deps = [
        ":ros2bag",
        "@ros2cli",
        requirement("packaging"),
    ],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "package.xml",
        "pytest.ini",
        "resource/ros2bag",
        "ros2bag/__init__.py",
        "ros2bag/api/__init__.py",
        "ros2bag/command/__init__.py",
        "ros2bag/command/bag.py",
        "ros2bag/verb/__init__.py",
        "ros2bag/verb/burst.py",
        "ros2bag/verb/convert.py",
        "ros2bag/verb/info.py",
        "ros2bag/verb/list.py",
        "ros2bag/verb/play.py",
        "ros2bag/verb/record.py",
        "ros2bag/verb/reindex.py",
        "setup.py",
    ] + [":ament_index"],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
    "xmllint",
]]

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":ros2bag"],
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclpy//:ament_package",
        "@ros2cli//:ament_package",
        "@rosbag2_py//:ament_package",
        "@rosbag2_storage_default_plugins//:ament_package",
        "@rosbag2_test_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
