load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_qt//:qt.bzl", "qt_cc_library", "qt_ui_library")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

DEPENDENCIES = {
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
}

genrule(
    name = "image_view_rename",
    srcs = ["src/rqt_image_view/image_view.ui"],
    outs = ["image_view.ui"],
    cmd = "cp $(location :src/rqt_image_view/image_view.ui) $(location :image_view.ui)",
)

qt_ui_library(
    name = "image_view",
    ui = "image_view.ui",
    deps = ["@rules_qt//:qt_widgets"],
)

qt_cc_library(
    name = "rqt_image_view_library",
    srcs = [
        "src/rqt_image_view/image_view.cpp",
        "src/rqt_image_view/ratio_layouted_frame.cpp",
    ],
    hdrs = [
        "include/rqt_image_view/image_view.hpp",
        "include/rqt_image_view/ratio_layouted_frame.hpp",
    ],
    includes = [
        ".",
        "include",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":image_view",
        "@geometry_msgs//:cc",
        "@qt_gui_cpp",
        "@rqt_gui_cpp",
        "@rules_qt//:qt_widgets",
        "@sensor_msgs//:cc",
    ],
)

cc_shared_library(
    name = "rqt_image_view",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rqt_image_view_library"],
    deps = [":rqt_image_view_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rqt_image_view"],
    visibility = ["//visibility:private"],
)

### DATA

genrule(
    name = "qt_gui_resource",
    outs = ["share/ament_index/resource_index/qt_gui/rqt_image_view"],
    cmd = "echo 'plugin.xml' > $@",
)

ament_index(
    name = "ament_index",
    data = glob(["resource/**"]),
    libraries = [":transitive_dynamic_deps"],
    package_xml = "package.xml",
    plugins = ["plugin.xml"],
    deps = ["@rqt_gui_cpp//:ament_index"],
)

### EXECUTABLES

