genrule(
    name = "gui_rename",
    srcs = ["scripts/rqt_image_view"],
    outs = ["scripts/rqt_image_view.py"],
    cmd = "cp $(location :scripts/rqt_image_view) $(location :scripts/rqt_image_view.py)",
)

py_binary(
    name = "gui",
    srcs = ["scripts/rqt_image_view.py"],
    args = ["--force-discover"],
    data = [
        ":ament_index",
        ":qt_gui_resource",
    ],
    main = "scripts/rqt_image_view.py",
    deps = ["@rqt_gui"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@geometry_msgs//:ament_package",
        "@image_transport//:ament_package",
        "@qt_gui_cpp//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_cpp//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
