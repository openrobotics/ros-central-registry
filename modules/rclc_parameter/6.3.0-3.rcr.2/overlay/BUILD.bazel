load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

PUBLIC_HEADERS = glob(["include/**/*.h"])

HEADERS = PUBLIC_HEADERS + glob(["src/**/*.h"])

DEPENDENCIES = {
    "@rcl//:rcl": "@rcl//:rcl_library",
    "@rclc//:rclc": "@rclc//:rclc_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

cc_library(
    name = "rclc_parameter_library",
    srcs = glob(["src/**/*.c"]),
    hdrs = HEADERS,
    defines = ["RCLC_PARAMETER_MAX_STRING_LENGTH=50"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rclc_parameter",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rclc_parameter_library"],
    deps = [":rclc_parameter_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rclc_parameter"],
    visibility = ["//visibility:private"],
)

### TESTING

cc_test(
    name = "rclc_parameter_test",
    srcs = ["test/rclc_parameter/test_parameter.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["src/rcl"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":rclc_parameter_library",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "ament_cmake",
        "rcl",
        "rclc",
        "rcutils",
        "builtin_interfaces",
    ],
    headers = PUBLIC_HEADERS,
    include_prefix = "",
    libraries = [":rclc_parameter"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@example_interfaces//:ament_package",
        "@osrf_testing_tools_cpp//:ament_package",
        "@rcl//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclc//:ament_package",
        "@rclcpp//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
