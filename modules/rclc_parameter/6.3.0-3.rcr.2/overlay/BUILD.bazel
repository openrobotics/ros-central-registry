load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/rclc_parameter/rclc_parameter.h",
        "include/rclc_parameter/visibility_control.h",
        "src/rclc_parameter/parameter_utils.h",
    ],
    includes = ["src/rcl"],
)

PUBLIC_HEADERS = [
    "include/rclc_parameter/rclc_parameter.h",
    "include/rclc_parameter/visibility_control.h",
]

HEADERS = PUBLIC_HEADERS + ["src/rclc_parameter/parameter_utils.h"]

DEPENDENCIES = {
    "@rcl//:rcl": "@rcl//:rcl_library",
    "@rclc//:rclc": "@rclc//:rclc_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
}

cc_library(
    name = "rclc_parameter_library",
    srcs = [
        "src/rclc_parameter/parameter_server.c",
        "src/rclc_parameter/parameter_utils.c",
    ],
    hdrs = HEADERS,
    defines = ["RCLC_PARAMETER_MAX_STRING_LENGTH=50"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rclc_parameter",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rclc_parameter_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rclc_parameter"],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "ament_cmake",
        "builtin_interfaces",
        "rcl",
        "rclc",
        "rcutils",
    ],
    headers = PUBLIC_HEADERS,
    include_prefix = "",
    libraries = [":rclc_parameter"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@example_interfaces//:ament_package",
        "@osrf_testing_tools_cpp//:ament_package",
        "@rcl//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclc//:ament_package",
        "@rclcpp//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
