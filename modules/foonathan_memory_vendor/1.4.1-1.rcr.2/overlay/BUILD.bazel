load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "cc_public_headers")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

cc_library(
    name = "foonathan_memory-0.7.4_library",
    defines = [
        "FOONATHAN_MEMORY=1",
        "FOONATHAN_MEMORY_VERSION_MAJOR=0",
        "FOONATHAN_MEMORY_VERSION_MINOR=7",
        "FOONATHAN_MEMORY_VERSION_PATCH=4",
    ],
    deps = [
        "@rosdistro//cc:foonathan_memory_library",
    ],
)

cc_public_headers(
    name = "foonathan_memory_headers",
    extensions = [".hpp"],
    prefix = "include/",
    deps = ["@rosdistro//cc:foonathan_memory_library"],
)

genrule(
    name = "static_foonathan_memory-0.7.4_a",
    srcs = ["@rosdistro//cc:foonathan_memory_library"],
    outs = ["libfoonathan_memory-0.7.4.a"],
    cmd = "for f in $(SRCS); do case $$f in *.a) cp $$f $@; exit 0;; esac; done; ar rcs $@",
)

register_ament_files(
    name = "ament_files_0",
    files = [
        "LICENSE",
    ],
    prefix = "share/foonathan_memory",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_1",
    files = [
        "README.md",
    ],
    prefix = "share/foonathan_memory",
    strip_prefix = "*",
)

ament_index(
    name = "ament_index",
    data = [
        ":ament_files_0",
        ":ament_files_1",
    ],
    libraries = [
        ":static_foonathan_memory-0.7.4_a",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_test//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [":foonathan_memory_headers"],
    include_prefix = "",
    libraries = [
        ":static_foonathan_memory-0.7.4_a",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_test//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
    ],
)
