load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@leo_msgs//:cc",
    "@nav_msgs//:cc",
    "@rcl_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
    "@std_srvs//:cc",
]

cc_library(
    name = "leo_fw_library",
    srcs = ["src/firmware_message_converter.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "leo_fw",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":leo_fw_library"],
)

rclcpp_components_register_node(
    name = "firmware_message_converter",
    component = ":leo_fw",
    node_name = "firmware_message_converter",
    plugin = "leo_fw::FirmwareMessageConverter",
)

py_library(
    name = "leo_fw_py",
    srcs = glob(["leo_fw/**/*.py"]),
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@geometry_msgs//:py",
        "@leo_msgs//:py",
        "@nav_msgs//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@ros2cli",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        "@std_srvs//:py",
    ],
)

ament_index(
    name = "ament_index",
    components = [":firmware_message_converter_record"],
    data = [
        "data/default_firmware_params.yaml",
        "data/firmware_binaries/core2_firmware.bin",
        "data/firmware_binaries/leocore_firmware.bin",
        "data/hw_tests/battery.yaml",
        "data/hw_tests/encoder.yaml",
        "data/hw_tests/encoder_load.yaml",
        "data/hw_tests/imu.yaml",
        "data/hw_tests/torque.yaml",
        "data/hw_tests/torque_load.yaml",
    ],
    lib_data = [
        ":firmware_message_converter",
        "scripts/firmware_parameter_bridge",
        "scripts/flash",
        "scripts/test_hw",
        "scripts/update",
    ],
    libraries = [
        ":leo_fw",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_black//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_mypy//:ament_package",
        "@ament_cmake_pep257//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@geometry_msgs//:ament_package",
        "@leo_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclpy//:ament_package",
        "@ros2cli//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    libraries = [
        ":leo_fw",
    ],
    package_xml = "package.xml",
    python = [":leo_fw_py"],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_black//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_mypy//:ament_package",
        "@ament_cmake_pep257//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@geometry_msgs//:ament_package",
        "@leo_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclpy//:ament_package",
        "@ros2cli//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
