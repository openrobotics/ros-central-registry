load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

# TODO: mrpt_libhwdrivers (MRPT 2.15) uses CMake ExternalProject_Add to clone MRPT from GitHub at build time; superseded by native MRPT 3.3.1 modules.

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@mrpt_libgui//:ament_package",
        "@mrpt_libmaps//:ament_package",
        "@mrpt_libslam//:ament_package",
    ],
)

ament_package(
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@mrpt_libgui//:ament_package",
        "@mrpt_libmaps//:ament_package",
        "@mrpt_libslam//:ament_package",
    ],
)
