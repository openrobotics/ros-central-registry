load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "auto_apms_ros2behavior",
    srcs = [
        "auto_apms_ros2behavior/__init__.py",
        "auto_apms_ros2behavior/api/__init__.py",
        "auto_apms_ros2behavior/command/__init__.py",
        "auto_apms_ros2behavior/command/behavior.py",
        "auto_apms_ros2behavior/verb/__init__.py",
        "auto_apms_ros2behavior/verb/list.py",
        "auto_apms_ros2behavior/verb/node/__init__.py",
        "auto_apms_ros2behavior/verb/node/call.py",
        "auto_apms_ros2behavior/verb/node/manifest.py",
        "auto_apms_ros2behavior/verb/node/model.py",
        "auto_apms_ros2behavior/verb/node/plugins.py",
        "auto_apms_ros2behavior/verb/run.py",
        "auto_apms_ros2behavior/verb/send.py",
        "auto_apms_ros2behavior/verb/show.py",
    ],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@auto_apms_interfaces//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@ros2cli",
        "@ros2param",
        "@ros2run",
        "@std_srvs//:py",
        requirement("argcomplete"),
        requirement("pyyaml"),
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":auto_apms_ros2behavior"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_index_python//:ament_package",
        "@auto_apms_behavior_tree//:ament_package",
        "@auto_apms_interfaces//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@ros2cli//:ament_package",
        "@ros2param//:ament_package",
        "@ros2run//:ament_package",
        "@rosdistro//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
