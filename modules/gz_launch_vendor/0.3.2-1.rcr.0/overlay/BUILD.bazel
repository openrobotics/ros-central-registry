load("@rosdistro//ament:ament_resource.bzl", "register_ament_resource")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

register_ament_resource(
    name = "res_vendor_packages",
    category = "vendor_packages",
    content = "",
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        ":res_vendor_packages",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_test//:ament_package",
        "@ament_cmake_vendor_package//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@gz_cmake_vendor//:ament_package",
        "@gz_common_vendor//:ament_package",
        "@gz_gui_vendor//:ament_package",
        "@gz_math_vendor//:ament_package",
        "@gz_msgs_vendor//:ament_package",
        "@gz_plugin_vendor//:ament_package",
        "@gz_sim_vendor//:ament_package",
        "@gz_tools_vendor//:ament_package",
        "@gz_transport_vendor//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "gz_cmake_vendor",
        "gz_common_vendor",
        "gz_gui_vendor",
        "gz_math_vendor",
        "gz_msgs_vendor",
        "gz_plugin_vendor",
        "gz_sim_vendor",
        "gz_tools_vendor",
        "gz_transport_vendor",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        ":res_vendor_packages",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_test//:ament_package",
        "@ament_cmake_vendor_package//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@gz_cmake_vendor//:ament_package",
        "@gz_common_vendor//:ament_package",
        "@gz_gui_vendor//:ament_package",
        "@gz_math_vendor//:ament_package",
        "@gz_msgs_vendor//:ament_package",
        "@gz_plugin_vendor//:ament_package",
        "@gz_sim_vendor//:ament_package",
        "@gz_tools_vendor//:ament_package",
        "@gz_transport_vendor//:ament_package",
    ],
)
