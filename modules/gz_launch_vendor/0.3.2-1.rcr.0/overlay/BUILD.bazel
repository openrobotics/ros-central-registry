ge_required} COMPONENTS gui)\nfind_package(gz-fuel_tools 11 ${gz_package_quiet} ${gz_package_required})\n# --------------------------------\n\n\n####### Expanded from @PACKAGE_INIT@ by configure_package_config_file() #######\n####### Any changes to this file will be overwritten by the next CMake run ####\n####### The input file was gz-config.cmake.in                            ########\n\nget_filename_component(PACKAGE_PREFIX_DIR \"${CMAKE_CURRENT_LIST_DIR}/../../../\" ABSOLUTE)\n\nmacro(set_and_check _var _file)\n  set(${_var} \"${_file}\")\n  if(NOT EXISTS \"${_file}\")\n    message(FATAL_ERROR \"File or directory ${_file} referenced by variable ${_var} does not exist !\")\n  endif()\nendmacro()\n\nmacro(check_required_components _NAME)\n  foreach(comp ${${_NAME}_FIND_COMPONENTS})\n    if(NOT ${_NAME}_${comp}_FOUND)\n      if(${_NAME}_FIND_REQUIRED_${comp})\n        set(${_NAME}_FOUND FALSE)\n      endif()\n    endif()\n  endforeach()\nendmacro()\n\n####################################################################################\n\nif(NOT TARGET gz-launch::gz-launch)\n  include(\"${CMAKE_CURRENT_LIST_DIR}/gz-launch-targets.cmake\")\n\n  # Create a simplified imported target name for the core library.\n  # You can link to this target instead of the core library.\n  add_library(gz-launch::core INTERFACE IMPORTED)\n  set_target_properties(gz-launch::core PROPERTIES\n    INTERFACE_LINK_LIBRARIES gz-launch::gz-launch)\n  # Note: In a future version of cmake, we can replace this with an ALIAS target\n\n  # In case someone tries to link against the plain library name, we want to\n  # intercept that and have them link against a target instead. This is\n  # effectively the same as gz-launch::core, but it does not have the\n  # benefit of unambiguously being a target name.\n  add_library(gz-launch INTERFACE IMPORTED)\n  set_target_properties(gz-launch PROPERTIES\n    INTERFACE_LINK_LIBRARIES gz-launch::gz-launch)\n\nendif()\n\n# Create the \"all\" target if it does not already exist\nif(NOT TARGET gz-launch::requested)\n  add_library(gz-launch::requested INTERFACE IMPORTED)\nendif()\n\n# Link the core library to the \"all\" target. We set the property explicitly\n# because target_link_libraries cannot be called on an imported target.\nget_target_property(gz_all_components gz-launch::requested INTERFACE_LINK_LIBRARIES)\nif(NOT gz_all_components)\n  # If gz-launch::requested has not been given any libraries yet, then cmake will\n  # set gz_all_components to gz_all_components-NOTFOUND, which is something we\n  # should NOT pass into the INTERFACE_LINK_LIBRARIES property.\n  set_target_properties(gz-launch::requested PROPERTIES\n    INTERFACE_LINK_LIBRARIES \"gz-launch::gz-launch\")\nelse()\n  set_target_properties(gz-launch::requested PROPERTIES\n    INTERFACE_LINK_LIBRARIES \"${gz_all_components};gz-launch::gz-launch\")\nendif()\n\n# Package variables. Note that gz-launch_LIBRARIES and gz-launch_CORE_LIBRARY\n# contain imported targets, so gz-launch_INCLUDE_DIRS is never needed.\nset(gz-launch_CORE_LIBRARY gz-launch::core)\nset(gz-launch_LIBRARIES gz-launch::requested)\n\nif (NOT gz-launch_INCLUDE_DIRS_OVERRIDE)\n  set_and_check(gz-launch_INCLUDE_DIRS \"${PACKAGE_PREFIX_DIR}/include/gz/launch9\")\nelse()\n  set_and_check(gz-launch_INCLUDE_DIRS ${gz-launch_INCLUDE_DIRS_OVERRIDE})\nendif()\n\n# Backwards compatibility variables\nset(GZ-LAUNCH_LIBRARIES ${gz-launch_LIBRARIES})\nset(GZ-LAUNCH_INCLUDE_DIRS ${gz-launch_INCLUDE_DIRS})\n\n# This macro is used by gz-cmake to automatically configure the pkgconfig\n# files for Gazebo projects.\ngz_pkg_config_entry(gz-launch \"gz-launch\")\n\n# Find each of the components requested by find_package(~)\nforeach(component ${gz-launch_FIND_COMPONENTS})\n\n  if(NOT gz-launch_FIND_QUIETLY)\n    message(STATUS \"Searching for <gz-launch> component [${component}]\")\n  endif()\n\n  if(gz-launch_FIND_REQUIRED_${component})\n\n    # Find the component package using find_dependency(~). If the user specified\n    # REQUIRED or QUIET, those will automatically get forwarded to\n    # find_dependency(~)\n    find_dependency(gz-launch-${component} 9.0.1 EXACT)\n\n  else()\n\n    # If this is an optional component, use find_package(~) instead of\n    # find_dependency(~) so we can ensure that the use of REQUIRED does not get\n    # forwarded to it.\n    find_package(gz-launch-${component} 9.0.1 EXACT ${gz_package_quiet})\n\n  endif()\n\nendforeach()\n\n# Specify the doxygen tag file\nset(GZ-LAUNCH_DOXYGEN_TAGFILE \"${PACKAGE_PREFIX_DIR}/share/gz/gz-launch/gz-launch.tag.xml\")\n\n# Specify the API url. This is where the doxygen tag file will resolve URLS to.\nset(GZ-LAUNCH_API_URL \"https://gazebosim.org/api/launch/9\")\n\n# include all config extra files\nset(_extras \"\")\nforeach(_extra ${_extras})\n  include(\"${gz-launch_DIR}/${_extra}\")\nendforeach()\n"],
