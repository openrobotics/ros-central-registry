load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
]

cc_library(
    name = "bag2_to_image_library",
    srcs = ["src/bag2_to_image.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/bag2_to_image",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "bag2_to_image",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":bag2_to_image_library"],
)

rclcpp_components_register_node(
    name = "bag2_to_image_exe",
    component = ":bag2_to_image",
    node_name = "bag2_to_image_exe",
    plugin = "bag2_to_image::Bag2ToImageNode",
)

pkg_files(
    name = "pkg_files_inc_0",
    srcs = ["include/bag2_to_image/bag2_to_image.hpp"],
    prefix = "include/bag2_to_image/include/bag2_to_image",
)

ament_index(
    name = "ament_index",
    components = [":bag2_to_image_exe_record"],
    lib_data = [":bag2_to_image_exe"],
    libraries = [":bag2_to_image"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "OpenCV",
        "rclcpp",
        "rclcpp_components",
        "rosbag2_cpp",
        "rosbag2_storage",
        "sensor_msgs",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    install = [":pkg_files_inc_0"],
    libraries = [":bag2_to_image"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
