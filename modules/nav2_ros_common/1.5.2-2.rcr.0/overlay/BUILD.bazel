load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@bondcpp//:bondcpp": "@bondcpp//:bondcpp_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

cc_library(
    name = "nav2_ros_common",
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values() + [
        "@builtin_interfaces//:cc",
        "@geometry_msgs//:cc",
        "@lifecycle_msgs//:cc",
        "@map_msgs//:cc",
        "@nav2_msgs//:cc",
        "@nav_msgs//:cc",
        "@rcl_interfaces//:cc",
        "@sensor_msgs//:cc",
        "@std_msgs//:cc",
    ],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

[
    cc_test(
        name = test,
        srcs = ["test/{}.cpp".format(test)],
        dynamic_deps = [":transitive_dynamic_deps"],
        deps = [
            ":nav2_ros_common",
            "@rosdistro//cc:googletest",
            "@std_srvs//:cc",
            "@test_msgs//:cc",
        ],
    )
    for test in [
        "test_node_utils",
        "test_service_client",
        "test_service_server",
        "test_actions",
        "test_lifecycle_node",
        "test_validation_messages",
    ]
]

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "bondcpp",
        "geometry_msgs",
        "nav2_msgs",
        "nav_msgs",
        "map_msgs",
        "rclcpp",
        "rclcpp_action",
        "rclcpp_lifecycle",
        "sensor_msgs",
        "tf2",
        "tf2_geometry_msgs",
        "tf2_ros",
        "pluginlib",
        "ament_index_cpp",
    ],
    headers = HEADERS,
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@backward_ros//:ament_package",
        "@bond//:ament_package",
        "@bondcpp//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@map_msgs//:ament_package",
        "@nav2_common//:ament_package",
        "@nav2_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@test_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
