load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

[cc_test(
    name = test.removesuffix(".py"),
    srcs = ["{}.cpp".format(test)],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    deps = [
        "//:nav2_ros_common",
        "@rosdistro//cc:googletest",
        "@std_srvs//:cc",
        "@test_msgs//:cc",
    ],
) for test in [
    "test_node_utils",
    "test_service_client",
    "test_service_server",
    "test_actions",
    "test_lifecycle_node",
    "test_validation_messages",
]]
