load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

py_library(
    name = "crazyflie_examples",
    srcs = [
        "crazyflie_examples/__init__.py",
        "crazyflie_examples/arming.py",
        "crazyflie_examples/cmd_full_state.py",
        "crazyflie_examples/figure8.py",
        "crazyflie_examples/goto_unicast.py",
        "crazyflie_examples/group_mask.py",
        "crazyflie_examples/hello_world.py",
        "crazyflie_examples/infinite_flight.py",
        "crazyflie_examples/multi_trajectory.py",
        "crazyflie_examples/nice_hover.py",
        "crazyflie_examples/set_param.py",
        "crazyflie_examples/simple_mapper_multiranger.py",
        "crazyflie_examples/swap.py",
        "crazyflie_examples/vel_mux.py",
    ],
    data = [
        "crazyflie_examples/data/figure8.csv",
        "crazyflie_examples/data/multi_trajectory/traj0.csv",
        "crazyflie_examples/data/multi_trajectory/traj1.csv",
    ],
    imports = ["."],
    deps = [
        "@crazyflie_py",
        "@geometry_msgs//:py",
        "@nav_msgs//:py",
        "@rclpy",
        "@sensor_msgs//:py",
        "@tf_transformations",
    ],
)

register_ament_files(
    name = "ament_files_0",
    files = [
        "crazyflie_examples/data/figure8.csv",
        "crazyflie_examples/data/multi_trajectory/traj0.csv",
        "crazyflie_examples/data/multi_trajectory/traj1.csv",
    ],
    prefix = "lib/python3.12/site-packages",
)

ament_index(
    name = "ament_index",
    data = [":ament_files_0"] + ([
        "config/nav2_params.yaml",
        "config/nav2_view.rviz",
        "config/slam_params.yaml",
        "data/map.data",
        "data/map.pgm",
        "data/map.posegraph",
        "data/map.yaml",
    ] + ["//launch:launch_files"]),
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    build_type = "ament_cmake",
    cmake_export_dependencies = False,
    console_scripts = {
        "arming": "crazyflie_examples.arming:main",
        "cmd_full_state": "crazyflie_examples.cmd_full_state:main",
        "figure8": "crazyflie_examples.figure8:main",
        "goto_unicast": "crazyflie_examples.goto_unicast:main",
        "group_mask": "crazyflie_examples.group_mask:main",
        "hello_world": "crazyflie_examples.hello_world:main",
        "infinite_flight": "crazyflie_examples.infinite_flight:main",
        "multi_trajectory": "crazyflie_examples.multi_trajectory:main",
        "nice_hover": "crazyflie_examples.nice_hover:main",
        "set_param": "crazyflie_examples.set_param:main",
        "simple_mapper_multiranger": "crazyflie_examples.simple_mapper_multiranger:main",
        "swap": "crazyflie_examples.swap:main",
        "vel_mux": "crazyflie_examples.vel_mux:main",
    },
    data = [
        "config/nav2_params.yaml",
        "config/nav2_view.rviz",
        "config/slam_params.yaml",
        "data/map.data",
        "data/map.pgm",
        "data/map.posegraph",
        "data/map.yaml",
    ] + ["//launch:launch_files"],
    package_xml = "package.xml",
    python = [":crazyflie_examples"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@crazyflie_py//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@tf_transformations//:ament_package",
    ],
)
