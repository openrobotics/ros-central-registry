load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "keyboard_velmux_launch.py",
        "launch.py",
        "multiranger_mapping_launch.py",
        "multiranger_nav2_launch.py",
        "multiranger_simple_mapper_launch.py",
    ],
)

launch_ros_binary(
    name = "keyboard_velmux_launch",
    src = "keyboard_velmux_launch.py",
    data = [
        "//:ament_index",
        "@crazyflie//:ament_index",
    ],
    deps = [
        "//:crazyflie_examples",
        "@ament_index_python",
    ],
)

launch_ros_binary(
    name = "launch_launch",
    src = "launch.py",
    data = [
        "//:ament_index",
        "@crazyflie//:ament_index",
    ],
    deps = [
        "//:crazyflie_examples",
        "@ament_index_python",
    ],
)

launch_ros_binary(
    name = "multiranger_mapping_launch",
    src = "multiranger_mapping_launch.py",
    data = [
        "//:ament_index",
        "@crazyflie//:ament_index",
        "@slam_toolbox//:ament_index",
        "@slam_toolbox//:ament_index_extra",
        "@slam_toolbox//:async_slam_toolbox_node",
    ],
    deps = [
        "//:crazyflie_examples",
        "@ament_index_python",
    ],
)

launch_ros_binary(
    name = "multiranger_nav2_launch",
    src = "multiranger_nav2_launch.py",
    data = [
        "//:ament_index",
        "@crazyflie//:ament_index",
        "@nav2_bringup//:ament_index",
        "@rclcpp_components//:ament_index",
        "@slam_toolbox//:ament_index",
        "@slam_toolbox//:ament_index_extra",
        "@slam_toolbox//:async_slam_toolbox_node",
    ],
    deps = [
        "//:crazyflie_examples",
        "@ament_index_python",
        "@nav2_bringup",
    ],
)

launch_ros_binary(
    name = "multiranger_simple_mapper_launch",
    src = "multiranger_simple_mapper_launch.py",
    data = [
        "//:ament_index",
        "@crazyflie//:ament_index",
    ],
    deps = [
        "//:crazyflie_examples",
        "@ament_index_python",
    ],
)
