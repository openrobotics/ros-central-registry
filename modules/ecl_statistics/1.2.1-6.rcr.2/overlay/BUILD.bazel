load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@ecl_linear_algebra//:ecl_linear_algebra": "@ecl_linear_algebra//:ecl_linear_algebra_library",
    "@ecl_type_traits//:ecl_type_traits": "@ecl_type_traits//:ecl_type_traits_library",
}

CC_DEPS = [
    "@ecl_config//:ecl_config",
    "@ecl_config//:ecl_config_library",
    "@ecl_mpl//:ecl_mpl",
    "@ecl_mpl//:ecl_mpl_library",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "ecl_statistics_library",
    srcs = ["src/lib/covariance_ellipsoid.cpp"],
    hdrs = [
        "include/ecl/statistics.hpp",
        "include/ecl/statistics/covariance_ellipsoid.hpp",
        "include/ecl/statistics/cumulative_statistics.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src/test",
    ],
    local_defines = ros_local_defines() + [
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "SOPHUS_USE_BASIC_LOGGING=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ecl_statistics",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":ecl_statistics_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ecl_statistics"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":ecl_statistics",
    ],
    package_xml = "package.xml",
    sonames = {
        "ecl_statistics": ["libecl_statistics.so.1.2.1"],
    },
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ecl_build//:ament_package",
        "@ecl_config//:ament_package",
        "@ecl_license//:ament_package",
        "@ecl_linear_algebra//:ament_package",
        "@ecl_mpl//:ament_package",
        "@ecl_type_traits//:ament_package",
    ],
)

cc_test(
    name = "ecl_test_covariance_ellipsoids",
    srcs = ["src/test/covariance_ellipsoids.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "src/test",
    ],
    local_defines = ros_local_defines() + [
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "GTEST_HAS_PTHREAD=1",
        "SOPHUS_USE_BASIC_LOGGING=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":ecl_statistics_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "ecl_test_cumulative_statistics",
    srcs = ["src/test/cumulative_statistics.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "src/test",
    ],
    local_defines = ros_local_defines() + [
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "GTEST_HAS_PTHREAD=1",
        "SOPHUS_USE_BASIC_LOGGING=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":ecl_statistics_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "ecl_config",
        "ecl_linear_algebra",
        "ecl_mpl",
        "ecl_type_traits",
    ],
    headers = [
        "include/ecl/statistics.hpp",
        "include/ecl/statistics/covariance_ellipsoid.hpp",
        "include/ecl/statistics/cumulative_statistics.hpp",
    ],
    include_prefix = "",
    libraries = [
        ":ecl_statistics",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ecl_build//:ament_package",
        "@ecl_config//:ament_package",
        "@ecl_license//:ament_package",
        "@ecl_linear_algebra//:ament_package",
        "@ecl_mpl//:ament_package",
        "@ecl_type_traits//:ament_package",
    ],
)
