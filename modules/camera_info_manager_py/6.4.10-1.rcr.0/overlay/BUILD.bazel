package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

py_library(
    name = "camera_info_manager_py",
    srcs = glob(["camera_info_manager/**/*.py"]),
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@rclpy",
        "@sensor_msgs//:py",
        requirement("pyyaml"),
    ],
)

py_pytest(
    name = "test_zoom_camera_info_manager",
    srcs = ["test/test_zoom_camera_info_manager.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    deps = [":camera_info_manager_py"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":camera_info_manager_py"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
