+def find_xmllint():
+    # Prefer the hermetic xmllint shipped in our runfiles, falling back to PATH.
+    try:
+        from ament_xmllint.xmllint_rlocation import XMLLINT_RLOCATIONPATH
+        from python.runfiles import runfiles
+    except ImportError:
+        return shutil.which('xmllint')
+    r = runfiles.Create()
+    if r:
+        path = r.Rlocation(XMLLINT_RLOCATIONPATH)
+        if path and os.path.isfile(path) and os.access(path, os.X_OK):
+            return os.path.abspath(path)
+    return shutil.which('xmllint')
+
