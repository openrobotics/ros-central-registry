load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "interactive_markers.launch",
        "interactive_markers.launch.xml",
        "interactive_markers_launch.py",
    ],
)

launch_ros_binary(
    name = "interactive_markers_launch_xml",
    src = "interactive_markers.launch.xml",
    data = [
        "//:ament_index",
        "//:marker_server",
    ],
)

launch_ros_binary(
    name = "interactive_markers_launch_py",
    src = "interactive_markers_launch.py",
    data = [
        "//:ament_index",
        "//:marker_server",
    ],
)
