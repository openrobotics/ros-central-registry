load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

cc_library(
    name = "autoware_utils_math_library",
    srcs = [
        "src/sin_table.cpp",
        "src/trigonometry.cpp",
    ],
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include"],
)

cc_shared_library(
    name = "autoware_utils_math",
    exports_filter = [":autoware_utils_math_library"],
    deps = [":autoware_utils_math_library"],
)

cc_test(
    name = "test_autoware_utils_math",
    srcs = glob(["test/**/*.cpp"]),
    deps = [
        ":autoware_utils_math_library",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_targets = False,
    headers = glob(["include/**/*.hpp"]),
    libraries = [":autoware_utils_math"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@autoware_cmake//:ament_package",
        "@autoware_lint_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
