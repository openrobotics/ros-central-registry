load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

py_library(
    name = "examples_tf2_py",
    srcs = glob(["examples_tf2_py/**/*.py"]),
    imports = ["."],
    deps = [
        "@geometry_msgs//:py",
        "@launch_ros",
        "@rclpy",
        "@sensor_msgs//:py",
        "@tf2_ros_py",
    ],
)

ament_index(
    name = "ament_index",
    data = ["launch/broadcasters.launch.xml"],
    package_xml = "package.xml",
)

launch_ros_binary(
    name = "broadcasters.launch.xml",
    src = "launch/broadcasters.launch.xml",
    data = [":ament_index"],
    deps = [":examples_tf2_py"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "async_waits_for_transform": "examples_tf2_py.async_waits_for_transform:main",
        "blocking_waits_for_transform": "examples_tf2_py.blocking_waits_for_transform:main",
        "dynamic_broadcaster": "examples_tf2_py.dynamic_broadcaster:main",
        "frame_dumper": "examples_tf2_py.frame_dumper:main",
        "static_broadcaster": "examples_tf2_py.static_broadcaster:main",
        "waits_for_transform": "examples_tf2_py.waits_for_transform:main",
    },
    data = ["launch/broadcasters.launch.xml"],
    package_xml = "package.xml",
    python = [":examples_tf2_py"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch_ros//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@tf2_ros_py//:ament_package",
    ],
)
