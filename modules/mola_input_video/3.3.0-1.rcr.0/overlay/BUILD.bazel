load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@mola_kernel//:mola_kernel_library",
    "@mrpt_hwdrivers//:mrpt_hwdrivers_library",
    "@mrpt_obs//:mrpt_obs_library",
]

cc_library(
    name = "mola_input_video_library",
    srcs = ["src/VideoDataset.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/mola_input_video",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=3",
        "MOLA_PATCH_VERSION=0",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_input_video",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mola_input_video_library"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mola_input_video",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_input_video": [
            "libmola_input_video.so.3.3",
            "libmola_input_video.so.3.3.0",
        ],
    },
    deps = [
        "@mola_kernel//:ament_package",
        "@mrpt_hwdrivers//:ament_package",
        "@mrpt_obs//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mola_input_video",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_input_video": [
            "libmola_input_video.so.3.3",
            "libmola_input_video.so.3.3.0",
        ],
    },
    deps = [":ament_index"] + [
        "@mola_kernel//:ament_package",
        "@mrpt_hwdrivers//:ament_package",
        "@mrpt_obs//:ament_package",
    ],
)
