load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

launch_ros_binary(
    name = "add_two_ints.launch",
    src = "examples/add_two_ints.launch.xml",
    data = [
        ":ament_index",
        "@demo_nodes_cpp//:add_two_ints_server",
        "@demo_nodes_cpp//:ament_index",
    ],
)

launch_ros_binary(
    name = "example.launch",
    src = "examples/example.launch.xml",
    data = [":ament_index"],
)

ament_index(
    name = "ament_index",
    data = [
        "examples/BasicTypes.yaml",
        "examples/Bool.yaml",
        "examples/MultiArray.yaml",
        "examples/RPY.yaml",
        "examples/TopDown.yaml",
        "examples/Twist.yaml",
        "examples/TwistStamped.yaml",
        "examples/VelPose.yaml",
        "examples/VelPoseRPY.yaml",
        "examples/add_two_ints.launch.xml",
        "examples/add_two_ints.yaml",
        "examples/example.launch.xml",
        "examples/tf.yaml",
    ],
    lib_data = ["src/slider_publisher"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@demo_nodes_cpp//:ament_package",
        "@launch_ros//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_gui_py//:ament_package",
    ],
)

ament_package(
    name = "ament_package",
    data = [
        "examples/BasicTypes.yaml",
        "examples/Bool.yaml",
        "examples/MultiArray.yaml",
        "examples/RPY.yaml",
        "examples/TopDown.yaml",
        "examples/Twist.yaml",
        "examples/TwistStamped.yaml",
        "examples/VelPose.yaml",
        "examples/VelPoseRPY.yaml",
        "examples/add_two_ints.launch.xml",
        "examples/add_two_ints.yaml",
        "examples/example.launch.xml",
        "examples/tf.yaml",
    ],
    executables = ["src/slider_publisher"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@demo_nodes_cpp//:ament_package",
        "@launch_ros//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_gui_py//:ament_package",
    ],
)
