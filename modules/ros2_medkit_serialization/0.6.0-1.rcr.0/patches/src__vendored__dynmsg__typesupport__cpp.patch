+// RCR (Bazel) builds one typesupport library per interface, named
+// lib<pkg>__<msg|srv|action>__<snake_case_name>__<typesupport>.so, instead of
+// upstream's single lib<pkg>__<typesupport>.so. Try the upstream name first,
+// then fall back to the per-interface one.
+std::string pascal_to_snake_case(const std::string & str)
+{
+  std::string result;
+  result.reserve(2 * str.size());
+  for (size_t i = 0; i < str.size(); ++i) {
+    const char ch = str[i];
+    if (std::isupper(static_cast<unsigned char>(ch))) {
+      if (i > 0 && str[i - 1] != '_') {
+        if (std::islower(static_cast<unsigned char>(str[i - 1])) ||
+          (i + 1 < str.size() && std::islower(static_cast<unsigned char>(str[i + 1]))))
+        {
+          result.push_back('_');
+        }
+      }
+      result.push_back(static_cast<char>(std::tolower(static_cast<unsigned char>(ch))));
+    } else {
+      result.push_back(ch);
+    }
+  }
+  return result;
+}
+
+// Strip the suffix rosidl appends to the message types generated for a
+// service or action, so they resolve to their parent interface's library.
+std::string base_interface_name(const std::string & iface_type, const std::string & type_name)
+{
+  static const char * const srv_suffixes[] = {"_Event", "_Request", "_Response"};
+  static const char * const action_suffixes[] = {
+    "_SendGoal_Request", "_SendGoal_Response", "_GetResult_Request", "_GetResult_Response",
+    "_SendGoal_Event", "_GetResult_Event", "_FeedbackMessage", "_SendGoal", "_GetResult",
+    "_Goal", "_Result", "_Feedback"};
+  auto strip = [&type_name](const char * const * begin, const char * const * end) {
+      for (auto it = begin; it != end; ++it) {
+        const std::string suffix(*it);
+        if (type_name.size() > suffix.size() &&
+          type_name.compare(type_name.size() - suffix.size(), suffix.size(), suffix) == 0)
+        {
+          return type_name.substr(0, type_name.size() - suffix.size());
+        }
+      }
+      return type_name;
+    };
+  if (iface_type == "srv") {
+    return strip(std::begin(srv_suffixes), std::end(srv_suffixes));
+  }
+  if (iface_type == "action") {
+    return strip(std::begin(action_suffixes), std::end(action_suffixes));
+  }
+  return type_name;
+}
+
+void * open_typesupport_library(
+  const std::string & pkg_name, const std::string & iface_type,
+  const std::string & type_name, const std::string & typesupport)
+{
+  const std::string package_lib = "lib" + pkg_name + "__" + typesupport + ".so";
+  void * lib = dlopen(package_lib.c_str(), RTLD_LAZY);
+  if (nullptr != lib) {
+    return lib;
+  }
+  const std::string interface_lib = "lib" + pkg_name + "__" + iface_type + "__" +
+    pascal_to_snake_case(base_interface_name(iface_type, type_name)) + "__" + typesupport + ".so";
+  RCUTILS_LOG_DEBUG_NAMED(
+    "dynmsg", "%s not found, trying %s", package_lib.c_str(), interface_lib.c_str());
+  return dlopen(interface_lib.c_str(), RTLD_LAZY);
+}
+
