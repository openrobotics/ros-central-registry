+namespace
+{
+// Platform-specific shared library suffix for the rosidl typesupport libraries
+// (lib<pkg>__rosidl_typesupport_introspection_<lang>.<suffix>).
+#if defined(__APPLE__)
+constexpr const char * kSharedLibrarySuffix = ".dylib";
+#elif defined(_WIN32)
+constexpr const char * kSharedLibrarySuffix = ".dll";
+#else
+constexpr const char * kSharedLibrarySuffix = ".so";
+#endif
+
+// dlopen() the typesupport library by bare file name first (resolved through
+// the dynamic loader's search path / already-loaded images), then fall back to
+// `lib/<name>` relative to the working directory. The fallback covers
+// interface packages that are only present as data (e.g. via the ament index)
+// rather than linked in: on Linux LD_LIBRARY_PATH=lib handles that, but macOS
+// strips DYLD_LIBRARY_PATH when the test runner shells through /bin/bash.
+void * dlopen_typesupport_library(const std::string & lib_name)
+{
+  void * lib = dlopen(lib_name.c_str(), RTLD_LAZY);
+  if (lib == nullptr) {
+    const std::string in_lib_dir = "lib/" + lib_name;
+    lib = dlopen(in_lib_dir.c_str(), RTLD_LAZY);
+  }
+  return lib;
+}
+}  // namespace
+
 namespace dynmsg
