        "include/ros2_medkit_serialization/vendored/dynmsg/vector_utils.hpp",
        "include/ros2_medkit_serialization/vendored/dynmsg/yaml_utils.hpp",
    ],
    includes = [
        ".",
        "include",
        "include/ros2_medkit_serialization",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ros2_medkit_serialization",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":ros2_medkit_serialization_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ros2_medkit_serialization"],
)

ament_index(
    name = "ament_index",
    libraries = [":ros2_medkit_serialization"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_clang_tidy//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@ros2_medkit_cmake//:ament_package",
        "@rosidl_runtime_c//:ament_package",
