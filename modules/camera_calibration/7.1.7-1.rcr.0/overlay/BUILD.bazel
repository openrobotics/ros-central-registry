load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

py_library(
    name = "camera_calibration",
    srcs = [
        "src/camera_calibration/__init__.py",
        "src/camera_calibration/calibrator.py",
        "src/camera_calibration/camera_calibrator.py",
        "src/camera_calibration/camera_checker.py",
        "src/camera_calibration/mono_calibrator.py",
        "src/camera_calibration/nodes/__init__.py",
        "src/camera_calibration/nodes/cameracalibrator.py",
        "src/camera_calibration/nodes/cameracheck.py",
        "src/camera_calibration/nodes/tarfile_calibration.py",
        "src/camera_calibration/stereo_calibrator.py",
    ],
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@image_geometry//:image_geometry_py",
        "@message_filters//:message_filters_py",
        "@rclpy",
        "@sensor_msgs//:py",
        "@std_srvs//:py",
        requirement("numpy"),
        requirement("opencv-python"),
        requirement("semver"),
    ],
)

ament_package(
    name = "ament_package",
    console_scripts = {
        "cameracalibrator": "camera_calibration.nodes.cameracalibrator:main",
        "cameracheck": "camera_calibration.nodes.cameracheck:main",
        "tarfile_calibration": "camera_calibration.nodes.tarfile_calibration:main",
    },
    package_xml = "package.xml",
    python = [":camera_calibration"],
    python_strip_prefix = "src",
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@cv_bridge//:ament_package",
        "@image_geometry//:ament_package",
        "@message_filters//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
