load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@hardware_interface//:hardware_interface_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:fmt",
]

cc_library(
    name = "kortex_driver_library",
    srcs = [":gen_kortex_driver_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/kortex_driver",
    ],
    local_defines = ros_local_defines() + [
        "_FILE_OFFSET_BITS=64",
        "_OS_UNIX=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "kortex_driver",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":kortex_driver_library"],
)

write_file(
    name = "gen_kortex_driver_stub_cpp",
    out = "_gen/kortex_driver_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    libraries = [":kortex_driver"],
    package_xml = "package.xml",
    plugin_category = "hardware_interface",
    plugins = ["hardware_interface_plugin.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@hardware_interface//:ament_package",
        "@kortex_api//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "hardware_interface",
        "kortex_api",
        "pluginlib",
        "rclcpp",
    ],
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [":kortex_driver"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@hardware_interface//:ament_package",
        "@kortex_api//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
    ],
)
