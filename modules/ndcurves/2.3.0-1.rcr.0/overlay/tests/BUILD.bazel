load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@pinocchio//:pinocchio_collision": "@pinocchio//:pinocchio_collision_library",
    "@pinocchio//:pinocchio_default": "@pinocchio//:pinocchio_default_library",
    "@pinocchio//:pinocchio_parsers": "@pinocchio//:pinocchio_parsers_library",
}

CC_DEPS = [
    "@rosdistro//cc:boost.test",
    "@rosdistro//cc:boost.serialization",
    "@rosdistro//cc:boost.math",
    "@rosdistro//cc:boost.utility",
    "@rosdistro//cc:eigen",
]

cc_test(
    name = "curves_tests",
    srcs = ["Main.cpp"] + ["load_problem.h"] + [
        "//:jrl_headers",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        "//:ament_index",
    ] + [
        "CMakeLists.txt",
        "data/discrete_points_acc.txt",
        "data/discrete_points_error.txt",
        "data/discrete_points_pos.txt",
        "data/discrete_points_vel.txt",
        "data/test.pb",
    ],
    dynamic_deps = ["//:core_dynamic_deps"],
    local_defines = ros_local_defines() + [
        "COAL_HAS_OCTOMAP",
        "COAL_HAVE_OCTOMAP",
        "CURVES_WITH_PINOCCHIO_SUPPORT",
        "NDEBUG",
        "OCTOMAP_MAJOR_VERSION=1",
        "OCTOMAP_MINOR_VERSION=10",
        "OCTOMAP_PATCH_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_MAJOR_VERSION=3",
        "PINOCCHIO_URDFDOM_HEADERS_MINOR_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_PATCH_VERSION=0",
        "PINOCCHIO_WITH_COLLISION",
        "PINOCCHIO_WITH_HPP_FCL",
        "PINOCCHIO_WITH_URDFDOM",
        'TEST_DATA_PATH=\\"tests/data/\\"',
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:ndcurves_headers",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

