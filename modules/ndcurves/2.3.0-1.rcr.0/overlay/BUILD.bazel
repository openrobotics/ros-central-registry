    "python/ndcurves/namespace.h",
    "python/ndcurves/optimization_python.h",
    "python/ndcurves/python_variables.h",
]

cc_library(
    name = "_test_root_headers",
    hdrs = _HDRS + _PY_HDRS,
    includes = [],
    deps = [
        "@rosdistro//cc:boost.serialization",
        "@rosdistro//cc:boost.test",
    ],
)

DEPENDENCIES = {
    "@eigenpy//:eigenpy": "@eigenpy//:eigenpy_library",
    "@pinocchio//:pinocchio_collision": "@pinocchio//:pinocchio_collision_library",
    "@pinocchio//:pinocchio_default": "@pinocchio//:pinocchio_default_library",
    "@pinocchio//:pinocchio_parsers": "@pinocchio//:pinocchio_parsers_library",
    "@rosdistro//cc:boost.chrono_shared": "@rosdistro//cc:boost.chrono",
    "@rosdistro//cc:boost.container_shared": "@rosdistro//cc:boost.container",
    "@rosdistro//cc:boost.serialization_shared": "@rosdistro//cc:boost.serialization",
    "@rosdistro//cc:boost.thread_shared": "@rosdistro//cc:boost.thread",
}

CC_DEPS = [
    "@rosdistro//cc:boost.math",
    "@rosdistro//cc:boost.test",
    "@rosdistro//cc:boost.utility",
    "@rosdistro//cc:eigen",
]

ros_jrl_headers(
    name = "jrl_headers",
    outs = [
        "_gen/include/ndcurves/config.hh",
        "_gen/include/ndcurves/deprecated.hh",
        "_gen/include/ndcurves/warning.hh",
    ],
)

cc_library(
    name = "ndcurves.cpython-314-x86_64-linux-gnu_library",
    srcs = [
        "python/ndcurves/curves_python.cpp",
        "python/ndcurves/namespace.cpp",
        "python/ndcurves/optimization_python.cpp",
        "python/ndcurves/python_variables.cpp",
    ],
    hdrs = _HDRS + _PY_HDRS + [":jrl_headers"],
    includes = [
        "_gen/include",
        "_gen/include/ndcurves",
        "include",
        "include/ndcurves",
    ],
    local_defines = ros_local_defines() + [
        "COAL_HAS_OCTOMAP",
        "COAL_HAVE_OCTOMAP",
        "CURVES_WITH_PINOCCHIO_SUPPORT",
        "NDEBUG",
        "OCTOMAP_MAJOR_VERSION=1",
        "OCTOMAP_MINOR_VERSION=10",
        "OCTOMAP_PATCH_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_MAJOR_VERSION=3",
        "PINOCCHIO_URDFDOM_HEADERS_MINOR_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_PATCH_VERSION=0",
        "PINOCCHIO_WITH_COLLISION",
        "PINOCCHIO_WITH_HPP_FCL",
        "PINOCCHIO_WITH_URDFDOM",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ndcurves.cpython-314-x86_64-linux-gnu",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "ndcurves/ndcurves.so",
    deps = [":ndcurves.cpython-314-x86_64-linux-gnu_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ndcurves.cpython-314-x86_64-linux-gnu"],
)

py_library(
    name = "ndcurves_py",
    srcs = [
        "python/ndcurves/__init__.py",
