    out = "_gen/include/octomap_ros/conversions.hpp",
    content = ["#pragma once\n#include \"octomap/octomap.h\"\n#include \"geometry_msgs/msg/point.hpp\"\n#include \"geometry_msgs/msg/vector3.hpp\"\n#include \"geometry_msgs/msg/pose.hpp\"\n#include \"geometry_msgs/msg/quaternion.hpp\"\n#include \"sensor_msgs/msg/point_cloud2.hpp\"\n#include \"tf2/LinearMath/Vector3.hpp\"\n#include \"tf2/LinearMath/Transform.hpp\"\nnamespace octomap {\ninline point3d pointMsgToOctomap(const geometry_msgs::msg::Point & p) { return point3d(p.x, p.y, p.z); }\ninline geometry_msgs::msg::Point pointOctomapToMsg(const point3d & p) { geometry_msgs::msg::Point m; m.x = p.x(); m.y = p.y(); m.z = p.z(); return m; }\ninline point3d pointTfToOctomap(const tf2::Vector3 & p) { return point3d(p.x(), p.y(), p.z()); }\ninline tf2::Vector3 pointOctomapToTf(const point3d & p) { return tf2::Vector3(p.x(), p.y(), p.z()); }\ninline void pointsOctomapToPointCloud2(const Pointcloud &, sensor_msgs::msg::PointCloud2 &) {}\ninline void pointCloud2ToOctomap(const sensor_msgs::msg::PointCloud2 &, Pointcloud &) {}\n}  // namespace octomap\n"],
)

