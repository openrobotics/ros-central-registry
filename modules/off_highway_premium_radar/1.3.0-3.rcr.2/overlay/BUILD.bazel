load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@io_context//:io_context": "@io_context//:io_context_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:asio": "@rosdistro//cc:asio_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
}

CC_DEPS = [
    "@@geometry_msgs+//:cc",
    "@off_highway_premium_radar_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

cc_library(
    name = "off_highway_premium_radar_library",
    srcs = [
        "src/converters/default_converter.cpp",
        "src/driver.cpp",
        "src/location_data_handler.cpp",
        "src/node.cpp",
        "src/pdu_definitions.cpp",
        "src/udp_socket.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        ".",
        "include",
        "include/off_highway_premium_radar",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "off_highway_premium_radar",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":off_highway_premium_radar_library"],
)

rclcpp_components_register_node(
    name = "driver",
    component = ":off_highway_premium_radar",
    node_name = "driver",
    plugin = "off_highway_premium_radar::NodeWithDefaultConverter",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":off_highway_premium_radar"],
)

ament_index(
    name = "ament_index",
    components = [":driver_record"],
    data = [
        "config/driver.yaml",
        "launch/driver_launch.py",
    ],
    lib_data = [":driver"],
    libraries = [":off_highway_premium_radar"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@asio_cmake_module//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@io_context//:ament_package",
        "@off_highway_premium_radar_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

