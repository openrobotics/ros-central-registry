load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

ament_index(
    name = "ament_index",
    data = [
        "config/controllers.yaml",
        "config/controllers_base_velocity.yaml",
        "config/mujoco_pid.yaml",
        "config/mujoco_ros2_control_plugins.yaml",
        "config/mujoco_ros2_control_plugins_base_velocity.yaml",
        "config/start_positions.xml",
        "config/test_robot.rviz",
        "demo_resources/mjcf_generation/test_inputs.xml",
        "demo_resources/mobile_base/mobile_base.urdf",
        "demo_resources/mobile_base/mobile_base.xml",
        "demo_resources/pid_control/test_robot_pid.xml",
        "demo_resources/robot/test_robot.urdf",
        "demo_resources/robot/test_robot.xml",
        "demo_resources/scenes/scene.xml",
        "demo_resources/scenes/scene_info.xml",
        "demo_resources/scenes/scene_mobile_base.xml",
        "demo_resources/scenes/scene_pid.xml",
        "//launch:launch_files",
    ],
    package_xml = "package.xml",
    deps = [
        "@controller_manager//:ament_index",
        "@forward_command_controller//:ament_index",
        "@joint_state_broadcaster//:ament_index",
        "@mujoco_ros2_control//:ament_index",
        "@pose_broadcaster//:ament_index",
    ],
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@controller_manager//:ament_package",
        "@forward_command_controller//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@mujoco_ros2_control//:ament_package",
        "@mujoco_ros2_control_msgs//:ament_package",
        "@pose_broadcaster//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
        "@xacro//:ament_package",
    ],
)
