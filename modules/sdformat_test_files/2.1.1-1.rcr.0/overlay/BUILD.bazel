### PACKAGING

write_file(
    name = "config_cmake",
    out = "cmake/sdformat_test_filesConfig.cmake",
    content = [
        "get_filename_component(PACKAGE_PREFIX_DIR \"${CMAKE_CURRENT_LIST_DIR}/../../../\" ABSOLUTE)",
        "set(sdformat_test_files_MODELS_DIR \"${PACKAGE_PREFIX_DIR}/share/sdformat_test_files/models\")",
        "include(\"${PACKAGE_PREFIX_DIR}/share/sdformat_test_files/cmake/sdformat_test_files_functions.cmake\")",
        "",
    ],
)

write_file(
    name = "config_version_cmake",
    out = "cmake/sdformat_test_filesConfigVersion.cmake",
    content = [
        "set(PACKAGE_VERSION \"2.0.2\")",
        "",
    ],
)

write_file(
    name = "functions_cmake",
    out = "cmake/sdformat_test_files_functions.cmake",
    content = [
        "function(sdformat_test_files_get_model_sdf arg model_name)",
        "  set(\"${arg}\" \"${sdformat_test_files_MODELS_DIR}/${model_name}/${model_name}.sdf\" PARENT_SCOPE)",
        "endfunction()",
        "",
    ],
)

HOOK_FILES = [
    "hook/pkg_config_path.dsv",
    "hook/pkg_config_path.ps1",
    "hook/pkg_config_path.sh",
    "hook/pkg_config_path_multiarch.dsv",
    "hook/pkg_config_path_multiarch.ps1",
    "hook/pkg_config_path_multiarch.sh",
]

[
    write_file(
        name = hook.replace("/", "_").replace(".", "_"),
        out = hook,
        content = [""],
    )
    for hook in HOOK_FILES
]

