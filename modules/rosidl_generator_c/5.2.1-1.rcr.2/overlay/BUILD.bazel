load("@rosdistro//ament:defs.bzl", "ament_package", "register_ament_resource")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

exports_files([
    "aspects.bzl",
    "defs.bzl",
    "types.bzl",
])

# These are the templates used for per-message header and source generation.
filegroup(
    name = "interface_templates",
    srcs = [
        "resource/action__type_support.c.em",
        "resource/action__type_support.h.em",
        "resource/empty__description.c.em",
        "resource/full__description.c.em",
        "resource/idl.h.em",
        "resource/idl__description.c.em",
        "resource/idl__functions.c.em",
        "resource/idl__functions.h.em",
        "resource/idl__struct.h.em",
        "resource/idl__type_support.c.em",
        "resource/idl__type_support.h.em",
        "resource/msg__functions.c.em",
        "resource/msg__functions.h.em",
        "resource/msg__struct.h.em",
        "resource/msg__type_support.h.em",
        "resource/srv__type_support.c.em",
        "resource/srv__type_support.h.em",
    ],
)

# Template used for per-package visibility header generation.
exports_files(
    srcs = ["resource/rosidl_generator_c__visibility_control.h.in"],
)

# The shared libraries generated C code links against at runtime
# (rosidl_runtime_c and its closure). Exposed here so rosidl_core_generators'
# bundled per-package libraries (lib<pkg>__rosidl_generator_c.so) can link
# against them dynamically without depending on rosidl_runtime_c itself.
alias(
    name = "runtime_dynamic_deps",
    actual = "@rosidl_runtime_c//:transitive_dynamic_deps",
)

# This is the python library that does the bulk of the work for converting
# the .msg, .srv, .action files to the generic .idl representation.
py_library(
    name = "rosidl_generator_c",
    srcs = [
        "rosidl_generator_c/__init__.py",
        "rosidl_generator_c/cli.py",
    ],
    deps = [
        "@ament_index_python",
        "@rcutils//:rcutils_library",
        "@rosidl_cli",
        "@rosidl_generator_type_description",
        "@rosidl_parser",
        "@rosidl_pycommon",
    ],
)

# The py_binary target does not accept files without the .py or .py3 suffix.
# This rule simply renames the file to make it usable.
genrule(
    name = "cli_rename",
    srcs = ["bin/rosidl_generator_c"],
    outs = ["bin/rosidl_generator_c.py"],
    cmd = "cp $(location :bin/rosidl_generator_c) $(location :bin/rosidl_generator_c.py)",
)

# This makes the setup script executable, and ensures that eny downstream
# consumers of this script bring in the correct dependencies.
py_binary(
    name = "cli",
    srcs = [":bin/rosidl_generator_c.py"],
    main = ":bin/rosidl_generator_c.py",
    deps = [":rosidl_generator_c"],
)

# Mirrors ament_package(CONFIG_EXTRAS "rosidl_generator_c-extras.cmake.in"): configure_file(@ONLY) of the template.
genrule(
    name = "extras_cmake",
    srcs = ["rosidl_generator_c-extras.cmake.in"],
    outs = ["rosidl_generator_c-extras.cmake"],
    cmd = "sed -e 's|@rosidl_generator_c_LIBRARY_TYPE@|SHARED|g' -e 's|@PYTHON_INSTALL_DIR@|lib/python3.14/site-packages|g' $< > $@",
)

# ament_index_register_resource() registrations, as ament_cmake installs them.

### PACKAGING

register_ament_resource(
    name = "res_rosidl_generator_packages",
    category = "rosidl_generator_packages",
    content = "",
)

ament_package(
    name = "ament_package",
    cmake = [
        ":extras_cmake",
    ] + [
        "cmake/register_c.cmake",
        "cmake/rosidl_generator_c_generate_interfaces.cmake",
    ],
    cmake_export_dependencies_list = [
        "rosidl_typesupport_interface",
    ],
    cmake_extras = ["rosidl_generator_c-extras.cmake"],
    data = [
        ":res_rosidl_generator_packages",
    ] + [
        "resource/action__type_support.c.em",
        "resource/action__type_support.h.em",
        "resource/empty__description.c.em",
        "resource/full__description.c.em",
        "resource/idl.h.em",
        "resource/idl__description.c.em",
        "resource/idl__functions.c.em",
        "resource/idl__functions.h.em",
        "resource/idl__struct.h.em",
        "resource/idl__type_support.c.em",
        "resource/idl__type_support.h.em",
        "resource/msg__functions.c.em",
        "resource/msg__functions.h.em",
        "resource/msg__struct.h.em",
        "resource/msg__type_support.h.em",
        "resource/rosidl_generator_c__visibility_control.h.in",
        "resource/srv__type_support.c.em",
        "resource/srv__type_support.h.em",
    ],
    lib_data = ["bin/rosidl_generator_c"],
    package_xml = "package.xml",
    python = [
        "rosidl_generator_c/__init__.py",
        "rosidl_generator_c/cli.py",
        "rosidl_generator_c/py.typed",
    ],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros_core//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_cli//:ament_package",
        "@rosidl_cmake//:ament_package",
        "@rosidl_generator_type_description//:ament_package",
        "@rosidl_parser//:ament_package",
        "@rosidl_pycommon//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidl_typesupport_interface//:ament_package",
    ],
)
