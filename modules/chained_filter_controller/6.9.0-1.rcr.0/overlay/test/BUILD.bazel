load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

# Tests run with cwd = <runfiles>/_main, but this repository's own test data
# lives under <runfiles>/<canonical repo name>/ when it is an external module.
REPO_RUNFILES_PREFIX = "../%s/" % (repo_name() or "_main")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@filters//:increment": "@filters//:increment_library",
    "@filters//:mean": "@filters//:mean_library",
    "@filters//:median": "@filters//:median_library",
    "@filters//:params": "@filters//:params_library",
    "@filters//:transfer_function": "@filters//:transfer_function_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "//:chained_filter_parameters",
    "@ros2_control_test_assets//:ros2_control_test_assets",
    "@controller_interface//:controller_interface_library",
    "@controller_manager//:controller_manager_library",
    "@filters//:filter_base",
    "@filters//:filter_chain",
    "@filters//:filters",
    "@filters//:realtime_circular_buffer",
    "@generate_parameter_library//:generate_parameter_library",
    "@hardware_interface//:hardware_interface_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
]

cc_test(
    name = "test_chained_filter_controller",
    srcs = ["test_chained_filter.cpp"] + [
        "test_chained_filter.hpp",
        "test_multiple_chained_filter.hpp",
    ] + ["//:chained_filter_parameters_gen"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "config/test_chained_filter.yaml",
        "config/test_multiple_chained_filter.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        'TEST_FILES_DIRECTORY=\\"%stest\\"' % REPO_RUNFILES_PREFIX,
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:chained_filter_controller_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

cc_test(
    name = "test_load_chained_filter_controller",
    srcs = ["test_load_chained_filter_controller.cpp"] + [
        "test_chained_filter.hpp",
        "test_multiple_chained_filter.hpp",
    ] + ["//:chained_filter_parameters_gen"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "config/test_chained_filter.yaml",
        "config/test_multiple_chained_filter.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        'TEST_FILES_DIRECTORY=\\"%stest\\"' % REPO_RUNFILES_PREFIX,
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:chained_filter_controller_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

cc_test(
    name = "test_multiple_chained_filter_controller",
    srcs = ["test_multiple_chained_filter.cpp"] + [
        "test_chained_filter.hpp",
        "test_multiple_chained_filter.hpp",
    ] + ["//:chained_filter_parameters_gen"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "config/test_chained_filter.yaml",
        "config/test_multiple_chained_filter.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        'TEST_FILES_DIRECTORY=\\"%stest\\"' % REPO_RUNFILES_PREFIX,
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:chained_filter_controller_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)
