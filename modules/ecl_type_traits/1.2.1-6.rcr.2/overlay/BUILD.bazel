load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

cc_library(
    name = "ecl_type_traits_library",
    srcs = glob(["src/lib/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include"],
    deps = [
        "@ecl_config",
        "@ecl_mpl",
    ],
)

cc_shared_library(
    name = "ecl_type_traits",
    shared_lib_name = "libecl_type_traits.so",
    deps = [":ecl_type_traits_library"],
)

cc_binary(
    name = "ecl_detect_sizes",
    srcs = ["src/utils/detect_sizes.cpp"],
    deps = [":ecl_type_traits_library"],
)

[
    cc_test(
        name = "test_{}".format(test_name),
        size = "small",
        srcs = ["src/test/{}.cpp".format(test_name)],
        deps = [
            ":ecl_type_traits_library",
            "@rosdistro//cc:googletest",
        ],
    )
    for test_name in [
        "numeric_limits",
        "fundamental_types",
    ]
]

ament_index(
    name = "ament_index",
    libraries = [
        ":ecl_type_traits",
    ],
    package_xml = "package.xml",
    sonames = {
        "ecl_type_traits": ["libecl_type_traits.so.1.2.1"],
    },
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "ecl_config",
        "ecl_mpl",
    ],
    headers = glob(["include/**/*.hpp"]),
    include_prefix = "",
    libraries = [
        ":ecl_type_traits",
    ],
    package_xml = "package.xml",
    programs = [
        ":ecl_detect_sizes",
    ],
    sonames = {
        "ecl_type_traits": ["libecl_type_traits.so.1.2.1"],
    },
    deps = [
        ":ament_index",
        "@ecl_build//:ament_package",
        "@ecl_config//:ament_package",
        "@ecl_license//:ament_package",
        "@ecl_mpl//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
