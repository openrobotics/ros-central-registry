load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

py_library(
    name = "nav2_simple_commander",
    srcs = [
        "nav2_simple_commander/__init__.py",
        "nav2_simple_commander/costmap_2d.py",
        "nav2_simple_commander/demo_inspection.py",
        "nav2_simple_commander/demo_picking.py",
        "nav2_simple_commander/demo_recoveries.py",
        "nav2_simple_commander/demo_security.py",
        "nav2_simple_commander/example_assisted_teleop.py",
        "nav2_simple_commander/example_follow_path.py",
        "nav2_simple_commander/example_nav_through_poses.py",
        "nav2_simple_commander/example_nav_to_pose.py",
        "nav2_simple_commander/example_route.py",
        "nav2_simple_commander/example_waypoint_follower.py",
        "nav2_simple_commander/footprint_collision_checker.py",
        "nav2_simple_commander/line_iterator.py",
        "nav2_simple_commander/occupancy_grid.py",
        "nav2_simple_commander/robot_navigator.py",
        "nav2_simple_commander/utils.py",
    ],
    imports = ["."],
    deps = [
        requirement("numpy"),
        "@action_msgs//:py",
        "@geometry_msgs//:py",
        "@lifecycle_msgs//:py",
        "@nav2_msgs//:py",
        "@rclpy",
    ],
)

_SCRIPTS = [
    "demo_inspection",
    "demo_picking",
    "demo_recoveries",
    "demo_security",
    "example_assisted_teleop",
    "example_follow_path",
    "example_nav_through_poses",
    "example_nav_to_pose",
    "example_route",
    "example_waypoint_follower",
]

# Runnable console scripts, so launch files can start them via
# Node(package='nav2_simple_commander', executable=...).
[
    (
        py_binary(
            name = "lib/{0}".format(script),
            srcs = ["nav2_simple_commander/{0}.py".format(script)],
            imports = ["."],
            main_module = "nav2_simple_commander.{0}".format(script),
            deps = [":nav2_simple_commander"],
        ),
        alias(
            name = script,
            actual = ":lib/{0}".format(script),
        ),
    )
    for script in _SCRIPTS
]

ament_package(
    name = "ament_package",
    build_type = "ament_python",
    console_scripts = {
        "demo_inspection": "nav2_simple_commander.demo_inspection:main",
        "demo_picking": "nav2_simple_commander.demo_picking:main",
        "demo_recoveries": "nav2_simple_commander.demo_recoveries:main",
        "demo_security": "nav2_simple_commander.demo_security:main",
        "example_assisted_teleop": "nav2_simple_commander.example_assisted_teleop:main",
        "example_follow_path": "nav2_simple_commander.example_follow_path:main",
        "example_nav_through_poses": "nav2_simple_commander.example_nav_through_poses:main",
        "example_nav_to_pose": "nav2_simple_commander.example_nav_to_pose:main",
        "example_route": "nav2_simple_commander.example_route:main",
        "example_waypoint_follower": "nav2_simple_commander.example_waypoint_follower:main",
    },
    data = ["//launch:launch_files"],
    executables = [":lib/{0}".format(script) for script in _SCRIPTS],
    package_xml = "package.xml",
    python = [":nav2_simple_commander"],
    deps = [
        "@action_msgs//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@nav2_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
