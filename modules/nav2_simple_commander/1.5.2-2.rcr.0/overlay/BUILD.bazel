load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

py_library(
    name = "nav2_simple_commander",
    srcs = glob(["nav2_simple_commander/**/*.py"]),
    imports = ["."],
    deps = [
        requirement("numpy"),
        "@action_msgs//:py",
        "@geometry_msgs//:py",
        "@lifecycle_msgs//:py",
        "@nav2_msgs//:py",
        "@rclpy",
    ],
)

[
    py_pytest(
        name = test,
        srcs = ["test/{}.py".format(test)],
        deps = [":nav2_simple_commander"],
    )
    for test in [
        "test_costmap2d",
        "test_footprint_collision_checker",
        "test_line_iterator",
        "test_occupancy_grid",
    ]
]

pkg_files(
    name = "launch_files",
    srcs = glob(["launch/*"]),
    prefix = "share/nav2_simple_commander",
)

ament_package(
    name = "ament_package",
    build_type = "ament_python",
    console_scripts = {
        "demo_inspection": "nav2_simple_commander.demo_inspection:main",
        "demo_picking": "nav2_simple_commander.demo_picking:main",
        "demo_recoveries": "nav2_simple_commander.demo_recoveries:main",
        "demo_security": "nav2_simple_commander.demo_security:main",
        "example_assisted_teleop": "nav2_simple_commander.example_assisted_teleop:main",
        "example_follow_path": "nav2_simple_commander.example_follow_path:main",
        "example_nav_through_poses": "nav2_simple_commander.example_nav_through_poses:main",
        "example_nav_to_pose": "nav2_simple_commander.example_nav_to_pose:main",
        "example_route": "nav2_simple_commander.example_route:main",
        "example_waypoint_follower": "nav2_simple_commander.example_waypoint_follower:main",
    },
    install = [":launch_files"],
    package_xml = "package.xml",
    python = [":nav2_simple_commander"],
    deps = [
        "@action_msgs//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@nav2_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
