# Console scripts installed to lib/controller_manager/. These are py_binary
# targets (not bare python3 shims) so each one carries :controller_manager_py
# and its transitive deps (controller_manager_msgs, rclpy, ...) in its own
# runfiles; consumers (e.g. launch files running the spawner) then only need
# :ament_index in `data`, not the Python library in their own `deps`.
[
    py_binary(
        name = script,
        srcs = ["controller_manager/{}.py".format(script)],
        main = "controller_manager/{}.py".format(script),
        deps = [":controller_manager_py"],
    )
    for script in [
        "hardware_spawner",
        "spawner",
        "unspawner",
    ]
]

