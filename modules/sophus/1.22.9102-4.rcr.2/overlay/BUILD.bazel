load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

exports_files(["sophus/test_macros.hpp"])

filegroup(
    name = "headers",
    srcs = [
        "sophus/average.hpp",
        "sophus/cartesian.hpp",
        "sophus/ceres_local_parameterization.hpp",
        "sophus/ceres_manifold.hpp",
        "sophus/ceres_typetraits.hpp",
        "sophus/common.hpp",
        "sophus/geometry.hpp",
        "sophus/interpolate.hpp",
        "sophus/interpolate_details.hpp",
        "sophus/num_diff.hpp",
        "sophus/rotation_matrix.hpp",
        "sophus/rxso2.hpp",
        "sophus/rxso3.hpp",
        "sophus/se2.hpp",
        "sophus/se3.hpp",
        "sophus/sim2.hpp",
        "sophus/sim3.hpp",
        "sophus/sim_details.hpp",
        "sophus/so2.hpp",
        "sophus/so3.hpp",
        "sophus/spline.hpp",
        "sophus/types.hpp",
        "sophus/velocities.hpp",
    ],
)

cc_library(
    name = "sophus",
    hdrs = [
        "sophus/average.hpp",
        "sophus/cartesian.hpp",
        "sophus/ceres_local_parameterization.hpp",
        "sophus/ceres_manifold.hpp",
        "sophus/ceres_typetraits.hpp",
        "sophus/common.hpp",
        "sophus/geometry.hpp",
        "sophus/interpolate.hpp",
        "sophus/interpolate_details.hpp",
        "sophus/num_diff.hpp",
        "sophus/rotation_matrix.hpp",
        "sophus/rxso2.hpp",
        "sophus/rxso3.hpp",
        "sophus/se2.hpp",
        "sophus/se3.hpp",
        "sophus/sim2.hpp",
        "sophus/sim3.hpp",
        "sophus/sim_details.hpp",
        "sophus/so2.hpp",
        "sophus/so3.hpp",
        "sophus/spline.hpp",
        "sophus/test_macros.hpp",
        "sophus/types.hpp",
        "sophus/velocities.hpp",
    ],
    includes = ["."],
    deps = [
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:fmt",
    ],
)

alias(
    name = "sophus_library",
    actual = ":sophus",
)

genrule(
    name = "sophus_cmake_gen",
    srcs = ["SophusConfig.cmake.in"],
    outs = [
        "cmake_gen/SophusConfig.cmake",
        "cmake_gen/SophusConfigVersion.cmake",
        "cmake_gen/SophusTargets.cmake",
    ],
    cmd = '\ncp $(location SophusConfig.cmake.in) $(location cmake_gen/SophusConfig.cmake)\necho \'set(PACKAGE_VERSION "1.22.10")\' > $(location cmake_gen/SophusConfigVersion.cmake)\necho \'add_library(Sophus::Sophus INTERFACE IMPORTED)\' > $(location cmake_gen/SophusTargets.cmake)\n',
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    build_type = "cmake",
    cmake = [":sophus_cmake_gen"],
    cmake_strip_prefix = "cmake_gen",
    headers = [":headers"],
    headers_strip_prefix = "",
    include_prefix = "",
    deps = ["@rosdistro//:ament_package"],
)
