load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

[cc_test(
    name = test_name,
    size = "small",
    srcs = [
        "//:sophus/test_macros.hpp",
        "core/{}.cpp".format(test_name),
        "core/tests.hpp",
    ],
    deps = ["//:sophus"],
) for test_name in [
    "test_common",
    "test_cartesian2",
    "test_cartesian3",
    "test_so2",
    "test_se2",
    "test_rxso2",
    "test_sim2",
    "test_so3",
    "test_se3",
    "test_rxso3",
    "test_sim3",
    "test_velocities",
    "test_geometry",
]]
