# Header-only C++ library (mirrors upstream's INTERFACE `proxsuite` target).
cc_library(
    name = "proxsuite",
    hdrs = _HDRS + [":jrl_headers"],
    includes = [
        "_gen/include",
        "include",
    ],
    deps = ["@rosdistro//cc:eigen"],
)

ament_package(
    name = "ament_package",
    build_type = "cmake",
    headers = _HDRS + [":jrl_headers"],
    headers_strip_prefixes = [
        "include",
        "_gen/include",
    ],
    include_prefix = "",
    package_xml = "package.xml",
    setup_cfg = "setup.cfg",
    deps = [
        "@rosdistro//:ament_package",
    ],
)
