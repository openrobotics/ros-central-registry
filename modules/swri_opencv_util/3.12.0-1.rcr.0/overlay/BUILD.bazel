load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@swri_math_util//:swri_math_util": "@swri_math_util//:swri_math_util_library",
}

CC_DEPS = [
]

cc_library(
    name = "swri_opencv_util_library",
    srcs = [
        "src/blend.cpp",
        "src/convert.cpp",
        "src/model_fit.cpp",
        "src/models.cpp",
    ],
    hdrs = [
        "include/swri_opencv_util/blend.h",
        "include/swri_opencv_util/convert.h",
        "include/swri_opencv_util/model_fit.h",
        "include/swri_opencv_util/models.h",
        "include/swri_opencv_util/show.h",
    ],
    includes = [
        "include",
        "include/swri_opencv_util",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "swri_opencv_util",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":swri_opencv_util_library"],
)

cc_library(
    name = "swri_opencv_util_show_library",
    srcs = ["src/show.cpp"],
    hdrs = [
        "include/swri_opencv_util/blend.h",
        "include/swri_opencv_util/convert.h",
        "include/swri_opencv_util/model_fit.h",
        "include/swri_opencv_util/models.h",
        "include/swri_opencv_util/show.h",
    ],
    includes = [
        "include",
        "include/swri_opencv_util",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "swri_opencv_util_show",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":swri_opencv_util_show_library"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":swri_opencv_util",
        ":swri_opencv_util_show",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@swri_math_util//:ament_package",
    ],
)

ament_package(
    cmake = ["cmake/swri_opencv_util-extras.cmake"],
    cmake_export_dependencies_list = [
        "ament_cmake",
        "OpenCV",
        "swri_math_util",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_swri_opencv_util",
    cmake_extras = ["swri_opencv_util-extras.cmake"],
    headers = [
        "include/swri_opencv_util/blend.h",
        "include/swri_opencv_util/convert.h",
        "include/swri_opencv_util/model_fit.h",
        "include/swri_opencv_util/models.h",
        "include/swri_opencv_util/show.h",
    ],
    libraries = [
        ":swri_opencv_util",
        ":swri_opencv_util_show",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@swri_math_util//:ament_package",
    ],
)
