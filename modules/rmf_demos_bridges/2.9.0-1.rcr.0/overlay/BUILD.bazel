load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "rmf_demos_bridges",
    srcs = [
        "rmf_demos_bridges/__init__.py",
        "rmf_demos_bridges/fleet_robotmanager_mqtt_bridge.py",
        "rmf_demos_bridges/fleet_socketio_bridge.py",
        "rmf_demos_bridges/test/socketio_subscribe.py",
    ],
    imports = ["."],
    deps = [
        "@rmf_building_map_tools",
        "@rmf_fleet_msgs//:py",
        "@rmf_site_map_msgs//:py",
        "@rmf_traffic_msgs//:py",
        requirement("pyproj"),
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "fleet_robotmanager_mqtt_bridge": "rmf_demos_bridges.fleet_robotmanager_mqtt_bridge:main",
        "fleet_socketio_bridge": "rmf_demos_bridges.fleet_socketio_bridge:main",
    },
    package_xml = "package.xml",
    python = [":rmf_demos_bridges"],
    setup_cfg = "setup.cfg",
    deps = [
        "@rmf_building_map_tools//:ament_package",
        "@rmf_fleet_msgs//:ament_package",
        "@rmf_site_map_msgs//:ament_package",
        "@rmf_traffic_msgs//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
