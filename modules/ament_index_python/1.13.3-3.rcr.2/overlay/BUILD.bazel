load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

py_library(
    name = "ament_index_python",
    srcs = [
        "ament_index_python/__init__.py",
        "ament_index_python/cli.py",
        "ament_index_python/constants.py",
        "ament_index_python/packages.py",
        "ament_index_python/resources.py",
        "ament_index_python/search_paths.py",
    ],
    deps = ["@rules_python//python/runfiles"],
)

py_binary(
    name = "setup",
    srcs = ["setup.py"],
    deps = [requirement("setuptools")],
)

genrule(
    name = "entry_points",
    srcs = [
        "CHANGELOG.rst",
        "QUALITY_DECLARATION.md",
        "README.md",
        "ament_index_python/__init__.py",
        "ament_index_python/cli.py",
        "ament_index_python/constants.py",
        "ament_index_python/packages.py",
        "ament_index_python/py.typed",
        "ament_index_python/resources.py",
        "ament_index_python/search_paths.py",
        "colcon.pkg",
        "completion/ament_index-argcomplete.bash",
        "completion/ament_index-argcomplete.zsh",
        "docs/Makefile",
        "docs/make.bat",
        "docs/source/api.rst",
        "docs/source/api/constants.rst",
        "docs/source/api/packages.rst",
        "docs/source/api/resources.rst",
        "docs/source/api/search_paths.rst",
        "docs/source/conf.py",
        "docs/source/index.rst",
        "package.xml",
        "resource/ament_index_python",
        "setup.py",
    ],
    outs = ["ament_index_python.egg-info/entry_points.txt"],
    cmd = "$(location :setup) egg_info --egg-base=$(@D)/..",
    tools = [":setup"],
)

py_console_script_binary(
    name = "ament_index",
    entry_points_txt = ":entry_points",
    pkg = ":ament_index_python",
    script = "ament_index",
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "QUALITY_DECLARATION.md",
        "README.md",
        "ament_index_python/__init__.py",
        "ament_index_python/cli.py",
        "ament_index_python/constants.py",
        "ament_index_python/packages.py",
        "ament_index_python/py.typed",
        "ament_index_python/resources.py",
        "ament_index_python/search_paths.py",
        "colcon.pkg",
        "completion/ament_index-argcomplete.bash",
        "completion/ament_index-argcomplete.zsh",
        "docs/Makefile",
        "docs/make.bat",
        "docs/source/api.rst",
        "docs/source/api/constants.rst",
        "docs/source/api/packages.rst",
        "docs/source/api/resources.rst",
        "docs/source/api/search_paths.rst",
        "docs/source/conf.py",
        "docs/source/index.rst",
        "package.xml",
        "resource/ament_index_python",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "mypy",
    "pep257",
    "xmllint",
]]

ament_package(
    name = "ament_package",
    console_programs = {"ament_index": "ament_index_python.cli:main"},
    env_hooks = [
        "environment/ament_index-argcomplete.bash",
        "environment/ament_index-argcomplete.zsh",
    ],
    package_xml = "package.xml",
    python = [":ament_index_python"] + ["ament_index_python/py.typed"],
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
