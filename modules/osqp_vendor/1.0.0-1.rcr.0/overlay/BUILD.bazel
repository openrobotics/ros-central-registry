load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

alias(
    name = "osqp_library",
    actual = "@rosdistro//cc:osqp_library",
)

alias(
    name = "osqp",
    actual = "@rosdistro//cc:osqp",
)

alias(
    name = "osqpstatic_library",
    actual = "@rosdistro//cc:osqp_library",
)

ament_index(
    name = "ament_index",
    libraries = [
        ":osqp",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ros_environment//:ament_package",
    ],
)

ament_package(
    cmake = [
        "cmake/osqp_vendor-extras.cmake",
    ],
    cmake_export_dependencies_list = ["osqp"],
    cmake_export_include_directories = False,
    cmake_export_targets = False,
    cmake_extras = ["osqp_vendor-extras.cmake"],
    include_prefix = "",
    libraries = [
        ":osqp",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ros_environment//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
