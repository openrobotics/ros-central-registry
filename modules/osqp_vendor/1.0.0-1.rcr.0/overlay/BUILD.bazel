load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@rosdistro//cc:osqp_library",
]

cc_library(
    name = "osqp_library",
    srcs = [],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_extra_0",
        ":gen_extra_1",
        ":gen_extra_2",
        ":gen_extra_3",
        ":gen_extra_4",
        ":gen_extra_5",
        ":gen_extra_6",
        ":gen_extra_7",
        ":gen_extra_8",
    ],
    includes = [
        "_gen/include",
        "_gen/include/osqp",
        "_gen/include/qdldl",
    ],
    local_defines = ros_local_defines() + [
        "BUILDING_OSQP",
        "OSQP_SHARED_LIB",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "osqp",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":osqp_library"],
)

cc_library(
    name = "osqpstatic_library",
    srcs = [],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_extra_0",
        ":gen_extra_1",
        ":gen_extra_2",
        ":gen_extra_3",
        ":gen_extra_4",
        ":gen_extra_5",
        ":gen_extra_6",
        ":gen_extra_7",
        ":gen_extra_8",
    ],
    includes = [
        "_gen/include",
        "_gen/include/osqp",
        "_gen/include/qdldl",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

genrule(
    name = "static_osqpstatic_a",
    srcs = [":osqpstatic_library"],
    outs = ["libosqpstatic.a"],
    cmd = "for f in $(SRCS); do case $$f in *.a) cp $$f $@; exit 0;; esac; done; ar rcs $@",
)

write_file(
