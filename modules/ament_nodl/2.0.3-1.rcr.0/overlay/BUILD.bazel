load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

py_pytest(
    name = "test_conformance_cmake",
    srcs = ["test/test_conformance_cmake.py"],
    data = glob(["cmake/**"]),
)

write_file(
    name = "meta_share_ament_nodl_cmake_ament_nodl_extras_cmake",
    out = "_meta/share/ament_nodl/cmake/ament_nodl-extras.cmake",
    content = [
        "# Resolves ${Python3_EXECUTABLE} for the build-time validation step the macros invoke.",
        "find_package(Python3 REQUIRED COMPONENTS Interpreter)",
        "",
        "include(\"${CMAKE_CURRENT_LIST_DIR}/ament_nodl_register.cmake\")",
        "include(\"${CMAKE_CURRENT_LIST_DIR}/nodl_add_conformance_test.cmake\")",
    ],
)

pkg_files(
    name = "meta_files",
    srcs = [":meta_share_ament_nodl_cmake_ament_nodl_extras_cmake"],
    strip_prefix = strip_prefix.from_pkg("_meta"),
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = glob(["cmake/**"]),
    cmake_extras = ["ament_nodl-extras.cmake"],
    install = [":meta_files"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@ros2nodl//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
