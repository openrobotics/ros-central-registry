# Upstream's py-bindings/CMakeLists.txt installs py-bindings/ompl/ as the `ompl`
# Python package next to the nanobind `_ompl` extension module. (The
# `ompl/_ompl/*.pyi` stubs it also emits are nanobind_add_stub build outputs
# and are not shipped here.)
OMPL_PY_SOURCES = glob(["py-bindings/ompl/*.py"])

[
    copy_file(
        name = "_py_ompl_" + f.rsplit("/", 1)[-1].removesuffix(".py"),
        src = f,
        out = "_gen/py/ompl/" + f.rsplit("/", 1)[-1],
    )
    for f in OMPL_PY_SOURCES
]

py_library(
    name = "ompl_python",
    srcs = ["_gen/py/ompl/" + f.rsplit("/", 1)[-1] for f in OMPL_PY_SOURCES],
    data = [":_ompl.cpython-314-x86_64-linux-gnu"],
    imports = ["_gen/py"],
)

