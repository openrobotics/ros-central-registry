    out = "_gen/include/boost/serialization/access.hpp",
    content = ["#ifndef RCR_BOOST_SERIALIZATION_ACCESS_HPP_\n#define RCR_BOOST_SERIALIZATION_ACCESS_HPP_\n#include <cstddef>\n#include <exception>\n#include <utility>\nnamespace boost {\nnamespace serialization {\nclass access {\n public:\n  template <class Archive, class T>\n  static void serialize(Archive & ar, T & t, const unsigned int version) {\n    t.serialize(ar, version);\n  }\n  template <class T>\n  static void destroy(const T * t) { delete t; }\n};\ntemplate <class T>\nstruct nvp {\n  const char * name;\n  T * value;\n  nvp(const char * n, T & v) : name(n), value(&v) {}\n};\ntemplate <class T>\ninline nvp<T> make_nvp(const char * name, T & v) { return nvp<T>(name, v); }\ntemplate <class Base, class Derived>\ninline Base & base_object(Derived & d) { return static_cast<Base &>(d); }\ntemplate <class Base, class Derived>\ninline const Base & base_object(const Derived & d) { return static_cast<const Base &>(d); }\ntemplate <class T>\nstruct array_wrapper {\n  T * data;\n  std::size_t size;\n};\ntemplate <class T>\ninline array_wrapper<T> make_array(T * data, std::size_t size) { return {data, size}; }\ntemplate <class Archive, class T>\ninline void split_free(Archive &, T &, const unsigned int) {}\ntemplate <class Archive, class T>\ninline void split_member(Archive &, T &, const unsigned int) {}\n}  // namespace serialization\nnamespace archive {\nenum archive_flags { no_header = 1, no_codecvt = 2, no_xml_tag_checking = 4, no_tracking = 8 };\nclass archive_exception : public std::exception {\n public:\n  const char * what() const noexcept override { return \"boost::archive::archive_exception\"; }\n};\nclass ArchiveStub {\n public:\n  template <typename... Args>\n  explicit ArchiveStub(Args &&...) {}\n  template <typename T>\n  ArchiveStub & operator<<(const T &) { return *this; }\n  template <typename T>\n  ArchiveStub & operator>>(T &&) { return *this; }\n  template <typename T>\n  ArchiveStub & operator&(T &&) { return *this; }\n  template <typename T>\n  void register_type() {}\n};\nusing ArchiveStubBase = ArchiveStub;\nstruct binary_iarchive : ArchiveStub { using ArchiveStub::ArchiveStub; };\nstruct binary_oarchive : ArchiveStub { using ArchiveStub::ArchiveStub; };\nstruct text_iarchive : ArchiveStub { using ArchiveStub::ArchiveStub; };\nstruct text_oarchive : ArchiveStub { using ArchiveStub::ArchiveStub; };\n}  // namespace archive\n}  // namespace boost\n#define BOOST_SERIALIZATION_NVP(v) ::boost::serialization::make_nvp(#v, v)\n#define BOOST_SERIALIZATION_BASE_OBJECT_NVP(...) ::boost::serialization::base_object<__VA_ARGS__>(*this)\n#define BOOST_SERIALIZATION_ASSUME_ABSTRACT(...)\n#define BOOST_CLASS_EXPORT(...)\n#define BOOST_CLASS_EXPORT_KEY(...)\n#define BOOST_CLASS_EXPORT_IMPLEMENT(...)\n#define BOOST_SERIALIZATION_SPLIT_MEMBER()\n#define BOOST_SERIALIZATION_SPLIT_FREE(...)\n#endif\n"],
)

