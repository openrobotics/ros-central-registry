load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

py_library(
    name = "diagnostic_common_diagnostics",
    srcs = glob(["diagnostic_common_diagnostics/**/*.py"]),
    imports = ["."],
    deps = [
        requirement("psutil"),
        "@diagnostic_updater//:diagnostic_updater_py",
        "@rclpy",
    ],
)

ament_index(
    name = "ament_index",
    executables = glob(["diagnostic_common_diagnostics/*.py"]),
    package_xml = "package.xml",
)

py_pytest(
    name = "test_cpu_monitor",
    srcs = ["test/systemtest/test_cpu_monitor.py"],
    deps = [
        ":diagnostic_common_diagnostics",
        "@diagnostic_updater//:diagnostic_updater_py",
        "@rclpy",
    ],
)

py_pytest(
    name = "ntp_monitor_launchtest",
    srcs = ["test/systemtest/test_ntp_monitor_launchtest.py"],
    data = [":ament_index"],
    tags = ["manual"],
    deps = [
        ":diagnostic_common_diagnostics",
        "@rclpy",
    ],
)

py_pytest(
    name = "hd_monitor_launchtest",
    srcs = ["test/systemtest/test_hd_monitor_launchtest.py"],
    data = [":ament_index"],
    tags = ["manual"],
    deps = [
        ":diagnostic_common_diagnostics",
        "@rclpy",
    ],
)

ament_package(
    name = "ament_package",
    executables = [
        "diagnostic_common_diagnostics/cpu_monitor.py",
        "diagnostic_common_diagnostics/hd_monitor.py",
        "diagnostic_common_diagnostics/ntp_monitor.py",
        "diagnostic_common_diagnostics/ram_monitor.py",
        "diagnostic_common_diagnostics/sensors_monitor.py",
    ],
    package_xml = "package.xml",
    python = [":diagnostic_common_diagnostics"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
