load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

cc_library(
    name = "ecl_console",
    hdrs = ["include/ecl/console.hpp"],
    includes = ["include"],
    deps = ["@ecl_config"],
)

alias(
    name = "ecl_console_library",
    actual = ":ecl_console",
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = ["ecl_config"],
    headers = ["include/ecl/console.hpp"],
    include_prefix = "",
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ecl_build//:ament_package",
        "@ecl_config//:ament_package",
        "@ecl_license//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
