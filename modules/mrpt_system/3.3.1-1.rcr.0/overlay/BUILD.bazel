load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

alias(
    name = "mrpt_containers",
    actual = "@mrpt_containers//:mrpt_containers",
)

alias(
    name = "mrpt_containers_library",
    actual = "@mrpt_containers//:mrpt_containers_library",
)

alias(
    name = "mrpt_core",
    actual = "@mrpt_containers//:mrpt_core",
)

alias(
    name = "mrpt_core_library",
    actual = "@mrpt_containers//:mrpt_core_library",
)

DEPENDENCIES = {
    "@mrpt_containers//:mrpt_containers": "@mrpt_containers//:mrpt_containers_library",
    "@mrpt_containers//:mrpt_core": "@mrpt_containers//:mrpt_core_library",
}

CC_DEPS = [
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
]

cc_library(
    name = "mrpt_system_library",
    srcs = [
        "src/CControlledRateTimer.cpp",
        "src/CDirectoryExplorer.cpp",
        "src/CFileSystemWatcher.cpp",
        "src/CObservable.cpp",
        "src/CObserver.cpp",
        "src/COutputLogger.cpp",
        "src/CRateTimer.cpp",
        "src/CTicTac.cpp",
        "src/CTimeLogger.cpp",
        "src/base64.cpp",
        "src/crc.cpp",
        "src/datetime.cpp",
        "src/filesystem.cpp",
        "src/hyperlink.cpp",
        "src/md5.cpp",
        "src/memory.cpp",
        "src/os.cpp",
        "src/progress.cpp",
        "src/scheduler.cpp",
        "src/string_utils.cpp",
        "src/thread_name.cpp",
    ],
    hdrs = [
        "include/mrpt/system/CConsoleRedirector.h",
        "include/mrpt/system/CControlledRateTimer.h",
        "include/mrpt/system/CDirectoryExplorer.h",
        "include/mrpt/system/CFileSystemWatcher.h",
        "include/mrpt/system/CGenericMemoryPool.h",
        "include/mrpt/system/CObservable.h",
        "include/mrpt/system/CObserver.h",
        "include/mrpt/system/COutputLogger.h",
        "include/mrpt/system/CRateTimer.h",
        "include/mrpt/system/CTicTac.h",
        "include/mrpt/system/CTimeLogger.h",
        "include/mrpt/system/crc.h",
        "include/mrpt/system/datetime.h",
        "include/mrpt/system/filesystem.h",
        "include/mrpt/system/hyperlink.h",
        "include/mrpt/system/md5.h",
        "include/mrpt/system/memory.h",
        "include/mrpt/system/mrptEvent.h",
        "include/mrpt/system/os.h",
        "include/mrpt/system/progress.h",
        "include/mrpt/system/scheduler.h",
        "include/mrpt/system/string_utils.h",
        "include/mrpt/system/thread_name.h",
    ] + [":config_h"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "src",
    ],
    local_defines = ros_local_defines() + ["STD_FS_IS_EXPERIMENTAL=0"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_system",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mrpt_system_library"],
)

cc_library(
    name = "_bindings.cpython-314-x86_64-linux-gnu_library",
    srcs = ["python_bindings/mrpt_system_py.cpp"],
    hdrs = [
        "include/mrpt/system/CConsoleRedirector.h",
        "include/mrpt/system/CControlledRateTimer.h",
        "include/mrpt/system/CDirectoryExplorer.h",
        "include/mrpt/system/CFileSystemWatcher.h",
        "include/mrpt/system/CGenericMemoryPool.h",
        "include/mrpt/system/CObservable.h",
        "include/mrpt/system/CObserver.h",
        "include/mrpt/system/COutputLogger.h",
        "include/mrpt/system/CRateTimer.h",
        "include/mrpt/system/CTicTac.h",
        "include/mrpt/system/CTimeLogger.h",
        "include/mrpt/system/crc.h",
        "include/mrpt/system/datetime.h",
        "include/mrpt/system/filesystem.h",
        "include/mrpt/system/hyperlink.h",
        "include/mrpt/system/md5.h",
        "include/mrpt/system/memory.h",
        "include/mrpt/system/mrptEvent.h",
        "include/mrpt/system/os.h",
        "include/mrpt/system/progress.h",
        "include/mrpt/system/scheduler.h",
        "include/mrpt/system/string_utils.h",
        "include/mrpt/system/thread_name.h",
    ] + [":config_h"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":mrpt_system_library"],
)

cc_shared_library(
    name = "_bindings.cpython-314-x86_64-linux-gnu",
    dynamic_deps = DEPENDENCIES.keys() + [":mrpt_system"],
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "mrpt/system/_bindings.so",
    deps = [":_bindings.cpython-314-x86_64-linux-gnu_library"],
)

py_library(
    name = "mrpt",
    srcs = ["python/mrpt/system/__init__.py"],
    imports = ["python"],
    deps = ["@mrpt_containers//:mrpt"],
)

expand_template(
    name = "config_h",
    out = "_gen/include/mrpt/system/config.h",
    substitutions = select({
        "@platforms//os:linux": {
            "${CMAKE_INSTALL_PREFIX}": ".",
            "${CMAKE_MRPT_HAS_INOTIFY}": "1",
            "${mrpt_system_SOURCE_DIR}": ".",
        },
        "//conditions:default": {
            "${CMAKE_INSTALL_PREFIX}": ".",
            "${CMAKE_MRPT_HAS_INOTIFY}": "0",
            "${mrpt_system_SOURCE_DIR}": ".",
        },
    }),
    template = "config.h.in",
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_system",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_system": [
            "libmrpt_system.so.3.3",
            "libmrpt_system.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_common//:ament_package",
        "@mrpt_containers//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    egg_info = False,
    headers = [
        ":config_h",
    ] + [
        "include/mrpt/system/CConsoleRedirector.h",
        "include/mrpt/system/CControlledRateTimer.h",
        "include/mrpt/system/CDirectoryExplorer.h",
        "include/mrpt/system/CFileSystemWatcher.h",
        "include/mrpt/system/CGenericMemoryPool.h",
        "include/mrpt/system/CObservable.h",
        "include/mrpt/system/CObserver.h",
        "include/mrpt/system/COutputLogger.h",
        "include/mrpt/system/CRateTimer.h",
        "include/mrpt/system/CTicTac.h",
        "include/mrpt/system/CTimeLogger.h",
        "include/mrpt/system/crc.h",
        "include/mrpt/system/datetime.h",
        "include/mrpt/system/filesystem.h",
        "include/mrpt/system/hyperlink.h",
        "include/mrpt/system/md5.h",
        "include/mrpt/system/memory.h",
        "include/mrpt/system/mrptEvent.h",
        "include/mrpt/system/os.h",
        "include/mrpt/system/progress.h",
        "include/mrpt/system/scheduler.h",
        "include/mrpt/system/string_utils.h",
        "include/mrpt/system/thread_name.h",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mrpt_system",
    ],
    package_xml = "package.xml",
    python = [
        ":mrpt",
        ":_bindings.cpython-314-x86_64-linux-gnu",
    ],
    python_strip_prefix = "python",
    sonames = {
        "mrpt_system": [
            "libmrpt_system.so.3.3",
            "libmrpt_system.so.3.3.1",
        ],
    },
    deps = [":ament_index"] + [
        "@mrpt_common//:ament_package",
        "@mrpt_containers//:ament_package",
    ],
)
