cc_library(
    name = "magnetometer_bias_remover_library",
    srcs = ["src/bias_remover.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ) + [":gen_extra_3"],
    copts = ["-std=c++20"],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/magnetometer_pipeline",
        "include",
        "include/magnetometer_pipeline",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

