CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
]

_HDRS = [
    "include/magnetometer_pipeline/bias_remover.hpp",
    "include/magnetometer_pipeline/magnetometer_bias_remover_nodelet.hpp",
    "include/magnetometer_pipeline/message_filter.hpp",
    ":version_h",
]

cc_library(
    name = "magnetometer_bias_remover_library",
    srcs = ["src/bias_remover.cpp"],
    hdrs = _HDRS,
    includes = [
        ".",
        "_gen/include",
        "_gen/include/magnetometer_pipeline",
        "include",
        "include/magnetometer_pipeline",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "magnetometer_bias_remover",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":magnetometer_bias_remover_library"],
)

cc_library(
    name = "magnetometer_bias_remover_filter_library",
    srcs = ["src/message_filter.cpp"],
    hdrs = _HDRS,
    includes = [
        ".",
        "_gen/include",
        "_gen/include/magnetometer_pipeline",
        "include",
        "include/magnetometer_pipeline",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":magnetometer_bias_remover_library"],
)

cc_shared_library(
    name = "magnetometer_bias_remover_filter",
    dynamic_deps = DEPENDENCIES.keys() + [":magnetometer_bias_remover"],
    exports_filter = ["//:__subpackages__"],
    deps = [":magnetometer_bias_remover_filter_library"],
)

cc_library(
    name = "magnetometer_bias_remover_nodelet_library",
    srcs = ["nodelets/magnetometer_bias_remover_nodelet.cpp"],
    hdrs = _HDRS,
    includes = [
        ".",
        "_gen/include",
        "_gen/include/magnetometer_pipeline",
        "include",
        "include/magnetometer_pipeline",
    ],
    local_defines = ros_local_defines() + ["MESSAGE_FILTERS_VERSION_SUBSCRIBER_USES_NODE_INTERFACES=1"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":magnetometer_bias_remover_filter_library",
        ":magnetometer_bias_remover_library",
    ],
)

cc_shared_library(
    name = "magnetometer_bias_remover_nodelet",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":magnetometer_bias_remover",
        ":magnetometer_bias_remover_filter",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":magnetometer_bias_remover_nodelet_library"],
)

rclcpp_components_register_node(
    name = "magnetometer_bias_remover_node",
    component = ":magnetometer_bias_remover_nodelet",
    data = [
        ":ament_index",
    ],
    node_name = "magnetometer_bias_remover_node",
    plugin = "magnetometer_pipeline::MagnetometerBiasRemoverNodelet",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
