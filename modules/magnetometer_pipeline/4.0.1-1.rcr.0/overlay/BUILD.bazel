        ":magnetometer_bias_remover",
        ":magnetometer_bias_remover_filter",
        ":magnetometer_bias_remover_nodelet",
    ],
)

ros_version_header(
    name = "version_h",
    out = "_gen/include/magnetometer_pipeline/magnetometer_pipeline/version.h",
)

