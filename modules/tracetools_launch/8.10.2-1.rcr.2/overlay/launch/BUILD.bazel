load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "example.launch.py",
        "example.launch.xml",
        "example.launch.yaml",
        "example_dual_session.launch.py",
        "example_dual_session.launch.xml",
        "example_dual_session.launch.yaml",
        "example_snapshot_mode.launch.py",
        "example_snapshot_mode.launch.xml",
        "example_snapshot_mode.launch.yaml",
    ],
)

launch_ros_binary(
    name = "example_launch_py",
    src = "example.launch.py",
    data = ["//:ament_index"],
    deps = [
        "//:tracetools_launch",
    ],
)

launch_ros_binary(
    name = "example_launch_xml",
    src = "example.launch.xml",
    data = ["//:ament_index"],
    deps = [
        "//:tracetools_launch",
        "@launch_xml",
    ],
)

