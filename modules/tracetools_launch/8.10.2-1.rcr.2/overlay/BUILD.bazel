package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "mypy",
        "pep257",
        "xmllint",
    ]
]

py_library(
    name = "tracetools_launch",
    srcs = glob(["tracetools_launch/**/*.py"]),
    imports = ["."],
    deps = [
        "@launch",
        "@launch_ros",
        "@tracetools_trace",
    ],
)

py_pytest(
    name = "test_ld_preload_action",
    srcs = ["test/tracetools_launch/test_ld_preload_action.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    deps = [":tracetools_launch"],
)

py_pytest(
    name = "test_trace_action",
    srcs = ["test/tracetools_launch/test_trace_action.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    deps = [":tracetools_launch"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = [
        "launch/example.launch.py",
        "launch/example.launch.xml",
        "launch/example.launch.yaml",
        "launch/example_dual_session.launch.py",
        "launch/example_dual_session.launch.xml",
        "launch/example_dual_session.launch.yaml",
        "launch/example_snapshot_mode.launch.py",
        "launch/example_snapshot_mode.launch.xml",
        "launch/example_snapshot_mode.launch.yaml",
    ],
    package_xml = "package.xml",
    python = [":tracetools_launch"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@rosdistro//:ament_package",
        "@tracetools_trace//:ament_package",
    ],
)
