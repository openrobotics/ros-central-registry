load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = ["include/rcss3d_agent_basic/rcss3d_agent_basic_node.hpp"]

DEPENDENCIES = {
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rcss3d_agent//:rcss3d_agent": "@rcss3d_agent//:rcss3d_agent_library",
}

cc_library(
    name = "rcss3d_agent_basic_node_library",
    srcs = ["src/rcss3d_agent_basic_node.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rcss3d_agent_basic_node",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rcss3d_agent_basic_node_library"],
)

rclcpp_components_register_node(
    name = "rcss3d_agent_basic",
    component = ":rcss3d_agent_basic_node",
    data = [":ament_index"],
    node_name = "rcss3d_agent_basic",
    plugin = "rcss3d_agent_basic::Rcss3dAgentBasicNode",
)

### PACKAGING

ament_index(
    name = "ament_index",
    components = [":rcss3d_agent_basic_record"],
    libraries = [":rcss3d_agent_basic_node"],
    package_xml = "package.xml",
    deps = [
        "@rclcpp_components//:ament_package",
        "@rcss3d_agent//:ament_package",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rcss3d_agent",
        "rclcpp_components",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_rcss3d_agent_basic",
    executables = [":rcss3d_agent_basic"],
    headers = HEADERS,
    include_prefix = "",
    libraries = [":rcss3d_agent_basic_node"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rcss3d_agent//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
