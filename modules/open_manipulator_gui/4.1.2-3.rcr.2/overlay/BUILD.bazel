cc_library(
    name = "_gen_textual_hdrs",
    includes = ["_gen/include"],
    textual_hdrs = [],
)

cc_library(
    name = "open_manipulator_gui_library",
    hdrs = [
        "include/omx_f_gui/main_window.hpp",
        "include/omx_f_gui/qnode.hpp",
        "include/omy_3m_gui/main_window.hpp",
        "include/omy_3m_gui/qnode.hpp",
        "include/omy_f3m_gui/main_window.hpp",
        "include/omy_f3m_gui/qnode.hpp",
        "include/open_manipulator_x_gui/main_window.hpp",
        "include/open_manipulator_x_gui/qnode.hpp",
    ] + [
        ":gen_ui_omx_f_main_window_h",
        ":gen_ui_omy_3m_main_window_h",
        ":gen_ui_omy_f3m_main_window_h",
        ":gen_ui_open_manipulator_x_main_window_h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "ui",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

qt_cc_binary(
    name = "omx_f_gui_node",
    srcs = [
        "src/omx_f/main.cpp",
        "src/omx_f/main_window.cpp",
        "src/omx_f/qnode.cpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [":ament_index"],
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtsvg//:svg_shared",
        "@qtbase//:widgets_shared",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "ui",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    moc_hdrs = [
        "include/omx_f_gui/main_window.hpp",
        "include/omx_f_gui/qnode.hpp",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":open_manipulator_gui_library"],
)

