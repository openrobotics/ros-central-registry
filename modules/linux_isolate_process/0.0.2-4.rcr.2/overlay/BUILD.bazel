load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            "CHANGELOG.rst",
            "LICENSE",
            "README.md",
            "linux_isolate_process/__init__.py",
            "linux_isolate_process/__main__.py",
            "linux_isolate_process/isolate.py",
            "package.xml",
            "resource/linux_isolate_process",
            "setup.cfg",
            "setup.py",
            "test/test_copyright.py",
            "test/test_flake8.py",
            "test/test_pep257.py",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
    ]
]

py_library(
    name = "linux_isolate_process",
    srcs = [
        "linux_isolate_process/__init__.py",
        "linux_isolate_process/__main__.py",
        "linux_isolate_process/isolate.py",
    ],
    imports = ["."],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":linux_isolate_process"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
