load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@class_loader//:class_loader": "@class_loader//:class_loader_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@yasmin//:yasmin": "@yasmin//:yasmin_library",
    "@yasmin_ros//:yasmin_ros": "@yasmin_ros//:yasmin_ros_library",
    "@yasmin_viewer//:yasmin_viewer": "@yasmin_viewer//:yasmin_viewer_library",
}

CC_DEPS = [
    "@action_msgs//:cc",
    "@class_loader//:class_loader_headers",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
    "@rules_python//python/cc:current_py_cc_libs",
    "@yasmin_msgs//:cc",
]

exports_files([
    "__init__.py",
    "test_action_cancel.xml",
    "test_action_complete.xml",
    "test_factory_action_servers.py",
    "test_file_path_sm.xml",
    "test_fsm_metadata.xml",
    "test_included_sm.xml",
    "test_nested_sm.xml",
    "test_orthogonal_sm.xml",
    "test_plugins.xml",
    "test_remapping.xml",
    "test_simple_sm_1.xml",
    "test_simple_sm_2.xml",
    "test_simple_state.cpp",
    "test_simple_state.py",
    "test_yasmin_factory.cpp",
    "test_yasmin_factory.py",
])

cc_library(
    name = "yasmin_factory_test_states_library",
    srcs = ["test_simple_state.cpp"],
    hdrs = [],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = ["."],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + ["//:_test_root_headers"],
)

cc_shared_library(
    name = "yasmin_factory_test_states",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":yasmin_factory_test_states_library"],
)

cc_test(
    name = "test_yasmin_factory_cpp",
    srcs = ["test_yasmin_factory.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "__init__.py",
        "test_action_cancel.xml",
        "test_action_complete.xml",
        "test_factory_action_servers.py",
        "test_file_path_sm.xml",
        "test_fsm_metadata.xml",
        "test_included_sm.xml",
        "test_nested_sm.xml",
        "test_orthogonal_sm.xml",
        "test_plugins.xml",
        "test_remapping.xml",
        "test_simple_sm_1.xml",
        "test_simple_sm_2.xml",
        "test_simple_state.py",
        "test_yasmin_factory.py",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:yasmin_factory_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

py_pytest(
    name = "test_yasmin_factory",
    srcs = ["test_yasmin_factory.py"],
    data = ["//:ament_index"],
    deps = [
        "//:yasmin_factory_py",
        "@action_msgs//:py",
        "@ament_index_python",
        "@rclpy",
        "@yasmin//:yasmin_py",
        "@yasmin_msgs//:py",
        "@yasmin_ros//:yasmin_ros_py",
        "@yasmin_viewer//:yasmin_viewer_py",
    ],
)

py_pytest(
    name = "test_factory_action_servers",
    srcs = ["test_factory_action_servers.py"],
    data = ["//:ament_index"],
    deps = [
        "//:yasmin_factory_py",
        "@action_msgs//:py",
        "@ament_index_python",
        "@rclpy",
        "@yasmin//:yasmin_py",
        "@yasmin_msgs//:py",
        "@yasmin_ros//:yasmin_ros_py",
