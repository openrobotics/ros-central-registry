        "@class_loader//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rclpy//:ament_package",
        "@tinyxml2_vendor//:ament_package",
        "@yasmin//:ament_package",
        "@yasmin_msgs//:ament_package",
        "@yasmin_ros//:ament_package",
        "@yasmin_viewer//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "TinyXML2",
        "ament_index_cpp",
        "pluginlib",
        "pybind11",
        "rclcpp",
        "yasmin",
    ],
