load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/yasmin_factory/yasmin_factory.hpp",
        "include/yasmin_factory/yasmin_factory_action_server.hpp",
    ],
    includes = [
        ".",
        "include",
        "include/yasmin_factory",
    ],
)

DEPENDENCIES = {
    "@action_msgs//:cc_shared": "@action_msgs//:cc",
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@class_loader//:class_loader": "@class_loader//:class_loader_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@yasmin//:yasmin": "@yasmin//:yasmin_library",
    "@yasmin_msgs//:cc_shared": "@yasmin_msgs//:cc",
    "@yasmin_ros//:yasmin_ros": "@yasmin_ros//:yasmin_ros_library",
    "@yasmin_viewer//:yasmin_viewer": "@yasmin_viewer//:yasmin_viewer_library",
}

CC_DEPS = [
    "@class_loader//:class_loader_headers",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
    "@rules_python//python/cc:current_py_cc_libs",
]

cc_library(
    name = "yasmin_factory_library",
    srcs = ["src/yasmin_factory.cpp"],
    hdrs = [
        "include/yasmin_factory/yasmin_factory.hpp",
        "include/yasmin_factory/yasmin_factory_action_server.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/yasmin_factory",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "yasmin_factory",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":yasmin_factory_library"],
)

cc_library(
    name = "yasmin_pybind_bridge.cpython-314-x86_64-linux-gnu_library",
    srcs = ["src/pybind_bridge.cpp"],
    hdrs = [
        "include/yasmin_factory/yasmin_factory.hpp",
        "include/yasmin_factory/yasmin_factory_action_server.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/yasmin_factory",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "yasmin_pybind_bridge.cpython-314-x86_64-linux-gnu",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "yasmin_pybind_bridge.so",
    deps = [":yasmin_pybind_bridge.cpython-314-x86_64-linux-gnu_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":yasmin_factory",
        ":yasmin_pybind_bridge.cpython-314-x86_64-linux-gnu",
    ],
)

cc_binary(
    name = "yasmin_factory_action_server",
    srcs = ["src/yasmin_factory_action_server.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/yasmin_factory",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":yasmin_factory_library"],
)

cc_binary(
    name = "yasmin_factory_node",
    srcs = ["src/yasmin_factory_node.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/yasmin_factory",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":yasmin_factory_library"],
)

py_library(
    name = "yasmin_factory_py",
    srcs = [
        "yasmin_factory/__init__.py",
        "yasmin_factory/factory.py",
        "yasmin_factory/type_utils.py",
        "yasmin_factory/yasmin_factory_action_server.py",
        "yasmin_factory/yasmin_factory_node.py",
    ],
    imports = ["."],
    deps = [
        "@action_msgs//:py",
        "@ament_index_python",
        "@rclpy",
        "@yasmin//:yasmin_py",
        "@yasmin_msgs//:py",
        "@yasmin_ros//:yasmin_ros_py",
        "@yasmin_viewer//:yasmin_viewer_py",
        requirement("lxml"),
    ],
)

ament_index(
