    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_yasmin_factory",
    headers = [
        "include/yasmin_factory/yasmin_factory.hpp",
        "include/yasmin_factory/yasmin_factory_action_server.hpp",
    ],
    include_prefix = "",
    libraries = [
        ":yasmin_factory",
        "//test:yasmin_factory_test_states",
    ],
    package_xml = "package.xml",
    python = [":yasmin_factory_py"],
    deps = [":ament_index"] + [
        "@action_msgs//:ament_package",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
