load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@mrpt_hwdrivers//:mrpt_hwdrivers": "@mrpt_hwdrivers//:mrpt_hwdrivers_library",
    "@mrpt_slam//:mrpt_slam": "@mrpt_slam//:mrpt_slam_library",
    "@mrpt_topography//:mrpt_topography": "@mrpt_topography//:mrpt_topography_library",
    # CLI11 is a compiled library also used directly by downstream apps
    # (mrpt_apps_cli); link it dynamically so it is not duplicated.
    "@rosdistro//cc:cli11_shared": "@rosdistro//cc:cli11",
}

CC_DEPS = []

cc_library(
    name = "mrpt_libapps_cli_library",
    srcs = [
        "include/mrpt/apps_cli/BaseAppDataSource.h",
        "include/mrpt/apps_cli/BaseAppInitializableCLI.h",
        "include/mrpt/apps_cli/BaseAppInitializableConfig.h",
        "include/mrpt/apps_cli/CRawlogProcessor.h",
        "include/mrpt/apps_cli/DataSourceRawlog.h",
        "include/mrpt/apps_cli/MonteCarloLocalization_App.h",
        "include/mrpt/apps_cli/RawlogEditApp.h",
        "include/mrpt/apps_cli/RawlogGrabberApp.h",
        "include/mrpt/apps_cli/registerAllClasses.h",
        "src/DataSourceRawlog.cpp",
        "src/RawlogEditApp.cpp",
        "src/RawlogGrabberApp.cpp",
        "src/rawlog-edit_2d-scans.cpp",
        "src/rawlog-edit_anemometer.cpp",
        "src/rawlog-edit_camera-params.cpp",
        "src/rawlog-edit_cuts.cpp",
        "src/rawlog-edit_deexternalize.cpp",
        "src/rawlog-edit_describe.cpp",
        "src/rawlog-edit_enose.cpp",
        "src/rawlog-edit_export_txt.cpp",
        "src/rawlog-edit_externalize.cpp",
        "src/rawlog-edit_filters.cpp",
        "src/rawlog-edit_generate-3d-pointclouds.cpp",
        "src/rawlog-edit_gps.cpp",
        "src/rawlog-edit_gps_gas.cpp",
        "src/rawlog-edit_imu.cpp",
        "src/rawlog-edit_info.cpp",
        "src/rawlog-edit_list-images.cpp",
        "src/rawlog-edit_list-poses.cpp",
        "src/rawlog-edit_list-rangbear.cpp",
        "src/rawlog-edit_list-timestamps.cpp",
        "src/rawlog-edit_odometry.cpp",
        "src/rawlog-edit_rawdaq.cpp",
        "src/rawlog-edit_remap_timestamps.cpp",
        "src/rawlog-edit_rename_externals.cpp",
        "src/rawlog-edit_sensor-poses.cpp",
        "src/rawlog-edit_undistort.cpp",
        "src/registerAllClasses.cpp",
    ],
    hdrs = [
        "include/mrpt/apps_cli/BaseAppDataSource.h",
        "include/mrpt/apps_cli/BaseAppInitializableCLI.h",
        "include/mrpt/apps_cli/BaseAppInitializableConfig.h",
        "include/mrpt/apps_cli/CRawlogProcessor.h",
        "include/mrpt/apps_cli/DataSourceRawlog.h",
        "include/mrpt/apps_cli/MonteCarloLocalization_App.h",
        "include/mrpt/apps_cli/RawlogEditApp.h",
        "include/mrpt/apps_cli/RawlogGrabberApp.h",
        "include/mrpt/apps_cli/registerAllClasses.h",
        "src/rawlog-edit-declarations.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_libapps_cli",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mrpt_libapps_cli_library"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_libapps_cli",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_libapps_cli": [
            "libmrpt_libapps_cli.so.3.3",
            "libmrpt_libapps_cli.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_hwdrivers//:ament_package",
        "@mrpt_slam//:ament_package",
        "@mrpt_topography//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/mrpt/apps_cli/BaseAppDataSource.h",
        "include/mrpt/apps_cli/BaseAppInitializableCLI.h",
        "include/mrpt/apps_cli/BaseAppInitializableConfig.h",
        "include/mrpt/apps_cli/CRawlogProcessor.h",
        "include/mrpt/apps_cli/DataSourceRawlog.h",
        "include/mrpt/apps_cli/MonteCarloLocalization_App.h",
        "include/mrpt/apps_cli/RawlogEditApp.h",
        "include/mrpt/apps_cli/RawlogGrabberApp.h",
        "include/mrpt/apps_cli/registerAllClasses.h",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mrpt_libapps_cli",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_libapps_cli": [
            "libmrpt_libapps_cli.so.3.3",
            "libmrpt_libapps_cli.so.3.3.1",
        ],
    },
    deps = [":ament_index"] + [
        "@mrpt_hwdrivers//:ament_package",
        "@mrpt_slam//:ament_package",
        "@mrpt_topography//:ament_package",
    ],
)
