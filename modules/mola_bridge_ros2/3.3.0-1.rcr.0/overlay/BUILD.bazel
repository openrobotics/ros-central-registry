load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
)

DEPENDENCIES = {
    "@diagnostic_msgs//:cc_shared": "@diagnostic_msgs//:cc",
    "@geographic_msgs//:cc_shared": "@geographic_msgs//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@gps_msgs//:cc_shared": "@gps_msgs//:cc",
    "@mola_kernel//:mola_kernel": "@mola_kernel//:mola_kernel_library",
    "@mola_msgs//:cc_shared": "@mola_msgs//:cc",
    "@mrpt_libros_bridge//:mrpt_libros_bridge": "@mrpt_libros_bridge//:mrpt_libros_bridge_library",
    "@mrpt_maps//:mrpt_maps": "@mrpt_maps//:mrpt_maps_library",
    "@mrpt_nav_interfaces//:cc_shared": "@mrpt_nav_interfaces//:cc",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
}

HEADERS = ["include/mola_bridge_ros2/BridgeROS2.h"]

cc_library(
    name = "mola_bridge_ros2_library",
    srcs = ["src/BridgeROS2.cpp"],
    hdrs = HEADERS,
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/mola_bridge_ros2",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "HAS_GPS_MSGS",
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=3",
        "MOLA_PATCH_VERSION=0",
        "MRPT_ROS2_BRIDGE_VERSION=0x040000",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "mola_bridge_ros2",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mola_bridge_ros2_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":mola_bridge_ros2"],
)

### PACKAGING

ament_index(
    name = "ament_index",
    libraries = [":mola_bridge_ros2"],
    package_xml = "package.xml",
    sonames = {"mola_bridge_ros2": [
        "libmola_bridge_ros2.so.3.3",
        "libmola_bridge_ros2.so.3.3.0",
    ]},
    deps = [
        "@diagnostic_msgs//:ament_package",
        "@geographic_msgs//:ament_package",
        "@geometry_msgs//:ament_package",
        "@gps_msgs//:ament_package",
        "@mola_common//:ament_package",
        "@mola_kernel//:ament_package",
        "@mola_msgs//:ament_package",
        "@mrpt_libros_bridge//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_nav_interfaces//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = HEADERS,
    include_prefix = "",
    libraries = [":mola_bridge_ros2"],
    package_xml = "package.xml",
    sonames = {"mola_bridge_ros2": [
        "libmola_bridge_ros2.so.3.3",
        "libmola_bridge_ros2.so.3.3.0",
    ]},
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_cmake//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@geographic_msgs//:ament_package",
        "@geometry_msgs//:ament_package",
        "@gps_msgs//:ament_package",
        "@mola_common//:ament_package",
        "@mola_kernel//:ament_package",
        "@mola_msgs//:ament_package",
        "@mrpt_libros_bridge//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_nav_interfaces//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_environment//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
    ],
)
