load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = ["include/rcss3d_agent/rcss3d_agent.hpp"]

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcss3d_agent_msgs//:cc_shared": "@rcss3d_agent_msgs//:cc",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

cc_library(
    name = "rcss3d_agent_library",
    srcs = [
        "src/connection.cpp",
        "src/rcss3d_agent.cpp",
        "src/sexp_creator.cpp",
        "src/sexp_parser.cpp",
        "src/sexp_vision.cpp",
        "src/socket.cpp",
        "src/socketaddress.cpp",
    ] + [
        "src/connection.hpp",
        "src/sexp_creator.hpp",
        "src/sexp_parser.hpp",
        "src/sexp_vision.hpp",
        "src/socket.hpp",
        "src/socketaddress.hpp",
    ] + [
        "external/sexpresso/sexpresso/sexpresso.cpp",
        "external/sexpresso/sexpresso/sexpresso.hpp",
    ],
    hdrs = HEADERS,
    includes = [
        "external/sexpresso",
        "include",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rcss3d_agent",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rcss3d_agent_library"],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rclcpp",
        "rcss3d_agent_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_rcss3d_agent",
    headers = HEADERS,
    include_prefix = "",
    libraries = [":rcss3d_agent"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rcss3d_agent_msgs//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
