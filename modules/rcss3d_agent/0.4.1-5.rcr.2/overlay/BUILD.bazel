load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

cc_library(
    name = "rcss3d_agent_library",
    srcs = glob(["src/*.cpp"]) + glob(["src/*.hpp"]) + [
        "external/sexpresso/sexpresso/sexpresso.cpp",
        "external/sexpresso/sexpresso/sexpresso.hpp",
    ],
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = [
        "external/sexpresso",
        "include",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@rcss3d_agent_msgs//:cc",
    ],
)

cc_shared_library(
    name = "rcss3d_agent",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rcss3d_agent_library"],
    deps = [":rcss3d_agent_library"],
)

### TESTS

[
    cc_test(
        name = test,
        srcs = ["test/{}.cpp".format(test)],
        copts = ["-std=c++17"],
        dynamic_deps = [":rcss3d_agent"],
        deps = [
            ":rcss3d_agent_library",
            "@rosdistro//cc:googletest",
        ],
    )
    for test in [
        "test_sexp_creator",
        "test_sexp_parser",
        "test_sexp_vision",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rclcpp",
        "rcss3d_agent_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_rcss3d_agent",
    headers = HEADERS,
    include_prefix = "",
    libraries = [":rcss3d_agent"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rcss3d_agent_msgs//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
