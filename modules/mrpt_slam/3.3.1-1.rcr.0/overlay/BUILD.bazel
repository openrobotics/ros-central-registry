cc_shared_library(
    name = "_bindings.cpython-314-x86_64-linux-gnu",
    dynamic_deps = DEPENDENCIES.keys(),
    shared_lib_name = "mrpt/slam/_bindings.so",
    deps = [":_bindings.cpython-314-x86_64-linux-gnu_library"],
)

py_library(
    name = "mrpt",
    srcs = ["python/mrpt/slam/__init__.py"],
    imports = ["python"],
    deps = [
        "@mrpt_maps//:mrpt",
        "@mrpt_topography//:mrpt",
    ],
)

expand_template(
    name = "config_h",
    out = "_gen/include/mrpt/slam/config.h",
    substitutions = {
        "${CMAKE_MRPT_HAS_TBB}": "1",
    },
    template = "config.h.in",
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_slam",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_slam": [
            "libmrpt_slam.so.3.3",
            "libmrpt_slam.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_maps//:ament_package",
        "@mrpt_topography//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
