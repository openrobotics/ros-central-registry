cc_shared_library(
    name = "ublox_dgnss_components",
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@rcl_interfaces//:cc_shared",
        "@rtcm_msgs//:cc_shared",
        "@std_msgs//:cc_shared",
        "@ublox_ubx_interfaces//:cc_shared",
        "@ublox_ubx_msgs//:cc_shared",
    ],
    deps = [":ublox_dgnss_components_library"],
)

rclcpp_components_register_node(
    name = "ublox_dgnss_node",
    component = ":ublox_dgnss_components",
    node_name = "ublox_dgnss_node",
    plugin = "ublox_dgnss::UbloxDGNSSNode",
)

ament_index(
    name = "ament_index",
    components = [":ublox_dgnss_node_record"],
    lib_data = [":ublox_dgnss_node"],
    libraries = [":ublox_dgnss_components"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
