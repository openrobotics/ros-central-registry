load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@diagnostic_msgs//:cc_shared": "@diagnostic_msgs//:cc",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:curl": "@rosdistro//cc:curl_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

CC_DEPS = [
]

cc_library(
    name = "influx_component_library",
    srcs = ["src/influxdb_connector.cpp"],
    hdrs = [
        "include/diagnostic_remote_logging/influx_line_protocol.hpp",
        "include/diagnostic_remote_logging/influxdb_connector.hpp",
    ],
    includes = [
        ".",
        "include",
        "include/diagnostic_remote_logging",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "influx_component",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":influx_component_library"],
)

rclcpp_components_register_node(
    name = "influxdb_connector",
    component = ":influx_component",
    node_name = "influxdb_connector",
    plugin = "InfluxDBConnector",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":influx_component"],
)

ament_index(
    name = "ament_index",
    components = [":influxdb_connector_record"],
    lib_data = [":influxdb_connector"],
    libraries = [":influx_component"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@rclcpp_components//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "CURL",
        "ament_cmake",
        "diagnostic_msgs",
        "influx_component",
        "rclcpp",
        "rclcpp_components",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_influx_component",
    libraries = [":influx_component"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@rclcpp_components//:ament_package",
    ],
)
