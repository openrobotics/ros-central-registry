load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@io_context//:io_context": "@io_context//:io_context_library",
    "@off_highway_premium_radar_sample_msgs//:cc_shared": "@off_highway_premium_radar_sample_msgs//:cc",
    "@pcl_conversions//:pcl_conversions": "@pcl_conversions//:pcl_conversions_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:asio": "@rosdistro//cc:asio_library",
    "@rosdistro//cc:boost.filesystem_shared": "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.iostreams_shared": "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:pcl": "@rosdistro//cc:pcl_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:pcl_common",
    "@rosdistro//cc:pcl_io",
    "@rosdistro//cc:pcl_octree",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_library(
    name = "off_highway_premium_radar_sample_library",
    srcs = [
        "src/converters/default_converter.cpp",
        "src/driver.cpp",
        "src/location_data_handler.cpp",
        "src/node.cpp",
        "src/pdu_definitions.cpp",
        "src/udp_socket.cpp",
    ],
    hdrs = [
        "include/off_highway_premium_radar_sample/converters/default_converter.hpp",
        "include/off_highway_premium_radar_sample/converters/pcl_radar_point_type.hpp",
        "include/off_highway_premium_radar_sample/driver.hpp",
        "include/off_highway_premium_radar_sample/impl/node_impl.hpp",
        "include/off_highway_premium_radar_sample/interface/converter.hpp",
        "include/off_highway_premium_radar_sample/interface/receiver.hpp",
        "include/off_highway_premium_radar_sample/interface/sender.hpp",
        "include/off_highway_premium_radar_sample/location_data_handler.hpp",
        "include/off_highway_premium_radar_sample/node.hpp",
        "include/off_highway_premium_radar_sample/pdu_definitions.hpp",
        "include/off_highway_premium_radar_sample/range.hpp",
        "include/off_highway_premium_radar_sample/udp_socket.hpp",
        "src/converters/ros_message_conversions.hpp",
        "src/helper.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/off_highway_premium_radar_sample",
    ],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "off_highway_premium_radar_sample",
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@geometry_msgs//:cc_shared",
        "@off_highway_premium_radar_sample_msgs//:cc_shared",
        "@sensor_msgs//:cc_shared",
        "@std_msgs//:cc_shared",
    ],
    deps = [":off_highway_premium_radar_sample_library"],
)

rclcpp_components_register_node(
    name = "driver",
    component = ":off_highway_premium_radar_sample",
    node_name = "driver",
    plugin = "off_highway_premium_radar_sample::NodeWithDefaultConverter",
)

ament_index(
    name = "ament_index",
    components = [":driver_record"],
    data = [
        "config/driver.yaml",
        "//launch:launch_files",
    ],
    lib_data = [":driver"],
    libraries = [":off_highway_premium_radar_sample"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@asio_cmake_module//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@geometry_msgs//:ament_package",
        "@io_context//:ament_package",
        "@off_highway_premium_radar_sample_msgs//:ament_package",
        "@pcl_conversions//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
    ],
)

ament_package(
    cmake = ["cmake/off_highway_premium_radar_sample-extras.cmake"],
    cmake_export_dependencies_list = [
        "ASIO",
        "PCL",
        "diagnostic_updater",
        "io_context",
        "off_highway_premium_radar_sample_msgs",
        "pcl_conversions",
        "rclcpp",
        "rclcpp_components",
        "sensor_msgs",
        "std_msgs",
        "tf2",
        "tf2_geometry_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_off_highway_premium_radar_sample",
    cmake_extras = ["off_highway_premium_radar_sample-extras.cmake"],
    headers = [
        "include/off_highway_premium_radar_sample/converters/default_converter.hpp",
        "include/off_highway_premium_radar_sample/converters/pcl_radar_point_type.hpp",
        "include/off_highway_premium_radar_sample/driver.hpp",
        "include/off_highway_premium_radar_sample/impl/node_impl.hpp",
        "include/off_highway_premium_radar_sample/interface/converter.hpp",
        "include/off_highway_premium_radar_sample/interface/receiver.hpp",
        "include/off_highway_premium_radar_sample/interface/sender.hpp",
        "include/off_highway_premium_radar_sample/location_data_handler.hpp",
        "include/off_highway_premium_radar_sample/node.hpp",
        "include/off_highway_premium_radar_sample/pdu_definitions.hpp",
        "include/off_highway_premium_radar_sample/range.hpp",
        "include/off_highway_premium_radar_sample/udp_socket.hpp",
    ],
    include_prefix = "",
    libraries = [":off_highway_premium_radar_sample"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@asio_cmake_module//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@geometry_msgs//:ament_package",
        "@io_context//:ament_package",
        "@off_highway_premium_radar_sample_msgs//:ament_package",
        "@pcl_conversions//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
    ],
)
