load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@broll//:broll": "@broll//:broll_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosbag2_transport//:rosbag2_transport": "@rosbag2_transport//:rosbag2_transport_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "bag_utils_library",
    srcs = ["src/bag_utils.cpp"],
    hdrs = ["include/rosbag2_storage_broll/bag_utils.hpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/rosbag2_storage_broll",
    ],
    local_defines = ros_local_defines() + [
        "ROS2_ROLLING",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "bag_utils",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":bag_utils_library"],
)

cc_library(
    name = "rosbag2_storage_broll_library",
    srcs = ["src/broll_storage.cpp"],
    hdrs = ["include/rosbag2_storage_broll/bag_utils.hpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/rosbag2_storage_broll",
    ],
    local_defines = ros_local_defines() + [
        "ROS2_ROLLING",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":bag_utils_library"],
)

cc_shared_library(
    name = "rosbag2_storage_broll",
    dynamic_deps = DEPENDENCIES.keys() + [":bag_utils"],
    exports_filter = ["//:__subpackages__"],
    deps = [":rosbag2_storage_broll_library"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":bag_utils",
        ":rosbag2_storage_broll",
    ],
    package_xml = "package.xml",
    plugin_category = "rosbag2_storage",
    plugins = ["rosbag2_storage_plugin.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@broll//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_transport//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = ["rosbag2_transport"],
    cmake_export_include_directories = False,
    cmake_export_name = "export_rosbag2_storage_broll",
    headers = ["include/rosbag2_storage_broll/bag_utils.hpp"],
    libraries = [
        ":bag_utils",
        ":rosbag2_storage_broll",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@broll//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_transport//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
