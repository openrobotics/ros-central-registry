load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@ros2_medkit_gateway//:test_bad_version_plugin": "@ros2_medkit_gateway//:test_bad_version_plugin_library",
    "@ros2_medkit_gateway//:test_gateway_plugin": "@ros2_medkit_gateway//:test_gateway_plugin_library",
    "@ros2_medkit_gateway//:test_minimal_plugin": "@ros2_medkit_gateway//:test_minimal_plugin_library",
    "@ros2_medkit_gateway//:test_no_symbols_plugin": "@ros2_medkit_gateway//:test_no_symbols_plugin_library",
    "@ros2_medkit_gateway//:test_null_factory_plugin": "@ros2_medkit_gateway//:test_null_factory_plugin_library",
    "@ros2_medkit_gateway//:test_update_backend": "@ros2_medkit_gateway//:test_update_backend_library",
    "@ros2_medkit_gateway//:test_version_only_plugin": "@ros2_medkit_gateway//:test_version_only_plugin_library",
    "@ros2_medkit_msgs//:cc_shared": "@ros2_medkit_msgs//:cc",
    "@rosdistro//cc:boringssl": "@rosdistro//cc:boringssl_crypto_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:sqlite3": "@rosdistro//cc:sqlite3_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:nlohmann_json",
]

cc_library(
    name = "beacon_common_lib_library",
    srcs = [
        "src/beacon_entity_mapper.cpp",
        "src/beacon_hint_store.cpp",
        "src/beacon_response_builder.cpp",
        "src/beacon_validator.cpp",
    ],
    hdrs = [
        "include/ros2_medkit_beacon_common/beacon_entity_mapper.hpp",
        "include/ros2_medkit_beacon_common/beacon_hint_store.hpp",
        "include/ros2_medkit_beacon_common/beacon_response_builder.hpp",
        "include/ros2_medkit_beacon_common/beacon_types.hpp",
        "include/ros2_medkit_beacon_common/beacon_validator.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/ros2_medkit_beacon_common",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

genrule(
    name = "static_beacon_common_lib_a",
    srcs = [":beacon_common_lib_library"],
    outs = ["libbeacon_common_lib.a"],
    cmd = "for f in $(SRCS); do case $$f in *.a) cp $$f $@; exit 0;; esac; done; ar rcs $@",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    libraries = [":static_beacon_common_lib_a"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@ros2_medkit_cmake//:ament_package",
        "@ros2_medkit_gateway//:ament_package",
        "@ros2_medkit_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "nlohmann_json",
        "rclcpp",
        "ros2_medkit_gateway",
        "ros2_medkit_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/ros2_medkit_beacon_common/beacon_entity_mapper.hpp",
        "include/ros2_medkit_beacon_common/beacon_hint_store.hpp",
        "include/ros2_medkit_beacon_common/beacon_response_builder.hpp",
        "include/ros2_medkit_beacon_common/beacon_types.hpp",
        "include/ros2_medkit_beacon_common/beacon_validator.hpp",
    ],
    include_prefix = "",
    libraries = [":static_beacon_common_lib_a"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@ros2_medkit_cmake//:ament_package",
        "@ros2_medkit_gateway//:ament_package",
        "@ros2_medkit_msgs//:ament_package",
    ],
)
