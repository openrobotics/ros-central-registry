cc_library(
    name = "easynav_sensors_library",
    srcs = [
        "src/easynav_sensors/SensorsNode.cpp",
        "src/easynav_sensors/types/DetectionsPerception.cpp",
        "src/easynav_sensors/types/GNSSPerception.cpp",
        "src/easynav_sensors/types/IMUPerception.cpp",
        "src/easynav_sensors/types/ImagePerception.cpp",
        "src/easynav_sensors/types/OdometryPerception.cpp",
        "src/easynav_sensors/types/PointPerception.cpp",
    ],
    hdrs = [
        "include/easynav_sensors/SensorsNode.hpp",
        "include/easynav_sensors/types/DetectionsPerception.hpp",
        "include/easynav_sensors/types/GNSSPerception.hpp",
        "include/easynav_sensors/types/IMUPerception.hpp",
        "include/easynav_sensors/types/ImagePerception.hpp",
        "include/easynav_sensors/types/OdometryPerception.hpp",
        "include/easynav_sensors/types/Perceptions.hpp",
        "include/easynav_sensors/types/PointPerception.hpp",
    ],
    includes = [
        "include",
        "include/easynav_sensors",
        "tests",
    ],
    local_defines = ros_local_defines() + [
        "EASYNAV_DEBUG_WITH_YAETS",
        "GLAD_API_CALL_EXPORT",
        "TBB_USE_DEBUG",
        "TINYXML2_DEBUG",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "easynav_sensors",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":easynav_sensors_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":easynav_sensors"],
)

ament_index(
    name = "ament_index",
    libraries = [":easynav_sensors"],
    package_xml = "package.xml",
    plugins = ["easynav_sensors_perception_handler_plugins.xml"],
