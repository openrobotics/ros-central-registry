load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "_event_camera_py_library",
    srcs = ["src/decoder.cpp"],
    hdrs = [
        "include/event_camera_py/accumulator.h",
        "include/event_camera_py/accumulator_unique.h",
        "include/event_camera_py/decoder.h",
        "include/event_camera_py/event_cd.h",
        "include/event_camera_py/event_ext_trig.h",
    ],
    includes = ["include"],
    deps = [
        "@event_camera_codecs//:codec_library",
        "@event_camera_msgs//:cc",
        "@rosdistro//cc:pybind11",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_shared_library(
    name = "_event_camera_py",
    dynamic_deps = ["@event_camera_codecs//:codec"],
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "event_camera_py/_event_camera_py.so",
    deps = [":_event_camera_py_library"],
)

py_library(
    name = "event_camera_py",
    srcs = ["event_camera_py/__init__.py"],
    data = [":_event_camera_py"],
    imports = ["."],
    deps = ["@rpyutils"],
)

ament_index(
    name = "ament_index_test",
    testonly = True,
    package_xml = "package.xml",
    deps = [
        "@event_camera_msgs//:ament_index",
        "@rosbag2_py//:ament_index",
        "@rosbag2_storage_default_plugins//:ament_index",
        "@rosbag2_storage_mcap//:ament_index",
    ],
)

ament_package(
    name = "ament_package",
    build_type = "ament_cmake",
    cmake_export_dependencies = False,
    package_xml = "package.xml",
    python = [
        ":event_camera_py",
        ":_event_camera_py",
    ],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@event_camera_codecs//:ament_package",
        "@event_camera_msgs//:ament_package",
        "@pybind11_vendor//:ament_package",
        "@python_cmake_module//:ament_package",
        "@rclpy//:ament_package",
        "@ros_environment//:ament_package",
        "@rosbag2_py//:ament_package",
        "@rosbag2_storage_default_plugins//:ament_package",
        "@rosbag2_storage_mcap//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_py//:ament_package",
        "@rpyutils//:ament_package",
    ],
)
