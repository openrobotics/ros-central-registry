load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

py_library(
    name = "test_helpers",
    testonly = True,
    srcs = [
        "bag_reader_ros2.py",
        "event_counter.py",
        "test_verify.py",
    ],
    imports = ["."],
    deps = [
        "//:event_camera_py",
        requirement("numpy"),
        "@event_camera_msgs//:py",
        "@rclpy",
        "@rosbag2_py",
        "@rosidl_runtime_py",
    ],
)

[py_pytest(
    name = test.removesuffix(".py"),
    srcs = ["{0}.py".format(test)],
    data = [
        "test_events_1/metadata.yaml",
        "test_events_1/test_events_1.db3",
        "test_events_2/metadata.yaml",
        "test_events_2/test_events_2_0.mcap",
    ] + ["//:ament_index_test"],
    env = {"ROS_VERSION": "2"},
    deps = [
        ":test_helpers",
        "//:event_camera_py",
    ],
) for test in [
    "test_1",
    "test_2",
]]
