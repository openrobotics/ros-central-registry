load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

default_generators(
    package_xml = "package.xml",
    deps = [
        "//action:SetMode",
        "//msg:OperationalMode",
        "//msg:ProgramInformation",
        "//msg:ProgramState",
        "//msg:RobotMode",
        "//msg:SafetyMode",
        "//msg:SafetyStatus",
        "//msg:UserRole",
        "//msg:VersionInformation",
        "//srv:AddToLog",
        "//srv:DownloadProgram",
        "//srv:DownloadSupportFile",
        "//srv:GenerateFlightReport",
        "//srv:GenerateSupportFile",
        "//srv:GetLoadedProgram",
        "//srv:GetOperationalMode",
        "//srv:GetPolyScopeVersion",
        "//srv:GetProgramState",
        "//srv:GetPrograms",
        "//srv:GetRobotMode",
        "//srv:GetRobotModel",
        "//srv:GetSafetyMode",
        "//srv:GetSafetyStatus",
        "//srv:GetSerialNumber",
        "//srv:GetUserRole",
        "//srv:IsInRemoteControl",
        "//srv:IsProgramRunning",
        "//srv:IsProgramSaved",
        "//srv:Load",
        "//srv:Popup",
        "//srv:RawRequest",
        "//srv:SetOperationalMode",
        "//srv:SetUserRole",
        "//srv:UploadProgram",
    ],
)

### PACKAGING

rosidl_ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@action_msgs//:ament_package",
        "@ament_cmake//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
    ],
)
