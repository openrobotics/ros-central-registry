load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

# Mirrors ament_package(CONFIG_EXTRAS "test_interface_files-extras.cmake.in"): configure_file(@ONLY) of the template.
genrule(
    name = "extras_cmake",
    srcs = ["test_interface_files-extras.cmake.in"],
    outs = ["test_interface_files-extras.cmake"],
    cmd = "sed -e 's|@msg_files@|msg/Arrays.msg;msg/BasicTypes.msg;msg/BoundedPlainSequences.msg;msg/BoundedSequences.msg;msg/Constants.msg;msg/Defaults.msg;msg/Empty.msg;msg/MultiNested.msg;msg/Nested.msg;msg/Strings.msg;msg/UnboundedSequences.msg;msg/WStrings.msg|g' -e 's|@srv_files@|srv/Arrays.srv;srv/BasicTypes.srv;srv/Empty.srv|g' -e 's|@action_files@|action/Fibonacci.action|g' -e 's|@idl_files@||g' -e 's|@PROJECT_NAME@|test_interface_files|g' -e 's|@PYTHON_INSTALL_DIR@|lib/python3.14/site-packages|g' $< > $@",
)

INTERFACE_FILES = [
    "//action:Fibonacci.action",
    "//msg:Arrays.msg",
    "//msg:BasicTypes.msg",
    "//msg:BoundedPlainSequences.msg",
    "//msg:BoundedSequences.msg",
    "//msg:Constants.msg",
    "//msg:Defaults.msg",
    "//msg:Empty.msg",
    "//msg:MultiNested.msg",
    "//msg:Nested.msg",
    "//msg:Strings.msg",
    "//msg:UnboundedSequences.msg",
    "//msg:WStrings.msg",
    "//srv:Arrays.srv",
    "//srv:BasicTypes.srv",
    "//srv:Empty.srv",
]

# install(FILES ... DESTINATION share/<pkg>/{msg,srv,action}); not `data`, since this
# package only ships the raw interface files and does not generate (or register)
# rosidl interfaces itself.

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = [
        ":extras_cmake",
    ],
    cmake_extras = ["test_interface_files-extras.cmake"],
    data = INTERFACE_FILES,
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_core//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
