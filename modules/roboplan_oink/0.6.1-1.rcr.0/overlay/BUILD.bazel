write_file(
    name = "gen_proxsuite_dense_hpp",
    out = "_gen/include/proxsuite/proxqp/dense/dense.hpp",
    content = ["#pragma once\n#include <optional>\n#include <Eigen/Core>\nnamespace proxsuite {\ninline constexpr std::nullopt_t nullopt = std::nullopt;\nnamespace proxqp {\nenum class InitialGuessStatus { NO_INITIAL_GUESS, WARM_START_WITH_PREVIOUS_RESULT };\nenum class QPSolverOutput {\n  PROXQP_SOLVED,\n  PROXQP_SOLVED_CLOSEST_PRIMAL_FEASIBLE,\n  PROXQP_MAX_ITER_REACHED,\n  PROXQP_PRIMAL_INFEASIBLE,\n  PROXQP_DUAL_INFEASIBLE,\n};\nnamespace dense {\ntemplate <typename T>\nclass QP {\npublic:\n  struct Settings {\n    T eps_abs = 1e-5;\n    T eps_rel = 0;\n    long max_iter = 10000;\n    bool verbose = false;\n    bool primal_infeasibility_solving = false;\n    InitialGuessStatus initial_guess = InitialGuessStatus::NO_INITIAL_GUESS;\n  } settings;\n  struct Results {\n    struct Info {\n      QPSolverOutput status = QPSolverOutput::PROXQP_SOLVED;\n    } info;\n    Eigen::Matrix<T, Eigen::Dynamic, 1> x;\n  } results;\n  QP(long n, long, long) { results.x = Eigen::Matrix<T, Eigen::Dynamic, 1>::Zero(n); }\n  template <typename... Args> void init(Args&&...) {}\n  template <typename... Args> void update(Args&&...) {}\n  void solve() {}\n};\n}  // namespace dense\n}  // namespace proxqp\n}  // namespace proxsuite\n"],
)

write_file(
    name = "gen_nanobind_h",
    out = "_gen/include/nanobind/nanobind.h",
    content = ["#ifndef RCR_NANOBIND_H_\n#define RCR_NANOBIND_H_\n#include <utility>\nnamespace nanobind {\nnamespace literals {}\nstruct module_ {\n  template <typename V>\n  struct attr_proxy {\n    attr_proxy & operator=(const V &) { return *this; }\n  };\n  attr_proxy<const char *> attr(const char *) { return {}; }\n  template <typename F, typename... Extra>\n  module_ & def(const char *, F &&, const Extra &...) { return *this; }\n};\n}  // namespace nanobind\n#define NB_MODULE(name, var) \\\n  static void nb_init_##name(::nanobind::module_ &); \\\n  extern \"C\" __attribute__((visibility(\"default\"))) void * PyInit_##name() { \\\n    static ::nanobind::module_ m; \\\n    nb_init_##name(m); \\\n    return nullptr; \\\n  } \\\n  static void nb_init_##name(::nanobind::module_ & var)\n#endif\n"],
)

write_file(
