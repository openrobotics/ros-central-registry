l StringtoDumpFormatType(const std::string &, DumpFormatType * v) { if (v) *v = CONSOLE; return true; }\nusing ResidualBlockId = void *;\nclass LossFunction {\n public:\n  virtual ~LossFunction() = default;\n  virtual void Evaluate(double s, double out[3]) const { out[0] = s; out[1] = 1.0; out[2] = 0.0; }\n};\nclass TrivialLoss : public LossFunction {\n public:\n  TrivialLoss() = default;\n};\nclass HuberLoss : public LossFunction {\n public:\n  explicit HuberLoss(double) {}\n};\nclass SoftLOneLoss : public LossFunction {\n public:\n  explicit SoftLOneLoss(double) {}\n};\nclass CauchyLoss : public LossFunction {\n public:\n  explicit CauchyLoss(double) {}\n};\nclass ArctanLoss : public LossFunction {\n public:\n  explicit ArctanLoss(double) {}\n};\nclass TolerantLoss : public LossFunction {\n public:\n  TolerantLoss(double, double) {}\n};\nclass TukeyLoss : public LossFunction {\n public:\n  explicit TukeyLoss(double) {}\n};\nclass ScaledLoss : public LossFunction {\n public:\n  ScaledLoss(const LossFunction *, double, Ownership) {}\n};\nclass ComposedLoss : public LossFunction {\n public:\n  ComposedLoss(const LossFunction *, Ownership, const LossFunction *, Ownership) {}\n};\nclass LocalParameterization {\n public:\n  virtual ~LocalParameterization() = default;\n  virtual bool Plus(const double * x, const double * delta, double * x_plus_delta) const = 0;\n  virtual bool ComputeJacobian(const double * x, double * jacobian) const = 0;\n  virtual bool MultiplyByJacobian(const double *, int, const double *, double *) const { return true; }\n  virtual int GlobalSize() const = 0;\n  virtual int LocalSize() const = 0;\n};\nclass Manifold {\n public:\n  virtual ~Manifold() = default;\n  virtual int AmbientSize() const = 0;\n  virtual int TangentSize() const = 0;\n  virtual bool Plus(const double * x, const double * delta, double * x_plus_delta) const = 0;\n  virtual bool PlusJacobian(const double * x, double * jacobian) const = 0;\n  virtual bool RightMultiplyByPlusJacobian(const double *, int, const double *, double *) const { return true; }\n  virtual bool Minus(const double * y, const double * x, double * y_minus_x) const = 0;\n  virtual bool MinusJacobian(const double * x, double * jacobian) const = 0;\n};\ntemplate <typename Functor, int kAmbientSize, int kTangentSize>\nclass AutoDiffManifold : public Manifold {\n public:\n  AutoDiffManifold() : functor_(new Functor()) {}\n  explicit AutoDiffManifold(Functor * functor) : functor_(functor) {}\n  int AmbientSize() const override { return kAmbientSize; }\n  int TangentSize() const override { return kTangentSize; }\n  bool Plus(const double * x, const double * delta, double * x_plus_delta) const override {\n    return functor_->Plus(x, delta, x_plus_delta);\n  }\n  bool PlusJacobian(const double *, double * jacobian) const override {\n    if (jacobian) std::fill_n(jacobian, kAmbientSize * kTangentSize, 0.0);\n    return true;\n  }\n  bool Minus(const double * y, const double * x, double * y_minus_x) const override {\n    return functor_->Minus(y, x, y_minus_x);\n  }\n  bool MinusJacobian(const double *, double * jacobian) const override {\n    if (jacobian) std::fill_n(jacobian, kTangentSize * kAmbientSize, 0.0);\n    return true;\n  }\n private:\n  std::unique_ptr<Functor> functor_;\n};\nenum DimensionType { DYNAMIC = -1 };\nclass CostFunction {\n public:\n  virtual ~CostFunction() = default;\n  virtual bool Evaluate(double const* const* parameters, double* residuals, double** jacobians) const = 0;\n  const std::vector<int32_t> & parameter_block_sizes() const { return parameter_block_sizes_; }\n  int num_residuals() const { return num_residuals_; }\n protected:\n  std::vector<int32_t> * mutable_parameter_block_sizes() { return &parameter_block_sizes_; }\n  void set_num_residuals(int num_residuals) { num_residuals_ = num_residuals; }\n private:\n  std::vector<int32_t> parameter_block_sizes_;\n  int num_residuals_{0};\n};\ntemplate <int kNumResiduals, int N0 = 0, int N1 = 0, int N2 