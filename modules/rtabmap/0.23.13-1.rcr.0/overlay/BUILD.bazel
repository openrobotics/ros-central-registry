# Equivalents of CMake's generate_export_header() output for each library.
# rtabmap_core/rtabmap_gui use DEPRECATED_MACRO_NAME RTABMAP_DEPRECATED, and
# rtabmap_utilite uses BASE_NAME utilite (-> UTILITE_EXPORT).
[
    write_file(
        name = name + "_export_h",
        out = "_gen/include/rtabmap/{}/{}_export.h".format(subdir, name),
        content = [
            "#ifndef {}_EXPORT_H".format(name.upper()),
            "#define {}_EXPORT_H".format(name.upper()),
            "",
            "#ifdef {}_STATIC_DEFINE".format(name.upper()),
            "#  define {}_EXPORT".format(name.upper()),
            "#  define {}_NO_EXPORT".format(name.upper()),
            "#else",
            "#  ifndef {}_EXPORT".format(name.upper()),
            "#    define {}_EXPORT __attribute__((visibility(\"default\")))".format(name.upper()),
            "#  endif",
            "#  ifndef {}_NO_EXPORT".format(name.upper()),
            "#    define {}_NO_EXPORT __attribute__((visibility(\"hidden\")))".format(name.upper()),
            "#  endif",
            "#endif",
            "",
            "#ifndef {}".format(deprecated),
            "#  define {} __attribute__ ((__deprecated__))".format(deprecated),
            "#endif",
            "",
            "#ifndef {}_DEPRECATED_EXPORT".format(name.upper()),
            "#  define {}_DEPRECATED_EXPORT {}_EXPORT {}".format(
                name.upper(),
                name.upper(),
                deprecated,
            ),
            "#endif",
            "",
            "#ifndef {}_DEPRECATED_NO_EXPORT".format(name.upper()),
            "#  define {}_DEPRECATED_NO_EXPORT {}_NO_EXPORT {}".format(
                name.upper(),
                name.upper(),
                deprecated,
            ),
            "#endif",
            "",
            "#endif /* {}_EXPORT_H */".format(name.upper()),
            "",
        ],
    )
    for name, subdir, deprecated in [
        ("rtabmap_core", "core", "RTABMAP_DEPRECATED"),
        ("rtabmap_gui", "gui", "RTABMAP_DEPRECATED"),
        ("utilite", "utilite", "UTILITE_DEPRECATED"),
    ]
]

