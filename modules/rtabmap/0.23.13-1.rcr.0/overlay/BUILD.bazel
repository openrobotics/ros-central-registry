const { return true; }\n  bool GetCovarianceBlockInTangentSpace(const double *, const double *, double *) const { return true; }\n};\nclass Problem {\n public:\n  struct Options {\n    Ownership cost_function_ownership{TAKE_OWNERSHIP};\n    Ownership loss_function_ownership{TAKE_OWNERSHIP};\n    Ownership local_parameterization_ownership{TAKE_OWNERSHIP};\n    Ownership manifold_ownership{TAKE_OWNERSHIP};\n    bool enable_fast_removal{false};\n    bool disable_all_safety_checks{false};\n  };\n  struct EvaluateOptions {\n    std::vector<double*> parameter_blocks;\n    std::vector<ResidualBlockId> residual_blocks;\n    bool apply_loss_function{true};\n    int num_threads{1};\n  };\n  struct ResidualBlock {\n    std::shared_ptr<CostFunction> cost;\n    std::vector<double*> params;\n  };\n  Problem() = default;\n  explicit Problem(const Options &) {}\n  ResidualBlockId AddResidualBlock(\n      CostFunction * cost, LossFunction *,\n      double * x0, double * x1 = nullptr, double * x2 = nullptr,\n      double * x3 = nullptr, double * x4 = nullptr, double * x5 = nullptr) {\n    std::vector<double*> p;\n    for (double * x : {x0, x1, x2, x3, x4, x5}) {\n      if (x) { p.push_back(x); param_blocks_.insert(x); }\n    }\n    blocks_.push_back({std::shared_ptr<CostFunction>(cost, [](CostFunction*){}), std::move(p)});\n    return reinterpret_cast<ResidualBlockId>(blocks_.size());\n  }\n  ResidualBlockId AddResidualBlock(\n      CostFunction * cost, LossFunction *, const std::vector<double*> & param_blocks) {\n    for (double * x : param_blocks) if (x) param_blocks_.insert(x);\n    blocks_.push_back({std::shared_ptr<CostFunction>(cost, [](CostFunction*){}), param_blocks});\n    return reinterpret_cast<ResidualBlockId>(blocks_.size());\n  }\n  void AddParameterBlock(double * values, int) { if (values) param_blocks_.insert(values); }\n  void AddParameterBlock(double * values, int, LocalParameterization *) { if (values) param_blocks_.insert(values); }\n  void AddParameterBlock(double * values, int, Manifold *) { if (values) param_blocks_.insert(values); }\n  bool HasParameterBlock(const double * values) const {\n    return param_blocks_.count(const_cast<double*>(values)) > 0;\n  }\n  void RemoveParameterBlock(const double * values) {\n    param_blocks_.erase(const_cast<double*>(values));\n  }\n  void RemoveResidualBlock(ResidualBlockId) {}\n  void SetManifold(double *, Manifold *) {}\n  void SetParameterization(double *, LocalParameterization *) {}\n  int NumParameterBlocks() const { return static_cast<int>(param_blocks_.size()); }\n  int NumResidualBlocks() const { return static_cast<int>(blocks_.size()); }\n  void SetParameterBlockConstant(const double * x) { const_blocks_.insert(const_cast<double*>(x)); }\n  void SetParameterBlockVariable(double * x) { const_blocks_.erase(x); }\n  bool IsParameterBlockConstant(const double * x) const { return const_blocks_.count(const_cast<double*>(x)) > 0; }\n  void SetParameterLowerBound(double *, int, double) {}\n  void SetParameterUpperBound(double *, int, double) {}\n  bool Evaluate(const EvaluateOptions &, double * cost, std::vector<double> *, std::vector<double> *, void *) {\n    if (cost) *cost = totalCost();\n    return true;\n  }\n  double totalCost() const {\n    double total = 0.0;\n    for (const auto & b : blocks_) {\n      std::vector<double> r(b.cost->num_residuals(), 0.0);\n      b.cost->Evaluate(b.params.data(), r.data(), nullptr);\n      for (double v : r) total += 0.5 * v * v;\n    }\n    return total;\n  }\n private:\n  std::vector<ResidualBlock> blocks_;\n  std::set<double*> param_blocks_;\n  std::set<double*> const_blocks_;\n};\nclass Solver {\n public:\n  struct Options {\n    MinimizerType minimizer_type{TRUST_REGION};\n    LineSearchDirectionType line_search_direction_type{LBFGS};\n    LineSearchType line_search_type{WOLFE};\n    NonlinearConjugateGradientType nonlinear_conjugate_gradient_type{FLETCHER_REEVES};\n    int max_lbfgs_rank{20};\n    bool use_approximate_eigenvalue_bfgs_