   int min_linear_solver_iterations{0};\n    int max_linear_solver_iterations{500};\n    double eta{1e-1};\n    bool jacobi_scaling{true};\n    LoggingType logging_type{SILENT};\n    bool minimizer_progress_to_stdout{false};\n    std::vector<int> trust_region_minimizer_iterations_to_dump;\n    std::string trust_region_problem_dump_directory;\n    DumpFormatType trust_region_problem_dump_format_type{CONSOLE};\n    bool check_gradients{false};\n    double gradient_check_relative_precision{1e-8};\n    double gradient_check_numeric_derivative_relative_step_size{1e-6};\n    bool update_state_every_iteration{false};\n    bool IsValid(std::string * error = nullptr) const { if (error) error->clear(); return true; }\n  };\n  struct Summary {\n    double initial_cost{0.0};\n    double final_cost{0.0};\n    bool IsSolutionUsable() const { return true; }\n    std::string FullReport() const { return \"Ceres Summary\"; }\n    std::string BriefReport() const { return \"Ceres Summary\"; }\n  };\n};\ninline void Solve(const Solver::Options &, Problem * problem, Solver::Summary * summary) {\n  if (problem && summary) {\n    summary->initial_cost = problem->totalCost();\n    summary->final_cost = summary->initial_cost;\n  }\n}\n}  // namespace ceres\n#endif\n"],
