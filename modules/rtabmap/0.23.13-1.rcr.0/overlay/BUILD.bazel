    content = ["#ifndef RCR_NANOFLANN_HPP_\n#define RCR_NANOFLANN_HPP_\n#include <algorithm>\n#include <cstddef>\n#include <utility>\n#include <vector>\nnamespace nanoflann {\ntemplate <typename T, class DataSource, typename _DistanceType = T, typename IndexType = std::size_t>\nstruct L2_Simple_Adaptor {\n  using ElementType = T;\n  using DistanceType = _DistanceType;\n  const DataSource & data_source;\n  explicit L2_Simple_Adaptor(const DataSource & ds) : data_source(ds) {}\n};\nstruct KDTreeSingleIndexAdaptorParams {\n  explicit KDTreeSingleIndexAdaptorParams(std::size_t = 10) {}\n};\ntemplate <typename Distance, class DatasetAdaptor, int DIM = -1, typename IndexType = std::size_t>\nclass KDTreeSingleIndexAdaptor {\n public:\n  using ElementType = typename Distance::ElementType;\n  using DistanceType = typename Distance::DistanceType;\n  KDTreeSingleIndexAdaptor(int dim, const DatasetAdaptor & adaptor, const KDTreeSingleIndexAdaptorParams & = KDTreeSingleIndexAdaptorParams())\n      : dim_(dim), adaptor_(adaptor) {}\n  void buildIndex() {}\n  std::size_t knnSearch(const ElementType * query_pt, std::size_t num_closest, IndexType * out_indices, DistanceType * out_distances_sq) const {\n    const std::size_t N = adaptor_.kdtree_get_point_count();\n    std::vector<std::pair<DistanceType, IndexType>> dists;\n    dists.reserve(N);\n    const int d = (DIM > 0) ? DIM : dim_;\n    for (std::size_t i = 0; i < N; ++i) {\n      DistanceType sq = 0;\n      for (int k = 0; k < d; ++k) {\n        DistanceType diff = query_pt[k] - adaptor_.kdtree_get_pt(i, k);\n        sq += diff * diff;\n      }\n      dists.emplace_back(sq, static_cast<IndexType>(i));\n    }\n    const std::size_t count = std::min(num_closest, N);\n    std::partial_sort(dists.begin(), dists.begin() + count, dists.end());\n    for (std::size_t i = 0; i < count; ++i) {\n      out_indices[i] = dists[i].second;\n      out_distances_sq[i] = dists[i].first;\n    }\n    return count;\n  }\n private:\n  int dim_;\n  const DatasetAdaptor & adaptor_;\n};\n}  // namespace nanoflann\n#endif\n"],
