load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@mrpt_bayes//:mrpt_bayes_library",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
]

cc_library(
    name = "mrpt_poses_library",
    srcs = [
        "src/CPoint.cpp",
        "src/CPoint2D.cpp",
        "src/CPoint2DPDF.cpp",
        "src/CPoint2DPDFGaussian.cpp",
        "src/CPoint3D.cpp",
        "src/CPointPDF.cpp",
        "src/CPointPDFGaussian.cpp",
        "src/CPointPDFParticles.cpp",
        "src/CPointPDFSOG.cpp",
        "src/CPose2D.cpp",
        "src/CPose2DInterpolator.cpp",
        "src/CPose3D.cpp",
        "src/CPose3DInterpolator.cpp",
        "src/CPose3DPDF.cpp",
        "src/CPose3DPDFGaussian.cpp",
        "src/CPose3DPDFGaussianInf.cpp",
        "src/CPose3DPDFGrid.cpp",
        "src/CPose3DPDFParticles.cpp",
        "src/CPose3DPDFSOG.cpp",
        "src/CPose3DQuat.cpp",
        "src/CPose3DQuatPDF.cpp",
        "src/CPose3DQuatPDFGaussian.cpp",
        "src/CPose3DQuatPDFGaussianInf.cpp",
        "src/CPosePDF.cpp",
        "src/CPosePDFGaussian.cpp",
        "src/CPosePDFGaussianInf.cpp",
        "src/CPosePDFGrid.cpp",
        "src/CPosePDFParticles.cpp",
        "src/CPosePDFSOG.cpp",
        "src/CPoseRandomSampler.cpp",
        "src/CPoses2DSequence.cpp",
        "src/CPoses3DSequence.cpp",
        "src/CRobot2DPoseEstimator.cpp",
        "src/FrameTransformer.cpp",
        "src/Lie/SE.cpp",
        "src/Lie/SO.cpp",
        "src/SO_SE_average.cpp",
        "src/registerAllClasses.cpp",
        "src/sensor_poses.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_poses",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mrpt_poses_library"],
)

cc_library(
    name = "_bindings.cpython-314-x86_64-linux-gnu_library",
    srcs = ["python_bindings/mrpt_poses_py.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":mrpt_poses_library"],
)

cc_shared_library(
    name = "_bindings.cpython-314-x86_64-linux-gnu",
    dynamic_deps = DEPENDENCIES.keys(),
    shared_lib_name = "mrpt/poses/_bindings.so",
    deps = [":_bindings.cpython-314-x86_64-linux-gnu_library"],
)

py_library(
    name = "mrpt",
    srcs = glob(["python/mrpt/**/*.py"]),
    imports = ["python"],
    deps = [
        "@mrpt_bayes//:mrpt",
        "@mrpt_io//:mrpt",
    ],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_poses",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_poses": [
            "libmrpt_poses.so.3.3",
            "libmrpt_poses.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_bayes//:ament_package",
        "@mrpt_common//:ament_package",
        "@mrpt_io//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    egg_info = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mrpt_poses",
    ],
    package_xml = "package.xml",
    python = [
        ":mrpt",
        ":_bindings.cpython-314-x86_64-linux-gnu",
    ],
    python_strip_prefix = "python",
    sonames = {
        "mrpt_poses": [
            "libmrpt_poses.so.3.3",
            "libmrpt_poses.so.3.3.1",
        ],
    },
    deps = [":ament_index"] + [
        "@mrpt_bayes//:ament_package",
        "@mrpt_common//:ament_package",
        "@mrpt_io//:ament_package",
    ],
)
