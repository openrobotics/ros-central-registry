    out = "_gen/include/mrpt/math/include/mrpt/math/gtsam_wrappers.h",
    content = ["/* +------------------------------------------------------------------------+\n   |                     Mobile Robot Programming Toolkit (MRPT)            |\n   |                          https://www.mrpt.org/                         |\n   |                                                                        |\n   | Copyright (c) 2005-2026, Individual contributors, see AUTHORS file     |\n   | See: https://www.mrpt.org/Authors - All rights reserved.               |\n   | Released under BSD License. See: https://www.mrpt.org/License          |\n   +------------------------------------------------------------------------+ */\n#pragma once\n\n#include <gtsam/geometry/Point3.h>\n#include <gtsam/navigation/NavState.h>  // Velocity3\n#include <mrpt/math/CMatrixFixed.h>\n#include <mrpt/math/TPoint3D.h>\n#include <mrpt/math/TTwist3D.h>\n\nnamespace mrpt::gtsam_wrappers\n{\n/** @name mrpt_gtsam_wrappers GTSAM <-> MRPT conversion functions\n *  \\note New in MRPT 2.3.3\n *  \\sa <mrpt/poses/gtsam_wrappers.h>\n * @{ */\n\nstatic gtsam::Point3 toPoint3(const mrpt::math::TPoint3D& p)\n{\n  return gtsam::Point3(p.x, p.y, p.z);\n}\n\nstatic mrpt::math::TPoint3D toTPoint3(const gtsam::Point3& p) { return {p.x(), p.y(), p.z()}; }\n\nstatic mrpt::math::TTwist3D toTTwist3D(const gtsam::Velocity3& v)\n{\n  mrpt::math::TTwist3D t;\n  t.vx = v.x();\n  t.vy = v.y();\n  t.vz = v.z();\n  return t;\n}\nstatic std::array<double, 3> toVelArray(const gtsam::Velocity3& v) { return {v.x(), v.y(), v.z()}; }\n\nstatic mrpt::math::CMatrixDouble66 to_mrpt_se3_cov6(const gtsam::Matrix6& se3_cov)\n{\n  mrpt::math::CMatrixDouble66 C;\n  // MRPT : X ,Y,Z,YAW,PITCH,ROLL\n  // GTSAM: RX RY RZ X Y Z\n  constexpr unsigned int mapping[6] = {5, 4, 3, 0, 1, 2};\n  for (int i = 0; i < 6; i++)\n    for (int j = 0; j < 6; j++) C(mapping[i], mapping[j]) = se3_cov(i, j);\n\n  return C;\n}\n\nstatic gtsam::Matrix6 to_gtsam_se3_cov6_reordering(const mrpt::math::CMatrixDouble66& se3_cov)\n{\n  gtsam::Matrix6 C;\n  // MRPT : X ,Y,Z,YAW,PITCH,ROLL\n  // GTSAM: RX RY RZ X Y Z\n  constexpr unsigned int mapping[6] = {5, 4, 3, 0, 1, 2};\n  for (int i = 0; i < 6; i++)\n    for (int j = 0; j < 6; j++) C(i, j) = se3_cov(mapping[i], mapping[j]);\n\n  return C;\n}\n\nstatic gtsam::Matrix6 to_gtsam_se3_cov6_isotropic(const mrpt::math::CMatrixDouble66& se3_cov)\n{\n  gtsam::Matrix6 C = to_gtsam_se3_cov6_reordering(se3_cov);\n  for (int i = 0; i < 6; i++)\n    for (int j = 0; j < 6; j++)\n      if (i != j) ASSERT_EQUAL_(C(i, j), 0);\n\n  return C;\n}\n\n/** @} */\n\n}  // namespace mrpt::gtsam_wrappers\n"],
)

write_file(
    name = "gen_extra_52",
    out = "_gen/include/mrpt/math/include/mrpt/math/homog_matrices.h",
    content = ["/* +------------------------------------------------------------------------+\n   |                     Mobile Robot Programming Toolkit (MRPT)            |\n   |                          https://www.mrpt.org/                         |\n   |                                                                        |\n   | Copyright (c) 2005-2026, Individual contributors, see AUTHORS file     |\n   | See: https://www.mrpt.org/Authors - All rights reserved.               |\n   | Released under BSD License. See: https://www.mrpt.org/License          |\n   +------------------------------------------------------------------------+ */\n#pragma once\n\n#include <mrpt/core/exceptions.h>\n\nnamespace mrpt::math\n{\n/** Efficiently compute the inverse of a 4x4 homogeneous matrix by only\n * transposing the rotation 3x3 part and solving the translation with dot\n * products.\n *  This is a generic template which works with:\n *    MATRIXLIKE: CMatrixDynamic, CMatrixFixed\n */\ntemplate <class MATRIXLIKE1, class MATRIXLIKE2>\nvoid homogeneousMatrixInverse(const MATRIXLIKE1& M, MATRIXLIKE2& out_inverse_M)\n{\n  MRPT_START\n  ASSERT_(M.isSquare() && M.rows() == 4);\n\n  /* Instead of performing a generic 4x4 matrix inversion, we only need to\n  transpose the rotation part, then replace the translation part by\n  three dot products. See, for example:\n   https://graphics.stanford.edu/courses/cs248-98-fall/Final/q4.html\n\n    [ux vx wx tx] -1   [ux uy uz -dot(u,t)]\n    [uy vy wy ty]      [vx vy vz -dot(v,t)]\n    [uz vz wz tz]    = [wx wy wz -dot(w,t)]\n    [ 0  0  0  1]      [ 0  0  0     1    ]\n  */\n\n  out_inverse_M.setSize(4, 4);\n\n  // 3x3 rotation part:\n  out_inverse_M(0, 0, M(0) = 0);\n  out_inverse_M(0, 1, M(1) = 0);\n  out_inverse_M(0, 2, M(2) = 0);\n\n  out_inverse_M(1, 0, M(0) = 1);\n  out_inverse_M(1, 1, M(1) = 1);\n  out_inverse_M(1, 2, M(2) = 1);\n\n  out_inverse_M(2, 0, M(0) = 2);\n  out_inverse_M(2, 1, M(1) = 2);\n  out_inverse_M(2, 2, M(2) = 2);\n\n  const double tx = -M(0, 3);\n  const double ty = -M(1, 3);\n  const double tz = -M(2, 3);\n\n  const double tx_ = tx * M(0, 0) + ty * M(1, 0) + tz * M(2, 0);\n  const double ty_ = tx * M(0, 1) + ty * M(1, 1) + tz * M(2, 1);\n  const double tz_ = tx * M(0, 2) + ty * M(1, 2) + tz * M(2, 2);\n\n  out_inverse_M(0, 3) = tx_;\n  out_inverse_M(1, 3) = ty_;\n  out_inverse_M(2, 3) = tz_;\n\n  out_inverse_M(3, 0) = 0;\n  out_inverse_M(3, 1) = 0;\n  out_inverse_M(3, 2) = 0;\n  out_inverse_M(3, 3) = 1;\n\n  MRPT_END\n}\n//! \\overload\ntemplate <class IN_ROTMATRIX, class IN_XYZ, class OUT_ROTMATRIX, class OUT_XYZ>\nvoid homogeneousMatrixInverse(\n    const IN_ROTMATRIX& in_R, const IN_XYZ& in_xyz, OUT_ROTMATRIX& out_R, OUT_XYZ& out_xyz)\n{\n  MRPT_START\n  ASSERT_(in_R.isSquare() && in_R.rows() == 3 && in_xyz.size() == 3);\n  out_R.setSize(3, 3);\n  out_xyz.resize(3);\n\n  // translation part:\n  using T = typename IN_ROTMATRIX::Scalar;\n  const T tx = -in_xyz[0];\n  const T ty = -in_xyz[1];\n  const T tz = -in_xyz[2];\n\n  out_xyz[0] = tx * in_R(0, 0) + ty * in_R(1, 0) + tz * in_R(2, 0);\n  out_xyz[1] = tx * in_R(0, 1) + ty * in_R(1, 1) + tz * in_R(2, 1);\n  out_xyz[2] = tx * in_R(0, 2) + ty * in_R(1, 2) + tz * in_R(2, 2);\n\n  // 3x3 rotation part: transpose\n  out_R = in_R.transpose();\n\n  MRPT_END\n}\n//! \\overload\ntemplate <class MATRIXLIKE>\ninline void homogeneousMatrixInverse(MATRIXLIKE& M)\n{\n  ASSERTDEB_(M.cols() == M.rows() && M.rows() == 4);\n  // translation:\n  const double tx = -M(0, 3);\n  const double ty = -M(1, 3);\n  const double tz = -M(2, 3);\n  M(0, 3) = tx * M(0, 0) + ty * M(1, 0) + tz * M(2, 0);\n  M(1, 3) = tx * M(0, 1) + ty * M(1, 1) + tz * M(2, 1);\n  M(2, 3) = tx * M(0, 2) + ty * M(1, 2) + tz * M(2, 2);\n  // 3x3 rotation part:\n  double t;  // avoid std::swap() to avoid <algorithm> only for that.\n  t = M(1, 0);\n  M(1, 0) = M(0, 1);\n  M(0, 1) = t;\n  t = M(2, 0);\n  M(2, 0) = M(0, 2);\n  M(0, 2) = t;\n  t = M(1, 2);\n  M(1, 2) = M(2, 1);\n  M(2, 1) = t;\n}\n}  // namespace mrpt::math\n"],
)

