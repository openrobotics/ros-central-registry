e namespace\nMRPT_DECLARE_TTYPENAME_NO_NAMESPACE(TPoint3D, mrpt::math)\nMRPT_DECLARE_TTYPENAME_NO_NAMESPACE(TPoint3Df, mrpt::math)\n}  // namespace mrpt::typemeta\n"],
