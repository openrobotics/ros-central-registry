load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

ENV_HOOKS = [
    "0.ros_distro_check.sh",
    "1.ros_discovery.dsv",
    "1.ros_discovery.sh",
    "1.ros_distro.dsv",
    "1.ros_distro.sh",
    "1.ros_python_version.dsv",
    "1.ros_python_version.sh",
    "1.ros_version.dsv",
    "1.ros_version.sh",
]

# ament_environment_hooks(env-hooks/*.in): configure_file(@ONLY) with the values
# ros_environment's CMakeLists.txt sets for this distribution.
[
    genrule(
        name = hook.replace(".", "_"),
        srcs = ["env-hooks/" + hook + ".in"],
        outs = ["environment/" + hook],
        cmd = "sed -e 's|@ROS_DISTRO@|lyrical|g' -e 's|@ROS_VERSION@|2|g' -e 's|@ROS_PYTHON_VERSION@|3|g' -e 's|@ROS_AUTOMATIC_DISCOVERY_RANGE@|SUBNET|g' $< > $@",
    )
    for hook in ENV_HOOKS
]

### PACKAGING

ament_package(
    name = "ament_package",
    data = ["environment/" + hook for hook in ENV_HOOKS],
    env_hooks = ["environment/" + hook for hook in ENV_HOOKS if not hook.endswith(".sh") or hook.startswith("0.")],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_core//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
