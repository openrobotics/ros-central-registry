load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@autoware_utils_geometry//:autoware_utils_geometry": "@autoware_utils_geometry//:autoware_utils_geometry_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@tf2_ros//:static_transform_broadcaster_node": "@tf2_ros//:static_transform_broadcaster_node_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "autoware_utils_tf_library",
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/autoware_utils_tf",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@autoware_cmake//:ament_package",
        "@autoware_lint_common//:ament_package",
        "@autoware_utils_geometry//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

cc_test(
    name = "test_autoware_utils_tf",
    srcs = [
        "test/cases/self_pose_listener.cpp",
        "test/cases/transform_listener.cpp",
        "test/main.cpp",
    ] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/autoware_utils_tf",
    ],
    local_defines = ros_local_defines() + ["GTEST_HAS_PTHREAD=1"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":autoware_utils_tf_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "autoware_utils_geometry",
        "geometry_msgs",
        "rclcpp",
        "tf2_ros",
    ],
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@autoware_cmake//:ament_package",
        "@autoware_lint_common//:ament_package",
        "@autoware_utils_geometry//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
