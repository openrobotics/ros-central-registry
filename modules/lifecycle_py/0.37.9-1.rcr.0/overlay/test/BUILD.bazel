load("@launch_testing_ros//:defs.bzl", "launch_ros_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

exports_files([
    "test_copyright.py",
    "test_flake8.py",
    "test_lifecycle.py",
    "test_mypy.py",
    "test_pep257.py",
    "test_xmllint.py",
])

launch_ros_test(
    name = "test_lifecycle",
    src = "test_lifecycle.py",
    data = [
        "test_copyright.py",
        "test_flake8.py",
        "test_lifecycle.py",
        "test_mypy.py",
        "test_pep257.py",
        "test_xmllint.py",
    ] + ["//:ament_index"] + [
        "@lifecycle//:ament_index",
        "@lifecycle//:lifecycle_listener",
    ],
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [
        "//:lifecycle_py",
        "@lifecycle_msgs//:py",
    ],
)
