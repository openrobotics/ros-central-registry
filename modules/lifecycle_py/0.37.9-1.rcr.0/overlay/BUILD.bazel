package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

py_library(
    name = "lifecycle_py",
    srcs = glob(["lifecycle_py/**/*.py"]),
    imports = ["."],
    deps = [
        "@example_interfaces//:py",
        "@lifecycle_msgs//:py",
        "@rclpy",
        requirement("typing-extensions"),
    ],
)

py_pytest(
    name = "test_lifecycle",
    srcs = ["test/test_lifecycle.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":lifecycle_py"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"lifecycle_talker": "lifecycle_py.talker:main"},
    data = ["launch/lifecycle_demo_launch.py"],
    package_xml = "package.xml",
    python = [":lifecycle_py"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@example_interfaces//:ament_package",
        "@lifecycle//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@ros_testing//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
