load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "README.rst",
        "lifecycle_py/__init__.py",
        "lifecycle_py/talker.py",
        "package.xml",
        "resource/lifecycle_py",
        "setup.cfg",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
    "xmllint",
]]

py_library(
    name = "lifecycle_py",
    srcs = [
        "lifecycle_py/__init__.py",
        "lifecycle_py/talker.py",
    ],
    imports = ["."],
    deps = [
        "@example_interfaces//:py",
        "@lifecycle_msgs//:py",
        "@rclpy",
        requirement("typing-extensions"),
    ],
)

ament_index(
    name = "ament_index",
    data = ["//launch:launch_files"],
    package_xml = "package.xml",
)

py_binary(
    name = "lifecycle_talker",
    srcs = ["lifecycle_py/talker.py"],
    data = [":ament_index"],
    main = "lifecycle_py/talker.py",
    deps = [":lifecycle_py"],
)

ament_package(
    name = "ament_package",
    console_scripts = {"lifecycle_talker": "lifecycle_py.talker:main"},
    executables = [":lifecycle_talker"],
    package_xml = "package.xml",
    python = [":lifecycle_py"],
    deps = [":ament_index"] + [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@example_interfaces//:ament_package",
        "@lifecycle//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@ros_testing//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
