load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

exports_files(glob(["*.bzl"]))

filegroup(
    name = "interface_templates",
    srcs = glob(["resource/**/*.em"]),
)

### LIBRARIES

HEADERS = glob([
    "include/**/*.h",
    "include/**/*.hpp",
])

DEPENDENCIES = {
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosidl_typesupport_c//:rosidl_typesupport_c": "@rosidl_typesupport_c//:rosidl_typesupport_c_library",
    # Sources call rcutils directly (RCUTILS_SET_ERROR_MSG and friends in
    # rather than a transitive one. Harmless and truthful on other platforms.
    # type_support_dispatch), so on Windows -- where a DLL may not contain
    # undefined symbols -- rcutils.dll must be a direct dynamic dependency
}

cc_library(
    name = "rosidl_typesupport_cpp_library",
    srcs = glob([
        "src/**/*.hpp",
        "src/**/*.cpp",
    ]),
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rosidl_typesupport_cpp",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rosidl_typesupport_cpp_library"],
    deps = [":rosidl_typesupport_cpp_library"],
)

py_library(
    name = "rosidl_typesupport_cpp_py",
    srcs = glob(["rosidl_typesupport_cpp/**/*.py"]),
    deps = [
        "@ament_index_python",
        "@rosidl_cli",
        "@rosidl_generator_cpp",
        "@rosidl_pycommon",
    ],
)

genrule(
    name = "cli_rename",
    srcs = ["bin/rosidl_typesupport_cpp"],
    outs = ["bin/rosidl_typesupport_cpp.py"],
    cmd = "cp $(location :bin/rosidl_typesupport_cpp) $(location :bin/rosidl_typesupport_cpp.py)",
)

py_binary(
    name = "cli",
    srcs = [":bin/rosidl_typesupport_cpp.py"],
    main = ":bin/rosidl_typesupport_cpp.py",
    deps = [":rosidl_typesupport_cpp_py"],
)

# Mirrors ament_package(CONFIG_EXTRAS "rosidl_typesupport_cpp-extras.cmake.in"): configure_file(@ONLY) of the template.
genrule(
    name = "extras_cmake",
    srcs = ["rosidl_typesupport_cpp-extras.cmake.in"],
    outs = ["rosidl_typesupport_cpp-extras.cmake"],
    cmd = "sed -e 's|@rosidl_typesupport_cpp_LIBRARY_TYPE@|SHARED|g' -e 's|@PROJECT_NAME@|rosidl_typesupport_cpp|g' -e 's|@PYTHON_INSTALL_DIR@|lib/python3.14/site-packages|g' $< > $@",
)

write_file(
    name = "resource_index_rosidl_runtime_packages",
    out = "_resource_index/rosidl_runtime_packages",
    content = [""],
)

# ament_index_register_resource() registrations, as ament_cmake installs them.
pkg_files(
    name = "resource_index",
    srcs = [
        ":resource_index_rosidl_runtime_packages",
    ],
    renames = {
        ":resource_index_rosidl_runtime_packages": "share/ament_index/resource_index/rosidl_runtime_packages/rosidl_typesupport_cpp",
    },
)

### TESTS

[
    (
        cc_library(
            name = "rosidl_typesupport_cpp__test_type_support{}_library".format(i),
            testonly = True,
            srcs = ["test/test_type_support.cpp"],
            deps = [":rosidl_typesupport_cpp_library"],
            alwayslink = True,
        ),
        cc_shared_library(
            name = "rosidl_typesupport_cpp__test_type_support{}".format(i),
            testonly = True,
            dynamic_deps = [":transitive_dynamic_deps"],
            exports_filter = [":rosidl_typesupport_cpp__test_type_support{}_library".format(i)],
            deps = [":rosidl_typesupport_cpp__test_type_support{}_library".format(i)],
        ),
    )
    for i in [
        1,
        2,
    ]
]

write_file(
    name = "test_type_support3",
    testonly = True,
    out = "librosidl_typesupport_cpp__test_type_support3.so",
    content = ["I'm not a shared library, why would you treat me like one?"],
)

ament_index(
    name = "test_ament_index",
    testonly = True,
    libraries = [
        ":rosidl_typesupport_cpp__test_type_support1",
        ":rosidl_typesupport_cpp__test_type_support2",
        ":test_type_support3",
    ],
    package_xml = "package.xml",
)

cc_test(
    name = "test_message_type_support",
    srcs = ["test/test_message_type_support_dispatch.cpp"],
    data = [":test_ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines() + ["RCUTILS_ENABLE_FAULT_INJECTION"],
    deps = DEPENDENCIES.values() + [
        ":rosidl_typesupport_cpp_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_service_type_support",
    srcs = ["test/test_service_type_support_dispatch.cpp"],
    data = [":test_ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines() + ["RCUTILS_ENABLE_FAULT_INJECTION"],
    deps = DEPENDENCIES.values() + [
        ":rosidl_typesupport_cpp_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "benchmark_type_support_dispatch",
    srcs = ["test/benchmark/benchmark_type_support_dispatch.cpp"],
    data = [":test_ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    tags = ["manual"],
    deps = DEPENDENCIES.values() + [
        ":rosidl_typesupport_cpp_library",
        "@google_benchmark//:benchmark_main",
        "@performance_test_fixture",
    ],
)

py_pytest(
    name = "test_cli_extension",
    srcs = ["test/test_cli_extension.py"],
    data = ["//test/msg:Test.msg"],
    deps = [
        ":rosidl_typesupport_cpp_py",
        "@rosidl_cli",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = glob(["cmake/**"]) + [":extras_cmake"],
    cmake_extras = ["rosidl_typesupport_cpp-extras.cmake"],
    data = glob(["resource/**"]),
    headers = HEADERS,
    install = [":resource_index"],
    lib_data = ["bin/rosidl_typesupport_cpp"],
    libraries = [":rosidl_typesupport_cpp"],
    package_xml = "package.xml",
    python = glob(["rosidl_typesupport_cpp/**"]),
    deps = [
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_ros_core//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@performance_test_fixture//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_cli//:ament_package",
        "@rosidl_generator_c//:ament_package",
        "@rosidl_generator_cpp//:ament_package",
        "@rosidl_generator_type_description//:ament_package",
        "@rosidl_pycommon//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
        "@rosidl_typesupport_c//:ament_package",
        "@rosidl_typesupport_interface//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
    ],
)

# Public so the rosidl generator aspects can link a message fragment against
# the full transitive DLL closure on Windows (see the aspects' _cc_shared_dep),
# where a DLL may not contain undefined symbols.
collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rosidl_typesupport_cpp"],
    visibility = ["//visibility:public"],
)
