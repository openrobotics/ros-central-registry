load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
]

cc_library(
    name = "yaets_library",
    srcs = ["src/yaets/tracing.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    includes = [
        "include",
        "include/yaets",
        "tests",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "yaets",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":yaets_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":yaets"],
)

ament_index(
    name = "ament_index",
    lib_data = [
        "scripts/diagrams.py",
        "scripts/elapsed_time_histogram.py",
        "scripts/execution_time_histogram.py",
        "scripts/gantt.py",
        "scripts/stats.py",
    ],
    libraries = [
        ":yaets",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@python_cmake_module//:ament_package",
    ],
)

cc_test(
    name = "yaets_test",
    srcs = ["tests/yaets_test.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    data = [":ament_index"] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/yaets",
        "tests",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":yaets_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_name = "export_yaets",
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [
        ":yaets",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@python_cmake_module//:ament_package",
    ],
)
