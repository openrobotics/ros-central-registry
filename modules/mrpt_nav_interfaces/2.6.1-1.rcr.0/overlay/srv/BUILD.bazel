load("@rosidl_default_generators//:defs.bzl", "ros_service")

package(default_visibility = ["//visibility:public"])

exports_files([
    "GetGridmapLayer.srv",
    "GetLayers.srv",
    "GetPointmapLayer.srv",
    "MakePlanFromTo.srv",
    "MakePlanTo.srv",
])

ros_service(
    name = "GetGridmapLayer",
    src = "GetGridmapLayer.srv",
    deps = [
        "@nav_msgs//msg:OccupancyGrid",
    ],
)

ros_service(
    name = "GetLayers",
    src = "GetLayers.srv",
)

ros_service(
    name = "GetPointmapLayer",
    src = "GetPointmapLayer.srv",
    deps = [
        "@sensor_msgs//msg:PointCloud2",
    ],
)

ros_service(
    name = "MakePlanFromTo",
    src = "MakePlanFromTo.srv",
    deps = [
        "@geometry_msgs//msg:Pose",
        "@mrpt_msgs//msg-ros2:WaypointSequence",
    ],
)

ros_service(
    name = "MakePlanTo",
    src = "MakePlanTo.srv",
    deps = [
        "@geometry_msgs//msg:PoseStamped",
        "@mrpt_msgs//msg-ros2:WaypointSequence",
    ],
)
