    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":ecl_linear_algebra_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "ecl_test_linear_algebra_plugin",
    srcs = ["src/test/plugin.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
