load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@ecl_exceptions//:ecl_exceptions": "@ecl_exceptions//:ecl_exceptions_library",
}

CC_DEPS = [
    "@ecl_converters//:ecl_converters_library",
    "@ecl_eigen//:ecl_eigen",
    "@ecl_eigen//:ecl_eigen_library",
    "@ecl_formatters//:ecl_formatters_library",
    "@ecl_math//:ecl_math",
    "@ecl_math//:ecl_math_library",
    "@rosdistro//cc:eigen",
    "@sophus//:sophus",
    "@sophus//:sophus_library",
]

cc_library(
    name = "ecl_linear_algebra_library",
    srcs = [
        "src/lib/sophus_helpers.cpp",
        "src/lib/sophus_interpolators.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src/test",
    ],
    local_defines = ros_local_defines() + [
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "SOPHUS_USE_BASIC_LOGGING=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ecl_linear_algebra",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":ecl_linear_algebra_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

pkg_files(
    name = "pkg_files_soname_0",
    srcs = [":ecl_linear_algebra"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "lib",
    renames = {":ecl_linear_algebra": "libecl_linear_algebra.so.1.2.1"},
)

ament_index(
    name = "ament_index",
    libraries = [":ecl_linear_algebra"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ecl_build//:ament_package",
        "@ecl_converters//:ament_package",
        "@ecl_eigen//:ament_package",
        "@ecl_exceptions//:ament_package",
        "@ecl_formatters//:ament_package",
        "@ecl_license//:ament_package",
        "@ecl_math//:ament_package",
        "@sophus//:ament_package",
    ],
)

cc_test(
