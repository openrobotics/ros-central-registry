load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@ecl_exceptions//:ecl_exceptions": "@ecl_exceptions//:ecl_exceptions_library",
    "@ecl_formatters//:ecl_formatters": "@ecl_formatters//:ecl_formatters_library",
}

CC_DEPS = [
    "@ecl_converters//:ecl_converters_library",
    "@ecl_eigen//:ecl_eigen",
    "@ecl_eigen//:ecl_eigen_library",
    "@ecl_math//:ecl_math",
    "@ecl_math//:ecl_math_library",
    "@rosdistro//cc:eigen",
    "@sophus//:sophus",
    "@sophus//:sophus_library",
]

cc_library(
    name = "ecl_linear_algebra_library",
    srcs = [
        "src/lib/sophus_helpers.cpp",
        "src/lib/sophus_interpolators.cpp",
    ],
    hdrs = [
        "include/ecl/linear_algebra.hpp",
        "include/ecl/linear_algebra/eigen.hpp",
        "include/ecl/linear_algebra/eigen/formatters.hpp",
        "include/ecl/linear_algebra/eigen/plugin.hpp",
        "include/ecl/linear_algebra/eigen/unsupported/nonlinear_optimization.hpp",
        "include/ecl/linear_algebra/eigen/unsupported/numerical_diff.hpp",
        "include/ecl/linear_algebra/sophus.hpp",
        "include/ecl/linear_algebra/sophus/formatters.hpp",
        "include/ecl/linear_algebra/sophus/helpers.hpp",
        "include/ecl/linear_algebra/sophus/interpolators.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src/test",
    ],
    local_defines = ros_local_defines() + [
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "SOPHUS_USE_BASIC_LOGGING=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ecl_linear_algebra",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":ecl_linear_algebra_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ecl_linear_algebra"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":ecl_linear_algebra",
    ],
    package_xml = "package.xml",
    sonames = {
        "ecl_linear_algebra": ["libecl_linear_algebra.so.1.2.1"],
    },
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ecl_build//:ament_package",
        "@ecl_converters//:ament_package",
        "@ecl_eigen//:ament_package",
        "@ecl_exceptions//:ament_package",
        "@ecl_formatters//:ament_package",
        "@ecl_license//:ament_package",
        "@ecl_math//:ament_package",
        "@sophus//:ament_package",
    ],
)

cc_test(
    name = "ecl_test_linear_algebra_formatters",
    srcs = ["src/test/formatters.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "src/test",
    ],
    local_defines = ros_local_defines() + [
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "GTEST_HAS_PTHREAD=1",
        "SOPHUS_USE_BASIC_LOGGING=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":ecl_linear_algebra_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "ecl_test_linear_algebra_interpolators",
    srcs = ["src/test/interpolators.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "src/test",
    ],
    local_defines = ros_local_defines() + [
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "GTEST_HAS_PTHREAD=1",
        "SOPHUS_USE_BASIC_LOGGING=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":ecl_linear_algebra_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "ecl_test_linear_algebra_plugin",
    srcs = ["src/test/plugin.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "src/test",
    ],
    local_defines = ros_local_defines() + [
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "GTEST_HAS_PTHREAD=1",
        "SOPHUS_USE_BASIC_LOGGING=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":ecl_linear_algebra_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "Sophus",
        "ecl_eigen",
        "ecl_exceptions",
        "ecl_formatters",
        "ecl_math",
    ],
    headers = [
        "include/ecl/linear_algebra.hpp",
        "include/ecl/linear_algebra/eigen.hpp",
        "include/ecl/linear_algebra/eigen/formatters.hpp",
        "include/ecl/linear_algebra/eigen/plugin.hpp",
        "include/ecl/linear_algebra/eigen/unsupported/nonlinear_optimization.hpp",
        "include/ecl/linear_algebra/eigen/unsupported/numerical_diff.hpp",
        "include/ecl/linear_algebra/sophus.hpp",
        "include/ecl/linear_algebra/sophus/formatters.hpp",
        "include/ecl/linear_algebra/sophus/helpers.hpp",
        "include/ecl/linear_algebra/sophus/interpolators.hpp",
    ],
    include_prefix = "",
    libraries = [
        ":ecl_linear_algebra",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ecl_build//:ament_package",
        "@ecl_converters//:ament_package",
        "@ecl_eigen//:ament_package",
        "@ecl_exceptions//:ament_package",
        "@ecl_formatters//:ament_package",
        "@ecl_license//:ament_package",
        "@ecl_math//:ament_package",
        "@sophus//:ament_package",
    ],
)
