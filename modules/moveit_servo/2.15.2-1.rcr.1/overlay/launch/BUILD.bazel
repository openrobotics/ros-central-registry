load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "demo_joint_jog.launch.py",
        "demo_pose.launch.py",
        "demo_ros_api.launch.py",
        "demo_twist.launch.py",
    ],
)

launch_ros_binary(
    name = "demo_joint_jog_launch",
    src = "demo_joint_jog.launch.py",
    deps = [
        "//:demo_joint_jog",
        "@ament_index_python",
        "@controller_manager//:ros2_control_node",
        "@controller_manager//:spawner",
        "@launch_param_builder",
        "@moveit_configs_utils",
        "@rclcpp_components//:component_container_mt",
        "@robot_state_publisher",
        "@rviz2",
        "@tf2_ros//:static_transform_broadcaster_node",
    ],
)

launch_ros_binary(
    name = "demo_pose_launch",
    src = "demo_pose.launch.py",
    deps = [
        "//:demo_pose",
        "@ament_index_python",
        "@controller_manager//:ros2_control_node",
        "@controller_manager//:spawner",
        "@launch_param_builder",
        "@moveit_configs_utils",
        "@rclcpp_components//:component_container_mt",
        "@robot_state_publisher",
        "@rviz2",
        "@tf2_ros//:static_transform_broadcaster_node",
    ],
)

launch_ros_binary(
    name = "demo_ros_api_launch",
    src = "demo_ros_api.launch.py",
    deps = [
        "//:servo_node",
        "@ament_index_python",
        "@controller_manager//:ros2_control_node",
        "@controller_manager//:spawner",
        "@launch_param_builder",
        "@moveit_configs_utils",
        "@rclcpp_components//:component_container_mt",
        "@robot_state_publisher",
        "@rviz2",
        "@tf2_ros//:static_transform_broadcaster_node",
    ],
)

launch_ros_binary(
    name = "demo_twist_launch",
    src = "demo_twist.launch.py",
    deps = [
        "//:demo_twist",
        "@ament_index_python",
        "@controller_manager//:ros2_control_node",
        "@controller_manager//:spawner",
        "@launch_param_builder",
        "@moveit_configs_utils",
        "@rclcpp_components//:component_container_mt",
        "@robot_state_publisher",
        "@rviz2",
        "@tf2_ros//:static_transform_broadcaster_node",
    ],
)
