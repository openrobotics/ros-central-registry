    name = "moveit_servo_lib_cpp_library",
    srcs = [":gen_moveit_servo_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_atomic_shared_ptr_shim_hpp",
