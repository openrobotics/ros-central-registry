+inline Mask& Mask::operator=(const Mask& other)
+{
+  if (this != &other)
+  {
+    for (uint32_t i = 0; i < WORD_COUNT; ++i)
+    {
+      words_[i] = other.words_[i];
+    }
+  }
+  return *this;
+}
+
+inline Mask& Mask::operator=(Mask&& other)
+{
+  if (this != &other)
+  {
+    if (WORD_COUNT <= 8)
+    {
+      for (uint32_t i = 0; i < WORD_COUNT; ++i)
+      {
+        words_[i] = other.words_[i];
+      }
+    }
+    else
+    {
+      std::swap(words_, other.words_);
+    }
+  }
+  return *this;
+}
