load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@ecl_devices//:ecl_devices": "@ecl_devices//:ecl_devices_library",
    "@ecl_errors//:ecl_errors": "@ecl_errors//:ecl_errors_library",
    "@ecl_time//:ecl_time": "@ecl_time//:ecl_time_library",
    "@ecl_type_traits//:ecl_type_traits": "@ecl_type_traits//:ecl_type_traits_library",
}

CC_DEPS = [
    "@ecl_concepts",
    "@ecl_converters//:ecl_converters_library",
]

HEADERS = [
    "include/ecl/streams.hpp",
    "include/ecl/streams/console_streams.hpp",
    "include/ecl/streams/file_streams.hpp",
    "include/ecl/streams/log_stream.hpp",
    "include/ecl/streams/macros.hpp",
    "include/ecl/streams/manipulators.hpp",
    "include/ecl/streams/manipulators/clear_screen.hpp",
    "include/ecl/streams/manipulators/end_of_line.hpp",
    "include/ecl/streams/manipulators/manipulator.hpp",
    "include/ecl/streams/serial_stream.hpp",
    "include/ecl/streams/shared_file_stream.hpp",
    "include/ecl/streams/socket_streams.hpp",
    "include/ecl/streams/string_stream.hpp",
    "include/ecl/streams/text_stream.hpp",
    "include/ecl/streams/text_streams/base_text_stream.hpp",
    "include/ecl/streams/text_streams/input_text_stream.hpp",
    "include/ecl/streams/text_streams/output_text_stream.hpp",
]

cc_library(
    name = "ecl_streams_library",
    srcs = [
        "src/lib/log_stream.cpp",
        "src/lib/manipulators.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ecl_streams",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "libecl_streams.so",
    deps = [":ecl_streams_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ecl_streams"],
)

cc_binary(
    name = "demo_console_streams",
    srcs = ["src/examples/console_streams.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":ecl_streams_library"],
)

cc_binary(
    name = "demo_log_streams",
    srcs = ["src/examples/log_streams.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":ecl_streams_library"],
)

cc_test(
    name = "ecl_test_file_streams",
    srcs = ["src/test/file_streams.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":ecl_streams_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "ecl_test_string_streams",
    srcs = ["src/test/string_streams.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":ecl_streams_library",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_index(
    name = "ament_index",
    libraries = [":ecl_streams"],
    package_xml = "package.xml",
    sonames = {"ecl_streams": ["libecl_streams.so.1.2.1"]},
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "ecl_concepts",
        "ecl_converters",
        "ecl_devices",
        "ecl_errors",
        "ecl_time",
        "ecl_type_traits",
    ],
    executables = [
        ":demo_console_streams",
        ":demo_log_streams",
    ],
    headers = HEADERS,
    include_prefix = "",
    libraries = [":ecl_streams"],
    package_xml = "package.xml",
    sonames = {"ecl_streams": ["libecl_streams.so.1.2.1"]},
    deps = [
        ":ament_index",
        "@ecl_build//:ament_package",
        "@ecl_concepts//:ament_package",
        "@ecl_converters//:ament_package",
        "@ecl_devices//:ament_package",
        "@ecl_errors//:ament_package",
        "@ecl_license//:ament_package",
        "@ecl_time//:ament_package",
        "@ecl_type_traits//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
