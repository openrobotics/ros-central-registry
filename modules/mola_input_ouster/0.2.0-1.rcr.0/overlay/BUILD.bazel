    "os_sensor/lidar_sensor.fbs",
    "os_sensor/sensor_info_stream.fbs",
    "streaming/streaming_info.fbs",
]

genrule(
    name = "fb_gen_headers",
    srcs = ["ouster-sdk/ouster_osf/fb/" + f for f in _FBS_FILES],
    outs = ["_gen/fb/" + f.removesuffix(".fbs") + "_generated.h" for f in _FBS_FILES],
    cmd = """
        OUT_ROOT="$$(dirname $(location _gen/fb/chunk_generated.h))"
        for f in $(SRCS); do
            rel="$${f#*ouster-sdk/ouster_osf/fb/}"
            sub="$$(dirname "$$rel")"
            mkdir -p "$$OUT_ROOT/$$sub"
            $(execpath @rosdistro//cc:flatc) --cpp --no-includes --scoped-enums -o "$$OUT_ROOT/$$sub" "$$f"
        done
    """,
    tools = ["@rosdistro//cc:flatc"],
)

