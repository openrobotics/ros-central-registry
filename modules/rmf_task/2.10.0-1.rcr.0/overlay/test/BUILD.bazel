load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {}

CC_DEPS = [
    "@rmf_battery//:rmf_battery_library",
    "@rmf_utils//:rmf_utils_library",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:nlohmann_json",
]

cc_test(
    name = "test_rmf_task",
    srcs = [
        "integration/test_backups.cpp",
        "main.cpp",
        "mock/MockDelivery.cpp",
        "mock/MockEvent.cpp",
        "mock/MockPhase.cpp",
        "mock/MockTask.cpp",
        "unit/agv/test_Constraints.cpp",
        "unit/agv/test_State.cpp",
        "unit/agv/test_TaskPlanner.cpp",
        "unit/test_Activator.cpp",
        "unit/test_Log.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["NDEBUG"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:rmf_task_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
