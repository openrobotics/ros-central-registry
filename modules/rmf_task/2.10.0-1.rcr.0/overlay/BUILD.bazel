load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@rmf_battery//:rmf_battery_library",
    "@rmf_utils//:rmf_utils_library",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:nlohmann_json",
]

cc_library(
    name = "rmf_task_library",
    srcs = [
        "src/rmf_task/Activator.cpp",
        "src/rmf_task/BackupFileManager.cpp",
        "src/rmf_task/BinaryPriority.cpp",
        "src/rmf_task/BinaryPriorityCostCalculator.cpp",
        "src/rmf_task/BinaryPriorityScheme.cpp",
        "src/rmf_task/CompositeData.cpp",
        "src/rmf_task/Constraints.cpp",
        "src/rmf_task/Estimate.cpp",
        "src/rmf_task/Event.cpp",
        "src/rmf_task/Header.cpp",
        "src/rmf_task/InvariantHeuristicQueue.cpp",
        "src/rmf_task/Log.cpp",
        "src/rmf_task/Parameters.cpp",
        "src/rmf_task/Payload.cpp",
        "src/rmf_task/Phase.cpp",
        "src/rmf_task/Request.cpp",
        "src/rmf_task/State.cpp",
        "src/rmf_task/Task.cpp",
        "src/rmf_task/TaskPlanner.cpp",
        "src/rmf_task/VersionedString.cpp",
        "src/rmf_task/detail/Backup.cpp",
        "src/rmf_task/detail/Resume.cpp",
        "src/rmf_task/events/SimpleEventState.cpp",
        "src/rmf_task/internal_task_planning.cpp",
        "src/rmf_task/phases/RestoreBackup.cpp",
        "src/rmf_task/requests/ChargeBattery.cpp",
        "src/rmf_task/requests/ChargeBatteryFactory.cpp",
        "src/rmf_task/requests/Clean.cpp",
        "src/rmf_task/requests/Delivery.cpp",
        "src/rmf_task/requests/Loop.cpp",
        "src/rmf_task/requests/ParkRobotFactory.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        ".",
        "include",
        "include/rmf_task",
    ],
    local_defines = ros_local_defines() + ["NDEBUG"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rmf_task",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":rmf_task_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    libraries = [
        ":rmf_task",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_catch2//:ament_package",
        "@rmf_battery//:ament_package",
        "@rmf_utils//:ament_package",
    ],
)

cc_test(
    name = "test_rmf_task",
    srcs = [
        "test/integration/test_backups.cpp",
        "test/main.cpp",
        "test/mock/MockDelivery.cpp",
        "test/mock/MockEvent.cpp",
        "test/mock/MockPhase.cpp",
        "test/mock/MockTask.cpp",
        "test/unit/agv/test_Constraints.cpp",
        "test/unit/agv/test_State.cpp",
        "test/unit/agv/test_TaskPlanner.cpp",
        "test/unit/test_Activator.cpp",
        "test/unit/test_Log.cpp",
    ] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/rmf_task",
    ],
    local_defines = ros_local_defines() + ["NDEBUG"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":rmf_task_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":rmf_task",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_catch2//:ament_package",
        "@rmf_battery//:ament_package",
        "@rmf_utils//:ament_package",
    ],
)
