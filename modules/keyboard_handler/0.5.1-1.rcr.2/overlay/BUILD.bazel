load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "keyboard_handler_library",
    srcs = [
        "src/default_unix_key_map.cpp",
        "src/default_windows_key_map.cpp",
        "src/keyboard_handler_base.cpp",
        "src/keyboard_handler_unix_impl.cpp",
        "src/keyboard_handler_windows_impl.cpp",
    ],
    hdrs = [
        "include/keyboard_handler/keyboard_handler.hpp",
        "include/keyboard_handler/keyboard_handler_base.hpp",
        "include/keyboard_handler/keyboard_handler_unix_impl.hpp",
        "include/keyboard_handler/keyboard_handler_windows_impl.hpp",
        "include/keyboard_handler/visibility_control.hpp",
    ],
    includes = ["include"],
    local_defines = ["KEYBOARD_HANDLER_BUILDING_LIBRARY"],
)

cc_shared_library(
    name = "keyboard_handler",
    exports_filter = ["//:__subpackages__"],
    deps = [":keyboard_handler_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":keyboard_handler"],
)

ament_package(
    name = "ament_package",
    cmake_export_name = "export_keyboard_handler",
    headers = [
        "include/keyboard_handler/keyboard_handler.hpp",
        "include/keyboard_handler/keyboard_handler_base.hpp",
        "include/keyboard_handler/keyboard_handler_unix_impl.hpp",
        "include/keyboard_handler/keyboard_handler_windows_impl.hpp",
        "include/keyboard_handler/visibility_control.hpp",
    ],
    libraries = [":keyboard_handler"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
