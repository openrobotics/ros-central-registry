# Mirrors version/version.cmake: the version comes from package.xml
# (moveit_core_VERSION), with no "-devel" postfix (as on the buildfarm) and no
# git metadata, since the release archive is not a git checkout.
MOVEIT_VERSION = "2.15.2"

expand_template(
    name = "version_hpp",
    out = "_gen/include/moveit_core/moveit/version.hpp",
    substitutions = {
        "@MOVEIT_GIT_COMMIT_HASH@": "",
        "@MOVEIT_GIT_NAME@": "",
        "@MOVEIT_VERSION@": MOVEIT_VERSION,
        "@MOVEIT_VERSION_MAJOR@": MOVEIT_VERSION.split(".")[0],
        "@MOVEIT_VERSION_MINOR@": MOVEIT_VERSION.split(".")[1],
        "@MOVEIT_VERSION_PATCH@": MOVEIT_VERSION.split(".")[2],
