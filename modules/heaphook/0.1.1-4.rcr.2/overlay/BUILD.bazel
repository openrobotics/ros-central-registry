load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@tlsf//:tlsf",
]

cc_library(
    name = "preloaded_heaptrack_library",
    srcs = ["src/preloaded.cpp"],
    hdrs = [],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "preloaded_heaptrack",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [
        "//:__subpackages__",
        "@tlsf//:__subpackages__",
    ],
    deps = [":preloaded_heaptrack_library"],
)

cc_library(
    name = "preloaded_tlsf_library",
    srcs = ["src/preloaded_tlsf.cpp"],
    hdrs = [],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "preloaded_tlsf",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [
        "//:__subpackages__",
        "@tlsf//:__subpackages__",
    ],
    deps = [":preloaded_tlsf_library"],
)

cc_binary(
    name = "app",
    srcs = ["src/app.cpp"],
    local_defines = ros_local_defines(),
)

ament_index(
    name = "ament_index",
    libraries = [
        ":preloaded_heaptrack",
        ":preloaded_tlsf",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@tlsf//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    libraries = [
        ":preloaded_heaptrack",
        ":preloaded_tlsf",
    ],
    package_xml = "package.xml",
    programs = [":app"],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@tlsf//:ament_package",
    ],
)
