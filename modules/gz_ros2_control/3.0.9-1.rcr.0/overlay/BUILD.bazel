load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@controller_manager//:controller_manager": "@controller_manager//:controller_manager_library",
    "@gz_sim_vendor//:gz_sim": "@gz_sim_vendor//:gz_sim_library",
    "@hardware_interface//:hardware_interface": "@hardware_interface//:hardware_interface_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libcap": "@rosdistro//cc:libcap_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:protobuf": "@rosdistro//cc:protobuf_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
}

CC_DEPS = [
    "@gz_plugin_vendor//:gz_plugin_register_library",
    "@gz_sim_vendor//:gz_sim_cc_proto",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
    "@rosdistro//cc:spdlog",
]

cc_library(
    name = "gz_hardware_plugins_library",
    srcs = ["src/gz_system.cpp"],
    hdrs = [
        "include/gz_ros2_control/gz_ros2_control_plugin.hpp",
        "include/gz_ros2_control/gz_system.hpp",
        "include/gz_ros2_control/gz_system_interface.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/gz_ros2_control",
    ],
    local_defines = ros_local_defines() + [
        "HAVE_PYBIND11",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "gz_hardware_plugins",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":gz_hardware_plugins_library"],
)

cc_library(
    name = "gz_ros2_control-system_library",
    srcs = ["src/gz_ros2_control_plugin.cpp"],
    hdrs = [
        "include/gz_ros2_control/gz_ros2_control_plugin.hpp",
        "include/gz_ros2_control/gz_system.hpp",
        "include/gz_ros2_control/gz_system_interface.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/gz_ros2_control",
    ],
    local_defines = ros_local_defines() + [
        "HAVE_PYBIND11",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "gz_ros2_control-system",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":gz_ros2_control-system_library"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":gz_hardware_plugins",
        ":gz_ros2_control-system",
    ],
    package_xml = "package.xml",
    plugin_category = "gz_ros2_control",
    plugins = ["gz_hardware_plugins.xml"],
    deps = [
        "@controller_manager//:ament_index",
        "@hardware_interface//:ament_index",
        "@pluginlib//:ament_index",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "controller_manager",
        "hardware_interface",
    ],
    cmake_export_name = "export_gz_ros2_control",
    headers = [
        "include/gz_ros2_control/gz_ros2_control_plugin.hpp",
        "include/gz_ros2_control/gz_system.hpp",
        "include/gz_ros2_control/gz_system_interface.hpp",
    ],
    libraries = [
        ":gz_hardware_plugins",
        ":gz_ros2_control-system",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@controller_manager//:ament_package",
        "@gz_plugin_vendor//:ament_package",
        "@gz_sim_vendor//:ament_package",
        "@hardware_interface//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@yaml_cpp_vendor//:ament_package",
    ],
)
