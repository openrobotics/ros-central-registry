load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":composition_nodes"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "composition_nodes_library",
    srcs = [
        "src/publisher_node.cpp",
        "src/subscriber_node.cpp",
    ],
    hdrs = [
        "include/minimal_composition/publisher_node.hpp",
        "include/minimal_composition/subscriber_node.hpp",
        "include/minimal_composition/visibility.h",
    ],
    includes = ["include"],
    local_defines = ros_local_defines() + ["MINIMAL_COMPOSITION_DLL"],
    deps = DEPENDENCIES.values() + [
        "@std_msgs//:cc",
    ],
)

cc_shared_library(
    name = "composition_nodes",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":composition_nodes_library"],
)

EXECUTABLES = {
    "composition_publisher": "src/standalone_publisher.cpp",
    "composition_subscriber": "src/standalone_subscriber.cpp",
    "composition_composed": "src/composed.cpp",
}

[
    cc_binary(
        name = name,
        srcs = [src],
        dynamic_deps = [":transitive_dynamic_deps"],
        local_defines = ros_local_defines(),
        deps = [":composition_nodes_library"],
    )
    for name, src in EXECUTABLES.items()
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    executables = [":{0}".format(e) for e in EXECUTABLES.keys()],
    libraries = [":composition_nodes"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
