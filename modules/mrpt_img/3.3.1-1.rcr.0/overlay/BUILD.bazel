load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@mrpt_config//:mrpt_config": "@mrpt_config//:mrpt_config_library",
    "@mrpt_io//:mrpt_io": "@mrpt_io//:mrpt_io_library",
    "@mrpt_math//:mrpt_math": "@mrpt_math//:mrpt_math_library",
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

PUBLIC_HEADERS = [
    "include/mrpt/img/CCanvas.h",
    "include/mrpt/img/CImage.h",
    "include/mrpt/img/CImagePyramid.h",
    "include/mrpt/img/CImage_Eigen.h",
    "include/mrpt/img/CImage_opencv.h",
    "include/mrpt/img/CMappedImage.h",
    "include/mrpt/img/CStereoRectifyMap.h",
    "include/mrpt/img/CUndistortMap.h",
    "include/mrpt/img/CVideoFileWriter.h",
    "include/mrpt/img/DistortionModel.h",
    "include/mrpt/img/TCamera.h",
    "include/mrpt/img/TColor.h",
    "include/mrpt/img/TPixelCoord.h",
    "include/mrpt/img/TStereoCamera.h",
    "include/mrpt/img/camera_geometry.h",
    "include/mrpt/img/color_maps.h",
    "include/mrpt/img/registerAllClasses.h",
]

PRIVATE_HEADERS = [
    "src/CImage.SSEx.h",
    "src/CImage_impl.h",
    "src/mrpt_font_10x20.h",
    "src/mrpt_font_18x18ja.h",
    "src/mrpt_font_5x7.h",
    "src/mrpt_font_6x13.h",
    "src/mrpt_font_6x13B.h",
    "src/mrpt_font_6x13O.h",
    "src/mrpt_font_9x15.h",
    "src/mrpt_font_9x15B.h",
    "src/remap_bilinear.h",
    "src/stb/stb_image.h",
    "src/stb/stb_image_resize2.h",
    "src/stb/stb_image_write.h",
]

# Upstream's mrpt_add_library() compiles *.SSE2.cpp with -msse2 and
# *.SSSE3.cpp with "-msse3 -mssse3" (handle_special_simd_flags), so they are
# built as separate objects with those per-file flags here.
[
    cc_library(
        name = "mrpt_img_{}_library".format(simd.lower()),
        srcs = ["src/CImage.{}.cpp".format(simd)] + PRIVATE_HEADERS,
        hdrs = PUBLIC_HEADERS + [":config_h"],
        copts = ["-Wno-missing-template-arg-list-after-template-kw"] + select({
            "@platforms//cpu:x86_64": flags,
            "//conditions:default": [],
        }),
        includes = [
            "_gen/include",
            "include",
        ],
        local_defines = ros_local_defines(),
        visibility = ["//visibility:private"],
        deps = DEPENDENCIES.values() + CC_DEPS,
        alwayslink = True,
    )
    for simd, flags in {
        "SSE2": ["-msse2"],
        "SSSE3": [
            "-msse3",
            "-mssse3",
        ],
    }.items()
]

cc_library(
    name = "mrpt_img_library",
    srcs = PRIVATE_HEADERS + [
        "src/CCanvas.cpp",
        "src/CImage.cpp",
        "src/CImagePyramid.cpp",
        "src/CImage_bayer.cpp",
        "src/CImage_impl.cpp",
        "src/CImage_loadXPM.cpp",
        "src/CMappedImage.cpp",
        "src/CStereoRectifyMap.cpp",
        "src/CUndistortMap.cpp",
        "src/CVideoFileWriter.cpp",
        "src/TCamera.cpp",
        "src/TColor.cpp",
        "src/TPixelCoord.cpp",
        "src/TStereoCamera.cpp",
        "src/camera_geometry.cpp",
        "src/color_maps.cpp",
        "src/registerAllClasses.cpp",
    ],
    hdrs = PUBLIC_HEADERS + [":config_h"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":mrpt_img_sse2_library",
        ":mrpt_img_ssse3_library",
    ],
)

cc_shared_library(
    name = "mrpt_img",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mrpt_img_library"],
)

TEST_DEPENDENCIES = DEPENDENCIES | {
    ":mrpt_img": ":mrpt_img_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_mrpt_img",
    srcs = [
        "tests/CCanvas_unittest.cpp",
        "tests/CImagePyramid_unittest.cpp",
        "tests/CImage_SSEx_unittest.cpp",
        "tests/CImage_legacy_serialization_unittest.cpp",
        "tests/CImage_loadFromBayerBuffer_unittest.cpp",
        "tests/CImage_loadFromEncodedBuffer_unittest.cpp",
        "tests/CImage_loadXPM_unittest.cpp",
        "tests/CImage_unittest.cpp",
        "tests/CMappedImage_unittest.cpp",
        "tests/CUndistortMap_unittest.cpp",
        "tests/CVideoFileWriter_unittest.cpp",
        "tests/TCamera_unittest.cpp",
        "tests/TColor_unittest.cpp",
        "tests/TPixelCoord_unittest.cpp",
        "tests/TStereoCamera_unittest.cpp",
        "tests/camera_geometry_unittest.cpp",
        "tests/color_maps_unittest.cpp",
        "tests/legacy_serialization.h",
        "@mrpt_common//:common_sources/mrpt_test_main.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ["CMAKE_UNITTEST_BASEDIR=\\\".\\\""],
    deps = TEST_DEPENDENCIES.values() + CC_DEPS + [
        "@mrpt_common//:mrpt_test_common",
        "@rosdistro//cc:googletest",
    ],
)

cc_library(
    name = "_bindings.cpython-314-x86_64-linux-gnu_library",
    srcs = ["python_bindings/mrpt_img_py.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":mrpt_img_library",
        "@rosdistro//cc:pybind11",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_shared_library(
    name = "_bindings.cpython-314-x86_64-linux-gnu",
    dynamic_deps = DEPENDENCIES.keys() + [":mrpt_img"],
    shared_lib_name = "mrpt/img/_bindings.so",
    deps = [":_bindings.cpython-314-x86_64-linux-gnu_library"],
)

py_library(
    name = "mrpt",
    srcs = ["python/mrpt/img/__init__.py"],
    imports = ["python"],
    deps = [
        "@mrpt_config//:mrpt",
        "@mrpt_io//:mrpt",
        "@mrpt_math//:mrpt",
    ],
)

expand_template(
    name = "config_h",
    out = "_gen/include/mrpt/img/config.h",
    substitutions = {
        "${CMAKE_MRPT_HAS_ASIAN_FONTS}": "1",
    },
    template = "config.h.in",
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_img",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_img": [
            "libmrpt_img.so.3.3",
            "libmrpt_img.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_common//:ament_package",
        "@mrpt_config//:ament_package",
        "@mrpt_io//:ament_package",
        "@mrpt_math//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    egg_info = False,
    headers = [":config_h"] + PUBLIC_HEADERS,
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mrpt_img",
    ],
    package_xml = "package.xml",
    python = [
        ":mrpt",
        ":_bindings.cpython-314-x86_64-linux-gnu",
    ],
    python_strip_prefix = "python",
    sonames = {
        "mrpt_img": [
            "libmrpt_img.so.3.3",
            "libmrpt_img.so.3.3.1",
        ],
    },
    deps = [":ament_index"] + [
        "@mrpt_common//:ament_package",
        "@mrpt_config//:ament_package",
        "@mrpt_io//:ament_package",
        "@mrpt_math//:ament_package",
    ],
)
