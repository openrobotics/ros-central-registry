load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

# Upstream builds lely-core (pinned commit) via ExternalProject_Add and
# exports its libraries. Here lely-core is a staged third-party module wired
# through rosdistro (@rosdistro//cc:lely_*); these targets keep the names the
# canopen_* packages link against: lely-<lib> (shared) and lely-<lib>_library.
LELY_LIBS = [
    "can",
    "co",
    "coapp",
    "ev",
    "io",
    "io2",
    "libc",
    "tap",
    "util",
]

[alias(
    name = "lely-" + lib,
    actual = "@rosdistro//cc:lely_" + lib,
) for lib in LELY_LIBS]

[alias(
    name = "lely-%s_library" % lib,
    actual = "@rosdistro//cc:lely_%s_library" % lib,
) for lib in LELY_LIBS]

cc_library(
    name = "lely",
    deps = [":lely-%s_library" % lib for lib in LELY_LIBS],
)

# cogen: expands bus.yml for cogen_dcf() (ament_python_install_package(cogen)).
py_library(
    name = "cogen_py",
    srcs = [
        "cogen/__init__.py",
        "cogen/cogen.py",
    ],
    imports = ["."],
    deps = [
        requirement("pyyaml"),
        "@rosdistro//python:dcf_tools",
    ],
)

py_binary(
    name = "cogen_tool",
    srcs = ["cogen/cogen.py"],
    main = "cogen/cogen.py",
    deps = [":cogen_py"],
)

ament_index(
    name = "ament_index",
    data = ["cmake/lely_core_libraries-extras.cmake"],
    data_strip_prefixes = ["cmake->cmake"],
    libraries = ["@rosdistro//cc:lely_" + lib for lib in LELY_LIBS],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    console_scripts = {
        "cogen": "cogen.cogen:main",
    },
    package_xml = "package.xml",
    python = [":cogen_py"],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
    ],
)
