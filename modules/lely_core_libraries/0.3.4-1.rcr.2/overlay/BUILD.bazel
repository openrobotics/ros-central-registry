e length of the string at <b>s</b> or\n * <b>maxlen</b>.\n */\nsize_t strnlen(const char *s, size_t maxlen);\n#endif\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif // !LELY_LIBC_STRING_H_\n"],
