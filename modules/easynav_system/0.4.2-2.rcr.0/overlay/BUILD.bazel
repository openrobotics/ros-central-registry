cc_library(
    name = "easynav_system_library",
    srcs = [
        "src/easynav_system/GoalManager.cpp",
        "src/easynav_system/GoalManagerClient.cpp",
        "src/easynav_system/SystemNode.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/easynav_system",
        "tests",
    ],
    local_defines = ros_local_defines() + [
        "EASYNAV_DEBUG_WITH_YAETS",
        "GLAD_API_CALL_EXPORT",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "easynav_system",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":easynav_system_library"],
)

collect_transitive_dynamic_deps(
