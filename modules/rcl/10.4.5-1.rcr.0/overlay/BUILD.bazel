load("@ament_cmake_gen_version_h//:defs.bzl", "generate_version_h")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARY

HEADERS = glob(["include/**/*.h"])

DEPENDENCIES = {
    "@rcl_logging_interface//:rcl_logging_interface": "@rcl_logging_interface//:rcl_logging_interface_library",
    "@rcl_logging_spdlog//:rcl_logging_spdlog": "@rcl_logging_spdlog//:rcl_logging_spdlog_library",
    "@rcl_yaml_param_parser//:rcl_yaml_param_parser": "@rcl_yaml_param_parser//:rcl_yaml_param_parser_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw_implementation//:rmw_implementation": "@rmw_implementation//:rmw_implementation_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
    "@tracetools//:tracetools": "@tracetools//:tracetools_library",
}

cc_library(
    name = "rcl_library",
    srcs = glob([
        "src/**/*.c",
        "src/**/*.h",
    ]),
    hdrs = HEADERS,
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@rcl_interfaces//:c",
        "@service_msgs//:c",
        "@type_description_interfaces//:c",
    ],
)

cc_shared_library(
    name = "rcl",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rcl_library"],
    deps = [":rcl_library"],
)

### TRANSITIVELY COLLECT ALL DYNAMIC DEPS TO ENSURE LINKING WORKS

# This is a workaround for the fact that dynamic_deps does not work transitively.
# So, if you have a (foo -> bar -> baz) dynamic_dep dep chain, the symbols from
# foo will not be available to baz at compile-time. This resolves that by running
# an aspect over the dynamic_deps attribute to collect everything in the chain.

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rcl"],
    visibility = ["//visibility:private"],
)

### TESTING

cc_library(
    name = "wait_for_entity_helpers",
    srcs = ["test/rcl/wait_for_entity_helpers.cpp"],
    hdrs = ["test/rcl/wait_for_entity_helpers.hpp"],
    includes = ["test"],
    local_defines = ros_local_defines(),
    deps = [
        ":rcl_library",
        "@osrf_testing_tools_cpp//:memory_tools",
    ],
)

[
    cc_test(
        name = test,
        timeout = "moderate",
        srcs = [
            "test/rcl/{}.cpp".format(test),
        ] + glob([
            "src/rcl/**/*.h",
            "test/rcl/**/*.h",
            "test/rcl/**/*.hpp",
            "test/mocking_utils/*.hpp",
        ]),
        data = glob(["test/resources/**"]),
        dynamic_deps = [":transitive_dynamic_deps"],
        includes = ["src/rcl"],
        local_defines = ros_local_defines() + ["RMW_TIMESTAMPS_SUPPORTED=1"],
        deps = DEPENDENCIES.values() + [
            ":rcl_library",
            ":wait_for_entity_helpers",
            "@osrf_testing_tools_cpp//:memory_tools",
            "@rosdistro//cc:googletest",
            "@rosdistro//cc:mimick",
            "@rules_cc//cc/runfiles",
            "@test_msgs//:c",
            "@test_msgs//:cc",
        ],
    )
    for test in [
        "test_arguments",
        "test_client",
        "test_common",
        "test_context",
        "test_count_matched",
        "test_discovery_options",
        "test_domain_id",
        "test_events",
        "test_expand_topic_name",
        "test_get_actual_qos",
        "test_get_node_names",
        "test_get_type_description_service",
        "test_graph",
        "test_guard_condition",
        "test_info_by_service",
        "test_info_by_topic",
        "test_init",
        "test_lexer",
        "test_lexer_lookahead",
        "test_log_level",
        "test_logging",
        "test_logging_rosout",
        "test_namespace",
        "test_network_flow_endpoints",
        "test_node",
        "test_node_type_cache",
        "test_publisher",
        "test_publisher_wait_all_ack",
        "test_remap",
        "test_remap_integration",
        "test_rmw_impl_id_check_func",
        "test_security",
        "test_service",
        "test_service_event_publisher",
        "test_subscription",
        "test_subscription_buffer_backend_options",
        "test_subscription_content_filter_options",
        "test_time",
        "test_timer",
        "test_type_description_conversions",
        "test_type_hash",
        "test_validate_enclave_name",
        "test_validate_topic_name",
        "test_wait",
    ]
]

[
    cc_binary(
        name = exe,
        testonly = True,
        srcs = [
            "test/rcl/{}.cpp".format(exe),
        ] + glob([
            "src/rcl/**/*.h",
            "test/rcl/**/*.h",
            "test/rcl/**/*.hpp",
        ]),
        dynamic_deps = [":transitive_dynamic_deps"],
        includes = ["src/rcl"],
        local_defines = ros_local_defines(),
        deps = DEPENDENCIES.values() + [
            ":rcl_library",
            ":wait_for_entity_helpers",
            "@osrf_testing_tools_cpp//:memory_tools",
            "@rosdistro//cc:googletest",
            "@test_msgs//:c",
            "@test_msgs//:cc",
        ],
    )
    for exe in [
        "client_fixture",
        "service_fixture",
        "test_rmw_impl_id_check_exe",
    ]
]

expand_template(
    name = "test_services_py",
    testonly = True,
    out = "test_services.py",
    substitutions = {
        "'@TEST_EXECUTABLE1@'": "os.path.join(os.path.dirname(__file__), 'service_fixture')",
        "@TEST_EXECUTABLE1_NAME@": "service_fixture",
        "'@TEST_EXECUTABLE2@'": "os.path.join(os.path.dirname(__file__), 'client_fixture')",
        "@TEST_EXECUTABLE2_NAME@": "client_fixture",
        "@TEST_NAME@": "test_services",
    },
    template = "test/rcl/test_two_executables.py.in",
)

py_pytest(
    name = "test_services",
    srcs = ["test_services.py"],
    args = [
        "-p",
        "launch_testing.pytest.hooks",
    ],
    data = [
        ":client_fixture",
        ":service_fixture",
    ],
    deps = [
        "@launch",
        "@launch_testing",
    ],
)

expand_template(
    name = "test_rmw_impl_id_check_py",
    testonly = True,
    out = "test_rmw_impl_id_check.py",
    substitutions = {
        "cmd=['@TEST_RMW_IMPL_ID_CHECK_EXECUTABLE_NAME@']": "cmd=[os.path.join(os.path.dirname(__file__), 'test_rmw_impl_id_check_exe')]",
        "@TEST_RMW_IMPL_ID_CHECK_EXECUTABLE_NAME@": "test_rmw_impl_id_check_exe",
        "'@rmw_implementation@'": "os.environ.get('RMW_IMPLEMENTATION', 'rmw_fastrtps_cpp')",
    },
    template = "test/rcl/test_rmw_impl_id_check.py.in",
)

py_pytest(
    name = "test_rmw_impl_id_check",
    srcs = ["test_rmw_impl_id_check.py"],
    args = [
        "-p",
        "launch_testing.pytest.hooks",
    ],
    data = [
        ":test_rmw_impl_id_check_exe",
    ],
    deps = [
        "@launch",
        "@launch_testing",
    ],
)

# Real rcl relies on ament_cmake_gen_version_h's CMake macro
# (ament_generate_version_header()) to generate and install this.
generate_version_h(
    name = "version_h",
    out = "include/rcl/version.h",
)

