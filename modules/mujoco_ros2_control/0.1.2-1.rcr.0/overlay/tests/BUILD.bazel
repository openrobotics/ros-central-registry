load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

TEST_DEPS = [
    "//:mujoco_ros2_control_library",
    "@hardware_interface//:hardware_interface_library",
    "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:bazel_test_helper",
    "@rosdistro//cc:googletest",
]

[cc_test(
    name = name,
    srcs = [name + ".cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = TEST_DEPS + (["//:src_private_headers"] if name == "test_mujoco_simulation" else []),
) for name in [
    "test_headless_init",
    "test_mujoco_simulation",
    "test_mujoco_system_interface",
    "test_plugin",
]]

py_pytest(
    name = "test_urdf_to_mujoco_utils",
    srcs = ["test_urdf_to_mujoco_utils.py"],
    data = ["//:ament_index"],
    deps = [
        "//:mujoco_ros2_control_py",
        "@ament_index_python",
        "@controller_manager//:controller_manager_py",
        "@geometry_msgs//:py",
        "@mujoco_ros2_control_msgs//:py",
        "@nav_msgs//:py",
        "@ros2pkg",
        "@rosgraph_msgs//:py",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        "@urdfdom_py",
    ],
)
