load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {}

CC_DEPS = []

alias(
    name = "lodepng_library",
    actual = "@rosdistro//cc:lodepng_library",
)

genrule(
    name = "static_lodepng_a",
    srcs = [":lodepng_library"],
    outs = ["liblodepng.a"],
    cmd = "for f in $(SRCS); do case $$f in *.a) cp $$f $@; exit 0;; esac; done; ar rcs $@",
)

alias(
    name = "simulate_library",
    actual = "@rosdistro//cc:mujoco_simulate_library",
)

genrule(
    name = "static_simulate_a",
    srcs = [":simulate_library"],
    outs = ["libsimulate.a"],
    cmd = "for f in $(SRCS); do case $$f in *.a) cp $$f $@; exit 0;; esac; done; ar rcs $@",
)

cc_library(
    name = "mujoco_ros2_control_library",
    srcs = [
        "src/mujoco_simulation.cpp",
        "src/mujoco_system_interface.cpp",
    ],
    hdrs = [
        "include/mujoco_ros2_control/data.hpp",
        "include/mujoco_ros2_control/mujoco_simulation.hpp",
        "include/mujoco_ros2_control/mujoco_system_interface.hpp",
        "include/mujoco_ros2_control/sim_display_text.hpp",
        "include/mujoco_ros2_control/utils.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/mujoco_ros2_control",
        "src",
        "tests",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mujoco_ros2_control",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":mujoco_ros2_control_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "ros2_control_node",
    srcs = [
        "include/mujoco_ros2_control/data.hpp",
        "include/mujoco_ros2_control/mujoco_simulation.hpp",
        "include/mujoco_ros2_control/mujoco_system_interface.hpp",
        "include/mujoco_ros2_control/sim_display_text.hpp",
        "include/mujoco_ros2_control/utils.hpp",
        "src/mujoco_ros2_control_node.cpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "include",
        "include/mujoco_ros2_control",
        "src",
        "tests",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

py_library(
    name = "mujoco_ros2_control_py",
    srcs = [
        "mujoco_ros2_control/__init__.py",
        "mujoco_ros2_control/urdf_to_mujoco_utils.py",
    ],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@controller_manager//:controller_manager_py",
        "@geometry_msgs//:py",
        "@mujoco_ros2_control_msgs//:py",
        "@nav_msgs//:py",
        "@ros2pkg",
        "@rosgraph_msgs//:py",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        "@urdfdom_py",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "resources/mujoco_logo.png",
        "resources/scene.xml",
        "scripts/find_missing_inertias.py",
        "scripts/make_mjcf_from_robot_description.py",
        "scripts/requirements.txt",
        "scripts/robot_description_to_mjcf.sh",
    ],
    data_strip_prefix = "scripts",
    lib_data = [
        ":ros2_control_node",
        "scripts/find_missing_inertias.py",
        "scripts/make_mjcf_from_robot_description.py",
        "scripts/robot_description_to_mjcf.sh",
    ],
    libraries = [
        ":mujoco_ros2_control",
        ":static_simulate_a",
        ":static_lodepng_a",
    ],
    package_xml = "package.xml",
    plugin_category = "hardware_interface",
    plugins = ["mujoco_system_interface_plugin.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_index_python//:ament_package",
        "@backward_ros//:ament_package",
        "@control_toolbox//:ament_package",
        "@controller_manager//:ament_package",
        "@geometry_msgs//:ament_package",
        "@hardware_interface//:ament_package",
        "@mujoco_ros2_control_msgs//:ament_package",
        "@mujoco_ros2_control_plugins//:ament_package",
        "@mujoco_vendor//:ament_package",
        "@nav_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@realtime_tools//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@ros2pkg//:ament_package",
        "@rosgraph_msgs//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tinyxml2_vendor//:ament_package",
        "@transmission_interface//:ament_package",
        "@urdfdom_py//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "Eigen3",
        "ament_index_cpp",
        "control_toolbox",
        "geometry_msgs",
        "hardware_interface",
        "mujoco_ros2_control_msgs",
        "mujoco_ros2_control_plugins",
        "mujoco_vendor",
        "nav_msgs",
        "pluginlib",
        "rclcpp",
        "rclcpp_lifecycle",
        "realtime_tools",
        "rosgraph_msgs",
        "sensor_msgs",
        "transmission_interface",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_mujoco_ros2_control",
    headers = [
        "include/mujoco_ros2_control/data.hpp",
        "include/mujoco_ros2_control/mujoco_simulation.hpp",
        "include/mujoco_ros2_control/mujoco_system_interface.hpp",
        "include/mujoco_ros2_control/sim_display_text.hpp",
        "include/mujoco_ros2_control/utils.hpp",
    ],
    include_prefix = "",
    libraries = [
        ":mujoco_ros2_control",
        ":static_simulate_a",
        ":static_lodepng_a",
    ],
    package_xml = "package.xml",
    python = [":mujoco_ros2_control_py"],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_index_python//:ament_package",
        "@backward_ros//:ament_package",
        "@control_toolbox//:ament_package",
        "@controller_manager//:ament_package",
        "@geometry_msgs//:ament_package",
        "@hardware_interface//:ament_package",
        "@mujoco_ros2_control_msgs//:ament_package",
        "@mujoco_ros2_control_plugins//:ament_package",
        "@mujoco_vendor//:ament_package",
        "@nav_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@realtime_tools//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@ros2pkg//:ament_package",
        "@rosgraph_msgs//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tinyxml2_vendor//:ament_package",
        "@transmission_interface//:ament_package",
        "@urdfdom_py//:ament_package",
    ],
)
