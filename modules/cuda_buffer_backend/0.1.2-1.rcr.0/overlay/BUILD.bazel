cc_test(
    name = "test_cuda_buffer_backend",
    srcs = ["test/test_cuda_buffer_backend.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_cuda_h",
        ":gen_cuda_runtime_h",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        ":ament_index",
        ":cuda_image_gpu_relay_component",
        ":cuda_image_publisher_component",
        ":cuda_image_subscriber_component",
    ] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/cuda_buffer_backend",
    ],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
    ],
    # Requires a real CUDA device: the hermetic build compiles against stub
    # cuda.h/cuda_runtime.h headers (no GPU in the sandbox), so device buffers
    # are never actually allocated or copied and content validation fails.
    tags = [
        "manual",
        "xfail",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":cuda_buffer_backend_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

