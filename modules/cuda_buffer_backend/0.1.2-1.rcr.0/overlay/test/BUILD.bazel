load("@launch_testing_ros//:defs.bzl", "launch_ros_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

launch_ros_test(
    name = "test_cuda_image_cpu_fallback_fastrtps_launch_py",
    src = "test_cuda_image_cpu_fallback_fastrtps_launch.py",
    data = [
        "//:ament_index",
        "@rclcpp_components//:ament_index",
    ],
    # xfail: composable nodes are not registered in the ament index under Bazel
    tags = [
        "manual",
        "xfail",
    ],
    deps = [
        "@std_msgs//:py",
    ],
)

