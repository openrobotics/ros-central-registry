load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@keyboard_handler//:keyboard_handler": "@keyboard_handler//:keyboard_handler_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosbag2_compression": "@rosbag2_compression//:rosbag2_compression_library",
    "@rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@test_msgs//:cc_shared": "@test_msgs//:cc",
}

TEST_DEPENDENCIES = DEPENDENCIES | {
    "//:rosbag2_transport": "//:rosbag2_transport_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:component_manager_library",
    "@rosbag2_test_common": "@rosbag2_test_common//:rosbag2_test_common_library",
}

[cc_test(
    name = test.removesuffix(".py"),
    srcs = ["rosbag2_transport/{0}.cpp".format(test)] + [
        "rosbag2_transport/composition_manager_test_fixture.hpp",
        "rosbag2_transport/mock_keyboard_handler.hpp",
        "rosbag2_transport/mock_player.hpp",
        "rosbag2_transport/mock_recorder.hpp",
        "rosbag2_transport/mock_sequential_reader.hpp",
        "rosbag2_transport/mock_sequential_writer.hpp",
        "rosbag2_transport/record_integration_fixture.hpp",
        "rosbag2_transport/rosbag2_play_duration_until_fixture.hpp",
        "rosbag2_transport/rosbag2_play_test_fixture.hpp",
        "rosbag2_transport/rosbag2_transport_test_fixture.hpp",
    ],
    data = ["//:ament_index"] + [
        "resources/mcap/rewriter_a/metadata.yaml",
        "resources/mcap/rewriter_a/rewriter_a_0.mcap",
        "resources/mcap/rewriter_b/metadata.yaml",
        "resources/mcap/rewriter_b/rewriter_b_0.mcap",
        "resources/mcap/test_bag_for_seek/metadata.yaml",
        "resources/mcap/test_bag_for_seek/test_bag_for_seek_0.mcap",
        "resources/player_node_params.yaml",
        "resources/qos_profile_overrides.yaml",
        "resources/recorder_node_params.yaml",
        "resources/sqlite3/rewriter_a/metadata.yaml",
        "resources/sqlite3/rewriter_a/rewriter_a_0.db3",
        "resources/sqlite3/rewriter_b/metadata.yaml",
        "resources/sqlite3/rewriter_b/rewriter_b_0.db3",
        "resources/sqlite3/test_bag_for_seek/metadata.yaml",
        "resources/sqlite3/test_bag_for_seek/test_bag_for_seek_0.db3",
        "resources/static_topics_list.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines() + ['_SRC_RESOURCES_DIR_PATH=\\"../rosbag2_transport+/test/resources\\"'],
    deps = TEST_DEPENDENCIES.values() + [
        "@rosdistro//cc:googletest",
    ],
) for test in [
    "test_burst",
    "test_composable_player",
    "test_composable_recorder",
    "test_keyboard_controls",
    "test_load_composable_components",
    "test_play",
    "test_play_callbacks",
    "test_play_duration",
    "test_play_loop",
    "test_play_next",
    "test_play_publish_clock",
    "test_play_seek",
    "test_play_services",
    "test_play_timing",
    "test_play_topic_remap",
    "test_play_until",
    "test_player_progress_bar",
    "test_player_stop",
    "test_readers_manager",
    "test_record",
    "test_record_all",
    "test_record_all_ignore_leaf_topics",
    "test_record_all_include_unpublished_topics",
    "test_record_all_no_discovery",
    "test_record_all_use_sim_time",
    "test_record_options",
    "test_record_regex",
    "test_record_services",
    "test_record_static_topics",
    "test_recorder_event_notifier",
    "test_rewrite",
    "test_topic_filter",
    "test_type_description_hash",
]]
