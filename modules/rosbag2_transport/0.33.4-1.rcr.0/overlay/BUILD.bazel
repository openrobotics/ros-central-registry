load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/rosbag2_transport/bag_rewrite.hpp",
    "include/rosbag2_transport/config_options_from_node_params.hpp",
    "include/rosbag2_transport/delayed_action_task_runner.hpp",
    "include/rosbag2_transport/play_options.hpp",
    "include/rosbag2_transport/player.hpp",
    "include/rosbag2_transport/player_action_client.hpp",
    "include/rosbag2_transport/player_progress_bar.hpp",
    "include/rosbag2_transport/player_service_client.hpp",
    "include/rosbag2_transport/rclcpp_publisher_wrapper.hpp",
    "include/rosbag2_transport/reader_writer_factory.hpp",
    "include/rosbag2_transport/readers_manager.hpp",
    "include/rosbag2_transport/record_options.hpp",
    "include/rosbag2_transport/recorder.hpp",
    "include/rosbag2_transport/recorder_event_notifier.hpp",
    "include/rosbag2_transport/topic_filter.hpp",
    "include/rosbag2_transport/visibility_control.hpp",
]

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@keyboard_handler//:keyboard_handler": "@keyboard_handler//:keyboard_handler_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosbag2_compression//:rosbag2_compression": "@rosbag2_compression//:rosbag2_compression_library",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosbag2_interfaces//:cc_shared": "@rosbag2_interfaces//:cc",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

cc_library(
    name = "rosbag2_transport_library",
    srcs = [
        "src/rosbag2_transport/bag_rewrite.cpp",
        "src/rosbag2_transport/config_options_from_node_params.cpp",
        "src/rosbag2_transport/delayed_action_task_runner.cpp",
        "src/rosbag2_transport/delayed_action_task_runner_impl.hpp",
        "src/rosbag2_transport/locked_priority_queue.hpp",
        "src/rosbag2_transport/logging.hpp",
        "src/rosbag2_transport/play_options.cpp",
        "src/rosbag2_transport/player.cpp",
        "src/rosbag2_transport/player_action_client.cpp",
        "src/rosbag2_transport/player_progress_bar.cpp",
        "src/rosbag2_transport/player_progress_bar_impl.hpp",
        "src/rosbag2_transport/player_service_client.cpp",
        "src/rosbag2_transport/reader_writer_factory.cpp",
        "src/rosbag2_transport/readers_manager.cpp",
        "src/rosbag2_transport/readers_manager_impl.hpp",
        "src/rosbag2_transport/record_options.cpp",
        "src/rosbag2_transport/recorder.cpp",
        "src/rosbag2_transport/recorder_event_notifier.cpp",
        "src/rosbag2_transport/recorder_event_notifier_impl.hpp",
        "src/rosbag2_transport/topic_filter.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rosbag2_transport",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rosbag2_transport_library"],
)

rclcpp_components_register_node(
    name = "player",
    component = ":rosbag2_transport",
    node_name = "player",
    plugin = "rosbag2_transport::Player",
)

rclcpp_components_register_node(
    name = "recorder",
    component = ":rosbag2_transport",
    node_name = "recorder",
    plugin = "rosbag2_transport::Recorder",
)

COMPONENTS = [
    ":player_record",
    ":recorder_record",
]

ament_index(
    name = "ament_index",
    components = COMPONENTS,
    libraries = [":rosbag2_transport"],
    package_xml = "package.xml",
    deps = [
        "@rosbag2_compression_zstd//:ament_package",
        "@rosbag2_cpp//:ament_index",
        "@rosbag2_storage_default_plugins//:ament_index",
        "@test_msgs//:ament_index",
    ],
)

TEST_DEPENDENCIES = DEPENDENCIES | {
    ":rosbag2_transport": ":rosbag2_transport_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:component_manager_library",
    "@rosbag2_test_common": "@rosbag2_test_common//:rosbag2_test_common_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
)

ament_package(
    name = "ament_package",
    cmake_export_name = "export_rosbag2_transport",
    executables = [
        ":player",
        ":recorder",
    ],
    headers = HEADERS,
    libraries = [":rosbag2_transport"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@composition_interfaces//:ament_package",
        "@keyboard_handler//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rmw_implementation_cmake//:ament_package",
        "@rosbag2_compression//:ament_package",
        "@rosbag2_compression_zstd//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosbag2_interfaces//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_storage_default_plugins//:ament_package",
        "@rosbag2_test_common//:ament_package",
        "@rosdistro//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
