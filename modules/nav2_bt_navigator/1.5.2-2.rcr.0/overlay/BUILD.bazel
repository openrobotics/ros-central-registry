CC_DEPS = [
    "@geometry_msgs//:cc",
    "@nav2_core//:nav2_core_library",
    "@nav2_msgs//:cc",
    "@nav2_ros_common//:nav2_ros_common",
    "@nav_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "bt_navigator_core_library",
    srcs = ["src/bt_navigator.cpp"],
    hdrs = [
        "include/nav2_bt_navigator/bt_navigator.hpp",
        "include/nav2_bt_navigator/navigators/navigate_through_poses.hpp",
        "include/nav2_bt_navigator/navigators/navigate_to_pose.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/nav2_bt_navigator",
    ],
    local_defines = ros_local_defines() + [
        "BTCPP_LIBRARY_VERSION=\\\"4.10.0\\\"",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "bt_navigator_core",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":bt_navigator_core_library"],
)

cc_library(
    name = "nav2_navigate_through_poses_library",
    srcs = ["src/navigators/navigate_through_poses.cpp"],
    hdrs = [
        "include/nav2_bt_navigator/bt_navigator.hpp",
        "include/nav2_bt_navigator/navigators/navigate_through_poses.hpp",
        "include/nav2_bt_navigator/navigators/navigate_to_pose.hpp",
