    includes = [
        "include",
        "include/nav2_bt_navigator",
    ],
    local_defines = ros_local_defines() + [
        "BTCPP_LIBRARY_VERSION=\\\"4.10.0\\\"",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "nav2_navigate_through_poses",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":nav2_navigate_through_poses_library"],
)

cc_library(
    name = "nav2_navigate_to_pose_navigator_library",
    srcs = ["src/navigators/navigate_to_pose.cpp"],
    hdrs = [
        "include/nav2_bt_navigator/bt_navigator.hpp",
        "include/nav2_bt_navigator/navigators/navigate_through_poses.hpp",
        "include/nav2_bt_navigator/navigators/navigate_to_pose.hpp",
