    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "nav2_navigate_to_pose_navigator",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":nav2_navigate_to_pose_navigator_library"],
)

rclcpp_components_register_nodes(
    name = "bt_navigator_core_components",
    component = ":bt_navigator_core",
    plugins = ["nav2_bt_navigator::BtNavigator"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":bt_navigator_core",
        ":nav2_navigate_through_poses",
        ":nav2_navigate_to_pose_navigator",
    ],
)

cc_binary(
    name = "bt_navigator",
    srcs = ["src/main.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/nav2_bt_navigator",
    ],
    local_defines = ros_local_defines() + [
        "BTCPP_LIBRARY_VERSION=\\\"4.10.0\\\"",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":bt_navigator_core_library"],
)

