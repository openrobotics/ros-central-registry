load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosidl_default_generators//:defs.bzl", "default_generators")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:SbgAirData",
        "//msg:SbgAirDataStatus",
        "//msg:SbgEkfEuler",
        "//msg:SbgEkfNav",
        "//msg:SbgEkfQuat",
        "//msg:SbgEkfRotAccel",
        "//msg:SbgEkfStatus",
        "//msg:SbgEkfVelBody",
        "//msg:SbgEvent",
        "//msg:SbgGpsHdt",
        "//msg:SbgGpsPos",
        "//msg:SbgGpsPosStatus",
        "//msg:SbgGpsRaw",
        "//msg:SbgGpsVel",
        "//msg:SbgGpsVelStatus",
        "//msg:SbgImuData",
        "//msg:SbgImuShort",
        "//msg:SbgImuStatus",
        "//msg:SbgMag",
        "//msg:SbgMagCalib",
        "//msg:SbgMagStatus",
        "//msg:SbgOdoVel",
        "//msg:SbgShipMotion",
        "//msg:SbgShipMotionStatus",
        "//msg:SbgStatus",
        "//msg:SbgStatusAiding",
        "//msg:SbgStatusCom",
        "//msg:SbgStatusGeneral",
        "//msg:SbgUtcTime",
        "//msg:SbgUtcTimeStatus",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@nmea_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@rtcm_msgs//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@urdf//:ament_package",
        "@xacro//:ament_package",
    ],
)
