load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@nav_msgs//:cc",
    "@nmea_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rtcm_msgs//:cc",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
    "@std_srvs//:cc",
    "@tf2_msgs//:cc",
]

cc_library(
    name = "sbgECom_library",
    srcs = glob(
        [
            "external/sbgECom/common/**/*.c",
            "external/sbgECom/src/**/*.c",
        ],
        exclude = ["external/sbgECom/common/interfaces/sbgInterfaceSerialWin.c"],
    ),
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "_gen/include/sbg_driver",
        "_gen/include/sbg_driver/sbg_driver",
        "external/sbgECom/common",
        "external/sbgECom/src",
        "include",
        "include/sbg_driver",
    ],
    local_defines = ros_local_defines() + [
        "SBG_COMMON_STATIC_USE",
        "SBG_ECOM_USE_DEPRECATED_MACROS",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":cc",
    ],
)

genrule(
    name = "static_sbgECom_a",
    srcs = [":sbgECom_library"],
    outs = ["libsbgECom.a"],
    cmd = "for f in $(SRCS); do case $$f in *.a) cp $$f $@; exit 0;; esac; done; ar rcs $@",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "sbg_device",
    srcs = [
        "src/config_applier.cpp",
        "src/config_store.cpp",
        "src/main.cpp",
        "src/message_publisher.cpp",
        "src/message_wrapper.cpp",
        "src/sbg_device.cpp",
        "src/sbg_ros_helpers.cpp",
        "src/sbg_utm.cpp",
    ] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "_gen/include/sbg_driver",
        "_gen/include/sbg_driver/sbg_driver",
        "external/sbgECom/common",
        "external/sbgECom/src",
        "include",
        "include/sbg_driver",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines() + ["SBG_COMMON_STATIC_USE"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":cc",
        ":sbgECom_library",
    ],
)

