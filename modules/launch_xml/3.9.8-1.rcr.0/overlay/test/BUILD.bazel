load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

exports_files([
    "launch_xml/executable.xml",
    "launch_xml/parser_no_extensions.py",
    "launch_xml/test_append_env.py",
    "launch_xml/test_arg.py",
    "launch_xml/test_boolean_substitution.py",
    "launch_xml/test_deprecated_launch_file.py",
    "launch_xml/test_executable.py",
    "launch_xml/test_for_loop.py",
    "launch_xml/test_group.py",
    "launch_xml/test_include.py",
    "launch_xml/test_let_var.py",
    "launch_xml/test_list.py",
    "launch_xml/test_log.py",
    "launch_xml/test_path_join_substitution.py",
    "launch_xml/test_rep_env.py",
    "launch_xml/test_reset.py",
    "launch_xml/test_set_env.py",
    "launch_xml/test_string_join_substitution.py",
    "launch_xml/test_timer.py",
    "launch_xml/test_unset_env.py",
    "test_copyright.py",
    "test_flake8.py",
    "test_pep257.py",
    "test_xmllint.py",
])

[py_pytest(
    name = f.split("/")[-1].removesuffix(".py"),
    srcs = [f],
    data = [
        "launch_xml/executable.xml",
        "launch_xml/parser_no_extensions.py",
    ],
    deps = ["//:launch_xml"],
) for f in [
    "launch_xml/test_append_env.py",
    "launch_xml/test_arg.py",
    "launch_xml/test_boolean_substitution.py",
    "launch_xml/test_deprecated_launch_file.py",
    "launch_xml/test_executable.py",
    "launch_xml/test_for_loop.py",
    "launch_xml/test_group.py",
    "launch_xml/test_include.py",
    "launch_xml/test_let_var.py",
    "launch_xml/test_list.py",
    "launch_xml/test_log.py",
    "launch_xml/test_path_join_substitution.py",
    "launch_xml/test_rep_env.py",
    "launch_xml/test_reset.py",
    "launch_xml/test_set_env.py",
    "launch_xml/test_string_join_substitution.py",
    "launch_xml/test_timer.py",
    "launch_xml/test_unset_env.py",
]]
