    "@lifecycle_msgs//:cc",
    "@control_msgs//:cc",
    "@controller_interface//:controller_interface_library",
    "@controller_manager//:controller_manager_library",
    "@generate_parameter_library//:generate_parameter_library",
    "@geometry_msgs//:cc",
    "@hardware_interface//:hardware_interface_library",
    "@nav_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
