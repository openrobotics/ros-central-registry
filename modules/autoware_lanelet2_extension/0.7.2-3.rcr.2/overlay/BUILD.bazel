load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@autoware_map_msgs//:cc_shared": "@autoware_map_msgs//:cc",
    "@autoware_planning_msgs//:cc_shared": "@autoware_planning_msgs//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@lanelet2_core//:lanelet2_core": "@lanelet2_core//:lanelet2_core_library",
    "@lanelet2_io//:lanelet2_io": "@lanelet2_io//:lanelet2_io_library",
    "@lanelet2_projection//:lanelet2_projection": "@lanelet2_projection//:lanelet2_projection_library",
    "@lanelet2_routing//:lanelet2_routing": "@lanelet2_routing//:lanelet2_routing_library",
    "@lanelet2_traffic_rules//:lanelet2_traffic_rules": "@lanelet2_traffic_rules//:lanelet2_traffic_rules_library",
    "@lanelet2_validation//:lanelet2_validation": "@lanelet2_validation//:lanelet2_validation_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:boost.serialization_shared": "@rosdistro//cc:boost.serialization_library",
    "@rosdistro//cc:geographiclib": "@rosdistro//cc:geographiclib_library",
    "@rosdistro//cc:pugixml": "@rosdistro//cc:pugixml_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@visualization_msgs//:cc_shared": "@visualization_msgs//:cc",
}

CC_DEPS = [
    "@rosdistro//cc:boost.optional",
    "@rosdistro//cc:boost.variant",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:range-v3",
]

HEADERS = [
    "include/autoware_lanelet2_extension/io/autoware_osm_parser.hpp",
    "include/autoware_lanelet2_extension/localization/landmark.hpp",
    "include/autoware_lanelet2_extension/projection/mgrs_projector.hpp",
    "include/autoware_lanelet2_extension/projection/transverse_mercator_projector.hpp",
    "include/autoware_lanelet2_extension/regulatory_elements/Forward.hpp",
    "include/autoware_lanelet2_extension/regulatory_elements/autoware_traffic_light.hpp",
    "include/autoware_lanelet2_extension/regulatory_elements/bus_stop_area.hpp",
    "include/autoware_lanelet2_extension/regulatory_elements/crosswalk.hpp",
    "include/autoware_lanelet2_extension/regulatory_elements/detection_area.hpp",
    "include/autoware_lanelet2_extension/regulatory_elements/no_parking_area.hpp",
    "include/autoware_lanelet2_extension/regulatory_elements/no_stopping_area.hpp",
    "include/autoware_lanelet2_extension/regulatory_elements/road_marking.hpp",
    "include/autoware_lanelet2_extension/regulatory_elements/speed_bump.hpp",
    "include/autoware_lanelet2_extension/regulatory_elements/virtual_traffic_light.hpp",
    "include/autoware_lanelet2_extension/utility/message_conversion.hpp",
    "include/autoware_lanelet2_extension/utility/query.hpp",
    "include/autoware_lanelet2_extension/utility/route_checker.hpp",
    "include/autoware_lanelet2_extension/utility/utilities.hpp",
    "include/autoware_lanelet2_extension/version.hpp",
    "include/autoware_lanelet2_extension/visualization/visualization.hpp",
]

# ament_auto_add_library(autoware_lanelet2_extension_lib SHARED ...)
cc_library(
    name = "autoware_lanelet2_extension_lib_library",
    srcs = [
        "lib/autoware_osm_parser.cpp",
        "lib/autoware_traffic_light.cpp",
        "lib/bus_stop_area.cpp",
        "lib/crosswalk.cpp",
        "lib/detection_area.cpp",
        "lib/landmark.cpp",
        "lib/message_conversion.cpp",
        "lib/mgrs_projector.cpp",
        "lib/no_parking_area.cpp",
        "lib/no_stopping_area.cpp",
        "lib/normalize_radian.hpp",
        "lib/query.cpp",
        "lib/road_marking.cpp",
        "lib/route_checker.cpp",
        "lib/speed_bump.cpp",
        "lib/transverse_mercator_projector.cpp",
        "lib/utilities.cpp",
        "lib/virtual_traffic_light.cpp",
        "lib/visualization.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
    alwayslink = True,
)

cc_shared_library(
    name = "autoware_lanelet2_extension_lib",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":autoware_lanelet2_extension_lib_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":autoware_lanelet2_extension_lib"],
)

EXECUTABLES = {
    "autoware_lanelet2_extension_sample": "src/sample_code.cpp",
    "autoware_lanelet2_validation": "src/validation.cpp",
    "check_right_of_way": "src/check_right_of_way.cpp",
}

[cc_binary(
    name = name,
    srcs = [src],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = [":autoware_lanelet2_extension_lib_library"],
) for name, src in EXECUTABLES.items()]

# ament_add_ros_isolated_gtest(...) for each test/src/*.cpp
TESTS = {
    "message_conversion-test": "test_message_conversion",
    "projector-test": "test_projector",
    "query-test": "test_query",
    "regulatory_elements-test": "test_regulatory_elements",
    "utilities-test": "test_utilities",
    "route-test": "test_route_checker",
    "normalize-radian": "test_normalize_radian",
}

[cc_test(
    name = name,
    srcs = ["test/src/{0}.cpp".format(src)] + (["lib/normalize_radian.hpp"] if name == "normalize-radian" else []),
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = [
        ":autoware_lanelet2_extension_lib_library",
        "@rosdistro//cc:googletest",
    ],
) for name, src in TESTS.items()]

### PACKAGING

ament_index(
    name = "ament_index",
    libraries = [":autoware_lanelet2_extension_lib"],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    executables = EXECUTABLES.keys(),
    headers = HEADERS,
    libraries = [":autoware_lanelet2_extension_lib"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@autoware_cmake//:ament_package",
        "@autoware_map_msgs//:ament_package",
        "@autoware_planning_msgs//:ament_package",
        "@geometry_msgs//:ament_package",
        "@lanelet2_core//:ament_package",
        "@lanelet2_io//:ament_package",
        "@lanelet2_maps//:ament_package",
        "@lanelet2_projection//:ament_package",
        "@lanelet2_routing//:ament_package",
        "@lanelet2_traffic_rules//:ament_package",
        "@lanelet2_validation//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
