load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_qt//:qt.bzl", "qt_cc_library", "qt_cc_test")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### DATA

DATA = glob([
    "icons/**",
    "images/**",
    "help/**",
]) + ["default.rviz"]

ament_index(
    name = "ament_index",
    data = DATA,
    package_xml = "package.xml",
    deps = ["@rviz_rendering//:ament_index"],
)

### LIBRARIES

HEADERS = glob(
    [
        "include/**/*.hpp",
        "include/**/*.h",
    ],
    allow_empty = True,
)

DEPENDENCIES = {
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@resource_retriever//:resource_retriever": "@resource_retriever//:resource_retriever_library",
    "@rosdistro//cc:OgreMain": "@rosdistro//cc:OgreMain_library",
    "@rosdistro//cc:OgreOverlay": "@rosdistro//cc:OgreOverlay_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rviz_rendering//:rviz_rendering": "@rviz_rendering//:rviz_rendering_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

cmake_configure_file(
    name = "env_config_cpp",
    src = "src/rviz_common/env_config.cpp.in",
    out = "src/rviz_common/env_config.cpp",
    defines = [
        "RVIZ_VERSION=15.2.6",
        "ROS_DISTRO=ROS 2",
        "OGRE_PLUGIN_PATH=rviz_ogre_vendor",
    ],
)

qt_cc_library(
    name = "rviz_common_library",
    srcs = glob(["src/**/*.cpp"]) + [":env_config_cpp"],
    hdrs = HEADERS + glob(["src/**/*.hpp"]),
    includes = [
        "include",
        "src",
        "src/rviz_common",
    ],
    local_defines = ros_local_defines() + ["RVIZ_COMMON_BUILDING_LIBRARY"],
    deps = DEPENDENCIES.values() + [
        "@geometry_msgs//:cc",
        "@rules_qt//:qt_widgets",
        "@sensor_msgs//:cc",
        "@std_msgs//:cc",
        "@std_srvs//:cc",
    ],
)

cc_shared_library(
    name = "rviz_common",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rviz_common_library"],
    deps = [":rviz_common_library"],
)

### TESTS

TEST_DEPENDENCIES = DEPENDENCIES | {
    ":rviz_common": ":rviz_common_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_test",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

# Equivalent of upstream's test_support_objects OBJECT library.
qt_cc_library(
    name = "rviz_common_test_support",
    testonly = True,
    srcs = [
        "test/display_context_fixture.cpp",
        "test/mock_display.cpp",
        "test/mock_property_change_receiver.cpp",
        "test/ogre_testing_environment.cpp",
    ],
    hdrs = [
        "test/mock_display.hpp",
        "test/mock_property_change_receiver.hpp",
    ],
    includes = [
        "include",
        "test",
    ],
    normal_hdrs = [
        "test/display_context_fixture.hpp",
        "test/mock_display_context.hpp",
        "test/mock_frame_transformer.hpp",
        "test/mock_window_manager_interface.hpp",
        "test/ogre_testing_environment.hpp",
    ],
    deps = TEST_DEPENDENCIES.values() + [
        "@rosdistro//cc:googletest",
        "@rules_qt//:qt_widgets",
    ],
)

TEST_DATA = [
    ":ament_index",
    "@rviz_rendering//:ament_index",
]

# Upstream guards these with SKIP_DISPLAY_TESTS (no DISPLAY -> skipped); the
# reference colcon run skipped them, so they are opt-in here as well.
DISPLAY_TEST_TAGS = [
    "manual",
    "no-sandbox",
    "xfail",
]

TEST_LINKOPTS = select({
    "@platforms//os:linux": ["-Wl,--allow-shlib-undefined"],
    "//conditions:default": [],
})

qt_cc_test(
    name = "rviz_common_core_tests",
    srcs = [
        "test/config_test.cpp",
        "test/display_test.cpp",
        "test/mock_display_group.cpp",
        "test/mock_display_group.hpp",
        "test/properties/qos_profile_property_test.cpp",
        "test/property_test.cpp",
        "test/ros_node_abstraction_test.cpp",
        "test/transformation/identity_frame_transformer_test.cpp",
        "test/uniform_string_stream_test.cpp",
        "test/visualizer_app_test.cpp",
    ],
    data = TEST_DATA,
    dynamic_deps = [":transitive_dynamic_deps_test"],
    includes = ["test"],
    linkopts = TEST_LINKOPTS,
    linkstatic = True,
    local_defines = ros_local_defines(),
    tags = DISPLAY_TEST_TAGS,
    deps = TEST_DEPENDENCIES.values() + [
        ":rviz_common_test_support",
        "@rosdistro//cc:googletest",
    ],
)

qt_cc_test(
    name = "rviz_common_interaction_tests",
    srcs = [
        "test/interaction/selection_handler_test.cpp",
        "test/interaction/selection_manager_test.cpp",
    ],
    data = TEST_DATA,
    dynamic_deps = [":transitive_dynamic_deps_test"],
    includes = ["test"],
    linkopts = TEST_LINKOPTS,
    linkstatic = True,
    local_defines = ros_local_defines(),
    tags = DISPLAY_TEST_TAGS,
    deps = TEST_DEPENDENCIES.values() + [
        ":rviz_common_test_support",
        "@rosdistro//cc:googletest",
    ],
)

qt_cc_test(
    name = "display_factory_test",
    srcs = [
        "src/rviz_common/display_factory.cpp",
        "test/display_factory_test.cpp",
    ],
    data = TEST_DATA + glob(["test/resources/**"]),
    dynamic_deps = [":transitive_dynamic_deps_test"],
    includes = ["test"],
    linkopts = TEST_LINKOPTS,
    linkstatic = True,
    local_defines = ros_local_defines() + [
        # Tests run from <runfiles>/_main; the package's own files live next
        # to it under the repository's runfiles directory.
        '_TEST_PLUGIN_DESCRIPTIONS=\\"../rviz_common+\\"',
    ],
    tags = DISPLAY_TEST_TAGS,
    deps = TEST_DEPENDENCIES.values() + [
        ":rviz_common_test_support",
        "@rosdistro//cc:googletest",
    ],
)

cc_library(
    name = "frame_manager_test_lib",
    testonly = True,
    srcs = [
        "src/rviz_common/frame_manager.cpp",
        "test/frame_manager_test.cpp",
        ":moc_src/rviz_common/frame_manager",
    ],
    hdrs = ["src/rviz_common/frame_manager.hpp"],
    includes = [
        "include",
        "src",
        "src/rviz_common",
        "test",
    ],
    local_defines = ros_local_defines(),
    deps = TEST_DEPENDENCIES.values() + [
        ":rviz_common_test_support",
        "@rosdistro//cc:googletest",
    ],
)

qt_cc_test(
    name = "frame_manager_test",
    srcs = [],
    data = TEST_DATA,
    dynamic_deps = [":transitive_dynamic_deps_test"],
    linkopts = TEST_LINKOPTS,
    linkstatic = True,
    local_defines = ros_local_defines(),
    deps = [
        ":frame_manager_test_lib",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = ["rviz_common-extras.cmake"],
    cmake_extras = ["rviz_common-extras.cmake"],
    data = DATA,
    headers = HEADERS,
    libraries = [":rviz_common"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@message_filters//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@resource_retriever//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz_ogre_vendor//:ament_package",
        "@rviz_rendering//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_ros//:ament_package",
        "@urdf//:ament_package",
        "@yaml_cpp_vendor//:ament_package",
    ],
)
