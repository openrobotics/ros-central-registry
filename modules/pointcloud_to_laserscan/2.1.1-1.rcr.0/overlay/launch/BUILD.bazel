load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "sample_laserscan_to_pointcloud_launch.py",
        "sample_pointcloud_to_laserscan_launch.py",
    ],
)

launch_ros_binary(
    name = "sample_laserscan_to_pointcloud_launch",
    src = "sample_laserscan_to_pointcloud_launch.py",
    deps = [
        "//:laserscan_to_pointcloud_node",
        "@tf2_ros//:static_transform_publisher",
    ],
)

launch_ros_binary(
    name = "sample_pointcloud_to_laserscan_launch",
    src = "sample_pointcloud_to_laserscan_launch.py",
    deps = [
        "//:dummy_pointcloud_publisher",
        "//:pointcloud_to_laserscan_node",
        "@tf2_ros//:static_transform_publisher",
    ],
)
