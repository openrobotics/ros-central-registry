load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@laser_geometry//:laser_geometry": "@laser_geometry//:laser_geometry_library",
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
    "@tf2_sensor_msgs//:tf2_sensor_msgs": "@tf2_sensor_msgs//:tf2_sensor_msgs_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@sensor_msgs//:cc",
]

cc_library(
    name = "laserscan_to_pointcloud_library",
    srcs = ["src/laserscan_to_pointcloud_node.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/pointcloud_to_laserscan",
    ],
    local_defines = ros_local_defines() + ["POINTCLOUD_TO_LASERSCAN_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "laserscan_to_pointcloud",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":laserscan_to_pointcloud_library"],
)

cc_library(
    name = "pointcloud_to_laserscan_library",
    srcs = ["src/pointcloud_to_laserscan_node.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/pointcloud_to_laserscan",
    ],
    local_defines = ros_local_defines() + ["POINTCLOUD_TO_LASERSCAN_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "pointcloud_to_laserscan",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":pointcloud_to_laserscan_library"],
)

rclcpp_components_register_node(
    name = "laserscan_to_pointcloud_node",
    component = ":laserscan_to_pointcloud",
    node_name = "laserscan_to_pointcloud_node",
    plugin = "pointcloud_to_laserscan::LaserScanToPointCloudNode",
)

rclcpp_components_register_node(
    name = "pointcloud_to_laserscan_node",
    component = ":laserscan_to_pointcloud",
    node_name = "pointcloud_to_laserscan_node",
    plugin = "pointcloud_to_laserscan::LaserScanToPointCloudNode",
)

rclcpp_components_register_nodes(
    name = "pointcloud_to_laserscan_components",
    component = ":pointcloud_to_laserscan",
    plugins = ["pointcloud_to_laserscan::PointCloudToLaserScanNode"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "dummy_pointcloud_publisher",
    srcs = ["src/dummy_pointcloud_publisher.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/pointcloud_to_laserscan",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

pkg_files(
    name = "pkg_files_inc_0",
    srcs = ["include/pointcloud_to_laserscan/laserscan_to_pointcloud_node.hpp"],
    prefix = "include/pointcloud_to_laserscan/include/pointcloud_to_laserscan",
)

pkg_files(
    name = "pkg_files_inc_1",
    srcs = ["include/pointcloud_to_laserscan/pointcloud_to_laserscan_node.hpp"],
    prefix = "include/pointcloud_to_laserscan/include/pointcloud_to_laserscan",
)

pkg_files(
    name = "pkg_files_inc_2",
    srcs = ["include/pointcloud_to_laserscan/visibility_control.h"],
    prefix = "include/pointcloud_to_laserscan/include/pointcloud_to_laserscan",
)

ament_index(
    name = "ament_index",
    components = [
        ":laserscan_to_pointcloud_node_record",
        ":pointcloud_to_laserscan_node_record",
        ":pointcloud_to_laserscan_components",
    ],
    data = [
        "launch/sample_laserscan_to_pointcloud_launch.py",
        "launch/sample_pointcloud_to_laserscan_launch.py",
    ],
    lib_data = [
        ":dummy_pointcloud_publisher",
        ":laserscan_to_pointcloud_node",
        ":pointcloud_to_laserscan_node",
    ],
    libraries = [
        ":laserscan_to_pointcloud",
        ":pointcloud_to_laserscan",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_flake8//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_pep257//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@laser_geometry//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@message_filters//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_ros//:ament_package",
        "@tf2_sensor_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "laser_geometry",
        "message_filters",
        "rclcpp",
        "rclcpp_components",
        "sensor_msgs",
        "tf2",
        "tf2_ros",
        "tf2_sensor_msgs",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    install = [
        ":pkg_files_inc_0",
        ":pkg_files_inc_1",
        ":pkg_files_inc_2",
    ],
    libraries = [
        ":laserscan_to_pointcloud",
        ":pointcloud_to_laserscan",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_flake8//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_pep257//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@laser_geometry//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@message_filters//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_ros//:ament_package",
        "@tf2_sensor_msgs//:ament_package",
    ],
)
