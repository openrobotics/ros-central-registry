}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "ruckig_library",
    srcs = [
        "src/ruckig/brake.cpp",
        "src/ruckig/position-step1.cpp",
        "src/ruckig/position-step2.cpp",
        "src/ruckig/velocity-step1.cpp",
        "src/ruckig/velocity-step2.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    includes = [
        "include",
        "include/ruckig",
        "third_party",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ruckig",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":ruckig_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ruckig"],
