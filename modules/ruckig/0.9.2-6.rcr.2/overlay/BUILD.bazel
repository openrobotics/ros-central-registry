load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "ruckig_library",
    srcs = [
        "src/ruckig/brake.cpp",
        "src/ruckig/position-step1.cpp",
        "src/ruckig/position-step2.cpp",
        "src/ruckig/velocity-step1.cpp",
        "src/ruckig/velocity-step2.cpp",
    ],
    hdrs = [
        "include/ruckig/block.hpp",
        "include/ruckig/brake.hpp",
        "include/ruckig/calculator.hpp",
        "include/ruckig/calculator_online.hpp",
        "include/ruckig/calculator_target.hpp",
        "include/ruckig/input_parameter.hpp",
        "include/ruckig/output_parameter.hpp",
        "include/ruckig/position.hpp",
        "include/ruckig/profile.hpp",
        "include/ruckig/roots.hpp",
        "include/ruckig/ruckig.hpp",
        "include/ruckig/trajectory.hpp",
        "include/ruckig/utils.hpp",
        "include/ruckig/velocity.hpp",
        "third_party/doctest/doctest.h",
        "third_party/httplib/httplib.h",
        "third_party/json/json.hpp",
    ],
    includes = [
        "include",
        "include/ruckig",
        "third_party",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ruckig",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":ruckig_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ruckig"],
)

ament_index(
    name = "ament_index",
    libraries = [":ruckig"],
    package_xml = "package.xml",
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/ruckig/block.hpp",
        "include/ruckig/brake.hpp",
        "include/ruckig/calculator.hpp",
        "include/ruckig/calculator_online.hpp",
        "include/ruckig/calculator_target.hpp",
        "include/ruckig/input_parameter.hpp",
        "include/ruckig/output_parameter.hpp",
        "include/ruckig/position.hpp",
        "include/ruckig/profile.hpp",
        "include/ruckig/roots.hpp",
        "include/ruckig/ruckig.hpp",
        "include/ruckig/trajectory.hpp",
        "include/ruckig/utils.hpp",
        "include/ruckig/velocity.hpp",
    ],
    include_prefix = "",
    libraries = [":ruckig"],
    package_xml = "package.xml",
    deps = [":ament_index"],
)
