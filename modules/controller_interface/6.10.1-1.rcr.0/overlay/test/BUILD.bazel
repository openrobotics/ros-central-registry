load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

# Tests run with cwd = <runfiles>/_main, but this repository's own test data
# lives under <runfiles>/<canonical repo name>/ when it is an external module.
REPO_RUNFILES_PREFIX = "../%s/" % (repo_name() or "_main")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@hardware_interface//:hardware_interface": "@hardware_interface//:hardware_interface_library",
    "@pal_statistics//:pal_statistics": "@pal_statistics//:pal_statistics_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libcap": "@rosdistro//cc:libcap_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@lifecycle_msgs//:cc",
    "@rosdistro//cc:fmt",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

cc_test(
    name = "test_chainable_controller_interface",
    srcs = ["test_chainable_controller_interface.cpp"] + [
        "test_chainable_controller_interface.hpp",
        "test_controller_interface.hpp",
        "test_controller_tf_prefix.hpp",
        "test_controller_with_options.hpp",
        "test_force_torque_sensor.hpp",
        "test_imu_sensor.hpp",
        "test_led_rgb_device.hpp",
        "test_magnetic_field_sensor.hpp",
        "test_pose_sensor.hpp",
        "test_semantic_component_command_interface.hpp",
        "test_semantic_component_interface.hpp",
    ] + [
        "//:version_h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + ["test_controller_node_options.yaml"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:controller_interface_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

