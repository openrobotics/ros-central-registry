load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines", "ros_version_header")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/controller_interface/chainable_controller_interface.hpp",
        "include/controller_interface/controller_interface.hpp",
        "include/controller_interface/controller_interface_base.hpp",
        "include/controller_interface/controller_interface_params.hpp",
        "include/controller_interface/helpers.hpp",
        "include/controller_interface/test_utils.hpp",
        "include/controller_interface/tf_prefix.hpp",
        "include/semantic_components/force_torque_sensor.hpp",
        "include/semantic_components/gps_sensor.hpp",
        "include/semantic_components/imu_sensor.hpp",
        "include/semantic_components/led_rgb_device.hpp",
        "include/semantic_components/magnetic_field_sensor.hpp",
        "include/semantic_components/pose_sensor.hpp",
        "include/semantic_components/range_sensor.hpp",
        "include/semantic_components/semantic_component_command_interface.hpp",
        "include/semantic_components/semantic_component_interface.hpp",
    ],
    includes = [],
)

DEPENDENCIES = {
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@hardware_interface//:hardware_interface": "@hardware_interface//:hardware_interface_library",
    "@lifecycle_msgs//:cc_shared": "@lifecycle_msgs//:cc",
    "@pal_statistics//:pal_statistics": "@pal_statistics//:pal_statistics_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libcap": "@rosdistro//cc:libcap_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

CC_DEPS = [
    "@rosdistro//cc:fmt",
]

cc_library(
    name = "controller_interface_library",
    srcs = [
        "src/chainable_controller_interface.cpp",
        "src/controller_interface.cpp",
        "src/controller_interface_base.cpp",
    ],
    hdrs = [
        "include/controller_interface/chainable_controller_interface.hpp",
        "include/controller_interface/controller_interface.hpp",
        "include/controller_interface/controller_interface_base.hpp",
        "include/controller_interface/controller_interface_params.hpp",
        "include/controller_interface/helpers.hpp",
        "include/controller_interface/test_utils.hpp",
        "include/controller_interface/tf_prefix.hpp",
        "include/semantic_components/force_torque_sensor.hpp",
        "include/semantic_components/gps_sensor.hpp",
        "include/semantic_components/imu_sensor.hpp",
        "include/semantic_components/led_rgb_device.hpp",
        "include/semantic_components/magnetic_field_sensor.hpp",
        "include/semantic_components/pose_sensor.hpp",
        "include/semantic_components/range_sensor.hpp",
        "include/semantic_components/semantic_component_command_interface.hpp",
        "include/semantic_components/semantic_component_interface.hpp",
    ] + [
        ":version_h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/controller_interface",
        "_gen/include/controller_interface/controller_interface",
        "include",
        "include/controller_interface",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "controller_interface",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":controller_interface_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":controller_interface"],
)

ros_version_header(
    name = "version_h",
    out = "_gen/include/controller_interface/controller_interface/version.h",
)

ament_index(
    name = "ament_index",
    libraries = [":controller_interface"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@geometry_msgs//:ament_package",
        "@hardware_interface//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@pal_statistics//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@realtime_tools//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "fmt",
        "hardware_interface",
        "pal_statistics",
        "rclcpp_lifecycle",
        "realtime_tools",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_controller_interface",
    headers = [
        "include/controller_interface/chainable_controller_interface.hpp",
        "include/controller_interface/controller_interface.hpp",
        "include/controller_interface/controller_interface_base.hpp",
        "include/controller_interface/controller_interface_params.hpp",
        "include/controller_interface/helpers.hpp",
        "include/controller_interface/test_utils.hpp",
        "include/controller_interface/tf_prefix.hpp",
        ":version_h",
        "include/semantic_components/force_torque_sensor.hpp",
        "include/semantic_components/gps_sensor.hpp",
        "include/semantic_components/imu_sensor.hpp",
        "include/semantic_components/led_rgb_device.hpp",
        "include/semantic_components/magnetic_field_sensor.hpp",
        "include/semantic_components/pose_sensor.hpp",
        "include/semantic_components/range_sensor.hpp",
        "include/semantic_components/semantic_component_command_interface.hpp",
        "include/semantic_components/semantic_component_interface.hpp",
    ],
    libraries = [":controller_interface"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@geometry_msgs//:ament_package",
        "@hardware_interface//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@pal_statistics//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@realtime_tools//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
