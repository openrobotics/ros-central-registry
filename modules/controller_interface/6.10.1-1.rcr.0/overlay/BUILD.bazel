write_file(
    name = "gen_extra_7",
    out = "_gen/include/controller_interface/controller_interface/version.h",
    content = ["// Copyright 2015 Open Source Robotics Foundation, Inc.\n//\n// Licensed under the Apache License, Version 2.0 (the \"License\");\n// you may not use this file except in compliance with the License.\n// You may obtain a copy of the License at\n//\n//     http://www.apache.org/licenses/LICENSE-2.0\n//\n// Unless required by applicable law or agreed to in writing, software\n// distributed under the License is distributed on an \"AS IS\" BASIS,\n// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n// See the License for the specific language governing permissions and\n// limitations under the License.\n\n#ifndef CONTROLLER_INTERFACE__VERSION_H_\n#define CONTROLLER_INTERFACE__VERSION_H_\n\n/// \\def CONTROLLER_INTERFACE_VERSION_MAJOR\n/// Defines CONTROLLER_INTERFACE major version number\n#define CONTROLLER_INTERFACE_VERSION_MAJOR (6)\n\n/// \\def CONTROLLER_INTERFACE_VERSION_MINOR\n/// Defines CONTROLLER_INTERFACE minor version number\n#define CONTROLLER_INTERFACE_VERSION_MINOR (10)\n\n/// \\def CONTROLLER_INTERFACE_VERSION_PATCH\n/// Defines CONTROLLER_INTERFACE version patch number\n#define CONTROLLER_INTERFACE_VERSION_PATCH (1)\n\n/// \\def CONTROLLER_INTERFACE_VERSION_STR\n/// Defines CONTROLLER_INTERFACE version string\n#define CONTROLLER_INTERFACE_VERSION_STR \"6.10.1\"\n\n/// \\def CONTROLLER_INTERFACE_VERSION_GTE\n/// Defines a macro to check whether the version of CONTROLLER_INTERFACE is greater than or equal to\n/// the given version triple.\n#define CONTROLLER_INTERFACE_VERSION_GTE(major, minor, patch) ( \\\n     (major < CONTROLLER_INTERFACE_VERSION_MAJOR) ? true \\\n     : ((major > CONTROLLER_INTERFACE_VERSION_MAJOR) ? false \\\n     : ((minor < CONTROLLER_INTERFACE_VERSION_MINOR) ? true \\\n     : ((minor > CONTROLLER_INTERFACE_VERSION_MINOR) ? false \\\n     : ((patch < CONTROLLER_INTERFACE_VERSION_PATCH) ? true \\\n     : ((patch > CONTROLLER_INTERFACE_VERSION_PATCH) ? false \\\n     : true))))))\n\n#endif  // CONTROLLER_INTERFACE__VERSION_H_\n"],
)

write_file(
    name = "gen_atomic_shared_ptr_shim_hpp",
    out = "_gen/include/atomic_shared_ptr_shim.hpp",
    content = ["#if !defined(__cpp_lib_atomic_shared_ptr) && !defined(RCR_ATOMIC_SHARED_PTR_SHIM_HPP_)\n#define RCR_ATOMIC_SHARED_PTR_SHIM_HPP_\n#include <atomic>\n#ifdef __cplusplus\n#include <memory>\n#endif\nnamespace std {\ntemplate <class T>\nstruct atomic<shared_ptr<T>> {\n  shared_ptr<T> ptr_;\n  atomic() noexcept = default;\n  atomic(shared_ptr<T> desired) noexcept : ptr_(std::move(desired)) {}\n  atomic(const atomic&) = delete;\n  void operator=(const atomic&) = delete;\n  void store(shared_ptr<T> desired, memory_order order = memory_order_seq_cst) noexcept {\n    atomic_store_explicit(&ptr_, std::move(desired), order);\n  }\n  shared_ptr<T> load(memory_order order = memory_order_seq_cst) const noexcept {\n    return atomic_load_explicit(&ptr_, order);\n  }\n  operator shared_ptr<T>() const noexcept { return load(); }\n  shared_ptr<T> exchange(shared_ptr<T> desired, memory_order order = memory_order_seq_cst) noexcept {\n    return atomic_exchange_explicit(&ptr_, std::move(desired), order);\n  }\n  void operator=(shared_ptr<T> desired) noexcept { store(std::move(desired)); }\n};\n}  // namespace std\n#endif\n"],
)

