load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/swri_image_util/draw_util.h",
        "include/swri_image_util/geometry_util.h",
        "include/swri_image_util/image_matching.h",
        "include/swri_image_util/image_normalization.h",
        "include/swri_image_util/image_warp_util.h",
        "include/swri_image_util/replace_colors.h",
        "include/swri_image_util/rolling_normalization.h",
    ] + [],
    includes = [],
    deps = ["@rosdistro//cc:opencv_library"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@rcl_interfaces//:cc_shared": "@rcl_interfaces//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:geos": "@rosdistro//cc:geos_library",
    "@rosdistro//cc:geos_c": "@rosdistro//cc:geos_c_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@swri_geometry_util//:swri_geometry_util": "@swri_geometry_util//:swri_geometry_util_library",
    "@swri_math_util//:swri_math_util": "@swri_math_util//:swri_math_util_library",
    "@swri_opencv_util//:swri_opencv_util": "@swri_opencv_util//:swri_opencv_util_library",
    "@swri_opencv_util//:swri_opencv_util_show": "@swri_opencv_util//:swri_opencv_util_show_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "swri_image_util_library",
    srcs = [
        "src/draw_util.cpp",
        "src/geometry_util.cpp",
        "src/image_matching.cpp",
        "src/image_normalization.cpp",
        "src/image_warp_util.cpp",
        "src/replace_colors.cpp",
        "src/rolling_normalization.cpp",
    ],
    hdrs = [
        "include/swri_image_util/draw_util.h",
        "include/swri_image_util/geometry_util.h",
        "include/swri_image_util/image_matching.h",
        "include/swri_image_util/image_normalization.h",
        "include/swri_image_util/image_warp_util.h",
        "include/swri_image_util/replace_colors.h",
        "include/swri_image_util/rolling_normalization.h",
    ] + [],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/swri_image_util",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "swri_image_util",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":swri_image_util_library"],
)

cc_library(
    name = "swri_image_util_display_library",
    srcs = [
        "src/draw_util_display.cpp",
        "src/image_warp_util_display.cpp",
    ],
    hdrs = [
        "include/swri_image_util/draw_util.h",
        "include/swri_image_util/geometry_util.h",
        "include/swri_image_util/image_matching.h",
        "include/swri_image_util/image_normalization.h",
        "include/swri_image_util/image_warp_util.h",
        "include/swri_image_util/replace_colors.h",
        "include/swri_image_util/rolling_normalization.h",
    ] + [],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/swri_image_util",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":swri_image_util_library"],
)

cc_shared_library(
    name = "swri_image_util_display",
    dynamic_deps = DEPENDENCIES.keys() + [":swri_image_util"],
    exports_filter = ["//:__subpackages__"],
    deps = [":swri_image_util_display_library"],
)

cc_library(
    name = "swri_image_util_nodes_library",
    srcs = [
        "src/nodes/blend_images_node.cpp",
        "src/nodes/contrast_stretch_node.cpp",
        "src/nodes/crosshairs_node.cpp",
        "src/nodes/draw_polygon_node.cpp",
        "src/nodes/draw_text_node.cpp",
        "src/nodes/dummy_image_publisher_node.cpp",
        "src/nodes/image_pub_node.cpp",
        "src/nodes/normalization_image_node.cpp",
        "src/nodes/normalize_response_node.cpp",
        "src/nodes/replace_colors_node.cpp",
        "src/nodes/rotate_image_node.cpp",
        "src/nodes/scale_image_node.cpp",
        "src/nodes/warp_image_node.cpp",
    ],
    hdrs = [
        "include/swri_image_util/draw_util.h",
        "include/swri_image_util/geometry_util.h",
        "include/swri_image_util/image_matching.h",
        "include/swri_image_util/image_normalization.h",
        "include/swri_image_util/image_warp_util.h",
        "include/swri_image_util/replace_colors.h",
        "include/swri_image_util/rolling_normalization.h",
    ] + [],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/swri_image_util",
    ],
    local_defines = ros_local_defines() + ["COMPOSITION_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":swri_image_util_library"],
)

cc_shared_library(
    name = "swri_image_util_nodes",
    dynamic_deps = DEPENDENCIES.keys() + [":swri_image_util"],
    exports_filter = ["//:__subpackages__"],
    deps = [":swri_image_util_nodes_library"],
)

rclcpp_components_register_nodes(
    name = "swri_image_util_nodes_components",
    component = ":swri_image_util_nodes",
    plugins = [
        "swri_image_util::BlendImagesNode",
        "swri_image_util::ContrastStretchNode",
        "swri_image_util::CrosshairsNode",
        "swri_image_util::DrawPolygonNode",
        "swri_image_util::DrawTextNode",
        "swri_image_util::DummyImagePublisherNode",
        "swri_image_util::ImagePubNode",
        "swri_image_util::NormalizationImageNode",
        "swri_image_util::NormalizeResponseNode",
        "swri_image_util::ReplaceColorsNode",
        "swri_image_util::RotateImageNode",
        "swri_image_util::ScaleImageNode",
        "swri_image_util::WarpImageNode",
    ],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":swri_image_util_display",
        ":swri_image_util_nodes",
    ] + [":swri_image_util"],
)

ament_index(
    name = "ament_index",
    components = [":swri_image_util_nodes_components"],
    libraries = [
        ":swri_image_util",
        ":swri_image_util_display",
        ":swri_image_util_nodes",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@cv_bridge//:ament_package",
        "@image_transport//:ament_package",
        "@message_filters//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@swri_geometry_util//:ament_package",
        "@swri_math_util//:ament_package",
        "@swri_opencv_util//:ament_package",
        "@tf2//:ament_package",
    ],
)

ament_package(
    cmake = ["cmake/swri_image_util-extras.cmake"],
    cmake_export_dependencies_list = [
        "OpenCV",
        "rclcpp",
        "swri_opencv_util",
        "tf2",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_swri_image_util",
    cmake_extras = ["swri_image_util-extras.cmake"],
    headers = [
        "include/swri_image_util/draw_util.h",
        "include/swri_image_util/geometry_util.h",
        "include/swri_image_util/image_matching.h",
        "include/swri_image_util/image_normalization.h",
        "include/swri_image_util/image_warp_util.h",
        "include/swri_image_util/replace_colors.h",
        "include/swri_image_util/rolling_normalization.h",
    ],
    libraries = [
        ":swri_image_util",
        ":swri_image_util_display",
        ":swri_image_util_nodes",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@cv_bridge//:ament_package",
        "@image_transport//:ament_package",
        "@message_filters//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@swri_geometry_util//:ament_package",
        "@swri_math_util//:ament_package",
        "@swri_opencv_util//:ament_package",
        "@tf2//:ament_package",
    ],
)
