load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

generate_parameter_library(
    name = "stomp_moveit_parameters",
    yaml_file = "res/stomp_moveit.yaml",
)

DEPENDENCIES = {
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rsl//:rsl": "@rsl//:rsl_library",
    "@stomp//:stomp": "@stomp//:stomp_library",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
}

CC_DEPS = [
    ":stomp_moveit_parameters",
    "@generate_parameter_library//:generate_parameter_library",
    "@moveit_core//:moveit_collision_detection_bullet_library",
    "@moveit_core//:moveit_collision_detection_fcl_library",
    "@moveit_core//:moveit_collision_detection_library",
    "@moveit_core//:moveit_collision_distance_field_library",
    "@moveit_core//:moveit_constraint_samplers_library",
    "@moveit_core//:moveit_distance_field_library",
    "@moveit_core//:moveit_dynamics_solver_library",
    "@moveit_core//:moveit_exceptions_library",
    "@moveit_core//:moveit_kinematic_constraints_library",
    "@moveit_core//:moveit_kinematics_base_library",
    "@moveit_core//:moveit_kinematics_metrics_library",
    "@moveit_core//:moveit_planning_interface_library",
    "@moveit_core//:moveit_planning_scene_library",
    "@moveit_core//:moveit_robot_model_library",
    "@moveit_core//:moveit_robot_state_library",
    "@moveit_core//:moveit_robot_trajectory_library",
    "@moveit_core//:moveit_smoothing_base_library",
    "@moveit_core//:moveit_test_utils_library",
    "@moveit_core//:moveit_trajectory_processing_library",
    "@moveit_core//:moveit_transforms_library",
    "@moveit_core//:moveit_utils_library",
    "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
    "@std_msgs//:cc",
    "@visualization_msgs//:cc",
]

cc_library(
    name = "stomp_moveit_plugin_library",
    srcs = [
        "src/stomp_moveit_planner_plugin.cpp",
        "src/stomp_moveit_planning_context.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":stomp_moveit_parameters_gen"],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "_gen/include/moveit_planners_stomp",
        "include",
        "test",
    ],
    local_defines = ros_local_defines() + [
        "NDEBUG",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "stomp_moveit_plugin",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":stomp_moveit_plugin_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    libraries = [
        ":stomp_moveit_plugin",
    ],
    package_xml = "package.xml",
    plugin_category = "moveit_core",
    plugins = ["stomp_moveit_plugin_description.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@moveit_common//:ament_package",
        "@moveit_core//:ament_package",
        "@rsl//:ament_package",
        "@std_msgs//:ament_package",
        "@stomp//:ament_package",
        "@tf2_eigen//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)

cc_test(
    name = "test_cost_functions",
    srcs = ["test/test_cost_functions.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":stomp_moveit_parameters_gen"],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        ":ament_index",
    ] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "_gen/include/moveit_planners_stomp",
        "include",
        "test",
    ],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "NDEBUG",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":stomp_moveit_plugin_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

