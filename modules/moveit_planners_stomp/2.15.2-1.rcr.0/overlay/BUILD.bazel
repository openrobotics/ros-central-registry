ament_package(
    cmake_export_dependencies_list = [
        "fmt",
        "rclcpp",
        "rclcpp_lifecycle",
        "rsl",
        "tcb_span",
        "tl-expected",
        "moveit_core",
        "stomp",
        "generate_parameter_library",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    libraries = [
        ":stomp_moveit_plugin",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@moveit_common//:ament_package",
        "@moveit_core//:ament_package",
        "@rsl//:ament_package",
        "@std_msgs//:ament_package",
        "@stomp//:ament_package",
        "@tf2_eigen//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
