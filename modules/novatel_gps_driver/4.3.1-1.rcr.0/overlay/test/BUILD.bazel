load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libpcap": "@rosdistro//cc:libpcap_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@swri_math_util//:swri_math_util": "@swri_math_util//:swri_math_util_library",
    "@swri_serial_util//:swri_serial_util": "@swri_serial_util//:swri_serial_util_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
}

CC_DEPS = [
    "@diagnostic_msgs//:cc",
    "@gps_msgs//:cc",
    "@nav_msgs//:cc",
    "@novatel_gps_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.accumulators",
    "@rosdistro//cc:boost.algorithm",
    "@rosdistro//cc:boost.asio",
    "@rosdistro//cc:boost.circular_buffer",
    "@rosdistro//cc:boost.lexical_cast",
    "@rosdistro//cc:boost.smart_ptr",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

exports_files([
    "bestpos-bestvel-psrdop2-sync.pcap",
    "corrimudata.pcap",
    "novatel_gps_tests.cpp",
    "parser_tests.cpp",
])

cc_test(
    name = "novatel_gps_tests",
    srcs = ["novatel_gps_tests.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "bestpos-bestvel-psrdop2-sync.pcap",
        "corrimudata.pcap",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["GTEST_HAS_PTHREAD=1"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:novatel_gps_driver_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "parser_tests",
    srcs = ["parser_tests.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "bestpos-bestvel-psrdop2-sync.pcap",
        "corrimudata.pcap",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["GTEST_HAS_PTHREAD=1"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:novatel_gps_driver_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
