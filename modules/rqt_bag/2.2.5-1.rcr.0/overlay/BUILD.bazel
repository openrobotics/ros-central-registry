load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

exports_files(["package.xml"])

### DATA

ament_index(
    name = "ament_index",
    data = ["resource/bag_widget.ui"] + ["plugin.xml"],
    package_xml = "package.xml",
)

### LIBRARIES

py_library(
    name = "rqt_bag",
    srcs = [
        "src/rqt_bag/__init__.py",
        "src/rqt_bag/bag.py",
        "src/rqt_bag/bag_helper.py",
        "src/rqt_bag/bag_timeline.py",
        "src/rqt_bag/bag_widget.py",
        "src/rqt_bag/index_cache_thread.py",
        "src/rqt_bag/message_listener_thread.py",
        "src/rqt_bag/message_loader_thread.py",
        "src/rqt_bag/node_selection.py",
        "src/rqt_bag/player.py",
        "src/rqt_bag/plugins/__init__.py",
        "src/rqt_bag/plugins/message_view.py",
        "src/rqt_bag/plugins/plugin.py",
        "src/rqt_bag/plugins/raw_view.py",
        "src/rqt_bag/plugins/timeline_renderer.py",
        "src/rqt_bag/plugins/topic_message_view.py",
        "src/rqt_bag/qos.py",
        "src/rqt_bag/recorder.py",
        "src/rqt_bag/rosbag2.py",
        "src/rqt_bag/timeline_cache.py",
        "src/rqt_bag/timeline_frame.py",
        "src/rqt_bag/timeline_menu.py",
        "src/rqt_bag/topic_selection.py",
    ],
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@ament_index_python",
        "@builtin_interfaces//:py",
        "@python_qt_binding",
        "@rclpy",
        "@rosbag2_py",
        "@rosidl_runtime_py",
        "@rqt_gui",
        "@rqt_gui_py",
    ],
)

### EXECUTABLES

genrule(
    name = "cli_rename",
    srcs = ["scripts/rqt_bag"],
    outs = ["scripts/rqt_bag.py"],
    cmd = "cp $(location :scripts/rqt_bag) $(location :scripts/rqt_bag.py)",
)

py_binary(
    name = "gui",
    srcs = ["scripts/rqt_bag.py"],
    args = ["--force-discover"],
    main = "scripts/rqt_bag.py",
    deps = [":rqt_bag"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    executables = ["scripts/rqt_bag"],
    package_xml = "package.xml",
    programs = ["scripts/rqt_bag"],
    python = [":rqt_bag"],
    python_strip_prefix = "src",
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@python_qt_binding//:ament_package",
        "@rclpy//:ament_package",
        "@rosbag2_py//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_py//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
    ],
)
