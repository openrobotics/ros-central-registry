load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@plansys2_msgs//:cc_shared": "@plansys2_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

exports_files([
    "CMakeLists.txt",
    "pddl/dom1.pddl",
    "pddl/dom2.pddl",
    "pddl/prob1.pddl",
    "pddl/prob2.pddl",
    "pddl/suave_domain.pddl",
    "pddl/suave_domain_extended_created.pddl",
    "pddl/suave_problem.pddl",
    "pddl/suave_problem_extended_created.pddl",
    "pddl_parser_test.cpp",
])

cc_test(
    name = "pddl_parser_test",
    srcs = ["pddl_parser_test.cpp"],
    data = ["//:ament_index"] + [
        "CMakeLists.txt",
        "pddl/dom1.pddl",
        "pddl/dom2.pddl",
        "pddl/prob1.pddl",
        "pddl/prob2.pddl",
        "pddl/suave_domain.pddl",
        "pddl/suave_domain_extended_created.pddl",
        "pddl/suave_problem.pddl",
        "pddl/suave_problem_extended_created.pddl",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:plansys2_pddl_parser_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
