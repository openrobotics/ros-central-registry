load("@launch_testing_ros//:defs.bzl", "launch_ros_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

launch_ros_test(
    name = "test_fake_imu_launch",
    src = "test_fake_imu_launch.py",
    data = [
        "expected_outputs/enclave_used.regex",
        "expected_outputs/fake_imu.regex",
        "expected_outputs/imu_sink.regex",
        "//:ament_index",
    ],
    deps = [
        "//:fake_imu",
        "//:imu_sink",
        "//launch:fake_imu.launch",
        "@example_interfaces//:py",
        "@nodl_to_policy",
        "@rclpy",
        "@ros2launch_security",
        "@sensor_msgs//:py",
        "@sros2",
    ],
)

