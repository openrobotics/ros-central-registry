load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### DATA

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

### PYTHON MODULE

py_library(
    name = "action_tutorials_py",
    srcs = glob(["action_tutorials_py/**/*.py"]),
    data = [
        ":ament_index",
    ],
    imports = ["."],
    deps = [
        "@rclpy",
    ],
)

### EXECUTABLES

[
    py_binary(
        name = executable,
        srcs = ["action_tutorials_py/{0}.py".format(executable)],
        main = "action_tutorials_py/{0}.py".format(executable),
        deps = [
            ":action_tutorials_py",
        ],
    )
    for executable in [
        "fibonacci_action_server",
        "fibonacci_action_client",
    ]
]

# TESTS

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "fibonacci_action_client": "action_tutorials_py.fibonacci_action_client:main",
        "fibonacci_action_server": "action_tutorials_py.fibonacci_action_server:main",
    },
    package_xml = "package.xml",
    python = [":action_tutorials_py"],
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@example_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
