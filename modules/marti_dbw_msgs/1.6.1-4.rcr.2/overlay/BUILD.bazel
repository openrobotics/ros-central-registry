load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### PACKAGING

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:PrimaryControl",
        "//msg:PrimaryFeedback",
        "//msg:TransmissionFeedback",
    ],
)

rosidl_ament_package(
    name = "ament_package",
    headers = glob(["include/**/*.h"]),
    interface_library = "marti_dbw_msgs_library",
    interface_library_link_libraries = ["marti_dbw_msgs::marti_dbw_msgs__rosidl_typesupport_cpp"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
