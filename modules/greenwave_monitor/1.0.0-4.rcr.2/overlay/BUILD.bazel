load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

exports_files([
    "src/example_greenwave_publisher_node.cpp",
    "src/minimal_publisher_node.cpp",
])

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/example_greenwave_publisher_node.hpp",
        "include/greenwave_diagnostics.hpp",
        "include/greenwave_monitor.hpp",
        "include/minimal_publisher_node.hpp",
    ],
    includes = [
        ".",
        "include",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

CC_DEPS = [
    "@diagnostic_msgs//:cc",
    "@greenwave_monitor_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "example_greenwave_publisher_node",
    srcs = [
        "src/example_greenwave_publisher_main.cpp",
        "src/example_greenwave_publisher_node.cpp",
    ] + [
        "include/example_greenwave_publisher_node.hpp",
        "include/greenwave_diagnostics.hpp",
        "include/greenwave_monitor.hpp",
        "include/minimal_publisher_node.hpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "_bin/greenwave_monitor",
    srcs = [
        "src/greenwave_monitor.cpp",
        "src/greenwave_monitor_main.cpp",
    ] + [
        "include/example_greenwave_publisher_node.hpp",
        "include/greenwave_diagnostics.hpp",
        "include/greenwave_monitor.hpp",
        "include/minimal_publisher_node.hpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "minimal_publisher_node",
    srcs = [
        "src/minimal_publisher_main.cpp",
        "src/minimal_publisher_node.cpp",
    ] + [
        "include/example_greenwave_publisher_node.hpp",
        "include/greenwave_diagnostics.hpp",
        "include/greenwave_monitor.hpp",
        "include/minimal_publisher_node.hpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

py_library(
    name = "greenwave_monitor_py",
    srcs = [
        "greenwave_monitor/__init__.py",
        "greenwave_monitor/ncurses_frontend.py",
        "greenwave_monitor/test_utils.py",
        "greenwave_monitor/ui_adaptor.py",
    ],
    imports = ["."],
    deps = [
        "@ament_flake8",
        "@ament_pep257",
        "@diagnostic_msgs//:py",
        "@greenwave_monitor_interfaces//:py",
        "@launch",
        "@launch//:test_support",
        "@launch_ros",
        "@launch_testing",
        "@launch_testing_ros",
        "@rclpy",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "config/example.yaml",
        "examples/README.md",
        "examples/example.launch.py",
        "//launch:launch_files",
    ],
    lib_data = [
        ":example_greenwave_publisher_node",
        ":_bin/greenwave_monitor",
        ":minimal_publisher_node",
        "scripts/ncurses_dashboard",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ament_pep257//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@greenwave_monitor_interfaces//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    python = [":greenwave_monitor_py"],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ament_pep257//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@greenwave_monitor_interfaces//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
