package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {"@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library"}

CC_DEPS = [
    "@diagnostic_msgs//:cc",
    "@greenwave_monitor_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

cc_test(
    name = "test_example_greenwave_publisher",
    srcs = [
        "test_example_greenwave_publisher.cpp",
        "//:src/example_greenwave_publisher_node.cpp",
    ],
    data = ["//:ament_index"] + [
        "test_copyright.py",
        "test_flake8.py",
        "test_greenwave_monitor.py",
        "test_greenwave_monitor_preset.py",
        "test_ncurses_frontend_argparse.py",
        "test_pep257.py",
        "test_topic_monitoring_integration.py",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

