load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "hz.launch.py",
        "test_publishers.launch.py",
    ],
)

launch_ros_binary(
    name = "hz_launch",
    src = "hz.launch.py",
    data = ["//:ament_index"],
    deps = ["//:greenwave_monitor_py"],
)

launch_ros_binary(
    name = "test_publishers_launch",
    src = "test_publishers.launch.py",
    deps = [
        "//:greenwave_monitor_py",
        "//:minimal_publisher_node",
    ],
)
