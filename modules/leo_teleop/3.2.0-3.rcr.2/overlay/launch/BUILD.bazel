load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "joy_teleop.launch.xml",
        "key_teleop.launch.xml",
    ],
)

launch_ros_binary(
    name = "joy_teleop_launch",
    src = "joy_teleop.launch.xml",
    data = ["//:ament_index"],
    deps = [
        "@joy_linux//:joy_linux_node",
        "@teleop_twist_joy//:teleop_node",
    ],
)

launch_ros_binary(
    name = "key_teleop_launch",
    src = "key_teleop.launch.xml",
    data = ["//:ament_index"],
    deps = ["@teleop_twist_keyboard"],
)
