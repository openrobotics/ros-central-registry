load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = glob(["cmake/**"]) + glob(["*-extras.cmake"]),
    cmake_extras = [
        "ament_cmake_core-extras.cmake",
        "ament_cmake_environment-extras.cmake",
        "ament_cmake_environment_hooks-extras.cmake",
        "ament_cmake_index-extras.cmake",
        "ament_cmake_package_templates-extras.cmake",
        "ament_cmake_symlink_install-extras.cmake",
        "ament_cmake_uninstall_target-extras.cmake",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_package",
        "@rosdistro//:ament_package",
    ],
)
