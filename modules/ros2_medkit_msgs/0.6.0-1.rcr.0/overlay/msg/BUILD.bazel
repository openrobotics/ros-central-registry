load("@rosidl_default_generators//:defs.bzl", "ros_message")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

exports_files([
    "ClusterInfo.msg",
    "EntityInfo.msg",
    "EnvironmentData.msg",
    "ExtendedDataRecords.msg",
    "Fault.msg",
    "FaultEvent.msg",
    "MedkitDiscoveryHint.msg",
    "MutedFaultInfo.msg",
    "Snapshot.msg",
])

ros_message(
    name = "ClusterInfo",
    src = "ClusterInfo.msg",
    deps = [
        "@builtin_interfaces//msg:Time",
    ],
)

ros_message(
    name = "EntityInfo",
    src = "EntityInfo.msg",
)

ros_message(
    name = "EnvironmentData",
    src = "EnvironmentData.msg",
    deps = [
        ":ExtendedDataRecords",
        ":Snapshot",
    ],
)

ros_message(
    name = "ExtendedDataRecords",
    src = "ExtendedDataRecords.msg",
)

ros_message(
    name = "Fault",
    src = "Fault.msg",
    deps = [
        "@builtin_interfaces//msg:Time",
    ],
)

ros_message(
    name = "FaultEvent",
    src = "FaultEvent.msg",
    deps = [
        ":Fault",
        "@builtin_interfaces//msg:Time",
    ],
)

ros_message(
    name = "MedkitDiscoveryHint",
    src = "MedkitDiscoveryHint.msg",
    deps = [
        "@builtin_interfaces//msg:Time",
        "@diagnostic_msgs//msg:KeyValue",
    ],
)

ros_message(
    name = "MutedFaultInfo",
    src = "MutedFaultInfo.msg",
)

ros_message(
    name = "Snapshot",
    src = "Snapshot.msg",
)
