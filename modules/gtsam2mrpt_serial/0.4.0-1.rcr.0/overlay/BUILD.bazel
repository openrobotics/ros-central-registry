load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@gtsam//:cephes-gtsam": "@gtsam//:cephes-gtsam_library",
    "@gtsam//:gtsam": "@gtsam//:gtsam_library",
    "@gtsam//:metis-gtsam": "@gtsam//:metis-gtsam_library",
    "@mrpt_containers//:mrpt_containers": "@mrpt_containers//:mrpt_containers_library",
    "@mrpt_io//:mrpt_io": "@mrpt_io//:mrpt_io_library",
    "@mrpt_math//:mrpt_math": "@mrpt_math//:mrpt_math_library",
    "@mrpt_poses//:mrpt_poses": "@mrpt_poses//:mrpt_poses_library",
    "@mrpt_random//:mrpt_random": "@mrpt_random//:mrpt_random_library",
    "@mrpt_rtti//:mrpt_rtti": "@mrpt_rtti//:mrpt_rtti_library",
    "@mrpt_serialization//:mrpt_serialization": "@mrpt_serialization//:mrpt_serialization_library",
    "@mrpt_system//:mrpt_system": "@mrpt_system//:mrpt_system_library",
    "@rosdistro//cc:boost.filesystem_shared": "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.serialization_shared": "@rosdistro//cc:boost.serialization",
    "@rosdistro//cc:boost.thread_shared": "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:boost.timer_shared": "@rosdistro//cc:boost.timer",
}

CC_DEPS = [
    "@gtsam//:_gen_textual_hdrs",
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.regex",
]

cc_library(
    name = "gtsam2mrpt_serial_library",
    srcs = ["src/serialize.cpp"],
    hdrs = [
        "include/gtsam2mrpt_serial/gtsam_detect_version.h",
        "include/gtsam2mrpt_serial/serialize.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "include/gtsam2mrpt_serial",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "link_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_shared_library(
    name = "gtsam2mrpt_serial",
    dynamic_deps = [":link_dynamic_deps"],
    deps = [":gtsam2mrpt_serial_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":gtsam2mrpt_serial",
        ":link_dynamic_deps",
    ],
)

ament_index(
    name = "ament_index",
    libraries = [":gtsam2mrpt_serial"],
    package_xml = "package.xml",
    sonames = {"gtsam2mrpt_serial": [
        "libgtsam2mrpt_serial.so.0.4",
        "libgtsam2mrpt_serial.so.0.4.0",
    ]},
    deps = [
        "@gtsam//:ament_package",
        "@mola_common//:ament_package",
        "@mrpt_containers//:ament_package",
        "@mrpt_io//:ament_package",
        "@mrpt_math//:ament_package",
        "@mrpt_poses//:ament_package",
        "@mrpt_random//:ament_package",
        "@mrpt_rtti//:ament_package",
        "@mrpt_serialization//:ament_package",
        "@mrpt_system//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/gtsam2mrpt_serial/gtsam_detect_version.h",
        "include/gtsam2mrpt_serial/serialize.h",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [":gtsam2mrpt_serial"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@gtsam//:ament_package",
        "@mola_common//:ament_package",
        "@mrpt_containers//:ament_package",
        "@mrpt_io//:ament_package",
        "@mrpt_math//:ament_package",
        "@mrpt_poses//:ament_package",
        "@mrpt_random//:ament_package",
        "@mrpt_rtti//:ament_package",
        "@mrpt_serialization//:ament_package",
        "@mrpt_system//:ament_package",
    ],
)
