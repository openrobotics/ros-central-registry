load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {}

CC_DEPS = [
    "@gtsam//:_gen_textual_hdrs",
    "@gtsam//:cephes-gtsam_library",
    "@gtsam//:gtsam_library",
    "@gtsam//:metis-gtsam_library",
    "@mrpt_containers//:mrpt_containers_library",
    "@mrpt_io//:mrpt_io_library",
    "@mrpt_math//:mrpt_math_library",
    "@mrpt_poses//:mrpt_poses_library",
    "@mrpt_random//:mrpt_random_library",
    "@mrpt_rtti//:mrpt_rtti_library",
    "@mrpt_serialization//:mrpt_serialization_library",
    "@mrpt_system//:mrpt_system_library",
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:boost.timer",
]

cc_test(
    name = "gtsam2mrpt_serial_tests",
    srcs = [
        "main.cpp",
        "sampleData.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = ["//:ament_index"] + ["CMakeLists.txt"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:gtsam2mrpt_serial_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
