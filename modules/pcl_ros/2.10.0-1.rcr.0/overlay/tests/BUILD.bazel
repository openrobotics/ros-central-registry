load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

TEST_DEPS = [
    "@rules_python//python/runfiles",
    "@sensor_msgs//:py",
]

cc_library(
    name = "dummy_topics_library",
    srcs = ["filters/dummy_topics.cpp"],
    local_defines = ros_local_defines(),
    deps = [
        "//:_test_root_headers",
        "@pcl_conversions//:pcl_conversions_library",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@sensor_msgs//:cc",
    ],
)

cc_shared_library(
    name = "dummy_topics",
    dynamic_deps = [
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
    ],
    exports_filter = [":dummy_topics_library"],
    deps = [":dummy_topics_library"],
)

rclcpp_components_register_node(
    name = "dummy_topics_node",
    component = ":dummy_topics",
    node_name = "dummy_topics",
    plugin = "pcl_ros_tests_filters::DummyTopics",
)

launch_ros_test(
    name = "test_pcl_ros_ExtractIndices",
    src = "filters/test_filter_component.py",
    data = [
        "//:ament_index",
        "//:test_solib_deps",
        "@rclcpp_components//:ament_index",
        "@rclcpp_components//:component_container",
    ],
    env = {
        "DUMMY_PLUGIN": "pcl_ros_tests_filters::DummyTopics",
        "FILTER_PLUGIN": "pcl_ros::ExtractIndices",
    },
    deps = TEST_DEPS + ["@sensor_msgs//:py"],
)

