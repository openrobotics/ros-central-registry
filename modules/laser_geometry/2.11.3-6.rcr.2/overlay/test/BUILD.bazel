load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
}

cc_test(
    name = "projection_test",
    srcs = ["projection_test.cpp"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        "//:laser_geometry_library",
        "@rosdistro//cc:googletest",
    ],
)

py_pytest(
    name = "projection",
    srcs = ["projection_test.py"],
    deps = ["//:laser_geometry_py"],
)
