load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

# Mirrors ament_package(CONFIG_EXTRAS "rti_connext_dds_cmake_module-extras.cmake.in"): configure_file(@ONLY) of the template.
genrule(
    name = "extras_cmake",
    srcs = ["rti_connext_dds_cmake_module-extras.cmake.in"],
    outs = ["rti_connext_dds_cmake_module-extras.cmake"],
    cmd = "sed -e 's|@RTIConnextDDSMicro_FOUND@|FALSE|g' -e 's|@RTIConnextDDS_FOUND@|FALSE|g' -e 's|@RTIMEHOME@||g' -e 's|@RTIME_TARGET_NAME@||g' -e 's|@RTIME_VERSION@||g' -e 's|@RTIME_COMPONENTS@||g' -e 's|@CONNEXTDDS_DIR@||g' -e 's|@CONNEXTDDS_ARCH@||g' -e 's|@CONNEXTDDS_VERSION@||g' -e 's|@CONNEXTDDS_COMPONENTS@||g' -e 's|@PROJECT_NAME@|rti_connext_dds_cmake_module|g' -e 's|@PYTHON_INSTALL_DIR@|lib/python3.14/site-packages|g' $< > $@",
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = ["cmake/rti_build_helper.cmake"] + [":extras_cmake"],
    cmake_extras = ["rti_connext_dds_cmake_module-extras.cmake"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
