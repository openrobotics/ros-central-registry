write_file(
    name = "gen_octomap_h",
    out = "_gen/include/octomap/octomap.h",
    content = ["#pragma once\n#include <cstdint>\n#include <cmath>\n#include <string>\n#include <vector>\n#include <set>\n#include <map>\n#include <istream>\n#include <ostream>\nnamespace octomap {\nusing key_type = uint16_t;\ninline float logodds(double p) { return static_cast<float>(std::log(p / (1.0 - p))); }\ninline double probability(double l) { return 1.0 / (1.0 + std::exp(-l)); }\nstruct point3d {\n  float x_ = 0, y_ = 0, z_ = 0;\n  point3d() = default;\n  point3d(float x, float y, float z) : x_(x), y_(y), z_(z) {}\n  float x() const { return x_; }\n  float y() const { return y_; }\n  float z() const { return z_; }\n  float & x() { return x_; }\n  float & y() { return y_; }\n  float & z() { return z_; }\n  float operator()(int i) const { return i == 0 ? x_ : (i == 1 ? y_ : z_); }\n  float & operator()(int i) { return i == 0 ? x_ : (i == 1 ? y_ : z_); }\n  float norm() const { return std::sqrt(x_*x_ + y_*y_ + z_*z_); }\n  point3d normalized() const { float n = norm(); return n > 0 ? point3d(x_/n, y_/n, z_/n) : *this; }\n  double distance(const point3d & o) const { return (*this - o).norm(); }\n  point3d operator+(const point3d & o) const { return point3d(x_+o.x_, y_+o.y_, z_+o.z_); }\n  point3d operator-(const point3d & o) const { return point3d(x_-o.x_, y_-o.y_, z_-o.z_); }\n  point3d operator*(float s) const { return point3d(x_*s, y_*s, z_*s); }\n  friend std::ostream & operator<<(std::ostream & os, const point3d & p) { return os << \"(\" << p.x_ << \" \" << p.y_ << \" \" << p.z_ << \")\"; }\n};\nusing Pointcloud = std::vector<point3d>;\nstruct OcTreeKey {\n  key_type k[3] = {0, 0, 0};\n  OcTreeKey() = default;\n  OcTreeKey(key_type a, key_type b, key_type c) { k[0] = a; k[1] = b; k[2] = c; }\n  key_type operator[](int i) const { return k[i]; }\n  key_type & operator[](int i) { return k[i]; }\n  bool operator==(const OcTreeKey & o) const { return k[0]==o.k[0] && k[1]==o.k[1] && k[2]==o.k[2]; }\n  bool operator!=(const OcTreeKey & o) const { return !(*this == o); }\n  bool operator<(const OcTreeKey & o) const {\n    if (k[0] != o.k[0]) return k[0] < o.k[0];\n    if (k[1] != o.k[1]) return k[1] < o.k[1];\n    return k[2] < o.k[2];\n  }\n  struct KeyHash { std::size_t operator()(const OcTreeKey & key) const { return key.k[0] ^ (key.k[1] << 5) ^ (key.k[2] << 10); } };\n};\nusing KeySet = std::set<OcTreeKey>;\nusing KeyBoolMap = std::map<OcTreeKey, bool>;\nclass KeyRay {\npublic:\n  using iterator = std::vector<OcTreeKey>::iterator;\n  using const_iterator = std::vector<OcTreeKey>::const_iterator;\n  void reset() { ray_.clear(); }\n  iterator begin() { return ray_.begin(); }\n  iterator end() { return ray_.end(); }\n  const_iterator begin() const { return ray_.begin(); }\n  const_iterator end() const { return ray_.end(); }\n  std::size_t size() const { return ray_.size(); }\nprivate:\n  std::vector<OcTreeKey> ray_;\n};\nclass OcTreeNode {\npublic:\n  float getLogOdds() const { return 0.0f; }\n  void setLogOdds(float) {}\n  double getOccupancy() const { return 0.5; }\n  float getValue() const { return 0.0f; }\n  void setValue(float) {}\n  bool hasChildren() const { return false; }\n};\nclass ColorOcTreeNode : public OcTreeNode {\npublic:\n  struct Color {\n    uint8_t r = 255, g = 255, b = 255;\n    Color() = default;\n    Color(uint8_t r_, uint8_t g_, uint8_t b_) : r(r_), g(g_), b(b_) {}\n  };\n  Color getColor() const { return Color(); }\n  void setColor(Color) {}\n  void setColor(uint8_t, uint8_t, uint8_t) {}\n  bool isColorSet() const { return true; }\n};\nclass AbstractOcTree {\npublic:\n  virtual ~AbstractOcTree() = default;\n  virtual std::string getTreeType() const { return \"OcTree\"; }\n  double getResolution() const { return 0.1; }\n  virtual void setResolution(double) {}\n  virtual std::size_t size() const { return 0; }\n  virtual std::size_t memoryUsage() const { return 0; }\n  virtual void clear() {}\n  virtual void prune() {}\n  virtual void expand() {}\n  bool write(const std::string &) const { return true; }