load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.smart_ptr",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

cc_test(
    name = "filtertests",
    srcs = [
        "test_buffer.cpp",
        "test_combiner_approximate_time.cpp",
        "test_combiner_exact_time.cpp",
        "test_combiner_fifo.cpp",
        "test_combiner_latch.cpp",
        "test_divider.cpp",
        "test_filter_loop.cpp",
        "test_helpers.cpp",
        "test_main.cpp",
        "test_publish_subscribe.cpp",
        "test_selector.cpp",
        "test_sequencer.cpp",
        "test_simple_user_filter.cpp",
        "test_tf_filter.cpp",
        "test_user_filter.cpp",
    ] + ["test.hpp"] + [
        "//:abi_namespace_hpp",
        "//:version_hpp",
    ],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["FKIE_MF_RCLCPP_VERSION=2097155"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:fkie_message_filters_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
