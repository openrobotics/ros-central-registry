load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

py_library(
    name = "roboplan_ros_examples_py",
    srcs = [
        "roboplan_ros_examples/__init__.py",
        "roboplan_ros_examples/utils.py",
    ],
    imports = ["."],
    deps = [
        "@control_msgs//:py",
        "@rclpy",
        "@roboplan//:roboplan_py",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        "@visualization_msgs//:py",
    ],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_python//:ament_package",
        "@control_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@roboplan//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    python = [":roboplan_ros_examples_py"],
    deps = [":ament_index"] + [
        "@ament_cmake_python//:ament_package",
        "@control_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@roboplan//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
