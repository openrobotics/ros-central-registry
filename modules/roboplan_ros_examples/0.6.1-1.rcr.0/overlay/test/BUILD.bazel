load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

py_pytest(
    name = "import_ros_bindings_test",
    srcs = ["import_ros_bindings_test.py"],
    data = ["//:ament_index"],
    # xfail: Python module 'roboplan_ros' is not available in the Bazel build
    tags = [
        "manual",
        "xfail",
    ],
    deps = [
        "//:roboplan_ros_examples_py",
        "@control_msgs//:py",
        "@rclpy",
        "@roboplan//:roboplan_py",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        "@visualization_msgs//:py",
    ],
)
