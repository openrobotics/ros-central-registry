load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = [
    "include/simple_actions/simple_client.hpp",
    "include/simple_actions/simple_server.hpp",
    "include/simple_actions/utilities.hpp",
]

cc_library(
    name = "simple_actions_headers",
    hdrs = HEADERS,
    includes = ["include"],
)

py_library(
    name = "simple_actions",
    srcs = [
        "simple_actions/__init__.py",
        "simple_actions/simple_client.py",
        "simple_actions/simple_server.py",
        "simple_actions/utilities.py",
    ],
    imports = ["."],
    deps = [
        "@action_msgs//:py",
        "@rclpy",
    ],
)

TEST_DYNAMIC_DEPS = [
    "@rclcpp//:rclcpp",
    "@rclcpp_action//:rclcpp_action",
]

collect_transitive_dynamic_deps(
    name = "test_transitive_dynamic_deps",
    dynamic_deps = TEST_DYNAMIC_DEPS,
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    cmake_export_interface = False,
    data = ["resource/simple_actions"],
    headers = HEADERS,
    include_prefix = "",
    package_xml = "package.xml",
    python = [":simple_actions"],
    setup_cfg = "setup.cfg",
    deps = [
        "@action_msgs//:ament_package",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@example_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
