load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

TEST_DEPS = [
    "//:simple_actions_headers",
    "@action_msgs//:cc",
    "@example_interfaces//:cc",
    "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action_library",
    "@rosdistro//cc:bazel_test_helper",
    "@rosdistro//cc:googletest",
]

cc_test(
    name = "simple_actions_smoke_test",
    srcs = ["smoke.cpp"],
    dynamic_deps = ["//:test_transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = TEST_DEPS,
)

cc_test(
    name = "simple_actions_complex_test",
    srcs = ["complex_setup.cpp"],
    dynamic_deps = ["//:test_transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = TEST_DEPS,
)
