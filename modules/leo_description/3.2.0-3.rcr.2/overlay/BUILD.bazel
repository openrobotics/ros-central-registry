load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

ament_index(
    name = "ament_index",
    data = glob([
        "launch/**",
        "models/**",
        "urdf/**",
    ]),
    package_xml = "package.xml",
)

launch_ros_binary(
    name = "state_publisher.launch.xml",
    src = "launch/state_publisher.launch.xml",
    data = [":ament_index"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = glob([
        "launch/**",
        "models/**",
        "urdf/**",
    ]),
    env_hooks = [
        "environment/gz_sim_resource_path.dsv",
        "environment/gz_sim_resource_path.sh",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@xacro//:ament_package",
    ],
)
