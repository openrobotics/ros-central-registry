load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

write_file(
    name = "meta_share_leo_description_environment_gz_sim_resource_path_dsv",
    out = "_meta/share/leo_description/environment/gz_sim_resource_path.dsv",
    content = ["prepend-non-duplicate;GZ_SIM_RESOURCE_PATH;share"],
)

write_file(
    name = "meta_share_leo_description_environment_gz_sim_resource_path_sh",
    out = "_meta/share/leo_description/environment/gz_sim_resource_path.sh",
    content = [],
)

pkg_files(
    name = "meta_files",
    srcs = [
        ":meta_share_leo_description_environment_gz_sim_resource_path_dsv",
        ":meta_share_leo_description_environment_gz_sim_resource_path_sh",
    ],
    strip_prefix = strip_prefix.from_pkg("_meta"),
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = glob([
        "launch/**",
        "models/**",
        "urdf/**",
    ]),
    env_hooks = [
        "environment/gz_sim_resource_path.dsv",
        "environment/gz_sim_resource_path.sh",
    ],
    install = [":meta_files"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@xacro//:ament_package",
    ],
)
