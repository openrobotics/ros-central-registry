load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.smart_ptr",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "feature0d_to_image",
    srcs = [
        "src/feature0d_to_image.cpp",
    ] + [
        "include/posedetection_msgs/feature0d_to_image.h",
        "include/posedetection_msgs/feature0d_view.h",
    ] + [
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "_gen/include/posedetection_msgs",
        "_gen/include/posedetection_msgs/posedetection_msgs",
        "include",
        "include/posedetection_msgs",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":cc",
    ],
)

cc_binary(
    name = "feature0d_view",
    srcs = [
        "src/feature0d_view.cpp",
    ] + [
        "include/posedetection_msgs/feature0d_to_image.h",
        "include/posedetection_msgs/feature0d_view.h",
    ] + [
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "_gen/include/posedetection_msgs",
        "_gen/include/posedetection_msgs/posedetection_msgs",
        "include",
        "include/posedetection_msgs",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":cc",
    ],
)

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:Curve1D",
        "//msg:Feature0D",
        "//msg:Feature1D",
        "//msg:ImageFeature0D",
        "//msg:ImageFeature1D",
