load("@rosidl_default_generators//:defs.bzl", "ros_message")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

exports_files(glob(["*.msg"]))

ros_message(
    name = "Curve1D",
    src = "Curve1D.msg",
)

ros_message(
    name = "Feature0D",
    src = "Feature0D.msg",
    deps = [
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "Feature1D",
    src = "Feature1D.msg",
    deps = [
        ":Curve1D",
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "ImageFeature0D",
    src = "ImageFeature0D.msg",
    deps = [
        ":Feature0D",
        "@sensor_msgs//msg:CameraInfo",
        "@sensor_msgs//msg:Image",
    ],
)

ros_message(
    name = "ImageFeature1D",
    src = "ImageFeature1D.msg",
    deps = [
        ":Feature1D",
        "@sensor_msgs//msg:CameraInfo",
        "@sensor_msgs//msg:Image",
    ],
)

ros_message(
    name = "Object6DPose",
    src = "Object6DPose.msg",
    deps = [
        "@geometry_msgs//msg:Pose",
    ],
)

ros_message(
    name = "ObjectDetection",
    src = "ObjectDetection.msg",
    deps = [
        ":Object6DPose",
        "@std_msgs//msg:Header",
    ],
)
