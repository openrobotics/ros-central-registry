load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

py_library(
    name = "turtlebot3_autorace_mission",
    srcs = [
        "turtlebot3_autorace_mission/__init__.py",
        "turtlebot3_autorace_mission/avoid_construction.py",
        "turtlebot3_autorace_mission/control_lane.py",
        "turtlebot3_autorace_mission/mission_tunnel.py",
    ],
    imports = ["."],
    deps = [
        "@rclpy",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        requirement("numpy"),
        requirement("opencv-python"),
    ],
)

[
    py_binary(
        name = script,
        srcs = ["turtlebot3_autorace_mission/{}.py".format(script)],
        data = [":ament_index"],
        main = "turtlebot3_autorace_mission/{}.py".format(script),
        deps = [":turtlebot3_autorace_mission"],
    )
    for script in [
        "avoid_construction",
        "control_lane",
        "mission_tunnel",
    ]
]

ament_index(
    name = "ament_index",
    data = [
        "map/map.pgm",
        "map/map.yaml",
        "param/navigation.yaml",
        "//launch:launch_files",
    ],
    package_xml = "package.xml",
    deps = [
        "@rclpy//:ament_index",
        "@sensor_msgs//:ament_index",
        "@std_msgs//:ament_index",
        "@turtlebot3_autorace_detect//:ament_index",
    ],
)

ament_package(
    name = "ament_package",
    console_scripts = {
        "avoid_construction": "turtlebot3_autorace_mission.avoid_construction:main",
        "control_lane": "turtlebot3_autorace_mission.control_lane:main",
        "mission_tunnel": "turtlebot3_autorace_mission.mission_tunnel:main",
    },
    package_xml = "package.xml",
    python = [":turtlebot3_autorace_mission"],
    deps = [":ament_index"] + [
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
