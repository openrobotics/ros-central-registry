load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "turtlebot3_autorace_mission",
    srcs = glob(["turtlebot3_autorace_mission/**/*.py"]),
    imports = ["."],
    deps = [
        "@rclpy",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        requirement("numpy"),
        requirement("opencv-python"),
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "launch/control_lane.launch.py",
        "launch/mission_construction.launch.py",
        "launch/mission_tunnel.launch.py",
        "map/map.pgm",
        "map/map.yaml",
        "param/navigation.yaml",
    ],
    package_xml = "package.xml",
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [":ament_index"],
        deps = [":turtlebot3_autorace_mission"],
    )
    for f in glob(["launch/**"])
]

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "avoid_construction": "turtlebot3_autorace_mission.avoid_construction:main",
        "control_lane": "turtlebot3_autorace_mission.control_lane:main",
        "mission_tunnel": "turtlebot3_autorace_mission.mission_tunnel:main",
    },
    data = [
        "launch/control_lane.launch.py",
        "launch/mission_construction.launch.py",
        "launch/mission_tunnel.launch.py",
        "map/map.pgm",
        "map/map.yaml",
        "param/navigation.yaml",
    ],
    package_xml = "package.xml",
    python = [":turtlebot3_autorace_mission"],
    deps = [
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
