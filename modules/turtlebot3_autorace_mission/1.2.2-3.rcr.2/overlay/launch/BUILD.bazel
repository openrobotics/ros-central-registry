load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "control_lane.launch.py",
        "mission_construction.launch.py",
        "mission_tunnel.launch.py",
    ],
)

launch_ros_binary(
    name = "control_lane_launch",
    src = "control_lane.launch.py",
    data = ["//:ament_index"],
    deps = ["//:turtlebot3_autorace_mission"],
)

launch_ros_binary(
    name = "mission_construction_launch",
    src = "mission_construction.launch.py",
    data = [
        "//:ament_index",
        "@turtlebot3_autorace_detect//:ament_index",
    ],
    deps = [
        "//:turtlebot3_autorace_mission",
        "@ament_index_python",
        "@turtlebot3_autorace_detect",
    ],
)

launch_ros_binary(
    name = "mission_tunnel_launch",
    src = "mission_tunnel.launch.py",
    data = ["//:ament_index"],
    deps = [
        "//:turtlebot3_autorace_mission",
        "@ament_index_python",
    ],
)
