load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

HEADERS = [
    "include/tracetools_image_pipeline/config.h",
    "include/tracetools_image_pipeline/tp_call.h",
    "include/tracetools_image_pipeline/tracetools.h",
    "include/tracetools_image_pipeline/utils.hpp",
    "include/tracetools_image_pipeline/visibility_control.hpp",
]

cc_library(
    name = "tracetools_image_pipeline_library",
    srcs = [
        "src/tracetools.c",
        "src/utils.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
)

cc_shared_library(
    name = "tracetools_image_pipeline",
    exports_filter = ["//:__subpackages__"],
    deps = [":tracetools_image_pipeline_library"],
)

### TRANSITIVE DYNAMIC DEPS

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":tracetools_image_pipeline",
    ],
    visibility = ["//visibility:private"],
)

### EXECUTABLES

cc_binary(
    name = "status",
    srcs = [
        "src/status.c",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":tracetools_image_pipeline_library",
    ],
)

### TESTS

write_file(
    name = "test_status_tool_sh",
    out = "test_status_tool.sh",
    content = [
        "#!/usr/bin/env bash",
        "set -e",
        "if \"$1\"; then exit 1; else exit 0; fi",
        "",
    ],
    is_executable = True,
)

sh_test(
    name = "test_status_tool",
    srcs = [":test_status_tool_sh"],
    args = ["$(location :status)"],
    data = [":status"],
)

### PACKAGING

write_file(
    name = "link_flags_extras",
    out = "cmake/ament_cmake_export_link_flags-extras.cmake",
    content = [
        "# generated from ament_cmake_export_link_flags/cmake/ament_cmake_export_link_flags-extras.cmake.in",
        "",
        "set(_exported_link_flags \"-rdynamic\")",
        "",
        "# append link_flags to tracetools_image_pipeline_LINK_FLAGS",
        "if(NOT \"${_exported_link_flags} \" STREQUAL \" \")",
        "  foreach(_link_flag ${_exported_link_flags})",
        "    list(APPEND tracetools_image_pipeline_LINK_FLAGS \"${_link_flag}\")",
        "  endforeach()",
        "endif()",
        "",
    ],
)

ament_package(
    name = "ament_package",
    cmake = [":link_flags_extras"],
    cmake_export_name = "tracetools_image_pipeline_export",
    cmake_extras = ["ament_cmake_export_link_flags-extras.cmake"],
    executables = [
        ":status",
    ],
    headers = HEADERS,
    include_prefix = "",
    libraries = [
        ":tracetools_image_pipeline",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
