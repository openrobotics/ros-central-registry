load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@mrpt_graphs//:mrpt_graphs_library",
    "@mrpt_libros_bridge//:mrpt_libros_bridge_library",
    "@mrpt_msgs//:cc",
    "@mrpt_obs//:mrpt_obs_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "mrpt_msgs_bridge_library",
    srcs = [
        "src/beacon.cpp",
        "src/landmark.cpp",
        "src/network_of_poses.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/mrpt_msgs_bridge",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_msgs_bridge",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mrpt_msgs_bridge_library"],
)

pkg_files(
    name = "pkg_files_shlib_0_mrpt_msgs_bridge",
    srcs = [":mrpt_msgs_bridge"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "lib/mrpt_msgs_bridge",
)

ament_index(
    name = "ament_index",
    libraries = [":mrpt_msgs_bridge"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mrpt_graphs//:ament_package",
        "@mrpt_libros_bridge//:ament_package",
        "@mrpt_msgs//:ament_package",
        "@mrpt_obs//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_environment//:ament_package",
        "@tf2//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    install = [":pkg_files_shlib_0_mrpt_msgs_bridge"],
    libraries = [":mrpt_msgs_bridge"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mrpt_graphs//:ament_package",
        "@mrpt_libros_bridge//:ament_package",
        "@mrpt_msgs//:ament_package",
        "@mrpt_obs//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_environment//:ament_package",
        "@tf2//:ament_package",
    ],
)
