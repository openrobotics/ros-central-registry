load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "game_controller_spl/__init__.py",
        "game_controller_spl/game_controller_spl.py",
        "game_controller_spl/rcgcd_14/conversion.py",
        "game_controller_spl/rcgcd_14/robocup_game_control_data.py",
        "game_controller_spl/rcgcd_15/conversion.py",
        "game_controller_spl/rcgcd_15/robocup_game_control_data.py",
        "game_controller_spl/rcgcd_16/conversion.py",
        "game_controller_spl/rcgcd_16/robocup_game_control_data.py",
        "game_controller_spl/rcgcrd_4/conversion.py",
        "game_controller_spl/rcgcrd_4/robocup_game_control_return_data.py",
        "package.xml",
        "resource/game_controller_spl",
        "setup.cfg",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
]]

py_library(
    name = "game_controller_spl",
    srcs = [
        "game_controller_spl/__init__.py",
        "game_controller_spl/game_controller_spl.py",
        "game_controller_spl/rcgcd_14/conversion.py",
        "game_controller_spl/rcgcd_14/robocup_game_control_data.py",
        "game_controller_spl/rcgcd_15/conversion.py",
        "game_controller_spl/rcgcd_15/robocup_game_control_data.py",
        "game_controller_spl/rcgcd_16/conversion.py",
        "game_controller_spl/rcgcd_16/robocup_game_control_data.py",
        "game_controller_spl/rcgcrd_4/conversion.py",
        "game_controller_spl/rcgcrd_4/robocup_game_control_return_data.py",
    ],
    imports = ["."],
    deps = [
        "@game_controller_spl_interfaces//:py",
        "@rclpy",
    ],
)

ament_package(
    name = "ament_package",
    console_scripts = {"game_controller_spl": "game_controller_spl.game_controller_spl:main"},
    executables = ["resource/game_controller_spl"],
    package_xml = "package.xml",
    python = [":game_controller_spl"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@game_controller_spl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
