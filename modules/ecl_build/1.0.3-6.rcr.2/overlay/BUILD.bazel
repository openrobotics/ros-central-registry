load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

pkg_files(
    name = "install_share_cmake",
    srcs = glob(["cmake/**"]),
    prefix = "share",
    strip_prefix = strip_prefix.from_pkg(""),
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    cmake = glob(["cmake/*.cmake"]),
    cmake_extras = [
        "ecl_platform_detection.cmake",
        "ecl_package.cmake",
        "ecl_find_sse.cmake",
        "ecl_build_utilities.cmake",
        "ecl_cxx.cmake",
        "cotire.cmake",
    ],
    install = [
        ":install_share_cmake",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ecl_license//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
