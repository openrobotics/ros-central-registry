load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

py_library(
    name = "easynav_tools",
    srcs = glob(["easynav_tools/**/*.py"]),
    data = glob(
        ["easynav_tools/vendor/**"],
        exclude = ["**/*.py"],
    ),
    imports = ["."],
    deps = [
        requirement("pydantic"),
        requirement("typing_extensions"),
        "@easynav_interfaces//:py",
        "@easynav_support_py",
        "@geometry_msgs//:py",
        "@rclpy",
        "@ros2cli",
        "@rosidl_runtime_py",
    ],
)

py_pytest(
    name = "test_goalmanager_client_unit",
    srcs = ["test/test_goalmanager_client_unit.py"],
    deps = [":easynav_tools"],
)

py_pytest(
    name = "test_ros_controllers",
    srcs = ["test/test_ros_controllers.py"],
    deps = [":easynav_tools"],
)

ament_package(
    name = "ament_package",
    build_type = "ament_python",
    console_scripts = {
        "tui": "easynav_tools.tui.app:run_app",
    },
    data = ["README.md"],
    package_xml = "package.xml",
    python = [":easynav_tools"],
    deps = [
        "@ament_cmake_pytest//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@easynav_interfaces//:ament_package",
        "@easynav_support_py//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@ros2cli//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_py//:ament_package",
    ],
)
