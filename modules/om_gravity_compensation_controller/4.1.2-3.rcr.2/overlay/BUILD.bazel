load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

# generate_parameter_library(gravity_compensation_controller_parameters ...)
generate_parameter_library(
    name = "gravity_compensation_controller_parameters",
    yaml_file = "src/gravity_compensation_controller_parameters.yaml",
)

DEPENDENCIES = {
    "@controller_interface//:controller_interface": "@controller_interface//:controller_interface_library",
    "@generate_parameter_library//:rsl": "@generate_parameter_library//:rsl_library",
    "@hardware_interface//:hardware_interface": "@hardware_interface//:hardware_interface_library",
    "@hardware_interface//:mock_components": "@hardware_interface//:mock_components_library",
    "@kdl_parser//:kdl_parser": "@kdl_parser//:kdl_parser_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@urdf//:urdf": "@urdf//:urdf_library",
}

HEADERS = [
    "include/gravity_compensation_controller/gravity_compensation_controller.hpp",
    "include/gravity_compensation_controller/visibility_control.h",
]

cc_library(
    name = "gravity_compensation_controller_library",
    srcs = ["src/gravity_compensation_controller.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + [
        "gravity_compensation_controller_BUILDING_DLL",
        "_USE_MATH_DEFINES",
    ],
    deps = DEPENDENCIES.values() + [":gravity_compensation_controller_parameters"],
    alwayslink = True,
)

cc_shared_library(
    name = "gravity_compensation_controller",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":gravity_compensation_controller_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":gravity_compensation_controller"],
)

### PACKAGING

ament_index(
    name = "ament_index",
    libraries = [":gravity_compensation_controller"],
    package_xml = "package.xml",
    plugin_category = "controller_interface",
    plugins = ["gravity_compensation_plugin.xml"],
)

ament_package(
    name = "ament_package",
    cmake_export_name = "export_gravity_compensation_controller",
    headers = HEADERS,
    libraries = [":gravity_compensation_controller"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@angles//:ament_package",
        "@backward_ros//:ament_package",
        "@control_msgs//:ament_package",
        "@control_toolbox//:ament_package",
        "@controller_interface//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@hardware_interface//:ament_package",
        "@kdl_parser//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@realtime_tools//:ament_package",
        "@rsl//:ament_package",
        "@urdf//:ament_package",
    ],
)
