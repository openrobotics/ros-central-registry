load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            "CHANGELOG.rst",
            "README.md",
            "launch/robot_launch.py",
            "package.xml",
            "resource/mavic_webots.urdf",
            "resource/webots_ros2_mavic",
            "setup.cfg",
            "setup.py",
            "test/test_copyright.py",
            "webots_ros2_mavic/__init__.py",
            "webots_ros2_mavic/mavic_driver.py",
            "worlds/.mavic_world.wbproj",
            "worlds/mavic_world.wbt",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@webots_ros2_driver//:ament_package",
    ],
)
