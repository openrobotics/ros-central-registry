load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files", "register_ament_resource")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

register_ament_resource(
    name = "rviz_ogre_media_exports_resource",
    package_name = "rviz_rendering_tests",
    category = "rviz_ogre_media_exports",
    content = "rviz_rendering_tests/ogre_media_resources/scripts\nrviz_rendering_tests/ogre_media_resources/meshes\n",
)

register_ament_files(
    name = "test_meshes",
    package_name = "rviz_rendering_tests",
    files = [
        "ogre_media_resources/test_meshes/16bit_vs_32bit_should_fail.stl",
        "ogre_media_resources/test_meshes/F10.stl",
        "ogre_media_resources/test_meshes/F2.stl",
        "ogre_media_resources/test_meshes/F3.stl",
        "ogre_media_resources/test_meshes/F4.stl",
        "ogre_media_resources/test_meshes/README",
        "ogre_media_resources/test_meshes/ax12_box.stl",
        "ogre_media_resources/test_meshes/base_color.png",
        "ogre_media_resources/test_meshes/base_normals.png",
        "ogre_media_resources/test_meshes/colored_box.glb",
        "ogre_media_resources/test_meshes/finger.stl",
        "ogre_media_resources/test_meshes/invalid.stl",
        "ogre_media_resources/test_meshes/invalid_ascii.stl",
        "ogre_media_resources/test_meshes/invalid_extra.stl",
        "ogre_media_resources/test_meshes/invalid_short.stl",
        "ogre_media_resources/test_meshes/pr2-base.dae",
        "ogre_media_resources/test_meshes/pr2-base_large.dae",
        "ogre_media_resources/test_meshes/solidworks.stl",
        "ogre_media_resources/test_meshes/test.urdf",
        "ogre_media_resources/test_meshes/valid.stl",
    ],
    strip_prefix = "ogre_media_resources",
)

ament_index(
    name = "ament_index",
    data = [
        "ogre_media_resources/meshes/test",
        "ogre_media_resources/scripts/test",
    ],
    package_xml = "package.xml",
    deps = [
        ":rviz_ogre_media_exports_resource",
        ":test_meshes",
        "@rviz_rendering//:ament_index",
    ],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        "@resource_retriever//:resource_retriever",
        "@rosdistro//cc:OgreMain",
        "@rviz_rendering//:rviz_rendering",
    ],
)

pkg_files(
    name = "install_rviz_ogre_media_exports",
    srcs = [":rviz_ogre_media_exports_resource"],
    prefix = "share/ament_index/resource_index/rviz_ogre_media_exports",
    renames = {":rviz_ogre_media_exports_resource": "rviz_rendering_tests"},
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    install = [":install_rviz_ogre_media_exports"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@resource_retriever//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz_rendering//:ament_package",
    ],
)
