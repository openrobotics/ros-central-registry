cc_library(
    name = "easynav_serest_controller_library",
    srcs = ["src/easynav_serest_controller/SerestController.cpp"],
    hdrs = ["include/easynav_serest_controller/SerestController.hpp"],
    includes = [
        "include",
        "include/easynav_serest_controller",
    ],
    local_defines = ros_local_defines() + [
        "EASYNAV_DEBUG_WITH_YAETS",
        "GLAD_API_CALL_EXPORT",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "easynav_serest_controller",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":easynav_serest_controller_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":easynav_serest_controller"],
