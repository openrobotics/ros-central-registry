load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

# The mock robot and tutorial tree executables the launch files start.
_EXECUTABLES = [
    "//:lib/mock-battery",
    "//:lib/mock-dashboard",
    "//:lib/mock-dock-client",
    "//:lib/mock-docking-controller",
    "//:lib/mock-led-strip",
    "//:lib/mock-move-base",
    "//:lib/mock-move-base-client",
    "//:lib/mock-rotate-client",
    "//:lib/mock-rotation-controller",
    "//:lib/mock-safety-sensors",
    "//:lib/tree-action-clients",
    "//:lib/tree-battery-check",
    "//:lib/tree-context-switching",
    "//:lib/tree-data-gathering",
    "//:lib/tree-docking-cancelling-failing",
    "//:lib/tree-dynamic-application-loading",
]

filegroup(
    name = "launch_files",
    srcs = [
        "mock_robot_launch.py",
        "tutorial_eight_dynamic_application_loading_launch.py",
        "tutorial_five_action_clients_launch.py",
        "tutorial_four_introspect_the_tree_launch.py",
        "tutorial_one_data_gathering_launch.py",
        "tutorial_seven_docking_cancelling_failing_launch.py",
        "tutorial_six_context_switching_launch.py",
        "tutorial_three_introspect_the_blackboard_launch.py",
        "tutorial_two_battery_check_launch.py",
    ],
)

launch_ros_binary(
    name = "mock_robot_launch",
    src = "mock_robot_launch.py",
    data = ["//:ament_index"],
    deps = ["//:py_trees_ros_tutorials"] + _EXECUTABLES,
)

launch_ros_binary(
    name = "tutorial_eight_dynamic_application_loading_launch",
    src = "tutorial_eight_dynamic_application_loading_launch.py",
