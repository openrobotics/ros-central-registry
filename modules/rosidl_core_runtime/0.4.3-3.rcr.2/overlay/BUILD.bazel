load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### ALIASES

alias(
    name = "c",
    actual = "@rosidl_runtime_c",
)

alias(
    name = "cc",
    actual = "@rosidl_runtime_cpp",
)

alias(
    name = "py",
    actual = "@rosidl_generator_py",
)

# Mirrors ament_package(CONFIG_EXTRAS "rosidl_core_runtime-extras.cmake.in"): configure_file(@ONLY) of the template.
genrule(
    name = "extras_cmake",
    srcs = ["rosidl_core_runtime-extras.cmake.in"],
    outs = ["rosidl_core_runtime-extras.cmake"],
    cmd = "sed -e 's|@PROJECT_NAME@|rosidl_core_runtime|g' -e 's|@PYTHON_INSTALL_DIR@|lib/python3.14/site-packages|g' $< > $@",
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = [":extras_cmake"],
    cmake_export_dependencies = False,
    cmake_extras = ["rosidl_core_runtime-extras.cmake"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_buffer_py//:ament_package",
        "@rosidl_generator_py//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
        "@rosidl_typesupport_c//:ament_package",
        "@rosidl_typesupport_cpp//:ament_package",
        "@rosidl_typesupport_fastrtps_c//:ament_package",
        "@rosidl_typesupport_fastrtps_cpp//:ament_package",
        "@rosidl_typesupport_introspection_c//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
    ],
)
