load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rosidlcpp_parser//:rosidlcpp_parser": "@rosidlcpp_parser//:rosidlcpp_parser_library",
}

CC_DEPS = [
    "@rosdistro//cc:fmt",
    "@rosdistro//cc:nlohmann_json",
]

cc_library(
    name = "rosidlcpp_generator_core_library",
    srcs = [
        "src/rosidlcpp_generator_core/generator_base.cpp",
        "src/rosidlcpp_generator_core/generator_utils.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++23"],
    includes = [
        "include",
        "include/rosidlcpp_generator_core",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rosidlcpp_generator_core",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":rosidlcpp_generator_core_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":rosidlcpp_generator_core"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosidlcpp_parser//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "ament_cmake",
        "nlohmann_json",
        "fmt",
        "rosidlcpp_parser",
    ],
    cmake_export_name = "export_rosidlcpp_generator_core",
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [":rosidlcpp_generator_core"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosidlcpp_parser//:ament_package",
    ],
)
