load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rosdistro//cc:boringssl": "@rosdistro//cc:boringssl_crypto_library",
    "@rosdistro//cc:protobuf": "@rosdistro//cc:protobuf_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
}

CC_DEPS = [
    "@rosdistro//cc:boost.asio",
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.lexical_cast",
    "@rosdistro//cc:boost.smart_ptr",
    "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:boost.utility",
    "@rosdistro//cc:boringssl_ssl_library",
]

cc_library(
    name = "protobuf_comm_library",
    srcs = [
        "client.cpp",
        "crypto.cpp",
        "message_register.cpp",
        "peer.cpp",
        "server.cpp",
    ],
    hdrs = [
        "include/protobuf_comm/client.h",
        "include/protobuf_comm/crypto.h",
        "include/protobuf_comm/frame_header.h",
        "include/protobuf_comm/message_register.h",
        "include/protobuf_comm/peer.h",
        "include/protobuf_comm/queue_entry.h",
        "include/protobuf_comm/server.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/protobuf_comm",
    ],
    local_defines = ros_local_defines() + ["HAVE_LIBCRYPTO"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "protobuf_comm",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":protobuf_comm_library"],
)

register_ament_files(
    name = "ament_files_0",
    files = [
        "cmake/ProtobufCommConfig.cmake",
    ],
    prefix = "lib/cmake/ProtobufComm",
    strip_prefix = "*",
)

ament_index(
    name = "ament_index",
    data = [
        ":ament_files_0",
    ],
    libraries = [
        ":protobuf_comm",
    ],
    package_xml = "package.xml",
    sonames = {
        "protobuf_comm": ["libprotobuf_comm.so.0"],
    },
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/protobuf_comm/client.h",
        "include/protobuf_comm/crypto.h",
        "include/protobuf_comm/frame_header.h",
        "include/protobuf_comm/message_register.h",
        "include/protobuf_comm/peer.h",
        "include/protobuf_comm/queue_entry.h",
        "include/protobuf_comm/server.h",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":protobuf_comm",
    ],
    package_xml = "package.xml",
    sonames = {
        "protobuf_comm": ["libprotobuf_comm.so.0"],
    },
    deps = [":ament_index"],
)
