load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

cc_test(
    name = "test_python_allocator",
    srcs = [
        "test_python_allocator.cpp",
        "//:src/rclpy/python_allocator.hpp",
    ],
    deps = [
        "//:_test_root_headers",
        "@rosdistro//cc:googletest",
        "@rosdistro//cc:pybind11",
        "@rules_python//python/cc:current_py_cc_headers",
        "@rules_python//python/cc:current_py_cc_libs",
    ],
)

[py_pytest(
    name = test.removesuffix(".py"),
    srcs = ["{}.py".format(test)],
    args = [
        "-p",
        "sitecustomize",
    ] if test.startswith("test_async_") else [],
    data = [
        "resources/test_node/complicated_wildcards.yaml",
        "resources/test_node/params_by_order.yaml",
        "resources/test_node/test_parameters.yaml",
        "resources/test_node/wildcards.yaml",
    ],
    tags = [
        "manual",
        "xfail",
    ] if test == "test_executor" else [],
    deps = [
        "//:rclpy",
        "@rules_python//python/runfiles",
        "@test_msgs//:py",
        "@test_msgs//:test_msgs_py",
    ],
) for test in [
    "test_action_client",
    "test_action_graph",
    "test_action_server",
    "test_async_client",
    "test_async_clock",
    "test_async_node",
    "test_async_publisher",
    "test_async_service",
    "test_async_subscription",
    "test_async_timer",
    "test_callback_group",
    "test_client",
    "test_clock",
    "test_context",
    "test_create_node",
    "test_create_while_spinning",
    "test_destruction",
    "test_events_executor",
    "test_executor",
    "test_expand_topic_name",
    "test_guard_condition",
    "test_init_shutdown",
    "test_lifecycle",
    "test_logging",
    "test_logging_rosout",
    "test_logging_service",
    "test_messages",
    "test_node",
    "test_parameter_client",
    "test_parameter_event_handler",
    "test_parameter",
    "test_parameter_service",
    "test_publisher",
    "test_qos_event",
    "test_qos_overriding_options",
    "test_qos",
    "test_rate",
    "test_rosout_subscription",
    "test_serialization",
    "test_service_introspection",
    "test_service",
    "test_subscription",
    "test_task",
    "test_time",
    "test_timer",
    "test_time_source",
    "test_topic_endpoint_info",
    "test_topic_or_service_is_hidden",
    "test_type_description_service",
    "test_type_hash",
    "test_type_support",
    "test_utilities",
    "test_validate_full_topic_name",
    "test_validate_namespace",
    "test_validate_node_name",
    "test_validate_topic_name",
    "test_waitable",
    "test_wait_for_message",
]]
