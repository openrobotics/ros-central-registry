### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_has_library_target = True,
    package_xml = "package.xml",
    # ament_python_install_package(rclpy) plus the pybind11 extension module,
    # which upstream installs next to the python sources (rclpy/_rclpy_pybind11.so)
    # rather than as an exported library in lib/.
    python = glob(["rclpy/**"]) + [":rclpy_bindings"],
    deps = [
        "@action_msgs//:ament_package",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@rcl//:ament_package",
        "@rcl_action//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rcl_lifecycle//:ament_package",
        "@rcl_logging_interface//:ament_package",
        "@rcl_yaml_param_parser//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rmw_implementation//:ament_package",
        "@rmw_implementation_cmake//:ament_package",
        "@rosdistro//:ament_package",
        "@rosgraph_msgs//:ament_package",
        "@rosidl_generator_py//:ament_package",
        "@rosidl_pycommon//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rpyutils//:ament_package",
        "@service_msgs//:ament_package",
        "@test_msgs//:ament_package",
        "@type_description_interfaces//:ament_package",
        "@unique_identifier_msgs//:ament_package",
    ],
)
