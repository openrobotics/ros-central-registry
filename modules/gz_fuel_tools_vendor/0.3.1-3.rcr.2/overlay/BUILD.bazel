# gz_fuel_tools_vendor: vendors gz-fuel-tools (version 11) from the Bazel
# Central Registry module `gz-fuel-tools` (shared library wrappers live in
# @rosdistro//cc/gz) and installs it like colcon's ament_vendor() does
# (opt/gz_fuel_tools_vendor/...).

load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc/gz:defs.bzl", "gz_install_files", "gz_install_headers", "gz_vendor_hooks")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES (gz-fuel_tools::core)

alias(
    name = "gz_fuel_tools",
    actual = "@rosdistro//cc/gz:gz-fuel-tools",
)

alias(
    name = "gz_fuel_tools_library",
    actual = "@rosdistro//cc/gz:gz-fuel-tools_library",
)

### INSTALL LAYOUT (opt/gz_fuel_tools_vendor/...)

VENDOR = "gz_fuel_tools_vendor"

PREFIX = "opt/" + VENDOR

gz_install_headers(
    name = "install_headers",
    include_only = "gz/",
    prefix = PREFIX + "/include/gz/fuel_tools11",
    deps = [":gz_fuel_tools_library"],
)

gz_install_files(
    name = "install_libraries",
    srcs = [":gz_fuel_tools"],
    flatten = True,
    prefix = PREFIX + "/lib",
)

ENV_HOOKS = gz_vendor_hooks(
    name = "install_hooks",
    pythonpath = False,
    vendor = VENDOR,
)

### PACKAGING

ament_package(
    name = "ament_package",
    env_hooks = ENV_HOOKS,
    install = [
        ":install_headers",
        ":install_hooks",
        ":install_libraries",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_test//:ament_package",
        "@ament_cmake_vendor_package//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@gz_cmake_vendor//:ament_package",
        "@gz_common_vendor//:ament_package",
        "@gz_math_vendor//:ament_package",
        "@gz_msgs_vendor//:ament_package",
        "@gz_tools_vendor//:ament_package",
        "@gz_utils_vendor//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
