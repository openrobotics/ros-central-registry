load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@point_cloud_transport//:point_cloud_transport": "@point_cloud_transport//:point_cloud_transport_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:zstd": "@rosdistro//cc:zstd_library",
}

CC_DEPS = [
    "@point_cloud_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
]

cc_library(
    name = "zstd_point_cloud_transport_library",
    srcs = [
        "src/manifest.cpp",
        "src/zstd_publisher.cpp",
        "src/zstd_subscriber.cpp",
    ],
    hdrs = [
        "include/zstd_point_cloud_transport/zstd_publisher.hpp",
        "include/zstd_point_cloud_transport/zstd_subscriber.hpp",
    ],
    includes = [
        "include",
        "include/zstd_point_cloud_transport",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "zstd_point_cloud_transport",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":zstd_point_cloud_transport_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":zstd_point_cloud_transport"],
    package_xml = "package.xml",
    plugin_category = "point_cloud_transport",
    plugins = ["zstd_plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@pluginlib//:ament_package",
        "@point_cloud_interfaces//:ament_package",
        "@point_cloud_transport//:ament_package",
        "@rclcpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@zstd_cmake_module//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "pluginlib",
        "point_cloud_interfaces",
        "point_cloud_transport",
        "rclcpp",
        "zstd_cmake_module",
        "zstd",
    ],
    cmake_export_targets = False,
    headers = [
        "include/zstd_point_cloud_transport/zstd_publisher.hpp",
        "include/zstd_point_cloud_transport/zstd_subscriber.hpp",
    ],
    include_prefix = "",
    libraries = [":zstd_point_cloud_transport"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@pluginlib//:ament_package",
        "@point_cloud_interfaces//:ament_package",
        "@point_cloud_transport//:ament_package",
        "@rclcpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@zstd_cmake_module//:ament_package",
    ],
)
