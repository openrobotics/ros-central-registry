load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "launch/demo.launch.py",
        "launch/moveit.rviz",
    ] + glob(["config/**"]),
    package_xml = "package.xml",
)

launch_ros_binary(
    name = "demo.launch.py",
    src = "launch/demo.launch.py",
    data = [":ament_index"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = [
        "launch/demo.launch.py",
        "launch/moveit.rviz",
    ] + glob(["config/**"]),
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@joint_state_publisher//:ament_package",
        "@moveit_resources_prbt_ikfast_manipulator_plugin//:ament_package",
        "@moveit_resources_prbt_support//:ament_package",
        "@moveit_ros_move_group//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
        "@xacro//:ament_package",
    ],
)
