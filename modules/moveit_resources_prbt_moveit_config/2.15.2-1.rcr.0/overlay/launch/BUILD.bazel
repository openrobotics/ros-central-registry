load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "demo.launch.py",
        "moveit.rviz",
    ],
)

launch_ros_binary(
    name = "demo_launch",
    src = "demo.launch.py",
    data = [
        "//:ament_index",
        "@controller_manager//:ament_index",
        "@controller_manager//:ros2_control_node",
        "@moveit_resources_prbt_support//:ament_package",
        "@moveit_ros_move_group//:ament_index",
        "@moveit_ros_move_group//:move_group",
        "@robot_state_publisher",
        "@robot_state_publisher//:ament_index",
        "@rviz2",
        "@rviz2//:ament_index",
        "@tf2_ros//:ament_index",
        "@tf2_ros//:static_transform_publisher",
    ],
    deps = [
        "@ament_index_python",
        "@xacro//:xacro_lib",
        requirement("pyyaml"),
    ],
)
