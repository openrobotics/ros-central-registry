load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

HEADERS = glob(["include/**/*.hpp"])

cc_library(
    name = "opennav_docking_core",
    hdrs = HEADERS,
    includes = ["include"],
    deps = [
        "@geometry_msgs//:cc",
        "@nav2_ros_common",
        "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
        "@tf2_ros//:tf2_ros_library",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "geometry_msgs",
        "rclcpp_lifecycle",
        "nav2_ros_common",
        "tf2_ros",
    ],
    headers = HEADERS,
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@backward_ros//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav2_common//:ament_package",
        "@nav2_ros_common//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rosdistro//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
