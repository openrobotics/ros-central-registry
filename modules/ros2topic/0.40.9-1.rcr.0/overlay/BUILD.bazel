load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

write_file(
    name = "pkg_info",
    out = "ros2topic-0.40.9.egg-info/PKG-INFO",
    content = [
        "Metadata-Version: 2.1",
        "Name: ros2topic",
        "Version: 0.40.9",
    ],
)

write_file(
    name = "entry_points_txt",
    out = "ros2topic-0.40.9.egg-info/entry_points.txt",
    content = [
        "[ros2cli.command]",
        "topic = ros2topic.command.topic:TopicCommand",
        "",
        "[ros2cli.extension_point]",
        "ros2topic.verb = ros2topic.verb:VerbExtension",
        "",
        "[ros2topic.verb]",
        "bw = ros2topic.verb.bw:BwVerb",
        "delay = ros2topic.verb.delay:DelayVerb",
        "echo = ros2topic.verb.echo:EchoVerb",
        "find = ros2topic.verb.find:FindVerb",
        "hz = ros2topic.verb.hz:HzVerb",
        "info = ros2topic.verb.info:InfoVerb",
        "list = ros2topic.verb.list:ListVerb",
        "pub = ros2topic.verb.pub:PubVerb",
        "type = ros2topic.verb.type:TypeVerb",
    ],
)

py_library(
    name = "ros2topic",
    srcs = [
        "ros2topic/__init__.py",
        "ros2topic/api/__init__.py",
        "ros2topic/command/__init__.py",
        "ros2topic/command/topic.py",
        "ros2topic/verb/__init__.py",
        "ros2topic/verb/bw.py",
        "ros2topic/verb/delay.py",
        "ros2topic/verb/echo.py",
        "ros2topic/verb/find.py",
        "ros2topic/verb/hz.py",
        "ros2topic/verb/info.py",
        "ros2topic/verb/list.py",
        "ros2topic/verb/pub.py",
        "ros2topic/verb/type.py",
    ],
    data = ["ros2topic/py.typed"] + [
        ":ament_index",
        ":entry_points_txt",
        ":pkg_info",
    ],
    imports = ["."],
    deps = [
        "@rclpy",
        "@ros2cli",
        "@rosidl_runtime_py",
    ],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "package.xml",
        "resource/ros2topic",
        "ros2topic/__init__.py",
        "ros2topic/api/__init__.py",
        "ros2topic/command/__init__.py",
        "ros2topic/command/topic.py",
        "ros2topic/py.typed",
        "ros2topic/verb/__init__.py",
        "ros2topic/verb/bw.py",
        "ros2topic/verb/delay.py",
        "ros2topic/verb/echo.py",
        "ros2topic/verb/find.py",
        "ros2topic/verb/hz.py",
        "ros2topic/verb/info.py",
        "ros2topic/verb/list.py",
        "ros2topic/verb/pub.py",
        "ros2topic/verb/type.py",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
    "xmllint",
]]

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":ros2topic"] + ["ros2topic/py.typed"],
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclpy//:ament_package",
        "@ros2cli//:ament_package",
        "@rosdistro//:ament_package",
        "@rosgraph_msgs//:ament_package",
        "@rosidl_runtime_py//:ament_package",
        "@std_msgs//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
