load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:boringssl": "@rosdistro//cc:boringssl_crypto_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
}

CC_DEPS = [
    "@moveit_setup_framework//:moveit_setup_framework_library",
    "@moveit_setup_srdf_plugins//:moveit_setup_srdf_plugins_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:boost.program_options",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:boringssl_ssl_library",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
    "@rules_qt//:qt_core",
    "@rules_qt//:qt_gui",
    "@rules_qt//:qt_svg",
    "@rules_qt//:qt_widgets",
]

cc_library(
    name = "moveit_setup_assistant_library",
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/moveit_setup_assistant",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "collisions_updater",
    srcs = [":gen_moveit_setup_assistant_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/moveit_setup_assistant",
    ],
    local_defines = ros_local_defines() + [
        "NDEBUG",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "moveit_setup_assistant",
    srcs = [":gen_moveit_setup_assistant_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/moveit_setup_assistant",
    ],
    local_defines = ros_local_defines() + [
        "NDEBUG",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

write_file(
    name = "gen_moveit_setup_assistant_stub_cpp",
    out = "_gen/moveit_setup_assistant_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    data = [
        "launch/setup_assistant.launch.py",
        "resources/MoveIt_Setup_Assistant2.png",
    ],
    lib_data = [
        ":collisions_updater",
        ":moveit_setup_assistant",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@moveit_configs_utils//:ament_package",
        "@moveit_resources_panda_moveit_config//:ament_package",
        "@moveit_setup_app_plugins//:ament_package",
        "@moveit_setup_controllers//:ament_package",
        "@moveit_setup_core_plugins//:ament_package",
        "@moveit_setup_framework//:ament_package",
        "@moveit_setup_srdf_plugins//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
    ],
)

launch_ros_binary(
    name = "setup_assistant.launch.py",
    src = "launch/setup_assistant.launch.py",
    data = [":ament_index"],
)

ament_package(
    cmake_export_dependencies_list = [
        "ament_index_cpp",
        "moveit_setup_framework",
        "moveit_setup_srdf_plugins",
        "pluginlib",
        "Qt6Core",
        "Qt6Widgets",
        "rclcpp",
    ],
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@moveit_configs_utils//:ament_package",
        "@moveit_resources_panda_moveit_config//:ament_package",
        "@moveit_setup_app_plugins//:ament_package",
        "@moveit_setup_controllers//:ament_package",
        "@moveit_setup_core_plugins//:ament_package",
        "@moveit_setup_framework//:ament_package",
        "@moveit_setup_srdf_plugins//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
    ],
)
