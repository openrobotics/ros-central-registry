cc_test(
    name = "test_action_client_state_cpp",
    srcs = ["test_action_client_state.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "test_action_client_state.py",
        "test_complex_scenarios.py",
        "test_monitor_state.py",
        "test_publisher_state.py",
        "test_ros_deserialize_state.py",
        "test_ros_serialize_state.py",
        "test_service_client_state.py",
        "test_tf_buffer_state.py",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:yasmin_ros_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

