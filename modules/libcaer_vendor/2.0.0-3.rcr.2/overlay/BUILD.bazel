r settings for Bosch IMU.\n */\nenum caer_imu_bosch_gyro_filter {\n\tBOSCH_GYRO_OSR4   = 0,\n\tBOSCH_GYRO_OSR2   = 1,\n\tBOSCH_GYRO_NORMAL = 2,\n};\n\n#endif // LIBCAER_DEVICES_IMU_SUPPORT_H_\n"],
