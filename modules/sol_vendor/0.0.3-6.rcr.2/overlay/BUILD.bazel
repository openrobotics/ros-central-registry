tstate& operator=(const state&) = delete;\n\t\tstate& operator=(state&& that) {\n\t\t\tstate_view::operator=(std::move(that));\n\t\t\tunique_base::operator=(std::move(that));\n\t\t\treturn *this;\n\t\t}\n\n\t\tusing state_view::get;\n\n\t\t~state() {\n\t\t}\n\t};\n} // namespace sol\n\n#endif // SOL_STATE_HPP\n"],
