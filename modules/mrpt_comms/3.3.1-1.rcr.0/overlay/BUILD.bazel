    content = ["#----------------------------------------------------------------\n# Generated CMake target import file.\n#----------------------------------------------------------------\n\n# Commands may need to know the format version.\nset(CMAKE_IMPORT_FILE_VERSION 1)\n\n# Import target \"mrpt::mrpt_comms\" for configuration \"\"\nset_property(TARGET mrpt::mrpt_comms APPEND PROPERTY IMPORTED_CONFIGURATIONS NOCONFIG)\nset_target_properties(mrpt::mrpt_comms PROPERTIES\n  IMPORTED_LOCATION_NOCONFIG \"${_IMPORT_PREFIX}/lib/libmrpt_comms.so.3.3.1\"\n  IMPORTED_SONAME_NOCONFIG \"libmrpt_comms.so.3.3\"\n  )\n\nlist(APPEND _cmake_import_check_targets mrpt::mrpt_comms )\nlist(APPEND _cmake_import_check_files_for_mrpt::mrpt_comms \"${_IMPORT_PREFIX}/lib/libmrpt_comms.so.3.3.1\" )\n\n# Commands beyond this point should not need to know the version.\nset(CMAKE_IMPORT_FILE_VERSION)\n"],
