    name = "config_h",
    src = "config.h.in",
    out = "_gen/include/mrpt/opengl/config.h",
    defines = [
        "CMAKE_MRPT_HAS_OPENGL=1",
        "CMAKE_MRPT_HAS_EGL=1",
        "CMAKE_MRPT_HAS_GLES=1",
