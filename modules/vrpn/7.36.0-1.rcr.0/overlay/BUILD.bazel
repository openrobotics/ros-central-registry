cc_library(
    name = "quat_library",
    srcs = [":gen_vrpn_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_gl_h",
        ":gen_glfw3_h",
        ":gen_glu_h",
        ":gen_libusb_1_0_libusb_h",
        ":gen_libusb_h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        ".",
        "_gen/include",
        "atmellib",
        "quat",
        "submodules/hidapi/hidapi",
        "submodules/jsoncpp/include",
    ],
    local_defines = ros_local_defines() + ["NDEBUG"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

genrule(
    name = "static_quat_a",
    srcs = [":quat_library"],
    outs = ["libquat.a"],
    cmd = "for f in $(SRCS); do case $$f in *.a) cp $$f $@; exit 0;; esac; done; ar rcs $@",
)

