load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@lifecycle_msgs//:cc_shared": "@lifecycle_msgs//:cc",
    "@plansys2_core//:plansys2_core": "@plansys2_core//:plansys2_core_library",
    "@plansys2_domain_expert//:plansys2_domain_expert": "@plansys2_domain_expert//:plansys2_domain_expert_library",
    "@plansys2_msgs//:cc_shared": "@plansys2_msgs//:cc",
    "@plansys2_pddl_parser//:plansys2_pddl_parser": "@plansys2_pddl_parser//:plansys2_pddl_parser_library",
    "@plansys2_popf_plan_solver//:plansys2_popf_plan_solver": "@plansys2_popf_plan_solver//:plansys2_popf_plan_solver_library",
    "@plansys2_problem_expert//:plansys2_problem_expert": "@plansys2_problem_expert//:plansys2_problem_expert_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

exports_files([
    "CMakeLists.txt",
    "pddl/domain_simple.pddl",
    "pddl/domain_simple_constants.pddl",
    "pddl/problem_simple_1.pddl",
    "pddl/problem_simple_2.pddl",
    "pddl/problem_simple_3.pddl",
    "pddl/problem_simple_constants_1.pddl",
    "pddl/problem_simple_constants_2.pddl",
    "unit/CMakeLists.txt",
    "unit/planner_test.cpp",
])

cc_test(
    name = "planner_test",
    srcs = ["unit/planner_test.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = ["//:ament_index"] + [
        "CMakeLists.txt",
        "pddl/domain_simple.pddl",
        "pddl/domain_simple_constants.pddl",
        "pddl/problem_simple_1.pddl",
        "pddl/problem_simple_2.pddl",
        "pddl/problem_simple_3.pddl",
        "pddl/problem_simple_constants_1.pddl",
        "pddl/problem_simple_constants_2.pddl",
        "unit/CMakeLists.txt",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["unit"],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    # Shells out to the `ros2` CLI (via std::system), which is not on PATH\nin the hermetic Bazel test environment.
    tags = ["manual"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:plansys2_planner_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
