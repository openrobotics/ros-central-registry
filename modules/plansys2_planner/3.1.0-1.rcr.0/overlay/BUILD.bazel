load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@plansys2_core//:plansys2_core": "@plansys2_core//:plansys2_core_library",
    "@plansys2_domain_expert//:plansys2_domain_expert": "@plansys2_domain_expert//:plansys2_domain_expert_library",
    "@plansys2_pddl_parser//:plansys2_pddl_parser": "@plansys2_pddl_parser//:plansys2_pddl_parser_library",
    "@plansys2_popf_plan_solver//:plansys2_popf_plan_solver": "@plansys2_popf_plan_solver//:plansys2_popf_plan_solver_library",
    "@plansys2_problem_expert//:plansys2_problem_expert": "@plansys2_problem_expert//:plansys2_problem_expert_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@lifecycle_msgs//:cc",
    "@plansys2_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "plansys2_planner_library",
    srcs = [
        "src/plansys2_planner/PlannerClient.cpp",
        "src/plansys2_planner/PlannerNode.cpp",
    ],
    hdrs = [
        "include/plansys2_planner/PlannerClient.hpp",
        "include/plansys2_planner/PlannerInterface.hpp",
        "include/plansys2_planner/PlannerNode.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/plansys2_planner",
        "test/unit",
    ],
    local_defines = ros_local_defines() + [
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "plansys2_planner",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":plansys2_planner_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":plansys2_planner"],
)

cc_binary(
    name = "planner_node",
    srcs = ["src/planner_node.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/plansys2_planner",
        "test/unit",
    ],
    local_defines = ros_local_defines() + [
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":plansys2_planner_library"],
)

ament_index(
    name = "ament_index",
    data = [
        "//launch:launch_files",
        "//test:pddl/domain_simple.pddl",
        "//test:pddl/domain_simple_constants.pddl",
        "//test:pddl/problem_simple_1.pddl",
        "//test:pddl/problem_simple_2.pddl",
        "//test:pddl/problem_simple_3.pddl",
        "//test:pddl/problem_simple_constants_1.pddl",
        "//test:pddl/problem_simple_constants_2.pddl",
    ],
    data_strip_prefix = "test",
    lib_data = [":planner_node"],
    libraries = [":plansys2_planner"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@plansys2_core//:ament_package",
        "@plansys2_domain_expert//:ament_package",
        "@plansys2_msgs//:ament_package",
        "@plansys2_pddl_parser//:ament_package",
        "@plansys2_popf_plan_solver//:ament_package",
        "@plansys2_problem_expert//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2run//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "ament_index_cpp",
        "lifecycle_msgs",
        "plansys2_core",
        "plansys2_domain_expert",
        "plansys2_msgs",
        "plansys2_pddl_parser",
        "plansys2_popf_plan_solver",
        "plansys2_problem_expert",
        "pluginlib",
        "rclcpp",
        "rclcpp_lifecycle",
    ],
    cmake_export_name = "export_plansys2_planner",
    headers = [
        "include/plansys2_planner/PlannerClient.hpp",
        "include/plansys2_planner/PlannerInterface.hpp",
        "include/plansys2_planner/PlannerNode.hpp",
    ],
    include_prefix = "",
    libraries = [":plansys2_planner"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@plansys2_core//:ament_package",
        "@plansys2_domain_expert//:ament_package",
        "@plansys2_msgs//:ament_package",
        "@plansys2_pddl_parser//:ament_package",
        "@plansys2_popf_plan_solver//:ament_package",
        "@plansys2_problem_expert//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2run//:ament_package",
    ],
)
