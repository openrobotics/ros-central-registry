load("@ament_cmake_gen_version_h//:defs.bzl", "generate_version_h")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

exports_files(["default_plugins.xml"])

generate_version_h(
    name = "version_h",
    out = "include/image_transport/version.h",
)

HEADERS = [
    "include/image_transport/camera_common.hpp",
    "include/image_transport/camera_publisher.hpp",
    "include/image_transport/camera_subscriber.hpp",
    "include/image_transport/exception.hpp",
    "include/image_transport/image_transport.hpp",
    "include/image_transport/loader_fwds.hpp",
    "include/image_transport/node_interfaces.hpp",
    "include/image_transport/publisher.hpp",
    "include/image_transport/publisher_plugin.hpp",
    "include/image_transport/raw_publisher.hpp",
    "include/image_transport/raw_subscriber.hpp",
    "include/image_transport/republish.hpp",
    "include/image_transport/simple_publisher_plugin.hpp",
    "include/image_transport/simple_subscriber_plugin.hpp",
    "include/image_transport/single_subscriber_publisher.hpp",
    "include/image_transport/subscriber.hpp",
    "include/image_transport/subscriber_filter.hpp",
    "include/image_transport/subscriber_plugin.hpp",
    "include/image_transport/transport_hints.hpp",
    "include/image_transport/visibility_control.hpp",
] + [":version_h"]

DEPENDENCIES = {
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
}

cc_library(
    name = "image_transport_library",
    srcs = [
        "src/camera_common.cpp",
        "src/camera_publisher.cpp",
        "src/camera_subscriber.cpp",
        "src/image_transport.cpp",
        "src/publisher.cpp",
        "src/publisher_plugin.cpp",
        "src/single_subscriber_publisher.cpp",
        "src/subscriber.cpp",
        "src/subscriber_plugin.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["IMAGE_TRANSPORT_BUILDING_DLL"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "image_transport",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":image_transport_library"],
)

cc_library(
    name = "image_transport_plugins_library",
    srcs = ["src/manifest.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values() + [
        ":image_transport_library",
    ],
)

cc_shared_library(
    name = "image_transport_plugins",
    dynamic_deps = DEPENDENCIES.keys() + [":image_transport"],
    exports_filter = ["//:__subpackages__"],
    deps = [":image_transport_plugins_library"],
)

cc_library(
    name = "republish_node_library",
    srcs = ["src/republish.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["IMAGE_TRANSPORT_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + [
        ":image_transport_library",
    ],
)

cc_shared_library(
    name = "republish_node",
    dynamic_deps = DEPENDENCIES.keys() + [":image_transport"],
    exports_filter = ["//:__subpackages__"],
    deps = [":republish_node_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":image_transport",
        "@sensor_msgs//:cc_shared",
    ],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_lifecycle",
    dynamic_deps = [
        ":image_transport",
        "@rclcpp_lifecycle//:rclcpp_lifecycle",
        "@sensor_msgs//:cc_shared",
    ],
)

cc_binary(
    name = "list_transports",
    srcs = ["src/list_transports.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        ":image_transport_library",
    ],
)

rclcpp_components_register_node(
    name = "republish",
    component = ":republish_node",
    node_name = "republish",
    plugin = "image_transport::Republisher",
)

ament_index(
    name = "ament_index_package",
    package_xml = "package.xml",
)

ament_index(
    name = "ament_index_plugin",
    export_name = "image_transport",
    libraries = [":image_transport_plugins"],
    package_xml = "package.xml",
    plugins = ["default_plugins.xml"],
)

ament_package(
    name = "ament_package",
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_image_transport",
    components = [":republish_record"],
    executables = [
        ":list_transports",
        ":republish",
    ],
    headers = HEADERS,
    libraries = [
        ":image_transport",
        ":image_transport_plugins",
        ":republish_node",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index_package",
        ":ament_index_plugin",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@message_filters//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
