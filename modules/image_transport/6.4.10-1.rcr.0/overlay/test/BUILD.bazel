load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
}

[cc_test(
    name = "test_image_transport-{0}".format(test),
    srcs = [
        "test_{0}.cpp".format(test),
        "utils.hpp",
    ],
    data = [
        "//:ament_index_package",
        "//:ament_index_plugin",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        "//:image_transport_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
) for test in [
    "message_passing",
    "publisher",
    "qos_override",
    "remapping",
    "single_subscriber_publisher",
    "subscriber",
]]

[cc_test(
    name = "test_image_transport-{0}_lifecycle".format(test),
    srcs = [
        "test_{0}_lifecycle.cpp".format(test),
        "utils.hpp",
    ],
    data = [
        "//:ament_index_package",
        "//:ament_index_plugin",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps_lifecycle"],
    deps = DEPENDENCIES.values() + [
        "//:image_transport_library",
        "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
) for test in [
    "message_passing",
    "publisher",
    "qos_override",
    "remapping",
    "single_subscriber_publisher",
    "subscriber",
]]

cc_test(
    name = "test_image_transport-camera_common",
    srcs = [
        "test_camera_common.cpp",
        "utils.hpp",
    ],
    data = [
        "test_plugin_manifest.xml",
        "//:ament_index_package",
        "//:ament_index_plugin",
        "//:default_plugins.xml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = [
        'DEFAULT_PLUGINS_XML=\\"../image_transport+/default_plugins.xml\\"',
        'TEST_PLUGIN_MANIFEST_XML=\\"../image_transport+/test/test_plugin_manifest.xml\\"',
    ],
    deps = DEPENDENCIES.values() + [
        "//:image_transport_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
