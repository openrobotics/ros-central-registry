load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "flexbe_input/__init__.py",
        "flexbe_input/bin/flexbe_input",
        "flexbe_input/complex_action_server.py",
        "flexbe_input/flexbe_input.py",
        "flexbe_input/input_action_server.py",
        "flexbe_input/input_gui.py",
        "package.xml",
        "resource/flexbe_input",
        "setup.cfg",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in ["flake8"]]

py_library(
    name = "flexbe_input",
    srcs = [
        "flexbe_input/__init__.py",
        "flexbe_input/complex_action_server.py",
        "flexbe_input/flexbe_input.py",
        "flexbe_input/input_action_server.py",
        "flexbe_input/input_gui.py",
    ],
    imports = ["."],
    deps = [
        "@flexbe_core",
        "@flexbe_msgs//:py",
        "@rclpy",
        requirement("pyside6"),
    ],
)

ament_package(
    name = "ament_package",
    console_scripts = {
        "flexbe_input": "flexbe_input.flexbe_input:main",
        "input_action_server": "flexbe_input.input_action_server:main",
    },
    executables = ["resource/flexbe_input"],
    package_xml = "package.xml",
    python = [":flexbe_input"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@flexbe_core//:ament_package",
        "@flexbe_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
