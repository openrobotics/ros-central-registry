load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "flake8",
    ]
]

py_library(
    name = "flexbe_input",
    srcs = glob(["flexbe_input/**/*.py"]),
    imports = ["."],
    deps = [
        "@flexbe_core",
        "@flexbe_msgs//:py",
        "@rclpy",
        requirement("pyside6"),
    ],
)

py_pytest(
    name = "test_complex_action_server",
    srcs = ["test/test_complex_action_server.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    deps = [":flexbe_input"],
)

py_pytest(
    name = "test_flexbe_input",
    srcs = ["test/test_flexbe_input.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    deps = [":flexbe_input"],
)

py_pytest(
    name = "test_input_action_server",
    srcs = ["test/test_input_action_server.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":flexbe_input"],
)

py_pytest(
    name = "test_input_gui",
    srcs = ["test/test_input_gui.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":flexbe_input"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "flexbe_input": "flexbe_input.flexbe_input:main",
        "input_action_server": "flexbe_input.input_action_server:main",
    },
    executables = ["resource/flexbe_input"],
    package_xml = "package.xml",
    python = [":flexbe_input"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@flexbe_core//:ament_package",
        "@flexbe_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
