load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "py_trees_ros_viewer",
    srcs = [
        "py_trees_ros_viewer/__init__.py",
        "py_trees_ros_viewer/backend.py",
        "py_trees_ros_viewer/console.py",
        "py_trees_ros_viewer/conversions.py",
        "py_trees_ros_viewer/exceptions.py",
        "py_trees_ros_viewer/images_rc.py",
        "py_trees_ros_viewer/main_window.py",
        "py_trees_ros_viewer/main_window_ui.py",
        "py_trees_ros_viewer/utilities.py",
        "py_trees_ros_viewer/viewer.py",
        "py_trees_ros_viewer/web_app_rc.py",
        "py_trees_ros_viewer/web_view.py",
        "py_trees_ros_viewer/web_view_ui.py",
    ],
    imports = ["."],
    deps = [
        "@py_trees_js",
        "@py_trees_ros_interfaces//:py",
        "@rclpy",
        "@unique_identifier_msgs//:py",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_programs = {"py-trees-tree-viewer": "py_trees_ros_viewer.viewer:main"},
    package_xml = "package.xml",
    python = [":py_trees_ros_viewer"],
    setup_cfg = "setup.cfg",
    deps = [
        "@py_trees_js//:ament_package",
        "@py_trees_ros_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@unique_identifier_msgs//:ament_package",
    ],
)
