load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@mola_kernel//:mola_kernel": "@mola_kernel//:mola_kernel_library",
    "@mrpt_maps//:mrpt_maps": "@mrpt_maps//:mrpt_maps_library",
    "@mrpt_obs//:mrpt_obs": "@mrpt_obs//:mrpt_obs_library",
    "@rosdistro//cc:boost.chrono_shared": "@rosdistro//cc:boost.chrono",
    "@rosdistro//cc:boost.filesystem_shared": "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.program_options_shared": "@rosdistro//cc:boost.program_options",
    "@rosdistro//cc:boost.thread_shared": "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:bzip2": "@rosdistro//cc:bzip2_library",
    "@rosdistro//cc:lz4": "@rosdistro//cc:lz4_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:boost.array",
    "@rosdistro//cc:boost.assert",
    "@rosdistro//cc:boost.assign",
    "@rosdistro//cc:boost.atomic",
    "@rosdistro//cc:boost.bind",
    "@rosdistro//cc:boost.config",
    "@rosdistro//cc:boost.foreach",
    "@rosdistro//cc:boost.format",
    "@rosdistro//cc:boost.function",
    "@rosdistro//cc:boost.iterator",
    "@rosdistro//cc:boost.lexical_cast",
    "@rosdistro//cc:boost.math",
    "@rosdistro//cc:boost.mpl",
    "@rosdistro//cc:boost.signals2",
    "@rosdistro//cc:boost.smart_ptr",
    "@rosdistro//cc:boost.scope_exit",
    "@rosdistro//cc:boost.tuple",
    "@rosdistro//cc:boost.utility",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_library(
    name = "rosbag_library",
    srcs = [
        "ros1/ros_comm/utilities/roslz4/src/lz4s.c",
        "ros1/ros_comm/utilities/roslz4/src/xxhash.c",
    ] + glob([
        "ros1/console_bridge/src/*.cpp",
        "ros1/ros_comm/tools/rosbag_storage/src/*.cpp",
        "ros1/roscpp_core/cpp_common/src/*.cpp",
        "ros1/roscpp_core/roscpp_serialization/src/*.cpp",
        "ros1/roscpp_core/rostime/src/*.cpp",
    ]),
    hdrs = glob(["ros1/**/*.h"]),
    copts = [
        "-fvisibility=hidden",
        "-Wno-deprecated-declarations",
        "-Wno-unused-parameter",
    ],
    includes = [
        "ros1/console_bridge/include",
        "ros1/include",
        "ros1/ros_comm/tools/rosbag_storage/include",
        "ros1/ros_comm/utilities/roslz4/include",
        "ros1/roscpp_core/cpp_common/include",
        "ros1/roscpp_core/roscpp_serialization/include",
        "ros1/roscpp_core/roscpp_traits/include",
        "ros1/roscpp_core/rostime/include",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_library(
    name = "mrpt_ros1bridge_library",
    srcs = [
        "mrpt_ros_bridge/ros1bridge/src/gps.cpp",
        "mrpt_ros_bridge/ros1bridge/src/image.cpp",
        "mrpt_ros_bridge/ros1bridge/src/imu.cpp",
        "mrpt_ros_bridge/ros1bridge/src/laser_scan.cpp",
        "mrpt_ros_bridge/ros1bridge/src/point_cloud2.cpp",
        "mrpt_ros_bridge/ros1bridge/src/pose.cpp",
        "mrpt_ros_bridge/ros1bridge/src/range.cpp",
        "mrpt_ros_bridge/ros1bridge/src/time.cpp",
    ],
    hdrs = [
        "mrpt_ros_bridge/ros1bridge/include/mrpt/ros1bridge/gps.h",
        "mrpt_ros_bridge/ros1bridge/include/mrpt/ros1bridge/image.h",
        "mrpt_ros_bridge/ros1bridge/include/mrpt/ros1bridge/imu.h",
        "mrpt_ros_bridge/ros1bridge/include/mrpt/ros1bridge/laser_scan.h",
        "mrpt_ros_bridge/ros1bridge/include/mrpt/ros1bridge/logging.h",
        "mrpt_ros_bridge/ros1bridge/include/mrpt/ros1bridge/map.h",
        "mrpt_ros_bridge/ros1bridge/include/mrpt/ros1bridge/point_cloud2.h",
        "mrpt_ros_bridge/ros1bridge/include/mrpt/ros1bridge/pose.h",
        "mrpt_ros_bridge/ros1bridge/include/mrpt/ros1bridge/range.h",
        "mrpt_ros_bridge/ros1bridge/include/mrpt/ros1bridge/stereo_image.h",
        "mrpt_ros_bridge/ros1bridge/include/mrpt/ros1bridge/time.h",
    ],
    includes = [
        "mrpt_ros_bridge/ros1bridge/include",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":rosbag_library",
    ],
)

cc_library(
    name = "mola_input_rosbag1_library",
    srcs = [
        "src/Rosbag1Dataset.cpp",
    ],
    hdrs = ["include/mola_input_rosbag1/Rosbag1Dataset.h"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/mola_input_rosbag1",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":mrpt_ros1bridge_library",
        ":rosbag_library",
    ],
)

cc_shared_library(
    name = "mola_input_rosbag1",
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":mola_input_rosbag1_library"],
)

cc_binary(
    name = "rosbag1-info",
    srcs = ["apps/rosbag1-info.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":rosbag_library"],
)

ament_index(
    name = "ament_index",
    data = [
        "mola-cli-launchs/publish_to_ros2.yaml",
        "mola-cli-launchs/rosbag1_botanicgarden.yaml",
        "mola-cli-launchs/rosbag1_lidar.yaml",
        "mola-cli-launchs/rosbag1_ntu_viral.yaml",
        "mola-cli-launchs/rosbag1_to_ros2.yaml",
    ],
    libraries = [
        ":mola_input_rosbag1",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_input_rosbag1": [
            "libmola_input_rosbag1.so.0.5",
            "libmola_input_rosbag1.so.0.5.0",
        ],
    },
    deps = [
        "@geometry_msgs//:ament_package",
        "@mola_common//:ament_package",
        "@mola_kernel//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_obs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = ["include/mola_input_rosbag1/Rosbag1Dataset.h"],
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mola_input_rosbag1",
    ],
    package_xml = "package.xml",
    programs = [
        ":rosbag1-info",
    ],
    sonames = {
        "mola_input_rosbag1": [
            "libmola_input_rosbag1.so.0.5",
            "libmola_input_rosbag1.so.0.5.0",
        ],
    },
    deps = [
        ":ament_index",
        "@geometry_msgs//:ament_package",
        "@mola_common//:ament_package",
        "@mola_kernel//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_obs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

launch_ros_binary(
    name = "ros1_ros_comm_tools_roslaunch_test_xml_not_launch_xml",
    src = "ros1/ros_comm/tools/roslaunch/test/xml/not-launch.xml",
    data = [":ament_index"],
)
