load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@mola_kernel//:mola_kernel_library",
    "@mrpt_maps//:mrpt_maps_library",
    "@mrpt_obs//:mrpt_obs_library",
    "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
]

cc_library(
    name = "mola_input_rosbag1_library",
    srcs = [":gen_mola_input_rosbag1_stub_cpp"],
    hdrs = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/mola_input_rosbag1",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_input_rosbag1",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mola_input_rosbag1_library"],
)

cc_binary(
    name = "rosbag1-info",
    srcs = [":gen_mola_input_rosbag1_stub_cpp"],
    deps = [":mola_input_rosbag1_library"],
)

write_file(
    name = "gen_mola_input_rosbag1_stub_cpp",
    out = "_gen/mola_input_rosbag1_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

pkg_files(
    name = "pkg_files_soname_0",
    srcs = [":mola_input_rosbag1"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "lib",
    renames = {":mola_input_rosbag1": "libmola_input_rosbag1.so.0.5"},
)

pkg_files(
    name = "pkg_files_soname_1",
    srcs = [":mola_input_rosbag1"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "lib",
    renames = {":mola_input_rosbag1": "libmola_input_rosbag1.so.0.5.0"},
)

pkg_files(
    name = "pkg_files_launchs",
    srcs = glob(["mola-cli-launchs/*.yaml"]),
    prefix = "share/mola_input_rosbag1/mola-cli-launchs",
)

ament_index(
    name = "ament_index",
    data = glob(["mola-cli-launchs/*.yaml"]),
    libraries = [":mola_input_rosbag1"],
    package_xml = "package.xml",
    deps = [
        "@geometry_msgs//:ament_package",
        "@mola_common//:ament_package",
        "@mola_kernel//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_obs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    install = [
        ":pkg_files_soname_0",
        ":pkg_files_soname_1",
        ":pkg_files_launchs",
    ],
    install_package_xml = False,
    libraries = [":mola_input_rosbag1"],
    package_xml = "package.xml",
    programs = [":rosbag1-info"],
    deps = [
        ":ament_index",
        "@geometry_msgs//:ament_package",
        "@mola_common//:ament_package",
        "@mola_kernel//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_obs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
