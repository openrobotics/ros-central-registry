load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "find_hardware_version.launch.py",
        "leo_bringup.launch.xml",
    ],
)

launch_ros_binary(
    name = "find_hardware_version_launch",
    src = "find_hardware_version.launch.py",
    data = ["//:ament_index"],
)

launch_ros_binary(
    name = "leo_bringup_launch",
    src = "leo_bringup.launch.xml",
    data = [
        "//:ament_index",
        "@image_proc//:ament_index",
        "@leo_description//:ament_index",
        "@leo_filters//:ament_index",
        "@leo_filters//:imu_filter",
        "@leo_filters//:odom_filter",
        "@leo_fw//:ament_index",
        "@leo_fw//:firmware_message_converter",
        "@rclcpp_components//:ament_index",
        "@rclcpp_components//:component_container",
        "@robot_state_publisher",
        "@robot_state_publisher//:ament_index",
        "@rosbridge_server//:ament_index",
        "@web_video_server//:ament_index",
        "@xacro",
    ],
    deps = [
        "@rosapi",
        "@rosbridge_server",
    ],
)
