--- a/test/common.py
+++ b/test/common.py
@@ -23,6 +23,21 @@
     #
     # For the fun RTTI ABI details, see https://whatofhow.wordpress.com/2015/03/17/odr-rtti-dso/.
     sys.setdlopenflags(os.RTLD_GLOBAL | os.RTLD_LAZY)
+
+# Under Bazel the test resources are read-only symlinks into the source tree,
+# but SQLite has to create -shm/-wal sidecar files next to a WAL-mode bag even
+# when opening it read-only (and some tests write next to the bags), so hand
+# the tests a writable copy of the resources instead, as a colcon source tree
+# would be.
+_resources_dir = os.environ.get('ROSBAG2_PY_TEST_RESOURCES_DIR')
+if _resources_dir and os.environ.get('TEST_TMPDIR'):
+    import shutil
+    import tempfile
+    _writable_copy = os.path.join(
+        tempfile.mkdtemp(prefix='rosbag2_py_test_resources_', dir=os.environ['TEST_TMPDIR']),
+        'resources')
+    shutil.copytree(_resources_dir, _writable_copy)
+    os.environ['ROSBAG2_PY_TEST_RESOURCES_DIR'] = _writable_copy
 
 from rclpy.clock import Clock, ClockType  # noqa
 from rclpy.duration import Duration  # noqa
