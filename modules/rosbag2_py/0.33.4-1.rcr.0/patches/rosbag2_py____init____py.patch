 from rpyutils import add_dll_directories_from_env
+
+
+@contextlib.contextmanager
+def _rtld_global():
+    # The extension modules below are built with clang/libc++, where
+    # class_loader's dynamic_cast across shared libraries (pluginlib storage,
+    # compression and serialization plugins, the RMW implementation) only
+    # resolves when the extensions' symbols are loaded RTLD_GLOBAL. See
+    # https://whatofhow.wordpress.com/2015/03/17/odr-rtti-dso/ and
+    # ROSBAG2_PY_TEST_WITH_RTLD_GLOBAL in upstream's test/common.py.
+    if sys.platform != 'linux':
+        yield
+        return
+    flags = sys.getdlopenflags()
+    sys.setdlopenflags(flags | os.RTLD_GLOBAL)
+    try:
+        yield
+    finally:
+        sys.setdlopenflags(flags)
+
 
