load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

py_library(
    name = "test_common",
    testonly = True,
    srcs = ["common.py"],
    imports = ["."],
    visibility = ["//visibility:private"],
    deps = [
        "//:rosbag2_py",
        "@rclpy",
    ],
)

[py_pytest(
    name = "test_{0}_py".format(test),
    srcs = ["test_{0}.py".format(test)],
    data = [
        "resources/mcap/convert_a/metadata.yaml",
        "resources/mcap/convert_a/rewriter_a_0.mcap",
        "resources/mcap/convert_b/metadata.yaml",
        "resources/mcap/convert_b/rewriter_b_0.mcap",
        "resources/mcap/reindex_test_bags/multiple_files/multiple_files_0.mcap",
        "resources/mcap/reindex_test_bags/multiple_files/multiple_files_1.mcap",
        "resources/mcap/reindex_test_bags/multiple_files/multiple_files_2.mcap",
        "resources/mcap/talker/metadata.yaml",
        "resources/mcap/talker/talker.mcap",
        "resources/mcap/wbag/metadata.yaml",
        "resources/mcap/wbag/wbag_0.mcap",
        "resources/mcap/wbag/wbag_1.mcap",
        "resources/mcap/wbag/wbag_2.mcap",
        "resources/mcap/wbag/wbag_3.mcap",
        "resources/mcap/wbag/wbag_4.mcap",
        "resources/sqlite3/convert_a/metadata.yaml",
        "resources/sqlite3/convert_a/rewriter_a_0.db3",
        "resources/sqlite3/convert_b/metadata.yaml",
        "resources/sqlite3/convert_b/rewriter_b_0.db3",
        "resources/sqlite3/reindex_test_bags/multiple_files/multiple_files_0.db3",
        "resources/sqlite3/reindex_test_bags/multiple_files/multiple_files_1.db3",
        "resources/sqlite3/reindex_test_bags/multiple_files/multiple_files_2.db3",
        "resources/sqlite3/talker/metadata.yaml",
        "resources/sqlite3/talker/talker.db3",
        "resources/sqlite3/wbag/metadata.yaml",
        "resources/sqlite3/wbag/wbag_0.db3",
        "resources/sqlite3/wbag/wbag_1.db3",
        "resources/sqlite3/wbag/wbag_2.db3",
        "resources/sqlite3/wbag/wbag_3.db3",
        "resources/sqlite3/wbag/wbag_4.db3",
    ] + ["//:ament_index_test"],
    env = {
        "ROSBAG2_PY_TEST_RESOURCES_DIR": "../rosbag2_py+/test/resources",
        "ROSBAG2_PY_TEST_WITH_RTLD_GLOBAL": "True",
    },
    tags = ["manual"] if test == "transport" else [],
    deps = [
        ":test_common",
        "//:rosbag2_py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@rosbag2_test_common//:rosbag2_test_common_py",
        "@rosbag2_test_msgdefs//:py",
        "@rosidl_runtime_py",
        "@std_msgs//:py",
    ],
) for test in [
    "compression",
    "convert",
    "message_definitions",
    "reindexer",
    "sequential_reader",
    "sequential_reader_multiple_files",
    "sequential_writer",
    "storage",
    "transport",
]]
