load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@rosbag2_compression//:rosbag2_compression": "@rosbag2_compression//:rosbag2_compression_library",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosbag2_transport//:rosbag2_transport": "@rosbag2_transport//:rosbag2_transport_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

cc_library(
    name = "rosbag2_py_headers",
    hdrs = [
        "src/rosbag2_py/action_info.hpp",
        "src/rosbag2_py/format_action_info.hpp",
        "src/rosbag2_py/format_bag_metadata.hpp",
        "src/rosbag2_py/format_service_info.hpp",
        "src/rosbag2_py/format_utils.hpp",
        "src/rosbag2_py/info_sorting_method.hpp",
        "src/rosbag2_py/pybind11.hpp",
        "src/rosbag2_py/service_event_info.hpp",
    ],
    includes = [
        "src",
        "src/rosbag2_py",
    ],
    deps = [
        "@rosdistro//cc:pybind11",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_library(
    name = "_compression_options_library",
    srcs = ["src/rosbag2_py/_compression_options.cpp"],
    deps = DEPENDENCIES.values() + [":rosbag2_py_headers"],
)

cc_shared_library(
    name = "_compression_options",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "rosbag2_py/_compression_options.so",
    deps = [":_compression_options_library"],
)

cc_library(
    name = "_info_library",
    srcs = [
        "src/rosbag2_py/_info.cpp",
        "src/rosbag2_py/format_action_info.cpp",
        "src/rosbag2_py/format_bag_metadata.cpp",
        "src/rosbag2_py/format_service_info.cpp",
        "src/rosbag2_py/format_utils.cpp",
        "src/rosbag2_py/info_sorting_method.cpp",
    ],
    deps = DEPENDENCIES.values() + [":rosbag2_py_headers"],
)

cc_shared_library(
    name = "_info",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "rosbag2_py/_info.so",
    deps = [":_info_library"],
)

cc_library(
    name = "_message_definitions_library",
    srcs = ["src/rosbag2_py/_message_definitions.cpp"],
    deps = DEPENDENCIES.values() + [":rosbag2_py_headers"],
)

cc_shared_library(
    name = "_message_definitions",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "rosbag2_py/_message_definitions.so",
    deps = [":_message_definitions_library"],
)

cc_library(
    name = "_reader_library",
    srcs = ["src/rosbag2_py/_reader.cpp"],
    deps = DEPENDENCIES.values() + [":rosbag2_py_headers"],
)

cc_shared_library(
    name = "_reader",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "rosbag2_py/_reader.so",
    deps = [":_reader_library"],
)

cc_library(
    name = "_reindexer_library",
    srcs = ["src/rosbag2_py/_reindexer.cpp"],
    deps = DEPENDENCIES.values() + [":rosbag2_py_headers"],
)

cc_shared_library(
    name = "_reindexer",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "rosbag2_py/_reindexer.so",
    deps = [":_reindexer_library"],
)

cc_library(
    name = "_storage_library",
    srcs = [
        "src/rosbag2_py/_storage.cpp",
        "src/rosbag2_py/format_bag_metadata.cpp",
        "src/rosbag2_py/info_sorting_method.cpp",
    ],
    deps = DEPENDENCIES.values() + [":rosbag2_py_headers"],
)

cc_shared_library(
    name = "_storage",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "rosbag2_py/_storage.so",
    deps = [":_storage_library"],
)

cc_library(
    name = "_transport_library",
    srcs = ["src/rosbag2_py/_transport.cpp"],
    deps = DEPENDENCIES.values() + [":rosbag2_py_headers"],
)

cc_shared_library(
    name = "_transport",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "rosbag2_py/_transport.so",
    deps = [":_transport_library"],
)

cc_library(
    name = "_writer_library",
    srcs = ["src/rosbag2_py/_writer.cpp"],
    deps = DEPENDENCIES.values() + [":rosbag2_py_headers"],
)

cc_shared_library(
    name = "_writer",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "rosbag2_py/_writer.so",
    deps = [":_writer_library"],
)

py_library(
    name = "rosbag2_py",
    srcs = ["rosbag2_py/__init__.py"],
    data = [
        ":_compression_options",
        ":_info",
        ":_message_definitions",
        ":_reader",
        ":_reindexer",
        ":_storage",
        ":_transport",
        ":_writer",
        ":ament_index",
    ],
    imports = ["."],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@rosbag2_compression//:ament_index",
        "@rosbag2_compression_zstd//:ament_index_package",
        "@rosbag2_compression_zstd//:ament_index_plugin",
        "@rosbag2_cpp//:ament_index",
        "@rosbag2_storage_default_plugins//:ament_index",
    ],
)

ament_index(
    name = "ament_index_test",
    testonly = True,
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@rosbag2_test_msgdefs//:ament_index",
        "@std_msgs//:ament_index",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    package_xml = "package.xml",
    python = [
        ":rosbag2_py",
        ":_compression_options",
        ":_info",
        ":_message_definitions",
        ":_reader",
        ":_reindexer",
        ":_storage",
        ":_transport",
        ":_writer",
    ] + [
        "rosbag2_py/__init__.pyi",
        "rosbag2_py/_compression_options.pyi",
        "rosbag2_py/_info.pyi",
        "rosbag2_py/_message_definitions.pyi",
        "rosbag2_py/_reader.pyi",
        "rosbag2_py/_reindexer.pyi",
        "rosbag2_py/_storage.pyi",
        "rosbag2_py/_transport.pyi",
        "rosbag2_py/_writer.pyi",
        "rosbag2_py/py.typed",
    ],
    deps = [
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosbag2_compression//:ament_package",
        "@rosbag2_compression_zstd//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_storage_default_plugins//:ament_package",
        "@rosbag2_test_common//:ament_package",
        "@rosbag2_test_msgdefs//:ament_package",
        "@rosbag2_transport//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_py//:ament_package",
        "@rpyutils//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
