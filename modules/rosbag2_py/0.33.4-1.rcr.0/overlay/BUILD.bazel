### PYTHON MODULE

py_library(
    name = "rosbag2_py",
    srcs = glob(["rosbag2_py/**/*.py"]),
    data = [
        ":_compression_options",
        ":_info",
        ":_message_definitions",
        ":_reader",
        ":_reindexer",
        ":_storage",
        ":_transport",
        ":_writer",
        ":ament_index",
    ],
    imports = ["."],
)

### TESTS

py_library(
    name = "test_common",
    testonly = True,
    srcs = ["test/common.py"],
    imports = ["test"],
    visibility = ["//visibility:private"],
    deps = [
        ":rosbag2_py",
        "@rclpy",
    ],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@rosbag2_compression//:ament_index",
        "@rosbag2_compression_zstd//:ament_index_package",
        "@rosbag2_compression_zstd//:ament_index_plugin",
        "@rosbag2_cpp//:ament_index",
        "@rosbag2_storage_default_plugins//:ament_index",
    ],
)

ament_index(
    name = "ament_index_test",
    testonly = True,
    package_xml = "package.xml",
    visibility = ["//visibility:private"],
    deps = [
        ":ament_index",
        "@rosbag2_test_msgdefs//:ament_index",
        "@std_msgs//:ament_index",
    ],
)

[
    py_pytest(
        name = "test_{0}_py".format(test),
        srcs = ["test/test_{0}.py".format(test)],
        data = glob(["test/resources/**"]) + [":ament_index_test"],
        env = {
            "ROSBAG2_PY_TEST_RESOURCES_DIR": "../rosbag2_py+/test/resources",
            # As upstream's CMake does for clang/libc++ builds (our hermetic
            # toolchain): make class_loader's RTTI work across the python
            # extension boundary (see test/common.py).
            "ROSBAG2_PY_TEST_WITH_RTLD_GLOBAL": "True",
        },
        # test_transport.py imports rosbag2_interfaces.srv, which rosbag2_py's
        # package.xml does not declare (upstream gets it transitively through
        # rosbag2_transport's CMake exports), so it cannot be expressed as a
        # Bazel dependency until the package declares it.
        tags = ["manual"] if test == "transport" else [],
        deps = [
            ":rosbag2_py",
            ":test_common",
            "@rcl_interfaces//:py",
            "@rclpy",
            "@rosbag2_test_common//:rosbag2_test_common_py",
            "@rosbag2_test_msgdefs//:py",
            "@rosidl_runtime_py",
            "@std_msgs//:py",
        ],
    )
    for test in [
        "compression",
        "convert",
        "message_definitions",
        "reindexer",
        "sequential_reader",
        "sequential_reader_multiple_files",
        "sequential_writer",
        "storage",
        "transport",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    package_xml = "package.xml",
    python = [
        ":rosbag2_py",
        ":_compression_options",
        ":_info",
        ":_message_definitions",
        ":_reader",
        ":_reindexer",
        ":_storage",
        ":_transport",
        ":_writer",
    ] + glob([
        "rosbag2_py/*.pyi",
        "rosbag2_py/py.typed",
    ]),
    deps = [
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosbag2_compression//:ament_package",
        "@rosbag2_compression_zstd//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_storage_default_plugins//:ament_package",
        "@rosbag2_test_common//:ament_package",
        "@rosbag2_test_msgdefs//:ament_package",
        "@rosbag2_transport//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_py//:ament_package",
        "@rpyutils//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
