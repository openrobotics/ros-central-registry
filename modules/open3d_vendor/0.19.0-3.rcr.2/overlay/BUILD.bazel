tity::Type makeIdentity(Entity::Type g, Entity::Type i) noexcept {\n        return (g << GENERATION_SHIFT) | (i & INDEX_MASK);\n    }\n\n    // stores the generation of each index.\n    uint8_t * const mGens;\n};\n\n} // namespace utils\n\n#endif // TNT_UTILS_ENTITYMANAGER_H\n"],
