gle_normals,\n                              core::Tensor& vertex_normals);\n\nvoid ComputeTriangleAreasCUDA(const core::Tensor& vertices,\n                              const core::Tensor& triangles,\n                              core::Tensor& triangle_areas);\n#endif\n\n}  // namespace trianglemesh\n}  // namespace kernel\n}  // namespace geometry\n}  // namespace t\n}  // namespace open3d\n"],
