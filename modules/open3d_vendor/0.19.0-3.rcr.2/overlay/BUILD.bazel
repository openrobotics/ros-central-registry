put iou values.\n/// \\param num_a Number of boxes in boxes_a.\n/// \\param num_b Number of boxes in boxes_b.\nvoid IoU3dCPUKernel(const float *boxes_a,\n                    const float *boxes_b,\n                    float *iou,\n                    int num_a,\n                    int num_b);\n\n}  // namespace contrib\n}  // namespace ml\n}  // namespace open3d\n"],
