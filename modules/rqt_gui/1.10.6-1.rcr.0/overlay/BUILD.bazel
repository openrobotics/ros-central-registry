load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### DATA

ament_index(
    name = "ament_index",
    data = glob(
        ["resource/**"],
        exclude = ["resource/rqt_gui"],
    ),
    package_xml = "package.xml",
    deps = ["@qt_gui//:ament_index"],
)

### LIBRARIES

py_library(
    name = "rqt_gui",
    srcs = glob(["src/rqt_gui/**/*.py"]),
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@python_qt_binding",
        "@qt_gui",
        "@rclpy",
        requirement("packaging"),
    ],
)

### EXECUTABLES

genrule(
    name = "cli_rename",
    srcs = ["bin/rqt_gui"],
    outs = ["bin/rqt_gui.py"],
    cmd = "cp $(location :bin/rqt_gui) $(location :bin/rqt_gui.py)",
)

py_binary(
    name = "rqt",
    srcs = [":bin/rqt_gui.py"],
    main = ":bin/rqt_gui.py",
    deps = [":rqt_gui"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_programs = {"rqt": "rqt_gui.main:main"},
    executables = ["bin/rqt_gui"],
    package_xml = "package.xml",
    python = [":rqt_gui"],
    python_strip_prefix = "src",
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@python_qt_binding//:ament_package",
        "@qt_gui//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
