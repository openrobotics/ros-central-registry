load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

write_file(
    name = "meta_share_automotive_autonomy_msgs_hook_pkg_config_path_dsv",
    out = "_meta/share/automotive_autonomy_msgs/hook/pkg_config_path.dsv",
    content = ["prepend-non-duplicate;PKG_CONFIG_PATH;lib/pkgconfig"],
)

write_file(
    name = "meta_share_automotive_autonomy_msgs_hook_pkg_config_path_ps1",
    out = "_meta/share/automotive_autonomy_msgs/hook/pkg_config_path.ps1",
    content = [
        "# generated from colcon_powershell/shell/template/hook_prepend_value.ps1.em",
        "",
        "colcon_prepend_unique_value PKG_CONFIG_PATH \"$env:COLCON_CURRENT_PREFIX/lib/pkgconfig\"",
    ],
)

write_file(
    name = "meta_share_automotive_autonomy_msgs_hook_pkg_config_path_sh",
    out = "_meta/share/automotive_autonomy_msgs/hook/pkg_config_path.sh",
    content = [
        "# generated from colcon_core/shell/template/hook_prepend_value.sh.em",
        "",
        "_colcon_prepend_unique_value PKG_CONFIG_PATH \"$COLCON_CURRENT_PREFIX/lib/pkgconfig\"",
    ],
)

write_file(
    name = "meta_share_automotive_autonomy_msgs_hook_pkg_config_path_multiarch_dsv",
    out = "_meta/share/automotive_autonomy_msgs/hook/pkg_config_path_multiarch.dsv",
    content = ["prepend-non-duplicate;PKG_CONFIG_PATH;lib/x86_64-linux-gnu/pkgconfig"],
)

write_file(
    name = "meta_share_automotive_autonomy_msgs_hook_pkg_config_path_multiarch_ps1",
    out = "_meta/share/automotive_autonomy_msgs/hook/pkg_config_path_multiarch.ps1",
    content = [
        "# generated from colcon_powershell/shell/template/hook_prepend_value.ps1.em",
        "",
        "colcon_prepend_unique_value PKG_CONFIG_PATH \"$env:COLCON_CURRENT_PREFIX/lib/x86_64-linux-gnu/pkgconfig\"",
    ],
)

write_file(
    name = "meta_share_automotive_autonomy_msgs_hook_pkg_config_path_multiarch_sh",
    out = "_meta/share/automotive_autonomy_msgs/hook/pkg_config_path_multiarch.sh",
    content = [
        "# generated from colcon_core/shell/template/hook_prepend_value.sh.em",
        "",
        "_colcon_prepend_unique_value PKG_CONFIG_PATH \"$COLCON_CURRENT_PREFIX/lib/x86_64-linux-gnu/pkgconfig\"",
    ],
)

write_file(
    name = "meta_share_automotive_autonomy_msgs_hook_ros_package_path_dsv",
    out = "_meta/share/automotive_autonomy_msgs/hook/ros_package_path.dsv",
    content = ["prepend-non-duplicate;ROS_PACKAGE_PATH;share"],
)

write_file(
    name = "meta_share_automotive_autonomy_msgs_hook_ros_package_path_ps1",
    out = "_meta/share/automotive_autonomy_msgs/hook/ros_package_path.ps1",
    content = [
        "# generated from colcon_powershell/shell/template/hook_prepend_value.ps1.em",
        "",
        "colcon_prepend_unique_value ROS_PACKAGE_PATH \"$env:COLCON_CURRENT_PREFIX/share\"",
    ],
)

write_file(
    name = "meta_share_automotive_autonomy_msgs_hook_ros_package_path_sh",
    out = "_meta/share/automotive_autonomy_msgs/hook/ros_package_path.sh",
    content = [
        "# generated from colcon_core/shell/template/hook_prepend_value.sh.em",
        "",
        "_colcon_prepend_unique_value ROS_PACKAGE_PATH \"$COLCON_CURRENT_PREFIX/share\"",
    ],
)

pkg_files(
    name = "meta_files",
    srcs = [
        ":meta_share_automotive_autonomy_msgs_hook_pkg_config_path_dsv",
        ":meta_share_automotive_autonomy_msgs_hook_pkg_config_path_multiarch_dsv",
        ":meta_share_automotive_autonomy_msgs_hook_pkg_config_path_multiarch_ps1",
        ":meta_share_automotive_autonomy_msgs_hook_pkg_config_path_multiarch_sh",
        ":meta_share_automotive_autonomy_msgs_hook_pkg_config_path_ps1",
        ":meta_share_automotive_autonomy_msgs_hook_pkg_config_path_sh",
        ":meta_share_automotive_autonomy_msgs_hook_ros_package_path_dsv",
        ":meta_share_automotive_autonomy_msgs_hook_ros_package_path_ps1",
        ":meta_share_automotive_autonomy_msgs_hook_ros_package_path_sh",
    ],
    strip_prefix = strip_prefix.from_pkg("_meta"),
)

### PACKAGING

ament_package(
    name = "ament_package",
    install = [":meta_files"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@automotive_navigation_msgs//:ament_package",
        "@automotive_platform_msgs//:ament_package",
        "@ros_environment//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
