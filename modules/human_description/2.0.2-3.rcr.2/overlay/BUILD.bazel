load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "config/human.rviz",
        "launch/robot_state_publisher.launch.py",
        "launch/show.launch.py",
        "urdf/human-tpl.xacro",
    ],
    package_xml = "package.xml",
)

# Upstream human_description/package.xml and urdf_test/package.xml omit <test_depend>launch_testing</test_depend>.
launch_ros_test(
    name = "human_description",
    src = "test/test_description.launch.py",
    data = [":ament_index"],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [
        "@launch_pal",
        "@launch_param_builder",
        "@urdf_test",
    ],
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [":ament_index"],
    )
    for f in glob(["launch/**"])
]

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@launch//:ament_package",
        "@launch_pal//:ament_package",
        "@launch_param_builder//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@urdf_test//:ament_package",
        "@xacro//:ament_package",
    ],
)
