cc_library(
    name = "autoware_utils",
    hdrs = HEADERS,
    includes = ["include"],
    deps = [
        "@autoware_utils_debug//:autoware_utils_debug_library",
        "@autoware_utils_diagnostics//:autoware_utils_diagnostics_library",
        "@autoware_utils_geometry//:autoware_utils_geometry_library",
        "@autoware_utils_logging//:autoware_utils_logging_library",
