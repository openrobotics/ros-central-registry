load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### EXECUTABLES

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "lifecycle_talker",
    srcs = ["src/lifecycle_talker.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@example_interfaces//:cc",
        "@lifecycle_msgs//:cc",
    ],
)

cc_binary(
    name = "lifecycle_listener",
    srcs = ["src/lifecycle_listener.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@example_interfaces//:cc",
        "@lifecycle_msgs//:cc",
    ],
)

cc_binary(
    name = "lifecycle_service_client",
    srcs = ["src/lifecycle_service_client.cpp"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@lifecycle_msgs//:cc",
    ],
)

launch_ros_binary(
    name = "lifecycle_demo_launch.py",
    src = "launch/lifecycle_demo_launch.py",
    data = [":ament_index"],
)

### TESTS

launch_ros_test(
    name = "test_test_lifecycle.py",
    src = "test/test_lifecycle.py",
    data = glob(["launch/*"]) + [
        ":lifecycle_listener",
        ":lifecycle_service_client",
        ":lifecycle_talker",
        # TODO(simmers) add these deps upstream.
        # "@launch",
        # "@launch_ros",
        # "@launch_testing",
        "@lifecycle_msgs//:cc",
    ] + [":ament_index"],
    tags = [
        "manual",
        "xfail",
    ],
)

ament_index(
    name = "ament_index",
    data = glob(["launch/**"]),
    executables = [
        ":lifecycle_talker",
        ":lifecycle_listener",
        ":lifecycle_service_client",
    ],
    package_xml = "package.xml",
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    data = glob(["launch/**"]),
    executables = [
        ":lifecycle_talker",
        ":lifecycle_listener",
        ":lifecycle_service_client",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@example_interfaces//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros_testing//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
