load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
)

DEPENDENCIES = {
    "@mola_pose_list//:mola_pose_list": "@mola_pose_list//:mola_pose_list_library",
    "@mp2p_icp//:mp2p_icp": "@mp2p_icp//:mp2p_icp_library",
    "@mp2p_icp//:mp2p_icp_common": "@mp2p_icp//:mp2p_icp_common_library",
    "@mp2p_icp//:mp2p_icp_map": "@mp2p_icp//:mp2p_icp_map_library",
    "@mrpt_maps//:mrpt_maps": "@mrpt_maps//:mrpt_maps_library",
    "@mrpt_obs//:mrpt_obs": "@mrpt_obs//:mrpt_obs_library",
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

HEADERS = ["include/mola_relocalization/relocalization.h"]

cc_library(
    name = "mola_relocalization_library",
    srcs = [
        "src/RelocalizationICP_SE2.cpp",
        "src/RelocalizationLikelihood_SE2.cpp",
        "src/find_best_poses_se2.cpp",
    ],
    hdrs = HEADERS,
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    defines = ["MP2P_ICP_HAS_MOLA_IMU_PREINTEGRATION"],
    includes = [
        "include",
        "include/mola_relocalization",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=3",
        "MOLA_PATCH_VERSION=0",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_relocalization",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mola_relocalization_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":mola_relocalization"],
)

cc_test(
    name = "test-relocalization-se2-kitti",
    srcs = ["tests/test-relocalization-se2-kitti.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        ":ament_index",
        "@mola_test_datasets//:ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines() + [
        'TEST_DATASETS_ROOT=\\"share/mola_test_datasets/datasets/\\"',
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":mola_relocalization_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_index(
    name = "ament_index",
    libraries = [":mola_relocalization"],
    package_xml = "package.xml",
    sonames = {"mola_relocalization": [
        "libmola_relocalization.so.2.0",
        "libmola_relocalization.so.2.0.0",
    ]},
    deps = [
        "@mola_common//:ament_package",
        "@mola_pose_list//:ament_package",
        "@mp2p_icp//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_obs//:ament_package",
    ],
)

ament_package(
    name = "ament_package",
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = HEADERS,
    include_prefix = "",
    install_package_xml = False,
    libraries = [":mola_relocalization"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@mola_common//:ament_package",
        "@mola_pose_list//:ament_package",
        "@mola_test_datasets//:ament_package",
        "@mp2p_icp//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_obs//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
