load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

default_generators(
    dependencies = [
        "@geometry_msgs",
        "@std_msgs",
    ],
    package_xml = "package.xml",
    deps = [
        "//msg:Graph",
        "//msg:Order",
        "//msg:OrderArray",
        "//msg:OrderPosition",
        "//msg:Pickup",
        "//msg:RobotGoals",
        "//msg:RobotGoalsArray",
        "//msg:RobotInfo",
        "//msg:Route",
        "//msg:RoutePrecondition",
        "//msg:RouteProgress",
        "//msg:RouteSegment",
        "//msg:RouterStatus",
        "//msg:Station",
        "//msg:StationArray",
        "//msg:Vertex",
        "//srv:StationManagerControlProtocol",
        "//srv:StationManagerStationProtocol",
    ],
)

rosidl_ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
