load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:ament_resource.bzl", "register_ament_resource")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@mujoco_vendor//:_gen_textual_hdrs",
    "@mujoco_vendor//:lodepng_library",
    "@mujoco_vendor//:mujoco_simulate_library",
]

cc_library(
    name = "mujoco_3d_lidar_library",
    srcs = [":gen_mujoco_3d_lidar_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/mujoco_3d_lidar",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mujoco_3d_lidar",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":mujoco_3d_lidar_library"],
)

register_ament_resource(
    name = "res_mujoco_plugins",
    category = "mujoco_plugins",
    content = "lib/mujoco_3d_lidar/mujoco_plugin",
)

write_file(
    name = "gen_mujoco_3d_lidar_stub_cpp",
    out = "_gen/mujoco_3d_lidar_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

register_ament_files(
    name = "ament_files_0",
    files = [
        ":mujoco_3d_lidar",
    ],
    prefix = "lib/mujoco_3d_lidar/mujoco_plugin",
    strip_prefix = "*",
)

ament_index(
    name = "ament_index",
    data = [
        ":ament_files_0",
    ],
    lib_data = [
        ":mujoco_3d_lidar",
    ],
    package_xml = "package.xml",
    deps = [
        ":res_mujoco_plugins",
        "@ament_cmake//:ament_package",
        "@mujoco_vendor//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = ["mujoco_vendor"],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        ":res_mujoco_plugins",
        "@ament_cmake//:ament_package",
        "@mujoco_vendor//:ament_package",
    ],
)
