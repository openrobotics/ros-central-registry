load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "tf2_ros_py",
    srcs = [
        "tf2_ros/__init__.py",
        "tf2_ros/buffer.py",
        "tf2_ros/buffer_client.py",
        "tf2_ros/buffer_interface.py",
        "tf2_ros/static_transform_broadcaster.py",
        "tf2_ros/static_transform_listener.py",
        "tf2_ros/transform_broadcaster.py",
        "tf2_ros/transform_listener.py",
    ],
    imports = ["."],
    deps = [
        "@geometry_msgs//:py",
        "@rclpy",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        "@tf2_msgs//:py",
        "@tf2_py",
    ],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "conftest.py",
        "doc/Makefile",
        "doc/make.bat",
        "doc/source/conf.py",
        "doc/source/index.rst",
        "package.xml",
        "pytest.ini",
        "resource/tf2_ros_py",
        "rosdoc2.yaml",
        "setup.cfg",
        "setup.py",
        "tf2_ros/__init__.py",
        "tf2_ros/buffer.py",
        "tf2_ros/buffer_client.py",
        "tf2_ros/buffer_interface.py",
        "tf2_ros/static_transform_broadcaster.py",
        "tf2_ros/static_transform_listener.py",
        "tf2_ros/transform_broadcaster.py",
        "tf2_ros/transform_listener.py",
    ],
    deps = [
        "@ament_{0}".format(linter),
        "@rmw_test_fixture_implementation//:rmw_test_fixture_implementation_py",
    ],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
    "xmllint",
]]

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":tf2_ros_py"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rmw_test_fixture_implementation//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2_msgs//:ament_package",
        "@tf2_py//:ament_package",
    ],
)
