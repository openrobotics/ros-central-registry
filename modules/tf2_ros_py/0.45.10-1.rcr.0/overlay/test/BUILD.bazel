load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

exports_files([
    "test_buffer.py",
    "test_buffer_client.py",
    "test_copyright.py",
    "test_flake8.py",
    "test_listener_and_broadcaster.py",
    "test_pep257.py",
    "test_xmllint.py",
])

[py_pytest(
    name = name,
    srcs = ["{}.py".format(name)],
    deps = [
        "//:tf2_ros_py",
        "@rmw_test_fixture_implementation//:rmw_test_fixture_implementation_py",
        "@rules_python//python/runfiles",
    ],
) for name in [
    "test_buffer",
    "test_buffer_client",
    "test_listener_and_broadcaster",
]]
