load("@rosdistro//ament:defs.bzl", "ament_package", "register_ament_files")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

filegroup(
    name = "_test_data_0",
    srcs = [
        "CMakeLists.txt",
        "README.md",
        "examples/assets/suzanne.stl",
        "examples/ex_allow_collisions.py",
        "examples/ex_clear_planning_scene.py",
        "examples/ex_collision_mesh.py",
        "examples/ex_collision_primitive.py",
        "examples/ex_doctor.py",
        "examples/ex_fk.py",
        "examples/ex_gripper.py",
        "examples/ex_ik.py",
        "examples/ex_joint_goal.py",
        "examples/ex_orientation_path_constraint.py",
        "examples/ex_pose_goal.py",
        "examples/ex_servo.py",
        "examples/ex_session.py",
        "package.xml",
    ],
)

py_library(
    name = "pymoveit2",
    srcs = [
        "pymoveit2/__init__.py",
        "pymoveit2/_action_lifecycle.py",
        "pymoveit2/_diagnostics.py",
        "pymoveit2/_example_utils.py",
        "pymoveit2/_joint_helpers.py",
        "pymoveit2/_mesh.py",
        "pymoveit2/_planning_scene.py",
        "pymoveit2/_request_builders.py",
        "pymoveit2/_validation.py",
        "pymoveit2/gripper_command.py",
        "pymoveit2/gripper_interface.py",
        "pymoveit2/moveit2.py",
        "pymoveit2/moveit2_gripper.py",
        "pymoveit2/moveit2_servo.py",
        "pymoveit2/robot_description.py",
        "pymoveit2/robots/__init__.py",
        "pymoveit2/robots/crane_x7.py",
        "pymoveit2/robots/kinova.py",
        "pymoveit2/robots/lbr.py",
        "pymoveit2/robots/panda.py",
        "pymoveit2/robots/phantomx_pincher.py",
        "pymoveit2/robots/ur.py",
        "pymoveit2/session.py",
        "pymoveit2/utils.py",
    ],
    imports = ["."],
    deps = [
        "@action_msgs//:py",
        "@control_msgs//:py",
        "@geometry_msgs//:py",
        "@moveit_msgs//:py",
        "@rclpy",
        "@sensor_msgs//:py",
        "@shape_msgs//:py",
        "@std_msgs//:py",
        "@std_srvs//:py",
        "@trajectory_msgs//:py",
    ],
)

register_ament_files(
    name = "ament_files_0",
    files = ["examples/assets/suzanne.stl"],
    prefix = "lib/pymoveit2/assets",
    strip_prefix = "examples/assets",
)

ament_package(
    name = "ament_package",
    data = [":ament_files_0"],
    executables = [
        "examples/ex_allow_collisions.py",
        "examples/ex_clear_planning_scene.py",
        "examples/ex_collision_mesh.py",
        "examples/ex_collision_primitive.py",
        "examples/ex_doctor.py",
        "examples/ex_fk.py",
        "examples/ex_gripper.py",
        "examples/ex_ik.py",
        "examples/ex_joint_goal.py",
        "examples/ex_orientation_path_constraint.py",
        "examples/ex_pose_goal.py",
        "examples/ex_servo.py",
        "examples/ex_session.py",
    ],
    package_xml = "package.xml",
    python = [":pymoveit2"],
    deps = [
        "@action_msgs//:ament_package",
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@control_msgs//:ament_package",
        "@geometry_msgs//:ament_package",
        "@moveit_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@shape_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@trajectory_msgs//:ament_package",
    ],
)
