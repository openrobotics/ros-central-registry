load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

py_library(
    name = "pymoveit2",
    srcs = glob(["pymoveit2/**/*.py"]),
    imports = ["."],
    deps = [
        "@action_msgs//:py",
        "@control_msgs//:py",
        "@geometry_msgs//:py",
        "@moveit_msgs//:py",
        "@rclpy",
        "@sensor_msgs//:py",
        "@shape_msgs//:py",
        "@std_msgs//:py",
        "@std_srvs//:py",
        "@trajectory_msgs//:py",
    ],
)

pkg_files(
    name = "example_assets",
    srcs = glob(["examples/assets/**"]),
    prefix = "lib/pymoveit2/assets",
    strip_prefix = strip_prefix.from_pkg("examples/assets"),
)

py_pytest(
    name = "pymoveit2_tests",
    srcs = [
        "test/test_core_regressions.py",
        "test/test_debian_package.py",
        "test/test_diagnostics.py",
        "test/test_docker_helpers.py",
        "test/test_docs_shape.py",
        "test/test_example_processes.py",
        "test/test_example_robot_config.py",
        "test/test_examples_parity.py",
        "test/test_execution_lifecycle.py",
        "test/test_execution_state.py",
        "test/test_failure_reporting.py",
        "test/test_future_waits.py",
        "test/test_gripper.py",
        "test/test_import.py",
        "test/test_mesh.py",
        "test/test_moveit2_construction.py",
        "test/test_no_deprecated_api.py",
        "test/test_planning_scene.py",
        "test/test_python_packaging.py",
        "test/test_requests.py",
        "test/test_robot_description.py",
        "test/test_robot_presets.py",
        "test/test_scene_client.py",
        "test/test_servo.py",
        "test/test_session.py",
        "test/test_test_runner.py",
        "test/test_validation.py",
    ],
    data = glob(
        [
            "CMakeLists.txt",
            "README.md",
            "docker/**",
            "docs/**",
            "examples/**",
            "package.xml",
            "test/**",
        ],
        allow_empty = True,
    ),
    tags = ["manual"],
    deps = [
        ":pymoveit2",
    ],
)

ament_package(
    name = "ament_package",
    executables = glob(["examples/ex_*.py"]),
    install = [":example_assets"],
    package_xml = "package.xml",
    python = [":pymoveit2"],
    deps = [
        "@action_msgs//:ament_package",
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@control_msgs//:ament_package",
        "@geometry_msgs//:ament_package",
        "@moveit_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@shape_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@trajectory_msgs//:ament_package",
    ],
)
