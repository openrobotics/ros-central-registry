load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

# Data-only package: upstream installs params/ and clips/ under share/.
ament_index(
    name = "ament_index",
    data = [
        "clips/hello_world.clp",
        "clips/tf2_tracked_pose.clp",
        "clips/turtlesim_monitor.clp",
        "clips/turtlesim_teleport.clp",
        "params/hello_world.yaml",
        "params/tf2_tracked_pose.yaml",
        "params/turtlesim.yaml",
    ],
    package_xml = "package.xml",
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cx_bringup//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
