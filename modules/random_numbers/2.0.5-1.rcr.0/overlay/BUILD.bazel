load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.math",
    "@rosdistro//cc:boost.smart_ptr",
    "@rosdistro//cc:boost.thread",
]

cc_library(
    name = "random_numbers_library",
    srcs = ["src/random_numbers.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    includes = [
        "include",
        "include/random_numbers",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "random_numbers",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":random_numbers_library"],
)

pkg_files(
    name = "pkg_files_cmake_0",
    srcs = ["ConfigExtras.cmake"],
    prefix = "share/random_numbers/cmake",
)

ament_index(
    name = "ament_index",
    libraries = [":random_numbers"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_cmake//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_random_numbers",
    cmake_extras = ["ConfigExtras.cmake"],
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    install = [":pkg_files_cmake_0"],
    libraries = [":random_numbers"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_cmake//:ament_package",
    ],
)
