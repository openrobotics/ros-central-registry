load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rosdistro//cc:boost.chrono_shared": "@rosdistro//cc:boost.chrono",
    "@rosdistro//cc:boost.container_shared": "@rosdistro//cc:boost.container",
    "@rosdistro//cc:boost.thread_shared": "@rosdistro//cc:boost.thread",
}

CC_DEPS = [
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.math",
    "@rosdistro//cc:boost.smart_ptr",
]

cc_library(
    name = "random_numbers_library",
    srcs = ["src/random_numbers.cpp"],
    hdrs = ["include/random_numbers/random_numbers.h"],
    includes = [
        "include",
        "include/random_numbers",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "random_numbers",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":random_numbers_library"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":random_numbers",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_cmake//:ament_package",
    ],
)

ament_package(
    cmake = [
        "ConfigExtras.cmake",
    ],
    cmake_export_dependencies = False,
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_random_numbers",
    cmake_extras = ["ConfigExtras.cmake"],
    cmake_strip_prefix = "",
    headers = ["include/random_numbers/random_numbers.h"],
    include_prefix = "",
    libraries = [
        ":random_numbers",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_cmake//:ament_package",
    ],
)
