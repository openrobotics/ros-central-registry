load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@ffmpeg_encoder_decoder//:ffmpeg_encoder_decoder": "@ffmpeg_encoder_decoder//:ffmpeg_encoder_decoder_library",
    "@ffmpeg_image_transport_msgs//:cc_shared": "@ffmpeg_image_transport_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "bag_to_file",
    srcs = [
        "include/ffmpeg_image_transport_tools/bag_processor.hpp",
        "include/ffmpeg_image_transport_tools/frame_info.hpp",
        "include/ffmpeg_image_transport_tools/message_processor.hpp",
        "src/bag_to_file.cpp",
        "test/test_utils.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/ffmpeg_image_transport_tools",
    ],
    local_defines = ros_local_defines() + [
        "USE_CV_BRIDGE_HPP",
        "USE_NEW_ROSBAG_WRITE_INTERFACE",
        "USE_ROSBAG2_STORAGE_RECV_TIME",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "bag_to_frames",
    srcs = [
        "include/ffmpeg_image_transport_tools/bag_processor.hpp",
        "include/ffmpeg_image_transport_tools/frame_info.hpp",
        "include/ffmpeg_image_transport_tools/message_processor.hpp",
