ament_index(
    name = "ament_index",
    lib_data = [
        ":bag_to_file",
        ":bag_to_frames",
        ":compress_bag",
        ":uncompress_bag",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_black//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@ffmpeg_encoder_decoder//:ament_package",
        "@ffmpeg_image_transport_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rcutils//:ament_package",
        "@ros_environment//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)

cc_test(
    name = "ffmpeg_image_transport_tools_test",
    srcs = [
        "include/ffmpeg_image_transport_tools/bag_processor.hpp",
        "include/ffmpeg_image_transport_tools/frame_info.hpp",
        "include/ffmpeg_image_transport_tools/message_processor.hpp",
        "test/test_1.cpp",
        "test/test_utils.cpp",
        "test/test_utils.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/ffmpeg_image_transport_tools",
    ],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "USE_CV_BRIDGE_HPP",
        "USE_NEW_ROSBAG_WRITE_INTERFACE",
        "USE_ROSBAG2_STORAGE_RECV_TIME",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_black//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@ffmpeg_encoder_decoder//:ament_package",
        "@ffmpeg_image_transport_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rcutils//:ament_package",
        "@ros_environment//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
