cc_binary(
    name = "uncompress_bag",
    srcs = [
        "include/ffmpeg_image_transport_tools/bag_processor.hpp",
        "include/ffmpeg_image_transport_tools/frame_info.hpp",
        "include/ffmpeg_image_transport_tools/message_processor.hpp",
        "src/uncompress_bag.cpp",
