load("@qt//:qt.bzl", "qt_cc_binary", "qt_cc_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

DATA = [
    "images/ardent.png",
    "images/bouncy.png",
    "images/crystal.png",
    "images/dashing.png",
    "images/eloquent.png",
    "images/foxy.png",
    "images/galactic.png",
    "images/humble.png",
    "images/iron.png",
    "images/jazzy.png",
    "images/kilted.png",
    "images/lyrical.png",
    "images/rolling.png",
] + ["//launch:launch_files"]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index_data",
    data = DATA,
)

# Full index: executables in lib/turtlesim plus the data above. Split so the
# executables (which need the data index at runtime) do not depend on themselves.
ament_index(
    name = "ament_index",
    lib_data = [
        ":draw_square",
        ":mimic",
        ":turtle_teleop_key",
        ":turtlesim_node",
    ],
    deps = [":ament_index_data"],
)

qt_cc_library(
    name = "turtlesim_lib",
    srcs = [
        "src/turtle.cpp",
        "src/turtle_frame.cpp",
    ],
    hdrs = [
        "include/turtlesim/qos.hpp",
        "include/turtlesim/turtle.hpp",
        "include/turtlesim/turtle_frame.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@geometry_msgs//:cc",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtbase//:widgets",
        "@std_srvs//:cc",
        "@turtlesim_msgs//:cc",
    ],
)

qt_cc_binary(
    name = "turtlesim_node",
    srcs = [
        "include/turtlesim/qos.hpp",
        "include/turtlesim/turtle.hpp",
        "include/turtlesim/turtle_frame.hpp",
    ] + ["src/turtlesim.cpp"],
    data = [":ament_index_data"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["include"],
    deps = DEPENDENCIES.values() + [":turtlesim_lib"] + [
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtbase//:widgets",
    ],
)

cc_binary(
    name = "turtle_teleop_key",
    srcs = [
        "include/turtlesim/qos.hpp",
        "include/turtlesim/turtle.hpp",
        "include/turtlesim/turtle_frame.hpp",
    ] + ["tutorials/teleop_turtle_key.cpp"],
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:widgets_shared",
    ],
    includes = ["include"],
    deps = DEPENDENCIES.values() + [
        "@geometry_msgs//:cc",
        "@turtlesim_msgs//:cc",
    ],
)

cc_binary(
    name = "draw_square",
    srcs = [
        "include/turtlesim/qos.hpp",
        "include/turtlesim/turtle.hpp",
        "include/turtlesim/turtle_frame.hpp",
    ] + ["tutorials/draw_square.cpp"],
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:widgets_shared",
    ],
    includes = ["include"],
    deps = DEPENDENCIES.values() + [
        "@geometry_msgs//:cc",
        "@std_srvs//:cc",
        "@turtlesim_msgs//:cc",
    ],
)

cc_binary(
    name = "mimic",
    srcs = [
        "include/turtlesim/qos.hpp",
        "include/turtlesim/turtle.hpp",
        "include/turtlesim/turtle_frame.hpp",
    ] + ["tutorials/mimic.cpp"],
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:widgets_shared",
    ],
    includes = ["include"],
    deps = DEPENDENCIES.values() + [
        "@geometry_msgs//:cc",
        "@turtlesim_msgs//:cc",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    executables = [
        ":turtlesim_node",
        ":turtle_teleop_key",
        ":draw_square",
        ":mimic",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@turtlesim_msgs//:ament_package",
    ],
)
