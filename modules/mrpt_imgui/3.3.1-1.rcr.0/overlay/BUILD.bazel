load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@mrpt_opengl//:mrpt_opengl_library",
]

cc_library(
    name = "mrpt_imgui_library",
    srcs = [":gen_mrpt_imgui_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":gen_extra_1"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_imgui",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mrpt_imgui_library"],
)

write_file(
    name = "gen_mrpt_imgui_stub_cpp",
    out = "_gen/mrpt_imgui_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

write_file(
    name = "gen_extra_1",
    out = "_gen/include/mrpt/imgui/config.h",
    content = ["/* +---------------------------------------------------------------------------+\n   |                     Mobile Robot Programming Toolkit (MRPT)               |\n   |                          https://www.mrpt.org/                            |\n   |                                                                           |\n   | Copyright (c) 2005-2026, Individual contributors, see AUTHORS file        |\n   | See: https://www.mrpt.org/Authors - All rights reserved.                  |\n   | Released under BSD License. See details in https://www.mrpt.org/License   |\n   +---------------------------------------------------------------------------+\n */\n\n#pragma once\n\n// clang-format off\n\n// clang-format on\n"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_imgui",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_imgui": [
            "libmrpt_imgui.so.3.3",
            "libmrpt_imgui.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_opengl//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        ":gen_extra_1",
    ] + glob(["include/**"]),
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mrpt_imgui",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_imgui": [
            "libmrpt_imgui.so.3.3",
            "libmrpt_imgui.so.3.3.1",
        ],
    },
    deps = [":ament_index"] + [
        "@mrpt_opengl//:ament_package",
    ],
)
