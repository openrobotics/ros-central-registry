load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@mrpt_opengl//:mrpt_opengl_library",
]

cc_library(
    name = "mrpt_imgui_library",
    srcs = [
        "include/mrpt/imgui/CImGuiSceneView.h",
        "src/CImGuiSceneView.cpp",
    ],
    hdrs = ["include/mrpt/imgui/CImGuiSceneView.h"] + [":config_h"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_imgui",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mrpt_imgui_library"],
)

expand_template(
    name = "config_h",
    out = "_gen/include/mrpt/imgui/config.h",
    substitutions = {
    },
    template = "config.h.in",
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_imgui",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_imgui": [
            "libmrpt_imgui.so.3.3",
            "libmrpt_imgui.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_opengl//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        ":config_h",
    ] + ["include/mrpt/imgui/CImGuiSceneView.h"],
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mrpt_imgui",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_imgui": [
            "libmrpt_imgui.so.3.3",
            "libmrpt_imgui.so.3.3.1",
        ],
    },
    deps = [":ament_index"] + [
        "@mrpt_opengl//:ament_package",
    ],
)
