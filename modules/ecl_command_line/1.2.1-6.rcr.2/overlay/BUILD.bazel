load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

cc_library(
    name = "ecl_command_line",
    hdrs = [
        "include/ecl/command_line.hpp",
        "include/ecl/command_line/arg.hpp",
        "include/ecl/command_line/arg_exception.hpp",
        "include/ecl/command_line/cmd_line.hpp",
        "include/ecl/command_line/cmd_line_interface.hpp",
        "include/ecl/command_line/cmd_line_output.hpp",
        "include/ecl/command_line/constraint.hpp",
        "include/ecl/command_line/docbook_output.hpp",
        "include/ecl/command_line/help_visitor.hpp",
        "include/ecl/command_line/ignore_rest_visitor.hpp",
        "include/ecl/command_line/multi_arg.hpp",
        "include/ecl/command_line/multi_switch_arg.hpp",
        "include/ecl/command_line/optional_unlabeled_tracker.hpp",
        "include/ecl/command_line/std_output.hpp",
        "include/ecl/command_line/switch_arg.hpp",
        "include/ecl/command_line/unlabeled_multi_arg.hpp",
        "include/ecl/command_line/unlabeled_value_arg.hpp",
        "include/ecl/command_line/value_arg.hpp",
        "include/ecl/command_line/values_constraint.hpp",
        "include/ecl/command_line/version_visitor.hpp",
        "include/ecl/command_line/visitor.hpp",
        "include/ecl/command_line/xor_handler.hpp",
    ],
    includes = ["include"],
)

alias(
    name = "ecl_command_line_library",
    actual = ":ecl_command_line",
)

cc_binary(
    name = "demo_command_line",
    srcs = ["src/examples/command_line.cpp"],
    deps = [":ecl_command_line"],
)

ament_index(
    name = "ament_index",
    executables = [":demo_command_line"],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    executables = [":demo_command_line"],
    headers = [
        "include/ecl/command_line.hpp",
        "include/ecl/command_line/arg.hpp",
        "include/ecl/command_line/arg_exception.hpp",
        "include/ecl/command_line/cmd_line.hpp",
        "include/ecl/command_line/cmd_line_interface.hpp",
        "include/ecl/command_line/cmd_line_output.hpp",
        "include/ecl/command_line/constraint.hpp",
        "include/ecl/command_line/docbook_output.hpp",
        "include/ecl/command_line/help_visitor.hpp",
        "include/ecl/command_line/ignore_rest_visitor.hpp",
        "include/ecl/command_line/multi_arg.hpp",
        "include/ecl/command_line/multi_switch_arg.hpp",
        "include/ecl/command_line/optional_unlabeled_tracker.hpp",
        "include/ecl/command_line/std_output.hpp",
        "include/ecl/command_line/switch_arg.hpp",
        "include/ecl/command_line/unlabeled_multi_arg.hpp",
        "include/ecl/command_line/unlabeled_value_arg.hpp",
        "include/ecl/command_line/value_arg.hpp",
        "include/ecl/command_line/values_constraint.hpp",
        "include/ecl/command_line/version_visitor.hpp",
        "include/ecl/command_line/visitor.hpp",
        "include/ecl/command_line/xor_handler.hpp",
    ],
    include_prefix = "",
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ecl_build//:ament_package",
        "@ecl_license//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
