load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@ompl//:ompl": "@ompl//:ompl_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:boost.chrono_shared": "@rosdistro//cc:boost.chrono",
    "@rosdistro//cc:boost.container_shared": "@rosdistro//cc:boost.container",
    "@rosdistro//cc:boost.serialization_shared": "@rosdistro//cc:boost.serialization",
    "@rosdistro//cc:boost.thread_shared": "@rosdistro//cc:boost.thread",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@moveit_core//:moveit_collision_detection_library",
    "@moveit_core//:moveit_constraint_samplers_library",
    "@moveit_core//:moveit_exceptions_library",
    "@moveit_core//:moveit_kinematic_constraints_library",
    "@moveit_core//:moveit_planning_interface_library",
    "@moveit_core//:moveit_planning_scene_library",
    "@moveit_core//:moveit_robot_model_library",
    "@moveit_core//:moveit_robot_state_library",
    "@moveit_core//:moveit_robot_trajectory_library",
    "@moveit_core//:moveit_utils_library",
    "@moveit_msgs//:cc",
    "@moveit_ros_planning//:moveit_constraint_sampler_manager_loader_library",
    "@moveit_ros_planning//:moveit_planning_scene_monitor_library",
    "@moveit_ros_planning//:moveit_robot_model_loader_library",
    "@rosdistro//cc:boost.algorithm",
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.math",
    "@rosdistro//cc:eigen",
]

HEADERS = glob(["ompl_interface/include/**/*.h*"])

INCLUDES = ["ompl_interface/include"]

LOCAL_DEFINES = ros_local_defines() + [
    "NDEBUG",
    "_FILE_OFFSET_BITS=64",
]

COPTS = ["-Wno-missing-template-arg-list-after-template-kw"]

cc_library(
    name = "moveit_ompl_interface_library",
    srcs = [
        "ompl_interface/src/detail/constrained_goal_sampler.cpp",
        "ompl_interface/src/detail/constrained_sampler.cpp",
        "ompl_interface/src/detail/constraints_library.cpp",
        "ompl_interface/src/detail/goal_union.cpp",
        "ompl_interface/src/detail/ompl_constraints.cpp",
        "ompl_interface/src/detail/projection_evaluators.cpp",
        "ompl_interface/src/detail/state_validity_checker.cpp",
        "ompl_interface/src/detail/threadsafe_state_storage.cpp",
        "ompl_interface/src/model_based_planning_context.cpp",
        "ompl_interface/src/ompl_interface.cpp",
        "ompl_interface/src/parameterization/joint_space/constrained_planning_state_space.cpp",
        "ompl_interface/src/parameterization/joint_space/constrained_planning_state_space_factory.cpp",
        "ompl_interface/src/parameterization/joint_space/joint_model_state_space.cpp",
        "ompl_interface/src/parameterization/joint_space/joint_model_state_space_factory.cpp",
        "ompl_interface/src/parameterization/model_based_state_space.cpp",
        "ompl_interface/src/parameterization/model_based_state_space_factory.cpp",
        "ompl_interface/src/parameterization/work_space/pose_model_state_space.cpp",
        "ompl_interface/src/parameterization/work_space/pose_model_state_space_factory.cpp",
        "ompl_interface/src/planning_context_manager.cpp",
    ],
    hdrs = HEADERS,
    copts = COPTS,
    includes = INCLUDES,
    local_defines = LOCAL_DEFINES,
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "moveit_ompl_interface",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":moveit_ompl_interface_library"],
)

cc_library(
    name = "moveit_ompl_planner_plugin_library",
    srcs = ["ompl_interface/src/ompl_planner_manager.cpp"],
    copts = COPTS,
    local_defines = LOCAL_DEFINES,
    deps = DEPENDENCIES.values() + CC_DEPS + [":moveit_ompl_interface_library"],
    alwayslink = True,
)

cc_shared_library(
    name = "moveit_ompl_planner_plugin",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":moveit_ompl_planner_plugin_library"],
)

TEST_DEPENDENCIES = DEPENDENCIES

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "generate_state_database",
    srcs = ["ompl_interface/scripts/generate_state_database.cpp"],
    copts = COPTS,
    dynamic_deps = [":transitive_dynamic_deps"],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = LOCAL_DEFINES,
    deps = TEST_DEPENDENCIES.values() + CC_DEPS + [":moveit_ompl_interface_library"],
)

ament_index(
    name = "ament_index",
    lib_data = [
        ":generate_state_database",
    ],
    libraries = [
        ":moveit_ompl_interface",
        ":moveit_ompl_planner_plugin",
    ],
    package_xml = "package.xml",
    plugin_category = "moveit_core",
    plugins = ["ompl_interface_plugin_description.xml"],
    sonames = {
        "moveit_ompl_interface": ["libmoveit_ompl_interface.so.2.15.2"],
        "moveit_ompl_planner_plugin": ["libmoveit_ompl_planner_plugin.so.2.15.2"],
    },
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@moveit_common//:ament_package",
        "@moveit_core//:ament_package",
        "@moveit_msgs//:ament_package",
        "@moveit_resources_fanuc_moveit_config//:ament_package",
        "@moveit_resources_panda_moveit_config//:ament_package",
        "@moveit_resources_pr2_description//:ament_package",
        "@moveit_ros_planning//:ament_package",
        "@ompl//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@tf2_eigen//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

# test_ompl_constraints is disabled upstream (flaky), so it is not ported.
[
    cc_test(
        name = test,
        srcs = [
            "ompl_interface/test/%s.cpp" % test,
            "ompl_interface/test/load_test_robot.hpp",
        ],
        copts = COPTS,
        data = [
            ":ament_index",
        ],
        dynamic_deps = [":transitive_dynamic_deps"],
        local_defines = LOCAL_DEFINES + ["GTEST_HAS_PTHREAD=1"],
        deps = TEST_DEPENDENCIES.values() + CC_DEPS + [
            ":moveit_ompl_interface_library",
            "@moveit_core//:moveit_test_utils_library",
            "@rosdistro//cc:bazel_test_helper",
            "@rosdistro//cc:googletest",
        ],
    )
    for test in [
        "test_constrained_planning_state_space",
        "test_constrained_state_validity_checker",
        "test_planning_context_manager",
        "test_state_space",
        "test_state_validity_checker",
        "test_threadsafe_state_storage",
    ]
]

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "moveit_core",
        "ompl",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = HEADERS,
    headers_strip_prefix = "ompl_interface/include",
    include_prefix = "moveit_planners",
    libraries = [
        ":moveit_ompl_interface",
        ":moveit_ompl_planner_plugin",
    ],
    package_xml = "package.xml",
    sonames = {
        "moveit_ompl_interface": ["libmoveit_ompl_interface.so.2.15.2"],
        "moveit_ompl_planner_plugin": ["libmoveit_ompl_planner_plugin.so.2.15.2"],
    },
    deps = [":ament_index"],
)
