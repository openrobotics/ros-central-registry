    "@rosdistro//cc:pcl_octree",
    "@rosdistro//cc:pcl_outofcore",
    "@rosdistro//cc:pcl_people",
    "@rosdistro//cc:pcl_recognition",
    "@rosdistro//cc:pcl_registration",
    "@rosdistro//cc:pcl_sample_consensus",
    "@rosdistro//cc:pcl_search",
    "@rosdistro//cc:pcl_segmentation",
    "@rosdistro//cc:pcl_surface",
    "@rosdistro//cc:pcl_tracking",
    "@rosdistro//cc:pcl_visualization",
]

cc_library(
    name = "dummy_localizer_library",
    srcs = ["src/easynav_localizer/DummyLocalizer.cpp"],
    hdrs = [
        "include/easynav_localizer/DummyLocalizer.hpp",
        "include/easynav_localizer/LocalizerNode.hpp",
    ],
    includes = [
        "include",
        "include/easynav_localizer",
        "tests",
    ],
    local_defines = ros_local_defines() + [
        "EASYNAV_DEBUG_WITH_YAETS",
        "GLAD_API_CALL_EXPORT",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "dummy_localizer",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":dummy_localizer_library"],
)

cc_library(
    name = "easynav_localizer_library",
    srcs = ["src/easynav_localizer/LocalizerNode.cpp"],
    hdrs = [
        "include/easynav_localizer/DummyLocalizer.hpp",
        "include/easynav_localizer/LocalizerNode.hpp",
    ],
    includes = [
        "include",
        "include/easynav_localizer",
        "tests",
    ],
    local_defines = ros_local_defines() + [
        "EASYNAV_DEBUG_WITH_YAETS",
        "GLAD_API_CALL_EXPORT",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "easynav_localizer",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":easynav_localizer_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":dummy_localizer",
        ":easynav_localizer",
    ],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":dummy_localizer",
        ":easynav_localizer",
    ],
    package_xml = "package.xml",
    plugin_category = "easynav_core",
    plugins = ["easynav_localizer_plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@easynav_common//:ament_package",
        "@easynav_core//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "easynav_common",
        "easynav_core",
        "lifecycle_msgs",
        "nav_msgs",
        "pluginlib",
        "rclcpp",
        "rclcpp_lifecycle",
    ],
    cmake_export_name = "export_easynav_localizer",
    headers = [
        "include/easynav_localizer/DummyLocalizer.hpp",
        "include/easynav_localizer/LocalizerNode.hpp",
    ],
    libraries = [
        ":dummy_localizer",
        ":easynav_localizer",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@easynav_common//:ament_package",
        "@easynav_core//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
    ],
)
