load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = [
        "demos/fake_sensor_publisher.py",
        "mola-cli-launchs/euroc_stereo_just_replay.yaml",
        "mola-cli-launchs/image_directory_just_replay.yaml",
        "mola-cli-launchs/kitti360_just_replay.yaml",
        "mola-cli-launchs/kitti_just_replay.yaml",
        "mola-cli-launchs/kitti_just_replay_to_ros2.yaml",
        "mola-cli-launchs/lidar_bin_directory_just_replay.yaml",
        "mola-cli-launchs/live_velodyne_just_view.yaml",
        "mola-cli-launchs/mulran_just_replay.yaml",
        "mola-cli-launchs/mulran_just_replay_to_ros2.yaml",
        "mola-cli-launchs/paris_luco_just_replay.yaml",
        "mola-cli-launchs/rawlog_just_replay.yaml",
        "mola-cli-launchs/ros2_ouster_just_view.yaml",
        "mola-cli-launchs/rosbag2_pointcloud_just_view.yaml",
        "mola-cli-launchs/video_camera_source_just_replay.yaml",
        "mola-cli-launchs/video_file_source_just_replay.yaml",
        "mola-cli-launchs/work-in-progress/euroc_monocular.yml",
        "mola-cli-launchs/work-in-progress/euroc_stereo.yml",
        "mola-cli-launchs/work-in-progress/kitti_monocular.yml",
        "mola-cli-launchs/work-in-progress/kitti_stereo.yml",
        "mola-cli-launchs/work-in-progress/pose_graph_g2o_file.yaml",
        "mola-cli-launchs/work-in-progress/rawlog_odom_and_lidar.yaml",
        "ros2-launchs/ros-kitti-play.launch.py",
        "ros2-launchs/ros-mulran-pf-localization.launch.py",
        "ros2-launchs/ros-mulran-play.launch.py",
        "ros2-params/mrpt-pf.yaml",
        "ros2-params/point-cloud-pipeline.yaml",
        "rviz2/kitti.rviz",
        "rviz2/mulran.rviz",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_pep257//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ros_environment//:ament_package",
        "@rosdistro//:ament_package",
    ],
)

launch_ros_binary(
    name = "ros2_launchs_ros_kitti_play_launch_py",
    src = "ros2-launchs/ros-kitti-play.launch.py",
    data = [
        "@mola_launcher//:ament_index",
        "@rviz2//:ament_index",
    ],
)

launch_ros_binary(
    name = "ros2_launchs_ros_mulran_pf_localization_launch_py",
    src = "ros2-launchs/ros-mulran-pf-localization.launch.py",
    data = [
        ":ros2_launchs_ros_mulran_play_launch_py",
        "@mrpt_map_server//:ament_package",
        "@mrpt_map_server//:launch_mrpt_map_server_launch_py",
        "@mrpt_pf_localization//:ament_package",
        "@mrpt_pf_localization//:launch_localization_launch_py",
        "@mrpt_pointcloud_pipeline//:ament_package",
        "@mrpt_pointcloud_pipeline//:launch_pointcloud_pipeline_launch_py",
    ],
)

launch_ros_binary(
    name = "ros2_launchs_ros_mulran_play_launch_py",
    src = "ros2-launchs/ros-mulran-play.launch.py",
    data = [
        "@mola_launcher//:ament_index",
        "@rviz2//:ament_index",
    ],
)
