    "@qtbase//:test",
    "@qtbase//:widgets",
    "@qtdeclarative//:qml",
    "@qtdeclarative//:quick",
    "@qtmultimedia//:multimedia",
    "@qtsvg//:svg",
]

exports_files([
    "common.hpp",
    "communication.cpp",
    "image_conversions.cpp",
    "image_transport_subscriber.cpp",
    "io.cpp",
    "logging.cpp",
    "message_comparison.hpp",
    "message_conversions.cpp",
    "ros_life_cycle.cpp",
    "test_io/test.yaml",
])

cc_library(
    name = "test_helpers",
    testonly = True,
    hdrs = [
        "common.hpp",
        "message_comparison.hpp",
    ],
    includes = ["."],
    visibility = ["//visibility:private"],
)

qt_cc_test(
    name = "test_communication",
    srcs = ["communication.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + ["test_io/test.yaml"],
    defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "RCLCPP_VERSION_MAJOR=32",
    ],
    dynamic_deps = [
        "//:transitive_dynamic_deps",
    ],
    includes = ["."],
    moc_hdrs = [],
    moc_srcs = ["communication.cpp"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":test_helpers",
        "//:qml_ros2_plugin_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

