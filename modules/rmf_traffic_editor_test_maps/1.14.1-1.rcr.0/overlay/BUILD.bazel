load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

_OUT = "_gen/share/rmf_traffic_editor_test_maps/maps/door_madness"

_MESHES = _OUT + "/models/building_L1/meshes"

# Mirrors the CMakeLists.txt foreach() over maps/*.building.yaml:
#   ros2 run rmf_building_map_tools building_map_generator gazebo \
#       <map> <out>/<world>.world <out>/models
genrule(
    name = "door_madness_world",
    srcs = ["maps/door_madness/door_madness.building.yaml"],
    outs = [
        _OUT + "/door_madness.world",
        _OUT + "/models/building_L1/model.config",
        _OUT + "/models/building_L1/model.sdf",
        _MESHES + "/blue_linoleum.png",
        _MESHES + "/default.png",
        _MESHES + "/floor_1.mtl",
        _MESHES + "/floor_1.obj",
        _MESHES + "/model.material",
        _MESHES + "/wall_1.mtl",
        _MESHES + "/wall_1.obj",
    ],
    cmd = "$(location @rmf_building_map_tools//:building_map_generator_tool) building_map_generator gazebo " +
          "$(location maps/door_madness/door_madness.building.yaml) " +
          "$(RULEDIR)/" + _OUT + "/door_madness.world " +
          "$(RULEDIR)/" + _OUT + "/models > /dev/null",
    tools = ["@rmf_building_map_tools//:building_map_generator_tool"],
)

ament_index(
    name = "ament_index",
    data = [
        "maps/door_madness/door_madness.building.yaml",
        "maps/door_madness/door_madness.project.yaml",
        ":door_madness_world",
    ],
    data_strip_prefix = "maps",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@rmf_building_map_tools//:ament_package",
        "@ros2run//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@rmf_building_map_tools//:ament_package",
        "@ros2run//:ament_package",
    ],
)
