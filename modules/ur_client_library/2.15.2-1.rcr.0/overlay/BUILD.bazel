### PACKAGING

PACKAGING_HEADERS = glob(
    [
        "include/**/*.h",
        "include/**/*.hpp",
        "include/**/*.md",
        "include/**/.*",
    ],
    allow_empty = True,
)

ament_package(
    name = "ament_package",
    build_type = "cmake",
    data = glob(["resources/**"]),
    env_hooks = [
        "hook/ament_prefix_path.dsv",
        "hook/ros_package_path.dsv",
    ],
    executables = [
        "scripts/start_ursim.sh",
        "scripts/tool_communication.py",
    ],
    headers = PACKAGING_HEADERS,
    include_prefix = "",
    libraries = [
        ":urcl",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
