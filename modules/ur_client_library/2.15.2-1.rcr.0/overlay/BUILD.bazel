### PACKAGING

# Define all headers for the package, which includes both original globbed headers
# and the generated compile_options.h header.
PACKAGING_HEADERS = glob(
    [
        "include/**/*.h",
        "include/**/*.hpp",
    ],
    allow_empty = True,
) + [":compile_options_h"]

ament_package(
    name = "ament_package",
    headers = PACKAGING_HEADERS,
    libraries = [":urcl"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
