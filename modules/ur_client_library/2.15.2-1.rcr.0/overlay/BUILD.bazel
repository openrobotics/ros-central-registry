load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PREPROCESSING

cmake_configure_file(
    name = "compile_options_h",
    src = "src/compile_options.h.in",
    out = "include/ur_client_library/compile_options.h",
    defines = [
        "PRIMARY_CLIENT_STRICT_PARSING_=0",
    ],
)

### LIBRARIES

HEADERS = glob(
    [
        "include/**/*.h",
        "include/**/*.hpp",
    ],
    allow_empty = True,
) + [":compile_options_h"]

cc_library(
    name = "urcl_library",
    srcs = glob(
        ["src/**/*.cpp"],
        allow_empty = True,
    ) + glob(
        [
            "3rdparty/**/*.h",
            "3rdparty/**/*.hpp",
        ],
        allow_empty = True,
    ),
    hdrs = HEADERS,
    copts = [
        "-Wall",
        "-pedantic",
        "-Wno-maybe-uninitialized",
    ],
    includes = [
        "3rdparty",
        "include",
    ],
    linkopts = ["-lpthread"],
    deps = [],
)

cc_shared_library(
    name = "urcl",
    exports_filter = [":urcl_library"],
    deps = [":urcl_library"],
)

