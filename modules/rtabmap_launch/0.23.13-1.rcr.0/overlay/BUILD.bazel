load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "launch/config/rgbd.rviz",
        "launch/rtabmap.launch.py",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@rtabmap_msgs//:ament_package",
        "@rtabmap_odom//:ament_package",
        "@rtabmap_rviz_plugins//:ament_package",
        "@rtabmap_slam//:ament_package",
        "@rtabmap_util//:ament_package",
        "@rtabmap_viz//:ament_package",
    ],
)

launch_ros_binary(
    name = "rtabmap.launch.py",
    src = "launch/rtabmap.launch.py",
    data = [":ament_index"],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@rtabmap_msgs//:ament_package",
        "@rtabmap_odom//:ament_package",
        "@rtabmap_rviz_plugins//:ament_package",
        "@rtabmap_slam//:ament_package",
        "@rtabmap_util//:ament_package",
        "@rtabmap_viz//:ament_package",
    ],
)
