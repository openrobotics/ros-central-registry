load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "config/rgbd.rviz",
        "rtabmap.launch.py",
    ],
)

launch_ros_binary(
    name = "rtabmap_launch",
    src = "rtabmap.launch.py",
    data = [
        "//:ament_index",
        "@image_transport//:ament_index_package",
        "@image_transport//:ament_index_plugin",
        "@image_transport//:republish",
        "@rtabmap_odom//:ament_index",
        "@rtabmap_odom//:icp_odometry",
        "@rtabmap_odom//:rgbd_odometry",
        "@rtabmap_odom//:stereo_odometry",
        "@rtabmap_slam//:ament_index",
        "@rtabmap_slam//:rtabmap",
        "@rtabmap_sync//:ament_index",
        "@rtabmap_sync//:rgbd_sync",
        "@rtabmap_sync//:stereo_sync",
        "@rtabmap_util//:ament_index",
        "@rtabmap_util//:point_cloud_xyzrgb",
        "@rtabmap_util//:rgbd_relay",
        "@rtabmap_viz",
        "@rtabmap_viz//:ament_index",
        "@rviz2",
        "@rviz2//:ament_index",
    ],
    deps = ["@ament_index_python"],
)
