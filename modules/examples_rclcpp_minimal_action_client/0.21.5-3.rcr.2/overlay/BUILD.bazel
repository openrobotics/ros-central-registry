load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

EXECUTABLES = {
    "action_client_member_functions": "member_functions.cpp",
    "action_client_not_composable": "not_composable.cpp",
    "action_client_not_composable_with_cancel": "not_composable_with_cancel.cpp",
    "action_client_not_composable_with_feedback": "not_composable_with_feedback.cpp",
}

[
    cc_binary(
        name = name,
        srcs = [src],
        dynamic_deps = [":transitive_dynamic_deps"],
        local_defines = ros_local_defines(),
        deps = DEPENDENCIES.values() + [
            "@example_interfaces//:cc",
        ],
    )
    for name, src in EXECUTABLES.items()
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    executables = [":{0}".format(e) for e in EXECUTABLES.keys()],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@example_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
