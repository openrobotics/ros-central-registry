load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### DATA

ament_index(
    name = "ament_index",
    data = ["plugin.xml"],
    package_xml = "package.xml",
    deps = ["@rqt_gui//:ament_index"],
)

### LIBRARIES

py_library(
    name = "rqt_gui_py",
    srcs = [
        "src/rqt_gui_py/__init__.py",
        "src/rqt_gui_py/plugin.py",
        "src/rqt_gui_py/rclpy_spinner.py",
        "src/rqt_gui_py/ros_py_plugin_provider.py",
    ],
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@python_qt_binding",
        "@qt_gui",
        "@rclpy",
        "@rqt_gui",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":rqt_gui_py"],
    python_strip_prefix = "src",
    setup_cfg = "setup.cfg",
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@python_qt_binding//:ament_package",
        "@qt_gui//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_gui//:ament_package",
    ],
)
