load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/rclc/action_client.h",
        "include/rclc/action_goal_handle.h",
        "include/rclc/action_server.h",
        "include/rclc/client.h",
        "include/rclc/executor.h",
        "include/rclc/executor_handle.h",
        "include/rclc/init.h",
        "include/rclc/node.h",
        "include/rclc/publisher.h",
        "include/rclc/rclc.h",
        "include/rclc/service.h",
        "include/rclc/sleep.h",
        "include/rclc/subscription.h",
        "include/rclc/timer.h",
        "include/rclc/types.h",
        "include/rclc/visibility_control.h",
        "src/rclc/action_client_internal.h",
        "src/rclc/action_generic_types.h",
        "src/rclc/action_goal_handle_internal.h",
        "src/rclc/action_server_internal.h",
        "src/rclc/rcl_wait_set_is_valid_backport.h",
    ],
    includes = ["src/rcl"],
)

PUBLIC_HEADERS = [
    "include/rclc/action_client.h",
    "include/rclc/action_goal_handle.h",
    "include/rclc/action_server.h",
    "include/rclc/client.h",
    "include/rclc/executor.h",
    "include/rclc/executor_handle.h",
    "include/rclc/init.h",
    "include/rclc/node.h",
    "include/rclc/publisher.h",
    "include/rclc/rclc.h",
    "include/rclc/service.h",
    "include/rclc/sleep.h",
    "include/rclc/subscription.h",
    "include/rclc/timer.h",
    "include/rclc/types.h",
    "include/rclc/visibility_control.h",
]

HEADERS = PUBLIC_HEADERS + [
    "src/rclc/action_client_internal.h",
    "src/rclc/action_generic_types.h",
    "src/rclc/action_goal_handle_internal.h",
    "src/rclc/action_server_internal.h",
    "src/rclc/rcl_wait_set_is_valid_backport.h",
]

DEPENDENCIES = {
    "@rcl//:rcl": "@rcl//:rcl_library",
    "@rcl_action//:rcl_action": "@rcl_action//:rcl_action_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

cc_library(
    name = "rclc_library",
    srcs = [
        "src/rclc/action_client.c",
        "src/rclc/action_goal_handle.c",
        "src/rclc/action_server.c",
        "src/rclc/client.c",
        "src/rclc/executor.c",
        "src/rclc/executor_handle.c",
        "src/rclc/init.c",
        "src/rclc/node.c",
        "src/rclc/publisher.c",
        "src/rclc/service.c",
        "src/rclc/sleep.c",
        "src/rclc/subscription.c",
        "src/rclc/timer.c",
    ],
    hdrs = HEADERS,
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rclc",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rclc_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rclc"],
)

TEST_DEPENDENCIES = {
    ":rclc": ":rclc_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_test",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "ament_cmake",
        "rcl",
        "rcl_action",
        "rcutils",
        "rosidl_generator_c",
    ],
    headers = PUBLIC_HEADERS,
    include_prefix = "",
    libraries = [":rclc"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@example_interfaces//:ament_package",
        "@launch_testing//:ament_package",
        "@osrf_testing_tools_cpp//:ament_package",
        "@rcl//:ament_package",
        "@rcl_action//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_generator_c//:ament_package",
        "@rosidl_typesupport_c//:ament_package",
        "@std_msgs//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
