load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

TEST_DEPENDENCIES = {
    "//:rclc": "//:rclc_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
}

cc_test(
    name = "rclc_test",
    srcs = [
        "rclc/test_action_client.cpp",
        "rclc/test_action_server.cpp",
        "rclc/test_client.cpp",
        "rclc/test_executor.cpp",
        "rclc/test_executor_handle.cpp",
        "rclc/test_init.cpp",
        "rclc/test_node.cpp",
        "rclc/test_publisher.cpp",
        "rclc/test_service.cpp",
        "rclc/test_subscription.cpp",
        "rclc/test_timer.cpp",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps_test"],
    local_defines = ros_local_defines(),
    deps = TEST_DEPENDENCIES.values() + [
        "@example_interfaces//:c",
        "@example_interfaces//:cc",
        "@osrf_testing_tools_cpp//:memory_tools",
        "@rosdistro//cc:googletest",
        "@std_msgs//:c",
        "@test_msgs//:c",
        "@test_msgs//:cc",
    ] + ["//:_test_root_headers"],
)
