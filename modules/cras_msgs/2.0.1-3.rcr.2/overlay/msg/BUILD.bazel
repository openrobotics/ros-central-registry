load("@rosidl_default_generators//:defs.bzl", "ros_message")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.msg"]))

ros_message(
    name = "Brightness",
    src = "Brightness.msg",
)

ros_message(
    name = "BrightnessStamped",
    src = "BrightnessStamped.msg",
    deps = [
        ":Brightness",
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "ColorRGBAStamped",
    src = "ColorRGBAStamped.msg",
    deps = [
        "@std_msgs//msg:ColorRGBA",
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "ElectricCurrent",
    src = "ElectricCurrent.msg",
)

ros_message(
    name = "ElectricCurrentStamped",
    src = "ElectricCurrentStamped.msg",
    deps = [
        "//msg_ros2/msg:ElectricCurrentMeasurement",
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "Heartbeat",
    src = "Heartbeat.msg",
    deps = [
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "Power",
    src = "Power.msg",
)

ros_message(
    name = "PowerStamped",
    src = "PowerStamped.msg",
    deps = [
        "//msg_ros2/msg:PowerMeasurement",
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "PowerSwitchState",
    src = "PowerSwitchState.msg",
)

ros_message(
    name = "PowerSwitchStateStamped",
    src = "PowerSwitchStateStamped.msg",
    deps = [
        ":PowerSwitchState",
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "Voltage",
    src = "Voltage.msg",
)

ros_message(
    name = "VoltageStamped",
    src = "VoltageStamped.msg",
    deps = [
        "//msg_ros2/msg:VoltageMeasurement",
        "@std_msgs//msg:Header",
    ],
)
