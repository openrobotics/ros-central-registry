load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/rosbag2_storage/bag_metadata.hpp",
    "include/rosbag2_storage/default_storage_id.hpp",
    "include/rosbag2_storage/logging.hpp",
    "include/rosbag2_storage/message_definition.hpp",
    "include/rosbag2_storage/metadata_io.hpp",
    "include/rosbag2_storage/qos.hpp",
    "include/rosbag2_storage/ros_helper.hpp",
    "include/rosbag2_storage/serialized_bag_message.hpp",
    "include/rosbag2_storage/storage_factory.hpp",
    "include/rosbag2_storage/storage_factory_interface.hpp",
    "include/rosbag2_storage/storage_filter.hpp",
    "include/rosbag2_storage/storage_interfaces/base_info_interface.hpp",
    "include/rosbag2_storage/storage_interfaces/base_io_interface.hpp",
    "include/rosbag2_storage/storage_interfaces/base_read_interface.hpp",
    "include/rosbag2_storage/storage_interfaces/base_write_interface.hpp",
    "include/rosbag2_storage/storage_interfaces/read_only_interface.hpp",
    "include/rosbag2_storage/storage_interfaces/read_write_interface.hpp",
    "include/rosbag2_storage/storage_options.hpp",
    "include/rosbag2_storage/storage_traits.hpp",
    "include/rosbag2_storage/topic_metadata.hpp",
    "include/rosbag2_storage/visibility_control.hpp",
    "include/rosbag2_storage/yaml.hpp",
]

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

cc_library(
    name = "rosbag2_storage_library",
    srcs = [
        "src/rosbag2_storage/base_io_interface.cpp",
        "src/rosbag2_storage/default_storage_id.cpp",
        "src/rosbag2_storage/impl/storage_factory_impl.hpp",
        "src/rosbag2_storage/metadata_io.cpp",
        "src/rosbag2_storage/qos.cpp",
        "src/rosbag2_storage/ros_helper.cpp",
        "src/rosbag2_storage/storage_factory.cpp",
        "src/rosbag2_storage/storage_options.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rosbag2_storage",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rosbag2_storage_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rosbag2_storage"],
)

ament_index(
    name = "ament_index",
    libraries = ["//test:test_plugin"],
    package_xml = "package.xml",
    plugins = ["//test:rosbag2_storage/test_plugin.xml"],
)

TEST_DEPENDENCIES = DEPENDENCIES | {
    ":rosbag2_storage": ":rosbag2_storage_library",
    "//test:test_plugin": "//test:test_plugin_library",
    "@rosbag2_test_common": "@rosbag2_test_common//:rosbag2_test_common_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_test",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
)

ament_package(
    name = "ament_package",
    cmake_export_name = "export_rosbag2_storage",
    headers = HEADERS,
    libraries = [
        ":rosbag2_storage",
        "//test:test_plugin",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rosbag2_test_common//:ament_package",
        "@rosdistro//:ament_package",
        "@yaml_cpp_vendor//:ament_package",
    ],
)
