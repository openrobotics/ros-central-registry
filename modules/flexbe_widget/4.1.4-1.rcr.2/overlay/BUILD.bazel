load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "flexbe_widget",
    srcs = [
        "flexbe_widget/__init__.py",
        "flexbe_widget/behavior_action_server.py",
        "flexbe_widget/behavior_launcher.py",
        "flexbe_widget/evaluate_logs.py",
        "flexbe_widget/flexbe_status_listener.py",
    ],
    imports = ["."],
)

ament_index(
    name = "ament_index",
    data = ["//launch:launch_files"],
    executables = [
        "bin/be_action_server",
        "bin/be_launcher",
        "bin/create_repo",
        "bin/evaluate_logs",
        "bin/flexbe_status_listener",
    ],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    package_xml = "package.xml",
    python = [":flexbe_widget"],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@flexbe_core//:ament_package",
        "@flexbe_mirror//:ament_package",
        "@flexbe_msgs//:ament_package",
        "@flexbe_onboard//:ament_package",
        "@launch_ros//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
