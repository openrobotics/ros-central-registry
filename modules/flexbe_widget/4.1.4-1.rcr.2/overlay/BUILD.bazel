load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

py_library(
    name = "flexbe_widget",
    srcs = glob(["flexbe_widget/**/*.py"]),
    imports = ["."],
)

ament_index(
    name = "ament_index",
    data = glob(["launch/**"]),
    executables = glob(["bin/*"]),
    package_xml = "package.xml",
)

launch_ros_binary(
    name = "flexbe_action_server.launch.py",
    src = "launch/flexbe_action_server.launch.py",
    data = [":ament_index"],
    deps = [":flexbe_widget"],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    data = glob(["launch/**"]),
    executables = glob(["bin/*"]),
    package_xml = "package.xml",
    python = [":flexbe_widget"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@flexbe_core//:ament_package",
        "@flexbe_mirror//:ament_package",
        "@flexbe_msgs//:ament_package",
        "@flexbe_onboard//:ament_package",
        "@launch_ros//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
