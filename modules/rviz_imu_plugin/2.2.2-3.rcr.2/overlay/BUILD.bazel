load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@qt//:qt.bzl", "qt_cc_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### LIBRARIES

DEPENDENCIES = {
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:OgreMain": "@rosdistro//cc:OgreMain_library",
    "@rosdistro//cc:OgreOverlay": "@rosdistro//cc:OgreOverlay_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:curl": "@rosdistro//cc:curl_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rviz_common//:rviz_common": "@rviz_common//:rviz_common_library",
    "@rviz_rendering//:rviz_rendering": "@rviz_rendering//:rviz_rendering_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

qt_cc_library(
    name = "rviz_imu_plugin_library",
    srcs = [
        "src/imu_acc_visual.cpp",
        "src/imu_axes_visual.cpp",
        "src/imu_display.cpp",
        "src/imu_orientation_visual.cpp",
        "src/mag_display.cpp",
        "src/mag_visual.cpp",
    ],
    hdrs = [
        "src/imu_acc_visual.h",
        "src/imu_axes_visual.h",
        "src/imu_display.h",
        "src/imu_orientation_visual.h",
        "src/mag_display.h",
        "src/mag_visual.h",
    ],
    includes = ["src"],
    local_defines = ros_local_defines() + [
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "QT_NO_KEYWORDS",
    ],
    deps = DEPENDENCIES.values() + [
        "@qtbase//:widgets",
    ],
)

cc_shared_library(
    name = "rviz_imu_plugin",
    dynamic_deps = DEPENDENCIES.keys() + [
        "@qtbase//:widgets_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":rviz_imu_plugin_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":rviz_imu_plugin",
        "@sensor_msgs//:cc_shared",
    ],
    visibility = ["//visibility:private"],
)

ament_index(
    name = "ament_index",
    libraries = [":transitive_dynamic_deps"],
    package_xml = "package.xml",
    plugin_category = "rviz_common",
    plugins = ["plugin_description.xml"],
)

### PACKAGING

write_file(
    name = "include_dirs_extras",
    out = "cmake/ament_cmake_export_include_directories-extras.cmake",
    content = [
        "# generated from ament_cmake_export_include_directories/cmake/ament_cmake_export_include_directories-extras.cmake.in",
        "",
        "set(_exported_include_dirs \"${rviz_imu_plugin_DIR}/../../../include\")",
        "if(NOT _exported_include_dirs STREQUAL \"\")",
        "  find_package(ament_cmake_core QUIET REQUIRED)",
        "  foreach(_exported_include_dir ${_exported_include_dirs})",
        "    normalize_path(_exported_include_dir \"${_exported_include_dir}\")",
        "    list(APPEND rviz_imu_plugin_INCLUDE_DIRS \"${_exported_include_dir}\")",
        "  endforeach()",
        "endif()",
        "",
    ],
)

ament_package(
    name = "ament_package",
    cmake = [":include_dirs_extras"],
    cmake_export_dependencies_list = [
        "Qt6",
        "rviz_common",
        "sensor_msgs",
        "tf2",
        "tf2_ros",
    ],
    cmake_export_targets = False,
    cmake_extras = ["ament_cmake_export_include_directories-extras.cmake"],
    libraries = [":rviz_imu_plugin"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@message_filters//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_ogre_vendor//:ament_package",
        "@rviz_rendering//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
