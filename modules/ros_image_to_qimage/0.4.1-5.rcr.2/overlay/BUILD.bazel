load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
}

cc_library(
    name = "ros_image_to_qimage_library",
    srcs = ["src/ros_image_to_qimage.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@rules_qt//:qt_widgets",
        "@sensor_msgs//:cc",
    ],
)

cc_shared_library(
    name = "ros_image_to_qimage",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":ros_image_to_qimage_library"],
    deps = [":ros_image_to_qimage_library"],
)

### PYTHON MODULE

py_library(
    name = "ros_image_to_qimage_py",
    srcs = glob(["ros_image_to_qimage/**/*.py"]),
    imports = ["."],
    deps = [
        "@cv_bridge//:cv_bridge_py",
        "@python_qt_binding",
        "@sensor_msgs//:py",
    ],
)

### TESTS

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ros_image_to_qimage"],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_ros_image_to_qimage_cpp",
    srcs = ["test/test_ros_image_to_qimage.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":ros_image_to_qimage_library",
        "@rosdistro//cc:googletest",
    ],
)

# Tagged manual/xfail like cv_bridge's own python tests: the @pip_ros
# opencv-python wheel fails to import cv2 under @pip_ros NumPy 2.x, which
# breaks `from cv_bridge import CvBridge` at collection time.
py_pytest(
    name = "test_ros_image_to_qimage_py",
    srcs = ["test/test_ros_image_to_qimage.py"],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":ros_image_to_qimage_py"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "Qt5Widgets",
        "sensor_msgs",
        "cv_bridge",
        "python_qt_binding",
    ],
    cmake_export_targets = False,
    headers = HEADERS,
    include_prefix = "",
    libraries = [":ros_image_to_qimage"],
    package_xml = "package.xml",
    python = [":ros_image_to_qimage_py"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@python_qt_binding//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
