load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = ["include/ros_image_to_qimage/ros_image_to_qimage.hpp"]

DEPENDENCIES = {
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
}

cc_library(
    name = "ros_image_to_qimage_library",
    srcs = ["src/ros_image_to_qimage.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@qtbase//:widgets",
        "@sensor_msgs//:cc",
    ],
)

cc_shared_library(
    name = "ros_image_to_qimage",
    dynamic_deps = DEPENDENCIES.keys() + ["@qtbase//:widgets_shared"],
    exports_filter = ["//:__subpackages__"],
    deps = [":ros_image_to_qimage_library"],
)

py_library(
    name = "ros_image_to_qimage_py",
    srcs = [
        "ros_image_to_qimage/__init__.py",
        "ros_image_to_qimage/ros_image_to_qimage.py",
    ],
    imports = ["."],
    deps = [
        "@cv_bridge//:cv_bridge_py",
        "@python_qt_binding",
        "@sensor_msgs//:py",
    ],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ros_image_to_qimage"],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "Qt5Widgets",
        "cv_bridge",
        "python_qt_binding",
        "sensor_msgs",
    ],
    cmake_export_targets = False,
    headers = HEADERS,
    include_prefix = "",
    libraries = [":ros_image_to_qimage"],
    package_xml = "package.xml",
    python = [":ros_image_to_qimage_py"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@python_qt_binding//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
