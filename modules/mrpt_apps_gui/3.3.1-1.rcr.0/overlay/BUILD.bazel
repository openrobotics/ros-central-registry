        allow_empty = True,
    ) + [
        ":gen_gl_h",
        ":gen_glfw3_h",
        ":gen_glu_h",
        ":gen_ui_CBeaconConfig_h",
        ":gen_ui_CConfigWidget_h",
        ":gen_ui_CGasGridConfig_h",
        ":gen_ui_CGeneralConfig_h",
