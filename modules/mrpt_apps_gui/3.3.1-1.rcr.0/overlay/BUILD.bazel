cc_binary(
    name = "_bin/2d-slam-demo",
    srcs = [":gen_mrpt_apps_gui_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
