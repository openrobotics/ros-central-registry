load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rosdistro//cc:glfw": "@rosdistro//cc:glfw_library",
    "@rosdistro//cc:glu": "@rosdistro//cc:glu_library",
}

CC_DEPS = [
    "@rosdistro//cc:opengl_headers",
]

cc_library(
    name = "mrpt_imgui_vendor_library",
    srcs = [
        "3rdparty/imgui/backends/imgui_impl_glfw.cpp",
        "3rdparty/imgui/backends/imgui_impl_opengl3.cpp",
        "3rdparty/imgui/imgui.cpp",
        "3rdparty/imgui/imgui_draw.cpp",
        "3rdparty/imgui/imgui_tables.cpp",
        "3rdparty/imgui/imgui_widgets.cpp",
        "3rdparty/imgui/misc/cpp/imgui_stdlib.cpp",
        "3rdparty/implot/implot.cpp",
        "3rdparty/implot/implot_items.cpp",
        "src/embedded_icon_font.cpp",
    ],
    hdrs = [
        "3rdparty/IconFontCppHeaders/IconsCodicons.h",
        "3rdparty/IconFontCppHeaders/IconsFontAwesome4.h",
        "3rdparty/IconFontCppHeaders/IconsFontAwesome5.h",
        "3rdparty/IconFontCppHeaders/IconsFontAwesome5Brands.h",
        "3rdparty/IconFontCppHeaders/IconsFontAwesome5Pro.h",
        "3rdparty/IconFontCppHeaders/IconsFontAwesome5ProBrands.h",
        "3rdparty/IconFontCppHeaders/IconsFontAwesome6.h",
        "3rdparty/IconFontCppHeaders/IconsFontAwesome6Brands.h",
        "3rdparty/IconFontCppHeaders/IconsFontAwesome7.h",
        "3rdparty/IconFontCppHeaders/IconsFontAwesome7Brands.h",
        "3rdparty/IconFontCppHeaders/IconsFontaudio.h",
        "3rdparty/IconFontCppHeaders/IconsForkAwesome.h",
        "3rdparty/IconFontCppHeaders/IconsKenney.h",
        "3rdparty/IconFontCppHeaders/IconsLucide.h",
        "3rdparty/IconFontCppHeaders/IconsMaterialDesign.h",
        "3rdparty/IconFontCppHeaders/IconsMaterialDesignIcons.h",
        "3rdparty/IconFontCppHeaders/IconsMaterialSymbols.h",
        "3rdparty/imgui/backends/imgui_impl_allegro5.h",
        "3rdparty/imgui/backends/imgui_impl_android.h",
        "3rdparty/imgui/backends/imgui_impl_dx10.h",
        "3rdparty/imgui/backends/imgui_impl_dx11.h",
        "3rdparty/imgui/backends/imgui_impl_dx12.h",
        "3rdparty/imgui/backends/imgui_impl_dx9.h",
        "3rdparty/imgui/backends/imgui_impl_glfw.h",
        "3rdparty/imgui/backends/imgui_impl_glut.h",
        "3rdparty/imgui/backends/imgui_impl_metal.h",
        "3rdparty/imgui/backends/imgui_impl_metal4.h",
        "3rdparty/imgui/backends/imgui_impl_null.h",
        "3rdparty/imgui/backends/imgui_impl_opengl2.h",
        "3rdparty/imgui/backends/imgui_impl_opengl3.h",
        "3rdparty/imgui/backends/imgui_impl_opengl3_loader.h",
        "3rdparty/imgui/backends/imgui_impl_osx.h",
        "3rdparty/imgui/backends/imgui_impl_qnx.h",
        "3rdparty/imgui/backends/imgui_impl_sdl2.h",
        "3rdparty/imgui/backends/imgui_impl_sdl3.h",
        "3rdparty/imgui/backends/imgui_impl_sdlgpu3.h",
        "3rdparty/imgui/backends/imgui_impl_sdlgpu3_shaders.h",
        "3rdparty/imgui/backends/imgui_impl_sdlrenderer2.h",
        "3rdparty/imgui/backends/imgui_impl_sdlrenderer3.h",
        "3rdparty/imgui/backends/imgui_impl_vulkan.h",
        "3rdparty/imgui/backends/imgui_impl_wgpu.h",
        "3rdparty/imgui/backends/imgui_impl_win32.h",
        "3rdparty/imgui/examples/example_allegro5/imconfig_allegro5.h",
        "3rdparty/imgui/examples/libs/emscripten/emscripten_mainloop_stub.h",
        "3rdparty/imgui/examples/libs/glfw/include/GLFW/glfw3.h",
        "3rdparty/imgui/examples/libs/glfw/include/GLFW/glfw3native.h",
        "3rdparty/imgui/examples/libs/usynergy/uSynergy.h",
        "3rdparty/imgui/imconfig.h",
        "3rdparty/imgui/imgui.h",
        "3rdparty/imgui/imgui_internal.h",
        "3rdparty/imgui/imstb_rectpack.h",
        "3rdparty/imgui/imstb_textedit.h",
        "3rdparty/imgui/imstb_truetype.h",
        "3rdparty/imgui/misc/cpp/imgui_stdlib.h",
        "3rdparty/imgui/misc/freetype/imgui_freetype.h",
        "3rdparty/imgui/misc/single_file/imgui_single_file.h",
        "3rdparty/implot/implot.h",
        "3rdparty/implot/implot_internal.h",
        "3rdparty/portable-file-dialogs/portable-file-dialogs.h",
        "include/mrpt/imgui_vendor/icon_font.h",
    ] + [
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "3rdparty/IconFontCppHeaders",
        "3rdparty/imgui",
        "3rdparty/imgui/backends",
        "3rdparty/imgui/misc/cpp",
        "3rdparty/implot",
        "3rdparty/portable-file-dialogs",
        "_gen/include",
        "include",
        "src",
    ],
    local_defines = ros_local_defines() + ["IMGUI_ENABLE_DOCKING"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

genrule(
    name = "static_mrpt_imgui_vendor_a",
    srcs = [":mrpt_imgui_vendor_library"],
    outs = ["libmrpt_imgui_vendor.a"],
    cmd = "for f in $(SRCS); do case $$f in *.a) cp $$f $@; exit 0;; esac; done; ar rcs $@",
)

ament_index(
    name = "ament_index",
    data = [
        "LICENSES/IconFontCppHeaders-Zlib.txt",
        "LICENSES/imgui-MIT.txt",
        "LICENSES/implot-MIT.txt",
        "LICENSES/material-symbols-Apache-2.0.txt",
        "LICENSES/portable-file-dialogs-WTFPL.txt",
    ],
    libraries = [
        ":static_mrpt_imgui_vendor_a",
    ],
    package_xml = "package.xml",
    deps = [
        "@mrpt_common//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "3rdparty/IconFontCppHeaders/IconsMaterialSymbols.h",
        "3rdparty/imgui/backends/imgui_impl_glfw.h",
        "3rdparty/imgui/backends/imgui_impl_opengl3.h",
        "3rdparty/imgui/backends/imgui_impl_opengl3_loader.h",
        "include/mrpt/imgui_vendor/icon_font.h",
        "3rdparty/imgui/imconfig.h",
        "3rdparty/imgui/imgui.h",
        "3rdparty/imgui/imgui_internal.h",
        "3rdparty/imgui/misc/cpp/imgui_stdlib.h",
        "3rdparty/implot/implot.h",
        "3rdparty/implot/implot_internal.h",
        "3rdparty/imgui/imstb_rectpack.h",
        "3rdparty/imgui/imstb_textedit.h",
        "3rdparty/imgui/imstb_truetype.h",
        "3rdparty/portable-file-dialogs/portable-file-dialogs.h",
    ],
    headers_strip_prefixes = [
        "3rdparty/IconFontCppHeaders->mrpt/imgui_vendor",
        "3rdparty/imgui->mrpt/imgui_vendor",
        "3rdparty/imgui/backends->mrpt/imgui_vendor",
        "3rdparty/imgui/misc/cpp->mrpt/imgui_vendor",
        "3rdparty/implot->mrpt/imgui_vendor",
        "3rdparty/portable-file-dialogs->mrpt/imgui_vendor",
        "include",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":static_mrpt_imgui_vendor_a",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@mrpt_common//:ament_package",
    ],
)
