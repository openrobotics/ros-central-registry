load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

py_pytest(
    name = "test_interfaces_py",
    srcs = ["test_interfaces.py"],
    deps = [
        "//:rosidl_generator_py",
        "//:test_msgs_py",
    ],
)

py_pytest(
    name = "test_property_py",
    srcs = ["test_property.py"],
    deps = [
        "//:rosidl_generator_py",
        "//:test_msgs_py",
    ],
)

py_pytest(
    name = "test_cli_extension",
    srcs = ["test_cli_extension.py"],
    data = ["//msg:StringArrays.msg"],
    deps = [
        "//:rosidl_generator_py",
        "@rosidl_cli",
    ],
)
