load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@pip_ros//:requirements.bzl", "requirement", "whl_requirement")
load("@rosdistro//ament:defs.bzl", "ament_package", "register_ament_resource")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python//python:pip.bzl", "whl_filegroup")
load(":defs.bzl", "py_ros_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

exports_files(glob(["*.bzl"]))

filegroup(
    name = "interface_templates",
    srcs = glob(["resource/**/*.em"]),
)

py_library(
    name = "hook",
    srcs = ["sitecustomize.py"],
    imports = ["."],
)

py_library(
    name = "rosidl_generator_py",
    srcs = glob(["rosidl_generator_py/**/*.py"]),
    deps = [
        ":hook",
        "@ament_index_python",
        "@rosidl_buffer_py",
        "@rosidl_cli",
        "@rosidl_generator_c",
        "@rosidl_parser",
        "@rosidl_pycommon",
        "@rpyutils",
        "@rules_python//python/runfiles",
        requirement("numpy"),
    ],
)

whl_filegroup(
    name = "numpy_includes",
    pattern = "numpy/.*core/include/numpy",
    whl = whl_requirement("numpy"),
)

cc_library(
    name = "numpy_headers",
    hdrs = [":numpy_includes"],
    includes = [
        "numpy_includes/numpy/_core/include",
        "numpy_includes/numpy/core/include",
    ],
    deps = ["@rules_python//python/cc:current_py_cc_headers"],
)

genrule(
    name = "cli_rename",
    srcs = ["bin/rosidl_generator_py"],
    outs = ["bin/rosidl_generator_py.py"],
    cmd = "cp $(location :bin/rosidl_generator_py) $(location :bin/rosidl_generator_py.py)",
)

py_binary(
    name = "cli",
    srcs = [":bin/rosidl_generator_py.py"],
    main = ":bin/rosidl_generator_py.py",
    deps = [":rosidl_generator_py"],
)

# Mirrors ament_package(CONFIG_EXTRAS "rosidl_generator_py-extras.cmake.in"): configure_file(@ONLY) of the template.
genrule(
    name = "extras_cmake",
    srcs = ["rosidl_generator_py-extras.cmake.in"],
    outs = ["rosidl_generator_py-extras.cmake"],
    cmd = "sed -e 's|@PYTHON_INSTALL_DIR@|lib/python3.14/site-packages|g' $< > $@",
)

write_file(
    name = "rosidl_cmake_extras",
    out = "cmake/rosidl_cmake-extras.cmake",
    content = [
        "# generated from",
        "# rosidl_cmake/rosidl_cmake-extras.cmake.in",
        "",
        "find_package(rosidl_cmake_core QUIET)",
        "if(NOT rosidl_cmake_core_FOUND)",
        "  find_package(rosidl_cmake REQUIRED)",
        "endif()",
        "",
        "set(rosidl_generator_py_IDL_FILES \"\")",
        "set(rosidl_generator_py_ROS_INTERFACE_FILES \"\")",
        "",
    ],
)

write_file(
    name = "rosidl_cmake_aggregate_target_extras",
    out = "cmake/rosidl_cmake_aggregate_target-extras.cmake",
    content = [
        "# generated from",
        "# rosidl_cmake/cmake/template/rosidl_cmake_aggregate_target.cmake.in",
        "",
        "# Create a convenience aggregate target rosidl_generator_py::rosidl_generator_py",
        "# that links all generated interface targets, so downstream packages can use",
        "# a single modern CMake target name instead of ${rosidl_generator_py_TARGETS}.",
        "if(rosidl_generator_py_TARGETS AND NOT TARGET rosidl_generator_py::rosidl_generator_py)",
        "  add_library(rosidl_generator_py::rosidl_generator_py INTERFACE IMPORTED)",
        "  set_target_properties(rosidl_generator_py::rosidl_generator_py PROPERTIES",
        "    INTERFACE_LINK_LIBRARIES \"${rosidl_generator_py_TARGETS}\")",
        "endif()",
        "",
    ],
)

# ament_index_register_resource() registrations, as ament_cmake installs them.

### TESTING

py_ros_library(
    name = "test_msgs_py",
    deps = [
        "//msg:Arrays",
        "//msg:BasicTypes",
        "//msg:BoundedPlainSequences",
        "//msg:BoundedSequences",
        "//msg:BuiltinTypeSequencesIdl",
        "//msg:Constants",
        "//msg:Defaults",
        "//msg:Empty",
        "//msg:MultiNested",
        "//msg:Nested",
        "//msg:Property",
        "//msg:StringArrays",
        "//msg:Strings",
        "//msg:UnboundedSequences",
        "//msg:WStrings",
    ],
)

py_pytest(
    name = "test_interfaces_py",
    srcs = ["test/test_interfaces.py"],
    deps = [
        ":rosidl_generator_py",
        ":test_msgs_py",
    ],
)

py_pytest(
    name = "test_property_py",
    srcs = ["test/test_property.py"],
    deps = [
        ":rosidl_generator_py",
        ":test_msgs_py",
    ],
)

py_pytest(
    name = "test_cli_extension",
    srcs = ["test/test_cli_extension.py"],
    data = ["//msg:StringArrays.msg"],
    deps = [
        ":rosidl_generator_py",
        "@rosidl_cli",
    ],
)

### PACKAGING

register_ament_resource(
    name = "res_rosidl_generator_packages",
    category = "rosidl_generator_packages",
    content = "",
)

ament_package(
    name = "ament_package",
    cmake = [
        ":extras_cmake",
        ":rosidl_cmake_aggregate_target_extras",
        ":rosidl_cmake_extras",
    ] + glob(["cmake/**"]),
    cmake_export_dependencies_list = [
        "ament_cmake",
        "rmw",
    ],
    cmake_extras = [
        "rosidl_generator_py_get_typesupports.cmake",
        "register_py.cmake",
        "rosidl_generator_py-extras.cmake",
        "rosidl_cmake-extras.cmake",
        "rosidl_cmake_aggregate_target-extras.cmake",
    ],
    data = [
        ":res_rosidl_generator_packages",
    ] + glob(["resource/**"]),
    lib_data = ["bin/rosidl_generator_py"],
    package_xml = "package.xml",
    python = glob(["rosidl_generator_py/**"]),
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_flake8//:ament_package",
        "@ament_cmake_mypy//:ament_package",
        "@ament_cmake_pep257//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rmw//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_buffer_py//:ament_package",
        "@rosidl_cli//:ament_package",
        "@rosidl_cmake//:ament_package",
        "@rosidl_generator_c//:ament_package",
        "@rosidl_generator_cpp//:ament_package",
        "@rosidl_parser//:ament_package",
        "@rosidl_pycommon//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidl_typesupport_c//:ament_package",
        "@rosidl_typesupport_fastrtps_c//:ament_package",
        "@rosidl_typesupport_interface//:ament_package",
        "@rosidl_typesupport_introspection_c//:ament_package",
        "@rpyutils//:ament_package",
        "@test_interface_files//:ament_package",
    ],
)
