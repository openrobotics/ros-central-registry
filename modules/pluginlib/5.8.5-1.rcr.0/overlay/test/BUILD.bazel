load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@class_loader": "@class_loader//:class_loader_library",
    "@rcpputils": "@rcpputils//:rcpputils_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

exports_files([
    "include/test_base.hpp",
    "include/test_plugins.hpp",
    "include/visibility_control.hpp",
    "test_package.xml",
    "test_plugins.cpp",
    "test_plugins.xml",
    "unique_ptr_test.cpp",
    "utest.cpp",
])

cc_library(
    name = "test_plugins_headers",
    hdrs = [
        "include/test_base.hpp",
        "include/test_plugins.hpp",
        "include/visibility_control.hpp",
    ],
    includes = ["include"],
)

cc_library(
    name = "test_plugins_library",
    srcs = ["test_plugins.cpp"],
    copts = ["-DTEST_PLUGINLIB_FIXTURE_BUILDING_LIBRARY"],
    implementation_deps = [":test_plugins_headers"],
    deps = DEPENDENCIES.values() + ["//:pluginlib_library"],
)

cc_shared_library(
    name = "test_plugins",
    dynamic_deps = ["//:transitive_dynamic_deps"],
    exports_filter = [":test_plugins_library"],
    deps = [":test_plugins_library"],
)

ament_index(
    name = "ament_index_real",
    libraries = [":test_plugins"],
    package_xml = "//:package.xml",
    plugins = ["test_plugins.xml"],
)

[cc_test(
    name = "pluginlib_{0}".format(test),
    srcs = ["{0}.cpp".format(test)],
    data = [
        ":ament_index_real",
        "//:ament_index",
    ],
    dynamic_deps = [
        "//:transitive_dynamic_deps",
        ":test_plugins",
    ],
    deps = DEPENDENCIES.values() + [
        ":test_plugins_headers",
        "//:pluginlib_library",
        "@rosdistro//cc:googletest",
    ],
) for test in [
    "utest",
    "unique_ptr_test",
]]
