load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

exports_files(["package.xml"])

HEADERS = [
    "include/pluginlib/class_desc.hpp",
    "include/pluginlib/class_list_macros.hpp",
    "include/pluginlib/class_loader.hpp",
    "include/pluginlib/class_loader_base.hpp",
    "include/pluginlib/class_loader_imp.hpp",
    "include/pluginlib/exceptions.hpp",
]

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@class_loader//:class_loader": "@class_loader//:class_loader_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

cc_library(
    name = "pluginlib_library",
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "pluginlib",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":pluginlib_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":pluginlib"],
)

cc_binary(
    name = "list_plugins",
    srcs = ["src/list_plugins.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [":pluginlib_library"],
)

ament_index(
    name = "ament_index",
    export_name = "test_pluginlib",
    libraries = ["//test:test_plugins"],
    package_xml = "package.xml",
    plugins = ["//test:test_plugins.xml"],
)

ament_package(
    name = "ament_package",
    cmake = [
        "cmake/blank.in",
        "cmake/pluginlib_enable_plugin_testing.cmake",
        "cmake/pluginlib_export_plugin_description_file.cmake",
        "cmake/pluginlib_package_hook.cmake",
    ] + ["pluginlib-extras.cmake"],
    cmake_export_name = "export_pluginlib",
    cmake_extras = ["pluginlib-extras.cmake"],
    executables = [":list_plugins"],
    headers = HEADERS,
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@class_loader//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
