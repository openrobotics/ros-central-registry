load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

cc_library(
    name = "ecl_io_library",
    srcs = glob(["src/lib/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include"],
    deps = [
        "@ecl_config",
        "@ecl_errors//:ecl_errors_library",
    ],
)

cc_shared_library(
    name = "ecl_io",
    shared_lib_name = "libecl_io.so",
    deps = [":ecl_io_library"],
)

cc_binary(
    name = "demo_sockets",
    srcs = ["src/examples/sockets.cpp"],
    deps = [":ecl_io_library"],
)

cc_binary(
    name = "demo_socketpair",
    srcs = ["src/examples/socketpair.cpp"],
    deps = [":ecl_io_library"],
)

cc_binary(
    name = "demo_poll",
    srcs = ["src/examples/poll.cpp"],
    deps = [":ecl_io_library"],
)

ament_index(
    name = "ament_index",
    executables = [
        ":demo_poll",
        ":demo_socketpair",
        ":demo_sockets",
    ],
    libraries = [
        ":ecl_io",
    ],
    package_xml = "package.xml",
    sonames = {
        "ecl_io": ["libecl_io.so.1.2.0"],
    },
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "ecl_config",
        "ecl_errors",
    ],
    executables = [
        ":demo_poll",
        ":demo_socketpair",
        ":demo_sockets",
    ],
    headers = [
        "include/ecl/io.hpp",
    ] + glob(["include/ecl/io/*.hpp"]),
    include_prefix = "",
    libraries = [
        ":ecl_io",
    ],
    package_xml = "package.xml",
    sonames = {
        "ecl_io": ["libecl_io.so.1.2.0"],
    },
    deps = [
        ":ament_index",
        "@ecl_build//:ament_package",
        "@ecl_config//:ament_package",
        "@ecl_errors//:ament_package",
        "@ecl_license//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
