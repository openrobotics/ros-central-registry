load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-2-Clause"],
)

py_library(
    name = "system_fingerprint",
    srcs = [
        "src/system_fingerprint/__init__.py",
        "src/system_fingerprint/imprint.py",
        "src/system_fingerprint/workspace.py",
    ],
    imports = ["src"],
    deps = [
        "@rcl_interfaces//:py",
        "@rclpy",
        "@ros2action",
        "@ros2cli",
        "@ros2node",
        "@ros2param",
        "@ros2topic",
        requirement("gitpython"),
        requirement("pyyaml"),
    ],
)

ament_package(
    name = "ament_package",
    console_scripts = {"scripts/imprint": "system_fingerprint.imprint:main"},
    package_xml = "package.xml",
    python = [":system_fingerprint"],
    python_strip_prefix = "src",
    setup_cfg = "setup.cfg",
    deps = [
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@ros2action//:ament_package",
        "@ros2cli//:ament_package",
        "@ros2node//:ament_package",
        "@ros2param//:ament_package",
        "@ros2topic//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
