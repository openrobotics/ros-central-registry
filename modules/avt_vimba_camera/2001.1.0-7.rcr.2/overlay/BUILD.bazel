write_file(
    name = "gen_avt_vimba_camera_stub_cpp",
    out = "_gen/avt_vimba_camera_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    data = [
        "README.md",
        "calibrations/calibration_example.yaml",
        "config/Mako_G-319.yaml",
        "config/params.yaml",
        "launch/Mako_G-319.launch.xml",
        "launch/mono_camera.launch.xml",
        "launch/stereo_camera.launch.xml",
        "launch/trigger_node.launch.xml",
    ],
    lib_data = [
        ":mono_camera_exec",
        ":trigger_exec",
    ],
    libraries = [
        ":VimbaC",
        ":VimbaCPP",
        ":mono_camera_node",
        ":trigger_node",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_auto//:ament_package",
        "@camera_info_manager//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@image_proc//:ament_package",
        "@image_transport//:ament_package",
        "@message_filters//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@stereo_image_proc//:ament_package",
    ],
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [
            ":ament_index",
            "@rclcpp_components//:ament_index",
        ],
    )
    for f in glob(["launch/**"])
]

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "rclcpp_components",
        "std_msgs",
        "sensor_msgs",
        "camera_info_manager",
        "diagnostic_updater",
        "diagnostic_msgs",
        "image_transport",
        "message_filters",
    ],
    cmake_export_include_directories = False,
    cmake_export_targets = False,
    headers = glob(["include/**"]),
    libraries = [
        ":VimbaC",
        ":VimbaCPP",
        ":mono_camera_node",
        ":trigger_node",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_auto//:ament_package",
        "@camera_info_manager//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@image_proc//:ament_package",
        "@image_transport//:ament_package",
        "@message_filters//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@stereo_image_proc//:ament_package",
    ],
)
