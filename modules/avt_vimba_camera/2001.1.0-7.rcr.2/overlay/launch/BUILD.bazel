load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "Mako_G-319.launch.xml",
        "mono_camera.launch.xml",
        "stereo_camera.launch.xml",
        "trigger_node.launch.xml",
    ],
)

launch_ros_binary(
    name = "Mako_G_319_launch",
    src = "Mako_G-319.launch.xml",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":mono_camera_launch",
        "//:mono_camera_exec",
    ],
)

launch_ros_binary(
    name = "mono_camera_launch",
    src = "mono_camera.launch.xml",
    data = [
        "@image_proc//:ament_index",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//:mono_camera_exec",
    ],
)

launch_ros_binary(
    name = "stereo_camera_launch",
    src = "stereo_camera.launch.xml",
    data = [
        "@stereo_image_proc//:ament_index",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":mono_camera_launch",
        "//:mono_camera_exec",
        "@stereo_image_proc//:disparity_node",
        "@stereo_image_proc//:point_cloud_node",
    ],
)

launch_ros_binary(
    name = "trigger_node_launch",
    src = "trigger_node.launch.xml",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//:trigger_exec",
    ],
)
