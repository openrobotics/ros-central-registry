load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            "CHANGELOG.rst",
            "README.md",
            "launch/robot_bringup_launch.py",
            "launch/robot_launch.py",
            "package.xml",
            "resource/cartographer.lua",
            "resource/default.rviz",
            "resource/default_bringup.rviz",
            "resource/map.pgm",
            "resource/map.yaml",
            "resource/nav2_params.yaml",
            "resource/nav2_params_iron.yaml",
            "resource/ros2_control.yml",
            "resource/ros2_control_bringup.yml",
            "resource/slam_toolbox_params.yaml",
            "resource/tiago_bringup_webots.urdf",
            "resource/tiago_webots.urdf",
            "resource/webots_ros2_tiago",
            "setup.cfg",
            "setup.py",
            "test/test_copyright.py",
            "worlds/.default.wbproj",
            "worlds/.default_bringup.wbproj",
            "worlds/default.wbt",
            "worlds/default_bringup.wbt",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
    ]
]

### PACKAGING

ament_index(
    name = "ament_index",
    data = [
        "launch/robot_bringup_launch.py",
        "launch/robot_launch.py",
        "resource/cartographer.lua",
        "resource/default.rviz",
        "resource/default_bringup.rviz",
        "resource/map.pgm",
        "resource/map.yaml",
        "resource/nav2_params.yaml",
        "resource/nav2_params_iron.yaml",
        "resource/ros2_control.yml",
        "resource/ros2_control_bringup.yml",
        "resource/slam_toolbox_params.yaml",
        "resource/tiago_bringup_webots.urdf",
        "resource/tiago_webots.urdf",
        "worlds/.default.wbproj",
        "worlds/.default_bringup.wbproj",
        "worlds/default.wbt",
        "worlds/default_bringup.wbt",
    ],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    setup_cfg = "setup.cfg",
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@controller_manager//:ament_package",
        "@diff_drive_controller//:ament_package",
        "@geometry_msgs//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@rclpy//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
        "@tf2_ros//:ament_package",
        "@webots_ros2_control//:ament_package",
        "@webots_ros2_driver//:ament_package",
    ],
)

launch_ros_binary(
    name = "launch_robot_bringup_launch_py",
    src = "launch/robot_bringup_launch.py",
    data = [
        ":ament_index",
        "@rviz2//:ament_index",
        "@webots_ros2_control//:ament_index",
        "@webots_ros2_driver//:ament_index",
    ],
    deps = [
        "@rviz2",
        "@webots_ros2_driver",
        "@webots_ros2_driver//:driver",
        "@webots_ros2_driver//:ros2_supervisor.py",
    ],
)

launch_ros_binary(
    name = "launch_robot_launch_py",
    src = "launch/robot_launch.py",
    data = [
        ":ament_index",
        "@cartographer_ros//:ament_index",
        "@controller_manager//:ament_index",
        "@diff_drive_controller//:ament_index",
        "@joint_state_broadcaster//:ament_index",
        "@nav2_bringup//:ament_index",
        "@robot_state_publisher//:ament_index",
        "@rviz2//:ament_index",
        "@slam_toolbox//:ament_index",
        "@tf2_ros//:ament_index",
        "@webots_ros2_control//:ament_index",
        "@webots_ros2_driver//:ament_index",
    ],
    deps = [
        "@cartographer_ros//:cartographer_node",
        "@cartographer_ros//:cartographer_occupancy_grid_node",
        "@controller_manager//:spawner",
        "@nav2_bringup//launch:bringup_launch",
        "@robot_state_publisher",
        "@rviz2",
        "@slam_toolbox//:async_slam_toolbox_node",
        "@tf2_ros//:static_transform_publisher",
        "@webots_ros2_driver",
        "@webots_ros2_driver//:driver",
        "@webots_ros2_driver//:ros2_supervisor.py",
    ],
)
