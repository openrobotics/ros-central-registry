load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### ENTRYPOINTS

py_binary(
    name = "setup",
    srcs = ["setup.py"],
    visibility = ["//visibility:private"],
    deps = [
        requirement("setuptools"),
    ],
)

genrule(
    name = "entry_points",
    srcs = [
        "CHANGELOG.rst",
        "ament_cpplint/__init__.py",
        "ament_cpplint/cpplint.py",
        "ament_cpplint/main.py",
        "ament_cpplint/py.typed",
        "doc/index.rst",
        "package.xml",
        "pytest.ini",
        "resource/ament_cpplint",
        "setup.py",
        "test/test_copyright.py",
        "test/test_flake8.py",
        "test/test_pep257.py",
        "test/test_xmllint.py",
    ],
    outs = [
        "ament_cpplint.egg-info/PKG-INFO",
        "ament_cpplint.egg-info/entry_points.txt",
        "ament_cpplint.egg-info/top_level.txt",
    ],
    cmd = "$(location :setup) egg_info --egg-base=. && mkdir -p $(@D)/ament_cpplint.egg-info && cp -r ament_cpplint.egg-info/* $(@D)/ament_cpplint.egg-info/",
    tools = [":setup"],
    visibility = ["//visibility:private"],
)

### PYTHON MODULE

py_library(
    name = "ament_cpplint",
    srcs = [
        "ament_cpplint/__init__.py",
        "ament_cpplint/cpplint.py",
        "ament_cpplint/main.py",
    ],
    data = [
        ":entry_points",
        "@rosdistro//cc:cpplint",
    ],
    imports = ["."],
)

### PYTHON EXECUTABLE

py_console_script_binary(
    name = "cli",
    entry_points_txt = ":entry_points",
    pkg = ":ament_cpplint",
    script = "ament_cpplint",
)

### TESTS

[
    py_pytest(
        name = "test_{0}".format(test_name),
        srcs = ["test/test_{0}.py".format(test_name)],
        data = [
            "CHANGELOG.rst",
            "ament_cpplint/__init__.py",
            "ament_cpplint/cpplint.py",
            "ament_cpplint/main.py",
            "ament_cpplint/py.typed",
            "doc/index.rst",
            "package.xml",
            "pytest.ini",
            "resource/ament_cpplint",
            "setup.py",
            "test/test_copyright.py",
            "test/test_flake8.py",
            "test/test_pep257.py",
            "test/test_xmllint.py",
        ],
        deps = ["@ament_{0}".format(test_name)],
    )
    for test_name in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    console_programs = {"ament_cpplint": "ament_cpplint.main:main"},
    package_xml = "package.xml",
    python = [":ament_cpplint"] + ["ament_cpplint/py.typed"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
