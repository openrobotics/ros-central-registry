load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

# Tests tagged xfail + manual: known failures under Bazel (see reasons).
_xfail_names = [
    "test_copyright",  # test assertion fails under Bazel: AssertionError...
]

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            "CHANGELOG.rst",
            "LICENSE",
            "README.md",
            "config/key_teleop.yaml",
            "key_teleop/__init__.py",
            "key_teleop/key_teleop.py",
            "package.xml",
            "resource/key_teleop",
            "setup.cfg",
            "setup.py",
            "test/test_copyright.py",
            "test/test_flake8.py",
            "test/test_pop257.py",
        ],
        tags = [
            "manual",
            "xfail",
        ] if "test_{0}".format(linter) in _xfail_names else [],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
    ]
]

py_library(
    name = "key_teleop",
    srcs = [
        "key_teleop/__init__.py",
        "key_teleop/key_teleop.py",
    ],
    imports = ["."],
    deps = [
        "@geometry_msgs//:py",
        "@rclpy",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"key_teleop": "key_teleop.key_teleop:main"},
    data = ["config/key_teleop.yaml"],
    executables = ["resource/key_teleop"],
    package_xml = "package.xml",
    python = [":key_teleop"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
