load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

HEADERS = [
    "include/event_camera_codecs/decoder.h",
    "include/event_camera_codecs/decoder_factory.h",
    "include/event_camera_codecs/encoder.h",
    "include/event_camera_codecs/event_packet.h",
    "include/event_camera_codecs/event_processor.h",
    "include/event_camera_codecs/evt3_decoder.h",
    "include/event_camera_codecs/evt3_encoder.h",
    "include/event_camera_codecs/evt3_types.h",
    "include/event_camera_codecs/libcaer_cmp_decoder.h",
    "include/event_camera_codecs/libcaer_cmp_types.h",
    "include/event_camera_codecs/libcaer_decoder.h",
    "include/event_camera_codecs/mono_decoder.h",
    "include/event_camera_codecs/mono_encoder.h",
    "include/event_camera_codecs/noop_event_processor.h",
    "include/event_camera_codecs/ros1_ros2_compat.h",
    "include/event_camera_codecs/trigger_decoder.h",
]

cc_library(
    name = "codec_library",
    srcs = ["src/encoder.cpp"],
    hdrs = HEADERS,
    defines = ["USING_ROS_2"],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = [
        "@event_camera_msgs//:cc",
    ],
)

cc_shared_library(
    name = "codec",
    dynamic_deps = [
        "@event_camera_msgs//:cc_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":codec_library"],
)

### EXECUTABLES

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":codec",
        "@event_camera_msgs//:cc_shared",
    ],
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "codec_perf",
    srcs = ["src/perf.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = [":codec_library"],
)

### AMENT INDEX

ament_index(
    name = "ament_index",
    executables = [
        ":codec_perf",
    ],
    libraries = [
        ":codec",
    ],
    package_xml = "package.xml",
)

### PACKAGING

write_file(
    name = "catkin_marker",
    out = ".catkin",
    content = [],
)

pkg_files(
    name = "catkin_files",
    srcs = [":catkin_marker"],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "ament_cmake",
        "event_camera_msgs",
        "class_loader",
    ],
    cmake_export_has_library_target = True,
    cmake_export_name = "codecTargets",
    executables = [":codec_perf"],
    headers = HEADERS,
    include_prefix = "",
    install = [
        ":catkin_files",
    ],
    libraries = [
        ":codec",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@class_loader//:ament_package",
        "@event_camera_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_environment//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
