load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@urdf//:urdf": "@urdf//:urdf_library",
    "@urdfdom_headers//:urdfdom_headers": "@urdfdom_headers//:urdfdom_headers_library",
}

CC_DEPS = ["@rosdistro//cc:boost.algorithm"]

cc_test(
    name = "test_cpp_C",
    srcs = ["test_parser.cpp"],
    data = ["//:ament_index"] + [
        "resources/pr2_desc.1.srdf",
        "resources/pr2_desc.2.srdf",
        "resources/pr2_desc.3.srdf",
        "resources/pr2_desc.3-normalized.srdf",
        "resources/pr2_desc.urdf",
        "test.py",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        'TEST_RESOURCE_LOCATION=\\"test/resources\\"',
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:srdfdom_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_cpp_nl_NL.UTF-8",
    srcs = ["test_parser.cpp"],
    data = ["//:ament_index"] + [
        "resources/pr2_desc.1.srdf",
        "resources/pr2_desc.2.srdf",
        "resources/pr2_desc.3.srdf",
        "resources/pr2_desc.3-normalized.srdf",
        "resources/pr2_desc.urdf",
        "test.py",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        'TEST_RESOURCE_LOCATION=\\"test/resources\\"',
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:srdfdom_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

py_pytest(
    name = "self_parser_test",
    srcs = ["test.py"],
    data = ["//:ament_index"],
    deps = [
        "//:srdfdom_py",
        "@ament_lint_cmake",
        "@urdfdom_py",
    ],
)
