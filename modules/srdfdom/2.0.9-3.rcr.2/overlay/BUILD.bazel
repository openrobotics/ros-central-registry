load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@urdf//:urdf": "@urdf//:urdf_library",
    "@urdfdom_headers//:urdfdom_headers": "@urdfdom_headers//:urdfdom_headers_library",
}

CC_DEPS = [
    "@rosdistro//cc:boost.algorithm",
]

cc_library(
    name = "srdfdom_library",
    srcs = [
        "src/model.cpp",
        "src/srdf_writer.cpp",
    ],
    hdrs = [
        "include/srdfdom/model.h",
        "include/srdfdom/srdf_writer.h",
        "include/srdfdom/visibility_control.h",
    ],
    includes = [
        ".",
        "include",
        "include/srdfdom",
    ],
    local_defines = ros_local_defines() + [
        "SRDFDOM_BUILDING_DLL",
        'TEST_RESOURCE_LOCATION=\\"test/resources\\"',
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "srdfdom",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":srdfdom_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":srdfdom"],
)

py_library(
    name = "srdfdom_py",
    srcs = [
        "srdfdom/__init__.py",
        "srdfdom/srdf.py",
    ],
    imports = ["."],
    deps = [
        "@ament_lint_cmake",
        "@urdfdom_py",
    ],
)

ament_index(
    name = "ament_index",
    lib_data = ["scripts/display_srdf"],
    libraries = [":srdfdom"],
    package_xml = "package.xml",
    sonames = {"srdfdom": ["libsrdfdom.so.2.0.9"]},
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_cmake//:ament_package",
        "@console_bridge_vendor//:ament_package",
        "@urdf//:ament_package",
        "@urdfdom_headers//:ament_package",
        "@urdfdom_py//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "TinyXML2",
        "console_bridge",
        "urdf",
        "urdfdom_headers",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "srdfdomTargets",
    headers = [
        "include/srdfdom/model.h",
        "include/srdfdom/srdf_writer.h",
        "include/srdfdom/visibility_control.h",
    ],
    include_prefix = "",
    libraries = [":srdfdom"],
    package_xml = "package.xml",
    python = [":srdfdom_py"],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_cmake//:ament_package",
        "@console_bridge_vendor//:ament_package",
        "@urdf//:ament_package",
        "@urdfdom_headers//:ament_package",
        "@urdfdom_py//:ament_package",
    ],
)
