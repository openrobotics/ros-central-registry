load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

write_file(
    name = "pkg_info",
    out = "ros2interface-0.40.9.egg-info/PKG-INFO",
    content = [
        "Metadata-Version: 2.1",
        "Name: ros2interface",
        "Version: 0.40.9",
    ],
)

write_file(
    name = "entry_points_txt",
    out = "ros2interface-0.40.9.egg-info/entry_points.txt",
    content = [
        "[ros2cli.command]",
        "interface = ros2interface.command.interface:InterfaceCommand",
        "",
        "[ros2cli.extension_point]",
        "ros2interface.verb = ros2interface.verb:VerbExtension",
        "",
        "[ros2interface.verb]",
        "list = ros2interface.verb.list:ListVerb",
        "package = ros2interface.verb.package:PackageVerb",
        "proto = ros2interface.verb.proto:ProtoVerb",
        "packages = ros2interface.verb.packages:PackagesVerb",
        "show = ros2interface.verb.show:ShowVerb",
    ],
)

py_library(
    name = "ros2interface",
    srcs = [
        "ros2interface/__init__.py",
        "ros2interface/api/__init__.py",
        "ros2interface/command/__init__.py",
        "ros2interface/command/interface.py",
        "ros2interface/verb/__init__.py",
        "ros2interface/verb/list.py",
        "ros2interface/verb/package.py",
        "ros2interface/verb/packages.py",
        "ros2interface/verb/proto.py",
        "ros2interface/verb/show.py",
    ],
    data = ["ros2interface/py.typed"] + [
        ":ament_index",
        ":entry_points_txt",
        ":pkg_info",
    ],
    imports = ["."],
    deps = [
        "@ros2cli",
        "@rosidl_adapter",
        "@rosidl_runtime_py",
    ],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "package.xml",
        "resource/ros2interface",
        "ros2interface/__init__.py",
        "ros2interface/api/__init__.py",
        "ros2interface/command/__init__.py",
        "ros2interface/command/interface.py",
        "ros2interface/py.typed",
        "ros2interface/verb/__init__.py",
        "ros2interface/verb/list.py",
        "ros2interface/verb/package.py",
        "ros2interface/verb/packages.py",
        "ros2interface/verb/proto.py",
        "ros2interface/verb/show.py",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
    "xmllint",
]]

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":ros2interface"] + ["ros2interface/py.typed"],
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@launch//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@ros2cli//:ament_package",
        "@ros2cli_test_interfaces//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_adapter//:ament_package",
        "@rosidl_runtime_py//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
