load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "franka_control.launch.yaml",
        "franka_example_planning.launch.yaml",
        "franka_optimal_ik_streaming.launch.yaml",
    ],
)

launch_ros_binary(
    name = "franka_control_launch",
    src = "franka_control.launch.yaml",
    data = [
        "//:ament_index",
        "@controller_manager//:ament_index",
        "@controller_manager//:ros2_control_node",
        "@mujoco_ros2_control//:ament_index",
        "@mujoco_ros2_control//:ros2_control_node",
        "@roboplan_example_models//:ament_index",
        "@robot_state_publisher",
        "@robot_state_publisher//:ament_index",
        "@rviz2",
        "@rviz2//:ament_index",
        "@xacro",
    ],
)

launch_ros_binary(
    name = "franka_example_planning_launch",
    src = "franka_example_planning.launch.yaml",
    data = [
        "//:ament_index",
        "@controller_manager//:ament_index",
        "@controller_manager//:ros2_control_node",
        "@mujoco_ros2_control//:ament_index",
        "@mujoco_ros2_control//:ros2_control_node",
        "@roboplan_example_models//:ament_index",
        "@robot_state_publisher",
        "@robot_state_publisher//:ament_index",
        "@rviz2",
        "@rviz2//:ament_index",
        "@xacro",
    ],
)

launch_ros_binary(
    name = "franka_optimal_ik_streaming_launch",
    src = "franka_optimal_ik_streaming.launch.yaml",
    data = [
        "//:ament_index",
        "@controller_manager//:ament_index",
        "@controller_manager//:ros2_control_node",
        "@mujoco_ros2_control//:ament_index",
        "@mujoco_ros2_control//:ros2_control_node",
        "@roboplan_example_models//:ament_index",
        "@robot_state_publisher",
        "@robot_state_publisher//:ament_index",
        "@rviz2",
        "@rviz2//:ament_index",
        "@xacro",
    ],
)
