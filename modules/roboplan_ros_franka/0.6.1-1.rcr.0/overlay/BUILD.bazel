load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

pkg_files(
    name = "pkg_files_extra_0",
    srcs = ["scripts/optimal_ik_streaming_node.py"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "lib/roboplan_ros_franka",
)

pkg_files(
    name = "pkg_files_extra_1",
    srcs = ["scripts/plan_and_execute_node.py"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "lib/roboplan_ros_franka",
)

ament_index(
    name = "ament_index",
    data = [
        "config/fr3_mujoco_obstacles.yaml",
        "config/franka_config.rviz",
        "config/franka_ik_config.rviz",
        "config/franka_oink_config.rviz",
        "config/ros2_controllers.yaml",
        "description/fr3_mujoco_inputs.xml",
        "description/fr3_mujoco_scene.xml",
        "launch/franka_control.launch.yaml",
        "launch/franka_example_planning.launch.yaml",
        "launch/franka_optimal_ik_streaming.launch.yaml",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@controller_manager//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@joint_trajectory_controller//:ament_package",
        "@mujoco_ros2_control//:ament_package",
        "@parallel_gripper_controller//:ament_package",
        "@roboplan//:ament_package",
        "@roboplan_example_models//:ament_package",
        "@roboplan_ros_examples//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@topic_tools//:ament_package",
        "@xacro//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    install = [
        ":pkg_files_extra_0",
        ":pkg_files_extra_1",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@controller_manager//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@joint_trajectory_controller//:ament_package",
        "@mujoco_ros2_control//:ament_package",
        "@parallel_gripper_controller//:ament_package",
        "@roboplan//:ament_package",
        "@roboplan_example_models//:ament_package",
        "@roboplan_ros_examples//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@topic_tools//:ament_package",
        "@xacro//:ament_package",
    ],
)
