load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

ament_index(
    name = "ament_index",
    data = [
        "config/fr3_mujoco_obstacles.yaml",
        "config/franka_config.rviz",
        "config/franka_ik_config.rviz",
        "config/franka_oink_config.rviz",
        "config/ros2_controllers.yaml",
        "description/fr3_mujoco_inputs.xml",
        "description/fr3_mujoco_scene.xml",
        "//launch:launch_files",
    ],
    lib_data = [
        "scripts/optimal_ik_streaming_node.py",
        "scripts/plan_and_execute_node.py",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@controller_manager//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@joint_trajectory_controller//:ament_package",
        "@mujoco_ros2_control//:ament_package",
        "@parallel_gripper_controller//:ament_package",
        "@roboplan//:ament_package",
        "@roboplan_example_models//:ament_package",
        "@roboplan_ros_examples//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@topic_tools//:ament_package",
        "@xacro//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@controller_manager//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@joint_trajectory_controller//:ament_package",
        "@mujoco_ros2_control//:ament_package",
        "@parallel_gripper_controller//:ament_package",
        "@roboplan//:ament_package",
        "@roboplan_example_models//:ament_package",
        "@roboplan_ros_examples//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@topic_tools//:ament_package",
        "@xacro//:ament_package",
    ],
)
