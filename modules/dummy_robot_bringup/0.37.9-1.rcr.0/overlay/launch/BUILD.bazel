load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "dummy_robot_bringup_launch.py",
        "dummy_robot_bringup_launch.xml",
        "dummy_robot_bringup_launch.yaml",
        "single_rrbot.urdf",
    ],
)

launch_ros_binary(
    name = "dummy_robot_bringup_launch",
    src = "dummy_robot_bringup_launch.py",
    data = [
        "//:ament_index",
        "@dummy_map_server",
        "@dummy_map_server//:ament_index",
        "@dummy_sensors//:ament_index",
        "@dummy_sensors//:dummy_joint_states",
        "@dummy_sensors//:dummy_laser",
        "@robot_state_publisher",
        "@robot_state_publisher//:ament_index",
        "@rviz2",
        "@rviz2//:ament_index",
    ],
)

launch_ros_binary(
    name = "dummy_robot_bringup_launch_xml",
    src = "dummy_robot_bringup_launch.xml",
    data = [
        "//:ament_index",
        "@dummy_map_server//:ament_index",
        "@dummy_sensors//:ament_index",
        "@robot_state_publisher//:ament_index",
    ],
)

launch_ros_binary(
    name = "dummy_robot_bringup_launch_yaml",
    src = "dummy_robot_bringup_launch.yaml",
    data = [
        "//:ament_index",
        "@dummy_map_server//:ament_index",
        "@dummy_sensors//:ament_index",
        "@robot_state_publisher//:ament_index",
    ],
)
