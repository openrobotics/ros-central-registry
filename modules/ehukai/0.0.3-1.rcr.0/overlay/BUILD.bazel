load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/Util/All.h",
        "include/Util/Exception.h",
        "include/Util/Foundation.h",
        "include/Util/Functions.h",
        "include/Util/Timer.h",
        "include/ehukai/All.h",
        "include/ehukai/Basics.h",
        "include/ehukai/DirectionalSpreading.h",
        "include/ehukai/Dispersion.h",
        "include/ehukai/Exception.h",
        "include/ehukai/FftwWrapper.h",
        "include/ehukai/Filter.h",
        "include/ehukai/Foundation.h",
        "include/ehukai/InitialState.h",
        "include/ehukai/MipMap.h",
        "include/ehukai/Normals.h",
        "include/ehukai/Parameters.h",
        "include/ehukai/Propagation.h",
        "include/ehukai/Random.h",
        "include/ehukai/Spectra.h",
        "include/ehukai/SpectralSpatialField.h",
        "include/ehukai/Stats.h",
    ] + [
    ],
    includes = [],
    deps = [
        "@rosdistro//cc:imath_library",
        "@rosdistro//cc:tbb_library",
    ],
)

DEPENDENCIES = {
    "@rosdistro//cc:imath": "@rosdistro//cc:imath_library",
    "@rosdistro//cc:tbb": "@rosdistro//cc:tbb_library",
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "ehukai_library",
    srcs = [
        "src/Foundation.cpp",
        "src/util/Exception.cpp",
    ],
    hdrs = [
        "include/Util/All.h",
        "include/Util/Exception.h",
        "include/Util/Foundation.h",
        "include/Util/Functions.h",
        "include/Util/Timer.h",
        "include/ehukai/All.h",
        "include/ehukai/Basics.h",
        "include/ehukai/DirectionalSpreading.h",
        "include/ehukai/Dispersion.h",
        "include/ehukai/Exception.h",
        "include/ehukai/FftwWrapper.h",
        "include/ehukai/Filter.h",
        "include/ehukai/Foundation.h",
        "include/ehukai/InitialState.h",
        "include/ehukai/MipMap.h",
        "include/ehukai/Normals.h",
        "include/ehukai/Parameters.h",
        "include/ehukai/Propagation.h",
        "include/ehukai/Random.h",
        "include/ehukai/Spectra.h",
        "include/ehukai/SpectralSpatialField.h",
        "include/ehukai/Stats.h",
    ] + [
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "include/ehukai",
    ],
    local_defines = ros_local_defines() + ["NDEBUG"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ehukai",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":ehukai_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ehukai"],
)

ament_index(
    name = "ament_index",
    libraries = [":ehukai"],
    package_xml = "package.xml",
    sonames = {"ehukai": [
        "libehukai.so.0",
        "libehukai.so.0.0.2",
    ]},
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/Util/All.h",
        "include/Util/Exception.h",
        "include/Util/Foundation.h",
        "include/Util/Functions.h",
        "include/Util/Timer.h",
        "include/ehukai/All.h",
        "include/ehukai/Basics.h",
        "include/ehukai/DirectionalSpreading.h",
        "include/ehukai/Dispersion.h",
        "include/ehukai/Exception.h",
        "include/ehukai/FftwWrapper.h",
        "include/ehukai/Filter.h",
        "include/ehukai/Foundation.h",
        "include/ehukai/InitialState.h",
        "include/ehukai/MipMap.h",
        "include/ehukai/Normals.h",
        "include/ehukai/Parameters.h",
        "include/ehukai/Propagation.h",
        "include/ehukai/Random.h",
        "include/ehukai/Spectra.h",
        "include/ehukai/SpectralSpatialField.h",
        "include/ehukai/Stats.h",
    ],
    include_prefix = "",
    libraries = [":ehukai"],
    package_xml = "package.xml",
    deps = [":ament_index"],
)
