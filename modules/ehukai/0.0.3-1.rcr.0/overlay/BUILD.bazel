nstallation prefix relative to this file.\nget_filename_component(_IMPORT_PREFIX \"${CMAKE_CURRENT_LIST_FILE}\" PATH)\nget_filename_component(_IMPORT_PREFIX \"${_IMPORT_PREFIX}\" PATH)\nget_filename_component(_IMPORT_PREFIX \"${_IMPORT_PREFIX}\" PATH)\nget_filename_component(_IMPORT_PREFIX \"${_IMPORT_PREFIX}\" PATH)\nif(_IMPORT_PREFIX STREQUAL \"/\")\n  set(_IMPORT_PREFIX \"\")\nendif()\n\n# Create imported target ehukai::ehukai\nadd_library(ehukai::ehukai SHARED IMPORTED)\n\nset_target_properties(ehukai::ehukai PROPERTIES\n  INTERFACE_INCLUDE_DIRECTORIES \"${_IMPORT_PREFIX}/include;${_IMPORT_PREFIX}/include\"\n  INTERFACE_LINK_LIBRARIES \"Eigen3::Eigen;TBB::tbb;Imath::Imath\"\n)\n\n# Load information for each installed configuration.\nfile(GLOB _cmake_config_files \"${CMAKE_CURRENT_LIST_DIR}/ehukaiTargets-*.cmake\")\nforeach(_cmake_config_file IN LISTS _cmake_config_files)\n  include(\"${_cmake_config_file}\")\nendforeach()\nunset(_cmake_config_file)\nunset(_cmake_config_files)\n\n# Cleanup temporary variables.\nset(_IMPORT_PREFIX)\n\n# Loop over all imported files and verify that they actually exist\nforeach(_cmake_target IN LISTS _cmake_import_check_targets)\n  if(CMAKE_VERSION VERSION_LESS \"3.28\"\n      OR NOT DEFINED _cmake_import_check_xcframework_for_${_cmake_target}\n      OR NOT IS_DIRECTORY \"${_cmake_import_check_xcframework_for_${_cmake_target}}\")\n    foreach(_cmake_file IN LISTS \"_cmake_import_check_files_for_${_cmake_target}\")\n      if(NOT EXISTS \"${_cmake_file}\")\n        message(FATAL_ERROR \"The imported target \\\"${_cmake_target}\\\" references the file\n   \\\"${_cmake_file}\\\"\nbut this file does not exist.  Possible reasons include:\n* The file was deleted, renamed, or moved to another location.\n* An install or uninstall procedure did not complete successfully.\n* The installation package was faulty and contained\n   \\\"${CMAKE_CURRENT_LIST_FILE}\\\"\nbut not all the files it references.\n\")\n      endif()\n    endforeach()\n  endif()\n  unset(_cmake_file)\n  unset(\"_cmake_import_check_files_for_${_cmake_target}\")\nendforeach()\nunset(_cmake_target)\nunset(_cmake_import_check_targets)\n\n# This file does not depend on other imported targets which have\n# been exported from the same project but in a separate export set.\n\n# Commands beyond this point should not need to know the version.\nset(CMAKE_IMPORT_FILE_VERSION)\ncmake_policy(POP)\n"],
)

write_file(
    name = "gen_tbb_blocked_range_h",
    out = "_gen/include/tbb/blocked_range.h",
    content = ["#ifndef RCR_TBB_BLOCKED_RANGE_H_\n#define RCR_TBB_BLOCKED_RANGE_H_\n#include <cstddef>\nnamespace tbb {\nstruct split {};\ntemplate <typename Value>\nclass blocked_range {\n public:\n  blocked_range(Value begin, Value end, std::size_t grainsize = 1)\n      : begin_(begin), end_(end), grainsize_(grainsize) {}\n  blocked_range(blocked_range & r, split)\n      : begin_(r.begin_), end_(r.end_), grainsize_(r.grainsize_) {}\n  Value begin() const { return begin_; }\n  Value end() const { return end_; }\n  std::size_t size() const { return static_cast<std::size_t>(end_ - begin_); }\n  std::size_t grainsize() const { return grainsize_; }\n  bool empty() const { return !(begin_ < end_); }\n private:\n  Value begin_, end_;\n  std::size_t grainsize_;\n};\n}  // namespace tbb\n#endif\n"],
)

write_file(
    name = "gen_tbb_parallel_for_h",
    out = "_gen/include/tbb/parallel_for.h",
    content = ["#ifndef RCR_TBB_PARALLEL_FOR_H_\n#define RCR_TBB_PARALLEL_FOR_H_\n#include \"tbb/blocked_range.h\"\nnamespace tbb {\ntemplate <typename Range, typename Body>\ninline void parallel_for(const Range & range, const Body & body) {\n  body(range);\n}\ntemplate <typename Index, typename Func>\ninline void parallel_for(Index first, Index last, const Func & f) {\n  for (Index i = first; i < last; ++i) f(i);\n}\n}  // namespace tbb\n#endif\n"],
)

write_file(
    name = "gen_tbb_parallel_for_each_h",
    out = "_gen/include/tbb/parallel_for_each.h",
    content = ["#ifndef RCR_TBB_PARALLEL_FOR_EACH_H_\n#define RCR_TBB_PARALLEL_FOR_EACH_H_\nnamespace tbb {\ntemplate <typename Iterator, typename Body>\ninline void parallel_for_each(Iterator first, Iterator last, const Body & body) {\n  for (; first != last; ++first) body(*first);\n}\ntemplate <typename Container, typename Body>\ninline void parallel_for_each(Container & c, const Body & body) {\n  for (auto & item : c) body(item);\n}\ntemplate <typename Container, typename Body>\ninline void parallel_for_each(const Container & c, const Body & body) {\n  for (const auto & item : c) body(item);\n}\n}  // namespace tbb\n#endif\n"],
)

write_file(
    name = "gen_tbb_blocked_range2d_h",
    out = "_gen/include/tbb/blocked_range2d.h",
    content = ["#pragma once\n#include \"tbb/blocked_range.h\"\nnamespace tbb {\ntemplate <typename RowValue, typename ColValue = RowValue>\nclass blocked_range2d {\npublic:\n  using row_range_type = blocked_range<RowValue>;\n  using col_range_type = blocked_range<ColValue>;\n  blocked_range2d(RowValue rbegin, RowValue rend, std::size_t rgrain, ColValue cbegin, ColValue cend, std::size_t cgrain = 1)\n    : rows_(rbegin, rend, rgrain), cols_(cbegin, cend, cgrain) {}\n  blocked_range2d(RowValue rbegin, RowValue rend, ColValue cbegin, ColValue cend)\n    : rows_(rbegin, rend), cols_(cbegin, cend) {}\n  blocked_range2d(blocked_range2d & r, split) : rows_(r.rows_, split()), cols_(r.cols_, split()) {}\n  const row_range_type & rows() const { return rows_; }\n  const col_range_type & cols() const { return cols_; }\nprivate:\n  row_range_type rows_;\n  col_range_type cols_;\n};\n}  // namespace tbb\n"],
)

write_file(
    name = "gen_tbb_parallel_reduce_h",
    out = "_gen/include/tbb/parallel_reduce.h",
    content = ["#pragma once\n#include \"tbb/blocked_range.h\"\nnamespace tbb {\ntemplate <typename Range, typename Body>\nvoid parallel_reduce(const Range & range, Body & body) { body(range); }\ntemplate <typename Range, typename Value, typename RealBody, typename Reduction>\nValue parallel_reduce(const Range & range, const Value & identity, const RealBody & real_body, const Reduction &) {\n  return real_body(range, identity);\n}\n}  // namespace tbb\n"],
)

write_file(
    name = "gen_tbb_global_control_h",
    out = "_gen/include/tbb/global_control.h",
    content = ["#pragma once\n#include <cstddef>\nnamespace tbb {\nclass global_control {\npublic:\n  enum parameter { max_allowed_parallelism, thread_stack_size };\n  global_control(parameter, std::size_t) {}\n  static std::size_t active_value(parameter) { return 1; }\n};\n}  // namespace tbb\n"],
)

write_file(
    name = "gen_imath_vec_h",
    out = "_gen/include/ImathVec.h",
    content = ["#pragma once\n#include <cmath>\n#include <iostream>\nnamespace Imath {\ntemplate <typename T> struct Vec2 {\n  T x = 0, y = 0;\n  constexpr Vec2() = default;\n  constexpr explicit Vec2(T a) : x(a), y(a) {}\n  constexpr Vec2(T a, T b) : x(a), y(b) {}\n  template <typename S> constexpr Vec2(const Vec2<S> & o) : x(static_cast<T>(o.x)), y(static_cast<T>(o.y)) {}\n  T & operator[](int i) { return i == 0 ? x : y; }\n  const T & operator[](int i) const { return i == 0 ? x : y; }\n  Vec2 operator+(const Vec2 & o) const { return Vec2(x + o.x, y + o.y); }\n  Vec2 operator-(const Vec2 & o) const { return Vec2(x - o.x, y - o.y); }\n  Vec2 operator*(T s) const { return Vec2(x * s, y * s); }\n  Vec2 operator/(T s) const { return Vec2(x / s, y / s); }\n  Vec2 & operator+=(const Vec2 & o) { x += o.x; y += o.y; return *this; }\n  Vec2 & operator-=(const Vec2 & o) { x -= o.x; y -= o.y; return *this; }\n  Vec2 & operator*=(T s) { x *= s; y *= s; return *this; }\n  bool operator==(const Vec2 & o) const { return x == o.x && y == o.y; }\n  bool operator!=(const Vec2 & o) const { return !(*this == o); }\n  T dot(const Vec2 & o) const { return x * o.x + y * o.y; }\n  T length() const { return static_cast<T>(std::sqrt(x * x + y * y)); }\n  T length2() const { return x * x + y * y; }\n  const Vec2 & normalize() { T l = length(); if (l > 0) { x /= l; y /= l; } return *this; }\n  Vec2 normalized() const { Vec2 r(*this); r.normalize(); return r; }\n};\ntemplate <typename T> struct Vec3 {\n  T x = 0, y = 0, z = 0;\n  constexpr Vec3() = default;\n  constexpr explicit Vec3(T a) : x(a), y(a), z(a) {}\n  constexpr Vec3(T a, T b, T c) : x(a), y(b), z(c) {}\n  template <typename S> constexpr Vec3(const Vec3<S> & o) : x(static_cast<T>(o.x)), y(static_cast<T>(o.y)), z(static_cast<T>(o.z)) {}\n  T & operator[](int i) { return i == 0 ? x : (i == 1 ? y : z); }\n  const T & operator[](int i) const { return i == 0 ? x : (i == 1 ? y : z); }\n  Vec3 operator+(const Vec3 & o) const { return Vec3(x + o.x, y + o.y, z + o.z); }\n  Vec3 operator-(const Vec3 & o) const { return Vec3(x - o.x, y - o.y, z - o.z); }\n  Vec3 operator*(T s) const { return Vec3(x * s, y * s, z * s); }\n  Vec3 operator/(T s) const { return Vec3(x / s, y / s, z / s); }\n  Vec3 & operator+=(const Vec3 & o) { x += o.x; y += o.y; z += o.z; return *this; }\n  Vec3 & operator-=(const Vec3 & o) { x -= o.x; y -= o.y; z -= o.z; return *this; }\n  Vec3 & operator*=(T s) { x *= s; y *= s; z *= s; return *this; }\n  bool operator==(const Vec3 & o) const { return x == o.x && y == o.y && z == o.z; }\n  bool operator!=(const Vec3 & o) const { return !(*this == o); }\n  T dot(const Vec3 & o) const { return x * o.x + y * o.y + z * o.z; }\n  Vec3 cross(const Vec3 & o) const { return Vec3(y * o.z - z * o.y, z * o.x - x * o.z, x * o.y - y * o.x); }\n  T length() const { return static_cast<T>(std::sqrt(x * x + y * y + z * z)); }\n  T length2() const { return x * x + y * y + z * z; }\n  const Vec3 & normalize() { T l = length(); if (l > 0) { x /= l; y /= l; z /= l; } return *this; }\n  Vec3 normalized() const { Vec3 r(*this); r.normalize(); return r; }\n};\nusing V2s = Vec2<short>;\nusing V2i = Vec2<int>;\nusing V2f = Vec2<float>;\nusing V2d = Vec2<double>;\nusing V3s = Vec3<short>;\nusing V3i = Vec3<int>;\nusing V3f = Vec3<float>;\nusing V3d = Vec3<double>;\n}  // namespace Imath\n"],
)

write_file(
    name = "gen_imath_box_h",
    out = "_gen/include/ImathBox.h",
    content = ["#pragma once\n#include \"ImathVec.h\"\nnamespace Imath {\ntemplate <typename V> struct Box {\n  V min, max;\n  Box() { makeEmpty(); }\n  explicit Box(const V & p) : min(p), max(p) {}\n  Box(const V & minV, const V & maxV) : min(minV), max(maxV) {}\n  void makeEmpty() { min = V(1); max = V(-1); }\n  void extendBy(const V & p) {\n    if (isEmpty()) { min = max = p; return; }\n    if (p.x < min.x) min.x = p.x;\n    if (p.y < min.y) min.y = p.y;\n    if (p.x > max.x) max.x = p.x;\n    if (p.y > max.y) max.y = p.y;\n  }\n  void extendBy(const Box & b) { if (!b.isEmpty()) { extendBy(b.min); extendBy(b.max); } }\n  V size() const { return isEmpty() ? V(0) : (max - min); }\n  V center() const { return (max + min) / 2; }\n  bool intersects(const V & p) const { return p.x >= min.x && p.x <= max.x && p.y >= min.y && p.y <= max.y; }\n  bool intersects(const Box & b) const { return min.x <= b.max.x && max.x >= b.min.x && min.y <= b.max.y && max.y >= b.min.y; }\n  bool isEmpty() const { return max.x < min.x || max.y < min.y; }\n  bool hasVolume() const { return max.x > min.x && max.y > min.y; }\n  bool operator==(const Box & o) const { return min == o.min && max == o.max; }\n  bool operator!=(const Box & o) const { return !(*this == o); }\n};\nusing Box2s = Box<V2s>;\nusing Box2i = Box<V2i>;\nusing Box2f = Box<V2f>;\nusing Box2d = Box<V2d>;\nusing Box3s = Box<V3s>;\nusing Box3i = Box<V3i>;\nusing Box3f = Box<V3f>;\nusing Box3d = Box<V3d>;\n}  // namespace Imath\n"],
)

write_file(
    name = "gen_imath_fun_h",
    out = "_gen/include/ImathFun.h",
    content = ["#pragma once\nnamespace Imath {\ntemplate <typename T, typename Q> constexpr T lerp(T a, T b, Q t) { return static_cast<T>(a + (b - a) * t); }\ntemplate <typename T> constexpr T clamp(T a, T l, T h) { return (a < l) ? l : ((a > h) ? h : a); }\ntemplate <typename T> constexpr int sign(T a) { return (a > T(0)) ? 1 : ((a < T(0)) ? -1 : 0); }\ntemplate <typename T> constexpr T abs(T a) { return (a < T(0)) ? -a : a; }\n}  // namespace Imath\n"],
)

write_file(
    name = "gen_imath_math_h",
    out = "_gen/include/ImathMath.h",
    content = ["#pragma once\n#include <cmath>\nnamespace Imath {\ntemplate <typename T> struct Math {\n  static T sqrt(T x) { return std::sqrt(x); }\n  static T fabs(T x) { return std::fabs(x); }\n  static T sin(T x) { return std::sin(x); }\n  static T cos(T x) { return std::cos(x); }\n  static T atan2(T y, T x) { return std::atan2(y, x); }\n  static T floor(T x) { return std::floor(x); }\n  static T ceil(T x) { return std::ceil(x); }\n  static T exp(T x) { return std::exp(x); }\n  static T log(T x) { return std::log(x); }\n  static T pow(T x, T y) { return std::pow(x, y); }\n};\n}  // namespace Imath\n"],
)

write_file(
    name = "gen_eigen_fft_h",
    out = "_gen/include/unsupported/Eigen/FFT",
    content = ["#pragma once\n#include <complex>\n#include <vector>\n#include <Eigen/Core>\nnamespace Eigen {\ntemplate <typename T> class FFT {\npublic:\n  using Scalar = T;\n  using Complex = std::complex<T>;\n  void fwd(std::vector<Complex> & dst, const std::vector<Scalar> & src) { dst.assign(src.size(), Complex(0, 0)); }\n  void fwd(std::vector<Complex> & dst, const std::vector<Complex> & src) { dst = src; }\n  void inv(std::vector<Scalar> & dst, const std::vector<Complex> & src) { dst.assign(src.size(), Scalar(0)); }\n  void inv(std::vector<Complex> & dst, const std::vector<Complex> & src) { dst = src; }\n  template <typename InputDerived, typename ComplexDerived>\n  void fwd(MatrixBase<ComplexDerived> & dst, const MatrixBase<InputDerived> & src) { dst.derived().resize(src.size()); dst.setZero(); }\n  template <typename OutputDerived, typename ComplexDerived>\n  void inv(MatrixBase<OutputDerived> & dst, const MatrixBase<ComplexDerived> & src) { dst.derived().resize(src.size()); dst.setZero(); }\n};\n}  // namespace Eigen\n"],
)

