load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@point_cloud_transport//:point_cloud_transport": "@point_cloud_transport//:point_cloud_transport_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@point_cloud_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

cc_library(
    name = "draco_point_cloud_transport_library",
    srcs = [
        "src/cloud.cpp",
        "src/draco_publisher.cpp",
        "src/draco_subscriber.cpp",
        "src/manifest.cpp",
    ],
    hdrs = [
        "include/draco_point_cloud_transport/cloud.hpp",
        "include/draco_point_cloud_transport/cloud/impl/cloud.hpp",
        "include/draco_point_cloud_transport/conversion_utilities.h",
        "include/draco_point_cloud_transport/draco_publisher.hpp",
        "include/draco_point_cloud_transport/draco_subscriber.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/draco_point_cloud_transport",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "draco_point_cloud_transport",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":draco_point_cloud_transport_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":draco_point_cloud_transport"],
    package_xml = "package.xml",
    plugin_category = "point_cloud_transport",
    plugins = ["draco_plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@pluginlib//:ament_package",
        "@point_cloud_interfaces//:ament_package",
        "@point_cloud_transport//:ament_package",
        "@rclcpp//:ament_package",
        "@rcpputils//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "pluginlib",
        "point_cloud_interfaces",
        "point_cloud_transport",
        "rclcpp",
        "rcpputils",
        "sensor_msgs",
        "std_msgs",
    ],
    cmake_export_targets = False,
    headers = [
        "include/draco_point_cloud_transport/cloud.hpp",
        "include/draco_point_cloud_transport/cloud/impl/cloud.hpp",
        "include/draco_point_cloud_transport/conversion_utilities.h",
        "include/draco_point_cloud_transport/draco_publisher.hpp",
        "include/draco_point_cloud_transport/draco_subscriber.hpp",
    ],
    include_prefix = "",
    libraries = [":draco_point_cloud_transport"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@pluginlib//:ament_package",
        "@point_cloud_interfaces//:ament_package",
        "@point_cloud_transport//:ament_package",
        "@rclcpp//:ament_package",
        "@rcpputils//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
