)

write_file(
    name = "spawner_py_src",
    out = "spawner_entry.py",
    content = [
        "import fcntl, os, sys, types",
        "os.environ.setdefault('ROS_HOME', os.path.join(os.environ.get('TEST_TMPDIR', '/tmp'), f'ros_home_{os.getpid()}'))",
        "class Timeout(Exception): pass",
        "class FileLock:",
        "    def __init__(self, path, timeout=-1):",
        "        self.path, self.timeout, self._fd = path, timeout, None",
        "    @property",
        "    def is_locked(self):",
        "        return self._fd is not None",
        "    def acquire(self, timeout=-1):",
        "        os.makedirs(os.path.dirname(self.path), exist_ok=True)",
        "        self._fd = open(self.path, 'w')",
        "        fcntl.flock(self._fd, fcntl.LOCK_EX)",
        "        return self",
        "    def release(self):",
        "        if self._fd is not None:",
        "            fcntl.flock(self._fd, fcntl.LOCK_UN)",
        "            self._fd.close()",
        "            self._fd = None",
        "    def __enter__(self):",
        "        return self.acquire()",
        "    def __exit__(self, *args):",
        "        self.release()",
        "m = types.ModuleType('filelock')",
        "m.Timeout, m.FileLock = Timeout, FileLock",
        "sys.modules['filelock'] = m",
        "from controller_manager.spawner import main",
        "if __name__ == '__main__':",
        "    sys.exit(main())",
        "",
    ],
)

py_binary(
    name = "spawner",
    srcs = [":spawner_py_src"],
    main = "spawner_entry.py",
    deps = ["@controller_manager//:controller_manager_py"],
)

ament_index(
    name = "controller_manager_spawner_index",
    export_name = "controller_manager",
    lib_data = [":spawner"],
)

