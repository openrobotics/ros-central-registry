load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@nav_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
]

cc_library(
    name = "imu_bias_remover_library",
    srcs = ["src/imu_bias_remover.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "imu_bias_remover",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":imu_bias_remover_library"],
)

cc_library(
    name = "imu_integrator_library",
    srcs = ["src/imu_integrator.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "imu_integrator",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":imu_integrator_library"],
)

rclcpp_components_register_node(
    name = "imu_bias_remover_node",
    component = ":imu_integrator",
    node_name = "imu_bias_remover_node",
    plugin = "imu_processors::ImuIntegrator",
)

rclcpp_components_register_node(
    name = "imu_integrator_node",
    component = ":imu_integrator",
    node_name = "imu_integrator_node",
    plugin = "imu_processors::ImuIntegrator",
)

rclcpp_components_register_nodes(
    name = "imu_bias_remover_components",
    component = ":imu_bias_remover",
    plugins = ["imu_processors::ImuBiasRemover"],
)

ament_index(
    name = "ament_index",
    components = [
        ":imu_bias_remover_node_record",
        ":imu_integrator_node_record",
        ":imu_bias_remover_components",
    ],
    lib_data = [
        ":imu_bias_remover_node",
        ":imu_integrator_node",
    ],
    libraries = [
        ":imu_bias_remover",
        ":imu_integrator",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_targets = False,
    libraries = [
        ":imu_bias_remover",
        ":imu_integrator",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
