load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

cc_library(
    name = "test_main_library",
    srcs = ["_test_main.cpp"],
    hdrs = ["test.hpp"],
    local_defines = ros_local_defines(),
    deps = ["//:backward_library"],
)

cc_shared_library(
    name = "test_main",
    dynamic_deps = ["//:backward"],
    exports_filter = [":test_main_library"],
    deps = [":test_main_library"],
)

collect_transitive_dynamic_deps(
    name = "test_transitive_dynamic_deps",
    dynamic_deps = [
        "//:backward",
        ":test_main",
    ],
    visibility = ["//visibility:private"],
)

[cc_test(
    name = "test_{}".format(test),
    srcs = [
        "{}.cpp".format(test),
        "test.hpp",
    ],
    dynamic_deps = [":test_transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = [
        ":test_main_library",
        "//:backward_library",
    ],
) for test in [
    "test",
    "stacktrace",
    "rectrace",
    "select_signals",
    "suicide",
]]
