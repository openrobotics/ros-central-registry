load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

### LIBRARIES

HEADERS = glob(
    [
        "include/**/*.hpp",
        "include/**/*.h",
    ],
    allow_empty = True,
)

cc_library(
    name = "backward_library",
    srcs = ["src/backward.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    linkopts = select({
        "@platforms//os:windows": ["-ldbghelp"],
        "//conditions:default": [],
    }),
    local_defines = ros_local_defines(),
)

cc_shared_library(
    name = "backward",
    exports_filter = [":backward_library"],
    deps = [":backward_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":backward"],
    visibility = ["//visibility:private"],
)

### TESTING

cc_library(
    name = "test_main_library",
    srcs = ["test/_test_main.cpp"],
    hdrs = ["test/test.hpp"],
    local_defines = ros_local_defines(),
    deps = [":backward_library"],
)

cc_shared_library(
    name = "test_main",
    dynamic_deps = [":backward"],
    exports_filter = [":test_main_library"],
    deps = [":test_main_library"],
)

collect_transitive_dynamic_deps(
    name = "test_transitive_dynamic_deps",
    dynamic_deps = [
        ":backward",
        ":test_main",
    ],
    visibility = ["//visibility:private"],
)

[
    cc_test(
        name = "test_{}".format(test),
        srcs = [
            "test/{}.cpp".format(test),
            "test/test.hpp",
        ],
        dynamic_deps = [":test_transitive_dynamic_deps"],
        local_defines = ros_local_defines(),
        deps = [
            ":backward_library",
            ":test_main_library",
        ],
    )
    for test in [
        "test",
        "stacktrace",
        "rectrace",
        "select_signals",
        "suicide",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    build_type = "cmake",
    cmake = glob(["cmake/**"]),
    headers = HEADERS,
    include_prefix = "",
    libraries = [":backward"],
    package_xml = "package.xml",
    deps = [
        "@rosdistro//:ament_package",
    ],
)
