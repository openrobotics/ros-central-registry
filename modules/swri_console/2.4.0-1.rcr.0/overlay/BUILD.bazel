load("@qt//:qt.bzl", "qt_cc_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosbag2_transport//:rosbag2_transport": "@rosbag2_transport//:rosbag2_transport_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

CC_DEPS = [
    "@rcl_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@qtbase//:core",
    "@qtbase//:gui",
    "@qtsvg//:svg",
    "@qtbase//:widgets",
]

cc_library(
    name = "swri_console_headers",
    hdrs = [
        "include/swri_console/bag_reader.h",
        "include/swri_console/console_master.h",
        "include/swri_console/console_window.h",
        "include/swri_console/log_database.h",
        "include/swri_console/log_database_proxy_model.h",
        "include/swri_console/node_click_handler.h",
        "include/swri_console/node_list_model.h",
        "include/swri_console/ros_thread.h",
        "include/swri_console/rosout_log_loader.h",
        "include/swri_console/settings_keys.h",
        "include/swri_console/unix_signal_handler.h",
        ":gen_ui_console_window_h",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/swri_console",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

qt_cc_binary(
    name = "swri_console",
    srcs = [
        "src/bag_reader.cpp",
        "src/console_master.cpp",
        "src/console_window.cpp",
        "src/log_database.cpp",
        "src/log_database_proxy_model.cpp",
        "src/main.cpp",
        "src/node_click_handler.cpp",
        "src/node_list_model.cpp",
        "src/ros_thread.cpp",
        "src/rosout_log_loader.cpp",
        "src/settings_keys.cpp",
        "src/unix_signal_handler.cpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtsvg//:svg_shared",
        "@qtbase//:widgets_shared",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/swri_console",
    ],
    local_defines = ros_local_defines() + [
        "SWRI_CONSOLE_HAS_LOGGER_SERVICES",
        "_FILE_OFFSET_BITS=64",
    ],
    moc_hdrs = [
        "include/swri_console/bag_reader.h",
        "include/swri_console/console_master.h",
        "include/swri_console/console_window.h",
        "include/swri_console/log_database.h",
        "include/swri_console/log_database_proxy_model.h",
        "include/swri_console/node_click_handler.h",
        "include/swri_console/node_list_model.h",
        "include/swri_console/ros_thread.h",
        "include/swri_console/rosout_log_loader.h",
        "include/swri_console/unix_signal_handler.h",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":swri_console_headers"],
)

genrule(
    name = "gen_ui_console_window_h",
    srcs = ["ui/console_window.ui"],
    outs = ["_gen/include/ui_console_window.h"],
    cmd = "$(execpath @qtbase//:uic) $(location ui/console_window.ui) -o $@",
    tools = ["@qtbase//:uic"],
)

ament_index(
    name = "ament_index",
    lib_data = [":swri_console"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_storage_mcap//:ament_package",
        "@rosbag2_transport//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "Qt5Core",
        "Qt5Gui",
        "Qt5Widgets",
        "ament_cmake",
        "rcl_interfaces",
        "rclcpp",
        "rcutils",
        "rmw",
        "rosbag2_storage",
        "rosbag2_transport",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_storage_mcap//:ament_package",
        "@rosbag2_transport//:ament_package",
    ],
)
