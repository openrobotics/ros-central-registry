load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosbag2_transport//:rosbag2_transport": "@rosbag2_transport//:rosbag2_transport_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

CC_DEPS = [
    "@rcl_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rules_qt//:qt_core",
    "@rules_qt//:qt_gui",
    "@rules_qt//:qt_svg",
    "@rules_qt//:qt_widgets",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "swri_console",
    srcs = [":gen_swri_console_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":gen_ui_console_window_h"],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/swri_console",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines() + [
        "SWRI_CONSOLE_HAS_LOGGER_SERVICES",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

write_file(
    name = "gen_swri_console_stub_cpp",
    out = "_gen/swri_console_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

genrule(
    name = "gen_ui_console_window_h",
    srcs = ["ui/console_window.ui"],
    outs = ["_gen/include/ui_console_window.h"],
    cmd = select({
        "@rules_qt//:linux_x86_64": "$(location @qt_linux_x86_64//:uic) $(location ui/console_window.ui) -o $@",
        "@rules_qt//:linux_aarch64": "$(location @qt_linux_aarch64//:uic) $(location ui/console_window.ui) -o $@",
        "@platforms//os:windows": "$(location @qt_windows_x86_64//:uic) $(location ui/console_window.ui) -o $@",
        "@rules_qt//:osx_x86_64": "$(location @qt_mac_x86_64//:uic) $(location ui/console_window.ui) -o $@",
        "@rules_qt//:osx_arm64": "$(location @qt_mac_aarch64//:uic) $(location ui/console_window.ui) -o $@",
    }),
    tools = select({
        "@rules_qt//:linux_x86_64": ["@qt_linux_x86_64//:uic"],
        "@rules_qt//:linux_aarch64": ["@qt_linux_aarch64//:uic"],
        "@platforms//os:windows": ["@qt_windows_x86_64//:uic"],
        "@rules_qt//:osx_arm64": ["@qt_mac_aarch64//:uic"],
        "@rules_qt//:osx_x86_64": ["@qt_mac_x86_64//:uic"],
    }),
)

ament_index(
    name = "ament_index",
    lib_data = [":swri_console"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_storage_mcap//:ament_package",
        "@rosbag2_transport//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "ament_cmake",
        "Qt5Core",
        "Qt5Gui",
        "Qt5Widgets",
        "rclcpp",
        "rcl_interfaces",
        "rcutils",
        "rosbag2_storage",
        "rosbag2_transport",
        "rmw",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_storage_mcap//:ament_package",
        "@rosbag2_transport//:ament_package",
    ],
)
