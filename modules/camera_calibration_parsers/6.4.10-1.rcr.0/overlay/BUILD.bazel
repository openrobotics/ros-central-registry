load("@ament_cmake_gen_version_h//:defs.bzl", "generate_version_h")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

generate_version_h(
    name = "version_h",
    out = "include/camera_calibration_parsers/version.h",
)

HEADERS = [
    "include/camera_calibration_parsers/parse.hpp",
    "include/camera_calibration_parsers/parse_ini.hpp",
    "include/camera_calibration_parsers/parse_yml.hpp",
    "include/camera_calibration_parsers/visibility_control.hpp",
] + [":version_h"]

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
}

cc_library(
    name = "camera_calibration_parsers_library",
    srcs = [
        "src/parse.cpp",
        "src/parse_ini.cpp",
        "src/parse_yml.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["CAMERA_CALIBRATION_PARSERS_BUILDING_DLL"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "camera_calibration_parsers",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":camera_calibration_parsers_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":camera_calibration_parsers",
        "@sensor_msgs//:cc_shared",
    ],
)

cc_binary(
    name = "convert",
    srcs = ["src/convert.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [":camera_calibration_parsers_library"],
)

ament_package(
    name = "ament_package",
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_camera_calibration_parsers",
    executables = [":convert"],
    headers = HEADERS,
    libraries = [":camera_calibration_parsers"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@yaml_cpp_vendor//:ament_package",
    ],
)
