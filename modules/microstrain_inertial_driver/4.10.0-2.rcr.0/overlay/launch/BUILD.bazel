load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "microstrain_launch.py",
        "microstrain_lifecycle_launch.py",
    ],
)

launch_ros_binary(
    name = "microstrain_launch",
    src = "microstrain_launch.py",
    deps = [
        "//:microstrain_inertial_driver_node",
        "@ament_index_python",
        "@lifecycle_msgs//:py",
    ],
)

launch_ros_binary(
    name = "microstrain_lifecycle_launch",
    src = "microstrain_lifecycle_launch.py",
    deps = [
        "//:microstrain_inertial_driver_lifecycle_node",
        "@ament_index_python",
        "@lifecycle_msgs//:py",
    ],
)
