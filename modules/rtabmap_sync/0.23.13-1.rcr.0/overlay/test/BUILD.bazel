    "@rtabmap_msgs//:cc",
    "@sensor_msgs//:cc",
]

cc_library(
    name = "test_helpers",
    testonly = True,
    textual_hdrs = glob(["*.hpp"]),
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_common_data_subscriber",
    srcs = ["test_common_data_subscriber.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "GTEST_LINKED_AS_SHARED_LIBRARY=1",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":test_helpers",
        "//:rtabmap_sync_library",
        "//:rtabmap_sync_plugins_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

