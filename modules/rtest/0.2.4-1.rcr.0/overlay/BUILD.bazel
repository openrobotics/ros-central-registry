load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@action_msgs//:cc_shared": "@action_msgs//:cc",
    "@rcl//:rcl": "@rcl//:rcl_library",
    "@rcl_action//:rcl_action": "@rcl_action//:rcl_action_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

CC_DEPS = [
    "@googletest//:gtest",
    "@rcl//:wait_for_entity_helpers",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.variant",
]

cc_library(
    name = "rtest_common_library",
    srcs = [
        "src/logger_mock.cpp",
        "src/registry_cleaner.cpp",
        "src/static_registry.cpp",
    ],
    hdrs = [
        "include/jazzy/rtest/action_client_base.hpp",
        "include/jazzy/rtest/action_server_base.hpp",
        "include/jazzy/rtest/client_base.hpp",
        "include/jazzy/rtest/service_base.hpp",
        "include/kilted/rtest/action_server_base.hpp",
        "include/kilted/rtest/client_base.hpp",
        "include/kilted/rtest/service_base.hpp",
        "include/lyrical/rtest/action_server_base.hpp",
        "include/lyrical/rtest/client_base.hpp",
        "include/lyrical/rtest/service_base.hpp",
        "include/rtest/action_client_mock.hpp",
        "include/rtest/action_server_mock.hpp",
        "include/rtest/create_timer_mock.hpp",
        "include/rtest/includes_mock.hpp",
        "include/rtest/logger_mock.hpp",
        "include/rtest/mock_defines.hpp",
        "include/rtest/publisher_mock.hpp",
        "include/rtest/registry_cleaner.hpp",
        "include/rtest/ros_versions.hpp",
        "include/rtest/service_client_mock.hpp",
        "include/rtest/service_mock.hpp",
        "include/rtest/single_instance.hpp",
        "include/rtest/static_registry.hpp",
        "include/rtest/subscription_mock.hpp",
        "include/rtest/test_clock.hpp",
    ],
    includes = [
        "include",
        "include/lyrical",
        "include/rtest",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rtest_common",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rtest_common_library"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":rtest_common",
    ],
    package_xml = "package.xml",
    deps = [
        "@action_msgs//:ament_package",
        "@ament_clang_tidy//:ament_package",
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rcl//:ament_package",
        "@rcl_action//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@ros_environment//:ament_package",
    ],
)

ament_package(
    cmake = [
        "cmake/test-doublesConfig.cmake.in",
        "cmake/test_tools_add_doubles.cmake",
    ],
    cmake_export_dependencies_list = [
        "GTest",
        "rcl_action",
        "rclcpp",
        "rclcpp_action",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "rtest_targets",
    cmake_extras = ["test_tools_add_doubles.cmake"],
    headers = [
        "include/jazzy/rtest/action_client_base.hpp",
        "include/jazzy/rtest/action_server_base.hpp",
        "include/jazzy/rtest/client_base.hpp",
        "include/jazzy/rtest/service_base.hpp",
        "include/kilted/rtest/action_server_base.hpp",
        "include/kilted/rtest/client_base.hpp",
        "include/kilted/rtest/service_base.hpp",
        "include/lyrical/rtest/action_server_base.hpp",
        "include/lyrical/rtest/client_base.hpp",
        "include/lyrical/rtest/service_base.hpp",
        "include/rtest/action_client_mock.hpp",
        "include/rtest/action_server_mock.hpp",
        "include/rtest/create_timer_mock.hpp",
        "include/rtest/includes_mock.hpp",
        "include/rtest/logger_mock.hpp",
        "include/rtest/mock_defines.hpp",
        "include/rtest/publisher_mock.hpp",
        "include/rtest/registry_cleaner.hpp",
        "include/rtest/ros_versions.hpp",
        "include/rtest/service_client_mock.hpp",
        "include/rtest/service_mock.hpp",
        "include/rtest/single_instance.hpp",
        "include/rtest/static_registry.hpp",
        "include/rtest/subscription_mock.hpp",
        "include/rtest/test_clock.hpp",
    ],
    headers_strip_prefixes = [
        "include",
        "include/lyrical",
    ],
    include_prefix = "",
    libraries = [
        ":rtest_common",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@action_msgs//:ament_package",
        "@ament_clang_tidy//:ament_package",
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rcl//:ament_package",
        "@rcl_action//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@ros_environment//:ament_package",
    ],
)
