package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rcl//:rcl": "@rcl//:rcl_library",
    "@rcl_action//:rcl_action": "@rcl_action//:rcl_action_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
}

CC_DEPS = [
    "@action_msgs//:cc",
    "@googletest//:gtest",
    "@rcl//:wait_for_entity_helpers",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.variant",
]

cc_library(
    name = "rtest_common_library",
    srcs = [
        "src/logger_mock.cpp",
        "src/registry_cleaner.cpp",
        "src/static_registry.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/lyrical",
        "include/rtest",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rtest_common",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":rtest_common_library"],
)

