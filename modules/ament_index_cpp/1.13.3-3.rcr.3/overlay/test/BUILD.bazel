load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

[cc_test(
    name = "ament_index_cpp_{}".format(test),
    srcs = ["{}.cpp".format(test)],
    data = [
        "prefix1/share/ament_index/resource_index/packages/bar",
        "prefix1/share/ament_index/resource_index/packages/foo",
        "prefix1/share/ament_index/resource_index/resource_type1/.hidden_dir1/.hidden_file2",
        "prefix1/share/ament_index/resource_index/resource_type1/.hidden_file1",
        "prefix1/share/ament_index/resource_index/resource_type1/bar",
        "prefix1/share/ament_index/resource_index/resource_type1/foo",
        "prefix1/share/ament_index/resource_index/resource_type1/subdir1/resource",
        "prefix1/share/ament_index/resource_index/resource_type2/foo",
        "prefix1/share/ament_index/resource_index/resource_type4/foo",
        "prefix1/share/ament_index/resource_index/resource_type5/foo",
        "prefix2/share/ament_index/resource_index/packages/bar",
        "prefix2/share/ament_index/resource_index/packages/baz",
        "prefix2/share/ament_index/resource_index/resource_type2/bar",
        "prefix2/share/ament_index/resource_index/resource_type3/bar",
        "prefix2/share/ament_index/resource_index/resource_type5/foo",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = [
        "//:ament_index_cpp_library",
        "@rosdistro//cc:googletest",
        "@rules_cc//cc/runfiles",
    ],
) for test in [
    "utest",
    "utest_deprecated",
]]
