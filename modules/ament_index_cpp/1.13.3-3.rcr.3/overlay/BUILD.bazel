load("@ament_cmake_gen_version_h//:defs.bzl", "generate_version_h")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

HEADERS = glob([
    "include/**/*.hpp",
    "include/**/*.h",
])

# Real ament_index_cpp relies on ament_cmake_gen_version_h's CMake macro
# (ament_generate_version_header()) to generate this at configure time --
# get_package_share_path() (used by consumers like rosx_introspection) is
# only available from 1.13.2 onward, gated via version.h's *_VERSION_GTE.
generate_version_h(
    name = "version_h",
    out = "include/ament_index_cpp/version.h",
)

cc_library(
    name = "ament_index_cpp_library",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = HEADERS + [":version_h"],
    includes = ["include"],
    local_defines = ros_local_defines(),
)

cc_shared_library(
    name = "ament_index_cpp",
    exports_filter = [":ament_index_cpp_library"],
    deps = [":ament_index_cpp_library"],
)

### TRANSITIVELY COLLECT ALL DYNAMIC DEPS TO ENSURE LINKING WORKS

# This is a workaround for the fact that dynamic_deps does not work transitively.
# So, if you have a (foo -> bar -> baz) dynamic_dep dep chain, the symbols from
# foo will not be available to baz at compile-time. This resolves that by running
# an aspect over the dynamic_deps attribute to collect everything in the chain.

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":ament_index_cpp"],
    visibility = ["//visibility:private"],
)

### TESTING

[
    cc_test(
        name = "ament_index_cpp_{}".format(test),
        srcs = ["test/{}.cpp".format(test)],
        data = glob([
            "test/prefix1/**",
            "test/prefix2/**",
        ]),
        dynamic_deps = [":transitive_dynamic_deps"],
        local_defines = ros_local_defines(),
        deps = [
            ":ament_index_cpp_library",
            "@rosdistro//cc:googletest",
            "@rules_cc//cc/runfiles",
        ],
    )
    for test in [
        "utest",
        "utest_deprecated",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_ament_index_cpp",
    headers = HEADERS + [":version_h"],
    libraries = [":ament_index_cpp"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
