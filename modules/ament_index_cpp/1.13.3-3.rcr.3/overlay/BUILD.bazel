load("@ament_cmake_gen_version_h//:defs.bzl", "generate_version_h")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/ament_index_cpp/get_package_prefix.hpp",
    "include/ament_index_cpp/get_package_share_directory.hpp",
    "include/ament_index_cpp/get_package_share_path.hpp",
    "include/ament_index_cpp/get_packages_with_prefixes.hpp",
    "include/ament_index_cpp/get_resource.hpp",
    "include/ament_index_cpp/get_resources.hpp",
    "include/ament_index_cpp/get_search_paths.hpp",
    "include/ament_index_cpp/has_resource.hpp",
    "include/ament_index_cpp/visibility_control.h",
]

generate_version_h(
    name = "version_h",
    out = "include/ament_index_cpp/version.h",
)

cc_library(
    name = "ament_index_cpp_library",
    srcs = [
        "src/get_package_prefix.cpp",
        "src/get_package_share_directory.cpp",
        "src/get_package_share_path.cpp",
        "src/get_packages_with_prefixes.cpp",
        "src/get_resource.cpp",
        "src/get_resources.cpp",
        "src/get_search_paths.cpp",
        "src/has_resource.cpp",
    ],
    hdrs = HEADERS + [":version_h"],
    includes = ["include"],
    local_defines = ros_local_defines(),
)

cc_shared_library(
    name = "ament_index_cpp",
    exports_filter = ["//:__subpackages__"],
    deps = [":ament_index_cpp_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":ament_index_cpp"],
)

ament_package(
    name = "ament_package",
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_ament_index_cpp",
    headers = HEADERS + [":version_h"],
    libraries = [":ament_index_cpp"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
