load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
    "@yaets//:yaets": "@yaets//:yaets_library",
}

CC_DEPS = [
    "@easynav_common//:easynav_common_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "easynav_costmap_common_library",
    srcs = ["src/easynav_costmap_common/costmap_2d.cpp"],
    hdrs = [
        "include/easynav_costmap_common/cost_values.hpp",
        "include/easynav_costmap_common/costmap_2d.hpp",
        "include/easynav_costmap_common/geometry_utils.hpp",
        "include/easynav_costmap_common/occ_grid_values.hpp",
    ],
    includes = [
        "include",
        "include/easynav_costmap_common",
        "tests",
    ],
    local_defines = ros_local_defines() + ["EASYNAV_DEBUG_WITH_YAETS"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "easynav_costmap_common",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":easynav_costmap_common_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":easynav_costmap_common"],
)

ament_index(
    name = "ament_index",
    libraries = [":easynav_costmap_common"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@easynav_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@yaets//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "easynav_common",
        "geometry_msgs",
        "nav_msgs",
        "rclcpp",
        "tf2_geometry_msgs",
    ],
    cmake_export_name = "export_easynav_costmap_common",
    headers = [
        "include/easynav_costmap_common/cost_values.hpp",
        "include/easynav_costmap_common/costmap_2d.hpp",
        "include/easynav_costmap_common/geometry_utils.hpp",
        "include/easynav_costmap_common/occ_grid_values.hpp",
    ],
    libraries = [":easynav_costmap_common"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@easynav_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@yaets//:ament_package",
    ],
)
