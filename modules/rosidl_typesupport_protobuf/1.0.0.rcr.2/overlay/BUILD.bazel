# Imports

load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

## LIBRARIES

HEADERS = glob(["include/**"])

DEPENDENCIES = {
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
}

cc_library(
    name = "rosidl_typesupport_protobuf_library",
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rosidl_typesupport_protobuf",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rosidl_typesupport_protobuf_library"],
    deps = [":rosidl_typesupport_protobuf_library"],
)

## PYTHON MODULES

py_library(
    name = "rosidl_typesupport_protobuf_py",
    srcs = glob(["rosidl_typesupport_protobuf/**/*.py"]),
    deps = [
        "@rosidl_pycommon",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [":rosidl_typesupport_protobuf"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_generator_c//:ament_package",
        "@rosidl_pycommon//:ament_package",
        "@rosidl_runtime_c//:ament_package",
    ],
)
