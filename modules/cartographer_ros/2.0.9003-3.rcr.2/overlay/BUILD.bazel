)

launch_ros_binary(
    name = "launch_backpack_3d_launch_py",
    src = "launch/backpack_3d.launch.py",
    data = ["@robot_state_publisher//:ament_index"],
)

launch_ros_binary(
    name = "launch_demo_backpack_2d_launch_py",
