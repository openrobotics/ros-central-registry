cc_library(
    name = "cartographer_ros_library",
    srcs = [
        "src/assets_writer.cpp",
        "src/map_builder_bridge.cpp",
        "src/metrics/family_factory.cpp",
        "src/metrics/internal/family.cpp",
        "src/metrics/internal/histogram.cpp",
