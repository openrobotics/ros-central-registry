        "src/submap.cpp",
        "src/tf_bridge.cpp",
        "src/time_conversion.cpp",
        "src/trajectory_options.cpp",
        "src/urdf_reader.cpp",
    ],
    hdrs = HDRS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

# Upstream builds cartographer_ros as a static library (plain add_library), so
# each executable only links the objects it references. A shared library would
# put offline_node.cpp's DEFINE_bool(collect_metrics) into every process next
# to node_main.cpp's, and gflags aborts on the duplicate definition.
collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

EXECUTABLES = {
    "cartographer_assets_writer": "src/assets_writer_main.cpp",
    "cartographer_node": "src/node_main.cpp",
    "cartographer_occupancy_grid_node": "src/occupancy_grid_node_main.cpp",
    "cartographer_offline_node": "src/offline_node_main.cpp",
    "cartographer_pbstream_map_publisher": "src/pbstream_map_publisher_main.cpp",
    "cartographer_pbstream_to_ros_map": "src/pbstream_to_ros_map_main.cpp",
    "cartographer_rosbag_validate": "src/rosbag_validate_main.cpp",
}

[
    cc_binary(
        name = name,
        srcs = [src],
        data = [":ament_index"],
        dynamic_deps = [":transitive_dynamic_deps"],
        local_defines = ros_local_defines(),
        deps = DEPENDENCIES.values() + CC_DEPS + [":cartographer_ros_library"],
    )
    for name, src in EXECUTABLES.items()
]

