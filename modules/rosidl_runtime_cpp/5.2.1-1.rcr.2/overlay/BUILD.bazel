load("@rosdistro//ament:defs.bzl", "ament_package", "register_ament_resource")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/rosidl_runtime_cpp/action_type_support_decl.hpp",
    "include/rosidl_runtime_cpp/bounded_vector.hpp",
    "include/rosidl_runtime_cpp/buffer__traits.hpp",
    "include/rosidl_runtime_cpp/message_initialization.hpp",
    "include/rosidl_runtime_cpp/message_type_support_decl.hpp",
    "include/rosidl_runtime_cpp/service_type_support_decl.hpp",
    "include/rosidl_runtime_cpp/traits.hpp",
    "include/rosidl_runtime_cpp/type_description/field__struct.hpp",
    "include/rosidl_runtime_cpp/type_description/field_type__struct.hpp",
    "include/rosidl_runtime_cpp/type_description/individual_type_description__struct.hpp",
    "include/rosidl_runtime_cpp/type_description/key_value__struct.hpp",
    "include/rosidl_runtime_cpp/type_description/type_description__struct.hpp",
    "include/rosidl_runtime_cpp/type_description/type_source__struct.hpp",
    "include/rosidl_typesupport_cpp/action_type_support.hpp",
    "include/rosidl_typesupport_cpp/message_type_support.hpp",
    "include/rosidl_typesupport_cpp/service_type_support.hpp",
]

DEPENDENCIES = {
    "@rosidl_buffer//:rosidl_buffer": "@rosidl_buffer//:rosidl_buffer_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
}

cc_library(
    name = "rosidl_runtime_cpp_library",
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rosidl_runtime_cpp",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rosidl_runtime_cpp_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rosidl_runtime_cpp"],
    visibility = ["//visibility:public"],
)

register_ament_resource(
    name = "res_rosidl_runtime_packages",
    category = "rosidl_runtime_packages",
    content = "",
)

ament_package(
    name = "ament_package",
    data = [":res_rosidl_runtime_packages"],
    headers = HEADERS,
    include_prefix = "",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@performance_test_fixture//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_buffer//:ament_package",
        "@rosidl_runtime_c//:ament_package",
    ],
)
