load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

[cc_test(
    name = test.removesuffix(".py"),
    timeout = "moderate",
    srcs = ["{}.cpp".format(test)],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = [
        "//:rosidl_runtime_cpp_library",
        "@rosdistro//cc:googletest",
    ],
) for test in ["test_bounded_vector"]]

[cc_test(
    name = name,
    timeout = "moderate",
    srcs = ["benchmark/{}.cpp".format(name)],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    tags = ["manual"],
    deps = [
        "//:rosidl_runtime_cpp_library",
        "@google_benchmark//:benchmark_main",
        "@performance_test_fixture",
    ],
) for name in ["benchmark_bounded_vector"]]
