# gz_transport_vendor: vendors gz-transport (version 15) from the Bazel
# Central Registry module `gz-transport` (shared library wrappers live in
# @rosdistro//cc/gz) and installs it like colcon's ament_vendor() does
# (opt/gz_transport_vendor/...).

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc/gz:defs.bzl", "gz_install_files", "gz_install_headers", "gz_vendor_hooks")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### UMBRELLA HEADERS (generated by CMake's gz_auto_headers.hh.in in colcon)

write_file(
    name = "umbrella_transport_hh",
    out = "include/gz/transport.hh",
    content = [
        "#include <gz/transport/config.hh>",
        "#include <gz/transport/AdvertiseOptions.hh>",
        "#include <gz/transport/CIface.h>",
        "#include <gz/transport/Clock.hh>",
        "#include <gz/transport/Exception.hh>",
        "#include <gz/transport/HandlerStorage.hh>",
        "#include <gz/transport/Helpers.hh>",
        "#include <gz/transport/MessageInfo.hh>",
        "#include <gz/transport/NetUtils.hh>",
        "#include <gz/transport/Node.hh>",
        "#include <gz/transport/NodeOptions.hh>",
        "#include <gz/transport/NodeShared.hh>",
        "#include <gz/transport/Publisher.hh>",
        "#include <gz/transport/RepHandler.hh>",
        "#include <gz/transport/ReqHandler.hh>",
        "#include <gz/transport/SubscribeOptions.hh>",
        "#include <gz/transport/SubscriptionHandler.hh>",
        "#include <gz/transport/TopicStatistics.hh>",
        "#include <gz/transport/TopicStorage.hh>",
        "#include <gz/transport/TopicUtils.hh>",
        "#include <gz/transport/TransportTypes.hh>",
        "#include <gz/transport/Uuid.hh>",
        "#include <gz/transport/WaitHelpers.hh>",
        "",
    ],
)

write_file(
    name = "umbrella_log_hh",
    out = "include/gz/transport/log.hh",
    content = [
        "#include <gz/transport/config.hh>",
        "#include <gz/transport/log/Batch.hh>",
        "#include <gz/transport/log/Descriptor.hh>",
        "#include <gz/transport/log/Log.hh>",
        "#include <gz/transport/log/Message.hh>",
        "#include <gz/transport/log/MsgIter.hh>",
        "#include <gz/transport/log/Playback.hh>",
        "#include <gz/transport/log/QualifiedTime.hh>",
        "#include <gz/transport/log/QueryOptions.hh>",
        "#include <gz/transport/log/Recorder.hh>",
        "#include <gz/transport/log/SqlStatement.hh>",
        "#include <gz/transport/log/detail/QueryOptions.hh>",
        "",
    ],
)

write_file(
    name = "umbrella_parameters_hh",
    out = "include/gz/transport/parameters.hh",
    content = [
        "#include <gz/transport/config.hh>",
        "#include <gz/transport/parameters/Client.hh>",
        "#include <gz/transport/parameters/Interface.hh>",
        "#include <gz/transport/parameters/Registry.hh>",
        "#include <gz/transport/parameters/result.hh>",
        "",
    ],
)

### LIBRARIES (gz-transport::core / ::log / ::parameters)

alias(
    name = "gz_transport",
    actual = "@rosdistro//cc/gz:gz-transport",
)

cc_library(
    name = "gz_transport_library",
    hdrs = ["include/gz/transport.hh"],
    includes = ["include"],
    deps = ["@rosdistro//cc/gz:gz-transport_library"],
)

alias(
    name = "gz_transport_log",
    actual = "@rosdistro//cc/gz:gz-transport-log",
)

cc_library(
    name = "gz_transport_log_library",
    hdrs = ["include/gz/transport/log.hh"],
    includes = ["include"],
    deps = ["@rosdistro//cc/gz:gz-transport-log_library"],
)

alias(
    name = "gz_transport_parameters",
    actual = "@rosdistro//cc/gz:gz-transport-parameters",
)

cc_library(
    name = "gz_transport_parameters_library",
    hdrs = ["include/gz/transport/parameters.hh"],
    includes = ["include"],
    deps = ["@rosdistro//cc/gz:gz-transport-parameters_library"],
)

### INSTALL LAYOUT (opt/gz_transport_vendor/...)

VENDOR = "gz_transport_vendor"

PREFIX = "opt/" + VENDOR

gz_install_headers(
    name = "install_headers",
    include_only = "gz/",
    prefix = PREFIX + "/include/gz/transport15",
    strip_prefixes = [
        "include",
        "log/include",
        "parameters/include",
    ],
    deps = [
        ":gz_transport_library",
        ":gz_transport_log_library",
        ":gz_transport_parameters_library",
        "@rosdistro//cc/gz:gz-transport-log_library",
        "@rosdistro//cc/gz:gz-transport-parameters_library",
        "@rosdistro//cc/gz:gz-transport_library",
    ],
)

gz_install_files(
    name = "install_libraries",
    srcs = [
        ":gz_transport",
        ":gz_transport_log",
        ":gz_transport_parameters",
    ],
    flatten = True,
    prefix = PREFIX + "/lib",
)

ENV_HOOKS = gz_vendor_hooks(
    name = "install_hooks",
    vendor = VENDOR,
)

### PACKAGING

ament_package(
    name = "ament_package",
    env_hooks = ENV_HOOKS,
    install = [
        ":install_headers",
        ":install_hooks",
        ":install_libraries",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_test//:ament_package",
        "@ament_cmake_vendor_package//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@gz_cmake_vendor//:ament_package",
        "@gz_math_vendor//:ament_package",
        "@gz_msgs_vendor//:ament_package",
        "@gz_tools_vendor//:ament_package",
        "@gz_utils_vendor//:ament_package",
        "@rosdistro//:ament_package",
        "@zenoh_cpp_vendor//:ament_package",
    ],
)
