load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/fuse_graphs/hash_graph.h",
        "include/fuse_graphs/hash_graph.hpp",
        "include/fuse_graphs/hash_graph_params.h",
        "include/fuse_graphs/hash_graph_params.hpp",
    ] + [
    ],
    includes = [],
    deps = ["@rosdistro//cc:ceres_library"],
)

DEPENDENCIES = {
    "@fuse_core//:fuse_core": "@fuse_core//:fuse_core_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:boost.chrono_shared": "@rosdistro//cc:boost.chrono",
    "@rosdistro//cc:boost.container_shared": "@rosdistro//cc:boost.container",
    "@rosdistro//cc:boost.iostreams_shared": "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:boost.serialization_shared": "@rosdistro//cc:boost.serialization",
    "@rosdistro//cc:boost.thread_shared": "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:ceres": "@rosdistro//cc:ceres_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:glog": "@rosdistro//cc:glog_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.algorithm",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "fuse_graphs_library",
    srcs = ["src/hash_graph.cpp"],
    hdrs = [
        "include/fuse_graphs/hash_graph.h",
        "include/fuse_graphs/hash_graph.hpp",
        "include/fuse_graphs/hash_graph_params.h",
        "include/fuse_graphs/hash_graph_params.hpp",
    ] + [
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/fuse_graphs",
        "test",
    ],
    local_defines = ros_local_defines() + [
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "fuse_graphs",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":fuse_graphs_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":fuse_graphs"],
)

ament_index(
    name = "ament_index",
    libraries = [":fuse_graphs"],
    package_xml = "package.xml",
    plugin_category = "fuse_core",
    plugins = ["fuse_plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@fuse_core//:ament_package",
        "@gtest_vendor//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
    ],
)

ament_package(
    cmake = ["boost-extras.cmake"],
    cmake_export_dependencies_list = [
        "Ceres",
        "ament_cmake_ros",
        "fuse_core",
        "pluginlib",
        "rclcpp",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "fuse_graphs-export",
    cmake_extras = ["boost-extras.cmake"],
    cmake_strip_prefix = "",
    headers = [
        "include/fuse_graphs/hash_graph.h",
        "include/fuse_graphs/hash_graph.hpp",
        "include/fuse_graphs/hash_graph_params.h",
        "include/fuse_graphs/hash_graph_params.hpp",
    ],
    include_prefix = "",
    libraries = [":fuse_graphs"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@fuse_core//:ament_package",
        "@gtest_vendor//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
    ],
)
