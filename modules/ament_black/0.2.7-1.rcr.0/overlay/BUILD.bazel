load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

py_library(
    name = "ament_black",
    srcs = glob(["ament_black/**/*.py"]),
    imports = ["."],
    deps = [
        requirement("packaging"),
    ],
)

py_pytest(
    name = "test_cli",
    srcs = ["test/test_cli.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":ament_black"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_programs = {"ament_black": "ament_black.pytest_marker"},
    package_xml = "package.xml",
    python = [":ament_black"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
