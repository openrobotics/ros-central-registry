load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rcl//:rcl": "@rcl//:rcl_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
}

cc_test(
    name = "test_collector",
    timeout = "moderate",
    srcs = ["collector/test_collector.cpp"],
    dynamic_deps = DEPENDENCIES.keys() + ["//:libstatistics_collector"],
    local_defines = ros_local_defines(),
    deps = [
        "//:libstatistics_collector_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_moving_average_statistics",
    timeout = "moderate",
    srcs = ["moving_average_statistics/test_moving_average_statistics.cpp"],
    dynamic_deps = DEPENDENCIES.keys() + ["//:libstatistics_collector"],
    local_defines = ros_local_defines(),
    deps = [
        "//:libstatistics_collector_library",
        "@rosdistro//cc:googletest",
    ],
)

[cc_test(
    name = name,
    timeout = "moderate",
    srcs = ["topic_statistics_collector/{}.cpp".format(name)],
    dynamic_deps = DEPENDENCIES.keys() + ["//:libstatistics_collector"],
    local_defines = ros_local_defines(),
    deps = [
        "//:libstatistics_collector_library",
        "@rcl//:rcl_library",
        "@rmw//:rmw_library",
        "@rosdistro//cc:googletest",
    ],
) for name in [
    "test_received_message_age",
    "test_received_message_period",
]]

[cc_test(
    name = name,
    timeout = "moderate",
    srcs = ["benchmark/{}.cpp".format(name)],
    dynamic_deps = DEPENDENCIES.keys() + ["//:libstatistics_collector"],
    tags = ["manual"],
    deps = [
        "//:libstatistics_collector_library",
        "@google_benchmark//:benchmark_main",
        "@performance_test_fixture",
    ],
) for name in ["benchmark_iterative"]]
