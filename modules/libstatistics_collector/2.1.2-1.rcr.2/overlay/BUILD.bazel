load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosidl_default_generators//:defs.bzl", "default_generators")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/libstatistics_collector/collector/collector.hpp",
    "include/libstatistics_collector/collector/generate_statistics_message.hpp",
    "include/libstatistics_collector/collector/metric_details_interface.hpp",
    "include/libstatistics_collector/moving_average_statistics/moving_average.hpp",
    "include/libstatistics_collector/moving_average_statistics/types.hpp",
    "include/libstatistics_collector/topic_statistics_collector/constants.hpp",
    "include/libstatistics_collector/topic_statistics_collector/received_message_age.hpp",
    "include/libstatistics_collector/topic_statistics_collector/received_message_period.hpp",
    "include/libstatistics_collector/topic_statistics_collector/topic_statistics_collector.hpp",
    "include/libstatistics_collector/visibility_control.hpp",
]

DEPENDENCIES = {
    "@rcl//:rcl": "@rcl//:rcl_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@statistics_msgs//:cc_shared": "@statistics_msgs//:cc",
}

cc_library(
    name = "libstatistics_collector_library",
    srcs = [
        "src/libstatistics_collector/collector/collector.cpp",
        "src/libstatistics_collector/collector/generate_statistics_message.cpp",
        "src/libstatistics_collector/moving_average_statistics/moving_average.cpp",
        "src/libstatistics_collector/moving_average_statistics/types.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "libstatistics_collector",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":libstatistics_collector_library"],
)

default_generators(
    dependencies = [
        "@std_msgs",
    ],
    package_xml = "package.xml",
    deps = [
        "//test/msg:DummyCustomHeaderMessage",
        "//test/msg:DummyMessage",
    ],
)

ament_package(
    name = "ament_package",
    cmake_extras = [
        "rosidl_cmake-extras.cmake",
        "rosidl_cmake_aggregate_target-extras.cmake",
    ],
    headers = HEADERS,
    include_prefix = "",
    install = [":rosidl_skip_install"],
    libraries = [":libstatistics_collector"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@performance_test_fixture//:ament_package",
        "@rcl//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@statistics_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
