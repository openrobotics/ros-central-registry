load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
}

cc_library(
    name = "mode_library",
    srcs = [
        "src/system_modes/mode.cpp",
        "src/system_modes/mode_handling.cpp",
        "src/system_modes/mode_impl.cpp",
        "src/system_modes/mode_inference.cpp",
        "src/system_modes/mode_observer.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["SYSTEMMODES_BUILDING_LIBRARY"],
    deps = DEPENDENCIES.values() + [
        "@builtin_interfaces//:cc",
        "@system_modes_msgs//:cc",
    ],
)

cc_shared_library(
    name = "mode",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":mode_library"],
    deps = [":mode_library"],
)

### EXECUTABLES

BINARY_DEPENDENCIES = DEPENDENCIES | {
    ":mode": ":mode_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = BINARY_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

cc_library(
    name = "mode_manager_library",
    srcs = ["src/system_modes/mode_manager.cpp"],
    local_defines = ros_local_defines(),
    deps = BINARY_DEPENDENCIES.values(),
)

cc_binary(
    name = "mode_manager",
    srcs = ["src/mode_manager_node.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = BINARY_DEPENDENCIES.values() + [":mode_manager_library"],
)

cc_library(
    name = "mode_monitor_library",
    srcs = ["src/system_modes/mode_monitor.cpp"],
    local_defines = ros_local_defines(),
    deps = BINARY_DEPENDENCIES.values(),
)

cc_binary(
    name = "mode_monitor",
    srcs = ["src/mode_monitor_node.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = BINARY_DEPENDENCIES.values() + [":mode_monitor_library"],
)

# Helper node used by the (launch_testing) integration tests; installed to
# lib/system_modes/ like upstream.
cc_binary(
    name = "modes_observer_test_node",
    srcs = ["test/launchtest/modes_observer_test_node.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = BINARY_DEPENDENCIES.values(),
)

### AMENT INDEX

DATA = glob(["launch/**"])

ament_index(
    name = "ament_index",
    data = DATA,
    executables = [
        ":mode_manager",
        ":mode_monitor",
        ":modes_observer_test_node",
    ],
    libraries = [":mode"],
    package_xml = "package.xml",
    deps = [
        "@system_modes_msgs//:ament_index",
    ],
)

### TESTS

# configure_file(test/modefiles.h.in system_modes/modefiles.h): points the
# tests at the yaml fixtures, resolved relative to the test runfiles.
genrule(
    name = "modefiles_h",
    srcs = [
        "test/modefiles.h.in",
        "test/test_modes.yaml",
        "test/test_modes_rules.yaml",
        "test/test_modes_wrong.yaml",
    ],
    outs = ["test/generated/system_modes/modefiles.h"],
    cmd = "sed" +
          " -e 's|@MODE_FILE_CORRECT@|$(rootpath test/test_modes.yaml)|'" +
          " -e 's|@MODE_FILE_RULES@|$(rootpath test/test_modes_rules.yaml)|'" +
          " -e 's|@MODE_FILE_WRONG@|$(rootpath test/test_modes_wrong.yaml)|'" +
          " $(location test/modefiles.h.in) > $@",
)

cc_library(
    name = "modefiles",
    hdrs = [":modefiles_h"],
    includes = ["test/generated"],
    visibility = ["//visibility:private"],
)

[
    cc_test(
        name = test,
        timeout = "moderate",
        srcs = ["test/{}.cpp".format(test)],
        data = glob(["test/*.yaml"]) + [":ament_index"],
        dynamic_deps = [":transitive_dynamic_deps"],
        local_defines = ros_local_defines(),
        deps = BINARY_DEPENDENCIES.values() + extra + [
            ":modefiles",
            "@rosdistro//cc:googletest",
        ],
    )
    for test, extra in {
        "test_default_mode": [],
        "test_mode": [],
        "test_mode_handling": [],
        "test_mode_inference": [],
        "test_mode_manager": [":mode_manager_library"],
        "test_mode_monitor": [":mode_monitor_library"],
        "test_mode_observer": [],
        "test_state_and_mode_struct": [],
    }.items()
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rclcpp",
        "rclcpp_lifecycle",
        "lifecycle_msgs",
        "system_modes_msgs",
    ],
    cmake_export_targets = False,
    data = DATA,
    executables = [
        ":mode_manager",
        ":mode_monitor",
        ":modes_observer_test_node",
    ],
    headers = HEADERS,
    include_prefix = "",
    libraries = [":mode"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_flake8//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pep257//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2run//:ament_package",
        "@rosdistro//:ament_package",
        "@system_modes_msgs//:ament_package",
    ],
)
