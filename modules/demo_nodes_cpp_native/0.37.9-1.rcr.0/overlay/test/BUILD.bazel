load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

exports_files([
    "talker.regex",
    "test_executables_tutorial.py.in",
])

cmake_configure_file(
    name = "test_tutorial_talker_py",
    src = "test_executables_tutorial.py.in",
    out = "test_tutorial_talker.py",
    defines = [
        "DEMO_NODES_CPP_EXECUTABLE=../demo_nodes_cpp_native+/talker",
        "DEMO_NODES_CPP_EXPECTED_OUTPUT=../demo_nodes_cpp_native+/test/talker",
    ],
)
