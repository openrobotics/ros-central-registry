load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rmw_fastrtps_cpp//:rmw_fastrtps_cpp": "@rmw_fastrtps_cpp//:rmw_fastrtps_cpp_library",
}

cc_library(
    name = "talker_native_library",
    srcs = ["src/talker.cpp"],
    hdrs = glob(
        [
            "include/**/*.hpp",
            "include/**/*.h",
        ],
        allow_empty = True,
    ),
    includes = ["include"],
    local_defines = ros_local_defines() + ["DEMO_NODES_CPP_NATIVE_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + [
        "@example_interfaces//:cc",
    ],
)

cc_shared_library(
    name = "talker_native",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":talker_native_library"],
    deps = [":talker_native_library"],
)

rclcpp_components_register_node(
    name = "talker",
    component = ":talker_native",
    executor = "SingleThreadedExecutor",
    node_name = "talker",
    plugin = "demo_nodes_cpp_native::Talker",
)

cmake_configure_file(
    name = "test_tutorial_talker_py",
    src = "test/test_executables_tutorial.py.in",
    out = "test_tutorial_talker.py",
    defines = [
        "DEMO_NODES_CPP_EXECUTABLE=../demo_nodes_cpp_native+/talker",
        "DEMO_NODES_CPP_EXPECTED_OUTPUT=../demo_nodes_cpp_native+/test/talker",
    ],
)

launch_ros_test(
    name = "test_tutorial_talker",
    src = "test_tutorial_talker_py",
    data = [
        "test/talker.regex",
        ":talker",
    ],
    env = {
        "RCL_ASSERT_RMW_ID_MATCHES": "rmw_fastrtps_cpp",
        "RMW_IMPLEMENTATION": "rmw_fastrtps_cpp",
    },
    deps = [
        "@rules_python//python/runfiles",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    components = [":talker_record"],
    executables = [":talker"],
    libraries = [":talker_native"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@example_interfaces//:ament_package",
        "@launch//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rmw_fastrtps_cpp//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
