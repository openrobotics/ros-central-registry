load("@rosdistro//ament:ament_resource.bzl", "register_ament_resource")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT-0",
    ],
)

register_ament_resource(
    name = "res_rqml_plugin",
    category = "rqml_plugin",
    content = "plugins:\n  - id: rqml_plugin_example.example_plugin\n    name: \"Example Plugin\"\n    group: \"Examples\"  # Prefer to use already commonly used groups unless necessary\n    path: \"share/rqml_plugin_example/qml/ExamplePlugin.qml\"\n    single_instance: false  # Rarely needed, typically should be users choice\n",
)

ament_index(
    name = "ament_index",
    data = [
        "qml/ExamplePlugin.qml",
    ],
    package_xml = "package.xml",
    deps = [
        ":res_rqml_plugin",
        "@ament_cmake//:ament_package",
        "@qml6_ros2_plugin//:ament_package",
        "@rqml_core//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        ":res_rqml_plugin",
        "@ament_cmake//:ament_package",
        "@qml6_ros2_plugin//:ament_package",
        "@rqml_core//:ament_package",
    ],
)
