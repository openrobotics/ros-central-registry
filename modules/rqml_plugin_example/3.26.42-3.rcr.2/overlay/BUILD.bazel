load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:ament_resource.bzl", "register_ament_resource")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT-0",
    ],
)

register_ament_resource(
    name = "res_rqml_plugin",
    category = "rqml_plugin",
    content = "plugins:\n  - id: rqml_plugin_example.example_plugin\n    name: \"Example Plugin\"\n    group: \"Examples\"  # Prefer to use already commonly used groups unless necessary\n    path: \"share/rqml_plugin_example/qml/ExamplePlugin.qml\"\n    single_instance: false  # Rarely needed, typically should be users choice\n",
)

write_file(
    name = "gen_extra_0",
    out = "_gen/share/ament_index/resource_index/rqml_plugin/rqml_plugin_example",
    content = ["plugins:\n  - id: rqml_plugin_example.example_plugin\n    name: \"Example Plugin\"\n    group: \"Examples\"  # Prefer to use already commonly used groups unless necessary\n    path: \"share/rqml_plugin_example/qml/ExamplePlugin.qml\"\n    single_instance: false  # Rarely needed, typically should be users choice\n"],
)

pkg_files(
    name = "pkg_files_extra_0",
    srcs = [":gen_extra_0"],
    prefix = "share/ament_index/resource_index/rqml_plugin",
)

ament_index(
    name = "ament_index",
    data = ["qml/ExamplePlugin.qml"],
    package_xml = "package.xml",
    deps = [
        ":res_rqml_plugin",
        "@ament_cmake//:ament_package",
        "@qml6_ros2_plugin//:ament_package",
        "@rqml_core//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    install = [":pkg_files_extra_0"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        ":res_rqml_plugin",
        "@ament_cmake//:ament_package",
        "@qml6_ros2_plugin//:ament_package",
        "@rqml_core//:ament_package",
    ],
)
