load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@autoware_utils_system//:autoware_utils_system": "@autoware_utils_system//:autoware_utils_system_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

CC_DEPS = [
    "@autoware_internal_debug_msgs//:cc",
    "@autoware_internal_msgs//:cc",
    "@diagnostic_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@std_msgs//:cc",
]

cc_library(
    name = "autoware_utils_debug_library",
    srcs = ["src/time_keeper.cpp"],
    hdrs = [
        "include/autoware_utils_debug/debug_publisher.hpp",
        "include/autoware_utils_debug/debug_traits.hpp",
        "include/autoware_utils_debug/processing_time_publisher.hpp",
        "include/autoware_utils_debug/published_time_publisher.hpp",
        "include/autoware_utils_debug/time_keeper.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/autoware_utils_debug",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "autoware_utils_debug",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":autoware_utils_debug_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":autoware_utils_debug"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@autoware_cmake//:ament_package",
        "@autoware_internal_debug_msgs//:ament_package",
        "@autoware_internal_msgs//:ament_package",
        "@autoware_lint_common//:ament_package",
        "@autoware_utils_system//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    colcon_hooks = False,
    install_package_xml = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@autoware_cmake//:ament_package",
        "@autoware_internal_debug_msgs//:ament_package",
        "@autoware_internal_msgs//:ament_package",
        "@autoware_lint_common//:ament_package",
        "@autoware_utils_system//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
