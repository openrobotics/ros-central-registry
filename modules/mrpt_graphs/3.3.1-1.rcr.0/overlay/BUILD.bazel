load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@mrpt_io//:mrpt_io": "@mrpt_io//:mrpt_io_library",
    "@mrpt_poses//:mrpt_poses": "@mrpt_poses//:mrpt_poses_library",
    "@mrpt_viz//:mrpt_viz": "@mrpt_viz//:mrpt_viz_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
    "@rosdistro//cc:zmq": "@rosdistro//cc:zmq_library",
    "@rosdistro//cc:zstd": "@rosdistro//cc:zstd_library",
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
]

cc_library(
    name = "mrpt_graphs_library",
    srcs = [
        "src/CGraphPartitioner.cpp",
        "src/ScalarFactorGraph.cpp",
        "src/registerAllClasses.cpp",
    ],
    hdrs = [
        "include/mrpt/graphs.h",
        "include/mrpt/graphs/CAStarAlgorithm.h",
        "include/mrpt/graphs/CDirectedGraph.h",
        "include/mrpt/graphs/CDirectedTree.h",
        "include/mrpt/graphs/CGraphPartitioner.h",
        "include/mrpt/graphs/CNetworkOfPoses.h",
        "include/mrpt/graphs/CNetworkOfPoses_impl.h",
        "include/mrpt/graphs/ScalarFactorGraph.h",
        "include/mrpt/graphs/THypothesis.h",
        "include/mrpt/graphs/TNodeAnnotations.h",
        "include/mrpt/graphs/TNodeID.h",
        "include/mrpt/graphs/dijkstra.h",
        "include/mrpt/graphs/registerAllClasses.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_graphs",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mrpt_graphs_library"],
)

cc_library(
    name = "_bindings.cpython-314-x86_64-linux-gnu_library",
    srcs = ["python_bindings/mrpt_graphs_py.cpp"],
    hdrs = [
        "include/mrpt/graphs.h",
        "include/mrpt/graphs/CAStarAlgorithm.h",
        "include/mrpt/graphs/CDirectedGraph.h",
        "include/mrpt/graphs/CDirectedTree.h",
        "include/mrpt/graphs/CGraphPartitioner.h",
        "include/mrpt/graphs/CNetworkOfPoses.h",
        "include/mrpt/graphs/CNetworkOfPoses_impl.h",
        "include/mrpt/graphs/ScalarFactorGraph.h",
        "include/mrpt/graphs/THypothesis.h",
        "include/mrpt/graphs/TNodeAnnotations.h",
        "include/mrpt/graphs/TNodeID.h",
        "include/mrpt/graphs/dijkstra.h",
        "include/mrpt/graphs/registerAllClasses.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":mrpt_graphs_library"],
)

cc_shared_library(
    name = "_bindings.cpython-314-x86_64-linux-gnu",
    dynamic_deps = DEPENDENCIES.keys() + [":mrpt_graphs"],
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "mrpt/graphs/_bindings.so",
    deps = [":_bindings.cpython-314-x86_64-linux-gnu_library"],
)

py_library(
    name = "mrpt",
    srcs = ["python/mrpt/graphs/__init__.py"],
    imports = ["python"],
    deps = [
        "@mrpt_io//:mrpt",
        "@mrpt_poses//:mrpt",
        "@mrpt_viz//:mrpt",
    ],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_graphs",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_graphs": [
            "libmrpt_graphs.so.3.3",
            "libmrpt_graphs.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_common//:ament_package",
        "@mrpt_io//:ament_package",
        "@mrpt_poses//:ament_package",
        "@mrpt_viz//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    egg_info = False,
    headers = [
        "include/mrpt/graphs.h",
        "include/mrpt/graphs/CAStarAlgorithm.h",
        "include/mrpt/graphs/CDirectedGraph.h",
        "include/mrpt/graphs/CDirectedTree.h",
        "include/mrpt/graphs/CGraphPartitioner.h",
        "include/mrpt/graphs/CNetworkOfPoses.h",
        "include/mrpt/graphs/CNetworkOfPoses_impl.h",
        "include/mrpt/graphs/ScalarFactorGraph.h",
        "include/mrpt/graphs/THypothesis.h",
        "include/mrpt/graphs/TNodeAnnotations.h",
        "include/mrpt/graphs/TNodeID.h",
        "include/mrpt/graphs/dijkstra.h",
        "include/mrpt/graphs/registerAllClasses.h",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mrpt_graphs",
    ],
    package_xml = "package.xml",
    python = [
        ":mrpt",
        ":_bindings.cpython-314-x86_64-linux-gnu",
    ],
    python_strip_prefix = "python",
    sonames = {
        "mrpt_graphs": [
            "libmrpt_graphs.so.3.3",
            "libmrpt_graphs.so.3.3.1",
        ],
    },
    deps = [":ament_index"] + [
        "@mrpt_common//:ament_package",
        "@mrpt_io//:ament_package",
        "@mrpt_poses//:ament_package",
        "@mrpt_viz//:ament_package",
    ],
)
