load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines", "ros_version_header")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/joint_limits/data_structures.hpp",
        "include/joint_limits/joint_limiter_interface.hpp",
        "include/joint_limits/joint_limits.hpp",
        "include/joint_limits/joint_limits_helpers.hpp",
        "include/joint_limits/joint_limits_rosparam.hpp",
        "include/joint_limits/joint_limits_urdf.hpp",
        "include/joint_limits/joint_saturation_limiter.hpp",
        "include/joint_limits/joint_soft_limiter.hpp",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/joint_limits",
        "_gen/include/joint_limits/joint_limits",
        "include",
        "include/joint_limits",
    ],
)

DEPENDENCIES = {
    "@backward_ros//:backward": "@backward_ros//:backward_library",
    "@generate_parameter_library//:rsl": "@generate_parameter_library//:rsl_library",
    "@lifecycle_msgs//:cc_shared": "@lifecycle_msgs//:cc",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libcap": "@rosdistro//cc:libcap_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@trajectory_msgs//:cc_shared": "@trajectory_msgs//:cc",
    "@urdf//:urdf": "@urdf//:urdf_library",
}

CC_DEPS = [
    "@generate_parameter_library//:generate_parameter_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:fmt",
]

cc_library(
    name = "joint_limiter_interface_library",
    srcs = ["src/joint_limiter_interface.cpp"],
    hdrs = [
        "include/joint_limits/data_structures.hpp",
        "include/joint_limits/joint_limiter_interface.hpp",
        "include/joint_limits/joint_limits.hpp",
        "include/joint_limits/joint_limits_helpers.hpp",
        "include/joint_limits/joint_limits_rosparam.hpp",
        "include/joint_limits/joint_limits_urdf.hpp",
        "include/joint_limits/joint_saturation_limiter.hpp",
        "include/joint_limits/joint_soft_limiter.hpp",
    ] + [":version_h"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/joint_limits",
        "_gen/include/joint_limits/joint_limits",
        "include",
        "include/joint_limits",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "joint_limiter_interface",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":joint_limiter_interface_library"],
)

cc_library(
    name = "joint_limits_helpers_library",
    srcs = ["src/joint_limits_helpers.cpp"],
    hdrs = [
        "include/joint_limits/data_structures.hpp",
        "include/joint_limits/joint_limiter_interface.hpp",
        "include/joint_limits/joint_limits.hpp",
        "include/joint_limits/joint_limits_helpers.hpp",
        "include/joint_limits/joint_limits_rosparam.hpp",
        "include/joint_limits/joint_limits_urdf.hpp",
        "include/joint_limits/joint_saturation_limiter.hpp",
        "include/joint_limits/joint_soft_limiter.hpp",
    ] + [":version_h"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/joint_limits",
        "_gen/include/joint_limits/joint_limits",
        "include",
        "include/joint_limits",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "joint_limits_helpers",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":joint_limits_helpers_library"],
)

cc_library(
    name = "joint_saturation_limiter_library",
    srcs = [
        "src/joint_range_limiter.cpp",
        "src/joint_saturation_limiter.cpp",
        "src/joint_soft_limiter.cpp",
    ],
    hdrs = [
        "include/joint_limits/data_structures.hpp",
        "include/joint_limits/joint_limiter_interface.hpp",
        "include/joint_limits/joint_limits.hpp",
        "include/joint_limits/joint_limits_helpers.hpp",
        "include/joint_limits/joint_limits_rosparam.hpp",
        "include/joint_limits/joint_limits_urdf.hpp",
        "include/joint_limits/joint_saturation_limiter.hpp",
        "include/joint_limits/joint_soft_limiter.hpp",
    ] + [":version_h"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/joint_limits",
        "_gen/include/joint_limits/joint_limits",
        "include",
        "include/joint_limits",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":joint_limiter_interface_library",
        ":joint_limits_helpers_library",
    ],
)

cc_shared_library(
    name = "joint_saturation_limiter",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":joint_limiter_interface",
        ":joint_limits_helpers",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":joint_saturation_limiter_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":joint_limiter_interface",
        ":joint_limits_helpers",
        ":joint_saturation_limiter",
    ],
)

ros_version_header(
    name = "version_h",
    out = "_gen/include/joint_limits/joint_limits/version.h",
)

