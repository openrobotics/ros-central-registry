load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

# Tests run with cwd = <runfiles>/_main, but this repository's own test data
# lives under <runfiles>/<canonical repo name>/ when it is an external module.
REPO_RUNFILES_PREFIX = "../%s/" % (repo_name() or "_main")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@backward_ros//:backward": "@backward_ros//:backward_library",
    "@generate_parameter_library//:rsl": "@generate_parameter_library//:generate_parameter_library",
    "@lifecycle_msgs//:cc_shared": "@lifecycle_msgs//:cc",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libcap": "@rosdistro//cc:libcap_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@trajectory_msgs//:cc_shared": "@trajectory_msgs//:cc",
    "@urdf//:urdf": "@urdf//:urdf_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:fmt",
]

exports_files([
    "joint_limits_rosparam.launch.py",
    "joint_limits_rosparam.yaml",
    "joint_limits_rosparam_test.cpp",
    "joint_limits_urdf_test.cpp",
    "joint_saturation_limiter_param.yaml",
    "test_joint_limiter.hpp",
    "test_joint_range_limiter.cpp",
    "test_joint_saturation_limiter.cpp",
    "test_joint_saturation_limiter.hpp",
    "test_joint_soft_limiter.cpp",
])

cc_binary(
    name = "_bin/joint_limits_rosparam_test",
    srcs = ["joint_limits_rosparam_test.cpp"] + [
        "test_joint_limiter.hpp",
        "test_joint_saturation_limiter.hpp",
    ] + ["//:version_h"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        'PARAMETERS_FILE_PATH=\\"%stest/\\"' % REPO_RUNFILES_PREFIX,
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + ["@rosdistro//cc:googletest"] + ["//:_test_root_headers"],
)

cc_test(
    name = "joint_limits_rosparam_test",
    srcs = ["joint_limits_rosparam_test.cpp"] + [
        "test_joint_limiter.hpp",
        "test_joint_saturation_limiter.hpp",
    ] + ["//:version_h"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "joint_limits_rosparam.launch.py",
        "joint_limits_rosparam.yaml",
        "joint_saturation_limiter_param.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        'PARAMETERS_FILE_PATH=\\"%stest/\\"' % REPO_RUNFILES_PREFIX,
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:joint_limiter_interface_library",
        "//:joint_limits_helpers_library",
        "//:joint_saturation_limiter_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "joint_limits_urdf_test",
    srcs = ["joint_limits_urdf_test.cpp"] + [
        "test_joint_limiter.hpp",
        "test_joint_saturation_limiter.hpp",
    ] + ["//:version_h"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "joint_limits_rosparam.launch.py",
        "joint_limits_rosparam.yaml",
        "joint_saturation_limiter_param.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["GTEST_HAS_PTHREAD=1"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:joint_limiter_interface_library",
        "//:joint_limits_helpers_library",
        "//:joint_saturation_limiter_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_joint_range_limiter",
    srcs = ["test_joint_range_limiter.cpp"] + [
        "test_joint_limiter.hpp",
        "test_joint_saturation_limiter.hpp",
    ] + ["//:version_h"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "joint_limits_rosparam.launch.py",
        "joint_limits_rosparam.yaml",
        "joint_saturation_limiter_param.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:joint_limiter_interface_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_joint_saturation_limiter",
    srcs = ["test_joint_saturation_limiter.cpp"] + [
        "test_joint_limiter.hpp",
        "test_joint_saturation_limiter.hpp",
    ] + ["//:version_h"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "joint_limits_rosparam.launch.py",
        "joint_limits_rosparam.yaml",
        "joint_saturation_limiter_param.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
    ],
    # xfail: gtest failures under Bazel: JointSaturationLimiterTest.when_deceleration_exceeded_expect_dec_enforced
    tags = [
        "manual",
        "xfail",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:joint_limiter_interface_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_joint_soft_limiter",
    srcs = ["test_joint_soft_limiter.cpp"] + [
        "test_joint_limiter.hpp",
        "test_joint_saturation_limiter.hpp",
    ] + ["//:version_h"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "joint_limits_rosparam.launch.py",
        "joint_limits_rosparam.yaml",
        "joint_saturation_limiter_param.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:joint_limiter_interface_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

launch_ros_test(
    name = "test_joint_limits_rosparam_launch",
    src = "joint_limits_rosparam.launch.py",
    data = [
        ":_bin/joint_limits_rosparam_test",
        "//:ament_index",
    ],
    deps = [
        "@ament_index_python",
        "@trajectory_msgs//:py",
    ],
)
