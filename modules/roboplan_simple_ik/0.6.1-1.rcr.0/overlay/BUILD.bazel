genrule(
    name = "tar",
    srcs = [":raw_tar"],
    outs = ["tar.tar.gz"],
    cmd = "tmpdir=$$(mktemp -d) && tar -xzf $(location :raw_tar) -C $$tmpdir && rm -rf $$tmpdir/opt/ros/lyrical/roboplan_simple_ik/share/roboplan_simple_ik/environment/pythonpath.dsv $$tmpdir/opt/ros/lyrical/roboplan_simple_ik/share/roboplan_simple_ik/environment/pythonpath.sh && tar -czf $@ -C $$tmpdir opt && rm -rf $$tmpdir",
)

