load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@camera_info_manager//:camera_info_manager": "@camera_info_manager//:camera_info_manager_library",
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:ffmpeg": "@rosdistro//cc:ffmpeg_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@std_srvs//:cc_shared": "@std_srvs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "usb_cam_library",
    srcs = ["src/usb_cam.cpp"],
    hdrs = [
        "include/usb_cam/constants.hpp",
        "include/usb_cam/conversions.hpp",
        "include/usb_cam/formats/av_pixel_format_helper.hpp",
        "include/usb_cam/formats/m420.hpp",
        "include/usb_cam/formats/mjpeg.hpp",
        "include/usb_cam/formats/mono.hpp",
        "include/usb_cam/formats/pixel_format_base.hpp",
        "include/usb_cam/formats/rgb.hpp",
        "include/usb_cam/formats/utils.hpp",
        "include/usb_cam/formats/uyvy.hpp",
        "include/usb_cam/formats/yuyv.hpp",
        "include/usb_cam/usb_cam.hpp",
        "include/usb_cam/usb_cam_node.hpp",
        "include/usb_cam/utils.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/usb_cam",
    ],
    local_defines = ros_local_defines(),
    target_compatible_with = ["@platforms//os:linux"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "usb_cam",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":usb_cam_library"],
)

cc_library(
    name = "usb_cam_node_library",
    srcs = ["src/ros2/usb_cam_node.cpp"],
    hdrs = [
        "include/usb_cam/constants.hpp",
        "include/usb_cam/conversions.hpp",
        "include/usb_cam/formats/av_pixel_format_helper.hpp",
        "include/usb_cam/formats/m420.hpp",
        "include/usb_cam/formats/mjpeg.hpp",
        "include/usb_cam/formats/mono.hpp",
        "include/usb_cam/formats/pixel_format_base.hpp",
        "include/usb_cam/formats/rgb.hpp",
        "include/usb_cam/formats/utils.hpp",
        "include/usb_cam/formats/uyvy.hpp",
        "include/usb_cam/formats/yuyv.hpp",
        "include/usb_cam/usb_cam.hpp",
        "include/usb_cam/usb_cam_node.hpp",
        "include/usb_cam/utils.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/usb_cam",
    ],
    local_defines = ros_local_defines(),
    target_compatible_with = ["@platforms//os:linux"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":usb_cam_library"],
)

cc_shared_library(
    name = "usb_cam_node",
    dynamic_deps = DEPENDENCIES.keys() + [":usb_cam"],
    exports_filter = ["//:__subpackages__"],
    deps = [":usb_cam_node_library"],
)

rclcpp_components_register_node(
    name = "usb_cam_node_exe",
    component = ":usb_cam_node",
    node_name = "usb_cam_node_exe",
    plugin = "usb_cam::UsbCamNode",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":usb_cam_node"] + [":usb_cam"],
)

ament_index(
    name = "ament_index",
    components = [":usb_cam_node_exe_record"],
    data = [
        "config/camera_info.yaml",
        "config/params_1.yaml",
        "config/params_2.yaml",
        "//launch:launch_files",
    ],
    lib_data = [
        ":usb_cam_node_exe",
        "scripts/show_image.py",
    ],
    libraries = [
        ":usb_cam",
        ":usb_cam_node",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@camera_info_manager//:ament_package",
        "@cv_bridge//:ament_package",
        "@image_transport//:ament_package",
        "@image_transport_plugins//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@ros_environment//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "builtin_interfaces",
        "camera_info_manager",
        "cv_bridge",
        "image_transport",
        "image_transport_plugins",
        "rclcpp",
        "rclcpp_components",
        "sensor_msgs",
        "std_msgs",
        "std_srvs",
    ],
    cmake_export_targets = False,
    headers = [
        "include/usb_cam/constants.hpp",
        "include/usb_cam/conversions.hpp",
        "include/usb_cam/formats/av_pixel_format_helper.hpp",
        "include/usb_cam/formats/m420.hpp",
        "include/usb_cam/formats/mjpeg.hpp",
        "include/usb_cam/formats/mono.hpp",
        "include/usb_cam/formats/pixel_format_base.hpp",
        "include/usb_cam/formats/rgb.hpp",
        "include/usb_cam/formats/utils.hpp",
        "include/usb_cam/formats/uyvy.hpp",
        "include/usb_cam/formats/yuyv.hpp",
        "include/usb_cam/usb_cam.hpp",
        "include/usb_cam/usb_cam_node.hpp",
        "include/usb_cam/utils.hpp",
    ],
    include_prefix = "",
    libraries = [
        ":usb_cam",
        ":usb_cam_node",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@camera_info_manager//:ament_package",
        "@cv_bridge//:ament_package",
        "@image_transport//:ament_package",
        "@image_transport_plugins//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@ros_environment//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
