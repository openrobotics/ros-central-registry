load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@camera_info_manager//:camera_info_manager": "@camera_info_manager//:camera_info_manager_library",
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
}

CC_DEPS = [
    "@builtin_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
    "@std_srvs//:cc",
]

cc_library(
    name = "usb_cam_library",
    srcs = [":gen_usb_cam_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_libavcodec_avcodec_h",
        ":gen_libavcodec_bsf_h",
        ":gen_libavcodec_version_h",
        ":gen_libavformat_avformat_h",
        ":gen_libavutil_imgutils_h",
        ":gen_libavutil_pixdesc_h",
        ":gen_libswscale_swscale_h",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/usb_cam",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "usb_cam",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["@@//:__subpackages__"],
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":usb_cam_library"],
)

cc_library(
    name = "usb_cam_node_library",
    srcs = [":gen_usb_cam_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_libavcodec_avcodec_h",
        ":gen_libavcodec_bsf_h",
        ":gen_libavcodec_version_h",
        ":gen_libavformat_avformat_h",
        ":gen_libavutil_imgutils_h",
        ":gen_libavutil_pixdesc_h",
        ":gen_libswscale_swscale_h",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/usb_cam",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":usb_cam_library"],
)

cc_shared_library(
    name = "usb_cam_node",
    dynamic_deps = DEPENDENCIES.keys() + [":usb_cam"],
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":usb_cam_node_library"],
)

rclcpp_components_register_node(
    name = "usb_cam_node_exe",
    component = ":usb_cam_node",
    node_name = "usb_cam_node_exe",
    plugin = "usb_cam::UsbCamNode",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":usb_cam"],
)

write_file(
    name = "gen_usb_cam_stub_cpp",
    out = "_gen/usb_cam_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

