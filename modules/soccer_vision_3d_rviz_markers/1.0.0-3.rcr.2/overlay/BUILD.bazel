load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        ".github/dependabot.yml",
        ".github/workflows/build_and_test_humble.yaml",
        ".github/workflows/build_and_test_iron.yaml",
        ".github/workflows/build_and_test_rolling.yaml",
        "CHANGELOG.rst",
        "CONTRIBUTING.md",
        "LICENSE",
        "README.md",
        "blender/ball.blend",
        "blender/ball.dae",
        "config/hl_adult.yaml",
        "config/hl_kid.yaml",
        "config/spl.yaml",
        "package.xml",
        "resource/soccer_vision_3d_rviz_markers",
        "rviz/demo.rviz",
        "setup.cfg",
        "setup.py",
        "soccer_vision_3d_rviz_markers/__init__.py",
        "soccer_vision_3d_rviz_markers/conversion.py",
        "soccer_vision_3d_rviz_markers/conversion_array.py",
        "soccer_vision_3d_rviz_markers/visualizer.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
]]

ament_index(
    name = "ament_index",
    data = [
        "blender/ball.dae",
        "config/hl_adult.yaml",
        "config/hl_kid.yaml",
        "config/spl.yaml",
        "rviz/demo.rviz",
    ],
    package_xml = "package.xml",
)

py_library(
    name = "soccer_vision_3d_rviz_markers",
    srcs = [
        "soccer_vision_3d_rviz_markers/__init__.py",
        "soccer_vision_3d_rviz_markers/conversion.py",
        "soccer_vision_3d_rviz_markers/conversion_array.py",
        "soccer_vision_3d_rviz_markers/visualizer.py",
    ],
    data = [":ament_index"],
    imports = ["."],
    deps = [
        "@rclpy",
        "@soccer_vision_3d_msgs//:py",
        "@soccer_vision_attribute_msgs//:py",
        "@visualization_msgs//:py",
    ],
)

ament_package(
    name = "ament_package",
    console_scripts = {"visualizer": "soccer_vision_3d_rviz_markers.visualizer:main"},
    package_xml = "package.xml",
    python = [":soccer_vision_3d_rviz_markers"],
    deps = [":ament_index"] + [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@soccer_vision_3d_msgs//:ament_package",
        "@soccer_vision_attribute_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
