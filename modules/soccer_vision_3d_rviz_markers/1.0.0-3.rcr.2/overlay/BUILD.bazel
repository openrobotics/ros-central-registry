package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
    ]
]

ament_index(
    name = "ament_index",
    data = [
        "blender/ball.dae",
        "config/hl_adult.yaml",
        "config/hl_kid.yaml",
        "config/spl.yaml",
        "rviz/demo.rviz",
    ],
    package_xml = "package.xml",
)

py_library(
    name = "soccer_vision_3d_rviz_markers",
    srcs = glob(["soccer_vision_3d_rviz_markers/**/*.py"]),
    data = [":ament_index"],
    imports = ["."],
    deps = [
        "@rclpy",
        "@soccer_vision_3d_msgs//:py",
        "@soccer_vision_attribute_msgs//:py",
        "@visualization_msgs//:py",
    ],
)

py_pytest(
    name = "test_conversion",
    srcs = ["test/test_conversion.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    deps = [":soccer_vision_3d_rviz_markers"],
)

py_pytest(
    name = "test_conversion_array",
    srcs = ["test/test_conversion_array.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    deps = [":soccer_vision_3d_rviz_markers"],
)

py_pytest(
    name = "test_visualizer",
    srcs = ["test/test_visualizer.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":soccer_vision_3d_rviz_markers"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"visualizer": "soccer_vision_3d_rviz_markers.visualizer:main"},
    data = [
        "blender/ball.dae",
        "config/hl_adult.yaml",
        "config/hl_kid.yaml",
        "config/spl.yaml",
        "rviz/demo.rviz",
    ],
    package_xml = "package.xml",
    python = [":soccer_vision_3d_rviz_markers"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@soccer_vision_3d_msgs//:ament_package",
        "@soccer_vision_attribute_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
