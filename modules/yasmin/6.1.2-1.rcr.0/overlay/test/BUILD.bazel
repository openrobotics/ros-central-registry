cc_test(
    name = "test_blackboard_cpp",
    srcs = ["test_blackboard.cpp"],
    data = [
        "//:ament_index",
        "//:blackboard",
        "//:callback_signal",
        "//:cb_state",
        "//:concurrence",
        "//:join_state",
        "//:logs",
        "//:orthogonal_state",
        "//:state",
        "//:state_machine",
    ] + [
        "test_blackboard.py",
        "test_callback_signal.py",
        "test_cb_state.py",
        "test_concurrence.py",
        "test_orthogonal_state.py",
        "test_state.py",
        "test_state_machine.py",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:yasmin_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
