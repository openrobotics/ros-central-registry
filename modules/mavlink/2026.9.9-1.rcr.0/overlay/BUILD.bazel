    content = ["// MESSAGE EFI_PERFORMANCE support class\n\n#pragma once\n\nnamespace mavlink {\nnamespace development {\nnamespace msg {\n\n/**\n * @brief EFI_PERFORMANCE message\n *\n * EFI performance and health telemetry. Primarily intended for debugging EFI system faults to determine whether problems are within the engine, fuel pump, actuators, or the ECU. Nominal stream rate is 1 Hz. Core engine telemetry (RPM, temperatures, pressures, fuel flow) is carried in EFI_STATUS; this message carries the electrical/actuator/diagnostic data not present there.\n */\nstruct EFI_PERFORMANCE : mavlink::Message {\n    static constexpr msgid_t MSG_ID = 442;\n    static constexpr size_t LENGTH = 49;\n    static constexpr size_t MIN_LENGTH = 49;\n    static constexpr uint8_t CRC_EXTRA = 189;\n    static constexpr auto NAME = \"EFI_PERFORMANCE\";\n\n\n    uint8_t ecu_index; /*<  Electronic Control Unit (ECU) index for systems with multiple EFI units. Set to 0 for the first (or only) ECU. */\n    uint8_t fuel_pump_duty_cycle; /*< [%] Fuel pump power output, as a percentage of maximum. 0 = off, 100 = full power. */\n    uint16_t fuel_pump_voltage; /*< [mV] Fuel pump supply voltage. */\n    uint16_t fuel_pump_current; /*< [cA] Fuel pump current draw. */\n    uint16_t ecu_supply_voltage; /*< [mV] ECU supply voltage. */\n    uint16_t ecu_current; /*< [cA] ECU current draw. */\n    int16_t ecu_temperature; /*< [cdegC] ECU/electronics board temperature. */\n    uint8_t ecu_cpu_load; /*< [%] ECU processor load. */\n    uint16_t servo_supply_voltage; /*< [mV] Throttle-servo / actuator supply voltage. */\n    uint8_t servo_output_level; /*< [%] Electronic-throttle / servo commanded output level. */\n    uint8_t water_pump_duty_cycle; /*< [%] Coolant-pump power output, as a percentage of maximum. */\n    uint8_t injector_duty_cycle; /*< [%] Primary injector duty cycle. */\n    float fuel_mass_rate; /*< [g/min] Instantaneous fuel consumption by mass. NaN if not provided. */\n    float commanded_rpm; /*< [rpm] Governor/target RPM setpoint. */\n    uint32_t engine_runtime; /*< [s] Cumulative engine run time (hobbs). */\n    uint8_t error_memory_count; /*<  Number of faults currently stored in the ECU error memory. */\n    float boost_pressure; /*< [kPa] Forced-induction boost pressure. NaN if not provided. */\n    float coolant_pressure; /*< [kPa] Coolant-circuit pressure. NaN if not provided. */\n    int16_t engine_torque; /*< [%] Percent engine torque (signed; negative = motoring/braking). */\n    uint64_t status_flags; /*<  EFI status flags. */\n\n\n    inline std::string get_name(void) const override\n    {\n            return NAME;\n    }\n\n    inline Info get_message_info(void) const override\n    {\n            return { MSG_ID, LENGTH, MIN_LENGTH, CRC_EXTRA };\n    }\n\n    inline std::string to_yaml(void) const override\n    {\n        std::stringstream ss;\n\n        ss << NAME << \":\" << std::endl;\n        ss << \"  ecu_index: \" << +ecu_index << std::endl;\n        ss << \"  fuel_pump_duty_cycle: \" << +fuel_pump_duty_cycle << std::endl;\n        ss << \"  fuel_pump_voltage: \" << fuel_pump_voltage << std::endl;\n        ss << \"  fuel_pump_current: \" << fuel_pump_current << std::endl;\n        ss << \"  ecu_supply_voltage: \" << ecu_supply_voltage << std::endl;\n        ss << \"  ecu_current: \" << ecu_current << std::endl;\n        ss << \"  ecu_temperature: \" << ecu_temperature << std::endl;\n        ss << \"  ecu_cpu_load: \" << +ecu_cpu_load << std::endl;\n        ss << \"  servo_supply_voltage: \" << servo_supply_voltage << std::endl;\n        ss << \"  servo_output_level: \" << +servo_output_level << std::endl;\n        ss << \"  water_pump_duty_cycle: \" << +water_pump_duty_cycle << std::endl;\n        ss << \"  injector_duty_cycle: \" << +injector_duty_cycle << std::endl;\n        ss << \"  fuel_mass_rate: \" << fuel_mass_rate << std::endl;\n        ss << \"  commanded_rpm: \" << commanded_rpm << std::endl;\n        ss << \"  engine_runtime: \" << engine_runtime << std::endl;\n        ss << \"  error_memory_count: \" << +error_memory_count << std::endl;\n        ss << \"  boost_pressure: \" << boost_pressure << std::endl;\n        ss << \"  coolant_pressure: \" << coolant_pressure << std::endl;\n        ss << \"  engine_torque: \" << engine_torque << std::endl;\n        ss << \"  status_flags: \" << status_flags << std::endl;\n\n        return ss.str();\n    }\n\n    inline void serialize(mavlink::MsgMap &map) const override\n    {\n        map.reset(MSG_ID, LENGTH);\n\n        map << status_flags;                  // offset: 0\n        map << fuel_mass_rate;                // offset: 8\n        map << commanded_rpm;                 // offset: 12\n        map << engine_runtime;                // offset: 16\n        map << boost_pressure;                // offset: 20\n        map << coolant_pressure;              // offset: 24\n        map << fuel_pump_voltage;             // offset: 28\n        map << fuel_pump_current;             // offset: 30\n        map << ecu_supply_voltage;            // offset: 32\n        map << ecu_current;                   // offset: 34\n        map << ecu_temperature;               // offset: 36\n        map << servo_supply_voltage;          // offset: 38\n        map << engine_torque;                 // offset: 40\n        map << ecu_index;                     // offset: 42\n        map << fuel_pump_duty_cycle;          // offset: 43\n        map << ecu_cpu_load;                  // offset: 44\n        map << servo_output_level;            // offset: 45\n        map << water_pump_duty_cycle;         // offset: 46\n        map << injector_duty_cycle;           // offset: 47\n        map << error_memory_count;            // offset: 48\n    }\n\n    inline void deserialize(mavlink::MsgMap &map) override\n    {\n        map >> status_flags;                  // offset: 0\n        map >> fuel_mass_rate;                // offset: 8\n        map >> commanded_rpm;                 // offset: 12\n        map >> engine_runtime;                // offset: 16\n        map >> boost_pressure;                // offset: 20\n        map >> coolant_pressure;              // offset: 24\n        map >> fuel_pump_voltage;             // offset: 28\n        map >> fuel_pump_current;             // offset: 30\n        map >> ecu_supply_voltage;            // offset: 32\n        map >> ecu_current;                   // offset: 34\n        map >> ecu_temperature;               // offset: 36\n        map >> servo_supply_voltage;          // offset: 38\n        map >> engine_torque;                 // offset: 40\n        map >> ecu_index;                     // offset: 42\n        map >> fuel_pump_duty_cycle;          // offset: 43\n        map >> ecu_cpu_load;                  // offset: 44\n        map >> servo_output_level;            // offset: 45\n        map >> water_pump_duty_cycle;         // offset: 46\n        map >> injector_duty_cycle;           // offset: 47\n        map >> error_memory_count;            // offset: 48\n    }\n};\n\n} // namespace msg\n} // namespace development\n} // namespace mavlink\n"],
