    content = ["// MESSAGE MANUAL_INPUT_STATUS support class\n\n#pragma once\n\nnamespace mavlink {\nnamespace development {\nnamespace msg {\n\n/**\n * @brief MANUAL_INPUT_STATUS message\n *\n * Status of the manual control input arbitration on the autopilot: which source is currently active and, when a MAVLink enabled input device is selected, which system/component is providing it. Emitted by the autopilot for ground stations to display the active manual control source.\n */\nstruct MANUAL_INPUT_STATUS : mavlink::Message {\n    static constexpr msgid_t MSG_ID = 515;\n    static constexpr size_t LENGTH = 3;\n    static constexpr size_t MIN_LENGTH = 3;\n    static constexpr uint8_t CRC_EXTRA = 128;\n    static constexpr auto NAME = \"MANUAL_INPUT_STATUS\";\n\n\n    uint8_t source; /*<  Current manual control source active. */\n    uint8_t sender_system_id; /*<  System ID of the MAVLink enabled input device currently providing manual control. Set whenever a MAVLink enabled input device is contributing, i.e. for both MAV_MANUAL_INPUT_SOURCE_MAVLINK and MAV_MANUAL_INPUT_SOURCE_MIXED. 0 otherwise. */\n    uint8_t sender_component_id; /*<  Component ID of the MAVLink enabled input device currently providing manual control. Set whenever a MAVLink enabled input device is contributing, i.e. for both MAV_MANUAL_INPUT_SOURCE_MAVLINK and MAV_MANUAL_INPUT_SOURCE_MIXED. 0 otherwise. */\n\n\n    inline std::string get_name(void) const override\n    {\n            return NAME;\n    }\n\n    inline Info get_message_info(void) const override\n    {\n            return { MSG_ID, LENGTH, MIN_LENGTH, CRC_EXTRA };\n    }\n\n    inline std::string to_yaml(void) const override\n    {\n        std::stringstream ss;\n\n        ss << NAME << \":\" << std::endl;\n        ss << \"  source: \" << +source << std::endl;\n        ss << \"  sender_system_id: \" << +sender_system_id << std::endl;\n        ss << \"  sender_component_id: \" << +sender_component_id << std::endl;\n\n        return ss.str();\n    }\n\n    inline void serialize(mavlink::MsgMap &map) const override\n    {\n        map.reset(MSG_ID, LENGTH);\n\n        map << source;                        // offset: 0\n        map << sender_system_id;              // offset: 1\n        map << sender_component_id;           // offset: 2\n    }\n\n    inline void deserialize(mavlink::MsgMap &map) override\n    {\n        map >> source;                        // offset: 0\n        map >> sender_system_id;              // offset: 1\n        map >> sender_component_id;           // offset: 2\n    }\n};\n\n} // namespace msg\n} // namespace development\n} // namespace mavlink\n"],
