t: 24\n        map >> command;                       // offset: 28\n        map >> target_system;                 // offset: 30\n        map >> target_component;              // offset: 31\n        map >> confirmation;                  // offset: 32\n    }\n};\n\n} // namespace msg\n} // namespace common\n} // namespace mavlink\n"],
