packets between different nodes. Typically MARSH Manager, see https://marsh-sim.github.io/manager.html | */\n    FLIGHT_MODEL=101, /* Component simulating flight dynamics of the aircraft. | */\n    CONTROLS=102, /* Component providing pilot control inputs. | */\n    VISUALISATION=103, /* Component showing the visual situation to the pilot. | */\n    INSTRUMENTS=104, /* Component implementing pilot instrument panel. | */\n    MOTION_PLATFORM=105, /* Component that moves the entire cockpit for motion cueing. | */\n    GSEAT=106, /* Component for in-seat motion cueing. | */\n    EYE_TRACKER=107, /* Component providing gaze data of pilot eyes. | */\n    CONTROL_LOADING=108, /* Component measuring and actuating forces on pilot control inputs. | */\n    VIBRATION_SOURCE=109, /* Component providing vibrations for system identification, road rumble, gusts, etc. | */\n    PILOT_TARGET=110, /* Component providing target for the pilot to follow like controls positions, aircraft state, ILS path etc. | */\n    EXPERIMENT_DIRECTOR=111, /* Principal component controlling the main scenario of a given test, (unlike lower level MARSH_TYPE_PILOT_TARGET or MARSH_TYPE_MANAGER for overall communication). | */\n};\n\n//! MARSH_TYPE ENUM_END\nconstexpr auto MARSH_TYPE_ENUM_END = 112;\n\n/** @brief These values are MARSH-specific modes intended to be sent in custom_mode field of HEARTBEAT message.\n        Prefer defining values in the most significant byte (between 2^24 and 2^31) to leave the lower three bytes to contain a message id */\nenum class MARSH_MODE_FLAGS\n{\n    SINGLE_MESSAGE=16777216, /* Request Manager to only send one specific message, advised for very resource limited nodes or with control flow limitations like Simulink.\n          That message id should be in the lower three bytes of the mode, which can be done by adding it to the flags. | */\n    ALL_MESSAGES=33554432, /* Request Manager to send every message going out to any of the clients. | */\n};\n\n//! MARSH_MODE_FLAGS ENUM_END\nconstexpr auto MARSH_MODE_FLAGS_ENUM_END = 33554433;\n\n/** @brief Specific axis of pilot control inputs, with order corresponding to x, y, z, r fields in MANUAL_CONTROL message. */\nenum class CONTROL_AXIS : uint8_t\n{\n    ROLL=0, /* Roll axis, with positive values corresponding to stick right movement, causing the vehicle to roll right. For helicopters this is lateral cyclic. | */\n    PITCH=1, /* Pitch axis, with positive values corresponding to stick forward movement, causing the vehicle to move nose down. For helicopters this is longitudinal cyclic. | */\n    THRUST=2, /* Main thrust, with positive values corresponding to going faster and higher. For helicopters this is collective. | */\n    YAW=3, /* Yaw axis, with positive values corresponding to pushing right pedal, causing the vehicle to face right direction. For helicopters this is tail collective. | */\n};\n\n//! CONTROL_AXIS ENUM_END\nconstexpr auto CONTROL_AXIS_ENUM_END = 4;\n\n/** @brief Usage of MANUAL_SETPOINT message, sent in mode_switch field. */\nenum class MARSH_MANUAL_SETPOINT_MODE\n{\n    TARGET=0, /* Values for target inceptors positions that the pilot should follow. | */\n    TRIM=1, /* Values for inceptors trim positions, the exact meaning depends on the flight model. | */\n};\n\n//! MARSH_MANUAL_SETPOINT_MODE ENUM_END\nconstexpr auto MARSH_MANUAL_SETPOINT_MODE_ENUM_END = 2;\n\n/** @brief Mode of a motion platform system. */\nenum class MOTION_PLATFORM_MODE : uint8_t\n{\n    UNKNOWN=0, /* Mode information is unsupported on this device. | */\n    UNINITIALIZED=1, /* Mode is currently not available, but may be in different condition. | */\n    OFF=2, /* Platform actuators are turned off, but control system is responsive. | */\n    SETTLED=3, /* Platform is in the lowest position and/or locked, appropriate for personnel entry. | */\n    NEUTRAL=4, /* Platform is in a neutral reference position, not accepting movement commands. | */\n    FROZEN=5, /* Platform is stopped in any position, not accepting movement commands. | */\n    ENGAGED=6, /* Platform is in any position, accepting movement commands. | */\n};\n\n//! MOTION_PLATFORM_MODE ENUM_END\nconstexpr auto MOTION_PLATFORM_MODE_ENUM_END = 7;\n\n/** @brief General error state of a motion platform system. */\nenum class MOTION_PLATFORM_HEALTH : uint8_t\n{\n    OK=0, /* System is operating correctly. | */\n    WARNING=1, /* There is at least one warning present, but operation can be continued. | */\n    ERROR=2, /* There is a failure or misconfiguration that requires operator's attention for correct operation. | */\n    CRITICAL=3, /* There is a major failure that requires immediate operator action to maintain safety. | */\n};\n\n//! MOTION_PLATFORM_HEALTH ENUM_END\nconstexpr auto MOTION_PLATFORM_HEALTH_ENUM_END = 4;\n\n\n} // namespace marsh\n} // namespace mavlink\n\n// MESSAGE DEFINITIONS\n#include \"./mavlink_msg_control_loading_axis.hpp\"\n#include \"./mavlink_msg_motion_platform_state.hpp\"\n#include \"./mavlink_msg_rexroth_motion_platform.hpp\"\n#include \"./mavlink_msg_motion_cue_extra.hpp\"\n#include \"./mavlink_msg_eye_tracking_data.hpp\"\n\n// base include\n#include \"../common/common.hpp\"\n"],
