LY_VOLTAGE=8589934592, /* ECU supply/system voltage is low. | */\n    CHARGING_ACTIVE=17179869184, /* Alternator/charging system is active. | */\n    DETONATION_OBSERVED=34359738368, /* Detonation/knock has been observed. | */\n    MISFIRE_OBSERVED=68719476736, /* Misfire has been observed. | */\n    DEBRIS_DETECTED=137438953472, /* Foreign debris has been detected. | */\n    HIGH_BOOST_PRESSURE=274877906944, /* Boost pressure is above threshold. | */\n    EGR_SYSTEM_FAULT=549755813888, /* Exhaust-gas-recirculation (EGR) system fault. | */\n};\n\n//! EFI_PERFORMANCE_STATUS_FLAGS ENUM_END\nconstexpr auto EFI_PERFORMANCE_STATUS_FLAGS_ENUM_END = 549755813889;\n\n\n} // namespace development\n} // namespace mavlink\n\n// MESSAGE DEFINITIONS\n#include \"./mavlink_msg_set_velocity_limits.hpp\"\n#include \"./mavlink_msg_velocity_limits.hpp\"\n#include \"./mavlink_msg_battery_status_v2.hpp\"\n#include \"./mavlink_msg_group_start.hpp\"\n#include \"./mavlink_msg_group_end.hpp\"\n#include \"./mavlink_msg_radio_rc_channels.hpp\"\n#include \"./mavlink_msg_rc_channels_override_v2.hpp\"\n#include \"./mavlink_msg_gnss_integrity.hpp\"\n#include \"./mavlink_msg_target_absolute.hpp\"\n#include \"./mavlink_msg_target_relative.hpp\"\n#include \"./mavlink_msg_control_status.hpp\"\n#include \"./mavlink_msg_esc_eeprom.hpp\"\n#include \"./mavlink_msg_ranging_beacon.hpp\"\n#include \"./mavlink_msg_estimator_sensor_fusion_status.hpp\"\n#include \"./mavlink_msg_manual_input_status.hpp\"\n#include \"./mavlink_msg_efi_performance.hpp\"\n#include \"./mavlink_msg_distance_sensor_info.hpp\"\n#include \"./mavlink_msg_distance_sensor_v2.hpp\"\n\n// base include\n#include \"../common/common.hpp\"\n"],
