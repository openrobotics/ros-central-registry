tem;                 // offset: 4\n        map << target_component;              // offset: 5\n    }\n\n    inline void deserialize(mavlink::MsgMap &map) override\n    {\n        map >> start;                         // offset: 0\n        map >> end;                           // offset: 2\n        map >> target_system;                 // offset: 4\n        map >> target_component;              // offset: 5\n    }\n};\n\n} // namespace msg\n} // namespace common\n} // namespace mavlink\n"],
