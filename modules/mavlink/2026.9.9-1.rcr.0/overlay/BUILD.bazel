        // offset: 41\n        map << alt_type;                      // offset: 42\n        map << sequence;                      // offset: 43\n        map << status;                        // offset: 44\n    }\n\n    inline void deserialize(mavlink::MsgMap &map) override\n    {\n        map >> time_usec;                     // offset: 0\n        map >> range;                         // offset: 8\n        map >> lat;                           // offset: 12\n        map >> lon;                           // offset: 16\n        map >> alt;                           // offset: 20\n        map >> hacc_est;                      // offset: 24\n        map >> vacc_est;                      // offset: 28\n        map >> range_accuracy;                // offset: 32\n        map >> beacon_id;                     // offset: 36\n        map >> carrier_freq;                  // offset: 38\n        map >> target_system;                 // offset: 40\n        map >> target_component;              // offset: 41\n        map >> alt_type;                      // offset: 42\n        map >> sequence;                      // offset: 43\n        map >> status;                        // offset: 44\n    }\n};\n\n} // namespace msg\n} // namespace development\n} // namespace mavlink\n"],
