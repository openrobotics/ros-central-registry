                           // offset: 7\n        map << data;                          // offset: 8\n    }\n\n    inline void deserialize(mavlink::MsgMap &map) override\n    {\n        map >> id;                            // offset: 0\n        map >> target_system;                 // offset: 4\n        map >> target_component;              // offset: 5\n        map >> bus;                           // offset: 6\n        map >> len;                           // offset: 7\n        map >> data;                          // offset: 8\n    }\n};\n\n} // namespace msg\n} // namespace common\n} // namespace mavlink\n"],
