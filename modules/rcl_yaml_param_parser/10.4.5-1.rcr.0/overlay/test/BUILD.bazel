load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

[cc_test(
    name = test,
    timeout = "moderate",
    srcs = [
        "locate_test_assets.h",
        "mocking_utils/patch.hpp",
        "time_bomb_allocator_testing_utils.h",
        test + ".cpp",
    ],
    data = [
        "benchmark/benchmark_params.yaml",
        "correct_config.yaml",
        "empty_name_in_ns.yaml",
        "empty_string.yaml",
        "indented_name_space.yaml",
        "multi_ns_correct.yaml",
        "multiple_nodes.yaml",
        "multiple_params.yaml",
        "no_alias_support.yaml",
        "no_value1.yaml",
        "overlay.yaml",
        "params_with_no_node.yaml",
        "root_ns.yaml",
        "seq_map1.yaml",
        "seq_map2.yaml",
        "special_float.yaml",
        "string_array_with_quoted_number.yaml",
        "tag_incorrect_config_01.yaml",
        "tag_incorrect_config_02.yaml",
        "tag_incorrect_config_03.yaml",
        "wildcards.yaml",
        "wildcards_node_slash.yaml",
        "wildcards_partial_01.yaml",
        "wildcards_partial_02.yaml",
        "wildcards_partial_03.yaml",
        "wildcards_partial_04.yaml",
        "wildcards_partial_05.yaml",
        "wildcards_partial_06.yaml",
        "wildcards_partial_07.yaml",
        "wildcards_partial_08.yaml",
        "wildcards_partial_09.yaml",
        "wildcards_partial_10.yaml",
        "wildcards_partial_11.yaml",
        "wildcards_partial_12.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "//:rcl_yaml_param_parser_library",
        "@osrf_testing_tools_cpp//:memory_tools",
        "@rosdistro//cc:googletest",
        "@rosdistro//cc:mimick",
        "@rules_cc//cc/runfiles",
    ] + ["//:_test_root_headers"],
) for test in [
    "test_namespace",
    "test_node_params",
    "test_parse",
    "test_parse_yaml",
    "test_parser",
    "test_parser_multiple_nodes",
    "test_parser_multiple_params",
    "test_yaml_variant",
]]

[cc_test(
    name = test,
    timeout = "moderate",
    srcs = ["benchmark/" + test + ".cpp"],
    data = ["benchmark/benchmark_params.yaml"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    tags = ["manual"],
    deps = DEPENDENCIES.values() + [
        "//:rcl_yaml_param_parser_",
        "@google_benchmark//:benchmark",
        "@google_benchmark//:benchmark_main",
        "@osrf_testing_tools_cpp//:memory_tools",
        "@performance_test_fixture",
        "@rosdistro//cc:mimick",
    ],
) for test in [
    "benchmark_parse_yaml",
    "benchmark_variant",
]]
