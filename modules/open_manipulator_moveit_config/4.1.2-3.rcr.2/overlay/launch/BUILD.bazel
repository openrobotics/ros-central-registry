load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "omx_f_moveit.launch.py",
        "omy_3m_moveit.launch.py",
        "omy_f3m_moveit.launch.py",
        "open_manipulator_x_moveit.launch.py",
    ],
)

launch_ros_binary(
    name = "omx_f_moveit_launch",
    src = "omx_f_moveit.launch.py",
    data = [
        "//:ament_index",
        "@moveit_ros_move_group//:ament_index",
        "@moveit_ros_move_group//:move_group",
        "@rviz2",
        "@rviz2//:ament_index",
    ],
    deps = ["@moveit_configs_utils"],
)

launch_ros_binary(
    name = "omy_3m_moveit_launch",
    src = "omy_3m_moveit.launch.py",
    data = [
        "//:ament_index",
        "@moveit_ros_move_group//:ament_index",
        "@moveit_ros_move_group//:move_group",
        "@rviz2",
        "@rviz2//:ament_index",
    ],
    deps = ["@moveit_configs_utils"],
)

launch_ros_binary(
    name = "omy_f3m_moveit_launch",
    src = "omy_f3m_moveit.launch.py",
    data = [
        "//:ament_index",
        "@moveit_ros_move_group//:ament_index",
        "@moveit_ros_move_group//:move_group",
        "@rviz2",
        "@rviz2//:ament_index",
    ],
    deps = ["@moveit_configs_utils"],
)

launch_ros_binary(
    name = "open_manipulator_x_moveit_launch",
    src = "open_manipulator_x_moveit.launch.py",
    data = [
        "//:ament_index",
        "@moveit_ros_move_group//:ament_index",
        "@moveit_ros_move_group//:move_group",
        "@rviz2",
        "@rviz2//:ament_index",
    ],
    deps = ["@moveit_configs_utils"],
)
