load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

exports_files(["package.xml"])

ament_index(
    name = "ament_index",
    data = [
        "plugin.xml",
        "resource/TopicWidget.ui",
    ],
    package_xml = "package.xml",
    plugin_category = "rqt_gui",
    plugins = ["plugin.xml"],
    deps = ["@rqt_gui_py//:ament_index"],
)

py_library(
    name = "rqt_topic",
    srcs = [
        "rqt_topic/__init__.py",
        "rqt_topic/buttons/__init__.py",
        "rqt_topic/buttons/clear.py",
        "rqt_topic/buttons/hide_timestamps.py",
        "rqt_topic/buttons/resize_columns.py",
        "rqt_topic/buttons/toggle_highlight.py",
        "rqt_topic/buttons/toggle_pause.py",
        "rqt_topic/main.py",
        "rqt_topic/models/__init__.py",
        "rqt_topic/models/message.py",
        "rqt_topic/models/message_detail.py",
        "rqt_topic/models/message_list.py",
        "rqt_topic/models/topic.py",
        "rqt_topic/models/topic_list.py",
        "rqt_topic/topic.py",
        "rqt_topic/topic_widget.py",
        "rqt_topic/views/__init__.py",
        "rqt_topic/views/message_detail.py",
        "rqt_topic/views/message_list.py",
        "rqt_topic/views/topic_list.py",
        "rqt_topic/workers/__init__.py",
        "rqt_topic/workers/topic.py",
    ],
    data = ["resource/TopicWidget.ui"] + ["plugin.xml"],
    imports = ["."],
    deps = [
        "@python_qt_binding",
        "@rclpy",
        "@ros2topic",
        "@rqt_gui",
        "@rqt_gui_py",
        "@rqt_py_common",
        requirement("argcomplete"),
        requirement("psutil"),
        requirement("pydantic"),
    ],
)

py_binary(
    name = "gui",
    srcs = ["rqt_topic/main.py"],
    args = ["--force-discover"],
    data = [":ament_index"],
    main = "rqt_topic/main.py",
    deps = [":rqt_topic"],
)

py_binary(
    name = "bin/rqt_topic",
    srcs = ["rqt_topic/main.py"],
    data = [":ament_index"],
    main = "rqt_topic/main.py",
    deps = [":rqt_topic"],
)

ament_package(
    name = "ament_package",
    console_scripts = {"rqt_topic": "rqt_topic.main:main"},
    package_xml = "package.xml",
    python = [":rqt_topic"],
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_xmllint//:ament_package",
        "@python_qt_binding//:ament_package",
        "@rclpy//:ament_package",
        "@ros2topic//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@rqt_py_common//:ament_package",
    ],
)
