load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

cc_library(
    name = "ping_node",
    srcs = [
        "src/examples_rclcpp_cbg_executor/ping_node.cpp",
        "src/examples_rclcpp_cbg_executor/utilities.hpp",
    ],
    hdrs = ["include/examples_rclcpp_cbg_executor/ping_node.hpp"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_library(
    name = "pong_node",
    srcs = [
        "src/examples_rclcpp_cbg_executor/pong_node.cpp",
        "src/examples_rclcpp_cbg_executor/utilities.hpp",
    ],
    hdrs = ["include/examples_rclcpp_cbg_executor/pong_node.hpp"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_binary(
    name = "ping",
    srcs = ["src/ping.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":ping_node"],
)

cc_binary(
    name = "pong",
    srcs = ["src/pong.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":pong_node"],
)

cc_binary(
    name = "ping_pong",
    srcs = ["src/ping_pong.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":ping_node",
        ":pong_node",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_include_directories = False,
    cmake_export_interface = False,
    cmake_export_targets = False,
    executables = [
        ":ping",
        ":pong",
        ":ping_pong",
    ],
    headers = [
        "include/examples_rclcpp_cbg_executor/ping_node.hpp",
        "include/examples_rclcpp_cbg_executor/pong_node.hpp",
    ],
    include_prefix = "",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
