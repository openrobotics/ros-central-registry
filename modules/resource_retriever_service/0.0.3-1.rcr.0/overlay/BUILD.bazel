load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/resource_retriever_service/resource_retriever_service.hpp",
    "include/resource_retriever_service/visibility_control.h",
]

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@resource_retriever_interfaces//:cc_shared": "@resource_retriever_interfaces//:cc",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

cc_library(
    name = "resource_retriever_service_library",
    srcs = ["src/resource_retriever_service.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["RESOURCE_RETRIEVER_SERVICE_BUILDING_DLL"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "resource_retriever_service",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":resource_retriever_service_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":resource_retriever_service",
        "@resource_retriever_interfaces//:cc_shared",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    headers = HEADERS,
    libraries = [":resource_retriever_service"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@resource_retriever_interfaces//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
