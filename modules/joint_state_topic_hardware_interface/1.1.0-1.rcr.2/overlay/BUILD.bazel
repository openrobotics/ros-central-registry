load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@hardware_interface//:hardware_interface": "@hardware_interface//:hardware_interface_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libcap": "@rosdistro//cc:libcap_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@angles//:angles",
    "@control_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@ros2_control_test_assets//:ros2_control_test_assets",
    "@rosdistro//cc:fmt",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

cc_library(
    name = "joint_state_topic_hardware_interface_library",
    srcs = ["src/joint_state_topic_hardware_interface.cpp"],
    hdrs = ["include/joint_state_topic_hardware_interface/joint_state_topic_hardware_interface.hpp"] + [
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/joint_state_topic_hardware_interface",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "joint_state_topic_hardware_interface",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":joint_state_topic_hardware_interface_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":joint_state_topic_hardware_interface"],
)

ament_index(
    name = "ament_index",
    libraries = [":joint_state_topic_hardware_interface"],
    package_xml = "package.xml",
    plugin_category = "hardware_interface",
    plugins = ["joint_state_topic_hardware_interface_plugin_description.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@angles//:ament_package",
        "@control_msgs//:ament_package",
        "@controller_manager//:ament_package",
        "@forward_command_controller//:ament_package",
        "@hardware_interface//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@joint_trajectory_controller//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@ros2_control_test_assets//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@topic_tools//:ament_package",
        "@xacro//:ament_package",
    ],
)

ament_package(
