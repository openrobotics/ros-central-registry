load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@std_msgs//:cc",
    "@angles//:angles",
    "@control_msgs//:cc",
    "@hardware_interface//:hardware_interface_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:fmt",
    "@sensor_msgs//:cc",
]

cc_test(
    name = "joint_state_topic_hardware_interface_test",
    srcs = ["joint_state_topic_hardware_interface_test.cpp"] + [] + [
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "gripper/gripper.launch.py",
        "gripper/gripper.urdf.xacro",
        "gripper/gripper_controller_position.yaml",
        "gripper/position.test.py",
        "rrr/position.test.py",
        "rrr/ros2_controllers.yaml",
        "rrr/rrr.launch.py",
        "rrr/rrr.urdf.xacro",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:joint_state_topic_hardware_interface_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

launch_ros_test(
    name = "test_rrr_position_test",
    src = "rrr/position.test.py",
    data = [
        "//:ament_index",
        "@topic_tools//:ament_index",
        "@topic_tools//:relay",
    ],
    deps = [
        "@ament_index_python",
        "@angles//:angles_py",
        "@control_msgs//:py",
        "@controller_manager//:controller_manager_py",
        "@launch//:test_support",
        "@rclpy",
        "@sensor_msgs//:py",
        "@topic_tools//:topic_tools_py",
        requirement("numpy"),
    ],
)

launch_ros_test(
    name = "test_gripper_position_test",
    src = "gripper/position.test.py",
    data = [
        "//:ament_index",
        "@topic_tools//:ament_index",
        "@topic_tools//:relay",
    ],
    deps = [
        "@ament_index_python",
        "@angles//:angles_py",
        "@control_msgs//:py",
        "@controller_manager//:controller_manager_py",
        "@launch//:test_support",
        "@rclpy",
        "@sensor_msgs//:py",
        "@topic_tools//:topic_tools_py",
        requirement("numpy"),
    ],
)
