+_PROTO_SECTION_RE = re.compile(r'^(?:#|//)\s*\[proto(?::([A-Za-z0-9_]+))?\]\s*$')
+_PROTO_ENTRY_RE = re.compile(r'^(?:#|//)\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(\d+)\s*$')
+
+
+def parse_proto_field_numbers(source_file):
+    """
+    Scan `source_file` (.msg, .srv, .action, or .idl) for trailing `[proto]` /
+    `[proto:<Section>]` comment blocks and return `(has_proto_block, sections)`
+    where `sections` maps section name (`""`, `"Request"`, `"Response"`,
+    `"Goal"`, `"Result"`, `"Feedback"`, or struct name) to `{field_name: int}`.
+    """
+    sections = {}
+    has_proto_block = False
+    if not source_file:
+        return has_proto_block, sections
+    path = pathlib.Path(source_file)
+    if not path.is_file():
+        return has_proto_block, sections
+
+    current_section = None
+    for raw_line in path.read_text(encoding='utf-8', errors='replace').splitlines():
+        line = raw_line.strip()
+        m_sec = _PROTO_SECTION_RE.match(line)
+        if m_sec:
+            has_proto_block = True
+            current_section = m_sec.group(1) or ''
+            sections.setdefault(current_section, {})
+            continue
+        if current_section is not None:
+            m_entry = _PROTO_ENTRY_RE.match(line)
+            if m_entry:
+                sections[current_section][m_entry.group(1)] = int(m_entry.group(2))
+    return has_proto_block, sections
+
 
