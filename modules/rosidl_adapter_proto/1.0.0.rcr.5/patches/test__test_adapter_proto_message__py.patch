+def test_parse_proto_field_numbers(tmp_path):
+    msg_file = tmp_path / 'Sample.msg'
+    msg_file.write_text(
+        'int32 a\nstring b\n\n'
+        '# [proto]\n'
+        '#   a = 1\n'
+        '#   b = 2\n',
+        encoding='utf-8',
+    )
+    has_block, sections = parse_proto_field_numbers(msg_file)
+    assert has_block is True
+    assert sections == {'': {'a': 1, 'b': 2}}
+
+
+def test_strict_mode_fails_without_proto_block(tmp_path):
+    import json
+    test_dir = pathlib.Path(__file__).parent
+    args_file = tmp_path / 'args.json'
+    args_file.write_text(
+        json.dumps({
+            'package_name': 'rosidl_adapter_proto',
+            'output_dir': str(tmp_path),
+            'template_dir': str(test_dir.parent / 'resource'),
+            'idl_tuples': [f'{test_dir}:msg/BoolTest.idl'],
+            'target_dependencies': [str(test_dir / 'msg' / 'BoolTest.idl')],
+        }),
+        encoding='utf-8',
+    )
+    with pytest.raises(RuntimeError, match='no protobuf field number'):
+        generate_proto(str(args_file), strict=True)
+
+
+def test_strict_mode_succeeds_with_proto_block(tmp_path):
+    import json
+    test_dir = pathlib.Path(__file__).parent
+    src_file = tmp_path / 'BoolTest.msg'
+    src_file.write_text(
+        'bool data\n\n'
+        '# [proto]\n'
+        '#   data = 1\n',
+        encoding='utf-8',
+    )
+    args_file = tmp_path / 'args.json'
+    args_file.write_text(
+        json.dumps({
+            'package_name': 'rosidl_adapter_proto',
+            'output_dir': str(tmp_path),
+            'template_dir': str(test_dir.parent / 'resource'),
+            'idl_tuples': [f'{test_dir}:msg/BoolTest.idl'],
+            'target_dependencies': [str(test_dir / 'msg' / 'BoolTest.idl')],
+        }),
+        encoding='utf-8',
+    )
+    rc = generate_proto(str(args_file), strict=True, source_file=str(src_file))
+    assert rc == 0
+    proto_text = (tmp_path / 'msg' / 'bool_test.proto').read_text(encoding='utf-8')
+    assert 'bool data = 1;' in proto_text
