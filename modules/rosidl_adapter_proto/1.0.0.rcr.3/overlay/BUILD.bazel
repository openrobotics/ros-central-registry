load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

filegroup(
    name = "_test_data_0",
    srcs = [
        "resource/action.proto.em",
        "resource/idl.proto.em",
        "resource/msg.proto.em",
        "resource/srv.proto.em",
    ],
)

exports_files([
    "aspects.bzl",
    "defs.bzl",
    "tools.bzl",
    "types.bzl",
])

filegroup(
    name = "interface_templates",
    srcs = [
        "resource/action.proto.em",
        "resource/idl.proto.em",
        "resource/msg.proto.em",
        "resource/srv.proto.em",
    ],
)

filegroup(
    name = "visibility_control_template",
    srcs = ["resource/rosidl_adapter_proto__visibility_control.h.in"],
)

py_library(
    name = "rosidl_adapter_proto",
    srcs = ["rosidl_adapter_proto/__init__.py"],
    data = [
        "resource/action.proto.em",
        "resource/idl.proto.em",
        "resource/msg.proto.em",
        "resource/srv.proto.em",
    ],
    deps = ["@rosidl_pycommon"],
)

genrule(
    name = "cli_rename",
    srcs = ["bin/rosidl_adapter_proto"],
    outs = ["bin/rosidl_adapter_proto.py"],
    cmd = "cp $(location :bin/rosidl_adapter_proto) $(location :bin/rosidl_adapter_proto.py)",
)

py_binary(
    name = "cli",
    srcs = [":bin/rosidl_adapter_proto.py"],
    main = ":bin/rosidl_adapter_proto.py",
    deps = [":rosidl_adapter_proto"],
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_cli//:ament_package",
        "@rosidl_cmake//:ament_package",
        "@rosidl_parser//:ament_package",
        "@rosidl_pycommon//:ament_package",
    ],
)
