load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = [
    "include/tf2/LinearMath/Matrix3x3.hpp",
    "include/tf2/LinearMath/MinMax.hpp",
    "include/tf2/LinearMath/QuadWord.hpp",
    "include/tf2/LinearMath/Quaternion.hpp",
    "include/tf2/LinearMath/Scalar.hpp",
    "include/tf2/LinearMath/Transform.hpp",
    "include/tf2/LinearMath/Vector3.hpp",
    "include/tf2/buffer_core.hpp",
    "include/tf2/buffer_core_interface.hpp",
    "include/tf2/convert.hpp",
    "include/tf2/exceptions.hpp",
    "include/tf2/impl/convert.hpp",
    "include/tf2/impl/utils.hpp",
    "include/tf2/time.hpp",
    "include/tf2/time_cache.hpp",
    "include/tf2/transform_datatypes.hpp",
    "include/tf2/transform_storage.hpp",
    "include/tf2/utils.hpp",
    "include/tf2/visibility_control.h",
]

DEPENDENCIES = {
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosidl_runtime_cpp//:rosidl_runtime_cpp": "@rosidl_runtime_cpp//:rosidl_runtime_cpp_library",
}

cc_library(
    name = "tf2_library",
    srcs = [
        "src/buffer_core.cpp",
        "src/cache.cpp",
        "src/static_cache.cpp",
        "src/time.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["TF2_BUILDING_DLL"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "tf2",
    dynamic_deps = [
        "@builtin_interfaces//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@rcutils//:rcutils",
        "@rosidl_runtime_cpp//:rosidl_runtime_cpp",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":tf2_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":tf2",
        "@builtin_interfaces//:cc_shared",
        "@geometry_msgs//:cc_shared",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_name = "export_tf2",
    headers = HEADERS,
    libraries = [":tf2"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_google_benchmark//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
    ],
)
