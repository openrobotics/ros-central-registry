load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

[cc_test(
    name = name,
    timeout = "moderate",
    srcs = ["{}.cpp".format(src)],
    local_defines = ros_local_defines(),
    deps = [
        "//:tf2_library",
        "@rosdistro//cc:googletest",
    ] + extra_deps,
) for name, src, extra_deps in [
    ("test_cache_unittest", "cache_unittest", []),
    ("test_static_cache_unittest", "static_cache_test", []),
    (
        "test_simple_tf2_core",
        "simple_tf2_core",
        ["@builtin_interfaces//:cc"],
    ),
    ("test_time", "test_time", []),
    ("test_storage", "test_storage", []),
]]

cc_test(
    name = "cache_benchmark",
    timeout = "moderate",
    srcs = ["cache_benchmark.cpp"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    tags = [
        "manual",
        "xfail",
    ],
    deps = [
        "//:tf2_library",
        "@google_benchmark//:benchmark",
        "@google_benchmark//:benchmark_main",
    ],
)
