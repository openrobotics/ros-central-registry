load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.asio",
    "@rosdistro//cc:boost.circular_buffer",
    "@sensor_msgs//:cc",
]

cc_library(
    name = "rplidar_c1_component_library",
    srcs = [
        "src/config.cpp",
        "src/helper.cpp",
        "src/lidar_node.cpp",
        "src/scan/express_scan.cpp",
        "src/scan/scan.cpp",
        "src/serial_port.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/lgdx_rplidar_c1",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rplidar_c1_component",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":rplidar_c1_component_library"],
)

rclcpp_components_register_node(
    name = "rplidar_c1_node",
    component = ":rplidar_c1_component",
    node_name = "rplidar_c1_node",
    plugin = "LgdxRobot2::LidarNode",
)

ament_index(
    name = "ament_index",
    components = [":rplidar_c1_node_record"],
    data = [
        "launch/rplidar_c1_launch.py",
        "rviz/lgdx_rplidar_c1.rviz",
    ],
    lib_data = [":rplidar_c1_node"],
    libraries = [":rplidar_c1_component"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)

launch_ros_binary(
    name = "rplidar_c1_launch.py",
    src = "launch/rplidar_c1_launch.py",
    data = [
        ":ament_index",
        "@rclcpp_components//:ament_index",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_rplidar_c1_component",
    libraries = [":rplidar_c1_component"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
