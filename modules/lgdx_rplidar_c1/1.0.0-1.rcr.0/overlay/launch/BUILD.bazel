load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = ["rplidar_c1_launch.py"],
)

launch_ros_binary(
    name = "rplidar_c1_launch",
    src = "rplidar_c1_launch.py",
    data = [
        "//:ament_index",
        "//:rplidar_c1_node",
        "@rclcpp_components//:ament_index",
        "@rviz2",
        "@rviz2//:ament_index",
    ],
    deps = ["@ament_index_python"],
)
