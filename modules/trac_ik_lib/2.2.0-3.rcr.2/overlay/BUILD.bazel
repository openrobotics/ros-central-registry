load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@kdl_parser//:kdl_parser": "@kdl_parser//:kdl_parser_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:nlopt": "@rosdistro//cc:nlopt_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@urdf//:urdf": "@urdf//:urdf_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "trac_ik_library",
    srcs = [
        "src/kdl_tl.cpp",
        "src/nlopt_ik.cpp",
        "src/trac_ik.cpp",
    ],
    hdrs = [
        "include/trac_ik/dual_quaternion.h",
        "include/trac_ik/kdl_tl.hpp",
        "include/trac_ik/math3d.h",
        "include/trac_ik/nlopt_ik.hpp",
        "include/trac_ik/trac_ik.hpp",
    ] + [],
    includes = [
        "_gen/include",
        "include",
    ],
    local_defines = ros_local_defines() + ["NLOPT_DLL"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "trac_ik",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":trac_ik_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":trac_ik"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@geometry_msgs//:ament_package",
        "@kdl_parser//:ament_package",
        "@rclcpp//:ament_package",
        "@urdf//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "geometry_msgs",
        "urdf",
        "kdl_parser",
        "NLopt",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_trac_ik_lib",
    headers = [
        "include/trac_ik/dual_quaternion.h",
        "include/trac_ik/kdl_tl.hpp",
        "include/trac_ik/math3d.h",
        "include/trac_ik/nlopt_ik.hpp",
        "include/trac_ik/trac_ik.hpp",
    ],
    include_prefix = "",
    libraries = [":trac_ik"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@geometry_msgs//:ament_package",
        "@kdl_parser//:ament_package",
        "@rclcpp//:ament_package",
        "@urdf//:ament_package",
    ],
)
