load("@rosidl_default_generators//:defs.bzl", "ros_message")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

exports_files(glob(["*.msg"]))

ros_message(
    name = "Action",
    src = "Action.msg",
    deps = [
        ":Param",
        ":Tree",
    ],
)

ros_message(
    name = "ActionExecution",
    src = "ActionExecution.msg",
)

ros_message(
    name = "ActionExecutionInfo",
    src = "ActionExecutionInfo.msg",
    deps = [
        "@builtin_interfaces//msg:Duration",
        "@builtin_interfaces//msg:Time",
    ],
)

ros_message(
    name = "ActionPerformerStatus",
    src = "ActionPerformerStatus.msg",
    deps = [
        "@builtin_interfaces//msg:Time",
    ],
)

ros_message(
    name = "Derived",
    src = "Derived.msg",
    deps = [
        ":Node",
        ":Tree",
    ],
)

ros_message(
    name = "DurativeAction",
    src = "DurativeAction.msg",
    deps = [
        ":Param",
        ":Tree",
    ],
)

ros_message(
    name = "Knowledge",
    src = "Knowledge.msg",
)

ros_message(
    name = "Node",
    src = "Node.msg",
    deps = [
        ":Param",
    ],
)

ros_message(
    name = "Param",
    src = "Param.msg",
)

ros_message(
    name = "Plan",
    src = "Plan.msg",
    deps = [
        ":PlanItem",
    ],
)

ros_message(
    name = "PlanArray",
    src = "PlanArray.msg",
    deps = [
        ":Plan",
    ],
)

ros_message(
    name = "PlanItem",
    src = "PlanItem.msg",
)

ros_message(
    name = "Problem",
    src = "Problem.msg",
    deps = [
        "@builtin_interfaces//msg:Time",
    ],
)

ros_message(
    name = "State",
    src = "State.msg",
    deps = [
        ":Derived",
        ":Node",
        ":Param",
    ],
)

ros_message(
    name = "Tree",
    src = "Tree.msg",
    deps = [
        ":Node",
    ],
)
