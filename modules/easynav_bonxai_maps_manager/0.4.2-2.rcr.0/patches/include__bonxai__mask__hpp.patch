--- a/include/bonxai/mask.hpp
+++ b/include/bonxai/mask.hpp
@@ -31,6 +31,42 @@
 
   Mask(const Mask & other);
   Mask(Mask && other);
+  Mask & operator=(const Mask & other)
+  {
+    if (this != &other) {
+      if (WORD_COUNT > 8) {
+        delete[] words_;
+      }
+      SIZE = other.SIZE;
+      WORD_COUNT = other.WORD_COUNT;
+      words_ = (WORD_COUNT <= 8) ? static_words_ : new uint64_t[WORD_COUNT];
+      for (uint32_t i = 0; i < WORD_COUNT; ++i) {
+        words_[i] = other.words_[i];
+      }
+    }
+    return *this;
+  }
+  Mask & operator=(Mask && other) noexcept
+  {
+    if (this != &other) {
+      if (WORD_COUNT > 8) {
+        delete[] words_;
+      }
+      SIZE = other.SIZE;
+      WORD_COUNT = other.WORD_COUNT;
+      if (WORD_COUNT <= 8) {
+        words_ = static_words_;
+        for (uint32_t i = 0; i < WORD_COUNT; ++i) {
+          words_[i] = other.words_[i];
+        }
+      } else {
+        words_ = other.words_;
+        other.words_ = other.static_words_;
+        other.WORD_COUNT = 0;
+      }
+    }
+    return *this;
+  }
 
   ~Mask();
 
