        allow_empty = True,
    ) + [
        ":gen_magick_h",
    ],
    copts = ["-std=c++20"],
    includes = [
        "_gen/include",
        "include",
        "include/easynav_bonxai_maps_manager",
    ],
    local_defines = ros_local_defines() + [
        "EASYNAV_DEBUG_WITH_YAETS",
        "GLAD_API_CALL_EXPORT",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":bonxai_library"],
)

