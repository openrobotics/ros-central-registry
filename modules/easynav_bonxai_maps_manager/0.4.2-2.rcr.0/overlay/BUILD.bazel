cc_library(
    name = "bonxai_library",
    srcs = [
        "src/bonxai/pcl_utils.cpp",
        "src/bonxai/probabilistic_map.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_magick_h",
    ],
    copts = ["-std=c++20"],
    includes = [
        "_gen/include",
        "include",
        "include/easynav_bonxai_maps_manager",
    ],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "bonxai",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":bonxai_library"],
)

cc_library(
    name = "easynav_bonxai_maps_manager_library",
    srcs = [
        "src/easynav_bonxai_maps_manager/BonxaiMapsManager.cpp",
