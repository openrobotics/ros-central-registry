cc_library(
    name = "plansys2_domain_expert_library",
    srcs = [
        "src/plansys2_domain_expert/DomainExpert.cpp",
        "src/plansys2_domain_expert/DomainExpertClient.cpp",
        "src/plansys2_domain_expert/DomainExpertNode.cpp",
        "src/plansys2_domain_expert/DomainReader.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++23",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/plansys2_domain_expert",
        "test/unit",
    ],
    local_defines = ros_local_defines() + ["PLUGINLIB__DISABLE_BOOST_FUNCTIONS"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "plansys2_domain_expert",
    dynamic_deps = DEPENDENCIES.keys(),
