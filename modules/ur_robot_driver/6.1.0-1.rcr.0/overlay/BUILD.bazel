cc_library(
    name = "robot_state_helper_lib_library",
    srcs = [":gen_ur_robot_driver_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/ur_robot_driver",
    ],
    local_defines = ros_local_defines() + ["NDEBUG"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

