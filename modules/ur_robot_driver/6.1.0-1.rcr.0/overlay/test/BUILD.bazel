cc_test(
    name = "test_mode_compatibility_symmetry",
    srcs = ["test_mode_compatibility_symmetry.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "dashboard_client.py",
        "example_move.py",
        "integration_test_component_lifecycle.py",
        "integration_test_config_controller.py",
        "integration_test_controller_switch.py",
        "integration_test_force_mode.py",
        "integration_test_friction_model.py",
        "integration_test_hand_back_control.py",
        "integration_test_io_controller.py",
        "integration_test_passthrough_controller.py",
        "integration_test_robot_models.py",
        "integration_test_scaled_joint_controller.py",
        "integration_test_tool_contact.py",
        "integration_test_trajectory_until.py",
        "integration_test_twist_controller.py",
        "launch_args.py",
        "resources/ursim/e-series/ur5e/programs/external_control.urp",
        "resources/ursim/e-series/ur5e/programs/hand_back_control_test_prog.urp",
        "test_common.py",
        "test_controller_doc_coverage.py",
        "test_mock_hardware.py",
        "test_program.urpx",
        "urscript_interface.py",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "NDEBUG",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:ur_robot_driver_plugin_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

