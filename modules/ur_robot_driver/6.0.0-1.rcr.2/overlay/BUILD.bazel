### BINARIES

cc_binary(
    name = "dashboard_client",
    srcs = [
        "src/dashboard_client_node.cpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = [
        ":dashboard_client_library",
        "@rclcpp//:rclcpp_library",
    ],
)

cc_binary(
    name = "controller_stopper_node",
    srcs = [
        "src/controller_stopper_node.cpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = [
        ":controller_stopper_library",
        "@rclcpp//:rclcpp_library",
    ],
)

cc_binary(
    name = "robot_state_helper",
    srcs = [
        "src/robot_state_helper_node.cpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = [
        ":robot_state_helper_library",
        "@rclcpp//:rclcpp_library",
    ],
)

cc_binary(
    name = "urscript_interface",
    dynamic_deps = [":transitive_deps_minimal"],
    deps = [
        ":urscript_interface_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "transitive_deps_minimal",
    dynamic_deps = [
        "@rclcpp//:rclcpp",
        "@ur_client_library//:urcl",
    ],
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "trajectory_until_node",
    dynamic_deps = [":transitive_deps_action"],
    deps = [
        ":trajectory_until_node_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "transitive_deps_action",
    dynamic_deps = [
        "@rclcpp//:rclcpp",
        "@rclcpp_action//:rclcpp_action",
    ],
    visibility = ["//visibility:private"],
)

### AMENT INDEX

ament_index(
    name = "ament_index",
    data = glob(
        [
            "config/**",
            "doc/**",
            "examples/**",
            "launch/**",
            "resources/**",
            "scripts/**",
            "urdf/**",
        ],
        allow_empty = True,
    ),
    package_xml = "package.xml",
    plugin_category = "hardware_interface",
    plugins = ["hardware_interface_plugin.xml"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    executables = [
        ":dashboard_client",
        ":controller_stopper_node",
        ":robot_state_helper",
        ":urscript_interface",
        ":trajectory_until_node",
    ],
    headers = HEADERS,
    libraries = [
        ":ur_robot_driver_log_handler",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@backward_ros//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rclpy//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@ros2run//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@ur_client_library//:ament_package",
