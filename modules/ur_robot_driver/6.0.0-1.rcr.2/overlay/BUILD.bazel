load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### LIBRARIES

HEADERS = glob(
    [
        "include/**/*.h",
        "include/**/*.hpp",
    ],
    allow_empty = True,
)

cc_library(
    name = "ur_robot_driver_log_handler_library",
    srcs = ["src/urcl_log_handler.cpp"],
    hdrs = ["include/ur_robot_driver/urcl_log_handler.hpp"],
    copts = [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = [
        "@rclcpp//:rclcpp_library",
        "@ur_client_library//:urcl_library",
    ],
)

cc_shared_library(
    name = "ur_robot_driver_log_handler",
    dynamic_deps = [
        "@rclcpp//:rclcpp",
        "@ur_client_library//:urcl",
    ],
    exports_filter = [":ur_robot_driver_log_handler_library"],
    deps = [":ur_robot_driver_log_handler_library"],
)

### TRANSITIVE DYNAMIC DEPS

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":ur_robot_driver_log_handler",
        "@rclcpp//:rclcpp",
        "@rclcpp_action//:rclcpp_action",
        "@ur_client_library//:urcl",
    ],
    visibility = ["//visibility:private"],
)

