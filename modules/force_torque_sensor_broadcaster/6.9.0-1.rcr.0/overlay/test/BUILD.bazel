load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@backward_ros//:backward": "@backward_ros//:backward_library",
    "@filters//:increment": "@filters//:increment_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@lifecycle_msgs//:cc",
    "@controller_interface//:controller_interface_library",
    "@controller_manager//:controller_manager_library",
    "@filters//:filter_base",
    "@filters//:filter_chain",
    "@filters//:filters",
    "@filters//:realtime_circular_buffer",
    "@generate_parameter_library//:generate_parameter_library",
    "@geometry_msgs//:cc",
    "@hardware_interface//:hardware_interface_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
]

exports_files([
    "dummy_filter.cpp",
    "dummy_filter_plugin.xml",
    "force_torque_sensor_broadcaster_params.yaml",
    "test_force_torque_sensor_broadcaster.cpp",
    "test_force_torque_sensor_broadcaster.hpp",
    "test_load_force_torque_sensor_broadcaster.cpp",
    "test_wrench_transformer.cpp",
])

cc_library(
    name = "dummy_filter_library",
    srcs = ["dummy_filter.cpp"],
    hdrs = ["test_force_torque_sensor_broadcaster.hpp"] + [
        "//:force_torque_sensor_broadcaster_parameters_gen",
        "//:wrench_transformer_parameters_gen",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = ["."],
    local_defines = ros_local_defines() + [
        'TEST_FILES_DIRECTORY=\\"test\\"',
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + ["//:_test_root_headers"],
)

cc_shared_library(
    name = "dummy_filter",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":dummy_filter_library"],
)

cc_test(
    name = "test_force_torque_sensor_broadcaster",
    srcs = ["test_force_torque_sensor_broadcaster.cpp"] + ["test_force_torque_sensor_broadcaster.hpp"] + [
        "//:force_torque_sensor_broadcaster_parameters_gen",
        "//:wrench_transformer_parameters_gen",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "dummy_filter_plugin.xml",
        "force_torque_sensor_broadcaster_params.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        'TEST_FILES_DIRECTORY=\\"test\\"',
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:force_torque_sensor_broadcaster_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

cc_test(
    name = "test_load_force_torque_sensor_broadcaster",
    srcs = ["test_load_force_torque_sensor_broadcaster.cpp"] + ["test_force_torque_sensor_broadcaster.hpp"] + [
        "//:force_torque_sensor_broadcaster_parameters_gen",
        "//:wrench_transformer_parameters_gen",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "dummy_filter_plugin.xml",
        "force_torque_sensor_broadcaster_params.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        'TEST_FILES_DIRECTORY=\\"test\\"',
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:force_torque_sensor_broadcaster_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

cc_test(
    name = "test_wrench_transformer",
    srcs = ["test_wrench_transformer.cpp"] + ["test_force_torque_sensor_broadcaster.hpp"] + [
        "//:force_torque_sensor_broadcaster_parameters_gen",
        "//:wrench_transformer_parameters_gen",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "dummy_filter_plugin.xml",
        "force_torque_sensor_broadcaster_params.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        'TEST_FILES_DIRECTORY=\\"test\\"',
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:wrench_transformer_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)
