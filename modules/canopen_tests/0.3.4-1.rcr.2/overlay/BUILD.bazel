load("@lely_core_libraries//:defs.bzl", "cogen_dcf", "generate_dcf")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

# Mirrors CMakeLists.txt: generate_dcf(<target>) / cogen_dcf(<target>) from
# lely_core_libraries. The generated bus.yml replaces the source one on
# install (upstream installs config/<target>/ with PATTERN "bus.yml" EXCLUDE).

generate_dcf(
    name = "simple_dcf",
    srcs = [
        "config/simple/simple.eds",
    ],
    target = "simple",
)

generate_dcf(
    name = "canopen_system_dcf",
    srcs = [
        "config/canopen_system/simple.eds",
    ],
    target = "canopen_system",
)

cogen_dcf(
    name = "cia402_system_dcf",
    srcs = [
        "config/cia402_system/cia402_slave.eds",
    ],
    extra_outs = [
        "cia402_device_1.bin",
    ],
    target = "cia402_system",
)

cogen_dcf(
    name = "cia402_namespaced_system_dcf",
    srcs = [
        "config/cia402_namespaced_system/cia402_slave.eds",
    ],
    extra_outs = [
        "cia402_device_1.bin",
    ],
    target = "cia402_namespaced_system",
)

cogen_dcf(
    name = "cia402_dcf",
    srcs = [
        "config/cia402/cia402_slave.eds",
    ],
    extra_outs = [
        "cia402_device_1.bin",
    ],
    target = "cia402",
)

generate_dcf(
    name = "cia402_lifecycle_dcf",
    srcs = [
        "config/cia402_lifecycle/cia402_slave.eds",
    ],
    extra_outs = [
        "cia402_device_1.bin",
    ],
    target = "cia402_lifecycle",
)

cogen_dcf(
    name = "cia402_diagnostics_dcf",
    srcs = [
        "config/cia402_diagnostics/cia402_slave.eds",
    ],
    extra_outs = [
        "cia402_device_1.bin",
        "cia402_device_2.bin",
        "cia402_device_3.bin",
    ],
    target = "cia402_diagnostics",
)

generate_dcf(
    name = "simple_lifecycle_dcf",
    srcs = [
        "config/simple_lifecycle/simple.eds",
    ],
    target = "simple_lifecycle",
)

cogen_dcf(
    name = "simple_diagnostics_dcf",
    srcs = [
        "config/simple_diagnostics/simple.eds",
    ],
    target = "simple_diagnostics",
)

generate_dcf(
    name = "robot_control_dcf",
    srcs = [
        "config/robot_control/cia402_slave.eds",
        "config/robot_control/prbt_0_1.dcf",
    ],
    extra_outs = [
        "joint_1.bin",
        "joint_2.bin",
    ],
    target = "robot_control",
)

ament_index(
    name = "ament_index",
    data = [
        "config/canopen_system/ros2_controllers.yaml",
        "config/canopen_system/simple.eds",
        "config/cia402/cia402_slave.eds",
        "config/cia402_diagnostics/cia402_slave.eds",
        "config/cia402_lifecycle/cia402_slave.eds",
        "config/cia402_namespaced_system/cia402_slave.eds",
        "config/cia402_namespaced_system/ros2_controllers.yaml",
        "config/cia402_system/cia402_slave.eds",
        "config/cia402_system/ros2_controllers.yaml",
        "config/robot_control/cia402_slave.eds",
        "config/robot_control/prbt_0_1.dcf",
        "config/robot_control/ros2_controllers.yaml",
        "config/simple/simple.eds",
        "config/simple_diagnostics/simple.eds",
        "config/simple_lifecycle/simple.eds",
        "launch_tests/test_cia402_driver.py",
        "launch_tests/test_proxy_driver.py",
        "launch_tests/test_proxy_driver_namespaced.py",
        "launch_tests/test_proxy_lifecycle_driver.py",
        "launch_tests/test_robot_control.py",
        "rviz/robot_controller.rviz",
        "urdf/canopen_system/canopen_system.ros2_control.xacro",
        "urdf/canopen_system/canopen_system.urdf.xacro",
        "urdf/cia402_system/cia402_system.ros2_control.xacro",
        "urdf/cia402_system/cia402_system.urdf.xacro",
        "urdf/robot_controller/robot_controller.macro.xacro",
        "urdf/robot_controller/robot_controller.ros2_control.xacro",
        "urdf/robot_controller/robot_controller.urdf.xacro",
        ":canopen_system_dcf",
        ":cia402_dcf",
        ":cia402_diagnostics_dcf",
        ":cia402_lifecycle_dcf",
        ":cia402_namespaced_system_dcf",
        ":cia402_system_dcf",
        ":robot_control_dcf",
        ":simple_dcf",
        ":simple_diagnostics_dcf",
        ":simple_lifecycle_dcf",
        "//launch:launch_files",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@canopen_402_driver//:ament_package",
        "@canopen_core//:ament_package",
        "@canopen_fake_slaves//:ament_package",
        "@canopen_proxy_driver//:ament_package",
        "@canopen_ros2_controllers//:ament_package",
        "@controller_manager//:ament_package",
        "@forward_command_controller//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@joint_trajectory_controller//:ament_package",
        "@lely_core_libraries//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@xacro//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@canopen_402_driver//:ament_package",
        "@canopen_core//:ament_package",
        "@canopen_fake_slaves//:ament_package",
        "@canopen_proxy_driver//:ament_package",
        "@canopen_ros2_controllers//:ament_package",
        "@controller_manager//:ament_package",
        "@forward_command_controller//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@joint_trajectory_controller//:ament_package",
        "@lely_core_libraries//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@xacro//:ament_package",
    ],
)
