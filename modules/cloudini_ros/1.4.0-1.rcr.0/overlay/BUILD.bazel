cc_library(
    name = "cloudini_point_cloud_transport_library",
    srcs = [
        "src/cloudini_publisher_plugin.cpp",
        "src/cloudini_subscriber_plugin.cpp",
        "src/conversion_utils.cpp",
        "src/plugin_manifest.cpp",
    ],
    hdrs = [
        "include/cloudini_plugin/cloudini_publisher_plugin.hpp",
        "include/cloudini_plugin/cloudini_subscriber_plugin.hpp",
        "include/cloudini_ros/cloudini_subscriber_pcl.hpp",
        "include/cloudini_ros/conversion_utils.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/cloudini_ros",
    ],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "cloudini_point_cloud_transport",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":cloudini_point_cloud_transport_library"],
)

