load("@rosidl_default_generators//:defs.bzl", "ros_service")

package(default_visibility = ["//visibility:public"])

exports_files([
    "AutonomyModeChange.idl",
    "HADMapService.idl",
    "ModifyTrajectory.idl",
])

ros_service(
    name = "AutonomyModeChange",
    src = "AutonomyModeChange.idl",
    deps = [
        "@std_msgs//msg:Empty",
    ],
)

ros_service(
    name = "HADMapService",
    src = "HADMapService.idl",
    deps = [
        "//msg:HADMapBin",
    ],
)

ros_service(
    name = "ModifyTrajectory",
    src = "ModifyTrajectory.idl",
    deps = [
        "//msg:Trajectory",
    ],
)
