load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PACKAGING

default_generators(
    dependencies = [
        "@builtin_interfaces",
        "@geometry_msgs",
        "@sensor_msgs",
        "@std_msgs",
    ],
    package_xml = "package.xml",
    deps = [
        "//action:PlanTrajectory",
        "//msg:BoundingBox",
        "//msg:BoundingBoxArray",
        "//msg:Complex32",
        "//msg:ControlDiagnostic",
        "//msg:DiagnosticHeader",
        "//msg:HADMapBin",
        "//msg:HighLevelControlCommand",
        "//msg:MapPrimitive",
        "//msg:PointClusters",
        "//msg:Quaternion32",
        "//msg:RawControlCommand",
        "//msg:Route",
        "//msg:Trajectory",
        "//msg:TrajectoryPoint",
        "//msg:VehicleControlCommand",
        "//msg:VehicleKinematicState",
        "//msg:VehicleOdometry",
        "//msg:VehicleStateCommand",
        "//msg:VehicleStateReport",
        "//srv:AutonomyModeChange",
        "//srv:HADMapService",
        "//srv:ModifyTrajectory",
    ],
)

rosidl_ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@action_msgs//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
