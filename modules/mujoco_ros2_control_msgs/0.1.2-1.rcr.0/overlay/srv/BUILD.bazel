load("@rosidl_default_generators//:defs.bzl", "ros_service")

package(default_visibility = ["//visibility:public"])

exports_files([
    "ApplyExternalWrench.srv",
    "ResetWorld.srv",
    "SetFreeJointState.srv",
    "SetPause.srv",
    "StepSimulation.srv",
])

ros_service(
    name = "ApplyExternalWrench",
    src = "ApplyExternalWrench.srv",
    deps = [
        "//msg:ExternalWrenchArray",
    ],
)

ros_service(
    name = "ResetWorld",
    src = "ResetWorld.srv",
    deps = [
        "//msg:SimulationState",
    ],
)

ros_service(
    name = "SetFreeJointState",
    src = "SetFreeJointState.srv",
    deps = [
        "//msg:FreeJointState",
    ],
)

ros_service(
    name = "SetPause",
    src = "SetPause.srv",
)

ros_service(
    name = "StepSimulation",
    src = "StepSimulation.srv",
)
