load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### LIBRARIES

HEADERS = glob(["include/velodyne_pointcloud/*.hpp"])

RAWDATA_DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

MSG_DEPENDENCIES = [
    "@geometry_msgs//:cc",
    "@sensor_msgs//:cc",
    "@velodyne_msgs//:cc",
]

# Header-only / statically-linked third-party deps.
STATIC_DEPENDENCIES = [
    "@angles",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:pcl_common",
]

cc_library(
    name = "velodyne_rawdata_library",
    srcs = [
        "src/lib/calibration.cpp",
        "src/lib/rawdata.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = RAWDATA_DEPENDENCIES.values() + MSG_DEPENDENCIES + STATIC_DEPENDENCIES,
)

cc_shared_library(
    name = "velodyne_rawdata",
    dynamic_deps = RAWDATA_DEPENDENCIES.keys(),
    exports_filter = [":velodyne_rawdata_library"],
    deps = [":velodyne_rawdata_library"],
)

CLOUD_TYPES_DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

cc_library(
    name = "velodyne_cloud_types_library",
    srcs = [
        "src/lib/organized_cloudXYZIRT.cpp",
        "src/lib/pointcloudXYZIRT.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = CLOUD_TYPES_DEPENDENCIES.values() + MSG_DEPENDENCIES + STATIC_DEPENDENCIES,
)

cc_shared_library(
    name = "velodyne_cloud_types",
    dynamic_deps = CLOUD_TYPES_DEPENDENCIES.keys(),
    exports_filter = [":velodyne_cloud_types_library"],
    deps = [":velodyne_cloud_types_library"],
)

TRANSFORM_DEPENDENCIES = {
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
}

cc_library(
    name = "transform_library",
    srcs = ["src/conversions/transform.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = TRANSFORM_DEPENDENCIES.values() + [
        ":velodyne_cloud_types_library",
        ":velodyne_rawdata_library",
    ],
)

cc_shared_library(
    name = "transform",
    dynamic_deps = dict(
        RAWDATA_DEPENDENCIES.items() +
        CLOUD_TYPES_DEPENDENCIES.items() +
        TRANSFORM_DEPENDENCIES.items(),
    ).keys(),
    exports_filter = [
        ":transform_library",
        ":velodyne_cloud_types_library",
        ":velodyne_rawdata_library",
    ],
    deps = [":transform_library"],
)

### COMPONENTS

rclcpp_components_register_nodes(
    name = "transform_nodes",
    component = ":transform",
    plugins = ["velodyne_pointcloud::Transform"],
)

### EXECUTABLES

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":transform"],
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "velodyne_transform_node",
    srcs = ["src/conversions/transform_node.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = [":transform_library"],
)

### AMENT INDEX

DATA = glob([
    "config/**",
    "launch/**",
    "params/**",
])

LIBRARIES = [
    ":transform",
    ":velodyne_cloud_types",
    ":velodyne_rawdata",
]

ament_index(
    name = "ament_index",
    components = [":transform_nodes"],
    data = DATA,
    executables = [":velodyne_transform_node"],
    libraries = LIBRARIES,
    package_xml = "package.xml",
)

### TESTS

collect_transitive_dynamic_deps(
    name = "test_row_step_dynamic_deps",
    dynamic_deps = [":velodyne_cloud_types"],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_row_step",
    srcs = ["tests/test_row_step.cpp"],
    dynamic_deps = [":test_row_step_dynamic_deps"],
    deps = CLOUD_TYPES_DEPENDENCIES.values() + [
        ":velodyne_cloud_types_library",
        "@rosdistro//cc:googletest",
    ],
)

collect_transitive_dynamic_deps(
    name = "test_calibration_dynamic_deps",
    dynamic_deps = [":velodyne_rawdata"],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_calibration",
    srcs = ["tests/test_calibration.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":test_calibration_dynamic_deps"],
    deps = RAWDATA_DEPENDENCIES.values() + [
        ":velodyne_rawdata_library",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "diagnostic_updater",
        "eigen",
        "geometry_msgs",
        "message_filters",
        "pcl",
        "rclcpp",
        "sensor_msgs",
        "tf2",
        "tf2_ros",
        "velodyne_msgs",
    ],
    cmake_export_name = "velodyne_pointcloud",
    components = [":transform_nodes"],
    data = DATA,
    executables = [":velodyne_transform_node"],
    headers = HEADERS,
    include_prefix = "",
    libraries = LIBRARIES,
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@angles//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@geometry_msgs//:ament_package",
        "@message_filters//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_ros//:ament_package",
        "@velodyne_msgs//:ament_package",
    ],
)
