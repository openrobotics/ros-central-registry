load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

default_generators(
    package_xml = "package.xml",
    deps = [
        "//action:Fibonacci",
        "//action:NestedMessage",
        "//msg:Arrays",
        "//msg:BasicTypes",
        "//msg:BoundedPlainSequences",
        "//msg:BoundedSequences",
        "//msg:Builtins",
        "//msg:ComplexNestedKey",
        "//msg:Constants",
        "//msg:Defaults",
        "//msg:Empty",
        "//msg:KeyedLong",
        "//msg:KeyedString",
        "//msg:MultiNested",
        "//msg:Nested",
        "//msg:NonKeyedWithNestedKey",
        "//msg:Strings",
        "//msg:UnboundedSequences",
        "//msg:WStrings",
        "//srv:Arrays",
        "//srv:BasicTypes",
        "//srv:Empty",
    ],
)

cc_library(
    name = "test_msgs_cc",
    hdrs = [
        "include/test_msgs/message_fixtures.hpp",
        "include/test_msgs/service_fixtures.hpp",
    ],
    includes = ["include"],
    deps = [":cc"],
)

py_library(
    name = "test_msgs_py",
    srcs = [
        "src/test_msgs/__init__.py",
        "src/test_msgs/message_fixtures.py",
        "src/test_msgs/service_fixtures.py",
    ],
    imports = ["src"],
    deps = [":py"],
)

rosidl_ament_package(
    name = "ament_package",
    headers = [
        "include/test_msgs/message_fixtures.hpp",
        "include/test_msgs/service_fixtures.hpp",
    ],
    interface_library = "test_msgs_includes",
    package_xml = "package.xml",
    python = [
        "src/test_msgs/__init__.py",
        "src/test_msgs/message_fixtures.py",
        "src/test_msgs/py.typed",
        "src/test_msgs/service_fixtures.py",
    ],
    python_strip_prefix = "src",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_mypy//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@test_interface_files//:ament_package",
    ],
)
