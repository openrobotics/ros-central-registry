load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

# Major version of the vendored gz-sim (GZ_SIM_VER in CMake).
GZ_SIM_VER = "10"

expand_template(
    name = "gz_sim_launch_py",
    out = "gz_sim.launch.py",
    substitutions = {"@GZ_SIM_VER@": GZ_SIM_VER},
    template = "gz_sim.launch.py.in",
)

filegroup(
    name = "launch_files",
    srcs = [
        "gz_remove_model.launch.py",
        "gz_server.launch.py",
        "gz_server.launch.xml",
        "gz_spawn_model.launch.py",
        "gz_spawn_model.launch.xml",
        "ros_gz_sim.launch.py",
        "ros_gz_sim.launch.xml",
        "ros_gz_spawn_model.launch.py",
        "ros_gz_spawn_model.launch.xml",
    ] + [
        ":gz_sim_launch_py",
    ],
)

launch_ros_binary(
    name = "gz_remove_model_launch",
    src = "gz_remove_model.launch.py",
    data = [
        "//:ament_index",
        "//:remove",
    ],
)

launch_ros_binary(
    name = "gz_server.launch",
    src = "gz_server.launch.xml",
    data = [
        "//:ament_index",
        "//:gzserver",
        "@rclcpp_components//:ament_index",
    ],
    deps = ["//:ros_gz_sim_py"],
)

launch_ros_binary(
    name = "gz_server_launch",
    src = "gz_server.launch.py",
    data = [
        "//:ament_index",
        "//:gzserver",
        "@rclcpp_components//:ament_index",
    ],
    deps = ["//:ros_gz_sim_py"],
)

launch_ros_binary(
    name = "gz_sim_launch",
    src = "gz_sim.launch.py",
    data = [
        "//:ament_index",
        "//:gzserver",
        "@rclcpp_components//:ament_index",
    ],
    deps = [
        "//:ros_gz_sim_py",
        "@ament_index_python",
        "@ros2pkg",
        requirement("catkin_pkg"),
    ],
)

launch_ros_binary(
    name = "gz_spawn_model.launch",
    src = "gz_spawn_model.launch.xml",
    data = [
        "//:ament_index",
        "//:create",
    ],
    deps = ["//:ros_gz_sim_py"],
)

launch_ros_binary(
    name = "gz_spawn_model_launch",
    src = "gz_spawn_model.launch.py",
    data = [
        "//:ament_index",
        "//:create",
    ],
)

launch_ros_binary(
    name = "ros_gz_sim.launch",
    src = "ros_gz_sim.launch.xml",
    data = [
        "//:ament_index",
        "//:gzserver",
        "@rclcpp_components//:ament_index",
        "@ros_gz_bridge//:ament_index",
        "@ros_gz_bridge//:bridge_node",
    ],
    deps = [
        "//:ros_gz_sim_py",
        "@ros_gz_bridge//:ros_gz_bridge_py",
    ],
)

launch_ros_binary(
    name = "ros_gz_sim_launch",
    src = "ros_gz_sim.launch.py",
    data = [
        "//:ament_index",
        "//:gzserver",
        "@rclcpp_components//:ament_index",
        "@ros_gz_bridge//:ament_index",
        "@ros_gz_bridge//:bridge_node",
    ],
    deps = [
        "//:ros_gz_sim_py",
        "@ros_gz_bridge//:ros_gz_bridge_py",
    ],
)

launch_ros_binary(
    name = "ros_gz_spawn_model.launch",
    src = "ros_gz_spawn_model.launch.xml",
    data = [
        "//:ament_index",
        "//:create",
        "@rclcpp_components//:ament_index",
        "@ros_gz_bridge//:ament_index",
        "@ros_gz_bridge//:bridge_node",
    ],
    deps = [
        "//:ros_gz_sim_py",
        "@ros_gz_bridge//:ros_gz_bridge_py",
    ],
)

launch_ros_binary(
    name = "ros_gz_spawn_model_launch",
    src = "ros_gz_spawn_model.launch.py",
    data = [
        "//:ament_index",
        "//:create",
        "@rclcpp_components//:ament_index",
        "@ros_gz_bridge//:ament_index",
        "@ros_gz_bridge//:bridge_node",
    ],
    deps = [
        "//:ros_gz_sim_py",
        "@ros_gz_bridge//:ros_gz_bridge_py",
    ],
)
