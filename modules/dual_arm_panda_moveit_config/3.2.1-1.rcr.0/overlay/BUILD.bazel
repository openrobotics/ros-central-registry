load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

ament_index(
    name = "ament_index",
    data = ["//launch:launch_files"] + [
        "config/hand.xacro",
        "config/joint_limits.yaml",
        "config/kinematics.yaml",
        "config/left_initial_positions.yaml",
        "config/moveit_controllers.yaml",
        "config/ompl_planning.yaml",
        "config/panda.ros2_control.xacro",
        "config/panda.srdf",
        "config/panda.urdf.xacro",
        "config/panda_arm_macro.xacro",
        "config/panda_hand.ros2_control.xacro",
        "config/pilz_cartesian_limits.yaml",
        "config/right_initial_positions.yaml",
        "config/ros2_controllers.yaml",
    ],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@joint_state_publisher//:ament_package",
        "@joint_state_publisher_gui//:ament_package",
        "@moveit_resources_panda_description//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@topic_tools//:ament_package",
        "@xacro//:ament_package",
    ],
)
