load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:boost.filesystem_shared": "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.iostreams_shared": "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:lz4": "@rosdistro//cc:lz4_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:pcl": "@rosdistro//cc:pcl_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:static_transform_broadcaster_node": "@tf2_ros//:static_transform_broadcaster_node_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:eigen",
    "@sensor_msgs//:cc",
    "@std_srvs//:cc",
]

cc_library(
    name = "ply_to_xyz_transframer_lib_library",
    srcs = [
        "src/ply_to_xyz_transframer/ply_to_xyz_transframer.cpp",
        "src/ply_to_xyz_transframer/ply_to_xyz_transframer_interface.cpp",
    ],
    hdrs = [
        "include/ply_to_xyz_transframer/ply_to_xyz_transframer.hpp",
        "include/ply_to_xyz_transframer/ply_to_xyz_transframer_interface.hpp",
        "include/xyz_to_ply_transframer/xyz_to_ply_transframer.hpp",
        "include/xyz_to_ply_transframer/xyz_to_ply_transframer_interface.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ply_to_xyz_transframer_lib",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":ply_to_xyz_transframer_lib_library"],
)

cc_library(
    name = "xyz_to_ply_transframer_lib_library",
    srcs = [
        "src/xyz_to_ply_transframer/xyz_to_ply_transframer.cpp",
        "src/xyz_to_ply_transframer/xyz_to_ply_transframer_interface.cpp",
    ],
    hdrs = [
        "include/ply_to_xyz_transframer/ply_to_xyz_transframer.hpp",
        "include/ply_to_xyz_transframer/ply_to_xyz_transframer_interface.hpp",
        "include/xyz_to_ply_transframer/xyz_to_ply_transframer.hpp",
        "include/xyz_to_ply_transframer/xyz_to_ply_transframer_interface.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "xyz_to_ply_transframer_lib",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":xyz_to_ply_transframer_lib_library"],
)

# Each node links only its own component library: both component libraries
# statically embed PCL (which is only available as static libraries), so a
# binary linking both would link PCL twice.
collect_transitive_dynamic_deps(
    name = "ply_to_xyz_transframer_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ply_to_xyz_transframer_lib"],
)

collect_transitive_dynamic_deps(
    name = "xyz_to_ply_transframer_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":xyz_to_ply_transframer_lib"],
)

cc_binary(
    name = "ply_to_xyz_transframer_interface_node",
    srcs = ["src/ply_to_xyz_transframer/ply_to_xyz_transframer_interface_node.cpp"],
    dynamic_deps = [":ply_to_xyz_transframer_dynamic_deps"],
    includes = ["include"],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":ply_to_xyz_transframer_lib_library"],
)

cc_binary(
    name = "xyz_to_ply_transframer_interface_node",
    srcs = ["src/xyz_to_ply_transframer/xyz_to_ply_transframer_interface_node.cpp"],
    dynamic_deps = [":xyz_to_ply_transframer_dynamic_deps"],
    includes = ["include"],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":xyz_to_ply_transframer_lib_library"],
)

py_library(
    name = "pointcloud_to_ply",
    srcs = [
        "pointcloud_to_ply/__init__.py",
        "pointcloud_to_ply/pointcloud_to_ply_node.py",
    ],
    imports = ["."],
    deps = [
        "@rclpy",
        "@sensor_msgs//:py",
        "@sensor_msgs_py",
        "@std_srvs//:py",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_py",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "config/params.yaml",
        "//launch:launch_files",
    ],
    lib_data = [
        ":ply_to_xyz_transframer_interface_node",
        ":xyz_to_ply_transframer_interface_node",
        ":ply_to_xyz_transframer_lib",
        ":xyz_to_ply_transframer_lib",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@pcl_conversions//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@sensor_msgs//:ament_package",
        "@sensor_msgs_py//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@yaml_cpp_vendor//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/ply_to_xyz_transframer/ply_to_xyz_transframer.hpp",
        "include/ply_to_xyz_transframer/ply_to_xyz_transframer_interface.hpp",
        "include/xyz_to_ply_transframer/xyz_to_ply_transframer.hpp",
        "include/xyz_to_ply_transframer/xyz_to_ply_transframer_interface.hpp",
    ],
    include_prefix = "",
    package_xml = "package.xml",
    python = [":pointcloud_to_ply"],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@pcl_conversions//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@sensor_msgs//:ament_package",
        "@sensor_msgs_py//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@yaml_cpp_vendor//:ament_package",
    ],
)
