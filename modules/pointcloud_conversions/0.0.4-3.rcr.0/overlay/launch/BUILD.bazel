load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "ply_to_xyz_transframer.launch.xml",
        "pointcloud_to_ply.launch.xml",
        "xyz_to_ply_transframer.launch.xml",
    ],
)

launch_ros_binary(
    name = "ply_to_xyz_transframer_launch",
    src = "ply_to_xyz_transframer.launch.xml",
    deps = [
        "//:ply_to_xyz_transframer_interface_node",
        "//:pointcloud_to_ply",
    ],
)

launch_ros_binary(
    name = "pointcloud_to_ply_launch",
    src = "pointcloud_to_ply.launch.xml",
    data = ["//:ament_index"],
    deps = ["//:pointcloud_to_ply"],
)

launch_ros_binary(
    name = "xyz_to_ply_transframer_launch",
    src = "xyz_to_ply_transframer.launch.xml",
    deps = [
        "//:pointcloud_to_ply",
        "//:xyz_to_ply_transframer_interface_node",
    ],
)
