load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

### EXECUTABLES

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
    "@tf2_sensor_msgs//:tf2_sensor_msgs": "@tf2_sensor_msgs//:tf2_sensor_msgs_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

cc_library(
    name = "message_tf_frame_transformer_headers",
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include"],
    textual_hdrs = glob(["include/**/*.macro"]),
    deps = DEPENDENCIES.values() + [
        "@geometry_msgs//:cc",
        "@sensor_msgs//:cc",
    ],
)

cc_binary(
    name = "message_tf_frame_transformer",
    srcs = ["src/message_tf_frame_transformer.cpp"],
    copts = ["-std=c++17"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":message_tf_frame_transformer_headers",
    ],
)

### AMENT INDEX

DATA = glob(["launch/**"])

ament_index(
    name = "ament_index",
    data = DATA,
    executables = [":message_tf_frame_transformer"],
    package_xml = "package.xml",
)

launch_ros_binary(
    name = "message_tf_frame_transformer.launch.xml",
    src = "launch/message_tf_frame_transformer.launch.xml",
    data = [":ament_index"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    data = DATA,
    executables = [":message_tf_frame_transformer"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@tf2_sensor_msgs//:ament_package",
    ],
)
