    name = "gen_ceres_ceres_h",
    out = "_gen/include/ceres/ceres.h",
    content = ["#ifndef RCR_CERES_CERES_H_\n#define RCR_CERES_CERES_H_\n#include <Eigen/Dense>\n#include <algorithm>\n#include <cmath>\n#include <cstddef>\n#include <cstdint>\n#include <memory>\n#include <set>\n#include <string>\n#include <utility>\n#include <vector>\n#define CERES_VERSION_MAJOR 2\n#define CERES_VERSION_MINOR 1\n#define CERES_VERSION_REVISION 0\nnamespace ceres {\ntemplate <typename T> inline bool isinf(const T & x) { return std::isinf(static_cast<double>(x)); }\ntemplate <typename T> inline bool IsInfinite(const T & x) { return std::isinf(static_cast<double>(x)); }\ntemplate <typename T> inline T abs(const T & x) { return std::abs(x); }\ntemplate <typename T> inline T floor(const T & x) { return std::floor(x); }\ntemplate <typename T> inline T cos(const T & x) { return std::cos(x); }\ntemplate <typename T> inline T sin(const T & x) { return std::sin(x); }\ntemplate <typename T> inline T asin(const T & x) { return std::asin(x); }\ntemplate <typename T> inline T acos(const T & x) { return std::acos(x); }\ntemplate <typename T> inline T atan2(const T & y, const T & x) { return std::atan2(y, x); }\ntemplate <typename T> inline T sqrt(const T & x) { return std::sqrt(x); }\ntemplate <typename T> inline T exp(const T & x) { return std::exp(x); }\ntemplate <typename T> inline T log(const T & x) { return std::log(x); }\nenum Ownership { DO_NOT_TAKE_OWNERSHIP = 0, TAKE_OWNERSHIP = 1 };\nenum LinearSolverType { DENSE_NORMAL_CHOLESKY = 0, DENSE_QR = 1, SPARSE_NORMAL_CHOLESKY = 2, DENSE_SCHUR = 3, SPARSE_SCHUR = 4, ITERATIVE_SCHUR = 5, CGNR = 6 };\nenum PreconditionerType { IDENTITY = 0, JACOBI = 1, SCHUR_JACOBI = 2, CLUSTER_JACOBI = 3, CLUSTER_TRIDIAGONAL = 4, SUBSET = 5 };\nenum VisibilityClusteringType { CANONICAL_VIEWS = 0, SINGLE_LINKAGE = 1 };\nenum SparseLinearAlgebraLibraryType { SUITE_SPARSE = 0, EIGEN_SPARSE = 1, CX_SPARSE = 2, ACCELERATE_SPARSE = 3, NO_SPARSE = 4 };\nenum DenseLinearAlgebraLibraryType { EIGEN = 0, LAPACK = 1, CUDA = 2 };\nenum LoggingType { SILENT = 0, PER_MINIMIZER_ITERATION = 1 };\nenum MinimizerType { TRUST_REGION = 0, LINE_SEARCH = 1 };\nenum LineSearchDirectionType { STEEPEST_DESCENT = 0, NONLINEAR_CONJUGATE_GRADIENT = 1, LBFGS = 2, BFGS = 3 };\nenum LineSearchType { ARMIJO = 0, WOLFE = 1 };\nenum NonlinearConjugateGradientType { FLETCHER_REEVES = 0, POLAK_RIBIERE = 1, HESTENES_STIEFEL = 2 };\nenum LineSearchInterpolationType { BISECTION = 0, QUADRATIC = 1, CUBIC = 2 };\nenum TrustRegionStrategyType { LEVENBERG_MARQUARDT = 0, DOGLEG = 1 };\nenum DoglegType { TRADITIONAL_DOGLEG = 0, SUBSPACE_DOGLEG = 1 };\nenum CovarianceAlgorithmType { DENSE_SVD = 0, SPARSE_QR = 1 };\nenum DumpFormatType { CONSOLE = 0, PROTOBUF = 1, TEXTFILE = 2 };\n#define RCR_CERES_OPT_STR_FN(Opt, DefVal) \\\n  inline const char * Opt##ToString(Opt) { return #DefVal; } \\\n  inline bool StringTo##Opt(const std::string &, Opt * v) { if (v) *v = DefVal; return true; }\nRCR_CERES_OPT_STR_FN(CovarianceAlgorithmType, DENSE_SVD)\nRCR_CERES_OPT_STR_FN(DenseLinearAlgebraLibraryType, EIGEN)\nRCR_CERES_OPT_STR_FN(DoglegType, TRADITIONAL_DOGLEG)\ninline const char * DumpFormatTypeToString(DumpFormatType) { return \"CONSOLE\"; }\nRCR_CERES_OPT_STR_FN(LinearSolverType, SPARSE_NORMAL_CHOLESKY)\nRCR_CERES_OPT_STR_FN(LineSearchDirectionType, LBFGS)\nRCR_CERES_OPT_STR_FN(LineSearchInterpolationType, CUBIC)\nRCR_CERES_OPT_STR_FN(LineSearchType, WOLFE)\ninline const char * LoggingTypeToString(LoggingType) { return \"SILENT\"; }\nRCR_CERES_OPT_STR_FN(MinimizerType, TRUST_REGION)\nRCR_CERES_OPT_STR_FN(NonlinearConjugateGradientType, FLETCHER_REEVES)\nRCR_CERES_OPT_STR_FN(PreconditionerType, JACOBI)\nRCR_CERES_OPT_STR_FN(SparseLinearAlgebraLibraryType, SUITE_SPARSE)\nRCR_CERES_OPT_STR_FN(TrustRegionStrategyType, LEVENBERG_MARQUARDT)\nRCR_CERES_OPT_STR_FN(VisibilityClusteringType, CANONICAL_VIEWS)\n#undef RCR_CERES_OPT_STR_FN\ninline bool StringtoLoggingType(const std::string &, LoggingType * v) { if (v) *v = SILENT; return true; }\ninline boo