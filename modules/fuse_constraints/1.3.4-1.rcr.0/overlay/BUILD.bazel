        ":gen_ceres_cost_function_h",
        ":gen_ceres_cost_function_to_functor_h",
        ":gen_ceres_covariance_h",
        ":gen_ceres_cubic_interpolation_h",
        ":gen_ceres_dynamic_autodiff_cost_function_h",
        ":gen_ceres_internal_autodiff_h",
        ":gen_ceres_jet_h",
        ":gen_ceres_local_parameterization_h",
        ":gen_ceres_loss_function_h",
        ":gen_ceres_manifold_h",
        ":gen_ceres_normal_prior_h",
        ":gen_ceres_numeric_diff_cost_function_h",
        ":gen_ceres_problem_h",
        ":gen_ceres_rotation_h",
