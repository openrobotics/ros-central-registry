id register_type() {}\n};\nusing ArchiveStubBase = ArchiveStub;\nstruct binary_iarchive : ArchiveStub { using ArchiveStub::ArchiveStub; };\nstruct binary_oarchive : ArchiveStub { using ArchiveStub::ArchiveStub; };\nstruct text_iarchive : ArchiveStub { using ArchiveStub::ArchiveStub; };\nstruct text_oarchive : ArchiveStub { using ArchiveStub::ArchiveStub; };\n}  // namespace archive\n}  // namespace boost\n#define BOOST_SERIALIZATION_NVP(v) ::boost::serialization::make_nvp(#v, v)\n#define BOOST_SERIALIZATION_BASE_OBJECT_NVP(...) ::boost::serialization::base_object<__VA_ARGS__>(*this)\n#define BOOST_SERIALIZATION_ASSUME_ABSTRACT(...)\n#define BOOST_CLASS_EXPORT(...)\n#define BOOST_CLASS_EXPORT_KEY(...)\n#define BOOST_CLASS_EXPORT_IMPLEMENT(...)\n#define BOOST_SERIALIZATION_SPLIT_MEMBER()\n#define BOOST_SERIALIZATION_SPLIT_FREE(...)\n#endif\n"],
