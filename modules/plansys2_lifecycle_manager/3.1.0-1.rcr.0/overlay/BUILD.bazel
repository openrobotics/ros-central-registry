load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

HEADERS = ["include/plansys2_lifecycle_manager/lifecycle_manager.hpp"]

DEPENDENCIES = {
    "@lifecycle_msgs//:cc_shared": "@lifecycle_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

cc_library(
    name = "plansys2_lifecycle_manager_library",
    srcs = ["src/plansys2_lifecycle_manager/lifecycle_manager.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "plansys2_lifecycle_manager",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":plansys2_lifecycle_manager_library"],
)

### EXECUTABLES

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":plansys2_lifecycle_manager"],
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "lifecycle_manager_node",
    srcs = ["src/lifecycle_manager_node.cpp"],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":plansys2_lifecycle_manager_library",
    ],
)

### AMENT INDEX

ament_index(
    name = "ament_index",
    libraries = [":plansys2_lifecycle_manager"],
    package_xml = "package.xml",
)

### TESTS

# test/lf_manager_test.cpp links rclcpp_lifecycle, which upstream's
# package.xml does not declare (the colcon reference build patched it in),
# so it cannot be expressed as a Bazel dependency until that reaches the
# bootstrapped MODULE.bazel.

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rclcpp",
        "lifecycle_msgs",
    ],
    cmake_export_name = "export_plansys2_lifecycle_manager",
    executables = [":lifecycle_manager_node"],
    headers = HEADERS,
    libraries = [":plansys2_lifecycle_manager"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
