write_file(
    name = "gen_extra_5",
    out = "_gen/include/compass_conversions/compass_conversions/version.h",
    content = ["// Copyright 2015 Open Source Robotics Foundation, Inc.\n//\n// Licensed under the Apache License, Version 2.0 (the \"License\");\n// you may not use this file except in compliance with the License.\n// You may obtain a copy of the License at\n//\n//     http://www.apache.org/licenses/LICENSE-2.0\n//\n// Unless required by applicable law or agreed to in writing, software\n// distributed under the License is distributed on an \"AS IS\" BASIS,\n// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n// See the License for the specific language governing permissions and\n// limitations under the License.\n\n#ifndef COMPASS_CONVERSIONS__VERSION_H_\n#define COMPASS_CONVERSIONS__VERSION_H_\n\n/// \\def COMPASS_CONVERSIONS_VERSION_MAJOR\n/// Defines COMPASS_CONVERSIONS major version number\n#define COMPASS_CONVERSIONS_VERSION_MAJOR (4)\n\n/// \\def COMPASS_CONVERSIONS_VERSION_MINOR\n/// Defines COMPASS_CONVERSIONS minor version number\n#define COMPASS_CONVERSIONS_VERSION_MINOR (0)\n\n/// \\def COMPASS_CONVERSIONS_VERSION_PATCH\n/// Defines COMPASS_CONVERSIONS version patch number\n#define COMPASS_CONVERSIONS_VERSION_PATCH (1)\n\n/// \\def COMPASS_CONVERSIONS_VERSION_STR\n/// Defines COMPASS_CONVERSIONS version string\n#define COMPASS_CONVERSIONS_VERSION_STR \"4.0.1\"\n\n/// \\def COMPASS_CONVERSIONS_VERSION_GTE\n/// Defines a macro to check whether the version of COMPASS_CONVERSIONS is greater than or equal to\n/// the given version triple.\n#define COMPASS_CONVERSIONS_VERSION_GTE(major, minor, patch) ( \\\n     (major < COMPASS_CONVERSIONS_VERSION_MAJOR) ? true \\\n     : ((major > COMPASS_CONVERSIONS_VERSION_MAJOR) ? false \\\n     : ((minor < COMPASS_CONVERSIONS_VERSION_MINOR) ? true \\\n     : ((minor > COMPASS_CONVERSIONS_VERSION_MINOR) ? false \\\n     : ((patch < COMPASS_CONVERSIONS_VERSION_PATCH) ? true \\\n     : ((patch > COMPASS_CONVERSIONS_VERSION_PATCH) ? false \\\n     : true))))))\n\n#endif  // COMPASS_CONVERSIONS__VERSION_H_\n"],
)

write_file(
    name = "gen_geographiclib_utmups_hpp",
    out = "_gen/include/GeographicLib/UTMUPS.hpp",
    content = ["#ifndef RCR_GEOGRAPHICLIB_UTMUPS_HPP_\n#define RCR_GEOGRAPHICLIB_UTMUPS_HPP_\n#include <cmath>\nnamespace GeographicLib {\nclass UTMUPS {\n public:\n  static void Forward(double lat, double lon, int & zone, bool & northp, double & x, double & y) {\n    zone = static_cast<int>((lon + 180.0) / 6.0) + 1;\n    northp = (lat >= 0.0);\n    constexpr double kPi = 3.14159265358979323846;\n    constexpr double a = 6378137.0;\n    constexpr double f = 1.0 / 298.257223563;\n    constexpr double k0 = 0.9996;\n    double e2 = f * (2.0 - f);\n    double ep2 = e2 / (1.0 - e2);\n    double phi = lat * kPi / 180.0;\n    double lam = lon * kPi / 180.0;\n    double lam0 = ((zone - 1) * 6 - 180 + 3) * kPi / 180.0;\n    double sin_phi = std::sin(phi), cos_phi = std::cos(phi), tan_phi = std::tan(phi);\n    double N = a / std::sqrt(1.0 - e2 * sin_phi * sin_phi);\n    double T = tan_phi * tan_phi;\n    double C = ep2 * cos_phi * cos_phi;\n    double A = cos_phi * (lam - lam0);\n    double M = a * ((1.0 - e2 / 4.0 - 3.0 * e2 * e2 / 64.0) * phi\n      - (3.0 * e2 / 8.0 + 3.0 * e2 * e2 / 32.0) * std::sin(2.0 * phi)\n      + (15.0 * e2 * e2 / 256.0) * std::sin(4.0 * phi));\n    x = k0 * N * (A + (1.0 - T + C) * A * A * A / 6.0) + 500000.0;\n    y = k0 * (M + N * tan_phi * (A * A / 2.0 + (5.0 - T + 9.0 * C + 4.0 * C * C) * A * A * A * A / 24.0));\n    if (!northp) y += 10000000.0;\n  }\n};\n}  // namespace GeographicLib\n#endif\n"],
)

