    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_compass_conversions",
    headers = [":version_h"] + [
        "include/compass_conversions/compass_converter.hpp",
        "include/compass_conversions/compass_transformer.hpp",
        "include/compass_conversions/message_filter.hpp",
        "include/compass_conversions/tf2_compass_msgs.hpp",
        "include/compass_conversions/topic_names.hpp",
    ],
    include_prefix = "",
    libraries = [
        ":compass_topic_names",
        ":compass_converter",
        ":compass_message_filter",
        ":tf2_compass_msgs",
        ":compass_transformer_nodelet_lib",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@angles//:ament_package",
        "@compass_interfaces//:ament_package",
        "@cras_cpp_common//:ament_package",
        "@cras_lint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch_ros//:ament_package",
        "@magnetic_model//:ament_package",
        "@message_filters//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
