load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines", "ros_version_header")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@compass_interfaces//:compass_interfaces_string_utils": "@compass_interfaces//:compass_interfaces_string_utils_library",
    "@cras_cpp_common//:cras_log_utils": "@cras_cpp_common//:cras_log_utils_library",
    "@cras_cpp_common//:cras_string_utils": "@cras_cpp_common//:cras_string_utils_library",
    "@cras_cpp_common//:cras_tf2_utils": "@cras_cpp_common//:cras_tf2_utils_library",
    "@cras_cpp_common//:cras_time_utils": "@cras_cpp_common//:cras_time_utils_library",
    "@magnetic_model//:magnetic_model": "@magnetic_model//:magnetic_model_library",
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:geographiclib": "@rosdistro//cc:geographiclib_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@angles//:angles",
    "@compass_interfaces//:cc",
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:fmt",
    "@rosdistro//cc:tl_expected",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

_HDRS = [
    "include/compass_conversions/compass_converter.hpp",
    "include/compass_conversions/compass_transformer.hpp",
    "include/compass_conversions/message_filter.hpp",
    "include/compass_conversions/tf2_compass_msgs.hpp",
    "include/compass_conversions/topic_names.hpp",
    ":version_h",
]

cc_library(
    name = "compass_topic_names_library",
    srcs = ["src/topic_names.cpp"],
    hdrs = _HDRS,
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/compass_conversions",
        "_gen/include/compass_conversions/compass_conversions",
        "include",
        "include/compass_conversions",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_shared_library(
    name = "compass_topic_names",
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":compass_topic_names_library"],
)

cc_library(
    name = "compass_converter_library",
    srcs = ["src/compass_converter.cpp"],
    hdrs = _HDRS,
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/compass_conversions",
        "_gen/include/compass_conversions/compass_conversions",
        "include",
        "include/compass_conversions",
    ],
    local_defines = ros_local_defines() + ["MESSAGE_FILTERS_VERSION_SUBSCRIBER_USES_NODE_INTERFACES=1"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":compass_topic_names_library"],
)

cc_shared_library(
    name = "compass_converter",
    dynamic_deps = [
        ":transitive_dynamic_deps",
        ":compass_topic_names",
    ],
    deps = [":compass_converter_library"],
)

cc_library(
    name = "compass_message_filter_library",
    srcs = ["src/message_filter.cpp"],
    hdrs = _HDRS,
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/compass_conversions",
        "_gen/include/compass_conversions/compass_conversions",
        "include",
        "include/compass_conversions",
    ],
    local_defines = ros_local_defines() + ["MESSAGE_FILTERS_VERSION_SUBSCRIBER_USES_NODE_INTERFACES=1"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":compass_converter_library",
        ":compass_topic_names_library",
    ],
)

cc_shared_library(
    name = "compass_message_filter",
    dynamic_deps = [
        ":transitive_dynamic_deps",
        ":compass_converter",
        ":compass_topic_names",
    ],
    deps = [":compass_message_filter_library"],
)

cc_library(
    name = "tf2_compass_msgs_library",
    srcs = ["src/tf2_compass_msgs.cpp"],
    hdrs = _HDRS,
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/compass_conversions",
        "_gen/include/compass_conversions/compass_conversions",
        "include",
        "include/compass_conversions",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "tf2_compass_msgs",
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":tf2_compass_msgs_library"],
)

cc_library(
    name = "compass_transformer_nodelet_lib_library",
    srcs = ["nodelets/compass_transformer.cpp"],
    hdrs = _HDRS,
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/compass_conversions",
        "_gen/include/compass_conversions/compass_conversions",
        "include",
        "include/compass_conversions",
    ],
    local_defines = ros_local_defines() + [
        "MESSAGE_FILTERS_VERSION_SUBSCRIBER_USES_NODE_INTERFACES=1",
        "TF2_ROS_HAS_NODE_INTERFACES=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":compass_converter_library",
        ":compass_message_filter_library",
        ":compass_topic_names_library",
        ":tf2_compass_msgs_library",
    ],
)

cc_shared_library(
    name = "compass_transformer_nodelet_lib",
    dynamic_deps = [
        ":transitive_dynamic_deps",
        ":compass_converter",
        ":compass_message_filter",
        ":compass_topic_names",
        ":tf2_compass_msgs",
    ],
    deps = [":compass_transformer_nodelet_lib_library"],
)

rclcpp_components_register_node(
    name = "compass_transformer",
    component = ":compass_transformer_nodelet_lib",
    node_name = "compass_transformer",
    plugin = "compass_conversions::CompassTransformerNodelet",
)

ros_version_header(
    name = "version_h",
    out = "_gen/include/compass_conversions/compass_conversions/version.h",
)

ament_index(
    name = "ament_index",
    components = [":compass_transformer_record"],
    data = ["//launch:launch_files"],
    lib_data = [":compass_transformer"],
    libraries = [
        ":compass_topic_names",
        ":compass_converter",
        ":compass_message_filter",
        ":tf2_compass_msgs",
        ":compass_transformer_nodelet_lib",
    ],
    package_xml = "package.xml",
    plugin_category = "rclcpp",
    plugins = ["plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@angles//:ament_package",
        "@compass_interfaces//:ament_package",
        "@cras_cpp_common//:ament_package",
        "@cras_lint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch_ros//:ament_package",
        "@magnetic_model//:ament_package",
        "@message_filters//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "compass_interfaces",
        "cras_cpp_common",
        "geometry_msgs",
        "message_filters",
        "rclcpp",
        "sensor_msgs",
        "std_msgs",
        "tf2",
        "tf2_ros",
