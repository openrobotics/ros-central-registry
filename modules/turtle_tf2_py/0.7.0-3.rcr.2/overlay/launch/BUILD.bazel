load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "turtle_tf2_demo.launch.py",
        "turtle_tf2_dynamic_frame_demo.launch.py",
        "turtle_tf2_fixed_frame_demo.launch.py",
        "turtle_tf2_sensor_message.launch.py",
    ],
)

launch_ros_binary(
    name = "turtle_tf2_demo_launch",
    src = "turtle_tf2_demo.launch.py",
    data = [
        "//:ament_index",
        "@turtlesim//:ament_index",
        "@turtlesim//:turtlesim_node",
    ],
    deps = ["//:turtle_tf2_py"],
)

launch_ros_binary(
    name = "turtle_tf2_dynamic_frame_demo_launch",
    src = "turtle_tf2_dynamic_frame_demo.launch.py",
    data = ["//:ament_index"],
    deps = [
        "//:turtle_tf2_py",
        "@ament_index_python",
    ],
)

launch_ros_binary(
    name = "turtle_tf2_fixed_frame_demo_launch",
    src = "turtle_tf2_fixed_frame_demo.launch.py",
    data = ["//:ament_index"],
    deps = [
        "//:turtle_tf2_py",
        "@ament_index_python",
    ],
)

launch_ros_binary(
    name = "turtle_tf2_sensor_message_launch",
    src = "turtle_tf2_sensor_message.launch.py",
    data = [
        "//:ament_index",
        "@turtlesim//:ament_index",
        "@turtlesim//:turtlesim_node",
    ],
    deps = ["//:turtle_tf2_py"],
)
