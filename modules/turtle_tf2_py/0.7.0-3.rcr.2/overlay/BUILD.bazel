load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
    ]
]

py_library(
    name = "turtle_tf2_py",
    srcs = glob(["turtle_tf2_py/**/*.py"]),
    imports = ["."],
    deps = [
        "@geometry_msgs//:py",
        "@launch",
        "@launch_ros",
        "@rclpy",
        "@turtlesim_msgs//:py",
        requirement("numpy"),
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "launch/turtle_tf2_demo.launch.py",
        "launch/turtle_tf2_dynamic_frame_demo.launch.py",
        "launch/turtle_tf2_fixed_frame_demo.launch.py",
        "launch/turtle_tf2_sensor_message.launch.py",
        "rviz/turtle_rviz.rviz",
    ],
    package_xml = "package.xml",
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [":ament_index"],
        deps = [":turtle_tf2_py"],
    )
    for f in glob(["launch/**"])
]

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "dynamic_frame_tf2_broadcaster": "turtle_tf2_py.dynamic_frame_tf2_broadcaster:main",
        "fixed_frame_tf2_broadcaster": "turtle_tf2_py.fixed_frame_tf2_broadcaster:main",
        "static_turtle_tf2_broadcaster": "turtle_tf2_py.static_turtle_tf2_broadcaster:main",
        "turtle_tf2_broadcaster": "turtle_tf2_py.turtle_tf2_broadcaster:main",
        "turtle_tf2_listener": "turtle_tf2_py.turtle_tf2_listener:main",
        "turtle_tf2_message_broadcaster": "turtle_tf2_py.turtle_tf2_message_broadcaster:main",
    },
    data = [
        "launch/turtle_tf2_demo.launch.py",
        "launch/turtle_tf2_dynamic_frame_demo.launch.py",
        "launch/turtle_tf2_fixed_frame_demo.launch.py",
        "launch/turtle_tf2_sensor_message.launch.py",
        "rviz/turtle_rviz.rviz",
    ],
    package_xml = "package.xml",
    python = [":turtle_tf2_py"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@tf2_ros//:ament_package",
        "@turtlesim_msgs//:ament_package",
    ],
)
