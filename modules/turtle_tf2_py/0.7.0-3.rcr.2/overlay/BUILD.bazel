load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["test/test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "package.xml",
        "resource/turtle_tf2_py",
        "rviz/turtle_rviz.rviz",
        "setup.cfg",
        "setup.py",
        "test/test_copyright.py",
        "test/test_flake8.py",
        "test/test_pep257.py",
        "turtle_tf2_py/__init__.py",
        "turtle_tf2_py/dynamic_frame_tf2_broadcaster.py",
        "turtle_tf2_py/fixed_frame_tf2_broadcaster.py",
        "turtle_tf2_py/static_turtle_tf2_broadcaster.py",
        "turtle_tf2_py/turtle_tf2_broadcaster.py",
        "turtle_tf2_py/turtle_tf2_listener.py",
        "turtle_tf2_py/turtle_tf2_message_broadcaster.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
]]

py_library(
    name = "turtle_tf2_py",
    srcs = [
        "turtle_tf2_py/__init__.py",
        "turtle_tf2_py/dynamic_frame_tf2_broadcaster.py",
        "turtle_tf2_py/fixed_frame_tf2_broadcaster.py",
        "turtle_tf2_py/static_turtle_tf2_broadcaster.py",
        "turtle_tf2_py/turtle_tf2_broadcaster.py",
        "turtle_tf2_py/turtle_tf2_listener.py",
        "turtle_tf2_py/turtle_tf2_message_broadcaster.py",
    ],
    imports = ["."],
    deps = [
        "@geometry_msgs//:py",
        "@launch",
        "@launch_ros",
        "@rclpy",
        "@turtlesim_msgs//:py",
        requirement("numpy"),
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "rviz/turtle_rviz.rviz",
        "//launch:launch_files",
    ],
    package_xml = "package.xml",
)

CONSOLE_SCRIPTS = [
    "dynamic_frame_tf2_broadcaster",
    "fixed_frame_tf2_broadcaster",
    "static_turtle_tf2_broadcaster",
    "turtle_tf2_broadcaster",
    "turtle_tf2_listener",
    "turtle_tf2_message_broadcaster",
]

[
    (
        write_file(
            name = "{0}_entry".format(script),
            out = "{0}_entry.py".format(script),
            content = [
                "import sys",
                "from turtle_tf2_py.{0} import main".format(script),
                "sys.exit(main())",
                "",
            ],
        ),
        py_binary(
            name = script,
            srcs = [":{0}_entry".format(script)],
            data = [":ament_index"],
            main = "{0}_entry.py".format(script),
            deps = [":turtle_tf2_py"],
        ),
    )
    for script in CONSOLE_SCRIPTS
]

ament_package(
    name = "ament_package",
    console_scripts = {
        "dynamic_frame_tf2_broadcaster": "turtle_tf2_py.dynamic_frame_tf2_broadcaster:main",
        "fixed_frame_tf2_broadcaster": "turtle_tf2_py.fixed_frame_tf2_broadcaster:main",
        "static_turtle_tf2_broadcaster": "turtle_tf2_py.static_turtle_tf2_broadcaster:main",
        "turtle_tf2_broadcaster": "turtle_tf2_py.turtle_tf2_broadcaster:main",
        "turtle_tf2_listener": "turtle_tf2_py.turtle_tf2_listener:main",
        "turtle_tf2_message_broadcaster": "turtle_tf2_py.turtle_tf2_message_broadcaster:main",
    },
    executables = [":{0}".format(s) for s in CONSOLE_SCRIPTS],
    package_xml = "package.xml",
    python = [":turtle_tf2_py"],
    deps = [":ament_index"] + [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@tf2_ros//:ament_package",
        "@turtlesim_msgs//:ament_package",
    ],
)
