load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@polygon_msgs//:cc",
]

cc_library(
    name = "polygon_utils_library",
    srcs = ["src/polygon_utils.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/polygon_utils",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "polygon_utils",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":polygon_utils_library"],
)

py_library(
    name = "polygon_utils_py",
    srcs = glob(["polygon_utils/**/*.py"]),
    imports = ["."],
    deps = [
        "@geometry_msgs//:py",
        "@polygon_msgs//:py",
    ],
)

ament_index(
    name = "ament_index",
    libraries = [":polygon_utils"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@geometry_msgs//:ament_package",
        "@polygon_msgs//:ament_package",
    ],
)

py_pytest(
    name = "short_path",
    srcs = ["test/test_shortest_path.py"],
    data = [":ament_index"],
    deps = [
        ":polygon_utils_py",
        "@geometry_msgs//:py",
        "@polygon_msgs//:py",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_polygon_utils",
    headers = glob(["include/**"]),
    include_prefix = "",
    libraries = [":polygon_utils"],
    package_xml = "package.xml",
    python = [":polygon_utils_py"],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@geometry_msgs//:ament_package",
        "@polygon_msgs//:ament_package",
    ],
)
