load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@polygon_msgs//:cc",
]

cc_library(
    name = "polygon_utils_library",
    srcs = ["src/polygon_utils.cpp"],
    hdrs = [
        "include/mapbox/earcut.hpp",
        "include/polygon_utils/polygon_utils.hpp",
    ],
    includes = [
        "include",
        "include/polygon_utils",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "polygon_utils",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":polygon_utils_library"],
)

py_library(
    name = "polygon_utils_py",
    srcs = [
        "polygon_utils/__init__.py",
        "polygon_utils/shapely_lib.py",
        "polygon_utils/shortest_path.py",
    ],
    imports = ["."],
    deps = [
        "@geometry_msgs//:py",
        "@polygon_msgs//:py",
    ],
)

ament_index(
    name = "ament_index",
    libraries = [":polygon_utils"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@geometry_msgs//:ament_package",
        "@polygon_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_polygon_utils",
    headers = [
        "include/mapbox/LICENSE",
        "include/mapbox/NOTES",
        "include/mapbox/earcut.hpp",
        "include/polygon_utils/polygon_utils.hpp",
    ],
    include_prefix = "",
    libraries = [":polygon_utils"],
    package_xml = "package.xml",
    python = [":polygon_utils_py"],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@geometry_msgs//:ament_package",
        "@polygon_msgs//:ament_package",
    ],
)
