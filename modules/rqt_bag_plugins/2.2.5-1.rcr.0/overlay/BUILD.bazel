load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

exports_files(["package.xml"])

### DATA

ament_index(
    name = "ament_index",
    data = ["resource/plot.ui"] + ["plugin.xml"],
    package_xml = "package.xml",
)

### LIBRARIES

py_library(
    name = "rqt_bag_plugins",
    srcs = [
        "src/rqt_bag_plugins/__init__.py",
        "src/rqt_bag_plugins/image_helper.py",
        "src/rqt_bag_plugins/image_plugin.py",
        "src/rqt_bag_plugins/image_qt.py",
        "src/rqt_bag_plugins/image_timeline_renderer.py",
        "src/rqt_bag_plugins/image_view.py",
        "src/rqt_bag_plugins/plot_plugin.py",
        "src/rqt_bag_plugins/plot_view.py",
    ],
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@ament_index_python",
        "@builtin_interfaces//:py",
        "@geometry_msgs//:py",
        "@rclpy",
        "@rosbag2",
        "@rqt_bag",
        "@rqt_gui",
        "@rqt_gui_py",
        "@rqt_plot",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        requirement("pillow"),
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":rqt_bag_plugins"],
    python_strip_prefix = "src",
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosbag2//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_bag//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@rqt_plot//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
