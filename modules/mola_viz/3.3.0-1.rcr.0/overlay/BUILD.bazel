load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
)

DEPENDENCIES = {
    "@mola_kernel//:mola_kernel": "@mola_kernel//:mola_kernel_library",
    "@mrpt_gui//:mrpt_gui": "@mrpt_gui//:mrpt_gui_library",
    "@mrpt_gui//:mrpt_nanogui": "@mrpt_gui//:mrpt_nanogui_library",
    "@mrpt_maps//:mrpt_maps": "@mrpt_maps//:mrpt_maps_library",
    "@mrpt_opengl//:mrpt_opengl": "@mrpt_opengl//:mrpt_opengl_library",
    "@mrpt_viz//:mrpt_viz": "@mrpt_viz//:mrpt_viz_library",
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "mola_viz_library",
    srcs = ["src/MolaViz.cpp"],
    hdrs = ["include/mola_viz/MolaViz.h"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/mola_viz",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=3",
        "MOLA_PATCH_VERSION=0",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_shared_library(
    name = "mola_viz",
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":mola_viz_library"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mola_viz",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_viz": [
            "libmola_viz.so.3.3",
            "libmola_viz.so.3.3.0",
        ],
    },
    deps = [
        "@mola_kernel//:ament_package",
        "@mrpt_gui//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_opengl//:ament_package",
        "@mrpt_viz//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = ["include/mola_viz/MolaViz.h"],
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mola_viz",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_viz": [
            "libmola_viz.so.3.3",
            "libmola_viz.so.3.3.0",
        ],
    },
    deps = [":ament_index"] + [
        "@mola_kernel//:ament_package",
        "@mrpt_gui//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_opengl//:ament_package",
        "@mrpt_viz//:ament_package",
    ],
)
