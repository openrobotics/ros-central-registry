load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@ecl_errors//:ecl_errors": "@ecl_errors//:ecl_errors_library",
    "@ecl_exceptions//:ecl_exceptions": "@ecl_exceptions//:ecl_exceptions_library",
    "@ecl_time_lite//:ecl_time_lite": "@ecl_time_lite//:ecl_time_lite_library",
}

CC_DEPS = [
    "@ecl_config",
]

HEADERS = [
    "include/ecl/time.hpp",
    "include/ecl/time/cpuwatch.hpp",
    "include/ecl/time/cpuwatch_rt.hpp",
    "include/ecl/time/duration.hpp",
    "include/ecl/time/frequency.hpp",
    "include/ecl/time/macros.hpp",
    "include/ecl/time/random_number_generator.hpp",
    "include/ecl/time/sleep.hpp",
    "include/ecl/time/sleep_pos.hpp",
    "include/ecl/time/sleep_win.hpp",
    "include/ecl/time/snooze.hpp",
    "include/ecl/time/snooze_pos.hpp",
    "include/ecl/time/snooze_win.hpp",
    "include/ecl/time/stopwatch.hpp",
    "include/ecl/time/time_data.hpp",
    "include/ecl/time/timestamp.hpp",
    "include/ecl/time/timestamp_base.hpp",
    "include/ecl/time/timestamp_pos.hpp",
    "include/ecl/time/timestamp_win.hpp",
]

cc_library(
    name = "ecl_time_library",
    srcs = [
        "src/lib/cpuwatch_rt.cpp",
        "src/lib/frequency.cpp",
        "src/lib/sleep_pos.cpp",
        "src/lib/sleep_win.cpp",
        "src/lib/snooze_pos.cpp",
        "src/lib/snooze_win.cpp",
        "src/lib/stopwatch.cpp",
        "src/lib/time_data.cpp",
        "src/lib/timestamp_base.cpp",
        "src/lib/timestamp_pos.cpp",
        "src/lib/timestamp_win.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ecl_time",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "libecl_time.so",
    deps = [":ecl_time_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ecl_time"],
)

cc_binary(
    name = "demo_random_number_generator",
    srcs = ["src/examples/random_number_generator.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":ecl_time_library"],
)

cc_binary(
    name = "demo_sleep",
    srcs = ["src/examples/sleep.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":ecl_time_library"],
)

cc_test(
    name = "ecl_test_cpuwatch_rt",
    srcs = ["src/test/cpuwatch_rt.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":ecl_time_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "ecl_test_frequency",
    srcs = ["src/test/frequency.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":ecl_time_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "ecl_test_sleep",
    srcs = ["src/test/sleep.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":ecl_time_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "ecl_test_snooze",
    srcs = ["src/test/snooze.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":ecl_time_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "ecl_test_timestamp",
    srcs = ["src/test/timestamp.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":ecl_time_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "ecl_test_time_data",
    srcs = ["src/test/time_data.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":ecl_time_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "ecl_test_stopwatch",
    srcs = ["src/test/stopwatch.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":ecl_time_library",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_index(
    name = "ament_index",
    libraries = [":ecl_time"],
    package_xml = "package.xml",
    sonames = {"ecl_time": ["libecl_time.so.1.2.1"]},
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "ecl_config",
        "ecl_errors",
        "ecl_exceptions",
        "ecl_time_lite",
    ],
    executables = [
        ":demo_random_number_generator",
        ":demo_sleep",
    ],
    headers = HEADERS,
    include_prefix = "",
    libraries = [":ecl_time"],
    package_xml = "package.xml",
    sonames = {"ecl_time": ["libecl_time.so.1.2.1"]},
    deps = [
        ":ament_index",
        "@ecl_build//:ament_package",
        "@ecl_config//:ament_package",
        "@ecl_errors//:ament_package",
        "@ecl_exceptions//:ament_package",
        "@ecl_license//:ament_package",
        "@ecl_time_lite//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
