load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@urdf//:urdf": "@urdf//:urdf_library",
    "@urdfdom_headers//:urdfdom_headers": "@urdfdom_headers//:urdfdom_headers_library",
}

cc_library(
    name = "kdl_parser_library",
    srcs = ["src/kdl_parser.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["KDL_PARSER_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:eigen",
    ],
)

cc_shared_library(
    name = "kdl_parser",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":kdl_parser_library"],
    deps = [":kdl_parser_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":kdl_parser"],
    visibility = ["//visibility:private"],
)

### TESTS

cc_test(
    name = "test_inertia_rpy",
    srcs = ["test/test_inertia_rpy.cpp"],
    data = ["@urdf//:ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        ":kdl_parser_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_kdl_parser",
    srcs = ["test/test_kdl_parser.cpp"],
    data = ["@urdf//:ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        ":kdl_parser_library",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_kdl_parser",
    headers = HEADERS,
    libraries = [":kdl_parser"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
        "@urdf//:ament_package",
        "@urdfdom_headers//:ament_package",
    ],
)
