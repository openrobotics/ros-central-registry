    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_graphslam",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mrpt_graphslam_library"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_graphslam",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_graphslam": [
            "libmrpt_graphslam.so.3.3",
            "libmrpt_graphslam.so.3.3.1",
