load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### PACKAGING

default_generators(
    dependencies = [
        "@geometry_msgs",
        "@sensor_msgs",
        "@shape_msgs",
        "@std_msgs",
    ],
    package_xml = "package.xml",
    deps = [
        "//action:ObjectRecognition",
        "//msg:ObjectInformation",
        "//msg:ObjectType",
        "//msg:RecognizedObject",
        "//msg:RecognizedObjectArray",
        "//msg:Table",
        "//msg:TableArray",
        "//srv:GetObjectInformation",
    ],
)

rosidl_ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@action_msgs//:ament_package",
        "@ament_cmake//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@sensor_msgs//:ament_package",
        "@shape_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
