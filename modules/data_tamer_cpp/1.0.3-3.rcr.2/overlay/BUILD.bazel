load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:mcap": "@rosdistro//cc:mcap_library",
}

CC_DEPS = [
    "@data_tamer_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "data_tamer_library",
    srcs = [
        "src/channel.cpp",
        "src/data_sink.cpp",
        "src/data_tamer.cpp",
        "src/sinks/mcap_sink.cpp",
        "src/sinks/ros2_publisher_sink.cpp",
        "src/types.cpp",
    ],
    hdrs = [
        "3rdparty/ConcurrentQueue/blockingconcurrentqueue.h",
        "3rdparty/ConcurrentQueue/concurrentqueue.h",
        "3rdparty/ConcurrentQueue/lightweightsemaphore.h",
        "3rdparty/mcap/include/mcap/crc32.hpp",
        "3rdparty/mcap/include/mcap/errors.hpp",
        "3rdparty/mcap/include/mcap/internal.hpp",
        "3rdparty/mcap/include/mcap/intervaltree.hpp",
        "3rdparty/mcap/include/mcap/mcap.hpp",
        "3rdparty/mcap/include/mcap/read_job_queue.hpp",
        "3rdparty/mcap/include/mcap/reader.hpp",
        "3rdparty/mcap/include/mcap/reader.inl",
        "3rdparty/mcap/include/mcap/types.hpp",
        "3rdparty/mcap/include/mcap/types.inl",
        "3rdparty/mcap/include/mcap/visibility.hpp",
        "3rdparty/mcap/include/mcap/writer.hpp",
        "3rdparty/mcap/include/mcap/writer.inl",
        "examples/geometry_types.hpp",
        "include/data_tamer/channel.hpp",
        "include/data_tamer/contrib/SerializeMe.hpp",
        "include/data_tamer/custom_types.hpp",
        "include/data_tamer/data_sink.hpp",
        "include/data_tamer/data_tamer.hpp",
        "include/data_tamer/details/locked_reference.hpp",
        "include/data_tamer/logged_value.hpp",
        "include/data_tamer/sinks/dummy_sink.hpp",
        "include/data_tamer/sinks/mcap_sink.hpp",
        "include/data_tamer/sinks/ros2_publisher_sink.hpp",
        "include/data_tamer/types.hpp",
        "include/data_tamer/values.hpp",
        "include/data_tamer_parser/data_tamer_parser.hpp",
    ],
    includes = [
        "3rdparty",
        "include",
        "tests",
    ],
    local_defines = ros_local_defines() + [
        'DATA_TAMER_VERSION=\\"1.0.0\\"',
        "USING_ROS2=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "data_tamer",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":data_tamer_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":data_tamer"],
)

cc_binary(
    name = "ros2_publisher",
    srcs = ["examples/ros2_publisher.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "3rdparty",
        "include",
        "tests",
    ],
    local_defines = ros_local_defines() + [
        'DATA_TAMER_VERSION=\\"1.0.0\\"',
        "USING_ROS2=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":data_tamer_library"],
)

ament_index(
    name = "ament_index",
    lib_data = [":ros2_publisher"],
    libraries = [":data_tamer"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@data_tamer_msgs//:ament_package",
        "@gtest_vendor//:ament_package",
        "@mcap_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "data_tamer_msgs",
        "mcap_vendor",
        "rclcpp",
        "rclcpp_lifecycle",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "data_tamerTargets",
    headers = [
        "include/data_tamer/channel.hpp",
        "include/data_tamer/contrib/SerializeMe.hpp",
        "include/data_tamer/custom_types.hpp",
        "include/data_tamer/data_sink.hpp",
        "include/data_tamer/data_tamer.hpp",
        "include/data_tamer/details/locked_reference.hpp",
        "include/data_tamer/logged_value.hpp",
        "include/data_tamer/sinks/dummy_sink.hpp",
        "include/data_tamer/sinks/mcap_sink.hpp",
        "include/data_tamer/sinks/ros2_publisher_sink.hpp",
        "include/data_tamer/types.hpp",
        "include/data_tamer/values.hpp",
        "include/data_tamer_parser/data_tamer_parser.hpp",
    ],
    include_prefix = "",
    libraries = [":data_tamer"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@data_tamer_msgs//:ament_package",
        "@gtest_vendor//:ament_package",
        "@mcap_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
    ],
)
