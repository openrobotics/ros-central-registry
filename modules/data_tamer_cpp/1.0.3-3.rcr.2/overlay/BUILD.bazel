load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:mcap": "@rosdistro//cc:mcap_library",
}

CC_DEPS = [
    "@data_tamer_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "data_tamer_library",
    srcs = [
        "src/channel.cpp",
        "src/data_sink.cpp",
        "src/data_tamer.cpp",
        "src/sinks/mcap_sink.cpp",
        "src/sinks/ros2_publisher_sink.cpp",
        "src/types.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    includes = [
        "3rdparty",
        "include",
        "tests",
    ],
    local_defines = ros_local_defines() + [
        "DATA_TAMER_VERSION=\\\"1.0.0\\\"",
        "USING_ROS2=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "data_tamer",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":data_tamer_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":data_tamer"],
)

cc_binary(
    name = "ros2_publisher",
    srcs = ["examples/ros2_publisher.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "3rdparty",
        "include",
        "tests",
    ],
    local_defines = ros_local_defines() + [
        "DATA_TAMER_VERSION=\\\"1.0.0\\\"",
        "USING_ROS2=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":data_tamer_library"],
)

ament_index(
    name = "ament_index",
    lib_data = [":ros2_publisher"],
    libraries = [":data_tamer"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@data_tamer_msgs//:ament_package",
        "@gtest_vendor//:ament_package",
        "@mcap_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
    ],
)

cc_test(
    name = "datatamer_test",
    srcs = [
        "tests/custom_types_tests.cpp",
        "tests/dt_tests.cpp",
        "tests/parser_tests.cpp",
    ] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    data = [":ament_index"] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "3rdparty",
        "include",
        "tests",
    ],
    local_defines = ros_local_defines() + [
        "DATA_TAMER_VERSION=\\\"1.0.0\\\"",
        "USING_ROS2=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":data_tamer_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "mcap_vendor",
        "rclcpp",
        "rclcpp_lifecycle",
        "data_tamer_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "data_tamerTargets",
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [":data_tamer"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@data_tamer_msgs//:ament_package",
        "@gtest_vendor//:ament_package",
        "@mcap_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
    ],
)
