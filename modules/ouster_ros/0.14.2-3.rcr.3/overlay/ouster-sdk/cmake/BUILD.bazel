load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

exports_files(["build.h.in"])

pkg_files(
    name = "ouster_sdk_cmake",
    srcs = [
        "Coverage.cmake",
        "FindCURL.cmake",
        "FindEigen3.cmake",
        "FindPcap.cmake",
        "Findglfw3.cmake",
        "Findlibtins.cmake",
        "Findlibzip.cmake",
        "VcpkgEnv.cmake",
    ],
    prefix = "lib/cmake/OusterSDK",
)
