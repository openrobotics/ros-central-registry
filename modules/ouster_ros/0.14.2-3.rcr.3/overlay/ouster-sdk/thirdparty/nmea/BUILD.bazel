load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

# Small bundled NMEA sentence parser (github.com/pcdangio/cpp-nmea), vendored
# directly inside ouster-sdk under thirdparty/ rather than fetched as its own
# dependency.
cc_library(
    name = "nmea",
    srcs = [
        "src/gga.cpp",
        "src/gll.cpp",
        "src/gsa.cpp",
        "src/gsv.cpp",
        "src/parse.cpp",
        "src/parse.hpp",
        "src/rmc.cpp",
        "src/sentence.cpp",
        "src/vtg.cpp",
        "src/zda.cpp",
    ],
    hdrs = [
        "include/nmea/field.hpp",
        "include/nmea/message/gga.hpp",
        "include/nmea/message/gll.hpp",
        "include/nmea/message/gsa.hpp",
        "include/nmea/message/gsv.hpp",
        "include/nmea/message/rmc.hpp",
        "include/nmea/message/vtg.hpp",
        "include/nmea/message/zda.hpp",
        "include/nmea/object/date.hpp",
        "include/nmea/object/mode.hpp",
        "include/nmea/object/status.hpp",
        "include/nmea/sentence.hpp",
    ],
    includes = ["include"],
    alwayslink = True,
)
