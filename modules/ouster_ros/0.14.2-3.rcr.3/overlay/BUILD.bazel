# NOTE: only the BUILD_SENSOR subset is wired up (matching this package's own
# CMakeLists.txt, which disables BUILD_PCAP/BUILD_OSF/BUILD_MAPPING/BUILD_VIZ
# when configuring the bundled ouster-sdk) -- so there is no os_pcap
# component here, matching upstream's own default (non-PCAP) build.

HEADERS = glob(["include/**/*.h"])

PRIVATE_HEADERS = glob(["src/**/*.h"])

### BASE LIBRARY

# Dynamic (cross-.so singleton/registry state) vs. static deps, mirroring
# ouster_ros_library's own CMakeLists.txt target_link_libraries/
# ament_target_dependencies calls. tf2 itself is not a bazel_dep of this
# package -- CMakeLists.txt's ament_target_dependencies lists it directly,
# but package.xml never declares it (a latent upstream packaging omission,
# only masked in CMake because tf2_eigen/tf2_ros transitively bring it in).
# tf2_eigen's own DEPENDENCIES already includes @tf2//:tf2(_library), so
# depending on tf2_eigen here provides tf2 transitively without needing a
# bazel_dep this package doesn't actually declare.
BASE_DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:bzip2": "@rosdistro//cc:bzip2_library",
    "@rosdistro//cc:libzip": "@rosdistro//cc:libzip_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
}

cc_library(
    name = "ouster_ros_static_library",
    srcs = ["src/os_ros.cpp"],
    hdrs = HEADERS + PRIVATE_HEADERS,
    copts = ["-DEIGEN_MPL2_ONLY"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = BASE_DEPENDENCIES.values() + [
        "//ouster-sdk/ouster_sensor",
        "@geometry_msgs//:cc",
        "@ouster_sensor_msgs//:cc",
        "@rosdistro//cc:eigen",
        "@sensor_msgs//:cc",
    ],
)

cc_shared_library(
    name = "ouster_ros_library",
    dynamic_deps = BASE_DEPENDENCIES.keys(),
    exports_filter = [":ouster_ros_static_library"],
    deps = [":ouster_ros_static_library"],
)

collect_transitive_dynamic_deps(
    name = "ouster_ros_transitive",
    dynamic_deps = [
        ":ouster_ros_library",
        "@pcl_conversions//:pcl_conversions",
    ],
    visibility = ["//visibility:private"],
)

### COMPONENTS

