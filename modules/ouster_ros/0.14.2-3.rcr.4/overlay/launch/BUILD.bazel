load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "driver.launch.py",
        "driver_launch.py",
        "record.composite.launch.xml",
        "record.launch.xml",
        "replay.composite.launch.xml",
        "replay.launch.xml",
        "replay_pcap.launch.xml",
        "rviz.launch.py",
        "rviz.launch.xml",
        "sensor.composite.launch.py",
        "sensor.composite.launch.xml",
        "sensor.launch.xml",
        "sensor_mtp.launch.xml",
    ],
)

launch_ros_binary(
    name = "driver.launch",
    src = "driver.launch.py",
    deps = [
        "//:os_driver",
        "@ament_index_python",
        "@lifecycle_msgs//:py",
    ],
)

launch_ros_binary(
    name = "driver_launch",
    src = "driver_launch.py",
    data = [
        "//:ament_index",
    ],
    deps = [
        "@ament_index_python",
        "@lifecycle_msgs//:py",
    ],
)

launch_ros_binary(
    name = "record_composite_launch",
    src = "record.composite.launch.xml",
    deps = [
        ":rviz_launch_xml",
        "//:os_cloud",
        "//:os_image",
        "//:os_sensor",
        "@rclcpp_components//:component_container_mt",
        "@rviz2",
    ],
)

launch_ros_binary(
    name = "record_launch",
    src = "record.launch.xml",
    deps = [
        ":rviz_launch_xml",
        "//:os_cloud",
        "//:os_image",
        "//:os_sensor",
        "@rclcpp_components//:component_container_mt",
        "@rviz2",
    ],
)

launch_ros_binary(
    name = "replay_composite_launch",
    src = "replay.composite.launch.xml",
    deps = [
        ":rviz_launch_xml",
        "//:os_cloud",
        "//:os_image",
        "//:os_replay",
        "@rclcpp_components//:component_container_mt",
        "@rviz2",
    ],
)

launch_ros_binary(
    name = "replay_launch",
    src = "replay.launch.xml",
    deps = [
        ":rviz_launch_xml",
        "//:os_cloud",
        "//:os_image",
        "//:os_replay",
        "@rclcpp_components//:component_container_mt",
        "@rviz2",
    ],
)

launch_ros_binary(
    name = "replay_pcap_launch",
    src = "replay_pcap.launch.xml",
    deps = [
        ":rviz_launch_xml",
        "//:os_cloud",
        "//:os_image",
        "@rclcpp_components//:component_container_mt",
        "@rviz2",
    ],
)

launch_ros_binary(
    name = "rviz_launch_py",
    src = "rviz.launch.py",
    data = [
        "//:ament_index",
    ],
    deps = [
        "@ament_index_python",
        "@rviz2",
    ],
)

launch_ros_binary(
    name = "rviz_launch_xml",
    src = "rviz.launch.xml",
    data = [
        "//:ament_index",
    ],
    deps = [
        "@rviz2",
    ],
)

launch_ros_binary(
    name = "sensor_composite_launch_py",
    src = "sensor.composite.launch.py",
    deps = [
        "//:os_cloud",
        "//:os_image",
        "//:os_sensor",
        "@ament_index_python",
        "@rclcpp_components//:component_container_mt",
    ],
)

launch_ros_binary(
    name = "sensor_composite_launch_xml",
    src = "sensor.composite.launch.xml",
    deps = [
        ":rviz_launch_xml",
        "//:os_driver",
        "@rviz2",
    ],
)

launch_ros_binary(
    name = "sensor_launch",
    src = "sensor.launch.xml",
    deps = [
        ":rviz_launch_xml",
        "//:os_driver",
        "@rviz2",
    ],
)

launch_ros_binary(
    name = "sensor_mtp_launch",
    src = "sensor_mtp.launch.xml",
    deps = [
        ":rviz_launch_xml",
        "//:os_driver",
        "@rviz2",
    ],
)
