load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package", "register_ament_files", "register_ament_resource")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

write_file(
    name = "_meta_file_2",
    out = "_gen_meta/share/rclcpp/nodl/rclcpp_node.nodl.yaml",
    content = [
        "# NoDL interface description for rclcpp::Node.",
        "#",
        "# This file is a stand-in until rclcpp ships its own .nodl.yaml.",
        "# It is registered in the ament index as nodl://rclcpp/node.",
        "",
        "nodl_version: 2",
        "description: rclcpp::Node base class interface",
        "",
        "codegen:",
        "  cpp:",
        "    role: BASE_CLASS",
        "    class: rclcpp::Node",
        "    header: rclcpp/rclcpp.hpp",
        "",
        "parameters:",
        "  use_sim_time:",
        "    type: bool",
        "    default_value: false",
        "    description: Use simulation time",
        "",
        "publishers:",
        "  - name: /rosout",
        "    type: rcl_interfaces/msg/Log",
        "    qos:",
        "      history: KEEP_LAST",
        "      depth: 1",
        "      reliability: RELIABLE",
        "",
        "  - name: /parameter_events",
        "    type: rcl_interfaces/msg/ParameterEvent",
        "    qos:",
        "      history: KEEP_LAST",
        "      depth: 1",
        "      reliability: RELIABLE",
        "",
        "service_servers:",
        "  - name: ~/describe_parameters",
        "    type: rcl_interfaces/srv/DescribeParameters",
        "",
        "  - name: ~/get_parameters",
        "    type: rcl_interfaces/srv/GetParameters",
        "",
        "  - name: ~/get_parameter_types",
        "    type: rcl_interfaces/srv/GetParameterTypes",
        "",
        "  - name: ~/list_parameters",
        "    type: rcl_interfaces/srv/ListParameters",
        "",
        "  - name: ~/set_parameters",
        "    type: rcl_interfaces/srv/SetParameters",
        "",
        "  - name: ~/set_parameters_atomically",
        "    type: rcl_interfaces/srv/SetParametersAtomically",
    ],
    is_executable = False,
)

write_file(
    name = "_meta_file_3",
    out = "_gen_meta/share/rclcpp_lifecycle/nodl/rclcpp_lifecycle_node.nodl.yaml",
    content = [
        "# NoDL interface description for rclcpp_lifecycle::LifecycleNode.",
        "#",
        "# This file is a stand-in until rclcpp_lifecycle ships its own .nodl.yaml.",
        "# It is registered in the ament index as nodl://rclcpp_lifecycle/lifecycle_node.",
        "",
        "nodl_version: 2",
        "description: rclcpp_lifecycle::LifecycleNode interface",
        "",
        "codegen:",
        "  cpp:",
        "    role: BASE_CLASS",
        "    class: rclcpp_lifecycle::LifecycleNode",
        "    header: rclcpp_lifecycle/lifecycle_node.hpp",
        "",
        "include:",
        "  - ref: nodl://rclcpp/node",
        "",
        "publishers:",
        "  - name: transition_event",
        "    type: lifecycle_msgs/msg/TransitionEvent",
        "    qos:",
        "      history: KEEP_LAST",
        "      depth: 1",
        "      reliability: RELIABLE",
        "",
        "service_servers:",
        "  - name: ~/change_state",
        "    type: lifecycle_msgs/srv/ChangeState",
        "",
        "  - name: ~/get_state",
        "    type: lifecycle_msgs/srv/GetState",
        "",
        "  - name: ~/get_available_states",
        "    type: lifecycle_msgs/srv/GetAvailableStates",
        "",
        "  - name: ~/get_available_transitions",
        "    type: lifecycle_msgs/srv/GetAvailableTransitions",
        "",
        "  - name: ~/get_transition_graph",
        "    type: lifecycle_msgs/srv/GetAvailableTransitions",
    ],
    is_executable = False,
)

register_ament_resource(
    name = "res_nodl",
    category = "nodl",
    content = "# NoDL interface description for rclcpp::Node.\n#\n# This file is a stand-in until rclcpp ships its own .nodl.yaml.\n# It is registered in the ament index as nodl://rclcpp/node.\n\nnodl_version: 2\ndescription: rclcpp::Node base class interface\n\ncodegen:\n  cpp:\n    role: BASE_CLASS\n    class: rclcpp::Node\n    header: rclcpp/rclcpp.hpp\n\nparameters:\n  use_sim_time:\n    type: bool\n    default_value: false\n    description: Use simulation time\n\npublishers:\n  - name: /rosout\n    type: rcl_interfaces/msg/Log\n    qos:\n      history: KEEP_LAST\n      depth: 1\n      reliability: RELIABLE\n\n  - name: /parameter_events\n    type: rcl_interfaces/msg/ParameterEvent\n    qos:\n      history: KEEP_LAST\n      depth: 1\n      reliability: RELIABLE\n\nservice_servers:\n  - name: ~/describe_parameters\n    type: rcl_interfaces/srv/DescribeParameters\n\n  - name: ~/get_parameters\n    type: rcl_interfaces/srv/GetParameters\n\n  - name: ~/get_parameter_types\n    type: rcl_interfaces/srv/GetParameterTypes\n\n  - name: ~/list_parameters\n    type: rcl_interfaces/srv/ListParameters\n\n  - name: ~/set_parameters\n    type: rcl_interfaces/srv/SetParameters\n\n  - name: ~/set_parameters_atomically\n    type: rcl_interfaces/srv/SetParametersAtomically\n",
)

register_ament_files(
    name = "ament_files_0",
    files = [
        ":_meta_file_2",
    ],
    prefix = "share/rclcpp/nodl",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_1",
    files = [
        ":_meta_file_3",
    ],
    prefix = "share/rclcpp_lifecycle/nodl",
    strip_prefix = "*",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    data = [
        ":ament_files_0",
        ":ament_files_1",
        ":res_nodl",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_nodl//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
