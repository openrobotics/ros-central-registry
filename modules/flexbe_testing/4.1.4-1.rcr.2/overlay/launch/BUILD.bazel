load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "flexbe_testing.launch.py",
        "selftest_test.launch.py",
    ],
)

launch_ros_binary(
    name = "flexbe_testing_launch",
    src = "flexbe_testing.launch.py",
    data = ["//:ament_index"],
    deps = ["//:flexbe_testing"],
)

launch_ros_binary(
    name = "selftest_test_launch",
    src = "selftest_test.launch.py",
    deps = [
        ":flexbe_testing_launch",
        "//:flexbe_testing",
        "@ament_index_python",
    ],
)
