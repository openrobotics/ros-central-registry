load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

filegroup(
    name = "_test_data_0",
    srcs = [
        "flexbe_testing/test/__init__.py",
        "flexbe_testing/test/import_only_state.py",
        "flexbe_testing/test/selftest_behavior.xml",
        "flexbe_testing/test/selftest_behavior_sm.py",
        "flexbe_testing/test/test_add_state.py",
        "flexbe_testing/test/test_sub_state.py",
    ],
)

py_library(
    name = "flexbe_testing",
    srcs = [
        "flexbe_testing/__init__.py",
        "flexbe_testing/data_provider.py",
        "flexbe_testing/logger.py",
        "flexbe_testing/py_tester.py",
        "flexbe_testing/state_docstring_tester.py",
        "flexbe_testing/test/__init__.py",
        "flexbe_testing/test/import_only_state.py",
        "flexbe_testing/test/selftest_behavior_sm.py",
        "flexbe_testing/test/test_add_state.py",
        "flexbe_testing/test/test_sub_state.py",
        "flexbe_testing/test_context.py",
        "flexbe_testing/test_interface.py",
        "flexbe_testing/tester.py",
    ],
    data = ["flexbe_testing/test/selftest_behavior.xml"],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@flexbe_core",
        "@flexbe_msgs//:py",
        "@launch_ros",
        "@rclpy",
    ],
)

ament_index(
    name = "ament_index",
    data = ["//launch:launch_files"] + ["//test:_root_test_files_0"],
    executables = [
        "bin/state_docstring_tester",
        "bin/testing_node",
    ],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    package_xml = "package.xml",
    python = [":flexbe_testing"] + ["flexbe_testing/test/selftest_behavior.xml"],
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@flexbe_core//:ament_package",
        "@flexbe_msgs//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
