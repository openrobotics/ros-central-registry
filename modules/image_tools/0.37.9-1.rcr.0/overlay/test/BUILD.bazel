load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

exports_files([
    "cam2image.txt",
    "showimage.regex",
    "test_executables_demo.py.in",
])

cmake_configure_file(
    name = "test_showimage_cam2image_py",
    src = "test_executables_demo.py.in",
    out = "test_showimage_cam2image.py",
    defines = [
        "RCLCPP_DEMO_SHOWIMAGE_EXECUTABLE=../image_tools+/showimage",
        "RCLCPP_DEMO_CAM2IMAGE_EXECUTABLE=../image_tools+/cam2image",
        "RCLCPP_DEMO_SHOWIMAGE_EXPECTED_OUTPUT=../image_tools+/test/showimage",
        "RCLCPP_DEMO_CAM2IMAGE_EXPECTED_OUTPUT=../image_tools+/test/cam2image",
        "rmw_implementation=rmw_fastrtps_cpp",
    ],
)
