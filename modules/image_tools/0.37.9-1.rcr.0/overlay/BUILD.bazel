load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/image_tools/cv_mat_sensor_msgs_image_type_adapter.hpp",
    "include/image_tools/visibility_control.h",
]

DEPENDENCIES = {
    "@example_interfaces//:cc_shared": "@example_interfaces//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

cc_library(
    name = "image_tools_library",
    srcs = [
        "src/burger.cpp",
        "src/burger.hpp",
        "src/cam2image.cpp",
        "src/cv_mat_sensor_msgs_image_type_adapter.cpp",
        "src/policy_maps.hpp",
        "src/showimage.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["IMAGE_TOOLS_BUILDING_DLL"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "image_tools",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":image_tools_library"],
)

rclcpp_components_register_node(
    name = "cam2image",
    component = ":image_tools",
    executor = "SingleThreadedExecutor",
    node_name = "cam2image",
    plugin = "image_tools::Cam2Image",
)

rclcpp_components_register_node(
    name = "showimage",
    component = ":image_tools",
    executor = "SingleThreadedExecutor",
    node_name = "showimage",
    plugin = "image_tools::ShowImage",
)

write_file(
    name = "rmw_test_fixture_implementation_py",
    out = "rmw_test_fixture_implementation.py",
    content = [
        "def rmw_test_isolation_start(): pass",
        "def rmw_test_isolation_stop(): pass",
    ],
)

py_library(
    name = "rmw_test_fixture_implementation",
    srcs = [":rmw_test_fixture_implementation_py"],
    imports = ["."],
)

launch_ros_test(
    name = "test_showimage_cam2image",
    src = "//test:test_showimage_cam2image_py",
    data = [
        "//test:cam2image.txt",
        "//test:showimage.regex",
    ],
    deps = [
        ":cam2image",
        ":rmw_test_fixture_implementation",
        ":showimage",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = ["rclcpp_components"],
    cmake_export_include_directories = False,
    components = [
        ":cam2image_record",
        ":showimage_record",
    ],
    executables = [
        ":cam2image",
        ":showimage",
    ],
    headers = HEADERS,
    libraries = [":image_tools"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@example_interfaces//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rmw_implementation_cmake//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
