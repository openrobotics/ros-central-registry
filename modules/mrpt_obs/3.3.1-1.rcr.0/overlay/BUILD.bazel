load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@mrpt_tfest//:mrpt_tfest_library",
    "@mrpt_viz//:mrpt_viz_library",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
]

cc_library(
    name = "mrpt_obs_library",
    srcs = [
        "src/CAction.cpp",
        "src/CActionCollection.cpp",
        "src/CActionRobotMovement2D.cpp",
        "src/CActionRobotMovement3D.cpp",
        "src/CMetricMap.cpp",
        "src/CObservation.cpp",
        "src/CObservation2DRangeScan.cpp",
        "src/CObservation2DRangeScanWithUncertainty.cpp",
        "src/CObservation3DRangeScan.cpp",
        "src/CObservation3DScene.cpp",
        "src/CObservation6DFeatures.cpp",
        "src/CObservationBatteryState.cpp",
        "src/CObservationBeaconRanges.cpp",
        "src/CObservationBearingRange.cpp",
        "src/CObservationCANBusJ1939.cpp",
        "src/CObservationComment.cpp",
        "src/CObservationGPS.cpp",
        "src/CObservationGasSensors.cpp",
        "src/CObservationIMU.cpp",
        "src/CObservationImage.cpp",
        "src/CObservationOdometry.cpp",
        "src/CObservationRFID.cpp",
        "src/CObservationRGBD360.cpp",
        "src/CObservationRange.cpp",
        "src/CObservationRawDAQ.cpp",
        "src/CObservationReflectivity.cpp",
        "src/CObservationRobotPose.cpp",
        "src/CObservationRotatingScan.cpp",
        "src/CObservationSkeleton.cpp",
        "src/CObservationStereoImages.cpp",
        "src/CObservationStereoImagesFeatures.cpp",
        "src/CObservationVelodyneScan.cpp",
        "src/CObservationWindSensor.cpp",
        "src/CObservationWirelessPower.cpp",
        "src/CRawlog.cpp",
        "src/CSensoryFrame.cpp",
        "src/CSimpleMap.cpp",
        "src/CSinCosLookUpTableFor2DScans.cpp",
        "src/TMetricMapInitializer.cpp",
        "src/TMetricMapTypesRegistry.cpp",
        "src/TPixelLabelInfo.cpp",
        "src/VelodyneCalibration.cpp",
        "src/carmen_log_tools.cpp",
        "src/format_externals_filename.cpp",
        "src/gnss_messages_ascii_nmea.cpp",
        "src/gnss_messages_common.cpp",
        "src/gnss_messages_novatel.cpp",
        "src/gnss_messages_topcon.cpp",
        "src/metric_map_types.cpp",
        "src/registerAllClasses.cpp",
        "src/stock_observations.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":gen_extra_51"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "src",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_obs",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mrpt_obs_library"],
)

cc_library(
    name = "_bindings.cpython-314-x86_64-linux-gnu_library",
    srcs = ["python_bindings/mrpt_obs_py.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":gen_extra_51"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":mrpt_obs_library"],
)

cc_shared_library(
    name = "_bindings.cpython-314-x86_64-linux-gnu",
    dynamic_deps = DEPENDENCIES.keys(),
    shared_lib_name = "mrpt/obs/_bindings.so",
    deps = [":_bindings.cpython-314-x86_64-linux-gnu_library"],
)

py_library(
    name = "mrpt",
    srcs = glob(["python/mrpt/**/*.py"]),
    imports = ["python"],
    deps = [
        "@mrpt_tfest//:mrpt",
        "@mrpt_viz//:mrpt",
    ],
)

write_file(
    name = "gen_extra_51",
    out = "_gen/include/mrpt/obs/config.h",
    content = ["/* +---------------------------------------------------------------------------+\n   |                     Mobile Robot Programming Toolkit (MRPT)               |\n   |                          https://www.mrpt.org/                            |\n   |                                                                           |\n   | Copyright (c) 2005-2026, Individual contributors, see AUTHORS file        |\n   | See: https://www.mrpt.org/Authors - All rights reserved.                  |\n   | Released under BSD License. See details in https://www.mrpt.org/License   |\n   +---------------------------------------------------------------------------+\n */\n\n#pragma once\n\n// clang-format off\n\n#define MRPT_HAS_TINYXML2        1\n#define MRPT_HAS_TINYXML2_SYSTEM 1\n\n// clang-format on\n"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_obs",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_obs": [
            "libmrpt_obs.so.3.3",
            "libmrpt_obs.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_common//:ament_package",
        "@mrpt_tfest//:ament_package",
        "@mrpt_viz//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    egg_info = False,
    headers = [
        ":gen_extra_51",
    ] + glob(["include/**"]),
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mrpt_obs",
    ],
    package_xml = "package.xml",
    python = [
        ":mrpt",
        ":_bindings.cpython-314-x86_64-linux-gnu",
    ],
    python_strip_prefix = "python",
    sonames = {
        "mrpt_obs": [
            "libmrpt_obs.so.3.3",
            "libmrpt_obs.so.3.3.1",
        ],
    },
    deps = [":ament_index"] + [
        "@mrpt_common//:ament_package",
        "@mrpt_tfest//:ament_package",
        "@mrpt_viz//:ament_package",
    ],
)
