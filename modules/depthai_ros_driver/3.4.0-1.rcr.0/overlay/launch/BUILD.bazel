launch_ros_binary(
    name = "calibration_launch",
    src = "calibration.launch.py",
    data = [
        ":driver_launch",
        "//:ament_index",
        "//:driver",
        "@camera_calibration//:ament_index",
        "@depthai_descriptions//:ament_index",
        "@rclcpp_components//:ament_index",
        "@rclcpp_components//:component_container",
        "@rviz2",
        "@rviz2//:ament_index",
    ],
    deps = [
        "//:depthai_ros_driver_py",
        "@ament_index_python",
        "@camera_calibration",
    ],
)

