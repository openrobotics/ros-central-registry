    includes = [
        "_gen/include",
        "include",
        "include/depthai_ros_driver",
    ],
    local_defines = ros_local_defines() + [
        "DEPTHAI_ENABLE_PROTOBUF",
        "DEPTHAI_HAVE_BASALT_SUPPORT",
        "DEPTHAI_HAVE_BETA",
        "DEPTHAI_HAVE_DYNAMIC_CALIBRATION_SUPPORT",
        "DEPTHAI_HAVE_HOUSING_COORDINATES",
        "DEPTHAI_HAVE_OPENCV_SUPPORT",
        "DEPTHAI_MERGED_TARGET",
        "DEPTHAI_TARGET_BASALT",
        "DEPTHAI_TARGET_CORE",
        "DEPTHAI_TARGET_OPENCV",
        "DEPTHAI_XTENSOR_SUPPORT",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

