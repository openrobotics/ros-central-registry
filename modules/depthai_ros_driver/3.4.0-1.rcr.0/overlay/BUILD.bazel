cc_library(
    name = "depthai_ros_driver_common_library",
    srcs = [":gen_depthai_ros_driver_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_atomic_shared_ptr_shim_hpp",
        ":gen_rcr_chrono_v2_shim_hpp",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
        "-include",
        "atomic_shared_ptr_shim.hpp",
        "-include",
        "rcr_chrono_v2_shim.hpp",
