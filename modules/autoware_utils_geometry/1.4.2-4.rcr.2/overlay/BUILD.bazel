load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@autoware_internal_planning_msgs//:cc_shared": "@autoware_internal_planning_msgs//:cc",
    "@autoware_perception_msgs//:cc_shared": "@autoware_perception_msgs//:cc",
    "@autoware_planning_msgs//:cc_shared": "@autoware_planning_msgs//:cc",
    "@autoware_utils_math//:autoware_utils_math": "@autoware_utils_math//:autoware_utils_math_library",
    "@autoware_utils_system//:autoware_utils_system": "@autoware_utils_system//:autoware_utils_system_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rosdistro//cc:boost.chrono_shared": "@rosdistro//cc:boost.chrono",
    "@rosdistro//cc:boost.container_shared": "@rosdistro//cc:boost.container",
    "@rosdistro//cc:boost.serialization_shared": "@rosdistro//cc:boost.serialization",
    "@rosdistro//cc:boost.thread_shared": "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
}

CC_DEPS = [
    "@rosdistro//cc:boost.geometry",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "autoware_utils_geometry_library",
    srcs = [
        "src/geometry/alt_geometry.cpp",
        "src/geometry/boost_polygon_utils.cpp",
        "src/geometry/ear_clipping.cpp",
        "src/geometry/geometry.cpp",
        "src/geometry/gjk_2d.cpp",
        "src/geometry/pose_deviation.cpp",
        "src/geometry/random_concave_polygon.cpp",
        "src/geometry/random_convex_polygon.cpp",
        "src/geometry/sat_2d.cpp",
        "src/msg/operation.cpp",
    ],
    hdrs = [
        "include/autoware_utils_geometry/alt_geometry.hpp",
        "include/autoware_utils_geometry/boost_geometry.hpp",
        "include/autoware_utils_geometry/boost_polygon_utils.hpp",
        "include/autoware_utils_geometry/ear_clipping.hpp",
        "include/autoware_utils_geometry/geometry.hpp",
        "include/autoware_utils_geometry/gjk_2d.hpp",
        "include/autoware_utils_geometry/msg/covariance.hpp",
        "include/autoware_utils_geometry/msg/operation.hpp",
        "include/autoware_utils_geometry/pose_deviation.hpp",
        "include/autoware_utils_geometry/random_concave_polygon.hpp",
        "include/autoware_utils_geometry/random_convex_polygon.hpp",
        "include/autoware_utils_geometry/sat_2d.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/autoware_utils_geometry",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "autoware_utils_geometry",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":autoware_utils_geometry_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":autoware_utils_geometry"],
)

ament_index(
    name = "ament_index",
    libraries = [":autoware_utils_geometry"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@autoware_cmake//:ament_package",
        "@autoware_internal_planning_msgs//:ament_package",
        "@autoware_lint_common//:ament_package",
        "@autoware_perception_msgs//:ament_package",
        "@autoware_planning_msgs//:ament_package",
        "@autoware_utils_math//:ament_package",
        "@autoware_utils_system//:ament_package",
        "@geometry_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_eigen//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "autoware_internal_planning_msgs",
        "autoware_utils_math",
        "tf2",
        "tf2_eigen",
        "tf2_geometry_msgs",
    ],
    cmake_export_targets = False,
    headers = [
        "include/autoware_utils_geometry/alt_geometry.hpp",
        "include/autoware_utils_geometry/boost_geometry.hpp",
        "include/autoware_utils_geometry/boost_polygon_utils.hpp",
        "include/autoware_utils_geometry/ear_clipping.hpp",
        "include/autoware_utils_geometry/geometry.hpp",
        "include/autoware_utils_geometry/gjk_2d.hpp",
        "include/autoware_utils_geometry/msg/covariance.hpp",
        "include/autoware_utils_geometry/msg/operation.hpp",
        "include/autoware_utils_geometry/pose_deviation.hpp",
        "include/autoware_utils_geometry/random_concave_polygon.hpp",
        "include/autoware_utils_geometry/random_convex_polygon.hpp",
        "include/autoware_utils_geometry/sat_2d.hpp",
    ],
    libraries = [":autoware_utils_geometry"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@autoware_cmake//:ament_package",
        "@autoware_internal_planning_msgs//:ament_package",
        "@autoware_lint_common//:ament_package",
        "@autoware_perception_msgs//:ament_package",
        "@autoware_planning_msgs//:ament_package",
        "@autoware_utils_math//:ament_package",
        "@autoware_utils_system//:ament_package",
        "@geometry_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_eigen//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
    ],
)
