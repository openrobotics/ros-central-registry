load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@backward_ros//:backward": "@backward_ros//:backward_library",
    "@nlohmann_json_schema_validator_vendor//:nlohmann_json_schema_validator": "@nlohmann_json_schema_validator_vendor//:nlohmann_json_schema_validator_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rmf_utils//:rmf_utils": "@rmf_utils//:rmf_utils_library",
    "@rosdistro//cc:boringssl": "@rosdistro//cc:boringssl_crypto_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.asio",
    "@rosdistro//cc:boost.bind",
    "@rosdistro//cc:boost.circular_buffer",
    "@rosdistro//cc:boost.config",
    "@rosdistro//cc:boost.function",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:boost.smart_ptr",
    "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:boringssl_ssl_library",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:nlohmann_json",
]

cc_library(
    name = "rmf_websocket_library",
    srcs = [
        "src/rmf_websocket/BroadcastClient.cpp",
        "src/rmf_websocket/BroadcastServer.cpp",
        "src/rmf_websocket/client/ClientWebSocketEndpoint.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/rmf_websocket",
        "websocketpp",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rmf_websocket",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":rmf_websocket_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    libraries = [
        ":rmf_websocket",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_catch2//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@backward_ros//:ament_package",
        "@nlohmann_json_schema_validator_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rmf_utils//:ament_package",
    ],
)

