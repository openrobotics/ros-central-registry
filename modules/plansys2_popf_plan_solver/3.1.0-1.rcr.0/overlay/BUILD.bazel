load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@plansys2_core//:plansys2_core": "@plansys2_core//:plansys2_core_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@popf//:Inst": "@popf//:Inst_library",
    "@popf//:ParsePDDL": "@popf//:ParsePDDL_library",
    "@popf//:VALGlobals": "@popf//:VALGlobals_library",
    "@popf//:popfCommon": "@popf//:popfCommon_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@plansys2_msgs//:cc",
    "@popf//:_gen_textual_hdrs",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "plansys2_popf_plan_solver_library",
    srcs = ["src/plansys2_popf_plan_solver/popf_plan_solver.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++23",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/plansys2_popf_plan_solver",
        "test/unit",
    ],
    local_defines = ros_local_defines() + [
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "plansys2_popf_plan_solver",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":plansys2_popf_plan_solver_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":plansys2_popf_plan_solver"],
)

pkg_files(
    name = "pkg_files_share_0",
    srcs = ["test/pddl/domain_1_ok.pddl"],
    prefix = "share/plansys2_popf_plan_solver/pddl",
)

pkg_files(
    name = "pkg_files_share_1",
    srcs = ["test/pddl/domain_2_error.pddl"],
    prefix = "share/plansys2_popf_plan_solver/pddl",
)

pkg_files(
    name = "pkg_files_share_2",
    srcs = ["test/pddl/domain_simple.pddl"],
    prefix = "share/plansys2_popf_plan_solver/pddl",
)

pkg_files(
    name = "pkg_files_share_3",
    srcs = ["test/pddl/problem_simple_1.pddl"],
    prefix = "share/plansys2_popf_plan_solver/pddl",
)

pkg_files(
    name = "pkg_files_share_4",
    srcs = ["test/pddl/problem_simple_2.pddl"],
    prefix = "share/plansys2_popf_plan_solver/pddl",
)

pkg_files(
    name = "pkg_files_share_5",
    srcs = ["test/pddl/problem_simple_3.pddl"],
    prefix = "share/plansys2_popf_plan_solver/pddl",
)

ament_index(
    name = "ament_index",
    libraries = [":plansys2_popf_plan_solver"],
    package_xml = "package.xml",
    plugin_category = "plansys2_core",
    plugins = ["plansys2_popf_plan_solver_plugin.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@plansys2_core//:ament_package",
        "@plansys2_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@popf//:ament_package",
        "@rclcpp//:ament_package",
        "@ros2run//:ament_package",
    ],
)

cc_test(
    name = "popf_test",
    srcs = ["test/unit/popf_test.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++23",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [":ament_index"] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/plansys2_popf_plan_solver",
        "test/unit",
    ],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":plansys2_popf_plan_solver_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "ament_index_cpp",
        "plansys2_core",
        "pluginlib",
    ],
    cmake_export_name = "export_plansys2_popf_plan_solver",
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    install = [
        ":pkg_files_share_0",
        ":pkg_files_share_1",
        ":pkg_files_share_2",
        ":pkg_files_share_3",
        ":pkg_files_share_4",
        ":pkg_files_share_5",
    ],
    libraries = [":plansys2_popf_plan_solver"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@plansys2_core//:ament_package",
        "@plansys2_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@popf//:ament_package",
        "@rclcpp//:ament_package",
        "@ros2run//:ament_package",
    ],
)
