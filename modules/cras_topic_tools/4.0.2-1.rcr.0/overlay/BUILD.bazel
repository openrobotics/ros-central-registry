load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines", "ros_version_header")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@cras_cpp_common//:cras_c_api": "@cras_cpp_common//:cras_c_api_library",
    "@cras_cpp_common//:cras_cloud": "@cras_cpp_common//:cras_cloud_library",
    "@cras_cpp_common//:cras_filter_base": "@cras_cpp_common//:cras_filter_base_library",
    "@cras_cpp_common//:cras_log_utils": "@cras_cpp_common//:cras_log_utils_library",
    "@cras_cpp_common//:cras_param_utils": "@cras_cpp_common//:cras_param_utils_library",
    "@cras_cpp_common//:cras_qos_utils": "@cras_cpp_common//:cras_qos_utils_library",
    "@cras_cpp_common//:cras_rate_limiter": "@cras_cpp_common//:cras_rate_limiter_library",
    "@cras_cpp_common//:cras_semaphore": "@cras_cpp_common//:cras_semaphore_library",
    "@cras_cpp_common//:cras_string_utils": "@cras_cpp_common//:cras_string_utils_library",
    "@cras_cpp_common//:cras_tf2_sensor_msgs": "@cras_cpp_common//:cras_tf2_sensor_msgs_library",
    "@cras_cpp_common//:cras_tf2_utils": "@cras_cpp_common//:cras_tf2_utils_library",
    "@cras_cpp_common//:cras_thread_utils": "@cras_cpp_common//:cras_thread_utils_library",
    "@cras_cpp_common//:cras_time_utils": "@cras_cpp_common//:cras_time_utils_library",
    "@cras_cpp_common//:cras_type_utils": "@cras_cpp_common//:cras_type_utils_library",
    "@cras_cpp_common//:cras_urdf_utils": "@cras_cpp_common//:cras_urdf_utils_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.bind",
    "@rosdistro//cc:boost.smart_ptr",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
    "@std_msgs//:cc",
]

cc_library(
    name = "cras_count_messages_library",
    srcs = ["src/count_messages.cpp"],
    hdrs = [
        "include/cras_topic_tools/change_header.h",
        "include/cras_topic_tools/count_messages.hpp",
        "include/cras_topic_tools/generic_lazy_pubsub.hpp",
        "include/cras_topic_tools/generic_subscription.hpp",
        "include/cras_topic_tools/heartbeat.h",
        "include/cras_topic_tools/impl/lazy_subscriber.hpp",
        "include/cras_topic_tools/impl/shape_shifter.hpp",
        "include/cras_topic_tools/lazy_subscriber.hpp",
        "include/cras_topic_tools/priority_mux.h",
        "include/cras_topic_tools/priority_mux_base.h",
        "include/cras_topic_tools/relay.h",
        "include/cras_topic_tools/repeat.h",
        "include/cras_topic_tools/shape_shifter.h",
        "include/cras_topic_tools/throttle_messages.h",
    ] + [":version_h"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "_gen/include/cras_topic_tools",
        "_gen/include/cras_topic_tools/cras_topic_tools",
        "include",
        "include/cras_topic_tools",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "cras_count_messages",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":cras_count_messages_library"],
)

rclcpp_components_register_node(
    name = "count_messages",
    component = ":cras_count_messages",
    node_name = "count_messages",
    plugin = "cras::CountMessagesComponent",
)

ros_version_header(
    name = "version_h",
    out = "_gen/include/cras_topic_tools/cras_topic_tools/version.h",
)

ament_index(
    name = "ament_index",
    components = [":count_messages_record"],
    lib_data = [
        ":count_messages",
    ],
    libraries = [
        ":cras_count_messages",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@cras_cpp_common//:ament_package",
        "@cras_lint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@std_msgs//:ament_package",
        "@topic_tools//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "cras_cpp_common",
        "rclcpp",
        "rclcpp_components",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_interface_targets = [
        "cras_topic_tools_defaults",
        "cras_topic_tools_version",
        "cras_topic_tools",
    ],
    cmake_export_libraries = False,
    cmake_export_name = "export_cras_topic_tools",
    headers = [
        "include/cras_topic_tools/change_header.h",
        "include/cras_topic_tools/count_messages.hpp",
        "include/cras_topic_tools/generic_lazy_pubsub.hpp",
        "include/cras_topic_tools/generic_subscription.hpp",
        "include/cras_topic_tools/heartbeat.h",
        "include/cras_topic_tools/impl/lazy_subscriber.hpp",
        "include/cras_topic_tools/impl/shape_shifter.hpp",
        "include/cras_topic_tools/lazy_subscriber.hpp",
        "include/cras_topic_tools/priority_mux.h",
        "include/cras_topic_tools/priority_mux_base.h",
        "include/cras_topic_tools/relay.h",
        "include/cras_topic_tools/repeat.h",
        "include/cras_topic_tools/shape_shifter.h",
        "include/cras_topic_tools/throttle_messages.h",
        ":version_h",
    ],
    libraries = [
        ":cras_count_messages",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@cras_cpp_common//:ament_package",
        "@cras_lint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@std_msgs//:ament_package",
        "@topic_tools//:ament_package",
    ],
)
