load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:ament_resource.bzl", "register_ament_resource")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
)

DEPENDENCIES = {
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rmw_dds_common//:rmw_dds_common": "@rmw_dds_common//:rmw_dds_common_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
    "@rosidl_typesupport_introspection_c//:rosidl_typesupport_introspection_c": "@rosidl_typesupport_introspection_c//:rosidl_typesupport_introspection_c_library",
    "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp": "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp_library",
}

CC_DEPS = [
    "@rcpputils//:dummy_shared_library_lib",
    "@rmw_dds_common//:cc",
]

cc_library(
    name = "rmw_desert_library",
    srcs = [
        "cbor/src/common.c",
        "cbor/src/decoder.c",
        "cbor/src/encoder.c",
        "cbor/src/helper.c",
        "cbor/src/ieee754.c",
        "cbor/src/parser.c",
        "src/desert_classes/CBorStream.cpp",
        "src/desert_classes/CStringHelper.cpp",
        "src/desert_classes/DesertClient.cpp",
        "src/desert_classes/DesertGuardCondition.cpp",
        "src/desert_classes/DesertNode.cpp",
        "src/desert_classes/DesertPublisher.cpp",
        "src/desert_classes/DesertService.cpp",
        "src/desert_classes/DesertSubscriber.cpp",
        "src/desert_classes/Discovery.cpp",
        "src/desert_classes/TcpDaemon.cpp",
        "src/desert_classes/TopicsConfig.cpp",
        "src/desert_classes/demangle.cpp",
        "src/dynamic_message_type_support.cpp",
        "src/event.cpp",
        "src/features.cpp",
        "src/get_network_flow_endpoints.cpp",
        "src/get_node_info_and_types.cpp",
        "src/get_service_endpoint_info.cpp",
        "src/get_service_names_and_types.cpp",
        "src/get_topic_endpoint_info.cpp",
        "src/get_topic_names_and_types.cpp",
        "src/init.cpp",
        "src/init_options.cpp",
        "src/qos_profiles.cpp",
        "src/rmw.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    includes = ["cbor/include"],
    local_defines = ros_local_defines() + ["rmw_desert_BUILDING_LIBRARY"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rmw_desert",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":rmw_desert_library"],
)

register_ament_resource(
    name = "res_rmw_typesupport",
    category = "rmw_typesupport",
    content = "rosidl_typesupport_c;rosidl_typesupport_introspection_c;rosidl_typesupport_cpp;rosidl_typesupport_introspection_cpp",
)

register_ament_resource(
    name = "res_rmw_typesupport_c",
    category = "rmw_typesupport_c",
    content = "rosidl_typesupport_c;rosidl_typesupport_introspection_c",
)

register_ament_resource(
    name = "res_rmw_typesupport_cpp",
    category = "rmw_typesupport_cpp",
    content = "rosidl_typesupport_cpp;rosidl_typesupport_introspection_cpp",
)

write_file(
    name = "gen_extra_0",
    out = "_gen/share/ament_index/resource_index/rmw_typesupport/rmw_desert",
    content = ["rosidl_typesupport_c;rosidl_typesupport_introspection_c;rosidl_typesupport_cpp;rosidl_typesupport_introspection_cpp"],
)

write_file(
    name = "gen_extra_1",
    out = "_gen/share/ament_index/resource_index/rmw_typesupport_c/rmw_desert",
    content = ["rosidl_typesupport_c;rosidl_typesupport_introspection_c"],
)

write_file(
    name = "gen_extra_2",
    out = "_gen/share/ament_index/resource_index/rmw_typesupport_cpp/rmw_desert",
    content = ["rosidl_typesupport_cpp;rosidl_typesupport_introspection_cpp"],
)

pkg_files(
    name = "pkg_files_extra_0",
    srcs = [":gen_extra_0"],
    prefix = "share/ament_index/resource_index/rmw_typesupport",
)

pkg_files(
    name = "pkg_files_extra_1",
    srcs = [":gen_extra_1"],
    prefix = "share/ament_index/resource_index/rmw_typesupport_c",
)

pkg_files(
    name = "pkg_files_extra_2",
    srcs = [":gen_extra_2"],
    prefix = "share/ament_index/resource_index/rmw_typesupport_cpp",
)

ament_index(
    name = "ament_index",
    libraries = [":rmw_desert"],
    package_xml = "package.xml",
    deps = [
        ":res_rmw_typesupport",
        ":res_rmw_typesupport_c",
        ":res_rmw_typesupport_cpp",
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros_core//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rmw_dds_common//:ament_package",
        "@rosidl_cmake//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidl_typesupport_introspection_c//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rcutils",
        "rcpputils",
        "rmw",
        "rosidl_runtime_c",
        "rmw_dds_common",
        "rosidl_typesupport_introspection_c",
        "rosidl_typesupport_introspection_cpp",
    ],
    cmake_export_include_directories = False,
    cmake_export_targets = False,
    install = [
        ":pkg_files_extra_0",
        ":pkg_files_extra_1",
        ":pkg_files_extra_2",
    ],
    libraries = [":rmw_desert"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros_core//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rmw_dds_common//:ament_package",
        "@rosidl_cmake//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidl_typesupport_introspection_c//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
    ],
)
