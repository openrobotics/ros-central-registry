load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_exports_header", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rcl_interfaces//:cc_shared": "@rcl_interfaces//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
    "@rosdistro//cc:tl_expected",
    "@tcb_span//:tcb_span",
]

cc_library(
    name = "rsl_library",
    srcs = [
        "src/parameter_validators.cpp",
        "src/random.cpp",
    ],
    hdrs = [
        "include/rsl/algorithm.hpp",
        "include/rsl/monad.hpp",
        "include/rsl/no_discard.hpp",
        "include/rsl/overload.hpp",
        "include/rsl/parameter_validators.hpp",
        "include/rsl/queue.hpp",
        "include/rsl/random.hpp",
        "include/rsl/static_string.hpp",
        "include/rsl/static_vector.hpp",
        "include/rsl/strong_type.hpp",
        "include/rsl/try.hpp",
    ] + [":export_hpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "_gen/include/rsl",
        "_gen/include/rsl/rsl",
        "include",
        "include/rsl",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rsl",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rsl_library"],
)

ros_exports_header(
    name = "export_hpp",
    out = "_gen/include/rsl/rsl/export.hpp",
    library = "rsl",
)

ament_index(
    name = "ament_index",
    libraries = [
        ":rsl",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@tcb_span//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake = [
        "cmake/rsl-config.cmake",
    ],
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/rsl/algorithm.hpp",
        ":export_hpp",
        "include/rsl/monad.hpp",
        "include/rsl/no_discard.hpp",
        "include/rsl/overload.hpp",
        "include/rsl/parameter_validators.hpp",
        "include/rsl/queue.hpp",
        "include/rsl/random.hpp",
        "include/rsl/static_string.hpp",
        "include/rsl/static_vector.hpp",
        "include/rsl/strong_type.hpp",
        "include/rsl/try.hpp",
    ],
    install_package_xml = False,
    libraries = [
        ":rsl",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@tcb_span//:ament_package",
    ],
)
