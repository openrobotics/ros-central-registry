load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@mrpt_gui//:mrpt_gui": "@mrpt_gui//:mrpt_gui_library",
    "@mrpt_gui//:mrpt_nanogui": "@mrpt_gui//:mrpt_nanogui_library",
    "@mrpt_libapps_cli//:mrpt_libapps_cli": "@mrpt_libapps_cli//:mrpt_libapps_cli_library",
    "@rosdistro//cc:wxwidgets": "@rosdistro//cc:wxwidgets_library",
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "mrpt_libapps_gui_library",
    srcs = [
        "include/mrpt/apps_gui/CRawlogProcessor.h",
        "include/mrpt/apps_gui/CameraSelectionGUI.h",
        "include/mrpt/apps_gui/ICP_SLAM_App.h",
        "include/mrpt/apps_gui/KFSLAMApp.h",
        "include/mrpt/apps_gui/MonteCarloLocalization_App.h",
        "include/mrpt/apps_gui/RBPF_SLAM_App.h",
        "include/mrpt/apps_gui/RawlogEditApp.h",
        "include/mrpt/apps_gui/registerAllClasses.h",
        "src/CameraSelectionGUI.cpp",
        "src/ICP_SLAM_App.cpp",
        "src/KFSLAMApp.cpp",
        "src/MonteCarloLocalization_App.cpp",
        "src/RBPF_SLAM_App.cpp",
        "src/registerAllClasses.cpp",
    ],
    hdrs = [
        "include/mrpt/apps_gui/CRawlogProcessor.h",
        "include/mrpt/apps_gui/CameraSelectionGUI.h",
        "include/mrpt/apps_gui/ICP_SLAM_App.h",
        "include/mrpt/apps_gui/KFSLAMApp.h",
        "include/mrpt/apps_gui/MonteCarloLocalization_App.h",
        "include/mrpt/apps_gui/RBPF_SLAM_App.h",
        "include/mrpt/apps_gui/RawlogEditApp.h",
        "include/mrpt/apps_gui/registerAllClasses.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "WXUSINGDLL",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_libapps_gui",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mrpt_libapps_gui_library"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_libapps_gui",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_libapps_gui": [
            "libmrpt_libapps_gui.so.3.3",
            "libmrpt_libapps_gui.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_gui//:ament_package",
        "@mrpt_libapps_cli//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/mrpt/apps_gui/CRawlogProcessor.h",
        "include/mrpt/apps_gui/CameraSelectionGUI.h",
        "include/mrpt/apps_gui/ICP_SLAM_App.h",
        "include/mrpt/apps_gui/KFSLAMApp.h",
        "include/mrpt/apps_gui/MonteCarloLocalization_App.h",
        "include/mrpt/apps_gui/RBPF_SLAM_App.h",
        "include/mrpt/apps_gui/RawlogEditApp.h",
        "include/mrpt/apps_gui/registerAllClasses.h",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mrpt_libapps_gui",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_libapps_gui": [
            "libmrpt_libapps_gui.so.3.3",
            "libmrpt_libapps_gui.so.3.3.1",
        ],
    },
    deps = [":ament_index"] + [
        "@mrpt_gui//:ament_package",
        "@mrpt_libapps_cli//:ament_package",
    ],
)
