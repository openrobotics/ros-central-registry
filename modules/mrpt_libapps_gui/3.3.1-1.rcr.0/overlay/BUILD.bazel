load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@mrpt_gui//:mrpt_gui_library",
    "@mrpt_gui//:mrpt_nanogui_library",
    "@mrpt_libapps_cli//:mrpt_libapps_cli_library",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "mrpt_libapps_gui_library",
    srcs = [":gen_mrpt_libapps_gui_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "WXUSINGDLL",
        "_FILE_OFFSET_BITS=64",
        "__WXGTK__",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_libapps_gui",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mrpt_libapps_gui_library"],
)

write_file(
    name = "gen_mrpt_libapps_gui_stub_cpp",
    out = "_gen/mrpt_libapps_gui_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_libapps_gui",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_libapps_gui": [
            "libmrpt_libapps_gui.so.3.3",
            "libmrpt_libapps_gui.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_gui//:ament_package",
        "@mrpt_libapps_cli//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mrpt_libapps_gui",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_libapps_gui": [
            "libmrpt_libapps_gui.so.3.3",
            "libmrpt_libapps_gui.so.3.3.1",
        ],
    },
    deps = [":ament_index"] + [
        "@mrpt_gui//:ament_package",
        "@mrpt_libapps_cli//:ament_package",
    ],
)
