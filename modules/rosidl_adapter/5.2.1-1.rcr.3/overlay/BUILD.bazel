load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

exports_files([
    "aspects.bzl",
    "defs.bzl",
    "rules.bzl",
    "tools.bzl",
    "types.bzl",
])

py_library(
    name = "rosidl_adapter",
    srcs = [
        "rosidl_adapter/__init__.py",
        "rosidl_adapter/__main__.py",
        "rosidl_adapter/action/__init__.py",
        "rosidl_adapter/cli.py",
        "rosidl_adapter/main.py",
        "rosidl_adapter/msg/__init__.py",
        "rosidl_adapter/parser.py",
        "rosidl_adapter/resource/__init__.py",
        "rosidl_adapter/srv/__init__.py",
    ],
    data = [
        "rosidl_adapter/py.typed",
        "rosidl_adapter/resource/action.idl.em",
        "rosidl_adapter/resource/msg.idl.em",
        "rosidl_adapter/resource/srv.idl.em",
        "rosidl_adapter/resource/struct.idl.em",
    ],
    deps = [
        requirement("catkin-pkg"),
        requirement("empy"),
        requirement("pyyaml"),
        "@rosidl_cli",
    ],
)

[py_binary(
    name = script,
    srcs = ["scripts/{}.py".format(script)],
    deps = [":rosidl_adapter"],
) for script in [
    "msg2idl",
    "srv2idl",
    "action2idl",
]]

ament_package(
    name = "ament_package",
    cmake = ["cmake/rosidl_adapt_interfaces.cmake"] + ["rosidl_adapter-extras.cmake"],
    cmake_extras = ["rosidl_adapter-extras.cmake"],
    lib_data = [
        "scripts/action2idl.py",
        "scripts/msg2idl.py",
        "scripts/srv2idl.py",
    ],
    package_xml = "package.xml",
    python = [
        "rosidl_adapter/__init__.py",
        "rosidl_adapter/__main__.py",
        "rosidl_adapter/action/__init__.py",
        "rosidl_adapter/cli.py",
        "rosidl_adapter/main.py",
        "rosidl_adapter/msg/__init__.py",
        "rosidl_adapter/parser.py",
        "rosidl_adapter/py.typed",
        "rosidl_adapter/resource/__init__.py",
        "rosidl_adapter/resource/action.idl.em",
        "rosidl_adapter/resource/msg.idl.em",
        "rosidl_adapter/resource/srv.idl.em",
        "rosidl_adapter/resource/struct.idl.em",
        "rosidl_adapter/srv/__init__.py",
    ],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_mypy//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_cli//:ament_package",
    ],
)
