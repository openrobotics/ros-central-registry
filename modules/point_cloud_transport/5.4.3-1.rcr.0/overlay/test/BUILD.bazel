load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
}

[cc_test(
    name = name,
    srcs = [
        "{0}.cpp".format(src),
        "utils.hpp",
    ],
    data = [
        "test_plugin_manifest.xml",
        "//:ament_index_package",
        "//:ament_index_plugin",
        "//:default_plugins.xml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = [
        'DEFAULT_PLUGINS_XML=\\"../point_cloud_transport+/default_plugins.xml\\"',
        'TEST_PLUGIN_MANIFEST_XML=\\"../point_cloud_transport+/test/test_plugin_manifest.xml\\"',
    ],
    deps = DEPENDENCIES.values() + [
        "//:point_cloud_transport_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
        "@sensor_msgs//:cc",
    ],
) for name, src in {
    "point_cloud_transport-codec": "test_point_cloud_codec",
    "point_cloud_transport-message-filter": "test_message_filter",
    "point_cloud_transport-message_passing": "test_message_passing",
    "point_cloud_transport-point_cloud_common": "test_point_cloud_common",
    "point_cloud_transport-publisher": "test_publisher",
    "point_cloud_transport-qos_override": "test_qos_override",
    "point_cloud_transport-remapping": "test_remapping",
    "point_cloud_transport-single_subscriber_publisher": "test_single_subscriber_publisher",
    "point_cloud_transport-subscriber": "test_subscriber",
}.items()]
