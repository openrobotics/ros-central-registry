load("@ament_cmake_gen_version_h//:defs.bzl", "generate_version_h")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

exports_files(["default_plugins.xml"])

generate_version_h(
    name = "version_h",
    out = "include/point_cloud_transport/version.h",
)

HEADERS = [
    "include/point_cloud_transport/exception.hpp",
    "include/point_cloud_transport/loader_fwds.hpp",
    "include/point_cloud_transport/point_cloud_codec.hpp",
    "include/point_cloud_transport/point_cloud_common.hpp",
    "include/point_cloud_transport/point_cloud_transport.hpp",
    "include/point_cloud_transport/publisher.hpp",
    "include/point_cloud_transport/publisher_plugin.hpp",
    "include/point_cloud_transport/raw_publisher.hpp",
    "include/point_cloud_transport/raw_subscriber.hpp",
    "include/point_cloud_transport/simple_publisher_plugin.hpp",
    "include/point_cloud_transport/simple_subscriber_plugin.hpp",
    "include/point_cloud_transport/single_subscriber_publisher.hpp",
    "include/point_cloud_transport/subscriber.hpp",
    "include/point_cloud_transport/subscriber_filter.hpp",
    "include/point_cloud_transport/subscriber_plugin.hpp",
    "include/point_cloud_transport/transport_hints.hpp",
    "include/point_cloud_transport/visibility_control.hpp",
] + [":version_h"]

DEPENDENCIES = {
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

cc_library(
    name = "point_cloud_transport_library",
    srcs = [
        "src/point_cloud_codec.cpp",
        "src/point_cloud_common.cpp",
        "src/point_cloud_transport.cpp",
        "src/publisher.cpp",
        "src/publisher_plugin.cpp",
        "src/raw_subscriber.cpp",
        "src/single_subscriber_publisher.cpp",
        "src/subscriber.cpp",
        "src/subscriber_filter.cpp",
        "src/subscriber_plugin.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + ["@sensor_msgs//:cc"],
)

cc_shared_library(
    name = "point_cloud_transport",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":point_cloud_transport_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":point_cloud_transport"],
)

cc_binary(
    name = "list_transports",
    srcs = ["src/list_transports.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [":point_cloud_transport_library"],
)

PLUGIN_DEPENDENCIES = DEPENDENCIES | {":point_cloud_transport": ":point_cloud_transport_library"}

cc_library(
    name = "point_cloud_transport_plugins_library",
    srcs = ["src/manifest.cpp"],
    deps = PLUGIN_DEPENDENCIES.values() + ["@sensor_msgs//:cc"],
)

cc_shared_library(
    name = "point_cloud_transport_plugins",
    dynamic_deps = PLUGIN_DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":point_cloud_transport_plugins_library"],
)

COMPONENT_DEPENDENCIES = DEPENDENCIES | {
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    ":point_cloud_transport": ":point_cloud_transport_library",
}

cc_library(
    name = "pc_republish_node_library",
    srcs = ["src/republish.cpp"],
    local_defines = ros_local_defines(),
    deps = COMPONENT_DEPENDENCIES.values(),
    alwayslink = True,
)

cc_shared_library(
    name = "pc_republish_node",
    dynamic_deps = COMPONENT_DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":pc_republish_node_library"],
)

rclcpp_components_register_node(
    name = "republish",
    component = ":pc_republish_node",
    executor = "SingleThreadedExecutor",
    node_name = "republish",
    plugin = "point_cloud_transport::Republisher",
)

ament_index(
    name = "ament_index_package",
    package_xml = "package.xml",
)

ament_index(
    name = "ament_index_plugin",
    export_name = "point_cloud_transport",
    libraries = [":point_cloud_transport_plugins"],
    package_xml = "package.xml",
    plugins = ["default_plugins.xml"],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "message_filters",
        "pluginlib",
        "rclcpp",
        "rcpputils",
        "rmw",
        "sensor_msgs",
    ],
    cmake_export_libraries = False,
    cmake_export_name = "export_point_cloud_transport",
    components = [":republish_record"],
    executables = [
        ":list_transports",
        ":republish",
    ],
    headers = HEADERS,
    libraries = [
        ":point_cloud_transport",
        ":point_cloud_transport_plugins",
        ":pc_republish_node",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index_package",
        ":ament_index_plugin",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@message_filters//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rcpputils//:ament_package",
        "@rmw//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
