 #include <string>
 #include <memory>
+#include <chrono>
+#include <stdexcept>
+#include <thread>
+#include <vector>
 
 #include <rclcpp/rclcpp.hpp>
 
 #include "point_cloud_transport/point_cloud_transport.hpp"
+
+// Endpoint discovery -- including a node's own publishers/subscriptions -- is
+// asynchronous in the RMW graph (rmw_cyclonedds_cpp, for one, feeds it from a
+// discovery thread reading the DDS builtin topics), so querying the graph right
+// after create_publisher()/create_subscription() can observe an empty or stale
+// list. The unchecked `[0]` accesses in these tests then dereference past the
+// end (observed as a segfault on the macOS CI runners under CycloneDDS). Poll,
+// bounded, until exactly `expected` endpoints are visible before returning.
+template<typename NodeT>
+std::vector<rclcpp::TopicEndpointInfo> wait_for_publishers_info(
+  NodeT & node, const std::string & topic, size_t expected = 1,
+  std::chrono::seconds timeout = std::chrono::seconds(10))
+{
+  const auto deadline = std::chrono::steady_clock::now() + timeout;
+  auto info = node.get_publishers_info_by_topic(topic);
+  while (info.size() != expected && std::chrono::steady_clock::now() < deadline) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    info = node.get_publishers_info_by_topic(topic);
+  }
+  if (info.size() != expected) {
+    throw std::runtime_error(
+            "expected " + std::to_string(expected) + " publisher(s) on '" + topic +
+            "' in the graph, found " + std::to_string(info.size()));
+  }
+  return info;
+}
+
+template<typename NodeT>
+std::vector<rclcpp::TopicEndpointInfo> wait_for_subscriptions_info(
+  NodeT & node, const std::string & topic, size_t expected = 1,
+  std::chrono::seconds timeout = std::chrono::seconds(10))
+{
+  const auto deadline = std::chrono::steady_clock::now() + timeout;
+  auto info = node.get_subscriptions_info_by_topic(topic);
+  while (info.size() != expected && std::chrono::steady_clock::now() < deadline) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    info = node.get_subscriptions_info_by_topic(topic);
+  }
+  if (info.size() != expected) {
+    throw std::runtime_error(
+            "expected " + std::to_string(expected) + " subscription(s) on '" + topic +
+            "' in the graph, found " + std::to_string(info.size()));
+  }
+  return info;
+}
 
 class TestQosOverride : public ::testing::Test
 {
