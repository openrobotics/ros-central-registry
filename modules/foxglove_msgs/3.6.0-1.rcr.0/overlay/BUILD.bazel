load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:ArrowPrimitive",
        "//msg:CameraCalibration",
        "//msg:CircleAnnotation",
        "//msg:Color",
        "//msg:CompressedAudio",
        "//msg:CompressedImage",
        "//msg:CompressedPointCloud",
        "//msg:CompressedVideo",
        "//msg:CubePrimitive",
        "//msg:CylinderPrimitive",
        "//msg:Event",
        "//msg:FrameTransform",
        "//msg:FrameTransforms",
        "//msg:GeoJSON",
        "//msg:Grid",
        "//msg:ImageAnnotations",
        "//msg:JointState",
        "//msg:JointStates",
        "//msg:KeyValuePair",
        "//msg:LaserScan",
        "//msg:LinePrimitive",
        "//msg:LocationFix",
        "//msg:LocationFixes",
        "//msg:Log",
        "//msg:ModelPrimitive",
        "//msg:Odometry",
        "//msg:PackedElementField",
        "//msg:Point2",
        "//msg:PointCloud",
        "//msg:PointsAnnotation",
        "//msg:PoseInFrame",
        "//msg:PosesInFrame",
        "//msg:RawAudio",
        "//msg:RawImage",
        "//msg:SceneEntity",
        "//msg:SceneEntityDeletion",
        "//msg:SceneUpdate",
        "//msg:SpherePrimitive",
        "//msg:TextAnnotation",
        "//msg:TextPrimitive",
        "//msg:TriangleListPrimitive",
        "//msg:Vector2",
        "//msg:VoxelGrid",
    ],
)

rosidl_ament_package(
    name = "ament_package",
    build_type = "ament_cmake",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@ros_environment//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
    ],
)
