load("@rosidl_default_generators//:defs.bzl", "ros_message")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

exports_files([
    "BehaviorTreeLog.msg",
    "BehaviorTreeStatusChange.msg",
    "CircleObject.msg",
    "CollisionDetectorState.msg",
    "CollisionMonitorState.msg",
    "Costmap.msg",
    "CostmapFilterInfo.msg",
    "CostmapMetaData.msg",
    "CostmapUpdate.msg",
    "CriticsStats.msg",
    "EdgeCost.msg",
    "ExclusionZoneDescription.msg",
    "Particle.msg",
    "ParticleCloud.msg",
    "PolygonObject.msg",
    "Route.msg",
    "RouteEdge.msg",
    "RouteNode.msg",
    "SpeedLimit.msg",
    "TrackingFeedback.msg",
    "VoxelGrid.msg",
    "WaypointStatus.msg",
])

ros_message(
    name = "BehaviorTreeLog",
    src = "BehaviorTreeLog.msg",
    deps = [
        ":BehaviorTreeStatusChange",
        "@builtin_interfaces//msg:Time",
    ],
)

ros_message(
    name = "BehaviorTreeStatusChange",
    src = "BehaviorTreeStatusChange.msg",
    deps = [
        "@builtin_interfaces//msg:Time",
    ],
)

ros_message(
    name = "CircleObject",
    src = "CircleObject.msg",
    deps = [
        "@geometry_msgs//msg:Point32",
        "@std_msgs//msg:Header",
        "@unique_identifier_msgs//msg:UUID",
