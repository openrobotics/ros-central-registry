ros_message(
    name = "ExclusionZoneDescription",
    src = "ExclusionZoneDescription.msg",
    deps = [
        "@geometry_msgs//msg:Point32",
    ],
)

ros_message(
    name = "Particle",
    src = "Particle.msg",
    deps = [
        "@geometry_msgs//msg:Pose",
    ],
)

ros_message(
    name = "ParticleCloud",
    src = "ParticleCloud.msg",
    deps = [
        ":Particle",
        "@std_msgs//msg:Header",
    ],
