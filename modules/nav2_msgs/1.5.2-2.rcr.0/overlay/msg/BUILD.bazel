)

ros_message(
    name = "CostmapMetaData",
    src = "CostmapMetaData.msg",
    deps = [
        "@builtin_interfaces//msg:Time",
        "@geometry_msgs//msg:Pose",
    ],
)

ros_message(
    name = "CostmapUpdate",
    src = "CostmapUpdate.msg",
    deps = [
