load("@rosidl_default_generators//:defs.bzl", "ros_service")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

exports_files(glob(["*.srv"]))

ros_service(
    name = "AddExclusionZone",
    src = "AddExclusionZone.srv",
    deps = [
        "//msg:ExclusionZoneDescription",
    ],
)

ros_service(
    name = "AddShapes",
    src = "AddShapes.srv",
    deps = [
        "//msg:CircleObject",
        "//msg:PolygonObject",
    ],
)

ros_service(
    name = "ClearCostmapAroundPose",
    src = "ClearCostmapAroundPose.srv",
    deps = [
        "@geometry_msgs//msg:PoseStamped",
    ],
)

ros_service(
    name = "ClearCostmapAroundRobot",
    src = "ClearCostmapAroundRobot.srv",
)

ros_service(
    name = "ClearCostmapExceptRegion",
    src = "ClearCostmapExceptRegion.srv",
)

ros_service(
    name = "ClearEntireCostmap",
    src = "ClearEntireCostmap.srv",
)

ros_service(
    name = "DynamicEdges",
    src = "DynamicEdges.srv",
    deps = [
        "//msg:EdgeCost",
    ],
)

ros_service(
    name = "GetCostmap",
    src = "GetCostmap.srv",
    deps = [
        "//msg:Costmap",
        "//msg:CostmapMetaData",
    ],
)

ros_service(
    name = "GetCosts",
    src = "GetCosts.srv",
    deps = [
        "@geometry_msgs//msg:PoseStamped",
    ],
)

ros_service(
    name = "GetShapes",
    src = "GetShapes.srv",
    deps = [
        "//msg:CircleObject",
        "//msg:PolygonObject",
    ],
)

ros_service(
    name = "IsPathValid",
    src = "IsPathValid.srv",
    deps = [
        "@nav_msgs//msg:Path",
    ],
)

ros_service(
    name = "LoadMap",
    src = "LoadMap.srv",
    deps = [
        "@nav_msgs//msg:OccupancyGrid",
    ],
)

ros_service(
    name = "ManageLifecycleNodes",
    src = "ManageLifecycleNodes.srv",
)

ros_service(
    name = "ReloadDockDatabase",
    src = "ReloadDockDatabase.srv",
)

ros_service(
    name = "RemoveExclusionZone",
    src = "RemoveExclusionZone.srv",
)

ros_service(
    name = "RemoveShapes",
    src = "RemoveShapes.srv",
    deps = [
        "@unique_identifier_msgs//msg:UUID",
    ],
)

ros_service(
    name = "SaveMap",
    src = "SaveMap.srv",
)

ros_service(
    name = "SetInitialPose",
    src = "SetInitialPose.srv",
    deps = [
        "@geometry_msgs//msg:PoseWithCovarianceStamped",
    ],
)

ros_service(
    name = "SetRouteGraph",
    src = "SetRouteGraph.srv",
)

ros_service(
    name = "Toggle",
    src = "Toggle.srv",
)
