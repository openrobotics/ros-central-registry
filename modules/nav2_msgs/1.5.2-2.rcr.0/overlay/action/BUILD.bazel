load("@rosidl_default_generators//:defs.bzl", "ros_action")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

exports_files([
    "AssistedTeleop.action",
    "BackUp.action",
    "ComputeAndTrackRoute.action",
    "ComputePathThroughPoses.action",
    "ComputePathToPose.action",
    "ComputeRoute.action",
    "DockRobot.action",
    "DriveOnHeading.action",
    "DummyBehavior.action",
    "FollowGPSWaypoints.action",
    "FollowObject.action",
    "FollowPath.action",
    "FollowWaypoints.action",
    "NavigateThroughPoses.action",
    "NavigateToPose.action",
    "SmoothPath.action",
    "Spin.action",
    "UndockRobot.action",
    "Wait.action",
])

ros_action(
    name = "AssistedTeleop",
    src = "AssistedTeleop.action",
    deps = [
        "@builtin_interfaces//msg:Duration",
    ],
)

ros_action(
    name = "BackUp",
    src = "BackUp.action",
    deps = [
        "@builtin_interfaces//msg:Duration",
        "@geometry_msgs//msg:Point",
    ],
)

ros_action(
    name = "ComputeAndTrackRoute",
    src = "ComputeAndTrackRoute.action",
    deps = [
        "//msg:Route",
        "@builtin_interfaces//msg:Duration",
        "@geometry_msgs//msg:PoseStamped",
        "@nav_msgs//msg:Path",
    ],
)

ros_action(
    name = "ComputePathThroughPoses",
    src = "ComputePathThroughPoses.action",
    deps = [
        "@builtin_interfaces//msg:Duration",
        "@geometry_msgs//msg:PoseStamped",
        "@nav_msgs//msg:Goals",
        "@nav_msgs//msg:Path",
    ],
)

ros_action(
    name = "ComputePathToPose",
    src = "ComputePathToPose.action",
    deps = [
        "@builtin_interfaces//msg:Duration",
        "@geometry_msgs//msg:PoseStamped",
        "@nav_msgs//msg:Path",
    ],
)

ros_action(
    name = "ComputeRoute",
    src = "ComputeRoute.action",
    deps = [
        "//msg:Route",
        "@builtin_interfaces//msg:Duration",
        "@geometry_msgs//msg:PoseStamped",
        "@nav_msgs//msg:Path",
    ],
)

ros_action(
    name = "DockRobot",
    src = "DockRobot.action",
    deps = [
        "@builtin_interfaces//msg:Duration",
        "@geometry_msgs//msg:PoseStamped",
    ],
)

ros_action(
    name = "DriveOnHeading",
    src = "DriveOnHeading.action",
    deps = [
        "@builtin_interfaces//msg:Duration",
        "@geometry_msgs//msg:Point",
    ],
)

ros_action(
    name = "DummyBehavior",
    src = "DummyBehavior.action",
    deps = [
        "@builtin_interfaces//msg:Duration",
        "@std_msgs//msg:String",
    ],
)

ros_action(
    name = "FollowGPSWaypoints",
    src = "FollowGPSWaypoints.action",
    deps = [
        "//msg:WaypointStatus",
        "@geographic_msgs//msg:GeoPose",
    ],
)

ros_action(
    name = "FollowObject",
    src = "FollowObject.action",
    deps = [
        "@builtin_interfaces//msg:Duration",
    ],
)

ros_action(
    name = "FollowPath",
    src = "FollowPath.action",
    deps = [
        "//msg:TrackingFeedback",
        "@nav_msgs//msg:Path",
        "@std_msgs//msg:Empty",
    ],
)

ros_action(
    name = "FollowWaypoints",
    src = "FollowWaypoints.action",
    deps = [
        "//msg:WaypointStatus",
        "@geometry_msgs//msg:PoseStamped",
    ],
)

ros_action(
    name = "NavigateThroughPoses",
    src = "NavigateThroughPoses.action",
    deps = [
        "//msg:WaypointStatus",
        "@builtin_interfaces//msg:Duration",
        "@geometry_msgs//msg:PoseStamped",
        "@nav_msgs//msg:Goals",
    ],
)

ros_action(
    name = "NavigateToPose",
    src = "NavigateToPose.action",
    deps = [
        "@builtin_interfaces//msg:Duration",
        "@geometry_msgs//msg:PoseStamped",
    ],
)

ros_action(
    name = "SmoothPath",
    src = "SmoothPath.action",
    deps = [
        "@builtin_interfaces//msg:Duration",
        "@nav_msgs//msg:Path",
    ],
