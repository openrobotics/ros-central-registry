load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
}

TEST_DEPENDENCIES = DEPENDENCIES | {
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "//:message_filters": "//:message_filters_library",
}

[cc_test(
    name = test.removesuffix(".py"),
    srcs = ["{0}".format(src)],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    flaky = test in ["message_filters-test_latest_time_policy"],
    deps = TEST_DEPENDENCIES.values() + [
        "@rosdistro//cc:googletest",
        "@sensor_msgs//:cc",
    ],
) for test, src in {
    "message_filters-msg_cache_unittest": "msg_cache_unittest.cpp",
    "message_filters-test_approximate_epsilon_time_policy": "test_approximate_epsilon_time_policy.cpp",
    "message_filters-test_approximate_time_policy": "test_approximate_time_policy.cpp",
    "message_filters-test_chain": "test_chain.cpp",
    "message_filters-test_exact_time_policy": "test_exact_time_policy.cpp",
    "message_filters-test_input_aligner": "test_input_aligner.cpp",
    "message_filters-test_latest_time_policy": "test_latest_time_policy.cpp",
    "message_filters-test_message_filters_delta_filter": "test_message_filters_delta_filter.cpp",
    "message_filters-test_message_traits": "test_message_traits.cpp",
    "message_filters-test_simple": "test_simple.cpp",
    "message_filters-test_subscriber": "test_subscriber.cpp",
    "message_filters-test_synchronizer": "test_synchronizer.cpp",
    "message_filters-test_time_sequencer": "time_sequencer_unittest.cpp",
    "message_filters-time_synchronizer_unittest": "time_synchronizer_unittest.cpp",
}.items()]

cc_test(
    name = "message_filters-test_fuzz",
    srcs = ["test_fuzz.cpp"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    tags = [
        "manual",
        "xfail",
    ],
    deps = TEST_DEPENDENCIES.values() + [
        "@rosdistro//cc:googletest",
        "@sensor_msgs//:cc",
    ],
)

[py_pytest(
    name = test.removesuffix(".py"),
    srcs = ["{0}".format(test)],
    deps = [
        "//:message_filters_py",
        "@builtin_interfaces//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
) for test in [
    "test_approxsync.py",
    "test_input_aligner.py",
    "test_message_filters_cache.py",
    "test_message_filters_chain.py",
    "test_time_synchronizer.py",
]]
