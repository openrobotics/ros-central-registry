load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = [
    "include/message_filters/cache.hpp",
    "include/message_filters/chain.hpp",
    "include/message_filters/connection.hpp",
    "include/message_filters/delta_filter.hpp",
    "include/message_filters/input_aligner.hpp",
    "include/message_filters/message_event.hpp",
    "include/message_filters/message_traits.hpp",
    "include/message_filters/null_types.hpp",
    "include/message_filters/parameter_adapter.hpp",
    "include/message_filters/pass_through.hpp",
    "include/message_filters/signal1.hpp",
    "include/message_filters/signal9.hpp",
    "include/message_filters/simple_filter.hpp",
    "include/message_filters/subscriber.hpp",
    "include/message_filters/sync_policies/approximate_epsilon_time.hpp",
    "include/message_filters/sync_policies/approximate_time.hpp",
    "include/message_filters/sync_policies/exact_time.hpp",
    "include/message_filters/sync_policies/latest_time.hpp",
    "include/message_filters/synchronizer.hpp",
    "include/message_filters/time_sequencer.hpp",
    "include/message_filters/time_synchronizer.hpp",
    "include/message_filters/visibility_control.hpp",
]

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

cc_library(
    name = "message_filters_library",
    srcs = ["src/connection.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["MESSAGE_FILTERS_BUILDING_DLL"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "message_filters",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":message_filters_library"],
)

py_library(
    name = "message_filters_py",
    srcs = [
        "src/message_filters/__init__.py",
        "src/message_filters/delta_filter.py",
        "src/message_filters/input_aligner.py",
        "src/message_filters/simple_filter.py",
    ],
    imports = ["src"],
    deps = [
        "@builtin_interfaces//:py",
        "@rclpy",
    ],
)

TEST_DEPENDENCIES = DEPENDENCIES | {
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    ":message_filters": ":message_filters_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
)

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [":message_filters"],
    package_xml = "package.xml",
    python = [":message_filters_py"],
    python_strip_prefix = "src",
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rclpy//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
