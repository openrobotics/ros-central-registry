load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
}

cc_library(
    name = "message_filters_library",
    srcs = ["src/connection.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + [
        "MESSAGE_FILTERS_BUILDING_DLL",
    ],
    deps = DEPENDENCIES.values() + [
        "@std_msgs//:cc",
    ],
)

cc_shared_library(
    name = "message_filters",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":message_filters_library"],
    deps = [":message_filters_library"],
)

### MODULES

py_library(
    name = "message_filters_py",
    srcs = glob(["src/message_filters/**/*.py"]),
    imports = ["src"],
    deps = [
        "@builtin_interfaces//:py",
        "@rclpy",
    ],
)

### TESTS

TEST_DEPENDENCIES = DEPENDENCIES | {
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    ":message_filters": ":message_filters_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

[
    cc_test(
        name = test,
        srcs = ["test/{0}".format(src)],
        dynamic_deps = [":transitive_dynamic_deps"],
        flaky = test in ["message_filters-test_latest_time_policy"],
        deps = TEST_DEPENDENCIES.values() + [
            "@rosdistro//cc:googletest",
            "@sensor_msgs//:cc",
        ],
    )
    for test, src in {
        "message_filters-msg_cache_unittest": "msg_cache_unittest.cpp",
        "message_filters-test_approximate_epsilon_time_policy": "test_approximate_epsilon_time_policy.cpp",
        "message_filters-test_approximate_time_policy": "test_approximate_time_policy.cpp",
        "message_filters-test_chain": "test_chain.cpp",
        "message_filters-test_exact_time_policy": "test_exact_time_policy.cpp",
        "message_filters-test_input_aligner": "test_input_aligner.cpp",
        "message_filters-test_latest_time_policy": "test_latest_time_policy.cpp",
        "message_filters-test_message_filters_delta_filter": "test_message_filters_delta_filter.cpp",
        "message_filters-test_message_traits": "test_message_traits.cpp",
        "message_filters-test_simple": "test_simple.cpp",
        "message_filters-test_subscriber": "test_subscriber.cpp",
        "message_filters-test_synchronizer": "test_synchronizer.cpp",
        "message_filters-test_time_sequencer": "time_sequencer_unittest.cpp",
        "message_filters-time_synchronizer_unittest": "time_synchronizer_unittest.cpp",
    }.items()
]

# Registered upstream with SKIP_TEST (ament_add_gtest(... SKIP_TEST)); built but
# never run by colcon.
cc_test(
    name = "message_filters-test_fuzz",
    srcs = ["test/test_fuzz.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    tags = [
        "manual",
        "xfail",
    ],
    deps = TEST_DEPENDENCIES.values() + [
        "@rosdistro//cc:googletest",
        "@sensor_msgs//:cc",
    ],
)

[
    py_pytest(
        name = test,
        srcs = ["test/{0}".format(test)],
        deps = [
            ":message_filters_py",
            "@builtin_interfaces//:py",
            "@rclpy",
            "@std_msgs//:py",
        ],
    )
    for test in [
        "test_approxsync.py",
        "test_input_aligner.py",
        "test_message_filters_cache.py",
        "test_message_filters_chain.py",
        "test_time_synchronizer.py",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [":message_filters"],
    package_xml = "package.xml",
    python = [":message_filters_py"],
    python_strip_prefix = "src",
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rclpy//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
