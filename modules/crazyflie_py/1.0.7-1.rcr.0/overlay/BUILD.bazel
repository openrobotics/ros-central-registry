load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

py_library(
    name = "crazyflie_py",
    srcs = [
        "crazyflie_py/__init__.py",
        "crazyflie_py/crazyflie.py",
        "crazyflie_py/crazyswarm_py.py",
        "crazyflie_py/genericJoystick.py",
        "crazyflie_py/joystick.py",
        "crazyflie_py/keyboard.py",
        "crazyflie_py/linuxjsdev.py",
        "crazyflie_py/uav_trajectory.py",
        "crazyflie_py/util.py",
    ],
    imports = ["."],
    deps = [
        "@crazyflie_interfaces//:py",
        "@rclpy",
    ],
)

ament_package(
    name = "ament_package",
    build_type = "ament_python",
    package_xml = "package.xml",
    python = [":crazyflie_py"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@crazyflie_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
