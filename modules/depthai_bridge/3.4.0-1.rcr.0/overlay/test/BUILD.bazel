cc_test(
    name = "depthai_bridge_disparity_converter_test",
    srcs = ["DisparityConverterTest.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines() + [
        "DEPTHAI_ENABLE_PROTOBUF",
        "DEPTHAI_HAVE_BASALT_SUPPORT",
        "DEPTHAI_HAVE_BETA",
        "DEPTHAI_HAVE_DYNAMIC_CALIBRATION_SUPPORT",
        "DEPTHAI_HAVE_OPENCV_SUPPORT",
        "DEPTHAI_MERGED_TARGET",
        "DEPTHAI_TARGET_BASALT",
        "DEPTHAI_TARGET_CORE",
        "DEPTHAI_TARGET_OPENCV",
        "DEPTHAI_XTENSOR_SUPPORT",
        "GTEST_HAS_PTHREAD=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:depthai_bridge_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

