load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:boringssl": "@rosdistro//cc:boringssl_crypto_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
    "@srdfdom//:srdfdom": "@srdfdom//:srdfdom_library",
    "@urdf//:urdf": "@urdf//:urdf_library",
}

CC_DEPS = [
    "@moveit_ros_visualization//:moveit_motion_planning_rviz_plugin_core_library",
    "@moveit_ros_visualization//:moveit_motion_planning_rviz_plugin_library",
    "@moveit_ros_visualization//:moveit_planning_scene_rviz_plugin_core_library",
    "@moveit_ros_visualization//:moveit_planning_scene_rviz_plugin_library",
    "@moveit_ros_visualization//:moveit_robot_state_rviz_plugin_core_library",
    "@moveit_ros_visualization//:moveit_robot_state_rviz_plugin_library",
    "@moveit_ros_visualization//:moveit_rviz_plugin_render_tools_library",
    "@moveit_ros_visualization//:moveit_trajectory_rviz_plugin_core_library",
    "@moveit_ros_visualization//:moveit_trajectory_rviz_plugin_library",
    "@moveit_setup_framework//:moveit_setup_framework_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.algorithm",
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:boringssl_ssl_library",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
    "@rules_qt//:qt_core",
    "@rules_qt//:qt_gui",
    "@rules_qt//:qt_svg",
    "@rules_qt//:qt_widgets",
]

cc_library(
    name = "moveit_setup_core_plugins_library",
    srcs = [":gen_moveit_setup_core_plugins_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/moveit_setup_core_plugins",
    ],
    local_defines = ros_local_defines() + [
        "NDEBUG",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "moveit_setup_core_plugins",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":moveit_setup_core_plugins_library"],
)

write_file(
    name = "gen_moveit_setup_core_plugins_stub_cpp",
    out = "_gen/moveit_setup_core_plugins_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    libraries = [":moveit_setup_core_plugins"],
    package_xml = "package.xml",
    plugin_category = "moveit_setup_framework",
    plugins = ["moveit_setup_framework_plugins.xml"],
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@moveit_ros_visualization//:ament_package",
        "@moveit_setup_framework//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@srdfdom//:ament_package",
        "@urdf//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    libraries = [":moveit_setup_core_plugins"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@moveit_ros_visualization//:ament_package",
        "@moveit_setup_framework//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@srdfdom//:ament_package",
        "@urdf//:ament_package",
    ],
)
