cc_library(
    name = "gps_localizer_library",
    srcs = ["src/easynav_gps_localizer/GpsLocalizer.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":gen_geographiclib_utmups_hpp"],
    copts = ["-std=c++20"],
    includes = [
        "_gen/include",
        "_gen/include/GeographicLib",
        "include",
        "include/easynav_gps_localizer",
        "tests",
    ],
    local_defines = ros_local_defines() + [
        "EASYNAV_DEBUG_WITH_YAETS",
        "GLAD_API_CALL_EXPORT",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "gps_localizer",
    dynamic_deps = DEPENDENCIES.keys(),
