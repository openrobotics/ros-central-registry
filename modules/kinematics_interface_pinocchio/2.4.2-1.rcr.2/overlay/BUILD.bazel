load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@kinematics_interface//:kinematics_interface": "@kinematics_interface//:kinematics_interface_library",
    "@pinocchio//:pinocchio_collision": "@pinocchio//:pinocchio_collision_library",
    "@pinocchio//:pinocchio_default": "@pinocchio//:pinocchio_default_library",
    "@pinocchio//:pinocchio_parsers": "@pinocchio//:pinocchio_parsers_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    ":_gen_textual_hdrs",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "_gen_textual_hdrs",
    includes = ["_gen/include"],
    textual_hdrs = [
        ":gen_eigen3_core_h",
        ":gen_eigen3_lu_h",
    ],
)

cc_library(
    name = "kinematics_interface_pinocchio_library",
    srcs = ["src/kinematics_interface_pinocchio.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_octomap_color_octree_h",
        ":gen_octomap_h",
        ":gen_octomap_msgs_conversions_h",
        ":gen_octomap_octree_key_h",
        ":gen_octomap_ros_conversions_hpp",
        ":gen_rcta_hdr_1",
        ":gen_rcta_hdr_2",
        ":gen_rcta_hdr_3",
        ":gen_rcta_hdr_4",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/kinematics_interface_pinocchio",
    ],
    local_defines = ros_local_defines() + [
        "COAL_HAS_OCTOMAP",
        "COAL_HAVE_OCTOMAP",
        "OCTOMAP_MAJOR_VERSION=1",
        "OCTOMAP_MINOR_VERSION=10",
        "OCTOMAP_PATCH_VERSION=0",
        "PINOCCHIO_ENABLE_TEMPLATE_INSTANTIATION",
        "PINOCCHIO_URDFDOM_HEADERS_MAJOR_VERSION=3",
        "PINOCCHIO_URDFDOM_HEADERS_MINOR_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_PATCH_VERSION=0",
        "PINOCCHIO_WITH_COLLISION",
        "PINOCCHIO_WITH_HPP_FCL",
        "PINOCCHIO_WITH_URDFDOM",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "kinematics_interface_pinocchio",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":kinematics_interface_pinocchio_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

write_file(
    name = "gen_rcta_hdr_1",
    out = "_gen/include/ros2_control_test_assets/components_urdfs.hpp",
    content = ["// Copyright (c) 2021 Stogl Robotics Consulting\n//\n// Licensed under the Apache License, Version 2.0 (the \"License\");\n// you may not use this file except in compliance with the License.\n// You may obtain a copy of the License at\n//\n//     http://www.apache.org/licenses/LICENSE-2.0\n//\n// Unless required by applicable law or agreed to in writing, software\n// distributed under the License is distributed on an \"AS IS\" BASIS,\n// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n// See the License for the specific language governing permissions and\n// limitations under the License.\n\n#ifndef ROS2_CONTROL_TEST_ASSETS__COMPONENTS_URDFS_HPP_\n#define ROS2_CONTROL_TEST_ASSETS__COMPONENTS_URDFS_HPP_\n\nnamespace ros2_control_test_assets\n{\n// 1. Industrial Robots with only one interface\nconst auto valid_urdf_ros2_control_system_one_interface =\n  R\"(\n  <ros2_control name=\"RRBotSystemPositionOnly\" type=\"system\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/RRBotSystemPositionOnlyHardware</plugin>\n      <param name=\"example_param_write_for_sec\">2</param>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n    </joint>\n    <joint name=\"joint2\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n    </joint>\n  </ros2_control>\n)\";\n\n// 2.1 Industrial Robots with multiple interfaces (cannot be written at the same time)\n// Note, joint parameters can be any string\nconst auto valid_urdf_ros2_control_system_multi_interface =\n  R\"(\n  <ros2_control name=\"RRBotSystemMultiInterface\" type=\"system\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/RRBotSystemMultiInterfaceHardware</plugin>\n      <param name=\"example_param_write_for_sec\">2</param>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n        <param name=\"initial_value\">1.2</param>\n      </command_interface>\n      <command_interface name=\"velocity\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n        <param name=\"initial_value\">3.4</param>\n      </command_interface>\n      <command_interface name=\"effort\">\n        <param name=\"min\">-0.5</param>\n        <param name=\"max\">0.5\"</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n      <state_interface name=\"velocity\"/>\n      <state_interface name=\"effort\"/>\n    </joint>\n    <joint name=\"joint2\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n      <state_interface name=\"velocity\"/>\n      <state_interface name=\"effort\"/>\n    </joint>\n  </ros2_control>\n)\";\n\n// 2.2 Industrial Robots with multiple interfaces (cannot be written at the same time)\n// Additionally some of the Command-/StateInterfaces have parameters defined per interface\nconst auto valid_urdf_ros2_control_system_multi_interface_and_custom_interface_parameters =\n  R\"(\n  <ros2_control name=\"RRBotSystemMultiInterface\" type=\"system\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/RRBotSystemMultiInterfaceHardware</plugin>\n      <param name=\"example_param_write_for_sec\">2</param>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n        <param name=\"initial_value\">1.2</param>\n        <param name=\"register\">1</param>\n        <param name=\"register_size\">2</param>\n      </command_interface>\n      <command_interface name=\"velocity\">\n        <param name=\"min\">-1.5</param>\n        <param name=\"max\">1.5</param>\n        <param name=\"initial_value\">3.4</param>\n        <param name=\"register\">2</param>\n        <param name=\"register_size\">4</param>\n      </command_interface>\n      <command_interface name=\"effort\">\n        <param name=\"min\">-0.5</param>\n        <param name=\"max\">0.5</param>\n      </command_interface>\n      <state_interface name=\"position\">\n        <param name=\"register\">3</param>\n        <param name=\"register_size\">2</param>\n      </state_interface>\n      <state_interface name=\"velocity\">\n        <param name=\"register\">4</param>\n        <param name=\"register_size\">4</param>\n      </state_interface>\n      <state_interface name=\"effort\"/>\n      <param name=\"modbus_server_ip\"> 1.1.1.1</param>\n      <param name=\"modbus_server_port\">1234\n      </param>\n      <param name=\"use_persistent_connection\"> true</param>\n    </joint>\n    <joint name=\"joint2\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n        <param name=\"register\">20</param>\n        <param name=\"data_type\">int32_t</param>\n      </command_interface>\n      <state_interface name=\"position\">\n        <param name=\"register\">21</param>\n        <param name=\"data_type\">int32_t </param>\n      </state_interface>\n      <state_interface name=\"velocity\"/>\n      <state_interface name=\"effort\">\n        <param name=\"register\">21</param>\n        <param name=\"data_type\"> int32_t </param>\n      </state_interface>\n      <param name=\"modbus_server_ip\">192.168.178.123</param>\n      <param name=\"modbus_server_port\">4321</param>\n    </joint>\n  </ros2_control>\n)\";\n\n// 3. Industrial Robots with integrated sensor\nconst auto valid_urdf_ros2_control_system_robot_with_sensor =\n  R\"(\n  <ros2_control name=\"RRBotSystemWithSensor\" type=\"system\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/RRBotSystemWithSensorHardware</plugin>\n      <param name=\"example_param_write_for_sec\">2</param>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n    </joint>\n    <joint name=\"joint2\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n    </joint>\n    <sensor name=\"tcp_fts_sensor\">\n      <state_interface name=\"fx\"/>\n      <state_interface name=\"fy\"/>\n      <state_interface name=\"fz\"/>\n      <state_interface name=\"tx\"/>\n      <state_interface name=\"ty\"/>\n      <state_interface name=\"tz\"/>\n      <param name=\"frame_id\">kuka_tcp</param>\n      <param name=\"lower_limits\">-100</param>\n      <param name=\"upper_limits\">100</param>\n    </sensor>\n  </ros2_control>\n)\";\n\n// 4. Industrial Robots with externally connected sensor\nconst auto valid_urdf_ros2_control_system_robot_with_external_sensor =\n  R\"(\n  <ros2_control name=\"RRBotSystemPositionOnlyWithExternalSensor\" type=\"system\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/RRBotSystemPositionOnlyHardware</plugin>\n      <param name=\"example_param_write_for_sec\">2</param>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n    </joint>\n    <joint name=\"joint2\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n    </joint>\n  </ros2_control>\n  <ros2_control name=\"RRBotForceTorqueSensor2D\" type=\"sensor\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/ForceTorqueSensor2DHardware</plugin>\n      <param name=\"example_param_read_for_sec\">0.43</param>\n    </hardware>\n    <sensor name=\"tcp_fts_sensor\">\n      <state_interface name=\"fx\"/>\n      <state_interface name=\"fy\"/>\n      <state_interface name=\"fz\"/>\n      <state_interface name=\"tx\"/>\n      <state_interface name=\"ty\"/>\n      <state_interface name=\"tz\"/>\n      <param name=\"frame_id\">kuka_tcp</param>\n      <param name=\"lower_limits\">-100</param>\n      <param name=\"upper_limits\">100</param>\n    </sensor>\n  </ros2_control>\n)\";\n\n// 5. Modular Robots with separate communication to each actuator\nconst auto valid_urdf_ros2_control_actuator_modular_robot =\n  R\"(\n  <ros2_control name=\"RRBotModularJoint1\"  type=\"actuator\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/PositionActuatorHardware</plugin>\n      <group>Hardware Group</group>\n      <param name=\"example_param_write_for_sec\">1.23</param>\n      <param name=\"example_param_read_for_sec\">3</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n    </joint>\n  </ros2_control>\n  <ros2_control name=\"RRBotModularJoint2\"  type=\"actuator\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/PositionActuatorHardware</plugin>\n      <group>Hardware Group</group>\n      <param name=\"example_param_write_for_sec\">1.23</param>\n      <param name=\"example_param_read_for_sec\">3</param>\n    </hardware>\n    <joint name=\"joint2\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n    </joint>\n  </ros2_control>\n)\";\n\n// 6. Modular Robots with actuators not providing states and with additional sensors\n// Example for simple transmission\nconst auto valid_urdf_ros2_control_actuator_modular_robot_sensors =\n  R\"(\n  <ros2_control name=\"RRBotModularJoint1\" type=\"actuator\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/VelocityActuatorHardware</plugin>\n      <group>Hardware Group 1</group>\n      <param name=\"example_param_write_for_sec\">1.23</param>\n      <param name=\"example_param_read_for_sec\">3</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"velocity\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"velocity\"/>\n    </joint>\n    <transmission name=\"transmission1\">\n      <plugin>transmission_interface/SimpleTansmission</plugin>\n      <joint name=\"joint1\" role=\"joint1\">\n        <mechanical_reduction>325.949</mechanical_reduction>\n      </joint>\n    </transmission>\n  </ros2_control>\n  <ros2_control name=\"RRBotModularJoint2\" type=\"actuator\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/VelocityActuatorHardware</plugin>\n      <group>Hardware Group 2</group>\n      <param name=\"example_param_write_for_sec\">1.23</param>\n      <param name=\"example_param_read_for_sec\">3</param>\n    </hardware>\n    <joint name=\"joint2\">\n      <command_interface name=\"velocity\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"velocity\"/>\n    </joint>\n  </ros2_control>\n  <ros2_control name=\"RRBotModularPositionSensorJoint1\" type=\"sensor\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/PositionSensorHardware</plugin>\n      <group>Hardware Group 1</group>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <state_interface name=\"position\"/>\n    </joint>\n  </ros2_control>\n  <ros2_control name=\"RRBotModularPositionSensorJoint2\" type=\"sensor\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/PositionSensorHardware</plugin>\n      <group>Hardware Group 2</group>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <joint name=\"joint2\">\n      <state_interface name=\"position\"/>\n    </joint>\n  </ros2_control>\n)\";\n\n// 7. Modular Robots with separate communication to each \"actuator\" with multi joints\n// Example for complex transmission (multi-joint/multi-actuator) - (system component is used)\nconst auto valid_urdf_ros2_control_system_multi_joints_transmission =\n  R\"(\n  <ros2_control name=\"RRBotModularWrist\" type=\"system\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/ActuatorHardwareMultiDOF</plugin>\n      <param name=\"example_param_write_for_sec\">1.23</param>\n      <param name=\"example_param_read_for_sec\">3</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n    </joint>\n    <joint name=\"joint2\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n    </joint>\n    <transmission name=\"transmission1\">\n      <plugin>transmission_interface/DifferentialTransmission</plugin>\n      <actuator name=\"joint1_motor\" role=\"actuator1\" read_only=\"true\"/>\n      <actuator name=\"joint2_motor\" role=\"actuator2\"/>\n      <joint name=\"joint1\" role=\"joint1\">\n        <mechanical_reduction>10</mechanical_reduction>\n        <offset>0.5</offset>\n      </joint>\n      <joint name=\"joint2\" role=\"joint2\" read_only=\"false\">\n        <mechanical_reduction>50</mechanical_reduction>\n      </joint>\n    </transmission>\n  </ros2_control>\n)\";\n\n// 8. Sensor only\nconst auto valid_urdf_ros2_control_sensor_only =\n  R\"(\n  <ros2_control name=\"CameraWithIMU\" type=\"sensor\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/CameraWithIMUSensor</plugin>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <sensor name=\"sensor1\">\n      <state_interface name=\"roll\"/>\n      <state_interface name=\"pitch\"/>\n      <state_interface name=\"yaw\"/>\n    </sensor>\n    <sensor name=\"sensor2\">\n      <state_interface name=\"image\"/>\n    </sensor>\n  </ros2_control>\n)\";\n\n// 9. Actuator Only\nconst auto valid_urdf_ros2_control_actuator_only =\n  R\"(\n  <ros2_control name=\"ActuatorModularJoint1\" type=\"actuator\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/VelocityActuatorHardware</plugin>\n      <param name=\"example_param_write_for_sec\">1.13</param>\n      <param name=\"example_param_read_for_sec\">3</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"velocity\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"velocity\"/>\n    </joint>\n    <transmission name=\"transmission1\">\n      <plugin>transmission_interface/RotationToLinerTansmission</plugin>\n      <joint name=\"joint1\" role=\"joint1\">\n        <mechanical_reduction>325.949</mechanical_reduction>\n      </joint>\n      <param name=\"additional_special_parameter\">1337</param>\n    </transmission>\n  </ros2_control>\n)\";\n\n// 10. Industrial Robots with integrated GPIO\nconst auto valid_urdf_ros2_control_system_robot_with_gpio =\n  R\"(\n  <ros2_control name=\"RRBotSystemWithGPIO\" type=\"system\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/RRBotSystemWithGPIOHardware</plugin>\n      <param name=\"example_param_write_for_sec\">2</param>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n    </joint>\n    <joint name=\"joint2\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n    </joint>\n    <gpio name=\"flange_analog_IOs\">\n      <command_interface name=\"analog_output1\"/>\n      <state_interface name=\"analog_output1\"/> <!-- Needed to know current state of the output -->\n      <state_interface name=\"analog_input1\"/>\n      <state_interface name=\"analog_input2\"/>\n    </gpio>\n    <gpio name=\"flange_vacuum\">\n      <command_interface name=\"vacuum\"/>\n      <state_interface name=\"vacuum\"> <!-- Needed to know current state of the input -->\n        <param name=\"initial_value\">1.0</param>\n      </state_interface>\n    </gpio>\n  </ros2_control>\n)\";\n\n// 11. Industrial Robots using size and data_type attributes\nconst auto valid_urdf_ros2_control_system_robot_with_size_and_data_type =\n  R\"(\n  <ros2_control name=\"RRBotSystemWithSizeAndDataType\" type=\"system\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/RRBotSystemWithSizeAndDataType</plugin>\n      <param name=\"example_param_write_for_sec\">2</param>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"position\"/>\n      <state_interface name=\"position\"/>\n    </joint>\n    <gpio name=\"flange_IOS\">\n      <command_interface name=\"digital_output\" size=\"2\" data_type=\"bool\"/>\n      <state_interface name=\"analog_input\" size=\"3\"/>\n      <state_interface name=\"image\" data_type=\"cv::Mat\"/>\n    </gpio>\n  </ros2_control>\n)\";\n\n// 12. Industrial Robots with integrated GPIO with few disabled limits in joints\nconst auto valid_urdf_ros2_control_system_robot_with_gpio_and_disabled_interface_limits =\n  R\"(\n  <ros2_control name=\"RRBotSystemWithGPIO\" type=\"system\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/RRBotSystemWithGPIOHardware</plugin>\n      <param name=\"example_param_write_for_sec\">2</param>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"position\">\n        <limits enable=\"false\"/>\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <command_interface name=\"velocity\">\n        <param name=\"min\">-0.05</param>\n        <param name=\"max\">0.1</param>\n      </command_interface>\n      <command_interface name=\"effort\">\n        <param name=\"min\">-0.2</param>\n        <param name=\"max\">0.2</param>\n      </command_interface>\n      <command_interface name=\"acceleration\">\n        <param name=\"min\">-0.5</param>\n        <param name=\"max\">0.5</param>\n      </command_interface>\n      <command_interface name=\"jerk\">\n        <param name=\"max\">5.0</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n    </joint>\n    <joint name=\"joint2\">\n      <limits enable=\"false\"/>\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <command_interface name=\"velocity\"/>\n      <command_interface name=\"effort\"/>\n      <command_interface name=\"acceleration\">\n        <param name=\"min\">-0.3</param>\n        <param name=\"max\">0.3</param>\n      </command_interface>\n      <command_interface name=\"jerk\">\n        <param name=\"min\">-2.0</param>\n        <param name=\"max\">2.0</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n    </joint>\n    <joint name=\"joint3\">\n      <command_interface name=\"acceleration\">\n        <param name=\"max\">1.0</param>\n      </command_interface>\n    </joint>\n    <gpio name=\"flange_IOS\">\n      <command_interface name=\"digital_output\" size=\"2\" data_type=\"bool\"/>\n      <state_interface name=\"analog_input\" size=\"3\"/>\n      <state_interface name=\"image\" data_type=\"cv::Mat\"/>\n    </gpio>\n  </ros2_control>\n)\";\nconst auto valid_urdf_ros2_control_system_robot_with_unavailable_interfaces =\n  R\"(\n  <ros2_control name=\"RRBotSystemWithGPIO\" type=\"system\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/RRBotSystemWithGPIOHardware</plugin>\n      <param name=\"example_param_write_for_sec\">2</param>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"position\">\n        <limits enable=\"false\"/>\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <command_interface name=\"velocity\">\n        <param name=\"min\">-0.05</param>\n        <param name=\"max\">0.1</param>\n      </command_interface>\n      <command_interface name=\"effort\">\n        <param name=\"min\">-0.2</param>\n        <param name=\"max\">0.2</param>\n      </command_interface>\n      <command_interface name=\"acceleration\">\n        <param name=\"min\">-0.5</param>\n        <param name=\"max\">0.5</param>\n      </command_interface>\n      <command_interface name=\"jerk\">\n        <param name=\"max\">5.0</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n    </joint>\n    <joint name=\"joint2\">\n      <limits enable=\"false\"/>\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <command_interface name=\"velocity\"/>\n      <command_interface name=\"effort\"/>\n      <command_interface name=\"acceleration\">\n        <param name=\"min\">-0.3</param>\n        <param name=\"max\">0.3</param>\n      </command_interface>\n      <command_interface name=\"jerk\"/>\n      <state_interface name=\"position\"/>\n    </joint>\n    <joint name=\"joint3\">\n      <command_interface name=\"acceleration\">\n        <param name=\"min\">1.0</param>\n      </command_interface>\n      <command_interface name=\"unavailable\">\n        <param name=\"min\">-0.3</param>\n        <param name=\"max\">0.3</param>\n      </command_interface>\n    </joint>\n  </ros2_control>\n)\";\nconst auto valid_urdf_ros2_control_system_robot_with_all_interfaces =\n  R\"(\n  <ros2_control name=\"RRBotSystemWithGPIO\" type=\"system\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/RRBotSystemWithGPIOHardware</plugin>\n      <param name=\"example_param_write_for_sec\">2</param>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"position\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <command_interface name=\"velocity\">\n        <param name=\"min\">-0.05</param>\n        <param name=\"max\">0.1</param>\n      </command_interface>\n      <command_interface name=\"effort\">\n        <param name=\"min\">-0.2</param>\n        <param name=\"max\">0.2</param>\n      </command_interface>\n      <command_interface name=\"acceleration\">\n        <param name=\"min\">-0.5</param>\n        <param name=\"max\">0.5</param>\n      </command_interface>\n      <command_interface name=\"jerk\">\n        <param name=\"max\">5.0</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n    </joint>\n    <joint name=\"joint2\">\n      <command_interface name=\"position\"/>\n      <command_interface name=\"velocity\"/>\n      <command_interface name=\"effort\"/>\n      <command_interface name=\"acceleration\"/>\n      <command_interface name=\"jerk\"/>\n      <state_interface name=\"position\"/>\n    </joint>\n   </ros2_control>\n)\";\n\n// Voltage Sensor only\nconst auto valid_urdf_ros2_control_voltage_sensor_only =\n  R\"(\n  <ros2_control name=\"SingleJointVoltage\" type=\"sensor\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/SingleJointVoltageSensor</plugin>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <sensor name=\"sens1\">\n      <state_interface name=\"voltage\" initial_value=\"0.0\"/>\n    </sensor>\n  </ros2_control>\n)\";\n\n// Joint+Voltage Sensor\nconst auto valid_urdf_ros2_control_joint_voltage_sensor =\n  R\"(\n  <ros2_control name=\"SingleJointVoltage\" type=\"sensor\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/SingleJointVoltageSensor</plugin>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <state_interface name=\"position\"/>\n    </joint>\n    <sensor name=\"sens1\">\n      <state_interface name=\"voltage\" initial_value=\"0.0\"/>\n    </sensor>\n  </ros2_control>\n)\";\n\nconst auto valid_urdf_ros2_control_dummy_actuator_only =\n  R\"(\n  <ros2_control name=\"ActuatorModularJoint1\" type=\"actuator\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/VelocityActuatorHardware</plugin>\n      <param name=\"example_param_write_for_sec\">1.13</param>\n      <param name=\"example_param_read_for_sec\">3</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"velocity\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n      <state_interface name=\"velocity\"/>\n    </joint>\n    <transmission name=\"transmission1\">\n      <plugin>transmission_interface/RotationToLinerTansmission</plugin>\n      <joint name=\"joint1\" role=\"joint1\">\n        <mechanical_reduction>325.949</mechanical_reduction>\n      </joint>\n      <param name=\"additional_special_parameter\">1337</param>\n    </transmission>\n  </ros2_control>\n)\";\n\nconst auto valid_urdf_ros2_control_dummy_system_robot =\n  R\"(\n  <ros2_control name=\"RRBotSystemWithGPIO\" type=\"system\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/RRBotSystemWithGPIOHardware</plugin>\n      <param name=\"example_param_write_for_sec\">2</param>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"velocity\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n      <state_interface name=\"velocity\"/>\n    </joint>\n    <joint name=\"joint2\">\n      <command_interface name=\"velocity\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n      <state_interface name=\"velocity\"/>\n    </joint>\n    <joint name=\"joint3\">\n      <command_interface name=\"velocity\">\n        <param name=\"min\">-1</param>\n        <param name=\"max\">1</param>\n      </command_interface>\n      <state_interface name=\"position\"/>\n      <state_interface name=\"velocity\"/>\n    </joint>\n  </ros2_control>\n)\";\n\nconst auto valid_urdf_ros2_control_parameter_empty =\n  R\"(\n  <ros2_control name=\"2DOF_System_Robot_Position_Only\" type=\"system\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/2DOF_System_Hardware_Position_Only</plugin>\n      <param name=\"example_param_write_for_sec\"></param>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"position\">\n      </command_interface>\n    </joint>\n  </ros2_control>\n)\";\n\nconst auto valid_urdf_ros2_control_system_robot_with_size_and_data_type_on_joint_sensor_and_gpio =\n  R\"(\n  <ros2_control name=\"RRBotSystemWithSizeAndDataType\" type=\"system\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/RRBotSystemWithSizeAndDataType</plugin>\n      <param name=\"example_param_write_for_sec\">2</param>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardware>\n    <joint name=\"joint1\">\n      <command_interface name=\"position\"/>\n      <state_interface name=\"position\"/>\n      <state_interface name=\"status\" data_type=\"bool\"/>\n      <command_interface name=\"enable\" data_type=\"bool\"/>\n    </joint>\n    <sensor name=\"trigger\">\n      <command_interface name=\"safety\" data_type=\"bool\"/>\n      <state_interface name=\"safety\" data_type=\"bool\"/>\n    </sensor>\n    <gpio name=\"flange_IOS\">\n      <command_interface name=\"digital_output\" size=\"2\" data_type=\"bool\"/>\n      <state_interface name=\"analog_input\" size=\"3\"/>\n      <state_interface name=\"image\" data_type=\"cv::Mat\"/>\n    </gpio>\n  </ros2_control>\n)\";\n\n// Errors\nconst auto invalid_urdf_ros2_control_invalid_child =\n  R\"(\n  <ros2_control name=\"2DOF_System_Robot_Position_Only\" type=\"system\">\n    <hardwarert>\n      <plugin>ros2_control_demo_hardware/2DOF_System_Hardware_Position_Only</plugin>\n      <param name=\"example_param_write_for_sec\">2</param>\n      <param name=\"example_param_read_for_sec\">2</param>\n    </hardwarert>\n  </ros2_control>\n  )\";\n\nconst auto invalid_urdf_ros2_control_missing_attribute =\n  R\"(\n  <ros2_control type=\"system\">\n    <hardware>\n      <plugin>ros2_control_demo_hardware/2DOF_System_Hardware_Position_Only</plugin>\n      <param nam