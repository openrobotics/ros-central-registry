load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = ["include/kinematics_interface_pinocchio/kinematics_interface_pinocchio.hpp"] + [
    ],
    includes = [],
)

DEPENDENCIES = {
    "@kinematics_interface//:kinematics_interface": "@kinematics_interface//:kinematics_interface_library",
    "@pinocchio//:pinocchio_collision": "@pinocchio//:pinocchio_collision_library",
    "@pinocchio//:pinocchio_default": "@pinocchio//:pinocchio_default_library",
    "@pinocchio//:pinocchio_parsers": "@pinocchio//:pinocchio_parsers_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    ":_gen_textual_hdrs",
    "@ros2_control_test_assets//:ros2_control_test_assets",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "_gen_textual_hdrs",
    includes = ["_gen/include"],
    textual_hdrs = [],
)

cc_library(
    name = "kinematics_interface_pinocchio_library",
    srcs = ["src/kinematics_interface_pinocchio.cpp"],
    hdrs = ["include/kinematics_interface_pinocchio/kinematics_interface_pinocchio.hpp"] + [
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/kinematics_interface_pinocchio",
    ],
    local_defines = ros_local_defines() + [
        "COAL_HAS_OCTOMAP",
        "COAL_HAVE_OCTOMAP",
        "OCTOMAP_MAJOR_VERSION=1",
        "OCTOMAP_MINOR_VERSION=10",
        "OCTOMAP_PATCH_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_MAJOR_VERSION=3",
        "PINOCCHIO_URDFDOM_HEADERS_MINOR_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_PATCH_VERSION=0",
        "PINOCCHIO_WITH_COLLISION",
        "PINOCCHIO_WITH_HPP_FCL",
        "PINOCCHIO_WITH_URDFDOM",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "kinematics_interface_pinocchio",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":kinematics_interface_pinocchio_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":kinematics_interface_pinocchio"],
)

ament_index(
    name = "ament_index",
    libraries = [":kinematics_interface_pinocchio"],
    package_xml = "package.xml",
    plugin_category = "kinematics_interface",
    plugins = ["kinematics_interface_pinocchio.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@kinematics_interface//:ament_package",
        "@pinocchio//:ament_package",
        "@pluginlib//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@ros2_control_test_assets//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "eigen3_cmake_module",
        "kinematics_interface",
        "pinocchio",
        "pluginlib",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_kinematics_interface_pinocchio",
    headers = ["include/kinematics_interface_pinocchio/kinematics_interface_pinocchio.hpp"],
    libraries = [":kinematics_interface_pinocchio"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@kinematics_interface//:ament_package",
        "@pinocchio//:ament_package",
        "@pluginlib//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@ros2_control_test_assets//:ament_package",
    ],
)
