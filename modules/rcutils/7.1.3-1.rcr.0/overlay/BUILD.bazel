    srcs = [
        "src/allocator.c",
        "src/array_list.c",
        "src/base64.c",
        "src/char_array.c",
        "src/cmdline_parser.c",
        "src/common.h",
        "src/env.c",
        "src/error_handling.c",
        "src/error_handling_helpers.h",
        "src/filesystem.c",
        "src/find.c",
        "src/format_string.c",
        "src/hash_map.c",
        "src/join.c",
        "src/logging.c",
        "src/process.c",
        "src/qsort.c",
        "src/repl_str.c",
        "src/runfiles.c",
        "src/sha256.c",
        "src/shared_library.c",
        "src/snprintf.c",
        "src/split.c",
        "src/strcasecmp.c",
        "src/strdup.c",
        "src/strerror.c",
        "src/string_array.c",
        "src/string_map.c",
        "src/strnlen.c",
        "src/testing/fault_injection.c",
        "src/time.c",
        "src/uint8_array.c",
    ] + select({
        "@platforms//os:windows": ["src/time_win32.c"],
        "//conditions:default": ["src/time_unix.c"],
    }),
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + [
        "RCUTILS_ENABLE_FAULT_INJECTION",
    ] + select({
        # _GNU_SOURCE requests glibc extensions (e.g. 'program_invocation_name',
        # 'memrchr'). It's meaningless on non-glibc platforms like Darwin, and
        # on Darwin it also makes find.c take the memrchr() branch, which
        # Darwin's libc doesn't provide.
        "@platforms//os:linux": ["_GNU_SOURCE"],
        "//conditions:default": [],
    }),
)

cc_shared_library(
    name = "rcutils",
    exports_filter = ["//:__subpackages__"],
    deps = [":rcutils_library"],
)

### TESTING

genrule(
    name = "file_with_space",
    outs = ["test/file with space.txt"],
    cmd = "echo '' > \"$(OUTS)\"",
)

genrule(
    name = "memory_tools_wrapper",
    srcs = ["memory_tools_wrapper_script.sh"],
    outs = ["memory_tools_wrapper.sh"],
    cmd = "cp $< $@ && chmod +x $@",
    executable = True,
)

# Tests that exercise osrf_testing_tools_cpp's memory-tools interposition
# checks. malloc/realloc/calloc/free interposition only reliably covers the
# whole process when injected via the :memory_tools_interpose shared library
# (a plain static link only interposes calls made directly from the test
# binary, missing calls made from within librcutils itself); a test needs to
# share that exact loaded instance -- not a separately linked static copy --
# to see the interposed calls' counters (see :memory_tools_interpose). These
# run through memory_tools_wrapper_script.sh, which additionally injects the
# dylib via DYLD_INSERT_LIBRARIES on Darwin, where interposition also needs
# to be forced early via the dynamic loader.
_MEMORY_TOOLS_TESTS = [
    "test_allocator",
    "test_error_handling",
    "test_error_handling_helpers",
    "test_time",
]

