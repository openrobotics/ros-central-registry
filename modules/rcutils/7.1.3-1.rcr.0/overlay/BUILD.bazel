[
    (
        cc_library(
            name = "dummy_" + suffix + "_lib",
            srcs = [
                "test/dummy_shared_library/dummy_shared_library.c",
                "test/dummy_shared_library/dummy_shared_library.h",
            ],
        ),
        cc_shared_library(
            name = "dummy_" + suffix,
            exports_filter = ["//:__subpackages__"],
            deps = [":dummy_" + suffix + "_lib"],
        ),
        collect_transitive_dynamic_deps(
            name = "test_" + suffix + "_dynamic_deps",
            dynamic_deps = [
                ":dummy_" + suffix,
                ":rcutils",
            ],
            visibility = ["//visibility:private"],
        ),
        cc_test(
            name = "test_" + suffix,
            srcs = [
                "test/allocator_testing_utils.h",
                "test/test_shared_library.cpp",
            ],
            data = [":dummy_" + suffix],
            dynamic_deps = [":test_" + suffix + "_dynamic_deps"],
            linkopts = ["-Wl,--no-as-needed"],
            local_defines = ros_local_defines() + [
                "SHARED_LIBRARY_UNDER_TEST=dummy_" + suffix,
            ],
            deps = [
                ":dummy_" + suffix + "_lib",
                ":rcutils_library",
                "@rosdistro//cc:googletest",
            ],
        ),
    )
    for suffix in [
        "shared_library_in_load_paths",
        "shared_library_in_run_paths",
        "shared_library_preloaded",
    ]
]

[
