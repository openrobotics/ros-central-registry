load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@mrpt_maps//:mrpt_maps_library",
    "@mrpt_poses//:mrpt_poses_library",
]

cc_library(
    name = "mola_pose_list_library",
    srcs = [":gen_mola_pose_list_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/mola_pose_list",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_pose_list",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mola_pose_list_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

write_file(
    name = "gen_mola_pose_list_stub_cpp",
    out = "_gen/mola_pose_list_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mola_pose_list",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_pose_list": [
            "libmola_pose_list.so.3.3",
            "libmola_pose_list.so.3.3.0",
        ],
    },
    deps = [
        "@mola_common//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_poses//:ament_package",
    ],
)

cc_test(
    name = "run_test-searchable-pose-list",
    srcs = [":gen_mola_pose_list_stub_cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        ":ament_index",
    ] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/mola_pose_list",
        "src",
    ],
    local_defines = ros_local_defines() + ["MOLA_MODULE_SOURCE_DIR=\\\"tests\\\""],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":mola_pose_list_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mola_pose_list",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_pose_list": [
            "libmola_pose_list.so.3.3",
            "libmola_pose_list.so.3.3.0",
        ],
    },
    deps = [":ament_index"] + [
        "@mola_common//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_poses//:ament_package",
    ],
)
