[cmake_configure_file(
    name = "{0}_py".format(test_name),
    src = "test_executables_tutorial.py.in",
    out = "{0}.py".format(test_name),
    defines = [
        "DEMO_NODES_CPP_EXECUTABLE={0}".format(exe_str),
        "DEMO_NODES_CPP_EXPECTED_OUTPUT={0}".format(expected_str),
        "rmw_implementation=rmw_fastrtps_cpp",
    ],
) for test_name, (exe_str, expected_str, _) in TUTORIAL_TESTS.items()]

EXPECTED_OUTPUT_FILES = [
    "add_two_ints_client.txt",
    "add_two_ints_client_async.txt",
    "add_two_ints_server.txt",
    "content_filtering_publisher.txt",
    "content_filtering_subscriber.txt",
    "content_filtering_subscriber-rmw_connextdds.txt",
    "content_filtering_subscriber-rmw_fastrtps_cpp.txt",
    "list_parameters.txt",
    "list_parameters_async.txt",
    "listener.regex",
    "matched_event_detect.txt",
    "parameter_events.txt",
    "parameter_events_async.txt",
    "set_and_get_parameters.txt",
    "set_and_get_parameters_async.txt",
    "talker.txt",
    "use_logger_service.txt",
]

[launch_ros_test(
    name = test_name,
    src = "{0}_py".format(test_name),
    # Only this test's expected-output files (incl. per-RMW variants).
    data = ["//:ament_index"] + [
        f
        for f in EXPECTED_OUTPUT_FILES
        if f.rsplit(".", 1)[0].split("-rmw_")[0] in [
            p.rsplit("/", 1)[-1]
            for p in expected_str.split(";")
        ]
    ],
    deps = executables + [
        "//:rmw_test_fixture_implementation",
        "@rules_python//python/runfiles",
    ],
) for test_name, (_, expected_str, executables) in TUTORIAL_TESTS.items()]
