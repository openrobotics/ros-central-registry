load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

ament_index(
    name = "ament_index",
    data = ["resource/plot.ui"] + ["plugin.xml"],
    executables = [":bin/rqt_plot"],
    package_xml = "package.xml",
    plugin_category = "rqt_gui",
    plugins = ["plugin.xml"],
    deps = ["@rqt_gui_py//:ament_index"],
)

py_library(
    name = "rqt_plot",
    srcs = [
        "src/rqt_plot/__init__.py",
        "src/rqt_plot/data_plot/__init__.py",
        "src/rqt_plot/data_plot/mat_data_plot.py",
        "src/rqt_plot/data_plot/pyqtgraph_data_plot.py",
        "src/rqt_plot/data_plot/qwt_data_plot.py",
        "src/rqt_plot/main.py",
        "src/rqt_plot/plot.py",
        "src/rqt_plot/plot_widget.py",
        "src/rqt_plot/rosplot.py",
    ],
    data = ["resource/plot.ui"] + ["plugin.xml"],
    imports = ["src"],
    deps = [
        "@python_qt_binding",
        "@qt_gui_py_common",
        "@rclpy",
        "@rosidl_parser",
        "@rosidl_runtime_py",
        "@rqt_gui",
        "@rqt_gui_py",
        "@rqt_py_common",
        "@std_msgs//:py",
        requirement("matplotlib"),
        requirement("pyqtgraph"),
    ],
)

py_binary(
    name = "gui",
    srcs = ["src/rqt_plot/main.py"],
    args = ["--force-discover"],
    data = [":ament_index"],
    main = "src/rqt_plot/main.py",
    deps = [":rqt_plot"],
)

py_binary(
    name = "bin/rqt_plot",
    srcs = ["src/rqt_plot/main.py"],
    main = "src/rqt_plot/main.py",
    deps = [":rqt_plot"],
)

ament_package(
    name = "ament_package",
    console_scripts = {"rqt_plot": "rqt_plot.main:main"},
    package_xml = "package.xml",
    python = [":rqt_plot"],
    python_strip_prefix = "src",
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@python_qt_binding//:ament_package",
        "@qt_gui_py_common//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_parser//:ament_package",
        "@rosidl_runtime_py//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@rqt_py_common//:ament_package",
        "@std_msgs//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
