load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
    "@yaets//:yaets": "@yaets//:yaets_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "easynav_common_library",
    hdrs = [
        "include/easynav_common/CircularBuffer.hpp",
        "include/easynav_common/RTTFBuffer.hpp",
        "include/easynav_common/Singleton.hpp",
        "include/easynav_common/YTSession.hpp",
        "include/easynav_common/types/NavState.hpp",
        "include/easynav_common/types/TFInfo.hpp",
    ],
    includes = [
        "include",
        "include/easynav_common",
        "tests",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

alias(
    name = "yaets",
    actual = "@yaets//:yaets",
)

alias(
    name = "yaets_library",
    actual = "@yaets//:yaets_library",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@tf2_ros//:ament_package",
        "@yaets//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "geometry_msgs",
        "rclcpp",
        "rclcpp_lifecycle",
        "tf2_ros",
        "yaets",
    ],
    cmake_export_libraries = False,
    cmake_export_name = "export_easynav_common",
    headers = [
        "include/easynav_common/CircularBuffer.hpp",
        "include/easynav_common/RTTFBuffer.hpp",
        "include/easynav_common/Singleton.hpp",
        "include/easynav_common/YTSession.hpp",
        "include/easynav_common/types/NavState.hpp",
        "include/easynav_common/types/TFInfo.hpp",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@tf2_ros//:ament_package",
        "@yaets//:ament_package",
    ],
)
