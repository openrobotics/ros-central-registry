load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
    "@yaets//:yaets": "@yaets//:yaets_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "easynav_common_library",
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/easynav_common",
        "tests",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@tf2_ros//:ament_package",
        "@yaets//:ament_package",
    ],
)

cc_test(
    name = "navstate_tests",
    srcs = ["tests/navstate_tests.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    data = [":ament_index"] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/easynav_common",
        "tests",
    ],
    local_defines = ros_local_defines() + ["EASYNAV_DEBUG_WITH_YAETS"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":easynav_common_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "rclcpp_lifecycle",
        "tf2_ros",
        "geometry_msgs",
        "yaets",
    ],
    cmake_export_libraries = False,
    cmake_export_name = "export_easynav_common",
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
        ],
        allow_empty = True,
    ),
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@tf2_ros//:ament_package",
        "@yaets//:ament_package",
    ],
)
