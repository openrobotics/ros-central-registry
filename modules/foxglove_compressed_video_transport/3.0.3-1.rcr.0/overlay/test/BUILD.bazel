load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@ffmpeg_encoder_decoder//:ffmpeg_encoder_decoder": "@ffmpeg_encoder_decoder//:ffmpeg_encoder_decoder_library",
    "@foxglove_msgs//:cc_shared": "@foxglove_msgs//:cc",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_test(
    name = "foxglove_compressed_video_transport_test",
    srcs = ["test_1.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "IMAGE_TRANSPORT_NEEDS_PUBLISHEROPTIONS",
        "IMAGE_TRANSPORT_RESOLVES_BASE_TOPIC",
        "IMAGE_TRANSPORT_USE_NODEINTERFACE",
        "IMAGE_TRANSPORT_USE_PUBLISHER_T",
        "IMAGE_TRANSPORT_USE_QOS",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:foxglove_compressed_video_transport_component_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
