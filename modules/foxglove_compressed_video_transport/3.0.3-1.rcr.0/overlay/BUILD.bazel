load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@ffmpeg_encoder_decoder//:ffmpeg_encoder_decoder": "@ffmpeg_encoder_decoder//:ffmpeg_encoder_decoder_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@foxglove_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

cc_library(
    name = "foxglove_compressed_video_transport_component_library",
    srcs = [":gen_foxglove_compressed_video_transport_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/foxglove_compressed_video_transport",
    ],
    local_defines = ros_local_defines() + [
        "IMAGE_TRANSPORT_NEEDS_PUBLISHEROPTIONS",
        "IMAGE_TRANSPORT_RESOLVES_BASE_TOPIC",
        "IMAGE_TRANSPORT_USE_NODEINTERFACE",
        "IMAGE_TRANSPORT_USE_PUBLISHER_T",
        "IMAGE_TRANSPORT_USE_QOS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "foxglove_compressed_video_transport_component",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":foxglove_compressed_video_transport_component_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":foxglove_compressed_video_transport_component"],
)

write_file(
    name = "gen_foxglove_compressed_video_transport_stub_cpp",
    out = "_gen/foxglove_compressed_video_transport_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    data = ["launch/cam.launch.py"],
    libraries = [":foxglove_compressed_video_transport_component"],
    package_xml = "package.xml",
    plugin_category = "image_transport",
    plugins = ["foxglove_plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ffmpeg_encoder_decoder//:ament_package",
        "@foxglove_msgs//:ament_package",
        "@image_transport//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rcutils//:ament_package",
        "@ros_environment//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

cc_test(
    name = "foxglove_compressed_video_transport_test",
    srcs = [":gen_foxglove_compressed_video_transport_stub_cpp"],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/foxglove_compressed_video_transport",
    ],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "IMAGE_TRANSPORT_NEEDS_PUBLISHEROPTIONS",
        "IMAGE_TRANSPORT_RESOLVES_BASE_TOPIC",
        "IMAGE_TRANSPORT_USE_NODEINTERFACE",
        "IMAGE_TRANSPORT_USE_PUBLISHER_T",
        "IMAGE_TRANSPORT_USE_QOS",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":foxglove_compressed_video_transport_component_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "image_transport",
        "pluginlib",
        "rclcpp",
        "rcutils",
        "sensor_msgs",
        "std_msgs",
        "ffmpeg_encoder_decoder",
        "foxglove_msgs",
    ],
    cmake_export_name = "export_foxglove_compressed_video_transport_component",
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [":foxglove_compressed_video_transport_component"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ffmpeg_encoder_decoder//:ament_package",
        "@foxglove_msgs//:ament_package",
        "@image_transport//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rcutils//:ament_package",
        "@ros_environment//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
