load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            "CHANGELOG.rst",
            "ament_clang_tidy/__init__.py",
            "ament_clang_tidy/main.py",
            "ament_clang_tidy/py.typed",
            "doc/index.rst",
            "package.xml",
            "pytest.ini",
            "resource/ament_clang_tidy",
            "setup.py",
            "test/test_copyright.py",
            "test/test_flake8.py",
            "test/test_pep257.py",
            "test/test_xmllint.py",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

py_library(
    name = "ament_clang_tidy",
    srcs = [
        "ament_clang_tidy/__init__.py",
        "ament_clang_tidy/main.py",
    ],
    imports = ["."],
    deps = [
        requirement("pyyaml"),
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_programs = {"ament_clang_tidy": "ament_clang_tidy.main:main"},
    package_xml = "package.xml",
    python = [":ament_clang_tidy"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
