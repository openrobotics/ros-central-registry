+def find_runfiles_executable():
+    # Prefer the hermetic clang-tidy shipped in our runfiles over one on PATH.
+    try:
+        from ament_clang_tidy.clang_tidy_rlocation import CLANG_TIDY_RLOCATIONPATH
+        from python.runfiles import runfiles
+    except ImportError:
+        return None
+    r = runfiles.Create()
+    path = r.Rlocation(CLANG_TIDY_RLOCATIONPATH) if r else None
+    if path and os.path.isfile(path) and os.access(path, os.X_OK):
+        return os.path.abspath(path)
+    return None
 
 
