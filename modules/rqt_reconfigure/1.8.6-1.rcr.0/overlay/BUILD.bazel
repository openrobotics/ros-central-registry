load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### DATA

ament_index(
    name = "ament_index",
    data = glob(
        ["resource/**"],
        exclude = ["resource/rqt_reconfigure"],
    ) + ["plugin.xml"],
    package_xml = "package.xml",
    deps = ["@rqt_gui_py//:ament_index"],
)

### LIBRARIES

py_library(
    name = "rqt_reconfigure",
    srcs = glob(["src/rqt_reconfigure/**/*.py"]),
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@python_qt_binding",
        "@qt_gui_py_common",
        "@rclpy",
        "@rqt_console",
        "@rqt_gui",
        "@rqt_gui_py",
        "@rqt_py_common",
    ],
)

### EXECUTABLES

py_binary(
    name = "gui",
    srcs = ["src/rqt_reconfigure/__main__.py"],
    args = ["--force-discover"],
    main = "src/rqt_reconfigure/__main__.py",
    deps = [":rqt_reconfigure"],
)

### TESTS

py_pytest(
    name = "test_treenode_qstditem",
    srcs = ["test/test_treenode_qstditem.py"],
    deps = [":rqt_reconfigure"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"rqt_reconfigure": "rqt_reconfigure.__main__:main"},
    package_xml = "package.xml",
    python = [":rqt_reconfigure"],
    python_strip_prefix = "src",
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_xmllint//:ament_package",
        "@python_qt_binding//:ament_package",
        "@qt_gui_py_common//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_console//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@rqt_py_common//:ament_package",
    ],
)
