load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

ament_index(
    name = "ament_index",
    data = [
        "resource/editor_bool.ui",
        "resource/editor_enum.ui",
        "resource/editor_number.ui",
        "resource/editor_string.ui",
        "resource/node_selector.ui",
        "resource/param_main.ui",
        "resource/param_timeline.ui",
        "resource/paramedit_pane.ui",
        "resource/singlenode_parameditor.ui",
        "resource/text_filter_widget.ui",
    ] + ["plugin.xml"],
    package_xml = "package.xml",
    deps = ["@rqt_gui_py//:ament_index"],
)

py_library(
    name = "rqt_reconfigure",
    srcs = [
        "src/rqt_reconfigure/__init__.py",
        "src/rqt_reconfigure/__main__.py",
        "src/rqt_reconfigure/filter_children_model.py",
        "src/rqt_reconfigure/logging.py",
        "src/rqt_reconfigure/node_selector_widget.py",
        "src/rqt_reconfigure/param_api.py",
        "src/rqt_reconfigure/param_client_widget.py",
        "src/rqt_reconfigure/param_editors.py",
        "src/rqt_reconfigure/param_plugin.py",
        "src/rqt_reconfigure/param_widget.py",
        "src/rqt_reconfigure/paramedit_widget.py",
        "src/rqt_reconfigure/text_filter.py",
        "src/rqt_reconfigure/text_filter_widget.py",
        "src/rqt_reconfigure/treenode_item_model.py",
        "src/rqt_reconfigure/treenode_qstditem.py",
        "src/rqt_reconfigure/treenode_status.py",
    ],
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@python_qt_binding",
        "@qt_gui_py_common",
        "@rclpy",
        "@rqt_console",
        "@rqt_gui",
        "@rqt_gui_py",
        "@rqt_py_common",
    ],
)

py_binary(
    name = "gui",
    srcs = ["src/rqt_reconfigure/__main__.py"],
    args = ["--force-discover"],
    main = "src/rqt_reconfigure/__main__.py",
    deps = [":rqt_reconfigure"],
)

ament_package(
    name = "ament_package",
    console_scripts = {"rqt_reconfigure": "rqt_reconfigure.__main__:main"},
    package_xml = "package.xml",
    python = [":rqt_reconfigure"],
    python_strip_prefix = "src",
    setup_cfg = "setup.cfg",
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_xmllint//:ament_package",
        "@python_qt_binding//:ament_package",
        "@qt_gui_py_common//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_console//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@rqt_py_common//:ament_package",
    ],
)
