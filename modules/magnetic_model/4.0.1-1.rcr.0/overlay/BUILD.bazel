    name = "gen_extra_2",
    out = "_gen/include/magnetic_model/magnetic_model/version.h",
    content = ["// Copyright 2015 Open Source Robotics Foundation, Inc.\n//\n// Licensed under the Apache License, Version 2.0 (the \"License\");\n// you may not use this file except in compliance with the License.\n// You may obtain a copy of the License at\n//\n//     http://www.apache.org/licenses/LICENSE-2.0\n//\n// Unless required by applicable law or agreed to in writing, software\n// distributed under the License is distributed on an \"AS IS\" BASIS,\n// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n// See the License for the specific language governing permissions and\n// limitations under the License.\n\n#ifndef MAGNETIC_MODEL__VERSION_H_\n#define MAGNETIC_MODEL__VERSION_H_\n\n/// \\def MAGNETIC_MODEL_VERSION_MAJOR\n/// Defines MAGNETIC_MODEL major version number\n#define MAGNETIC_MODEL_VERSION_MAJOR (4)\n\n/// \\def MAGNETIC_MODEL_VERSION_MINOR\n/// Defines MAGNETIC_MODEL minor version number\n#define MAGNETIC_MODEL_VERSION_MINOR (0)\n\n/// \\def MAGNETIC_MODEL_VERSION_PATCH\n/// Defines MAGNETIC_MODEL version patch number\n#define MAGNETIC_MODEL_VERSION_PATCH (1)\n\n/// \\def MAGNETIC_MODEL_VERSION_STR\n/// Defines MAGNETIC_MODEL version string\n#define MAGNETIC_MODEL_VERSION_STR \"4.0.1\"\n\n/// \\def MAGNETIC_MODEL_VERSION_GTE\n/// Defines a macro to check whether the version of MAGNETIC_MODEL is greater than or equal to\n/// the given version triple.\n#define MAGNETIC_MODEL_VERSION_GTE(major, minor, patch) ( \\\n     (major < MAGNETIC_MODEL_VERSION_MAJOR) ? true \\\n     : ((major > MAGNETIC_MODEL_VERSION_MAJOR) ? false \\\n     : ((minor < MAGNETIC_MODEL_VERSION_MINOR) ? true \\\n     : ((minor > MAGNETIC_MODEL_VERSION_MINOR) ? false \\\n     : ((patch < MAGNETIC_MODEL_VERSION_PATCH) ? true \\\n     : ((patch > MAGNETIC_MODEL_VERSION_PATCH) ? false \\\n     : true))))))\n\n#endif  // MAGNETIC_MODEL__VERSION_H_\n"],
)

