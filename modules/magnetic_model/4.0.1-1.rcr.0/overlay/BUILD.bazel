load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines", "ros_version_header")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@cras_cpp_common//:cras_c_api": "@cras_cpp_common//:cras_c_api_library",
    "@cras_cpp_common//:cras_cloud": "@cras_cpp_common//:cras_cloud_library",
    "@cras_cpp_common//:cras_filter_base": "@cras_cpp_common//:cras_filter_base_library",
    "@cras_cpp_common//:cras_log_utils": "@cras_cpp_common//:cras_log_utils_library",
    "@cras_cpp_common//:cras_param_utils": "@cras_cpp_common//:cras_param_utils_library",
    "@cras_cpp_common//:cras_qos_utils": "@cras_cpp_common//:cras_qos_utils_library",
    "@cras_cpp_common//:cras_rate_limiter": "@cras_cpp_common//:cras_rate_limiter_library",
    "@cras_cpp_common//:cras_semaphore": "@cras_cpp_common//:cras_semaphore_library",
    "@cras_cpp_common//:cras_string_utils": "@cras_cpp_common//:cras_string_utils_library",
    "@cras_cpp_common//:cras_tf2_sensor_msgs": "@cras_cpp_common//:cras_tf2_sensor_msgs_library",
    "@cras_cpp_common//:cras_tf2_utils": "@cras_cpp_common//:cras_tf2_utils_library",
    "@cras_cpp_common//:cras_thread_utils": "@cras_cpp_common//:cras_thread_utils_library",
    "@cras_cpp_common//:cras_time_utils": "@cras_cpp_common//:cras_time_utils_library",
    "@cras_cpp_common//:cras_type_utils": "@cras_cpp_common//:cras_type_utils_library",
    "@cras_cpp_common//:cras_urdf_utils": "@cras_cpp_common//:cras_urdf_utils_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:geographiclib": "@rosdistro//cc:geographiclib_library",
}

CC_DEPS = [
    "@angles//:angles",
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
    "@sensor_msgs//:cc",
]

cc_library(
    name = "magnetic_model_library",
    srcs = [
        "src/magnetic_model.cpp",
        "src/magnetic_model_manager.cpp",
    ],
    hdrs = [
        "include/magnetic_model/magnetic_model.hpp",
        "include/magnetic_model/magnetic_model_manager.hpp",
    ] + [":version_h"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/magnetic_model",
        "_gen/include/magnetic_model/magnetic_model",
        "include",
        "include/magnetic_model",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_shared_library(
    name = "magnetic_model",
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":magnetic_model_library"],
)

ros_version_header(
    name = "version_h",
    out = "_gen/include/magnetic_model/magnetic_model/version.h",
)

ament_index(
    name = "ament_index",
    data = [
        "share/data/magnetic/LICENSE",
        "share/data/magnetic/README.md",
        "share/data/magnetic/igrf14.wmm",
        "share/data/magnetic/igrf14.wmm.cof",
        "share/data/magnetic/igrf14.wmm.cof.license",
        "share/data/magnetic/igrf14.wmm.license",
        "share/data/magnetic/wmm2010.wmm",
        "share/data/magnetic/wmm2010.wmm.cof",
        "share/data/magnetic/wmm2010.wmm.cof.license",
        "share/data/magnetic/wmm2010.wmm.license",
        "share/data/magnetic/wmm2015v2.wmm",
        "share/data/magnetic/wmm2015v2.wmm.cof",
        "share/data/magnetic/wmm2015v2.wmm.cof.license",
        "share/data/magnetic/wmm2015v2.wmm.license",
        "share/data/magnetic/wmm2020.wmm",
        "share/data/magnetic/wmm2020.wmm.cof",
        "share/data/magnetic/wmm2020.wmm.cof.license",
        "share/data/magnetic/wmm2020.wmm.license",
        "share/data/magnetic/wmm2025.wmm",
        "share/data/magnetic/wmm2025.wmm.cof",
        "share/data/magnetic/wmm2025.wmm.cof.license",
        "share/data/magnetic/wmm2025.wmm.license",
    ],
    data_strip_prefix = "share",
    libraries = [
        ":magnetic_model",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@angles//:ament_package",
        "@cras_cpp_common//:ament_package",
        "@cras_lint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)

cc_test(
    name = "test_magnetic_model",
    srcs = ["test/test_magnetic_model.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/magnetic_model",
        "_gen/include/magnetic_model/magnetic_model",
        "include",
        "include/magnetic_model",
    ],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "TEST_DATA_DIR=\\\"share/magnetic_model/data/magnetic\\\"",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":magnetic_model_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "cras_cpp_common",
        "geometry_msgs",
        "rclcpp",
        "sensor_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_magnetic_model",
    headers = [
        ":version_h",
    ] + [
        "include/magnetic_model/magnetic_model.hpp",
        "include/magnetic_model/magnetic_model_manager.hpp",
    ],
    include_prefix = "",
    libraries = [
        ":magnetic_model",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@angles//:ament_package",
        "@cras_cpp_common//:ament_package",
        "@cras_lint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
