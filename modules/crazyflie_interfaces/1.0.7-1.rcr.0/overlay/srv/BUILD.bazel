load("@rosidl_default_generators//:defs.bzl", "ros_service")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

exports_files([
    "AddLogging.srv",
    "Arm.srv",
    "GoTo.srv",
    "Land.srv",
    "NotifySetpointsStop.srv",
    "RemoveLogging.srv",
    "SetGroupMask.srv",
    "StartTrajectory.srv",
    "Stop.srv",
    "Takeoff.srv",
    "UpdateParams.srv",
    "UploadTrajectory.srv",
])

ros_service(
    name = "AddLogging",
    src = "AddLogging.srv",
)

ros_service(
    name = "Arm",
    src = "Arm.srv",
)

ros_service(
    name = "GoTo",
    src = "GoTo.srv",
    deps = [
        "@builtin_interfaces//msg:Duration",
        "@geometry_msgs//msg:Point",
    ],
)

ros_service(
    name = "Land",
    src = "Land.srv",
    deps = [
        "@builtin_interfaces//msg:Duration",
    ],
)

ros_service(
    name = "NotifySetpointsStop",
    src = "NotifySetpointsStop.srv",
)

ros_service(
    name = "RemoveLogging",
    src = "RemoveLogging.srv",
)

ros_service(
    name = "SetGroupMask",
    src = "SetGroupMask.srv",
)

ros_service(
    name = "StartTrajectory",
    src = "StartTrajectory.srv",
)

ros_service(
    name = "Stop",
    src = "Stop.srv",
)

ros_service(
    name = "Takeoff",
    src = "Takeoff.srv",
    deps = [
        "@builtin_interfaces//msg:Duration",
    ],
)

ros_service(
    name = "UpdateParams",
    src = "UpdateParams.srv",
)

ros_service(
    name = "UploadTrajectory",
    src = "UploadTrajectory.srv",
    deps = [
        "//msg:TrajectoryPolynomialPiece",
    ],
)
