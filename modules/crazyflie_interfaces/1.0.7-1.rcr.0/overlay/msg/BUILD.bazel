load("@rosidl_default_generators//:defs.bzl", "ros_message")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

exports_files([
    "ConnectionStatistics.msg",
    "ConnectionStatisticsArray.msg",
    "FullState.msg",
    "Hover.msg",
    "LogBlock.msg",
    "LogDataGeneric.msg",
    "Position.msg",
    "Status.msg",
    "TrajectoryPolynomialPiece.msg",
    "VelocityWorld.msg",
])

ros_message(
    name = "ConnectionStatistics",
    src = "ConnectionStatistics.msg",
)

ros_message(
    name = "ConnectionStatisticsArray",
    src = "ConnectionStatisticsArray.msg",
    deps = [
        ":ConnectionStatistics",
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "FullState",
    src = "FullState.msg",
    deps = [
        "@geometry_msgs//msg:Pose",
        "@geometry_msgs//msg:Twist",
        "@geometry_msgs//msg:Vector3",
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "Hover",
    src = "Hover.msg",
    deps = [
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "LogBlock",
    src = "LogBlock.msg",
)

ros_message(
    name = "LogDataGeneric",
    src = "LogDataGeneric.msg",
    deps = [
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "Position",
    src = "Position.msg",
    deps = [
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "Status",
    src = "Status.msg",
    deps = [
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "TrajectoryPolynomialPiece",
    src = "TrajectoryPolynomialPiece.msg",
    deps = [
        "@builtin_interfaces//msg:Duration",
    ],
)

ros_message(
    name = "VelocityWorld",
    src = "VelocityWorld.msg",
    deps = [
        "@geometry_msgs//msg:Vector3",
        "@std_msgs//msg:Header",
    ],
)
