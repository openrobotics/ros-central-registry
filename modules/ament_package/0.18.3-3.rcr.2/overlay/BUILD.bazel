load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PYTHON MODULE

# Named :py because :ament_package is the packaging target below.
py_library(
    name = "py",
    srcs = glob(["ament_package/**/*.py"]),
    data = glob(["ament_package/template/**"]),
    imports = ["."],
)

### TESTS

py_pytest(
    name = "test_flake8",
    srcs = ["test/test_flake8.py"],
    data = glob(["**/*"]),
    deps = [requirement("flake8")],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":py"] + glob(["ament_package/template/**"]),
    deps = [
        "@rosdistro//:ament_package",
    ],
)
