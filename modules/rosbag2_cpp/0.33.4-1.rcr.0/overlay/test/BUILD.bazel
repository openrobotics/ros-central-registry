cc_library(
    name = "converter_test_plugins_library",
    srcs = [
        "rosbag2_cpp/converter_test_plugin.cpp",
        "rosbag2_cpp/serializer_test_plugin.cpp",
    ],
    hdrs = [
        "rosbag2_cpp/converter_test_plugin.hpp",
        "rosbag2_cpp/fake_data.hpp",
        "rosbag2_cpp/mock_cache_consumer.hpp",
        "rosbag2_cpp/mock_converter.hpp",
        "rosbag2_cpp/mock_converter_factory.hpp",
        "rosbag2_cpp/mock_message_cache.hpp",
        "rosbag2_cpp/mock_metadata_io.hpp",
        "rosbag2_cpp/mock_storage.hpp",
        "rosbag2_cpp/mock_storage_factory.hpp",
        "rosbag2_cpp/serializer_test_plugin.hpp",
    ],
    deps = DEPENDENCIES.values() + ["//:rosbag2_cpp_library"],
)

cc_shared_library(
    name = "converter_test_plugins",
    dynamic_deps = [
        "//:transitive_dynamic_deps",
        "@std_msgs//:cc_shared",
        "@test_msgs//:cc_shared",
    ],
    exports_filter = [":converter_test_plugins_library"],
    deps = [":converter_test_plugins_library"],
)

cc_library(
    name = "test_headers",
    testonly = True,
    hdrs = [
        "rosbag2_cpp/fake_data.hpp",
        "rosbag2_cpp/mock_cache_consumer.hpp",
        "rosbag2_cpp/mock_converter.hpp",
        "rosbag2_cpp/mock_converter_factory.hpp",
        "rosbag2_cpp/mock_message_cache.hpp",
        "rosbag2_cpp/mock_metadata_io.hpp",
        "rosbag2_cpp/mock_storage.hpp",
        "rosbag2_cpp/mock_storage_factory.hpp",
    ],
)

[cc_test(
    name = test.removesuffix(".py"),
    srcs = [
        "rosbag2_cpp/{0}.cpp".format(test),
        "rosbag2_cpp/fake_data.cpp",
    ],
    data = [
        ":converter_test_plugins",
        "//:ament_index",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines() + ['_TEST_RESOURCES_DIR_PATH=\\"test/rosbag2_cpp\\"'],
    deps = TEST_DEPENDENCIES.values() + [
        ":test_headers",
        "@rosdistro//cc:googletest",
    ],
) for test in [
    "test_action_utils",
    "test_circular_message_cache",
    "test_converter_factory",
    "test_info",
    "test_local_message_definition_source",
    "test_message_cache",
    "test_multifile_reader",
    "test_reindexer",
    "test_sequential_reader",
    "test_sequential_writer",
    "test_serialization_converter",
    "test_service_utils",
    "test_storage_without_metadata_file",
    "test_time_controller_clock",
    "test_transient_local_messages_cache",
]]

cc_test(
    name = "test_ros2_message",
    srcs = ["rosbag2_cpp/types/test_ros2_message.cpp"],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = TEST_DEPENDENCIES.values() + [
        "@rosdistro//cc:googletest",
    ],
)
