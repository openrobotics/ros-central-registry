cc_library(
    name = "moveit_ros_benchmarks_library",
    srcs = [
        "src/BenchmarkExecutor.cpp",
        "src/BenchmarkOptions.cpp",
    ],
    hdrs = [
        "include/moveit/benchmarks/BenchmarkExecutor.h",
        "include/moveit/benchmarks/BenchmarkExecutor.hpp",
        "include/moveit/benchmarks/BenchmarkOptions.h",
        "include/moveit/benchmarks/BenchmarkOptions.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = ["include"],
    local_defines = ros_local_defines() + [
        "NDEBUG",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "moveit_ros_benchmarks",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":moveit_ros_benchmarks_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "moveit_run_benchmark",
