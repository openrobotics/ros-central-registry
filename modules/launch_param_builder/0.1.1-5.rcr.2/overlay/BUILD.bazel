load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

py_library(
    name = "launch_param_builder",
    srcs = [
        "launch_param_builder/__init__.py",
        "launch_param_builder/launch_param_builder.py",
        "launch_param_builder/utils.py",
    ],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@rclpy",
        "@xacro",
        requirement("pyyaml"),
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "example/launch_param_builder_example.launch.py",
        "example/parameter_injection_example.launch.py",
    ] + [
        "example/config/param_file_to_inject.yaml",
        "example/config/parameter.xacro",
        "example/config/parameter_file",
        "example/config/parameters.yaml",
        "example/config/parameters_injection.yaml",
    ],
    data_strip_prefixes = [
        "example/config->config",
        "example->launch",
    ],
    package_xml = "package.xml",
)

py_binary(
    name = "example_node.py",
    srcs = ["example/example_node.py"],
    data = [":ament_index"],
    main = "example/example_node.py",
    deps = [
        ":launch_param_builder",
        "@rclpy",
    ],
)

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            ".github/workflows/ci.yaml",
            ".github/workflows/format.yaml",
            ".github/workflows/prerelease.yaml",
            ".pre-commit-config.yaml",
            "CHANGELOG.rst",
            "CONTRIBUTING.md",
            "LICENSE",
            "README.md",
            "example/config/param_file_to_inject.yaml",
            "example/config/parameter.xacro",
            "example/config/parameter_file",
            "example/config/parameters.yaml",
            "example/config/parameters_injection.yaml",
            "example/example_node.py",
            "example/launch_param_builder_example.launch.py",
            "example/parameter_injection_example.launch.py",
            "launch_param_builder/__init__.py",
            "launch_param_builder/launch_param_builder.py",
            "launch_param_builder/utils.py",
            "package.xml",
            "resource/launch_param_builder",
            "setup.py",
            "test/test_copyright.py",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    executables = [":example_node.py"],
    package_xml = "package.xml",
    python = [":launch_param_builder"],
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_index_python//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@xacro//:ament_package",
    ],
)

launch_ros_binary(
    name = "example_launch_param_builder_example_launch_py",
    src = "example/launch_param_builder_example.launch.py",
    deps = [
        ":example_node.py",
        ":launch_param_builder",
    ],
)

launch_ros_binary(
    name = "example_parameter_injection_example_launch_py",
    src = "example/parameter_injection_example.launch.py",
    data = [":ament_index"],
    deps = [":launch_param_builder"],
)
