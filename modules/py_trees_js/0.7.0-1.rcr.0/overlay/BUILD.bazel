load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "py_trees_js",
    srcs = [
        "py_trees_js/__init__.py",
        "py_trees_js/resources.py",
        "py_trees_js/viewer/__init__.py",
        "py_trees_js/viewer/console.py",
        "py_trees_js/viewer/images_rc.py",
        "py_trees_js/viewer/main_window.py",
        "py_trees_js/viewer/main_window_ui.py",
        "py_trees_js/viewer/trees.py",
        "py_trees_js/viewer/viewer.py",
        "py_trees_js/viewer/web_app_rc.py",
        "py_trees_js/viewer/web_view.py",
        "py_trees_js/viewer/web_view_ui.py",
    ],
    imports = ["."],
)

ament_package(
    name = "ament_package",
    console_programs = {"py-trees-demo-viewer": "py_trees_js.viewer.viewer:main"},
    data = [
        "js/jointjs/README",
        "js/jointjs/backbone-1.4.0.js",
        "js/jointjs/dagre-0.8.4.min.js",
        "js/jointjs/graphlib-2.1.7.min.js",
        "js/jointjs/joint-3.0.2.min.css",
        "js/jointjs/joint-3.0.2.min.js",
        "js/jointjs/joint-3.0.4.js",
        "js/jointjs/joint-3.0.4.min.css",
        "js/jointjs/joint-3.0.4.min.js",
        "js/jointjs/jquery-3.4.1.min.js",
        "js/jointjs/lodash-4.17.11.min.js",
        "js/py_trees-0.6.css",
        "js/py_trees-0.6.js",
    ],
    package_xml = "package.xml",
    python = [":py_trees_js"],
    deps = ["@rosdistro//:ament_package"],
)
