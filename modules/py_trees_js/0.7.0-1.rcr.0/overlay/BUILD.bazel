load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "py_trees_js",
    srcs = glob(["py_trees_js/**/*.py"]),
    imports = ["."],
)

py_pytest(
    name = "test_launch",
    srcs = ["tests/test_launch.py"],
    data = glob(["tests/**"]),
    imports = [
        ".",
        "tests",
    ],
    deps = [":py_trees_js"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_programs = {"py-trees-demo-viewer": "py_trees_js.viewer.viewer:main"},
    data = [
        "js/jointjs/README",
        "js/jointjs/backbone-1.4.0.js",
        "js/jointjs/dagre-0.8.4.min.js",
        "js/jointjs/graphlib-2.1.7.min.js",
        "js/jointjs/joint-3.0.2.min.css",
        "js/jointjs/joint-3.0.2.min.js",
        "js/jointjs/joint-3.0.4.js",
        "js/jointjs/joint-3.0.4.min.css",
        "js/jointjs/joint-3.0.4.min.js",
        "js/jointjs/jquery-3.4.1.min.js",
        "js/jointjs/lodash-4.17.11.min.js",
        "js/py_trees-0.6.css",
        "js/py_trees-0.6.js",
    ],
    package_xml = "package.xml",
    python = [":py_trees_js"],
    deps = [
        "@rosdistro//:ament_package",
    ],
)
