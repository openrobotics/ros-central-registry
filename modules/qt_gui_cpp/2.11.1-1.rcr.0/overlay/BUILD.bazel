load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")
load("@rules_qt//:qt.bzl", "qt_cc_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

ament_index(
    name = "ament_index",
    data = ["plugin.xml"],
    package_xml = "package.xml",
)

HEADERS = glob(["include/**/*.hpp"])

qt_cc_library(
    name = "qt_gui_cpp",
    srcs = glob([
        "src/qt_gui_cpp/*.cpp",
    ]),
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = [
        "@pluginlib//:pluginlib_library",
        "@rosdistro//cc:tinyxml2_library",
        "@rules_qt//:qt",
        "@rules_qt//:qt_gui",
        "@rules_qt//:qt_widgets",
    ],
)

cc_shared_library(
    name = "qt_gui_cpp_shared",
    dynamic_deps = [
        "@pluginlib//:pluginlib",
        "@rosdistro//cc:tinyxml2",
    ],
    exports_filter = [":qt_gui_cpp"],
    shared_lib_name = "qt_gui_cpp.so",
    deps = [":qt_gui_cpp"],
)

genrule(
    name = "qt_gui_cpp_sip_so",
    outs = ["src/qt_gui_cpp/libqt_gui_cpp_sip.so"],
    cmd = "touch $@",
)

py_library(
    name = "qt_gui_cpp_py",
    srcs = glob(["src/qt_gui_cpp/**/*.py"]),
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@python_qt_binding",
        "@qt_gui",
    ],
)

# Skipped in reference colcon run (requires SIP/Shiboken C++ bindings built against system qmake6).
py_pytest(
    name = "test_imports_sip",
    srcs = ["test/test_imports_sip.py"],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":qt_gui_cpp_py"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = ["cmake/qt_gui_cpp-extras.cmake"],
    cmake_export_dependencies_list = [
        "pluginlib",
        "TinyXML2",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_qt_gui_cpp",
    cmake_extras = ["qt_gui_cpp-extras.cmake"],
    headers = HEADERS,
    libraries = [":qt_gui_cpp_shared"],
    package_xml = "package.xml",
    python = [
        ":qt_gui_cpp_py",
        ":qt_gui_cpp_sip_so",
    ] + glob(["src/qt_gui_cpp/*.cpp"]),
    python_strip_prefix = "src",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@pluginlib//:ament_package",
        "@python_qt_binding//:ament_package",
        "@qt_gui//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
