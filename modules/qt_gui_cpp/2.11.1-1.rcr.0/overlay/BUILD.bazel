load("@qt//:qt.bzl", "qt_cc_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

ament_index(
    name = "ament_index",
    data = ["plugin.xml"],
    package_xml = "package.xml",
)

HEADERS = [
    "include/qt_gui_cpp/composite_plugin_provider.hpp",
    "include/qt_gui_cpp/generic_proxy.hpp",
    "include/qt_gui_cpp/plugin.hpp",
    "include/qt_gui_cpp/plugin_bridge.hpp",
    "include/qt_gui_cpp/plugin_context.hpp",
    "include/qt_gui_cpp/plugin_descriptor.hpp",
    "include/qt_gui_cpp/plugin_provider.hpp",
    "include/qt_gui_cpp/recursive_plugin_provider.hpp",
    "include/qt_gui_cpp/ros_pluginlib_plugin_provider.hpp",
    "include/qt_gui_cpp/ros_pluginlib_plugin_provider_for_plugin_providers.hpp",
    "include/qt_gui_cpp/ros_pluginlib_plugin_provider_for_plugins.hpp",
    "include/qt_gui_cpp/settings.hpp",
]

qt_cc_library(
    name = "qt_gui_cpp",
    srcs = [
        "src/qt_gui_cpp/composite_plugin_provider.cpp",
        "src/qt_gui_cpp/generic_proxy.cpp",
        "src/qt_gui_cpp/plugin_bridge.cpp",
        "src/qt_gui_cpp/plugin_context.cpp",
        "src/qt_gui_cpp/plugin_descriptor.cpp",
        "src/qt_gui_cpp/plugin_provider.cpp",
        "src/qt_gui_cpp/recursive_plugin_provider.cpp",
        "src/qt_gui_cpp/settings.cpp",
    ],
    hdrs = HEADERS,
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = [
        "@pluginlib//:pluginlib_library",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtbase//:widgets",
        "@rosdistro//cc:tinyxml2_library",
    ],
)

cc_shared_library(
    name = "qt_gui_cpp_shared",
    dynamic_deps = [
        "@pluginlib//:pluginlib",
        "@rosdistro//cc:tinyxml2",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:widgets_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "qt_gui_cpp.so",
    deps = [":qt_gui_cpp"],
)

genrule(
    name = "qt_gui_cpp_sip_so",
    outs = ["src/qt_gui_cpp/libqt_gui_cpp_sip.so"],
    cmd = "touch $@",
)

py_library(
    name = "qt_gui_cpp_py",
    srcs = [
        "src/qt_gui_cpp/__init__.py",
        "src/qt_gui_cpp/cpp_binding_helper.py",
        "src/qt_gui_cpp/cpp_plugin_provider.py",
        "src/qt_gui_cpp/ros_pluginlib_plugin_provider.py",
    ],
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@python_qt_binding",
        "@qt_gui",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = ["cmake/qt_gui_cpp-extras.cmake"],
    cmake_export_dependencies_list = [
        "TinyXML2",
        "pluginlib",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_qt_gui_cpp",
    cmake_extras = ["qt_gui_cpp-extras.cmake"],
    headers = HEADERS,
    libraries = [":qt_gui_cpp_shared"],
    package_xml = "package.xml",
    python = [
        ":qt_gui_cpp_py",
        ":qt_gui_cpp_sip_so",
    ] + [
        "src/qt_gui_cpp/composite_plugin_provider.cpp",
        "src/qt_gui_cpp/generic_proxy.cpp",
        "src/qt_gui_cpp/plugin_bridge.cpp",
        "src/qt_gui_cpp/plugin_context.cpp",
        "src/qt_gui_cpp/plugin_descriptor.cpp",
        "src/qt_gui_cpp/plugin_provider.cpp",
        "src/qt_gui_cpp/recursive_plugin_provider.cpp",
        "src/qt_gui_cpp/settings.cpp",
    ],
    python_strip_prefix = "src",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@pluginlib//:ament_package",
        "@python_qt_binding//:ament_package",
        "@qt_gui//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
