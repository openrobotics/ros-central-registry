load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
    ]
]

py_library(
    name = "rmf_demos_tasks",
    srcs = glob(["rmf_demos_tasks/**/*.py"]),
    imports = ["."],
    deps = [
        "@rmf_dispenser_msgs//:py",
        "@rmf_fleet_msgs//:py",
        "@rmf_lift_msgs//:py",
        "@rmf_task_msgs//:py",
        requirement("pyyaml"),
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "api_request": "rmf_demos_tasks.api_request:main",
        "cancel_robot_task": "rmf_demos_tasks.cancel_robot_task:main",
        "cancel_task": "rmf_demos_tasks.cancel_task:main",
        "dispatch_action": "rmf_demos_tasks.dispatch_action:main",
        "dispatch_cart_delivery": "rmf_demos_tasks.dispatch_cart_delivery:main",
        "dispatch_clean": "rmf_demos_tasks.dispatch_clean:main",
        "dispatch_delivery": "rmf_demos_tasks.dispatch_delivery:main",
        "dispatch_dynamic_event": "rmf_demos_tasks.dispatch_dynamic_event:main",
        "dispatch_go_to_place": "rmf_demos_tasks.dispatch_go_to_place:main",
        "dispatch_json": "rmf_demos_tasks.dispatch_json:main",
        "dispatch_loop": "rmf_demos_tasks.dispatch_loop:main",
        "dispatch_patrol": "rmf_demos_tasks.dispatch_patrol:main",
        "dispatch_teleop": "rmf_demos_tasks.dispatch_teleop:main",
        "dynamic_event_client": "rmf_demos_tasks.dynamic_event_client:main",
        "emergency_signal": "rmf_demos_tasks.emergency_signal:main",
        "get_robot_location": "rmf_demos_tasks.get_robot_location:main",
        "mock_docker": "rmf_demos_tasks.mock_docker:main",
        "request_lift": "rmf_demos_tasks.request_lift:main",
        "request_loop": "rmf_demos_tasks.request_loop:main",
        "teleop_robot": "rmf_demos_tasks.teleop_robot:main",
        "wait_for_task_complete": "rmf_demos_tasks.wait_for_task_complete:main",
    },
    package_xml = "package.xml",
    python = [":rmf_demos_tasks"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@rmf_dispenser_msgs//:ament_package",
        "@rmf_fleet_msgs//:ament_package",
        "@rmf_lift_msgs//:ament_package",
        "@rmf_task_msgs//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
