load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

_SCRIPTS = [
    "api_request",
    "cancel_robot_task",
    "cancel_task",
    "dispatch_action",
    "dispatch_cart_delivery",
    "dispatch_clean",
    "dispatch_delivery",
    "dispatch_dynamic_event",
    "dispatch_go_to_place",
    "dispatch_json",
    "dispatch_loop",
    "dispatch_patrol",
    "dispatch_teleop",
    "dynamic_event_client",
    "emergency_signal",
    "get_robot_location",
    "mock_docker",
    "request_lift",
    "request_loop",
    "teleop_robot",
    "wait_for_task_complete",
]

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            "CHANGELOG.rst",
            "QUALITY_DECLARATION.md",
            "README.md",
            "package.xml",
            "resource/rmf_demos_tasks",
            "rmf_demos_tasks/__init__.py",
            "rmf_demos_tasks/airport_docker_config.yaml",
            "rmf_demos_tasks/api_request.py",
            "rmf_demos_tasks/cancel_robot_task.py",
            "rmf_demos_tasks/cancel_task.py",
            "rmf_demos_tasks/dispatch_action.py",
            "rmf_demos_tasks/dispatch_cart_delivery.py",
            "rmf_demos_tasks/dispatch_clean.py",
            "rmf_demos_tasks/dispatch_delivery.py",
            "rmf_demos_tasks/dispatch_dynamic_event.py",
            "rmf_demos_tasks/dispatch_go_to_place.py",
            "rmf_demos_tasks/dispatch_json.py",
            "rmf_demos_tasks/dispatch_loop.py",
            "rmf_demos_tasks/dispatch_patrol.py",
            "rmf_demos_tasks/dispatch_teleop.py",
            "rmf_demos_tasks/dynamic_event_client.py",
            "rmf_demos_tasks/emergency_signal.py",
            "rmf_demos_tasks/get_robot_location.py",
            "rmf_demos_tasks/hotel_cleaner_config.yaml",
            "rmf_demos_tasks/mock_docker.py",
            "rmf_demos_tasks/request_lift.py",
            "rmf_demos_tasks/request_loop.py",
            "rmf_demos_tasks/teleop_robot.py",
            "rmf_demos_tasks/wait_for_task_complete.py",
            "setup.cfg",
            "setup.py",
            "test/__init__.py",
            "test/test_copyright.py",
            "test/test_flake8.py",
            "test/test_pep257.py",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
    ]
]

py_library(
    name = "rmf_demos_tasks",
    srcs = [
        "rmf_demos_tasks/__init__.py",
        "rmf_demos_tasks/api_request.py",
        "rmf_demos_tasks/cancel_robot_task.py",
        "rmf_demos_tasks/cancel_task.py",
        "rmf_demos_tasks/dispatch_action.py",
        "rmf_demos_tasks/dispatch_cart_delivery.py",
        "rmf_demos_tasks/dispatch_clean.py",
        "rmf_demos_tasks/dispatch_delivery.py",
        "rmf_demos_tasks/dispatch_dynamic_event.py",
        "rmf_demos_tasks/dispatch_go_to_place.py",
        "rmf_demos_tasks/dispatch_json.py",
        "rmf_demos_tasks/dispatch_loop.py",
        "rmf_demos_tasks/dispatch_patrol.py",
        "rmf_demos_tasks/dispatch_teleop.py",
        "rmf_demos_tasks/dynamic_event_client.py",
        "rmf_demos_tasks/emergency_signal.py",
        "rmf_demos_tasks/get_robot_location.py",
        "rmf_demos_tasks/mock_docker.py",
        "rmf_demos_tasks/request_lift.py",
        "rmf_demos_tasks/request_loop.py",
        "rmf_demos_tasks/teleop_robot.py",
        "rmf_demos_tasks/wait_for_task_complete.py",
    ],
    imports = ["."],
    deps = [
        "@rmf_dispenser_msgs//:py",
        "@rmf_fleet_msgs//:py",
        "@rmf_lift_msgs//:py",
        "@rmf_task_msgs//:py",
        requirement("pyyaml"),
    ],
)

[
    (
        py_binary(
            name = "lib/{0}".format(script),
            srcs = ["rmf_demos_tasks/{0}.py".format(script)],
            data = [":ament_index"],
            imports = ["."],
            main_module = "rmf_demos_tasks.{0}".format(script),
            deps = [":rmf_demos_tasks"],
        ),
        alias(
            name = script,
            actual = ":lib/{0}".format(script),
        ),
    )
    for script in _SCRIPTS
]

### PACKAGING

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@rmf_dispenser_msgs//:ament_package",
        "@rmf_fleet_msgs//:ament_package",
        "@rmf_lift_msgs//:ament_package",
        "@rmf_task_msgs//:ament_package",
        "@rosdistro//:ament_package",
    ],
)

ament_package(
    name = "ament_package",
    console_scripts = {
        script: "rmf_demos_tasks.{0}:main".format(script)
        for script in _SCRIPTS
    },
    executables = [":lib/{0}".format(script) for script in _SCRIPTS],
    package_xml = "package.xml",
    python = [":rmf_demos_tasks"],
    setup_cfg = "setup.cfg",
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@rmf_dispenser_msgs//:ament_package",
        "@rmf_fleet_msgs//:ament_package",
        "@rmf_lift_msgs//:ament_package",
        "@rmf_task_msgs//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
