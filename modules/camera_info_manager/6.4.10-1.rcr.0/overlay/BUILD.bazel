load("@ament_cmake_gen_version_h//:defs.bzl", "generate_version_h")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

generate_version_h(
    name = "version_h",
    out = "include/camera_info_manager/version.h",
)

HEADERS = glob(
    [
        "include/**/*.h",
        "include/**/*.hpp",
    ],
    allow_empty = True,
) + [":version_h"]

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@camera_calibration_parsers//:camera_calibration_parsers": "@camera_calibration_parsers//:camera_calibration_parsers_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
}

cc_library(
    name = "camera_info_manager_library",
    srcs = [
        "src/camera_info_manager.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["CAMERA_INFO_MANAGER_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + [
        "@sensor_msgs//:cc",
    ],
)

cc_shared_library(
    name = "camera_info_manager",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":camera_info_manager_library"],
    deps = [":camera_info_manager_library"],
)

### TRANSITIVE DYNAMIC DEPS

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":camera_info_manager",
    ],
    visibility = ["//visibility:private"],
)

### TESTS

ament_index(
    name = "ament_index",
    data = ["tests/test_calibration.yaml"],
    package_xml = "package.xml",
)

cc_test(
    name = "camera_info_manager-unit_test",
    srcs = ["tests/unit_test.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    tags = [
        "manual",
        "xfail",
    ],
    deps = DEPENDENCIES.values() + [
        ":camera_info_manager_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
        "@sensor_msgs//:cc",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_camera_info_manager",
    headers = HEADERS,
    libraries = [":camera_info_manager"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@camera_calibration_parsers//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rcpputils//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
