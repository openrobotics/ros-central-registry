load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

py_library(
    name = "rpyutils",
    srcs = [
        "rpyutils/__init__.py",
        "rpyutils/add_dll_directories.py",
        "rpyutils/import_c_library.py",
    ],
    data = ["rpyutils/py.typed"],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "CONTRIBUTING.md",
        "LICENSE",
        "README.md",
        "package.xml",
        "pytest.ini",
        "resource/rpyutils",
        "rpyutils/__init__.py",
        "rpyutils/add_dll_directories.py",
        "rpyutils/import_c_library.py",
        "rpyutils/py.typed",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)] + ([
        ":rpyutils",
        "@ament_flake8",
        "@ament_pep257",
        "@ament_xmllint",
    ] if linter == "mypy" else []),
) for linter in [
    "copyright",
    "flake8",
    "mypy",
    "pep257",
    "xmllint",
]]

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":rpyutils"] + ["rpyutils/py.typed"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
