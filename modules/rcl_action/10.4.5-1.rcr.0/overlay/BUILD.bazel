load("@ament_cmake_gen_version_h//:defs.bzl", "generate_version_h")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/rcl_action/action_client.h",
        "include/rcl_action/action_server.h",
        "include/rcl_action/default_qos.h",
        "include/rcl_action/goal_handle.h",
        "include/rcl_action/goal_state_machine.h",
        "include/rcl_action/graph.h",
        "include/rcl_action/names.h",
        "include/rcl_action/rcl_action.h",
        "include/rcl_action/types.h",
        "include/rcl_action/visibility_control.h",
        "include/rcl_action/wait.h",
        "src/rcl_action/action_client_impl.h",
        "src/rcl_action/action_server_impl.h",
    ],
    includes = ["src"],
)

HEADERS = [
    "include/rcl_action/action_client.h",
    "include/rcl_action/action_server.h",
    "include/rcl_action/default_qos.h",
    "include/rcl_action/goal_handle.h",
    "include/rcl_action/goal_state_machine.h",
    "include/rcl_action/graph.h",
    "include/rcl_action/names.h",
    "include/rcl_action/rcl_action.h",
    "include/rcl_action/types.h",
    "include/rcl_action/visibility_control.h",
    "include/rcl_action/wait.h",
]

DEPENDENCIES = {
    "@action_msgs//:c_shared": "@action_msgs//:c",
    "@rcl//:rcl": "@rcl//:rcl_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
}

cc_library(
    name = "rcl_action_library",
    srcs = [
        "src/rcl_action/action_client.c",
        "src/rcl_action/action_client_impl.h",
        "src/rcl_action/action_server.c",
        "src/rcl_action/action_server_impl.h",
        "src/rcl_action/goal_handle.c",
        "src/rcl_action/goal_state_machine.c",
        "src/rcl_action/graph.c",
        "src/rcl_action/names.c",
        "src/rcl_action/types.c",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rcl_action",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rcl_action_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":rcl_action",
        "@action_msgs//:c_shared",
    ],
)

generate_version_h(
    name = "version_h",
    out = "include/rcl_action/version.h",
)

ament_package(
    name = "ament_package",
    headers = HEADERS + [":version_h"],
    libraries = [":rcl_action"],
    package_xml = "package.xml",
    deps = [
        "@action_msgs//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@osrf_testing_tools_cpp//:ament_package",
        "@rcl//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rmw_implementation_cmake//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
