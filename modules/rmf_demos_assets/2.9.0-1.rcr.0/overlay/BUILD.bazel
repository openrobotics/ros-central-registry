load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

write_file(
    name = "meta_share_rmf_demos_assets_environment_rmf_demos_assets_dsv",
    out = "_meta/share/rmf_demos_assets/environment/rmf_demos_assets.dsv",
    content = ["prepend-non-duplicate;GZ_SIM_RESOURCE_PATH;share/rmf_demos_assets/models"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = [
        ":meta_share_rmf_demos_assets_environment_rmf_demos_assets_dsv",
    ] + glob(["models/**"]),
    env_hooks = ["environment/rmf_demos_assets.dsv"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
