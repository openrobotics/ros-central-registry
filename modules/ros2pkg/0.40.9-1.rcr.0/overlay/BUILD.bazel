load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### DATA

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

### PYTHON MODULE

write_file(
    name = "pkg_info",
    out = "ros2pkg-0.40.9.egg-info/PKG-INFO",
    content = [
        "Metadata-Version: 2.1",
        "Name: ros2pkg",
        "Version: 0.40.9",
    ],
)

write_file(
    name = "entry_points_txt",
    out = "ros2pkg-0.40.9.egg-info/entry_points.txt",
    content = [
        "[ros2cli.command]",
        "pkg = ros2pkg.command.pkg:PkgCommand",
        "",
        "[ros2cli.extension_point]",
        "ros2pkg.verb = ros2pkg.verb:VerbExtension",
        "",
        "[ros2pkg.verb]",
        "create = ros2pkg.verb.create:CreateVerb",
        "executables = ros2pkg.verb.executables:ExecutablesVerb",
        "list = ros2pkg.verb.list:ListVerb",
        "prefix = ros2pkg.verb.prefix:PrefixVerb",
        "xml = ros2pkg.verb.xml:XmlVerb",
    ],
)

py_library(
    name = "ros2pkg",
    srcs = glob(["ros2pkg/**/*.py"]),
    data = glob(
        ["ros2pkg/**"],
        exclude = ["ros2pkg/**/*.py"],
    ) + [
        ":ament_index",
        ":entry_points_txt",
        ":pkg_info",
    ],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@ros2cli",
        requirement("catkin_pkg"),
    ],
)

### TESTS

[
    py_pytest(
        name = test,
        srcs = ["test/{0}.py".format(test)],
        args = [
            "-p",
            "launch_testing.pytest.hooks",
            "-p",
            "launch_testing_ros_pytest_entrypoint",
            "--",
        ] if test == "test_cli" else [],
        deps = [
            ":ros2pkg",
            "@ament_copyright",
            "@launch",
            "@launch_testing",
            "@launch_testing_ros",
        ],
    )
    for test in [
        "test_api",
        "test_cli",
    ]
]

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":ros2pkg"] + glob(
        ["ros2pkg/**"],
        exclude = ["ros2pkg/**/*.py"],
    ),
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@launch//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@ros2cli//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
