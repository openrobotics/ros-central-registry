load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

write_file(
    name = "pkg_info",
    out = "ros2pkg-0.40.9.egg-info/PKG-INFO",
    content = [
        "Metadata-Version: 2.1",
        "Name: ros2pkg",
        "Version: 0.40.9",
    ],
)

write_file(
    name = "entry_points_txt",
    out = "ros2pkg-0.40.9.egg-info/entry_points.txt",
    content = [
        "[ros2cli.command]",
        "pkg = ros2pkg.command.pkg:PkgCommand",
        "",
        "[ros2cli.extension_point]",
        "ros2pkg.verb = ros2pkg.verb:VerbExtension",
        "",
        "[ros2pkg.verb]",
        "create = ros2pkg.verb.create:CreateVerb",
        "executables = ros2pkg.verb.executables:ExecutablesVerb",
        "list = ros2pkg.verb.list:ListVerb",
        "prefix = ros2pkg.verb.prefix:PrefixVerb",
        "xml = ros2pkg.verb.xml:XmlVerb",
    ],
)

py_library(
    name = "ros2pkg",
    srcs = [
        "ros2pkg/__init__.py",
        "ros2pkg/api/__init__.py",
        "ros2pkg/api/create.py",
        "ros2pkg/command/__init__.py",
        "ros2pkg/command/pkg.py",
        "ros2pkg/resource/__init__.py",
        "ros2pkg/resource/ament_cargo/__init__.py",
        "ros2pkg/resource/ament_cmake/__init__.py",
        "ros2pkg/resource/ament_python/__init__.py",
        "ros2pkg/resource/cmake/__init__.py",
        "ros2pkg/resource/cpp/__init__.py",
        "ros2pkg/resource/package_environment/__init__.py",
        "ros2pkg/resource/rust/__init__.py",
        "ros2pkg/verb/__init__.py",
        "ros2pkg/verb/create.py",
        "ros2pkg/verb/executables.py",
        "ros2pkg/verb/list.py",
        "ros2pkg/verb/prefix.py",
        "ros2pkg/verb/xml.py",
    ],
    data = [
        "ros2pkg/py.typed",
        "ros2pkg/resource/ament_cargo/Cargo.toml.em",
        "ros2pkg/resource/ament_cmake/CMakeLists.txt.em",
        "ros2pkg/resource/ament_python/init.py.em",
        "ros2pkg/resource/ament_python/main.py.em",
        "ros2pkg/resource/ament_python/py.typed.em",
        "ros2pkg/resource/ament_python/resource_file.em",
        "ros2pkg/resource/ament_python/setup.cfg.em",
        "ros2pkg/resource/ament_python/setup.py.em",
        "ros2pkg/resource/ament_python/test_copyright.py.em",
        "ros2pkg/resource/ament_python/test_flake8.py.em",
        "ros2pkg/resource/ament_python/test_mypy.py.em",
        "ros2pkg/resource/ament_python/test_pep257.py.em",
        "ros2pkg/resource/ament_python/test_xmllint.py.em",
        "ros2pkg/resource/cmake/CMakeLists.txt.em",
        "ros2pkg/resource/cmake/Config.cmake.in.em",
        "ros2pkg/resource/cmake/ConfigVersion.cmake.in.em",
        "ros2pkg/resource/cpp/header.hpp.em",
        "ros2pkg/resource/cpp/library.cpp.em",
        "ros2pkg/resource/cpp/main.cpp.em",
        "ros2pkg/resource/cpp/visibility_control.h.em",
        "ros2pkg/resource/package_environment/package.xml.em",
        "ros2pkg/resource/rust/main.rs.em",
    ] + [
        ":ament_index",
        ":entry_points_txt",
        ":pkg_info",
    ],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@ros2cli",
        requirement("catkin_pkg"),
    ],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "package.xml",
        "resource/ros2pkg",
        "ros2pkg/__init__.py",
        "ros2pkg/api/__init__.py",
        "ros2pkg/api/create.py",
        "ros2pkg/command/__init__.py",
        "ros2pkg/command/pkg.py",
        "ros2pkg/py.typed",
        "ros2pkg/resource/__init__.py",
        "ros2pkg/resource/ament_cargo/Cargo.toml.em",
        "ros2pkg/resource/ament_cargo/__init__.py",
        "ros2pkg/resource/ament_cmake/CMakeLists.txt.em",
        "ros2pkg/resource/ament_cmake/__init__.py",
        "ros2pkg/resource/ament_python/__init__.py",
        "ros2pkg/resource/ament_python/init.py.em",
        "ros2pkg/resource/ament_python/main.py.em",
        "ros2pkg/resource/ament_python/py.typed.em",
        "ros2pkg/resource/ament_python/resource_file.em",
        "ros2pkg/resource/ament_python/setup.cfg.em",
        "ros2pkg/resource/ament_python/setup.py.em",
        "ros2pkg/resource/ament_python/test_copyright.py.em",
        "ros2pkg/resource/ament_python/test_flake8.py.em",
        "ros2pkg/resource/ament_python/test_mypy.py.em",
        "ros2pkg/resource/ament_python/test_pep257.py.em",
        "ros2pkg/resource/ament_python/test_xmllint.py.em",
        "ros2pkg/resource/cmake/CMakeLists.txt.em",
        "ros2pkg/resource/cmake/Config.cmake.in.em",
        "ros2pkg/resource/cmake/ConfigVersion.cmake.in.em",
        "ros2pkg/resource/cmake/__init__.py",
        "ros2pkg/resource/cpp/__init__.py",
        "ros2pkg/resource/cpp/header.hpp.em",
        "ros2pkg/resource/cpp/library.cpp.em",
        "ros2pkg/resource/cpp/main.cpp.em",
        "ros2pkg/resource/cpp/visibility_control.h.em",
        "ros2pkg/resource/package_environment/__init__.py",
        "ros2pkg/resource/package_environment/package.xml.em",
        "ros2pkg/resource/rust/__init__.py",
        "ros2pkg/resource/rust/main.rs.em",
        "ros2pkg/verb/__init__.py",
        "ros2pkg/verb/create.py",
        "ros2pkg/verb/executables.py",
        "ros2pkg/verb/list.py",
        "ros2pkg/verb/prefix.py",
        "ros2pkg/verb/xml.py",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
    "xmllint",
]]

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":ros2pkg"] + [
        "ros2pkg/py.typed",
        "ros2pkg/resource/ament_cargo/Cargo.toml.em",
        "ros2pkg/resource/ament_cmake/CMakeLists.txt.em",
        "ros2pkg/resource/ament_python/init.py.em",
        "ros2pkg/resource/ament_python/main.py.em",
        "ros2pkg/resource/ament_python/py.typed.em",
        "ros2pkg/resource/ament_python/resource_file.em",
        "ros2pkg/resource/ament_python/setup.cfg.em",
        "ros2pkg/resource/ament_python/setup.py.em",
        "ros2pkg/resource/ament_python/test_copyright.py.em",
        "ros2pkg/resource/ament_python/test_flake8.py.em",
        "ros2pkg/resource/ament_python/test_mypy.py.em",
        "ros2pkg/resource/ament_python/test_pep257.py.em",
        "ros2pkg/resource/ament_python/test_xmllint.py.em",
        "ros2pkg/resource/cmake/CMakeLists.txt.em",
        "ros2pkg/resource/cmake/Config.cmake.in.em",
        "ros2pkg/resource/cmake/ConfigVersion.cmake.in.em",
        "ros2pkg/resource/cpp/header.hpp.em",
        "ros2pkg/resource/cpp/library.cpp.em",
        "ros2pkg/resource/cpp/main.cpp.em",
        "ros2pkg/resource/cpp/visibility_control.h.em",
        "ros2pkg/resource/package_environment/package.xml.em",
        "ros2pkg/resource/rust/main.rs.em",
    ],
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@launch//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@ros2cli//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
