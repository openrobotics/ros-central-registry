load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "microstrain_inertial_rqt",
    srcs = [
        "microstrain_inertial_rqt_common/src/microstrain_inertial_rqt/__init__.py",
        "microstrain_inertial_rqt_common/src/microstrain_inertial_rqt/filter_data.py",
        "microstrain_inertial_rqt_common/src/microstrain_inertial_rqt/gnss_data.py",
        "microstrain_inertial_rqt_common/src/microstrain_inertial_rqt/gq7_led.py",
        "microstrain_inertial_rqt_common/src/microstrain_inertial_rqt/quickview.py",
        "microstrain_inertial_rqt_common/src/microstrain_inertial_rqt/rtk_status.py",
        "microstrain_inertial_rqt_common/src/microstrain_inertial_rqt/sensor_data.py",
        "microstrain_inertial_rqt_common/src/microstrain_inertial_rqt/utils/__init__.py",
        "microstrain_inertial_rqt_common/src/microstrain_inertial_rqt/utils/common.py",
        "microstrain_inertial_rqt_common/src/microstrain_inertial_rqt/utils/constants.py",
        "microstrain_inertial_rqt_common/src/microstrain_inertial_rqt/utils/services.py",
        "microstrain_inertial_rqt_common/src/microstrain_inertial_rqt/utils/subscribers.py",
        "microstrain_inertial_rqt_common/src/microstrain_inertial_rqt/utils/widgets.py",
    ],
    imports = ["microstrain_inertial_rqt_common/src"],
    deps = [
        "@geometry_msgs//:py",
        "@nav_msgs//:py",
        "@rclpy",
        "@rqt_gui",
        "@rqt_gui_py",
        "@std_msgs//:py",
    ],
)

ament_package(
    name = "ament_package",
    data = [
        "microstrain_inertial_rqt_common/plugin.xml",
        "//launch:launch_files",
    ] + [
        "microstrain_inertial_rqt_common/resource/DeviceSelector.ui",
        "microstrain_inertial_rqt_common/resource/FilterData.ui",
        "microstrain_inertial_rqt_common/resource/GNSSData.ui",
        "microstrain_inertial_rqt_common/resource/GQ7LED.ui",
        "microstrain_inertial_rqt_common/resource/RTKStatus.ui",
        "microstrain_inertial_rqt_common/resource/SensorData.ui",
        "microstrain_inertial_rqt_common/resource/icons/icon-blue-checked.png",
        "microstrain_inertial_rqt_common/resource/icons/icon-blue-unchecked.png",
        "microstrain_inertial_rqt_common/resource/icons/icon-green-checked.png",
        "microstrain_inertial_rqt_common/resource/icons/icon-green-unchecked.png",
        "microstrain_inertial_rqt_common/resource/icons/icon-grey-checked.png",
        "microstrain_inertial_rqt_common/resource/icons/icon-grey-unchecked.png",
        "microstrain_inertial_rqt_common/resource/icons/icon-red-checked.png",
        "microstrain_inertial_rqt_common/resource/icons/icon-red-unchecked.png",
        "microstrain_inertial_rqt_common/resource/icons/icon-teal-checked.png",
        "microstrain_inertial_rqt_common/resource/icons/icon-teal-unchecked.png",
        "microstrain_inertial_rqt_common/resource/icons/icon-yellow-checked.png",
        "microstrain_inertial_rqt_common/resource/icons/icon-yellow-unchecked.png",
        "microstrain_inertial_rqt_common/resource/quickview.perspective",
    ],
    package_xml = "package.xml",
    python = [":microstrain_inertial_rqt"],
    python_strip_prefix = "microstrain_inertial_rqt_common/src",
    setup_cfg = "setup.cfg",
    deps = [
        "@geometry_msgs//:ament_package",
        "@microstrain_inertial_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
