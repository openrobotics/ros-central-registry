load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

py_library(
    name = "microstrain_inertial_rqt",
    srcs = glob(["microstrain_inertial_rqt_common/src/microstrain_inertial_rqt/**/*.py"]),
    imports = ["microstrain_inertial_rqt_common/src"],
    deps = [
        "@geometry_msgs//:py",
        "@nav_msgs//:py",
        "@rclpy",
        "@rqt_gui",
        "@rqt_gui_py",
        "@std_msgs//:py",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = [
        "launch/quickview_launch.py",
        "microstrain_inertial_rqt_common/plugin.xml",
    ] + glob(["microstrain_inertial_rqt_common/resource/**"]),
    package_xml = "package.xml",
    python = [":microstrain_inertial_rqt"],
    python_strip_prefix = "microstrain_inertial_rqt_common/src",
    deps = [
        "@geometry_msgs//:ament_package",
        "@microstrain_inertial_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
