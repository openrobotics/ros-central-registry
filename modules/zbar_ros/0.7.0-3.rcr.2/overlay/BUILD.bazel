load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:zbar": "@rosdistro//cc:zbar_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
    "@zbar_ros_interfaces//:cc",
]

cc_library(
    name = "barcode_reader_node_library",
    srcs = ["src/barcode_reader_node.cpp"],
    hdrs = ["include/zbar_ros/barcode_reader_node.hpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/zbar_ros",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "barcode_reader_node",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":barcode_reader_node_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":barcode_reader_node"],
)

cc_binary(
    name = "barcode_reader",
    srcs = ["src/barcode_reader_main.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/zbar_ros",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":barcode_reader_node_library"],
)

ament_index(
    name = "ament_index",
    lib_data = [":barcode_reader"],
    libraries = [":barcode_reader_node"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@rclcpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@zbar_ros_interfaces//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = ["include/zbar_ros/barcode_reader_node.hpp"],
    include_prefix = "",
    libraries = [":barcode_reader_node"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@rclcpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@zbar_ros_interfaces//:ament_package",
    ],
)
