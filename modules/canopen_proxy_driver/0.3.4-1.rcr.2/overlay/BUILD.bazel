load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/canopen_proxy_driver/lifecycle_proxy_driver.hpp",
    "include/canopen_proxy_driver/node_interfaces/node_canopen_proxy_driver.hpp",
    "include/canopen_proxy_driver/node_interfaces/node_canopen_proxy_driver_impl.hpp",
    "include/canopen_proxy_driver/proxy_driver.hpp",
    "include/canopen_proxy_driver/visibility_control.h",
]

# Map of shared library (key) to its static library (value).
DEPENDENCIES = {
    "@canopen_base_driver//:lely_driver_bridge": "@canopen_base_driver//:lely_driver_bridge_library",
    "@canopen_base_driver//:node_canopen_base_driver": "@canopen_base_driver//:node_canopen_base_driver_library",
    "@canopen_core//:node_canopen_driver": "@canopen_core//:node_canopen_driver_library",
    "@canopen_interfaces//:cc_shared": "@canopen_interfaces//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
}

CC_DEPS = [
]

COPTS = [
    "-Wno-missing-template-arg-list-after-template-kw",
]

cc_library(
    name = "node_canopen_proxy_driver_library",
    srcs = ["src/node_interfaces/node_canopen_proxy_driver.cpp"],
    hdrs = HEADERS,
    copts = COPTS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "node_canopen_proxy_driver",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":node_canopen_proxy_driver_library"],
)

cc_library(
    name = "lifecycle_proxy_driver_library",
    srcs = ["src/lifecycle_proxy_driver.cpp"],
    hdrs = HEADERS,
    copts = COPTS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["CANOPEN_PROXY_DRIVER_BUILDING_LIBRARY"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":node_canopen_proxy_driver_library"],
    alwayslink = True,
)

cc_shared_library(
    name = "lifecycle_proxy_driver",
    dynamic_deps = DEPENDENCIES.keys() + [":node_canopen_proxy_driver"],
    exports_filter = ["//:__subpackages__"],
    deps = [":lifecycle_proxy_driver_library"],
)

cc_library(
    name = "proxy_driver_library",
    srcs = ["src/proxy_driver.cpp"],
    hdrs = HEADERS,
    copts = COPTS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["CANOPEN_proxy_DRIVER_BUILDING_LIBRARY"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":node_canopen_proxy_driver_library"],
    alwayslink = True,
)

cc_shared_library(
    name = "proxy_driver",
    dynamic_deps = DEPENDENCIES.keys() + [":node_canopen_proxy_driver"],
    exports_filter = ["//:__subpackages__"],
    deps = [":proxy_driver_library"],
)

rclcpp_components_register_nodes(
    name = "lifecycle_proxy_driver_components",
    component = ":lifecycle_proxy_driver",
    plugins = ["ros2_canopen::LifecycleProxyDriver"],
)

rclcpp_components_register_nodes(
    name = "proxy_driver_components",
    component = ":proxy_driver",
    plugins = ["ros2_canopen::ProxyDriver"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":node_canopen_proxy_driver",
        "@canopen_core//:device_container",
        "@canopen_core//:node_canopen_master",
        "@rclcpp_components//:component_manager",
    ],
)

ament_index(
    name = "ament_index",
    components = [
        ":lifecycle_proxy_driver_components",
        ":proxy_driver_components",
    ],
    libraries = [
        ":node_canopen_proxy_driver",
        ":lifecycle_proxy_driver",
        ":proxy_driver",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@canopen_base_driver//:ament_package",
        "@canopen_core//:ament_package",
        "@canopen_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "canopen_base_driver",
        "canopen_core",
        "canopen_interfaces",
        "rclcpp",
        "rclcpp_components",
        "rclcpp_lifecycle",
    ],
    cmake_export_name = "export_canopen_proxy_driver",
    headers = HEADERS,
    include_prefix = "",
    libraries = [
        ":node_canopen_proxy_driver",
        ":lifecycle_proxy_driver",
        ":proxy_driver",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@canopen_base_driver//:ament_package",
        "@canopen_core//:ament_package",
        "@canopen_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
    ],
)
