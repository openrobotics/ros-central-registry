load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

TEST_DEPS = [
    "@canopen_base_driver//:lely_driver_bridge_library",
    "@canopen_base_driver//:node_canopen_base_driver_library",
    "@canopen_core//:device_container_library",
    "@canopen_core//:node_canopen_master_library",
    "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:bazel_test_helper",
    "@rosdistro//cc:googletest",
]

cc_test(
    name = "test_driver_component",
    srcs = ["test_driver_component.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "CMakeLists.txt",
        "master.dcf",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines() + ["GTEST_HAS_PTHREAD=1"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = TEST_DEPS,
)

cc_test(
    name = "test_node_interface",
    srcs = ["test_node_interface.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "CMakeLists.txt",
        "master.dcf",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines() + ["GTEST_HAS_PTHREAD=1"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = TEST_DEPS + ["//:node_canopen_proxy_driver_library"],
)
