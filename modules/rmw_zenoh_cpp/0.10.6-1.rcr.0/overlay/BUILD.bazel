load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_resource")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### AMENT INDEX

register_ament_resource(
    name = "res_rmw_typesupport",
    category = "rmw_typesupport",
    content = "rosidl_typesupport_introspection_c;rosidl_typesupport_introspection_cpp\n",
)

register_ament_resource(
    name = "res_rmw_typesupport_c",
    category = "rmw_typesupport_c",
    content = "rosidl_typesupport_introspection_c\n",
)

register_ament_resource(
    name = "res_rmw_typesupport_cpp",
    category = "rmw_typesupport_cpp",
    content = "rosidl_typesupport_introspection_cpp\n",
)

ament_index(
    name = "ament_index",
    data = glob(["config/**"]),
    package_xml = "package.xml",
    deps = [
        ":res_rmw_typesupport",
        ":res_rmw_typesupport_c",
        ":res_rmw_typesupport_cpp",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosdistro//cc:fastcdr": "@rosdistro//cc:fastcdr_library",
    "@rosdistro//cc:zenoh-cpp": "@rosdistro//cc:zenoh-cpp_library",
    "@rosidl_buffer_backend_registry//:rosidl_buffer_backend_registry": "@rosidl_buffer_backend_registry//:rosidl_buffer_backend_registry_library",
    "@rosidl_typesupport_fastrtps_c//:rosidl_typesupport_fastrtps_c": "@rosidl_typesupport_fastrtps_c//:rosidl_typesupport_fastrtps_c_library",
    "@rosidl_typesupport_fastrtps_cpp//:rosidl_typesupport_fastrtps_cpp": "@rosidl_typesupport_fastrtps_cpp//:rosidl_typesupport_fastrtps_cpp_library",
    "@tracetools//:tracetools": "@tracetools//:tracetools_library",
}

cc_library(
    name = "rmw_zenoh_cpp_library",
    srcs = glob(
        [
            "src/**/*.cpp",
            "src/**/*.hpp",
        ],
        exclude = [
            "src/rmw_test_fixture.cpp",
            "src/zenohd/**",
        ],
    ),
    hdrs = HEADERS,
    data = [":ament_index"],
    includes = [
        "include",
        "src",
        "src/detail",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        # Header-only.
        "@rosdistro//cc:nlohmann_json",
    ],
)

cc_shared_library(
    name = "rmw_zenoh_cpp",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rmw_zenoh_cpp_library"],
    deps = [":rmw_zenoh_cpp_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rmw_zenoh_cpp"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "rmw_zenoh_cpp_test_fixture_library",
    srcs = glob(["src/detail/*.hpp"]) + [
        "src/detail/logging.cpp",
        "src/detail/zenoh_config.cpp",
        "src/rmw_test_fixture.cpp",
    ],
    hdrs = HEADERS,
    includes = [
        "include",
        "src",
        "src/detail",
    ],
    local_defines = ros_local_defines() + ["RMW_TEST_FIXTURE_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + [
        "@rmw_test_fixture//:rmw_test_fixture_library",
        "@rosdistro//cc:nlohmann_json",
    ],
)

cc_shared_library(
    name = "rmw_zenoh_cpp_test_fixture",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rmw_zenoh_cpp_test_fixture_library"],
    deps = [":rmw_zenoh_cpp_test_fixture_library"],
)

### BINARIES

cc_binary(
    name = "rmw_zenohd",
    srcs = glob(["src/**/*.hpp"]) + [
        "src/detail/liveliness_utils.cpp",
        "src/detail/logging.cpp",
        "src/detail/qos.cpp",
        "src/detail/simplified_xxhash3.cpp",
        "src/detail/zenoh_config.cpp",
        "src/zenohd/main.cpp",
    ],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

# ament_index_register_resource() registrations, as ament_cmake installs them.

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_rmw_zenoh_cpp",
    data = glob(["config/**"]),
    executables = [":rmw_zenohd"],
    headers = HEADERS,
    include_prefix = "",
    libraries = [
        ":rmw_zenoh_cpp",
        ":rmw_zenoh_cpp_test_fixture",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rmw_test_fixture//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_buffer_backend_registry//:ament_package",
        "@rosidl_typesupport_fastrtps_c//:ament_package",
        "@rosidl_typesupport_fastrtps_cpp//:ament_package",
        "@tracetools//:ament_package",
        "@zenoh_cpp_vendor//:ament_package",
    ],
)
