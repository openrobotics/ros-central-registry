load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

DEPENDENCIES = {
    "@rosidl_buffer//:rosidl_buffer": "@rosidl_buffer//:rosidl_buffer_library",
}

cc_library(
    name = "rcl_buffer_py_bindings_library",
    srcs = glob(["src/**/*.cpp"]),
    includes = ["."],
    visibility = ["//visibility:private"],
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:pybind11",
    ],
)

cc_shared_library(
    name = "rcl_buffer_py_bindings",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rcl_buffer_py_bindings_library"],
    shared_lib_name = "rosidl_buffer/_rosidl_buffer_py.so",
    user_link_flags = select({
        "@platforms//os:osx": [
            "-undefined",
            "dynamic_lookup",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
    deps = [":rcl_buffer_py_bindings_library"],
)

### PYTHON MODULES

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rcl_buffer_py_bindings"],
    visibility = ["//visibility:private"],
)

py_library(
    name = "rosidl_buffer_py",
    srcs = glob(["rosidl_buffer/**/*.py"]),
    data = [":rcl_buffer_py_bindings"],
    imports = ["."],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_buffer//:ament_package",
    ],
)
