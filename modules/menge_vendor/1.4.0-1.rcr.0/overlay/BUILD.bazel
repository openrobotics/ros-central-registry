load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

# Upstream (CMakeLists.txt) builds a single shared library from
# src/Menge/MengeCore/**/*.cpp, linked against tinyxml (v1) and libdl.
# TODO: tinyxml (v1, <tinyxml.h>) is not yet available from @rosdistro//cc.

MENGE_CORE_HDRS = glob([
    "src/Menge/MengeCore/**/*.h",
    "src/include/**/*.h",
])

cc_library(
    name = "menge_vendor_library",
    srcs = glob(["src/Menge/MengeCore/**/*.cpp"]),
    hdrs = MENGE_CORE_HDRS,
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
        # Upstream is written against C++11 and still uses dynamic exception
        # specifications (throw(...)), which are ill-formed in C++17.
        "-Wno-dynamic-exception-spec",
    ],
    includes = [
        "src",
        "src/Menge",
        "src/include",
    ],
    linkopts = ["-ldl"],
    local_defines = ros_local_defines(),
)

cc_shared_library(
    name = "menge_vendor",
    deps = [":menge_vendor_library"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":menge_vendor",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    headers = MENGE_CORE_HDRS,
    headers_strip_prefixes = [
        "src/Menge",
        "src/include",
    ],
    include_prefix = "",
    libraries = [
        ":menge_vendor",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
    ],
)
