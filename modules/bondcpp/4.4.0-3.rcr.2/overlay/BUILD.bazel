load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
}

cc_library(
    name = "bondcpp_library",
    srcs = [
        "src/BondSM_sm.cpp",
        "src/bond.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["BONDCPP_BUILDING_LIBRARY"],
    deps = DEPENDENCIES.values() + [
        "@bond//:cc",
        "@smclib//:smclib_header",
    ],
)

cc_shared_library(
    name = "bondcpp",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":bondcpp_library"],
    deps = [":bondcpp_library"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "bond",
        "rclcpp",
        "rclcpp_lifecycle",
        "smclib",
    ],
    headers = HEADERS,
    libraries = [":bondcpp"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@bond//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rosdistro//:ament_package",
        "@smclib//:ament_package",
    ],
)
