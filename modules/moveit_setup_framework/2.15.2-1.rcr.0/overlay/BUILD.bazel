cc_library(
    name = "moveit_setup_framework_library",
    srcs = [":gen_moveit_setup_framework_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/moveit_setup_framework",
    ],
    local_defines = ros_local_defines() + [
        "NDEBUG",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "moveit_setup_framework",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":moveit_setup_framework_library"],
)

write_file(
    name = "gen_moveit_setup_framework_stub_cpp",
    out = "_gen/moveit_setup_framework_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    data = [
        "templates/CMakeLists.txt",
        "templates/config/pilz_cartesian_limits.yaml",
        "templates/package.xml.template",
    ],
    libraries = [":moveit_setup_framework"],
    package_xml = "package.xml",
    plugins = ["moveit_setup_framework_plugins.xml"],
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@moveit_common//:ament_package",
        "@moveit_core//:ament_package",
        "@moveit_ros_planning//:ament_package",
        "@moveit_ros_visualization//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_rendering//:ament_package",
        "@srdfdom//:ament_package",
        "@urdf//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "fmt",
        "rclcpp",
        "Qt6Core",
        "Qt6Widgets",
        "moveit_common",
        "moveit_core",
        "moveit_ros_planning",
        "moveit_ros_visualization",
        "rviz_common",
        "rviz_rendering",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    libraries = [":moveit_setup_framework"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@moveit_common//:ament_package",
        "@moveit_core//:ament_package",
