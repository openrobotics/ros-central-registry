load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

# Upstream links every app against the same set of ecl libraries.
DEPENDENCIES = {
    "@ecl_devices//:ecl_devices": "@ecl_devices//:ecl_devices_library",
    "@ecl_errors//:ecl_errors": "@ecl_errors//:ecl_errors_library",
    "@ecl_exceptions//:ecl_exceptions": "@ecl_exceptions//:ecl_exceptions_library",
    "@ecl_formatters//:ecl_formatters": "@ecl_formatters//:ecl_formatters_library",
    "@ecl_geometry//:ecl_geometry": "@ecl_geometry//:ecl_geometry_library",
    "@ecl_ipc//:ecl_ipc": "@ecl_ipc//:ecl_ipc_library",
    "@ecl_linear_algebra//:ecl_linear_algebra": "@ecl_linear_algebra//:ecl_linear_algebra_library",
    "@ecl_streams//:ecl_streams": "@ecl_streams//:ecl_streams_library",
    "@ecl_threads//:ecl_threads": "@ecl_threads//:ecl_threads_library",
    "@ecl_time_lite//:ecl_time_lite": "@ecl_time_lite//:ecl_time_lite_library",
    "@ecl_type_traits//:ecl_type_traits": "@ecl_type_traits//:ecl_type_traits_library",
}

CC_DEPS = [
    "@ecl_command_line",
    "@ecl_config",
    "@ecl_containers//:ecl_containers_library",
    "@ecl_converters//:ecl_converters_library",
    "@ecl_sigslots//:ecl_sigslots_library",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

# Benchmarks (installed to bin/) and utilities (ecl_add_utility installs to
# lib/<pkg>/, ecl_add_global_utility to bin/). eigen_sparse is commented out
# upstream.
cc_binary(
    name = "ecl_bench_containers",
    srcs = ["src/benchmarks/containers.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

