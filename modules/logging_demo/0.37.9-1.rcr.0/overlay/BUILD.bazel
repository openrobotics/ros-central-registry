load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

default_generators(
    package_xml = "package.xml",
    deps = [
        "//srv:ConfigLogger",
    ],
)

cc_library(
    name = "logger_config_component_library",
    srcs = ["src/logger_config_component.cpp"],
    hdrs = glob(
        [
            "include/**/*.hpp",
            "include/**/*.h",
        ],
        allow_empty = True,
    ),
    includes = ["include"],
    local_defines = ros_local_defines() + ["LOGGING_DEMO_BUILDING_DLL"],
    deps = [
        ":cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
    ],
)

cc_shared_library(
    name = "logger_config_component",
    dynamic_deps = [
        "@rclcpp",
        "@rclcpp_components",
    ],
    exports_filter = [":logger_config_component_library"],
    deps = [":logger_config_component_library"],
)

rclcpp_components_register_node(
    name = "node_logger_config",
    component = ":logger_config_component",
    executor = "SingleThreadedExecutor",
    node_name = "logger_config_node",
    plugin = "logging_demo::LoggerConfig",
)

cc_library(
    name = "logger_usage_component_library",
    srcs = ["src/logger_usage_component.cpp"],
    hdrs = glob(
        [
            "include/**/*.hpp",
            "include/**/*.h",
        ],
        allow_empty = True,
    ),
    includes = ["include"],
    local_defines = ros_local_defines() + ["LOGGING_DEMO_BUILDING_DLL"],
    deps = [
        "@example_interfaces//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
    ],
)

cc_shared_library(
    name = "logger_usage_component",
    dynamic_deps = [
        "@rclcpp",
        "@rclcpp_components",
    ],
    exports_filter = [":logger_usage_component_library"],
    deps = [":logger_usage_component_library"],
)

rclcpp_components_register_node(
    name = "node_logger_usage",
    component = ":logger_usage_component",
    executor = "SingleThreadedExecutor",
    node_name = "logger_usage_node",
    plugin = "logging_demo::LoggerUsage",
)

cc_binary(
    name = "logging_demo_main",
    srcs = ["src/logging_demo_main.cpp"],
    local_defines = ros_local_defines(),
    deps = [
        ":logger_config_component_library",
        ":logger_usage_component_library",
        "@rclcpp//:rclcpp_library",
    ],
)

### TESTS

write_file(
    name = "rmw_test_fixture_implementation_py",
    out = "rmw_test_fixture_implementation.py",
    content = [
        "def rmw_test_isolation_start(): pass",
        "def rmw_test_isolation_stop(): pass",
    ],
)

py_library(
    name = "rmw_test_fixture_implementation",
    srcs = [":rmw_test_fixture_implementation_py"],
    imports = ["."],
    visibility = ["//visibility:private"],
)

cmake_configure_file(
    name = "test_logging_demo_py",
    src = "test/test_logging_demo.py.in",
    out = "test_logging_demo.py",
    defines = [
        "EXPECTED_OUTPUT_LOGGING_DEMO_MAIN_DEBUG_SEVERITY=../logging_demo+/test/logging_demo_main_debug_severity",
        "EXPECTED_OUTPUT_LOGGING_DEMO_MAIN_DEFAULT_SEVERITY=../logging_demo+/test/logging_demo_main_default_severity",
        "LOGGING_DEMO_MAIN_EXECUTABLE=../logging_demo+/logging_demo_main",
        "rmw_implementation=rmw_fastrtps_cpp",
    ],
)

py_pytest(
    name = "test_logging_demo",
    srcs = ["test_logging_demo_py"],
    args = [
        "-p",
        "launch_testing.pytest.hooks",
        "-p",
        "launch_testing_ros_pytest_entrypoint",
    ],
    data = [
        "test/logging_demo_main_debug_severity.txt",
        "test/logging_demo_main_default_severity.txt",
        ":logging_demo_main",
    ],
    deps = [
        ":rmw_test_fixture_implementation",
        "@launch",
        "@launch_testing",
        "@launch_testing_ros",
        "@rules_python//python/runfiles",
    ],
)

### PACKAGING

rosidl_ament_package(
    name = "ament_package",
    components = [
        ":node_logger_config_record",
        ":node_logger_usage_record",
    ],
    executables = [":logging_demo_main"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@example_interfaces//:ament_package",
        "@launch//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rcutils//:ament_package",
        "@rmw_implementation_cmake//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
    ],
)
