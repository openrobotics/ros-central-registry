load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

### LIBRARIES

HEADERS = glob(["include/aruco/**/*.h"])

DEPENDENCIES = {
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
}

cc_library(
    name = "aruco_library",
    srcs = glob(["src/aruco/**/*.cpp"]),
    hdrs = HEADERS,
    # Upstream exports include/aruco (headers are included unqualified,
    # e.g. "marker.h") and installs them under include/aruco/.
    includes = [
        "include",
        "include/aruco",
    ],
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:eigen",
    ],
)

cc_shared_library(
    name = "aruco",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":aruco_library"],
    deps = [":aruco_library"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    cmake_export_targets = False,
    headers = HEADERS,
    include_prefix = "",
    libraries = [":aruco"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@cv_bridge//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
