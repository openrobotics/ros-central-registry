load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### DATA

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

### C++ LIBRARIES

cc_library(
    name = "inverse_dynamics_solver",
    hdrs = glob(["include/**/*.hpp"]),
    data = [":ament_index"],
    includes = ["include"],
    deps = [
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:eigen",
    ],
)

cc_binary(
    name = "evaluate_solver",
    srcs = ["demo/evaluate_solver.cpp"],
    deps = [
        ":inverse_dynamics_solver",
        "@pluginlib//:pluginlib_library",
        "@rclcpp//:rclcpp_library",
        "@rosbag2_cpp//:rosbag2_cpp_library",
        "@sensor_msgs//:cc",
        "@urdf//:urdf_library",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_storage_default_plugins//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@urdf//:ament_package",
    ],
)
