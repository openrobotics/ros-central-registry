write_file(
    name = "aruco_compat_hdr",
    out = "compat_include/opencv2/aruco.hpp",
    content = [
        "#ifndef OPENCV_ARUCO_COMPAT_HPP_",
        "#define OPENCV_ARUCO_COMPAT_HPP_",
        "#include <vector>",
        "#include <opencv2/calib3d.hpp>",
        "#include <opencv2/core.hpp>",
        "#include <opencv2/objdetect/aruco_detector.hpp>",
        "namespace cv {",
        "namespace aruco {",
        "inline void detectMarkers(",
        "  InputArray image,",
        "  const Ptr<Dictionary> & dictionary,",
        "  OutputArrayOfArrays corners,",
        "  OutputArray ids)",
        "{",
        "  ArucoDetector detector(*dictionary);",
        "  detector.detectMarkers(image, corners, ids);",
        "}",
        "inline void estimatePoseSingleMarkers(",
        "  InputArrayOfArrays _corners,",
        "  float markerLength,",
        "  InputArray _cameraMatrix,",
        "  InputArray _distCoeffs,",
        "  OutputArray _rvecs,",
        "  OutputArray _tvecs)",
        "{",
        "  Mat markerObjPoints(4, 1, CV_32FC3);",
        "  markerObjPoints.ptr<Vec3f>(0)[0] = Vec3f(-markerLength / 2.f, markerLength / 2.f, 0);",
        "  markerObjPoints.ptr<Vec3f>(0)[1] = Vec3f(markerLength / 2.f, markerLength / 2.f, 0);",
        "  markerObjPoints.ptr<Vec3f>(0)[2] = Vec3f(markerLength / 2.f, -markerLength / 2.f, 0);",
        "  markerObjPoints.ptr<Vec3f>(0)[3] = Vec3f(-markerLength / 2.f, -markerLength / 2.f, 0);",
        "  int nMarkers = static_cast<int>(_corners.total());",
        "  _rvecs.create(nMarkers, 1, CV_64FC3);",
        "  _tvecs.create(nMarkers, 1, CV_64FC3);",
        "  Mat rvecs = _rvecs.getMat();",
        "  Mat tvecs = _tvecs.getMat();",
        "  for (int i = 0; i < nMarkers; i++) {",
        "    solvePnP(",
        "      markerObjPoints, _corners.getMat(i), _cameraMatrix, _distCoeffs,",
        "      rvecs.at<Vec3d>(i), tvecs.at<Vec3d>(i));",
        "  }",
        "}",
        "}  // namespace aruco",
        "}  // namespace cv",
        "#endif  // OPENCV_ARUCO_COMPAT_HPP_",
        "",
    ],
)

cc_library(
