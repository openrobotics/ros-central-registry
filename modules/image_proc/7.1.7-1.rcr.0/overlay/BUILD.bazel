load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = [
    "include/image_proc/crop_decimate.hpp",
    "include/image_proc/crop_non_zero.hpp",
    "include/image_proc/debayer.hpp",
    "include/image_proc/edge_aware.hpp",
    "include/image_proc/processor.hpp",
    "include/image_proc/rectify.hpp",
    "include/image_proc/resize.hpp",
    "include/image_proc/track_marker.hpp",
    "include/image_proc/utils.hpp",
]

DEPENDENCIES = {
    "@camera_calibration_parsers//:camera_calibration_parsers": "@camera_calibration_parsers//:camera_calibration_parsers_library",
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@image_geometry//:image_geometry": "@image_geometry//:image_geometry_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:opencv_contrib_aruco": "@rosdistro//cc:opencv_contrib_aruco_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tracetools_image_pipeline//:tracetools_image_pipeline": "@tracetools_image_pipeline//:tracetools_image_pipeline_library",
}

cc_library(
    name = "image_proc_library",
    srcs = ["src/image_proc/processor.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "image_proc",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":image_proc_library"],
)

cc_library(
    name = "rectify_library",
    srcs = ["src/rectify.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["COMPOSITION_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + [
        ":image_proc_library",
    ],
)

cc_shared_library(
    name = "rectify",
    dynamic_deps = DEPENDENCIES.keys() + [":image_proc"],
    exports_filter = ["//:__subpackages__"],
    deps = [":rectify_library"],
)

cc_library(
    name = "debayer_library",
    srcs = [
        "src/debayer.cpp",
        "src/edge_aware.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["COMPOSITION_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + [
        ":image_proc_library",
    ],
)

cc_shared_library(
    name = "debayer",
    dynamic_deps = DEPENDENCIES.keys() + [":image_proc"],
    exports_filter = ["//:__subpackages__"],
    deps = [":debayer_library"],
)

cc_library(
    name = "resize_library",
    srcs = ["src/resize.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["COMPOSITION_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + [
        ":image_proc_library",
    ],
)

cc_shared_library(
    name = "resize",
    dynamic_deps = DEPENDENCIES.keys() + [":image_proc"],
    exports_filter = ["//:__subpackages__"],
    deps = [":resize_library"],
)

cc_library(
    name = "crop_decimate_library",
    srcs = ["src/crop_decimate.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["COMPOSITION_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + [
        ":image_proc_library",
    ],
)

cc_shared_library(
    name = "crop_decimate",
    dynamic_deps = DEPENDENCIES.keys() + [":image_proc"],
    exports_filter = ["//:__subpackages__"],
    deps = [":crop_decimate_library"],
)

cc_library(
    name = "crop_non_zero_library",
    srcs = ["src/crop_non_zero.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["COMPOSITION_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + [
        ":image_proc_library",
    ],
)

cc_shared_library(
    name = "crop_non_zero",
    dynamic_deps = DEPENDENCIES.keys() + [":image_proc"],
    exports_filter = ["//:__subpackages__"],
    deps = [":crop_non_zero_library"],
)

cc_library(
    name = "track_marker_library",
    srcs = [
        "src/track_marker.cpp",
    ],
    hdrs = HEADERS,
    includes = [
        "include",
    ],
    local_defines = ros_local_defines() + ["COMPOSITION_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + [
        ":image_proc_library",
    ],
)

cc_shared_library(
    name = "track_marker",
    dynamic_deps = DEPENDENCIES.keys() + [":image_proc"],
    exports_filter = ["//:__subpackages__"],
    deps = [":track_marker_library"],
)

COMPONENTS = [
    ("rectify_node", ":rectify", "image_proc::RectifyNode"),
    ("debayer_node", ":debayer", "image_proc::DebayerNode"),
    ("resize_node", ":resize", "image_proc::ResizeNode"),
    ("crop_decimate_node", ":crop_decimate", "image_proc::CropDecimateNode"),
    ("crop_non_zero_node", ":crop_non_zero", "image_proc::CropNonZeroNode"),
    ("track_marker_node", ":track_marker", "image_proc::TrackMarkerNode"),
]

[rclcpp_components_register_node(
    name = node_name,
    component = comp,
    data = [":ament_index"],
    node_name = node_name,
    plugin = plugin,
) for node_name, comp, plugin in COMPONENTS]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":image_proc",
        ":rectify",
        ":debayer",
        ":resize",
        ":crop_decimate",
        ":crop_non_zero",
        ":track_marker",
    ],
)

ament_index(
    name = "ament_index",
    components = [":{}_record".format(node_name) for node_name, _, _ in COMPONENTS],
    data = ["//launch:launch_files"],
    libraries = [
        ":image_proc",
        ":rectify",
        ":debayer",
        ":resize",
        ":crop_decimate",
        ":crop_non_zero",
        ":track_marker",
    ],
    package_xml = "package.xml",
    deps = [
        "@image_transport//:ament_index",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_targets = False,
    executables = [":{}".format(node_name) for node_name, _, _ in COMPONENTS],
    headers = HEADERS,
    libraries = [
        ":image_proc",
        ":rectify",
        ":debayer",
        ":resize",
        ":crop_decimate",
        ":crop_non_zero",
        ":track_marker",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@camera_calibration_parsers//:ament_package",
        "@cv_bridge//:ament_package",
        "@geometry_msgs//:ament_package",
        "@image_geometry//:ament_package",
        "@image_transport//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tracetools_image_pipeline//:ament_package",
    ],
)
