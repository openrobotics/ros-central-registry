load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:static_transform_broadcaster_node": "@tf2_ros//:static_transform_broadcaster_node_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@mbf_msgs//:cc",
    "@nav_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "mbf_utility_library",
    srcs = [
        "src/navigation_utility.cpp",
        "src/odometry_helper.cpp",
        "src/robot_information.cpp",
    ],
    hdrs = [
        "include/mbf_utility/exe_path_exception.h",
        "include/mbf_utility/get_path_exception.h",
        "include/mbf_utility/navigation_utility.h",
        "include/mbf_utility/odometry_helper.h",
        "include/mbf_utility/recovery_exception.h",
        "include/mbf_utility/robot_information.h",
        "include/mbf_utility/types.h",
    ],
    includes = [
        "include",
        "include/mbf_utility",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mbf_utility",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mbf_utility_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":mbf_utility"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mbf_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "geometry_msgs",
        "mbf_msgs",
        "rclcpp",
        "tf2",
        "tf2_ros",
        "tf2_geometry_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    cmake_export_name = "export_mbf_utility",
    headers = [
        "include/mbf_utility/exe_path_exception.h",
        "include/mbf_utility/get_path_exception.h",
        "include/mbf_utility/navigation_utility.h",
        "include/mbf_utility/odometry_helper.h",
        "include/mbf_utility/recovery_exception.h",
        "include/mbf_utility/robot_information.h",
        "include/mbf_utility/types.h",
    ],
    include_prefix = "",
    libraries = [":mbf_utility"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mbf_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
