load("@rosdistro//ament:defs.bzl", "ament_package", "register_ament_resource")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load(":vendor_install.bzl", "vendor_install_tree")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

vendor_install_tree(
    name = "opt_files",
    prefix = "opt/mimick_vendor",
    transitive = False,
    deps = ["@rosdistro//cc:mimick"],
)

[
    genrule(
        name = "vendor_package_" + ext,
        srcs = ["@ament_cmake_vendor_package//:cmake/templates/vendor_package." + ext + ".in"],
        outs = ["environment/vendor_package." + ext],
        cmd = "sed -e 's|@PROJECT_NAME@|mimick_vendor|g' -e 's|@_LIBDIR_VAR_NAME@|LD_LIBRARY_PATH|g' $< > $@",
    )
    for ext in [
        "bat",
        "dsv",
        "sh",
    ]
]

genrule(
    name = "vendor_package_cmake_prefix",
    srcs = ["@ament_cmake_vendor_package//:cmake/templates/vendor_package_cmake_prefix.cmake.in"],
    outs = ["vendor_package_cmake_prefix.cmake"],
    cmd = "sed -e 's|@PROJECT_NAME@|mimick_vendor|g' $< > $@",
)

[
    write_file(
        name = "meta_" + f.replace("-", "_").replace(".", "_"),
        out = "_meta/opt/mimick_vendor/lib/cmake/mimick/" + f,
        content = [""],
    )
    for f in [
        "mimick-targets-noconfig.cmake",
        "mimick-targets.cmake",
        "mimickConfig.cmake",
    ]
]

pkg_files(
    name = "mimick_cmake_files",
    srcs = [
        ":meta_mimickConfig_cmake",
        ":meta_mimick_targets_cmake",
        ":meta_mimick_targets_noconfig_cmake",
    ],
    strip_prefix = strip_prefix.from_pkg("_meta"),
)

### PACKAGING

register_ament_resource(
    name = "res_vendor_packages",
    category = "vendor_packages",
    content = "opt/mimick_vendor\n",
)

ament_package(
    name = "ament_package",
    cmake = [
        ":vendor_package_cmake_prefix",
    ],
    cmake_export_dependencies_list = ["mimick"],
    cmake_extras = ["vendor_package_cmake_prefix.cmake"],
    data = [
        "environment/vendor_package.bat",
        "environment/vendor_package.dsv",
        "environment/vendor_package.sh",
        ":res_vendor_packages",
    ],
    env_hooks = ["environment/vendor_package.dsv"],
    install = [
        ":mimick_cmake_files",
        ":opt_files",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_vendor_package//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
