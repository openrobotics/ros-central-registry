load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
)

DEPENDENCIES = {
    "@mola_imu_preintegration//:mola_imu_preintegration": "@mola_imu_preintegration//:mola_imu_preintegration_library",
    "@mola_kernel//:mola_kernel": "@mola_kernel//:mola_kernel_library",
    "@mola_yaml//:mola_yaml": "@mola_yaml//:mola_yaml_library",
    "@mrpt_obs//:mrpt_obs": "@mrpt_obs//:mrpt_obs_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "mola_state_estimation_simple_library",
    srcs = [
        "src/Parameters.cpp",
        "src/StateEstimationSimple.cpp",
        "src/register.cpp",
    ],
    hdrs = [
        "include/mola_state_estimation_simple/Parameters.h",
        "include/mola_state_estimation_simple/StateEstimationSimple.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/mola_state_estimation_simple",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=3",
        "MOLA_PATCH_VERSION=0",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_state_estimation_simple",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mola_state_estimation_simple_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":mola_state_estimation_simple"],
)

ament_index(
    name = "ament_index",
    libraries = [":mola_state_estimation_simple"],
    package_xml = "package.xml",
    sonames = {"mola_state_estimation_simple": [
        "libmola_state_estimation_simple.so.3.0",
        "libmola_state_estimation_simple.so.3.0.2",
    ]},
    deps = [
        "@mola_common//:ament_package",
        "@mola_imu_preintegration//:ament_package",
        "@mola_kernel//:ament_package",
        "@mola_yaml//:ament_package",
        "@mrpt_obs//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/mola_state_estimation_simple/Parameters.h",
        "include/mola_state_estimation_simple/StateEstimationSimple.h",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [":mola_state_estimation_simple"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@mola_common//:ament_package",
        "@mola_imu_preintegration//:ament_package",
        "@mola_kernel//:ament_package",
        "@mola_yaml//:ament_package",
        "@mrpt_obs//:ament_package",
    ],
)
