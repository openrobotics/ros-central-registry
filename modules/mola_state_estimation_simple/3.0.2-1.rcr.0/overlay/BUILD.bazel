load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@mola_imu_preintegration//:mola_imu_preintegration_library",
    "@mola_kernel//:mola_kernel_library",
    "@mola_yaml//:mola_yaml_library",
    "@mrpt_obs//:mrpt_obs_library",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "mola_state_estimation_simple_library",
    srcs = [
        "src/Parameters.cpp",
        "src/StateEstimationSimple.cpp",
        "src/register.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/mola_state_estimation_simple",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=3",
        "MOLA_PATCH_VERSION=0",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_state_estimation_simple",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mola_state_estimation_simple_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mola_state_estimation_simple",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_state_estimation_simple": [
            "libmola_state_estimation_simple.so.3.0",
            "libmola_state_estimation_simple.so.3.0.2",
        ],
    },
    deps = [
        "@mola_common//:ament_package",
        "@mola_imu_preintegration//:ament_package",
        "@mola_kernel//:ament_package",
        "@mola_yaml//:ament_package",
        "@mrpt_obs//:ament_package",
    ],
)

cc_test(
    name = "run_test-state-estimation-simple",
    srcs = ["tests/test-state-estimation-simple.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        ":ament_index",
    ] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/mola_state_estimation_simple",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=3",
        "MOLA_MODULE_SOURCE_DIR=\\\"tests\\\"",
        "MOLA_PATCH_VERSION=0",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":mola_state_estimation_simple_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mola_state_estimation_simple",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_state_estimation_simple": [
            "libmola_state_estimation_simple.so.3.0",
            "libmola_state_estimation_simple.so.3.0.2",
        ],
    },
    deps = [":ament_index"] + [
        "@mola_common//:ament_package",
        "@mola_imu_preintegration//:ament_package",
        "@mola_kernel//:ament_package",
        "@mola_yaml//:ament_package",
        "@mrpt_obs//:ament_package",
    ],
)
