load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {}

CC_DEPS = [
    "@mola_imu_preintegration//:mola_imu_preintegration_library",
    "@mola_kernel//:mola_kernel_library",
    "@mola_yaml//:mola_yaml_library",
    "@mrpt_obs//:mrpt_obs_library",
    "@rosdistro//cc:eigen",
]

cc_test(
    name = "run_test-state-estimation-simple",
    srcs = ["test-state-estimation-simple.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = ["//:ament_index"] + ["CMakeLists.txt"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines() + [
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=3",
        'MOLA_MODULE_SOURCE_DIR=\\"tests\\"',
        "MOLA_PATCH_VERSION=0",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:mola_state_estimation_simple_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
