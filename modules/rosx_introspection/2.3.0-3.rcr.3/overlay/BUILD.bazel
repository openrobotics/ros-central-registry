load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

HEADERS = [
    "include/rosx_introspection/builtin_types.hpp",
    "include/rosx_introspection/contrib/SmallVector.h",
    "include/rosx_introspection/contrib/msgpack.hpp",
    "include/rosx_introspection/contrib/nanocdr.hpp",
    "include/rosx_introspection/contrib/span.hpp",
    "include/rosx_introspection/deserializer.hpp",
    "include/rosx_introspection/details/conversion_impl.hpp",
    "include/rosx_introspection/details/exceptions.hpp",
    "include/rosx_introspection/msgpack_utils.hpp",
    "include/rosx_introspection/ros_field.hpp",
    "include/rosx_introspection/ros_message.hpp",
    "include/rosx_introspection/ros_parser.hpp",
    "include/rosx_introspection/ros_type.hpp",
    "include/rosx_introspection/ros_utils/ros1_helpers.hpp",
    "include/rosx_introspection/ros_utils/ros2_helpers.hpp",
    "include/rosx_introspection/serializer.hpp",
    "include/rosx_introspection/stringtree_leaf.hpp",
    "include/rosx_introspection/tree.hpp",
    "include/rosx_introspection/variant.hpp",
]

PRIVATE_HEADERS = ["src/ros_utils/message_definition_cache.hpp"]

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

cc_library(
    name = "rosx_introspection_library",
    srcs = [
        "src/deserializer.cpp",
        "src/msgpack_utils.cpp",
        "src/ros_field.cpp",
        "src/ros_message.cpp",
        "src/ros_parser.cpp",
        "src/ros_type.cpp",
        "src/ros_utils/message_definition_cache.cpp",
        "src/ros_utils/ros2_helpers.cpp",
        "src/serializer.cpp",
        "src/stringtree_leaf.cpp",
    ],
    hdrs = HEADERS + PRIVATE_HEADERS,
    defines = ["span_CONFIG_SELECT_SPAN=1"],
    includes = ["include"],
    local_defines = ros_local_defines() + ["ROSX_HAS_JSON"],
    deps = DEPENDENCIES.values() + ["@rosdistro//cc:rapidjson"],
)

cc_shared_library(
    name = "rosx_introspection",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rosx_introspection_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":rosx_introspection"],
)

ament_index(
    name = "ament_index",
    deps = [
        "@builtin_interfaces//:ament_index",
        "@geometry_msgs//:ament_index",
        "@sensor_msgs//:ament_index",
        "@std_msgs//:ament_index",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "rosx_introspectionTargets",
    headers = HEADERS,
    include_prefix = "",
    libraries = [":rosx_introspection"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
