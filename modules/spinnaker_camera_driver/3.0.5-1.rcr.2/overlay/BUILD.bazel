load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

# TODO: spinnaker_camera_driver requires proprietary FLIR Spinnaker SDK deb download (Point Grey EULA)
cc_library(
    name = "camera_driver_library",
    hdrs = [
        "include/spinnaker_camera_driver/camera.hpp",
        "include/spinnaker_camera_driver/camera_driver.hpp",
        "include/spinnaker_camera_driver/diagnostic_levels.hpp",
        "include/spinnaker_camera_driver/exposure_controller.hpp",
        "include/spinnaker_camera_driver/image.hpp",
        "include/spinnaker_camera_driver/lifecycle_types.hpp",
        "include/spinnaker_camera_driver/logging.hpp",
        "include/spinnaker_camera_driver/pixel_format.hpp",
        "include/spinnaker_camera_driver/spinnaker_wrapper.hpp",
        "include/spinnaker_camera_driver/synchronizer.hpp",
        "include/spinnaker_camera_driver/utils.hpp",
    ],
    includes = [
        "include",
        "include/spinnaker_camera_driver",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "config/blackfly.yaml",
        "config/blackfly_s.yaml",
        "config/chameleon.yaml",
        "config/firefly_ffy_u3162c.yaml",
        "config/flir_ax5.yaml",
        "config/grasshopper.yaml",
        "config/oryx.yaml",
        "//launch:launch_files",
    ],
    lib_data = [
        "scripts/linux_setup_flir",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@camera_info_manager//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@flir_camera_msgs//:ament_package",
        "@image_transport//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@ros_environment//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/spinnaker_camera_driver/camera.hpp",
        "include/spinnaker_camera_driver/camera_driver.hpp",
        "include/spinnaker_camera_driver/diagnostic_levels.hpp",
        "include/spinnaker_camera_driver/exposure_controller.hpp",
        "include/spinnaker_camera_driver/image.hpp",
        "include/spinnaker_camera_driver/lifecycle_types.hpp",
        "include/spinnaker_camera_driver/logging.hpp",
        "include/spinnaker_camera_driver/pixel_format.hpp",
        "include/spinnaker_camera_driver/spinnaker_wrapper.hpp",
        "include/spinnaker_camera_driver/synchronizer.hpp",
        "include/spinnaker_camera_driver/utils.hpp",
    ],
    include_prefix = "",
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@camera_info_manager//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@flir_camera_msgs//:ament_package",
        "@image_transport//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@ros_environment//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
