write_file(
    name = "gen_extra_107",
    out = "_gen/include/mrpt/serialization/include/mrpt/serialization/archiveFrom_std_streams.h",
    content = ["/* +------------------------------------------------------------------------+\n   |                     Mobile Robot Programming Toolkit (MRPT)            |\n   |                          https://www.mrpt.org/                         |\n   |                                                                        |\n   | Copyright (c) 2005-2026, Individual contributors, see AUTHORS file     |\n   | See: https://www.mrpt.org/Authors - All rights reserved.               |\n   | Released under BSD License. See: https://www.mrpt.org/License          |\n   +------------------------------------------------------------------------+ */\n#pragma once\n\n#include <mrpt/serialization/CArchive.h>\n\n#include <iosfwd>\n#include <istream>\n#include <ostream>\n\nnamespace mrpt::serialization\n{\n/** Specialization for std::istream */\ntemplate <>\nclass CArchiveStreamBase<std::istream> : public CArchive\n{\n  std::istream& m_s;\n\n public:\n  CArchiveStreamBase(std::istream& s) : m_s(s) {}\n\n protected:\n  size_t write(const void* d, size_t n) override\n  {\n    throw std::runtime_error(\n        \"CArchiveStreamBase<std::istream>:\"\n        \"cannot write to an input stream.\");\n  }\n  size_t read(void* d, size_t n) override\n  {\n    if (m_s.read(reinterpret_cast<char*>(d), n))\n      return n;\n    else\n      return 0;\n  }\n};\n\n/** Specialization for std::ostream */\ntemplate <>\nclass CArchiveStreamBase<std::ostream> : public CArchive\n{\n  std::ostream& m_s;\n\n public:\n  CArchiveStreamBase(std::ostream& s) : m_s(s) {}\n\n protected:\n  size_t write(const void* d, size_t n) override\n  {\n    if (m_s.write(reinterpret_cast<const char*>(d), n))\n      return n;\n    else\n      return 0;\n  }\n  size_t read(void* d, size_t n) override\n  {\n    throw std::runtime_error(\n        \"CArchiveStreamBase<std::ostream>:\"\n        \"cannot read from output stream.\");\n  }\n};\n\n/** Specialization for std::iostream */\ntemplate <>\nclass CArchiveStreamBase<std::iostream> : public CArchive\n{\n  std::iostream& m_s;\n\n public:\n  CArchiveStreamBase(std::iostream& s) : m_s(s) {}\n\n protected:\n  size_t write(const void* d, size_t n) override\n  {\n    if (m_s.write(reinterpret_cast<const char*>(d), n))\n      return n;\n    else\n      return 0;\n  }\n  size_t read(void* d, size_t n) override\n  {\n    if (m_s.read(reinterpret_cast<char*>(d), n))\n      return n;\n    else\n      return 0;\n  }\n};\n\n}  // namespace mrpt::serialization\n"],
)

write_file(
    name = "gen_extra_108",
    out = "_gen/include/mrpt/serialization/include/mrpt/serialization/archiveFrom_std_vector.h",
    content = ["/* +------------------------------------------------------------------------+\n   |                     Mobile Robot Programming Toolkit (MRPT)            |\n   |                          https://www.mrpt.org/                         |\n   |                                                                        |\n   | Copyright (c) 2005-2026, Individual contributors, see AUTHORS file     |\n   | See: https://www.mrpt.org/Authors - All rights reserved.               |\n   | Released under BSD License. See: https://www.mrpt.org/License          |\n   +------------------------------------------------------------------------+ */\n#pragma once\n\n#include <mrpt/serialization/CArchive.h>\n\n#include <cstdint>\n#include <cstring>\n#include <vector>\n\nnamespace mrpt::serialization\n{\n/** Specialization for std::vector, suitable for read/write, using the\n * `vector<uint8_t>` as the underlaying stream container. Writing always happen\n * at the end of the vector. Reading starts at the beggining upon construction\n * of this wrapper class (via `archiveFrom()`).\n */\ntemplate <>\nclass CArchiveStreamBase<std::vector<uint8_t>> : public CArchive\n{\n  std::vector<uint8_t>& m_v;\n  int m_pos_read{0};\n\n public:\n  CArchiveStreamBase(std::vector<uint8_t>& v) : m_v(v) {}\n\n protected:\n  size_t write(const void* d, size_t n) override\n  {\n    const size_t idx = m_v.size();\n    m_v.resize(idx + n);\n    std::memcpy(&m_v[idx], d, n);\n    return n;\n  }\n  size_t read(void* d, size_t n) override\n  {\n    const int avail = static_cast<int>(m_v.size()) - m_pos_read;\n    if (avail < static_cast<int>(n))\n      throw std::runtime_error(\"CArchiveStreamBase: EOF reading from std::vector!\");\n    std::memcpy(d, &m_v[m_pos_read], n);\n    m_pos_read += n;\n    return n;\n  };\n};\n/** Read-only version of the wrapper. See archiveFrom() */\ntemplate <>\nclass CArchiveStreamBase<const std::vector<uint8_t>> : public CArchive\n{\n  const std::vector<uint8_t>& m_v;\n  int m_pos_read{0};\n\n public:\n  CArchiveStreamBase(const std::vector<uint8_t>& v) : m_v(v) {}\n\n protected:\n  size_t write(const void* d, size_t n) override\n  {\n    throw std::runtime_error(\"CArchiveStreamBase: Attempt to write to read-only vector.\");\n  }\n  size_t read(void* d, size_t n) override\n  {\n    const int avail = static_cast<int>(m_v.size()) - m_pos_read;\n    if (avail < static_cast<int>(n))\n      throw std::runtime_error(\"CArchiveStreamBase: EOF reading from std::vector!\");\n    std::memcpy(d, &m_v[m_pos_read], n);\n    m_pos_read += n;\n    return n;\n  };\n};\n}  // namespace mrpt::serialization\n"],
)

write_file(
    name = "gen_extra_109",
    out = "_gen/include/mrpt/serialization/include/mrpt/serialization/bimap_serialization.h",
    content = ["/* +------------------------------------------------------------------------+\n   |                     Mobile Robot Programming Toolkit (MRPT)            |\n   |                          https://www.mrpt.org/                         |\n   |                                                                        |\n   | Copyright (c) 2005-2026, Individual contributors, see AUTHORS file     |\n   | See: https://www.mrpt.org/Authors - All rights reserved.               |\n   | Released under BSD License. See: https://www.mrpt.org/License          |\n   +------------------------------------------------------------------------+ */\n#pragma once\n\n#include <mrpt/containers/bimap.h>\n#include <mrpt/serialization/CArchive.h>\n#include <mrpt/typemeta/TTypeName_stl.h>  // TTypeName<> for STL templates, needed for serialization of STL templates\n\nnamespace mrpt::serialization\n{\n/** \\addtogroup mrpt_serialization_stlext_grp\n * @{ */\n\n/** Template method to serialize an associative STL container  */\ntemplate <typename KEY, typename VALUE>\nCArchive& operator<<(CArchive& out, const mrpt::containers::bimap<KEY, VALUE>& obj)\n{\n  out << \"mrpt::containers::bimap\" << mrpt::typemeta::TTypeName<KEY>::get()\n      << mrpt::typemeta::TTypeName<VALUE>::get();\n  out.WriteAs<uint32_t>(obj.size());\n  for (const auto& kv : obj.getDirectMap()) out << kv.first << kv.second;\n  return out;\n}\n/** Template method to deserialize an associative STL container */\ntemplate <typename KEY, typename VALUE>\nCArchive& operator>>(CArchive& in, mrpt::containers::bimap<KEY, VALUE>& obj)\n{\n  obj.clear();\n  std::string pref, stored_K, stored_V;\n  in >> pref;\n  const auto kType = mrpt::typemeta::TTypeName<KEY>::get();\n  const auto mTp = mrpt::typemeta::TTypeName<VALUE>::get();\n  if (pref != \"mrpt::containers::bimap\")\n    THROW_EXCEPTION_FMT(\n        \"Error: serialized container %s<%s,%s>'s preamble is \"\n        \"wrong: '%s'\",\n        \"mrpt::containers::bimap\", kType.c_str(), mTp.c_str(), pref.c_str());\n  in >> stored_K;\n  if (stored_K != std::string(kType.c_str()))\n    THROW_EXCEPTION_FMT(\n        \"Error: serialized container %s key type %s != %s\", \"mrpt::containers::bimap\",\n        stored_K.c_str(), kType.c_str());\n  in >> stored_V;\n  if (stored_V != std::string(mTp.c_str()))\n    THROW_EXCEPTION_FMT(\n        \"Error: serialized container %s value type %s != %s\", \"mrpt::containers::bimap\",\n        stored_V.c_str(), mTp.c_str());\n  const uint32_t n = in.ReadAs<uint32_t>();\n  for (uint32_t i = 0; i < n; i++)\n  {\n    KEY key_obj;\n    in >> key_obj;\n    VALUE value_obj;\n    in >> value_obj;\n    obj.insert(key_obj, value_obj);\n  }\n  return in;\n}\n/** @} */  // end of grouping\n}  // namespace mrpt::serialization\n"],
)

