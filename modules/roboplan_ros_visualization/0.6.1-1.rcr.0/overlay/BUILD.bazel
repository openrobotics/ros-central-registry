        "@geometry_msgs//:ament_package",
        "@interactive_markers//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@roboplan//:ament_package",
        "@roboplan_ros_cpp//:ament_package",
        "@roboplan_simple_ik//:ament_package",
        "@rviz2//:ament_package",
