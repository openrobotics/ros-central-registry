py_pytest(
    name = "roboplan_ik_marker_test",
    srcs = ["bindings/test/roboplan_ik_marker_test.py"],
    data = [
        ":_visualization_ext.cpython-314-x86_64-linux-gnu",
        ":ament_index",
    ],
    deps = [
        ":roboplan_ros",
        "@geometry_msgs//:py",
        "@interactive_markers//:py",
        "@rclpy",
        "@roboplan//:roboplan_py",
        "@roboplan_ros_cpp//:roboplan_ros",
