load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@interactive_markers//:interactive_markers": "@interactive_markers//:interactive_markers_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@roboplan//:roboplan": "@roboplan//:roboplan_library",
    "@roboplan_ros_cpp//:roboplan_ros_cpp": "@roboplan_ros_cpp//:roboplan_ros_cpp_library",
    "@roboplan_simple_ik//:roboplan_simple_ik": "@roboplan_simple_ik//:roboplan_simple_ik_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

CC_DEPS = [
    "@rosdistro//cc:nanobind",
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rules_python//python/cc:current_py_cc_headers",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
    "@visualization_msgs//:cc",
]

cc_library(
    name = "roboplan_ros_visualization_library",
    srcs = [
        "src/path_visualization.cpp",
        "src/roboplan_ik_marker.cpp",
        "src/roboplan_visualizer.cpp",
    ],
    hdrs = [
        "include/roboplan_ros_visualization/path_visualization.hpp",
        "include/roboplan_ros_visualization/roboplan_ik_marker.hpp",
        "include/roboplan_ros_visualization/roboplan_visualizer.hpp",
    ] + [
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/roboplan_ros_visualization",
    ],
    local_defines = ros_local_defines() + [
        "COAL_HAS_OCTOMAP",
        "COAL_HAVE_OCTOMAP",
        "OCTOMAP_MAJOR_VERSION=1",
        "OCTOMAP_MINOR_VERSION=10",
        "OCTOMAP_PATCH_VERSION=0",
        "PINOCCHIO_ENABLE_TEMPLATE_INSTANTIATION",
        "PINOCCHIO_URDFDOM_HEADERS_MAJOR_VERSION=3",
        "PINOCCHIO_URDFDOM_HEADERS_MINOR_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_PATCH_VERSION=0",
        "PINOCCHIO_WITH_COLLISION",
        "PINOCCHIO_WITH_HPP_FCL",
        "PINOCCHIO_WITH_URDFDOM",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "roboplan_ros_visualization",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":roboplan_ros_visualization_library"],
)

cc_library(
    name = "_visualization_ext.cpython-314-x86_64-linux-gnu_library",
    srcs = ["bindings/src/roboplan_ros_visualization_bindings.cpp"],
    hdrs = [
        "include/roboplan_ros_visualization/path_visualization.hpp",
        "include/roboplan_ros_visualization/roboplan_ik_marker.hpp",
        "include/roboplan_ros_visualization/roboplan_visualizer.hpp",
    ] + [
    ],
    includes = [
        "_gen/include",
        "include",
        "include/roboplan_ros_visualization",
    ],
    local_defines = ros_local_defines() + [
        "COAL_HAS_OCTOMAP",
        "COAL_HAVE_OCTOMAP",
        "OCTOMAP_MAJOR_VERSION=1",
        "OCTOMAP_MINOR_VERSION=10",
        "OCTOMAP_PATCH_VERSION=0",
        "PINOCCHIO_ENABLE_TEMPLATE_INSTANTIATION",
        "PINOCCHIO_URDFDOM_HEADERS_MAJOR_VERSION=3",
        "PINOCCHIO_URDFDOM_HEADERS_MINOR_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_PATCH_VERSION=0",
        "PINOCCHIO_WITH_COLLISION",
        "PINOCCHIO_WITH_HPP_FCL",
        "PINOCCHIO_WITH_URDFDOM",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":roboplan_ros_visualization_library"],
)

cc_shared_library(
    name = "_visualization_ext.cpython-314-x86_64-linux-gnu",
    dynamic_deps = DEPENDENCIES.keys() + [":roboplan_ros_visualization"],
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "roboplan_ros/visualization/_visualization_ext.so",
    deps = [":_visualization_ext.cpython-314-x86_64-linux-gnu_library"],
)

py_library(
    name = "roboplan_ros",
    srcs = ["bindings/python/roboplan_ros/visualization/__init__.py"],
    imports = ["bindings/python"],
    deps = [
        "@geometry_msgs//:py",
        "@interactive_markers//:py",
        "@rclpy",
        "@roboplan//:roboplan_py",
        "@roboplan_ros_cpp//:roboplan_ros",
        "@roboplan_simple_ik//:roboplan",
        "@sensor_msgs//:py",
        "@visualization_msgs//:py",
    ],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":roboplan_ros_visualization",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@geometry_msgs//:ament_package",
        "@interactive_markers//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@roboplan//:ament_package",
        "@roboplan_ros_cpp//:ament_package",
        "@roboplan_simple_ik//:ament_package",
        "@rviz2//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)

