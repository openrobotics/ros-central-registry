load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = [
    "include/image_publisher/image_publisher.hpp",
    "include/image_publisher/visibility.h",
]

DEPENDENCIES = {
    "@camera_info_manager//:camera_info_manager": "@camera_info_manager//:camera_info_manager_library",
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

cc_library(
    name = "image_publisher_library",
    srcs = ["src/image_publisher.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + ["@rcl_interfaces//:cc"],
)

cc_shared_library(
    name = "image_publisher",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":image_publisher_library"],
)

rclcpp_components_register_node(
    name = "node_image_publisher",
    component = ":image_publisher",
    node_name = "image_publisher",
    plugin = "image_publisher::ImagePublisher",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":image_publisher"],
)

cc_binary(
    name = "image_publisher_node",
    srcs = ["src/image_publisher_node.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [":image_publisher_library"],
)

ament_index(
    name = "ament_index",
    components = [":node_image_publisher_record"],
    data = ["//launch:launch_files"],
    export_name = "image_publisher",
    lib_data = [":image_publisher_node"],
    libraries = [":image_publisher"],
    package_xml = "package.xml",
    plugin_category = "rclcpp_components",
    deps = [
        "@image_transport//:ament_index_package",
        "@image_transport//:ament_index_plugin",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_targets = False,
    executables = [":image_publisher_node"],
    headers = HEADERS,
    libraries = [":image_publisher"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@camera_info_manager//:ament_package",
        "@cv_bridge//:ament_package",
        "@image_transport//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
