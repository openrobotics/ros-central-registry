load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "image_publisher_component_file.launch.py",
        "image_publisher_file.launch.py",
        "image_publisher_mono.launch.py",
        "image_publisher_stereo.launch.py",
        "splash.png",
    ],
)

launch_ros_binary(
    name = "image_publisher_component_file_launch",
    src = "image_publisher_component_file.launch.py",
    deps = [
        "//:node_image_publisher",
        "@ament_index_python",
        "@rclcpp_components//:component_container",
    ],
)

launch_ros_binary(
    name = "image_publisher_file_launch",
    src = "image_publisher_file.launch.py",
    deps = [
        "//:image_publisher_node",
        "@ament_index_python",
    ],
)

launch_ros_binary(
    name = "image_publisher_mono_launch",
    src = "image_publisher_mono.launch.py",
    deps = [
        "//:image_publisher_node",
    ],
)

launch_ros_binary(
    name = "image_publisher_stereo_launch",
    src = "image_publisher_stereo.launch.py",
    deps = [
        "//:image_publisher_node",
    ],
)
