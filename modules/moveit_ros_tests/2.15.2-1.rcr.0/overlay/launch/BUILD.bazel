load("@launch_testing_ros//:defs.bzl", "launch_ros_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = ["move_group_api.test.py"],
)

launch_ros_test(
    name = "launch_move_group_api_test",
    src = "move_group_api.test.py",
    data = [
        "//:ament_index",
        "@controller_manager//:ament_index",
        "@moveit_resources_panda_moveit_config//:ament_index",
        "@tf2_ros//:ament_index",
    ],
    # xfail: needs launch argument 'test_binary_dir' that upstream CMake supplies
    tags = [
        "manual",
        "xfail",
    ],
    deps = [
        "@ament_index_python",
        "@controller_manager//:ros2_control_node",
        "@moveit_configs_utils",
        "@moveit_ros_move_group//:move_group",
        "@robot_state_publisher",
        "@tf2_ros//:static_transform_publisher",
    ],
)
