load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@moveit_common//:ament_package",
        "@moveit_configs_utils//:ament_package",
        "@moveit_core//:ament_package",
        "@moveit_planners_chomp//:ament_package",
        "@moveit_planners_ompl//:ament_package",
        "@moveit_planners_stomp//:ament_package",
        "@moveit_resources_panda_moveit_config//:ament_package",
        "@moveit_ros_move_group//:ament_package",
        "@moveit_ros_planning//:ament_package",
        "@moveit_ros_planning_interface//:ament_package",
        "@moveit_simple_controller_manager//:ament_package",
        "@pilz_industrial_motion_planner//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_testing//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

py_pytest(
    name = "launch_move_group_api.test.py",
    srcs = ["launch/move_group_api.test.py"],
    args = [
        "-p",
        "launch_testing.pytest.hooks",
    ],
    data = [":ament_index"],
    deps = ["@moveit_configs_utils"],
)

genrule(
    name = "tar",
    srcs = [":raw_tar"],
    outs = ["tar.tar.gz"],
    cmd = "tmpdir=$$(mktemp -d) && tar -xzf $(location :raw_tar) -C $$tmpdir && rm -rf $$tmpdir/opt/ros/lyrical/moveit_ros_tests/share/moveit_ros_tests/hook && tar -czf $@ -C $$tmpdir opt && rm -rf $$tmpdir",
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    install_package_xml = False,
    package_xml = "package.xml",
    tar_name = "raw_tar",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@moveit_common//:ament_package",
        "@moveit_configs_utils//:ament_package",
        "@moveit_core//:ament_package",
        "@moveit_planners_chomp//:ament_package",
        "@moveit_planners_ompl//:ament_package",
        "@moveit_planners_stomp//:ament_package",
        "@moveit_resources_panda_moveit_config//:ament_package",
        "@moveit_ros_move_group//:ament_package",
        "@moveit_ros_planning//:ament_package",
        "@moveit_ros_planning_interface//:ament_package",
        "@moveit_simple_controller_manager//:ament_package",
        "@pilz_industrial_motion_planner//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_testing//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
