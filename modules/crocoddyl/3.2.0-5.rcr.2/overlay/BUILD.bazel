 define CROCODDYL_DEPRECATED_HEADER(MSG) \\\n    __pragma(message(__FILE__ \"(\" CROCODDYL_STRINGIZE(__LINE__) \") : Warning: \" MSG))\n# else\n#  define CROCODDYL_DEPRECATED_HEADER(MSG)\n# endif\n\n#endif //! CROCODDYL_DEPRECATED_HH\n"],
