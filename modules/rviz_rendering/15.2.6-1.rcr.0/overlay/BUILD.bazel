genrule(
    name = "qbytearray_stdstring_shim_cpp",
    outs = ["qbytearray_stdstring_shim.cpp"],
    cmd = "cat << 'EOF' > $@\n#include <QByteArray>\n#include <string>\nstd::string QByteArray::toStdString() const { return std::string(constData(), length()); }\nQByteArray QByteArray::fromStdString(const std::string &s) { return QByteArray(s.data(), qsizetype(s.size())); }\nEOF\n",
)

