load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_qt//:qt.bzl", "qt_cc_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### DATA

ament_index(
    name = "ament_index",
    data = glob(["ogre_media/**"]),
    package_xml = "package.xml",
    deps = ["@rviz_ogre_vendor//:ament_index"],
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@resource_retriever//:resource_retriever": "@resource_retriever//:resource_retriever_library",
    "@rosdistro//cc:OgreMain": "@rosdistro//cc:OgreMain_library",
    "@rosdistro//cc:OgreOverlay": "@rosdistro//cc:OgreOverlay_library",
}

genrule(
    name = "qbytearray_stdstring_shim_cpp",
    outs = ["qbytearray_stdstring_shim.cpp"],
    cmd = """cat << 'EOF' > $@
#include <QByteArray>
#include <string>
std::string QByteArray::toStdString() const { return std::string(constData(), length()); }
QByteArray QByteArray::fromStdString(const std::string &s) { return QByteArray(s.data(), qsizetype(s.size())); }
EOF
""",
)

qt_cc_library(
    name = "rviz_rendering_library",
    srcs = glob([
        "src/rviz_rendering/**/*.hpp",
        "src/rviz_rendering/**/*.cpp",
    ]) + [":qbytearray_stdstring_shim_cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + [
        "RVIZ_RENDERING_BUILDING_LIBRARY",
    ],
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:RenderSystems",
        "@rosdistro//cc:assimp",
        "@rosdistro//cc:eigen",
        "@rules_qt//:qt_widgets",
    ],
)

cc_shared_library(
    name = "rviz_rendering",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [
        ":rviz_rendering_library",
    ],
    # render_system.cpp calls glX*/GL directly; the GL link flag carried by
    # ogre's header-only glx target is not propagated into shared-library
    # links, so spell it out here.
    user_link_flags = select({
        "@platforms//os:osx": [
            "-framework",
            "OpenGL",
        ],
        "//conditions:default": [],
    }),
    deps = [":rviz_rendering_library"],
)

### TESTS

cc_library(
    name = "rviz_rendering_test_utils_library",
    srcs = [
        "test/rviz_rendering/ogre_testing_environment.cpp",
        "test/rviz_rendering/scene_graph_introspection.cpp",
    ],
    hdrs = [
        "test/rviz_rendering/matcher.hpp",
        "test/rviz_rendering/ogre_testing_environment.hpp",
        "test/rviz_rendering/scene_graph_introspection.hpp",
        "test/rviz_rendering/visibility_control.hpp",
    ],
    local_defines = ros_local_defines() + ["TEST_RVIZ_RENDERING_BUILDING_LIBRARY"],
    deps = DEPENDENCIES.values() + [
        ":rviz_rendering_library",
        "@rosdistro//cc:googletest",
    ],
)

TEST_DEPENDENCIES = DEPENDENCIES | {
    ":rviz_rendering": ":rviz_rendering_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_test",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

cc_test(
    name = "string_helper_test",
    srcs = ["test/rviz_rendering/string_helper_test.cpp"],
    dynamic_deps = [":transitive_dynamic_deps_test"],
    includes = ["src"],
    linkopts = select({
        "@platforms//os:linux": ["-Wl,--allow-shlib-undefined"],
        "//conditions:default": [],
    }),
    linkstatic = True,
    deps = TEST_DEPENDENCIES.values() + [
        "@rosdistro//cc:googletest",
    ],
)

# Upstream only runs these when a display is available (SKIP_DISPLAY_TESTS
# otherwise); the reference colcon run skipped them, so they are opt-in here.
[
    cc_test(
        name = test,
        srcs = srcs,
        data = [":ament_index"],
        dynamic_deps = [":transitive_dynamic_deps_test"],
        linkopts = select({
            "@platforms//os:linux": ["-Wl,--allow-shlib-undefined"],
            "//conditions:default": [],
        }),
        linkstatic = True,
        local_defines = ros_local_defines(),
        tags = [
            "manual",
            "no-sandbox",
            "xfail",
        ],
        deps = TEST_DEPENDENCIES.values() + [
            ":rviz_rendering_test_utils_library",
            "@rosdistro//cc:googletest",
            "@rules_qt//:qt_widgets",
        ],
    )
    for test, srcs in {
        "billboard_line_test_target": ["test/rviz_rendering/objects/billboard_line_test.cpp"],
        "covariance_visual_test_target": ["test/rviz_rendering/objects/covariance_visual_test.cpp"],
        "effort_visual_test_target": ["test/rviz_rendering/objects/effort_visual_test.cpp"],
        "grid_test_target": ["test/rviz_rendering/objects/grid_test.cpp"],
        "line_test_target": ["test/rviz_rendering/objects/line_test.cpp"],
        "mesh_shape_visual_test_target": ["test/rviz_rendering/mesh_shape_test.cpp"],
        "movable_text_test_target": ["test/rviz_rendering/objects/movable_text_test.cpp"],
        "point_cloud_renderable_test_target": ["test/rviz_rendering/objects/point_cloud_renderable_test.cpp"],
        "point_cloud_test_target": ["test/rviz_rendering/objects/point_cloud_test.cpp"],
        "screw_visual_test_target": ["test/rviz_rendering/objects/screw_visual_test.cpp"],
        "triangle_polygon_visual_test_target": ["test/rviz_rendering/objects/triangle_polygon_test.cpp"],
        "wrench_visual_test_target": ["test/rviz_rendering/objects/wrench_visual_test.cpp"],
    }.items()
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = glob(["src/cmake/*.cmake"]) + ["rviz_rendering-extras.cmake"],
    cmake_extras = ["rviz_rendering-extras.cmake"],
    cmake_strip_prefix = "src/cmake",
    data = glob(["ogre_media/**"]),
    headers = HEADERS,
    libraries = [":rviz_rendering"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@resource_retriever//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz_ogre_vendor//:ament_package",
    ],
)
