load("@qt//:qt.bzl", "qt_cc_test")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@resource_retriever//:resource_retriever": "@resource_retriever//:resource_retriever_library",
    "@rosdistro//cc:OgreMain": "@rosdistro//cc:OgreMain_library",
    "@rosdistro//cc:OgreOverlay": "@rosdistro//cc:OgreOverlay_library",
}

TEST_DEPENDENCIES = DEPENDENCIES | {"//:rviz_rendering": "//:rviz_rendering_library"}

cc_library(
    name = "rviz_rendering_test_utils_library",
    srcs = [
        "rviz_rendering/ogre_testing_environment.cpp",
        "rviz_rendering/scene_graph_introspection.cpp",
    ],
    hdrs = [
        "rviz_rendering/matcher.hpp",
        "rviz_rendering/ogre_testing_environment.hpp",
        "rviz_rendering/scene_graph_introspection.hpp",
        "rviz_rendering/visibility_control.hpp",
    ],
    local_defines = ros_local_defines() + ["TEST_RVIZ_RENDERING_BUILDING_LIBRARY"],
    deps = DEPENDENCIES.values() + [
        "//:rviz_rendering_library",
        "@rosdistro//cc:googletest",
    ],
)

qt_cc_test(
    name = "string_helper_test",
    srcs = ["rviz_rendering/string_helper_test.cpp"],
    dynamic_deps = [
        "//:transitive_dynamic_deps_test",
    ],
    linkstatic = True,
    deps = TEST_DEPENDENCIES.values() + [
        "@qtbase//:widgets",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

[qt_cc_test(
    name = test,
    srcs = srcs,
    data = ["//:ament_index"],
    dynamic_deps = [
        "//:transitive_dynamic_deps_test",
    ],
    linkstatic = True,
    local_defines = ros_local_defines(),
    tags = [
        "manual",
        "no-sandbox",
        "xfail",
    ],
    deps = TEST_DEPENDENCIES.values() + [
        ":rviz_rendering_test_utils_library",
        "@qtbase//:widgets",
        "@rosdistro//cc:googletest",
    ],
) for test, srcs in {
    "billboard_line_test_target": ["rviz_rendering/objects/billboard_line_test.cpp"],
    "covariance_visual_test_target": ["rviz_rendering/objects/covariance_visual_test.cpp"],
    "effort_visual_test_target": ["rviz_rendering/objects/effort_visual_test.cpp"],
    "grid_test_target": ["rviz_rendering/objects/grid_test.cpp"],
    "line_test_target": ["rviz_rendering/objects/line_test.cpp"],
    "mesh_shape_visual_test_target": ["rviz_rendering/mesh_shape_test.cpp"],
    "movable_text_test_target": ["rviz_rendering/objects/movable_text_test.cpp"],
    "point_cloud_renderable_test_target": ["rviz_rendering/objects/point_cloud_renderable_test.cpp"],
    "point_cloud_test_target": ["rviz_rendering/objects/point_cloud_test.cpp"],
    "screw_visual_test_target": ["rviz_rendering/objects/screw_visual_test.cpp"],
    "triangle_polygon_visual_test_target": ["rviz_rendering/objects/triangle_polygon_test.cpp"],
    "wrench_visual_test_target": ["rviz_rendering/objects/wrench_visual_test.cpp"],
}.items()]
