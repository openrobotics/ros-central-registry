+// Resolve an OGRE plugin inside `plugin_dir`. CMake-built OGRE installs its
+// plugins without a `lib` prefix (RenderSystem_GL.so.1.12.10), while a Bazel
+// underlay ships the same libraries as regular shared libraries in lib/
+// (libRenderSystem_GL.so / .dylib). Probe the known spellings and fall back
+// to the plain name so OGRE's own DynLib suffix handling still applies.
+std::string find_ogre_plugin(
+  const std::filesystem::path & plugin_dir, const std::string & plugin_name)
+{
+  const std::string stems[] = {plugin_name, "lib" + plugin_name};
+  const std::string extensions[] = {".so", ".dylib", ".dll"};
+  for (const auto & stem : stems) {
+    for (const auto & extension : extensions) {
+      std::error_code ec;
+      auto candidate = plugin_dir / (stem + extension);
+      if (std::filesystem::exists(candidate, ec)) {
+        return candidate.string();
+      }
+    }
+  }
+  return (plugin_dir / plugin_name).string();
+}
+
+}  // namespace
