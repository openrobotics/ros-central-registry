+  }
+  const std::filesystem::path prefix = result.resourcePath.value();
+#ifdef _WIN32
+  const std::filesystem::path vendored = prefix / "opt" / "rviz_ogre_vendor" / "bin";
+  const std::filesystem::path flat = prefix / "bin";
+#else
+  const std::filesystem::path vendored = prefix / "opt" / "rviz_ogre_vendor" / "lib" / "OGRE";
+  const std::filesystem::path flat = prefix / "lib";
+#endif
+  // colcon installs the vendored OGRE under opt/rviz_ogre_vendor/; an
+  // underlay that ships OGRE as plain shared libraries keeps them in lib/.
+  std::error_code ec;
+  if (std::filesystem::is_directory(vendored, ec)) {
+    set_ogre_plugin_directory(vendored.string());
