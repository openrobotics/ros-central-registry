# Upstream's RobotRaconteurPython/CMakeLists.txt assembles the `RobotRaconteur`
# Python package from the hand-written sources in RobotRaconteurPython/, the
# SWIG-generated RobotRaconteurPython.py shipped under generated_src/, and
# RobotRaconteurPythonError.py (configure_file() output of the .py.in next to
# it, see PythonExceptions.cmake). Mirror that layout here.
RR_PY_SOURCES = [
    "RobotRaconteurPython/Client.py",
    "RobotRaconteurPython/NamedClient.py",
    "RobotRaconteurPython/RobotRaconteurPythonDataTypes.py",
    "RobotRaconteurPython/RobotRaconteurPythonError.py",
    "RobotRaconteurPython/RobotRaconteurPythonUtil.py",
    "RobotRaconteurPython/__init__.py",
    "RobotRaconteurPython/classproperty.py",
    "generated_src/Python3/swigwordsize64/RobotRaconteurPython.py",
]

[
    copy_file(
        name = "_py_RobotRaconteur_" + f.rsplit("/", 1)[-1].removesuffix(".py"),
        src = f,
        out = "_gen/py/RobotRaconteur/" + f.rsplit("/", 1)[-1],
    )
    for f in RR_PY_SOURCES
]

py_library(
    name = "RobotRaconteur",
