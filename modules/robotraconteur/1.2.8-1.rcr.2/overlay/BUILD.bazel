escriptor(libusb_device *, libusb_device_descriptor * desc) { if (desc) *desc = {}; return 0; }\ninline uint8_t libusb_get_bus_number(libusb_device *) { return 0; }\ninline uint8_t libusb_get_port_number(libusb_device *) { return 0; }\ninline uint8_t libusb_get_device_address(libusb_device *) { return 0; }\ninline int libusb_open(libusb_device *, libusb_device_handle ** h) { if (h) *h = nullptr; return LIBUSB_ERROR_NO_DEVICE; }\ninline libusb_device_handle * libusb_open_device_with_vid_pid(libusb_context *, uint16_t, uint16_t) { return nullptr; }\ninline void libusb_close(libusb_device_handle *) {}\ninline libusb_device * libusb_ref_device(libusb_device * dev) { return dev; }\ninline void libusb_unref_device(libusb_device *) {}\ninline int libusb_kernel_driver_active(libusb_device_handle *, int) { return 0; }\ninline int libusb_detach_kernel_driver(libusb_device_handle *, int) { return 0; }\ninline int libusb_claim_interface(libusb_device_handle *, int) { return 0; }\ninline int libusb_release_interface(libusb_device_handle *, int) { return 0; }\ninline int libusb_get_string_descriptor_ascii(libusb_device_handle *, uint8_t, unsigned char * data, int length) { if (data && length > 0) data[0] = 0; return 0; }\ninline int libusb_control_transfer(libusb_device_handle *, uint8_t, uint8_t, uint16_t, uint16_t, unsigned char *, uint16_t, unsigned int) { return 0; }\ninline int libusb_bulk_transfer(libusb_device_handle *, unsigned char, unsigned char *, int, int * transferred, unsigned int) { if (transferred) *transferred = 0; return 0; }\ninline int libusb_interrupt_transfer(libusb_device_handle *, unsigned char, unsigned char *, int, int * transferred, unsigned int) { if (transferred) *transferred = 0; return 0; }\n#endif\n"],
