write_file(
    name = "gen_boost_uuid_uuid_hpp",
    out = "_gen/include/boost/uuid/uuid.hpp",
    content = ["#ifndef RCR_BOOST_UUID_UUID_HPP_\n#define RCR_BOOST_UUID_UUID_HPP_\n#include <algorithm>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <cstring>\n#include <functional>\n#include <iostream>\n#include <random>\n#include <string>\nnamespace boost {\ntemplate <typename T> struct hash;\nnamespace uuids {\nstruct uuid {\n  uint8_t data[16];\n  using value_type = uint8_t;\n  using iterator = uint8_t *;\n  using const_iterator = const uint8_t *;\n  using size_type = std::size_t;\n  static constexpr std::size_t static_size() noexcept { return 16; }\n  constexpr std::size_t size() const noexcept { return 16; }\n  iterator begin() noexcept { return data; }\n  iterator end() noexcept { return data + 16; }\n  const_iterator begin() const noexcept { return data; }\n  const_iterator end() const noexcept { return data + 16; }\n  bool is_nil() const noexcept {\n    for (int i = 0; i < 16; ++i) if (data[i] != 0) return false;\n    return true;\n  }\n  friend bool operator==(const uuid & lhs, const uuid & rhs) noexcept {\n    return std::memcmp(lhs.data, rhs.data, 16) == 0;\n  }\n  friend bool operator!=(const uuid & lhs, const uuid & rhs) noexcept {\n    return !(lhs == rhs);\n  }\n  friend bool operator<(const uuid & lhs, const uuid & rhs) noexcept {\n    return std::memcmp(lhs.data, rhs.data, 16) < 0;\n  }\n  friend bool operator>(const uuid & lhs, const uuid & rhs) noexcept { return rhs < lhs; }\n  friend bool operator<=(const uuid & lhs, const uuid & rhs) noexcept { return !(rhs < lhs); }\n  friend bool operator>=(const uuid & lhs, const uuid & rhs) noexcept { return !(lhs < rhs); }\n  friend std::ostream & operator<<(std::ostream & os, const uuid & u);\n  friend std::istream & operator>>(std::istream & is, uuid & u);\n};\ninline std::string to_string(const uuid & u) {\n  char buf[37];\n  std::snprintf(buf, sizeof(buf),\n    \"%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x\",\n    u.data[0], u.data[1], u.data[2], u.data[3], u.data[4], u.data[5], u.data[6], u.data[7],\n    u.data[8], u.data[9], u.data[10], u.data[11], u.data[12], u.data[13], u.data[14], u.data[15]);\n  return std::string(buf);\n}\ninline std::ostream & operator<<(std::ostream & os, const uuid & u) {\n  return os << to_string(u);\n}\ninline std::istream & operator>>(std::istream & is, uuid & u) {\n  std::string s;\n  if (is >> s) {\n    std::memset(u.data, 0, 16);\n  }\n  return is;\n}\ninline std::size_t hash_value(const uuid & u) noexcept {\n  std::size_t seed = 0;\n  for (int i = 0; i < 16; ++i) {\n    seed ^= static_cast<std::size_t>(u.data[i]) + 0x9e3779b9 + (seed << 6) + (seed >> 2);\n  }\n  return seed;\n}\nstruct string_generator {\n  uuid operator()(const std::string & s) const {\n    uuid u = {{0}};\n    std::string hex;\n    for (char c : s) {\n      if ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')) hex.push_back(c);\n    }\n    for (std::size_t i = 0; i < 16 && i * 2 + 1 < hex.size(); ++i) {\n      unsigned int val = 0;\n      std::sscanf(hex.c_str() + i * 2, \"%2x\", &val);\n      u.data[i] = static_cast<uint8_t>(val);\n    }\n    return u;\n  }\n};\nstruct random_generator {\n  uuid operator()() {\n    uuid u = {{0}};\n    std::random_device rd;\n    for (int i = 0; i < 16; ++i) u.data[i] = static_cast<uint8_t>(rd() & 0xFF);\n    u.data[6] = static_cast<uint8_t>((u.data[6] & 0x0F) | 0x40);\n    u.data[8] = static_cast<uint8_t>((u.data[8] & 0x3F) | 0x80);\n    return u;\n  }\n};\nstruct name_generator {\n  uuid ns_;\n  explicit name_generator(const uuid & ns = {{0}}) : ns_(ns) {}\n  uuid operator()(const void * buffer, std::size_t count) const {\n    uuid u = ns_;\n    const auto * bytes = static_cast<const uint8_t *>(buffer);\n    for (std::size_t i = 0; i < count; ++i) {\n      u.data[i % 16] = static_cast<uint8_t>((u.data[i % 16] * 31) ^ bytes[i]);\n    }\n    u.data[6] = static_cast<uint8_t>((u.data[6] & 0x0F) | 0x50);\n    u.data[8] = static_cast<uint8_t>((u.data[8] & 0x3F) | 0x80);\n    return u;\n  }\n  uuid operator()(const std::string & s) const { return (*this)(s.data(), s.size()); }\n  uuid operator()(const char * s) const { return (*this)(s, std::strlen(s)); }\n};\n}  // namespace uuids\n}  // namespace boost\nnamespace std {\ntemplate <>\nstruct hash<boost::uuids::uuid> {\n  std::size_t operator()(const boost::uuids::uuid & u) const noexcept {\n    return boost::uuids::hash_value(u);\n  }\n};\n}  // namespace std\n#endif\n"],
)

