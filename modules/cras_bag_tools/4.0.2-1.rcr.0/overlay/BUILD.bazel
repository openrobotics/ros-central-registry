load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

py_library(
    name = "cras_bag_tools",
    srcs = glob(["cras_bag_tools/**/*.py"]),
    imports = ["."],
)

ament_package(
    name = "ament_package",
    data = glob(["config/**"]),
    executables = ["scripts/extract_images"],
    package_xml = "package.xml",
    python = [":cras_bag_tools"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@cras_lint//:ament_package",
        "@cv_bridge//:ament_package",
        "@rclpy//:ament_package",
        "@rosbag2_py//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_py//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_msgs//:ament_package",
    ],
)
