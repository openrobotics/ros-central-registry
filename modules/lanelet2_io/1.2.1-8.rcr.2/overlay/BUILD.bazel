load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@lanelet2_core//:lanelet2_core": "@lanelet2_core//:lanelet2_core_library",
    "@rosdistro//cc:boost.filesystem_shared": "@rosdistro//cc:boost.filesystem_library",
    "@rosdistro//cc:boost.serialization_shared": "@rosdistro//cc:boost.serialization_library",
    "@rosdistro//cc:pugixml": "@rosdistro//cc:pugixml_library",
}

CC_DEPS = [
    "@rosdistro//cc:boost.format",
    "@rosdistro//cc:boost.geometry",
]

HEADERS = [
    "include/lanelet2_io/Configuration.h",
    "include/lanelet2_io/Exceptions.h",
    "include/lanelet2_io/Io.h",
    "include/lanelet2_io/Projection.h",
    "include/lanelet2_io/io_handlers/BinHandler.h",
    "include/lanelet2_io/io_handlers/Factory.h",
    "include/lanelet2_io/io_handlers/IoHandler.h",
    "include/lanelet2_io/io_handlers/OsmFile.h",
    "include/lanelet2_io/io_handlers/OsmHandler.h",
    "include/lanelet2_io/io_handlers/Parser.h",
    "include/lanelet2_io/io_handlers/Serialize.h",
    "include/lanelet2_io/io_handlers/Writer.h",
]

cc_library(
    name = "lanelet2_io_library",
    srcs = [
        "src/BinHandler.cpp",
        "src/Factory.cpp",
        "src/Io.cpp",
        "src/OsmFile.cpp",
        "src/OsmHandlerLoad.cpp",
        "src/OsmHandlerWrite.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "lanelet2_io",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":lanelet2_io_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":lanelet2_io"],
)

# mrt_add_tests(test): one gtest per test/*.cpp.
cc_test(
    name = "lanelet2_io-gtest-TestBinHandler",
    srcs = [
        "test/TestBinHandler.cpp",
        "test/TestSetup.h",
    ],
    args = ["--gtest_filter=-BinHandler.fullMap"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["test"],
    deps = [
        ":lanelet2_io_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "lanelet2_io-gtest-TestLanelet2Io",
    srcs = [
        "test/TestLanelet2Io.cpp",
        "test/TestSetup.h",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["test"],
    deps = [
        ":lanelet2_io_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "lanelet2_io-gtest-TestOsmFile",
    srcs = [
        "test/TestOsmFile.cpp",
        "test/TestSetup.h",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["test"],
    deps = [
        ":lanelet2_io_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "lanelet2_io-gtest-TestOsmHandler",
    srcs = [
        "test/TestOsmHandler.cpp",
        "test/TestSetup.h",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["test"],
    deps = [
        ":lanelet2_io_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "lanelet2_io-gtest-TestSimpleUsage",
    srcs = [
        "test/TestSetup.h",
        "test/TestSimpleUsage.cpp",
    ],
    args = ["--gtest_filter=-lanelet2_io.exampleUsage"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["test"],
    deps = [
        ":lanelet2_io_library",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_index(
    name = "ament_index",
    libraries = [":lanelet2_io"],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    build_type = "cmake",
    cmake_export_targets = False,
    headers = HEADERS,
    include_prefix = "",
    libraries = [":lanelet2_io"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_core//:ament_package",
        "@lanelet2_core//:ament_package",
        "@mrt_cmake_modules//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
