load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "README.md",
        "launch_system_modes/__init__.py",
        "launch_system_modes/actions/__init__.py",
        "launch_system_modes/actions/node.py",
        "launch_system_modes/actions/system.py",
        "launch_system_modes/actions/system_part.py",
        "launch_system_modes/event_handlers/__init__.py",
        "launch_system_modes/event_handlers/on_mode_changed.py",
        "launch_system_modes/event_handlers/on_state_transition.py",
        "launch_system_modes/events/__init__.py",
        "launch_system_modes/events/change_mode.py",
        "launch_system_modes/events/change_state.py",
        "launch_system_modes/events/mode_changed.py",
        "launch_system_modes/events/state_transition.py",
        "package.xml",
        "resource/launch_system_modes",
        "setup.cfg",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
]]

py_library(
    name = "launch_system_modes",
    srcs = [
        "launch_system_modes/__init__.py",
        "launch_system_modes/actions/__init__.py",
        "launch_system_modes/actions/node.py",
        "launch_system_modes/actions/system.py",
        "launch_system_modes/actions/system_part.py",
        "launch_system_modes/event_handlers/__init__.py",
        "launch_system_modes/event_handlers/on_mode_changed.py",
        "launch_system_modes/event_handlers/on_state_transition.py",
        "launch_system_modes/events/__init__.py",
        "launch_system_modes/events/change_mode.py",
        "launch_system_modes/events/change_state.py",
        "launch_system_modes/events/mode_changed.py",
        "launch_system_modes/events/state_transition.py",
    ],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@launch",
        "@launch_ros",
        "@osrf_pycommon",
        "@rclpy",
        "@system_modes_msgs//:py",
    ],
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":launch_system_modes"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@launch//:ament_package",
        "@osrf_pycommon//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@system_modes_msgs//:ament_package",
    ],
)
