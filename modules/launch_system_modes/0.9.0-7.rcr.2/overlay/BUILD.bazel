package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
    ]
]

py_library(
    name = "launch_system_modes",
    srcs = glob(["launch_system_modes/**/*.py"]),
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@launch",
        "@osrf_pycommon",
        "@rclpy",
        "@system_modes_msgs//:py",
    ],
)

py_pytest(
    name = "test_change_mode",
    srcs = ["test/test_launch_system_modes/test_change_mode.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":launch_system_modes"],
)

