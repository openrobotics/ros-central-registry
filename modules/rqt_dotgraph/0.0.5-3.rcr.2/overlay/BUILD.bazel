load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            ".flake8",
            ".github/workflows/test.yaml",
            "CHANGELOG.rst",
            "LICENSE",
            "README.md",
            "codecov.yaml",
            "package.xml",
            "plugin.xml",
            "resource/rqt_dotgraph",
            "resource/rqt_dotgraph.ui",
            "rqt_dotgraph/__init__.py",
            "rqt_dotgraph/rqt_dotgraph.py",
            "rqt_dotgraph/xdot_qt.py",
            "setup.cfg",
            "setup.py",
            "statick_config/rsc/config.yaml",
            "statick_config/rsc/exceptions.yaml",
            "test/test_pep257.py",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "pep257",
    ]
]

py_library(
    name = "rqt_dotgraph",
    srcs = [
        "rqt_dotgraph/__init__.py",
        "rqt_dotgraph/rqt_dotgraph.py",
        "rqt_dotgraph/xdot_qt.py",
    ],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@python_qt_binding",
        "@qt_dotgraph",
        "@qt_gui_py_common",
        "@rqt_graph",
        "@rqt_gui",
        "@rqt_gui_py",
        "@std_msgs//:py",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"rqt_dotgraph": "rqt_dotgraph.rqt_dotgraph:main"},
    data = [
        "plugin.xml",
        "resource/rqt_dotgraph.ui",
    ],
    executables = ["resource/rqt_dotgraph"],
    package_xml = "package.xml",
    python = [":rqt_dotgraph"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@python_qt_binding//:ament_package",
        "@qt_dotgraph//:ament_package",
        "@qt_gui_py_common//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_graph//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
