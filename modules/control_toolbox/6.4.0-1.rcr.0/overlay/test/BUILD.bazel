cc_test(
    name = "pid_ros_parameters_tests",
    srcs = ["pid_ros_parameters_tests.cpp"] + ["control_filters/test_filter_util.hpp"] + [
        "//:exponential_filter_parameters_gen",
        "//:gravity_compensation_filter_parameters_gen",
        "//:low_pass_filter_parameters_gen",
        "//:rate_limiter_parameters_gen",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "control_filters/test_exponential_filter_parameters.yaml",
        "control_filters/test_gravity_compensation_parameters.yaml",
        "control_filters/test_low_pass_filter_parameters.yaml",
        "control_filters/test_rate_limiter_parameters.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["GTEST_HAS_PTHREAD=1"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:control_toolbox_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

