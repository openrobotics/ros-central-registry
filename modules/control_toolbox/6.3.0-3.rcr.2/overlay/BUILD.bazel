load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### PARAMETER LIBRARIES

generate_parameter_library(
    name = "low_pass_filter_parameters",
    yaml_file = "src/control_filters/low_pass_filter_parameters.yaml",
)

generate_parameter_library(
    name = "rate_limiter_parameters",
    yaml_file = "src/control_filters/rate_limiter_parameters.yaml",
    validate_header = "include/control_filters/custom_validators.hpp",
)

generate_parameter_library(
    name = "exponential_filter_parameters",
    yaml_file = "src/control_filters/exponential_filter_parameters.yaml",
)

generate_parameter_library(
    name = "gravity_compensation_filter_parameters",
    yaml_file = "src/control_filters/gravity_compensation_filter_parameters.yaml",
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
    "@rsl//:rsl": "@rsl//:rsl_library",
}

cc_library(
    name = "control_toolbox_library",
    srcs = [
        "src/dither.cpp",
        "src/limited_proxy.cpp",
        "src/pid.cpp",
        "src/pid_ros.cpp",
        "src/sine_sweep.cpp",
        "src/sinusoid.cpp",
        "src/control_filters/low_pass_filter.cpp",
        "src/control_filters/rate_limiter.cpp",
        "src/control_filters/exponential_filter.cpp",
        "src/control_filters/gravity_compensation.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["CONTROL_TOOLBOX_BUILDING_LIBRARY"],
    deps = DEPENDENCIES.values() + [
        ":low_pass_filter_parameters",
        ":rate_limiter_parameters",
        ":exponential_filter_parameters",
        ":gravity_compensation_filter_parameters",
        "@control_msgs//:cc",
        "@filters//:filter_base",
        "@geometry_msgs//:cc",
        "@rcl_interfaces//:cc",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:fmt",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    ],
)

cc_shared_library(
    name = "control_toolbox",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":control_toolbox_library"],
    deps = [":control_toolbox_library"],
)

### TRANSITIVE DYNAMIC DEPS FOR TESTS

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    dynamic_deps = [":control_toolbox"],
    visibility = ["//visibility:private"],
)

### AMENT INDEX

ament_index(
    name = "ament_index",
    export_name = "control_toolbox",
    libraries = [":control_toolbox"],
    package_xml = "package.xml",
    plugin_category = "filters",
    plugins = ["control_filters.xml"],
)

### TESTS

cc_test(
    name = "pid_tests",
    srcs = ["test/pid_tests.cpp"],
    dynamic_deps = [":test_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        ":control_toolbox_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "rate_limiter_tests",
