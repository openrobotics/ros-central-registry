load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
]

cc_library(
    name = "canopen_ros2_control_library",
    srcs = [
        "src/canopen_system.cpp",
        "src/cia402_system.cpp",
        "src/robot_system.cpp",
    ],
    hdrs = [
        "include/canopen_ros2_control/canopen_system.hpp",
        "include/canopen_ros2_control/cia402_data.hpp",
        "include/canopen_ros2_control/cia402_system.hpp",
        "include/canopen_ros2_control/helpers.hpp",
        "include/canopen_ros2_control/robot_system.hpp",
        "include/canopen_ros2_control/visibility_control.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/canopen_ros2_control",
    ],
    local_defines = ros_local_defines() + [
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "canopen_ros2_control",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":canopen_ros2_control_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":canopen_ros2_control"],
    package_xml = "package.xml",
    plugin_category = "hardware_interface",
    plugins = ["canopen_ros2_control.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@canopen_402_driver//:ament_package",
        "@canopen_core//:ament_package",
        "@canopen_proxy_driver//:ament_package",
        "@hardware_interface//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2_control_test_assets//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "canopen_402_driver",
        "canopen_core",
        "canopen_proxy_driver",
        "hardware_interface",
        "pluginlib",
        "rclcpp",
        "rclcpp_components",
        "rclcpp_lifecycle",
    ],
    cmake_export_targets = False,
    headers = [
        "include/canopen_ros2_control/canopen_system.hpp",
        "include/canopen_ros2_control/cia402_data.hpp",
        "include/canopen_ros2_control/cia402_system.hpp",
        "include/canopen_ros2_control/helpers.hpp",
        "include/canopen_ros2_control/robot_system.hpp",
        "include/canopen_ros2_control/visibility_control.h",
    ],
    include_prefix = "",
    libraries = [":canopen_ros2_control"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@canopen_402_driver//:ament_package",
        "@canopen_core//:ament_package",
        "@canopen_proxy_driver//:ament_package",
        "@hardware_interface//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2_control_test_assets//:ament_package",
    ],
)
