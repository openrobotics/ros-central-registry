load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

cc_library(
    name = "eigen_stl_containers",
    hdrs = [
        "include/eigen_stl_containers/eigen_stl_containers.h",
        "include/eigen_stl_containers/eigen_stl_map_container.h",
        "include/eigen_stl_containers/eigen_stl_vector_container.h",
    ],
    includes = ["include"],
    deps = ["@rosdistro//cc:eigen"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = ["Eigen3"],
    cmake_export_name = "eigen_stl_containersTargets",
    headers = [
        "include/eigen_stl_containers/eigen_stl_containers.h",
        "include/eigen_stl_containers/eigen_stl_map_container.h",
        "include/eigen_stl_containers/eigen_stl_vector_container.h",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
