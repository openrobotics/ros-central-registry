load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@qml6_ros2_plugin//:qml6_ros2_plugin": "@qml6_ros2_plugin//:qml6_ros2_plugin_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

CC_DEPS = [
    "@ros_babel_fish_test_msgs//:cc",
    "@rosdistro//cc:fmt",
    "@rosdistro//cc:nlohmann_json",
    "@rosdistro//cc:spdlog",
    "@qtbase//:core",
    "@qtbase//:gui",
    "@qtsvg//:svg",
    "@qtbase//:widgets",
]

cc_test(
    name = "test_rqml_core",
    srcs = ["test_rqml_core.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "mocks/com/kdab/dockwidgets/KDDockWidgets.js",
        "mocks/com/kdab/dockwidgets/qmldir",
        "tst_ChangeSlider.qml",
        "tst_DecimalInputField.qml",
        "tst_DecimalSpinBox.qml",
        "tst_EditMessageDialog.qml",
        "tst_FuzzySearch.qml",
        "tst_FuzzySearchDialogs.qml",
        "tst_FuzzySelector.qml",
        "tst_IconButton.qml",
        "tst_IntegerInputField.qml",
        "tst_LoadingListView.qml",
        "tst_MessageContentEditor.qml",
        "tst_MessageUtils.qml",
        "tst_Object.qml",
        "tst_RefreshButton.qml",
        "tst_SearchBar.qml",
        "tst_SpeedSlider.qml",
        "tst_StateIndicator.qml",
        "tst_ToastManager.qml",
        "tst_TruncatedLabel.qml",
    ],
    dynamic_deps = [
        "//:transitive_dynamic_deps",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtsvg//:svg_shared",
        "@qtbase//:widgets_shared",
    ],
    local_defines = ros_local_defines() + ['QUICK_TEST_SOURCE_DIR=\\"test\\"'],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:kddockwidgets-qt6_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
