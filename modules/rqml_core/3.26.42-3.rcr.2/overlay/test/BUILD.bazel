load("@qt//:qt.bzl", "qt_cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

# Mirrors upstream's ament_add_test(test_rqml_core ... -import <src> -import <src>/test/mocks).
qt_cc_test(
    name = "test_rqml_core",
    srcs = ["test_rqml_core.cpp"],
    args = [
        "-import",
        "../rqml_core+",
        "-import",
        "../rqml_core+/test/mocks",
    ],
    data = ["//:ament_index"] + glob(["mocks/**"]) + [
        "tst_ChangeSlider.qml",
        "tst_DecimalInputField.qml",
        "tst_DecimalSpinBox.qml",
        "tst_EditMessageDialog.qml",
        "tst_FuzzySearch.qml",
        "tst_FuzzySearchDialogs.qml",
        "tst_FuzzySelector.qml",
        "tst_IconButton.qml",
        "tst_IntegerInputField.qml",
        "tst_LoadingListView.qml",
        "tst_MessageContentEditor.qml",
        "tst_MessageUtils.qml",
        "tst_Object.qml",
        "tst_RefreshButton.qml",
        "tst_SearchBar.qml",
        "tst_SpeedSlider.qml",
        "tst_StateIndicator.qml",
        "tst_ToastManager.qml",
        "tst_TruncatedLabel.qml",
    ],
    defines = ['QUICK_TEST_SOURCE_DIR=\\"../rqml_core+/test\\"'],
    moc_srcs = ["test_rqml_core.cpp"],
    # xfail: fails under Bazel: ********* Finished testing of RqmlCoreTest *********
    tags = [
        "manual",
        "xfail",
    ],
    deps = [
        "@qtdeclarative//:qml",
        "@qtdeclarative//:quick",
        "@qtdeclarative//:quicktest",
    ],
)
