load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@qml6_ros2_plugin//:qml6_ros2_plugin": "@qml6_ros2_plugin//:qml6_ros2_plugin_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

CC_DEPS = [
    "@ros_babel_fish_test_msgs//:cc",
    "@rosdistro//cc:fmt",
    "@rosdistro//cc:nlohmann_json",
    "@rosdistro//cc:spdlog",
    "@rules_qt//:qt_core",
    "@rules_qt//:qt_gui",
    "@rules_qt//:qt_svg",
    "@rules_qt//:qt_widgets",
]

cc_library(
    name = "kddockwidgets-qt6_library",
    srcs = [":gen_rqml_core_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":gen_extra_42"],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "third_party/KDDockWidgets/src",
        "third_party/KDDockWidgets/src/3rdparty",
        "third_party/KDDockWidgets/src/fwd_headers",
        "third_party/KDDockWidgets/src/qtquick",
    ],
    local_defines = ros_local_defines() + [
        "BUILDING_DOCKS_LIBRARY",
        "KDDW_FRONTEND_QT",
        "KDDW_FRONTEND_QTQUICK",
        "KDDW_HAS_SPDLOG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "kddockwidgets-qt6",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":kddockwidgets-qt6_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "rqml",
    srcs = [":gen_rqml_core_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":gen_extra_42"],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "third_party/KDDockWidgets/src",
        "third_party/KDDockWidgets/src/3rdparty",
        "third_party/KDDockWidgets/src/fwd_headers",
        "third_party/KDDockWidgets/src/qtquick",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines() + [
        "CMAKE_INSTALL_PREFIX=\\\".\\\"",
        "KDDW_FRONTEND_QT",
        "KDDW_FRONTEND_QTQUICK",
        "RCLCPP_VERSION_MAJOR=32",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":kddockwidgets-qt6_library"],
)

write_file(
    name = "gen_rqml_core_stub_cpp",
    out = "_gen/rqml_core_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

write_file(
    name = "gen_extra_42",
    out = "_gen/include/kddockwidgets-qt6/kddockwidgets/kddockwidgets_version.h",
    content = ["// This file was generated by ecm_setup_version(): DO NOT EDIT!\n\n#ifndef KDDOCKWIDGETS_VERSION_H\n#define KDDOCKWIDGETS_VERSION_H\n\n#define KDDOCKWIDGETS_VERSION_STRING \"2.4.0\"\n#define KDDOCKWIDGETS_VERSION_MAJOR 2\n#define KDDOCKWIDGETS_VERSION_MINOR 4\n#define KDDOCKWIDGETS_VERSION_PATCH 0\n#define KDDOCKWIDGETS_VERSION KDDOCKWIDGETS_VERSION_CHECK(KDDOCKWIDGETS_VERSION_MAJOR, KDDOCKWIDGETS_VERSION_MINOR, KDDOCKWIDGETS_VERSION_PATCH)\n\n/*\n   for example: KDDOCKWIDGETS_VERSION >= KDDOCKWIDGETS_VERSION_CHECK(1, 2, 2))\n*/\n#define KDDOCKWIDGETS_VERSION_CHECK(major, minor, patch) ((major<<16)|(minor<<8)|(patch))\n\n#endif\n"],
)

ament_index(
    name = "ament_index",
    data = [
        "RQml/Elements/Caption.qml",
        "RQml/Elements/ChangeSlider.qml",
        "RQml/Elements/DecimalInputField.qml",
        "RQml/Elements/DecimalSpinBox.qml",
        "RQml/Elements/EditMessageDialog.qml",
        "RQml/Elements/FuzzySelector.qml",
        "RQml/Elements/Hint.qml",
        "RQml/Elements/IconButton.qml",
        "RQml/Elements/IconTextButton.qml",
        "RQml/Elements/IconToggleButton.qml",
        "RQml/Elements/IntegerInputField.qml",
        "RQml/Elements/LetterIndicator.qml",
        "RQml/Elements/ListHeader.qml",
        "RQml/Elements/LoadingListView.qml",
        "RQml/Elements/MessageContentEditor.qml",
        "RQml/Elements/RefreshButton.qml",
        "RQml/Elements/SearchBar.qml",
        "RQml/Elements/SpeedSlider.qml",
        "RQml/Elements/StateIndicator.qml",
        "RQml/Elements/Title.qml",
        "RQml/Elements/ToastManager.qml",
        "RQml/Elements/TruncatedLabel.qml",
        "RQml/Elements/qmldir",
        "RQml/Fonts/Font Awesome 7 Free-Solid-900.otf",
        "RQml/Fonts/Font-Awesome-LICENSE.txt",
        "RQml/Fonts/IconFont.qml",
        "RQml/Fonts/qmldir",
        "RQml/Utils/FuzzySearch.js",
        "RQml/Utils/MessageUtils.js",
        "RQml/Utils/Object.qml",
        "RQml/Utils/qmldir",
        "assets/app_icon.svg",
    ],
    data_strip_prefix = "assets",
    libraries = [
        ":kddockwidgets-qt6",
    ],
    package_xml = "package.xml",
    sonames = {
        "kddockwidgets-qt6": [
            "libkddockwidgets-qt6.so.2.4.0",
            "libkddockwidgets-qt6.so.3",
        ],
    },
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@qml6_ros2_plugin//:ament_package",
        "@ros_babel_fish_test_msgs//:ament_package",
        "@yaml_cpp_vendor//:ament_package",
    ],
)

cc_test(
    name = "test_rqml_core",
    srcs = [":gen_rqml_core_stub_cpp"],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        ":ament_index",
    ] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "third_party/KDDockWidgets/src",
        "third_party/KDDockWidgets/src/3rdparty",
        "third_party/KDDockWidgets/src/fwd_headers",
        "third_party/KDDockWidgets/src/qtquick",
    ],
    local_defines = ros_local_defines() + ["QUICK_TEST_SOURCE_DIR=\\\"test\\\""],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":kddockwidgets-qt6_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

