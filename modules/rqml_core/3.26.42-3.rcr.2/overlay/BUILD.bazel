# ---------------------------------------------------------------------------
# Vendored KDDockWidgets, configured the way rqml_core's CMakeLists.txt does:
# KDDockWidgets_QT6=ON, KDDockWidgets_FRONTENDS=qtquick, no QML module, no
# developer mode/tests/examples/python bindings.
# ---------------------------------------------------------------------------

KDDW = "third_party/KDDockWidgets/src/"

# KDDW_LAYOUTING_SRCS + KDDW_BACKEND_SRCS + KDDW_QTCOMMON_SRCS +
# KDDW_FRONTEND_QTQUICK_SRCS + KDDW_MODULE_QML_ELEMENTS (src/CMakeLists.txt).
KDDW_SRCS = [KDDW + f + ".cpp" for f in [
    "Config",
    "KDDockWidgets",
    "LayoutSaver",
    "core/Action",
    "core/Controller",
    "core/DelayedCall",
    "core/DockRegistry",
    "core/DockWidget",
    "core/DragController",
    "core/Draggable",
    "core/DropArea",
    "core/DropIndicatorOverlay",
    "core/FloatingWindow",
    "core/FocusScope",
    "core/Group",
    "core/Layout",
    "core/Logging",
    "core/MDILayout",
    "core/MainWindow",
    "core/Platform",
    "core/Position",
    "core/Screen",
    "core/Separator",
    "core/SideBar",
    "core/Stack",
    "core/TabBar",
    "core/TitleBar",
    "core/View",
    "core/ViewFactory",
    "core/ViewGuard",
    "core/WidgetResizeHandler",
    "core/Window",
    "core/WindowBeingDragged",
    "core/indicators/ClassicDropIndicatorOverlay",
    "core/indicators/NullDropIndicatorOverlay",
    "core/indicators/SegmentedDropIndicatorOverlay",
    "core/layouting/Item",
    "core/layouting/ItemFreeContainer",
    "core/views/ClassicIndicatorWindowViewInterface",
    "core/views/DockWidgetViewInterface",
    "core/views/GroupViewInterface",
    "core/views/MainWindowMDIViewInterface",
    "core/views/MainWindowViewInterface",
    "core/views/SideBarViewInterface",
    "core/views/StackViewInterface",
    "core/views/TabBarViewInterface",
    "core/views/TitleBarViewInterface",
    "qtcommon/CustomFrameHelper",
    "qtcommon/DragControllerWayland_p",
    "qtcommon/Platform",
    "qtcommon/Screen",
    "qtcommon/View",
    "qtcommon/ViewWrapper",
    "qtcommon/Window",
    "qtquick/Action",
    "qtquick/DockWidgetInstantiator",
    "qtquick/Helpers",
    "qtquick/LayoutSaverInstantiator",
    "qtquick/MainWindowInstantiator",
    "qtquick/MainWindowMDIInstantiator",
    "qtquick/Platform",
    "qtquick/QmlConfig",
    "qtquick/QmlTypes",
    "qtquick/Singletons",
    "qtquick/ViewFactory",
    "qtquick/Window",
    "qtquick/views/ClassicIndicatorsWindow",
    "qtquick/views/DockWidget",
    "qtquick/views/DropArea",
    "qtquick/views/FloatingWindow",
    "qtquick/views/Group",
    "qtquick/views/MDILayout",
    "qtquick/views/MainWindow",
    "qtquick/views/MainWindowMDI",
    "qtquick/views/RubberBand",
    "qtquick/views/Separator",
    "qtquick/views/Stack",
    "qtquick/views/TabBar",
    "qtquick/views/TitleBar",
    "qtquick/views/View",
    "qtquick/views/ViewWrapper",
]]

KDDW_HDRS = glob(
    [
        KDDW + "**/*.h",
        KDDW + "3rdparty/**/*.hpp",
    ],
    exclude = [
        KDDW + "core/layouting/examples/**",
        KDDW + "flutter/**",
        KDDW + "fwd_headers/kddockwidgets/qtwidgets/**",
        KDDW + "fwd_headers/qtwidgets_pretty/**",
        KDDW + "qtwidgets/**",
    ],
)

KDDW_INCLUDES = [
    "_gen/include/kddockwidgets-qt6",
    KDDW[:-1],
    KDDW + "3rdparty",
    KDDW + "fwd_headers",
    KDDW + "fwd_headers/qtquick",
    KDDW + "qtquick",
]

# add_definitions() in KDDockWidgets' CMakeLists.txt and src/CMakeLists.txt,
# plus the PRIVATE target_compile_definitions of the kddockwidgets target.
KDDW_LOCAL_DEFINES = [
    "BUILDING_DOCKS_LIBRARY",
    "KDDW_HAS_SPDLOG",
    "QT_NO_CAST_FROM_ASCII",
    "QT_NO_CAST_FROM_BYTEARRAY",
    "QT_NO_CAST_TO_ASCII",
    "QT_NO_FOREACH",
    "QT_NO_KEYWORDS",
    "QT_NO_NARROWING_CONVERSIONS_IN_CONNECT",
    "QT_NO_SIGNALS_SLOTS_KEYWORDS",
    "QT_NO_URL_CAST_FROM_STRING",
    "QT_STRICT_ITERATORS",
    "QT_USE_QSTRINGBUILDER",
]

# PUBLIC target_compile_definitions of the kddockwidgets target.
KDDW_DEFINES = [
    "KDDW_FRONTEND_QT",
    "KDDW_FRONTEND_QTQUICK",
]

# Qt6::Quick Qt6::QuickControls2 (PUBLIC), Qt6::GuiPrivate Qt6::QuickPrivate.
KDDW_QT_DEPS = [
    "@qtbase//:core",
    "@qtbase//:gui",
    "@qtdeclarative//:qml",
    "@qtdeclarative//:quick",
    "@qtdeclarative//:quickcontrols2",
]

expand_template(
    name = "kddockwidgets_version_h",
    out = "_gen/include/kddockwidgets-qt6/kddockwidgets/kddockwidgets_version.h",
    substitutions = {
        "@PACKAGE_VERSION@": "2.4.0",
        "@PROJECT_VERSION_MAJOR@": "2",
        "@PROJECT_VERSION_MINOR@": "4",
        "@PROJECT_VERSION_PATCH@": "0",
        "@VERSION_PREFIX@": "KDDOCKWIDGETS",
    },
    template = "third_party/KDDockWidgets/cmake/ECM/modules/ECMVersionHeader.h.in",
)

qt_resource_via_qrc(
    name = "kddockwidgets_resources",
    files = glob([KDDW + "img/**/*.png"]),
    qrc_file = KDDW + "kddockwidgets_resources.qrc",
)

qt_resource_via_qrc(
    name = "kddockwidgets_qtquick",
    files = glob([KDDW + "qtquick/views/qml/*.qml"]),
    qrc_file = KDDW + "qtquick/kddockwidgets_qtquick.qrc",
)

genrule(
    name = "kddockwidgets_config_h",
    srcs = [KDDW + "Config.h"],
    outs = ["Config.h"],
    cmd = "cp $< $@",
)

# AUTOMOC output for the qtquick/views headers. These share basenames with
# headers under core/ and qtcommon/ (View.h, Group.h, ...), so they need their
# own moc output directory.
qt_cc_library(
    name = "kddockwidgets_qtquick_views",
    hdrs = KDDW_HDRS + [
        ":kddockwidgets_config_h",
        ":kddockwidgets_version_h",
    ],
    copts = [
        "-Ithird_party/KDDockWidgets/src",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    defines = KDDW_DEFINES,
    includes = KDDW_INCLUDES,
    local_defines = KDDW_LOCAL_DEFINES,
    # Order matters for the AUTOMOC-style unity TU: TabBar/TitleBar must be
    # complete before the views that only forward-declare them.
    moc_hdrs = [KDDW + "qtquick/" + f + ".h" for f in [
        "views/TabBar",
        "views/TitleBar",
        "views/ClassicIndicatorsWindow",
        "views/DockWidget",
        "views/DropArea",
        "views/FloatingWindow",
        "views/Group",
        "views/MDILayout",
        "views/MainWindow",
        "views/MainWindowMDI",
        "views/RubberBand",
        "views/Separator",
        "views/Stack",
        "views/View",
        "ViewFactory",
    ]],
    deps = KDDW_QT_DEPS + [
        "@rosdistro//cc:fmt",
        "@rosdistro//cc:nlohmann_json",
        "@rosdistro//cc:spdlog",
    ],
)

qt_cc_library(
    name = "kddockwidgets-qt6_library",
    srcs = KDDW_SRCS,
    hdrs = KDDW_HDRS + [
        ":kddockwidgets_config_h",
        ":kddockwidgets_version_h",
    ],
    copts = [
        "-Ithird_party/KDDockWidgets/src",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    defines = KDDW_DEFINES,
    includes = KDDW_INCLUDES,
    local_defines = KDDW_LOCAL_DEFINES,
    moc_hdrs = [KDDW + f + ".h" for f in [
        "KDDockWidgets",
        "core/Controller",
        "core/DockRegistry",
        "core/DockWidget",
        "core/DragController_p",
        "core/DropArea",
        "core/DropIndicatorOverlay",
        "core/FloatingWindow",
        "core/Group",
        "core/Layout",
        "core/MDILayout",
        "core/MainWindow",
        "core/Separator",
        "core/SideBar",
        "core/Stack",
        "core/TabBar",
        "core/TitleBar",
        "core/ViewFactory",
        "core/WidgetResizeHandler_p",
        "core/indicators/ClassicDropIndicatorOverlay",
        "core/indicators/NullDropIndicatorOverlay",
        "core/indicators/SegmentedDropIndicatorOverlay",
        "core/layouting/ItemFreeContainer_p",
        "core/layouting/Item_p",
        "qtcommon/CustomFrameHelper_p",
        "qtcommon/DragControllerWayland_p",
        "qtquick/Action",
        "qtquick/DockWidgetInstantiator",
        "qtquick/Helpers_p",
        "qtquick/LayoutSaverInstantiator",
        "qtquick/MainWindowInstantiator",
        "qtquick/MainWindowMDIInstantiator",
        "qtquick/QmlConfig",
        "qtquick/Singletons_p",
    ]],
    moc_srcs = [
        KDDW + "qtquick/views/FloatingWindow.cpp",
        KDDW + "qtquick/views/View.cpp",
    ],
    deps = KDDW_QT_DEPS + [
        ":kddockwidgets_qtquick",
        ":kddockwidgets_qtquick_views",
        ":kddockwidgets_resources",
        "@rosdistro//cc:fmt",
        "@rosdistro//cc:spdlog",
    ],
)

qt_cc_shared_library(
    name = "kddockwidgets-qt6",
    qt_deps = KDDW_QT_DEPS,
    deps = [":kddockwidgets-qt6_library"],
)

