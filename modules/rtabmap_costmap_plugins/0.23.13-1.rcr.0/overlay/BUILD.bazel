load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@nav2_costmap_2d//:layers": "@nav2_costmap_2d//:layers_library",
    "@nav2_costmap_2d//:nav2_costmap_2d_core": "@nav2_costmap_2d//:nav2_costmap_2d_core_library",
    "@nav2_msgs//:cc_shared": "@nav2_msgs//:cc",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@visualization_msgs//:cc_shared": "@visualization_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "rtabmap_costmap_plugins_library",
    srcs = ["src/voxel_layer.cpp"],
    hdrs = [
        "include/rtabmap_costmap_plugins/visibility.h",
        "include/rtabmap_costmap_plugins/voxel_layer.hpp",
    ],
    includes = [
        "include",
        "include/rtabmap_costmap_plugins",
    ],
    local_defines = ros_local_defines() + [
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "RTABMAP_ROS_BUILDING_LIBRARY",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rtabmap_costmap_plugins",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rtabmap_costmap_plugins_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":rtabmap_costmap_plugins"],
)

cc_binary(
    name = "voxel_marker",
    srcs = ["src/voxel_marker.cpp"] + [
        "include/rtabmap_costmap_plugins/visibility.h",
        "include/rtabmap_costmap_plugins/voxel_layer.hpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/rtabmap_costmap_plugins",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

ament_index(
    name = "ament_index",
    lib_data = [
        ":voxel_marker",
    ],
    libraries = [
        ":rtabmap_costmap_plugins",
    ],
    package_xml = "package.xml",
    plugin_category = "nav2_costmap_2d",
    plugins = ["costmap_plugins.xml"],
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@nav2_costmap_2d//:ament_package",
        "@nav2_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_environment//:ament_package",
        "@sensor_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "pluginlib",
        "rclcpp",
        "nav2_costmap_2d",
        "visualization_msgs",
    ],
    cmake_export_include_directories = False,
    headers = [
        "include/rtabmap_costmap_plugins/visibility.h",
    ],
    include_prefix = "",
    libraries = [
        ":rtabmap_costmap_plugins",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@nav2_costmap_2d//:ament_package",
        "@nav2_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_environment//:ament_package",
        "@sensor_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
