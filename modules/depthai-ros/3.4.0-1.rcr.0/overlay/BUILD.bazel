load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

write_file(
    name = "gen_rcr_chrono_v2_shim_hpp",
    out = "_gen/include/rcr_chrono_v2_shim.hpp",
    content = ["#pragma once\n#ifdef __cplusplus\n#include <chrono>\n#ifdef _LIBCPP_BEGIN_NAMESPACE_STD\n_LIBCPP_BEGIN_NAMESPACE_STD\nnamespace chrono { namespace _V2 = ::std::chrono; }\n_LIBCPP_END_NAMESPACE_STD\n#else\nnamespace std { namespace chrono { namespace _V2 = ::std::chrono; } }\n#endif\n#endif\n"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@depthai//:ament_package",
        "@depthai_bridge//:ament_package",
        "@depthai_descriptions//:ament_package",
        "@depthai_examples//:ament_package",
        "@depthai_filters//:ament_package",
        "@depthai_ros_driver//:ament_package",
        "@depthai_ros_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@depthai//:ament_package",
        "@depthai_bridge//:ament_package",
        "@depthai_descriptions//:ament_package",
        "@depthai_examples//:ament_package",
        "@depthai_filters//:ament_package",
        "@depthai_ros_driver//:ament_package",
        "@depthai_ros_msgs//:ament_package",
    ],
)
