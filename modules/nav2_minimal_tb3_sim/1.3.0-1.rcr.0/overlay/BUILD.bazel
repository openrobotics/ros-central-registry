load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "configs/turtlebot3_waffle_bridge.yaml",
        "configs/turtlebot3_waffle_gps_bridge.yaml",
        "launch/spawn_tb3.launch.py",
        "launch/spawn_tb3_gps.launch.py",
        "models/turtlebot3_model/meshes/lds.dae",
        "models/turtlebot3_model/meshes/r200.dae",
        "models/turtlebot3_model/meshes/tire.dae",
        "models/turtlebot3_model/meshes/waffle_base.dae",
        "models/turtlebot3_model/model.config",
        "models/turtlebot3_world/meshes/hexagon.dae",
        "models/turtlebot3_world/meshes/wall.dae",
        "models/turtlebot3_world/model.config",
        "models/turtlebot3_world/model.sdf",
        "models/turtlebot3_world/model-1_4.sdf",
        "urdf/gz_waffle.sdf.xacro",
        "urdf/gz_waffle_gps.sdf.xacro",
        "urdf/turtlebot3_waffle.urdf",
        "urdf/turtlebot3_waffle_gps.urdf",
        "worlds/tb3_empty_world.sdf.xacro",
        "worlds/tb3_sandbox.sdf.xacro",
    ],
    package_xml = "package.xml",
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [":ament_index"],
    )
    for f in glob(["launch/**"])
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    data = [
        "configs/turtlebot3_waffle_bridge.yaml",
        "configs/turtlebot3_waffle_gps_bridge.yaml",
        "launch/spawn_tb3.launch.py",
        "launch/spawn_tb3_gps.launch.py",
        "models/turtlebot3_model/meshes/lds.dae",
        "models/turtlebot3_model/meshes/r200.dae",
        "models/turtlebot3_model/meshes/tire.dae",
        "models/turtlebot3_model/meshes/waffle_base.dae",
        "models/turtlebot3_model/model.config",
        "models/turtlebot3_world/meshes/hexagon.dae",
        "models/turtlebot3_world/meshes/wall.dae",
        "models/turtlebot3_world/model.config",
        "models/turtlebot3_world/model.sdf",
        "models/turtlebot3_world/model-1_4.sdf",
        "urdf/gz_waffle.sdf.xacro",
        "urdf/gz_waffle_gps.sdf.xacro",
        "urdf/turtlebot3_waffle.urdf",
        "urdf/turtlebot3_waffle_gps.urdf",
        "worlds/tb3_empty_world.sdf.xacro",
        "worlds/tb3_sandbox.sdf.xacro",
    ],
    package_xml = "package.xml",
