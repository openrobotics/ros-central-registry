load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["test/test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "README.md",
        "config.yaml",
        "package.xml",
        "resource/rmf_demos_fleet_adapter",
        "rmf_demos_fleet_adapter/RobotClientAPI.py",
        "rmf_demos_fleet_adapter/__init__.py",
        "rmf_demos_fleet_adapter/fleet_adapter.py",
        "rmf_demos_fleet_adapter/fleet_manager.py",
        "rmf_demos_fleet_adapter/manage_lane.py",
        "setup.cfg",
        "setup.py",
        "test/__init__.py",
        "test/test_copyright.py",
        "test/test_flake8.py",
        "test/test_pep257.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
]]

py_library(
    name = "rmf_demos_fleet_adapter",
    srcs = [
        "rmf_demos_fleet_adapter/RobotClientAPI.py",
        "rmf_demos_fleet_adapter/__init__.py",
        "rmf_demos_fleet_adapter/fleet_adapter.py",
        "rmf_demos_fleet_adapter/fleet_manager.py",
        "rmf_demos_fleet_adapter/manage_lane.py",
    ],
    imports = ["."],
    deps = [
        "@launch_xml",
        "@rclpy",
        "@rmf_fleet_msgs//:py",
        "@rmf_task_msgs//:py",
        requirement("numpy"),
        requirement("pydantic"),
        requirement("pyproj"),
        requirement("pyyaml"),
        requirement("requests"),
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "config.yaml",
        "//launch:launch_files",
    ],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    console_scripts = {
        "fleet_adapter": "rmf_demos_fleet_adapter.fleet_adapter:main",
        "fleet_manager": "rmf_demos_fleet_adapter.fleet_manager:main",
        "manage_lane": "rmf_demos_fleet_adapter.manage_lane:main",
    },
    package_xml = "package.xml",
    python = [":rmf_demos_fleet_adapter"],
    deps = [":ament_index"] + [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@launch_xml//:ament_package",
        "@rclpy//:ament_package",
        "@rmf_fleet_adapter_python//:ament_package",
        "@rmf_fleet_msgs//:ament_package",
        "@rmf_task_msgs//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
