load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@lanelet2_core//:lanelet2_core": "@lanelet2_core//:lanelet2_core_library",
    "@lanelet2_io//:lanelet2_io": "@lanelet2_io//:lanelet2_io_library",
    "@lanelet2_matching//:lanelet2_matching": "@lanelet2_matching//:lanelet2_matching_library",
    "@lanelet2_projection//:lanelet2_projection": "@lanelet2_projection//:lanelet2_projection_library",
    "@lanelet2_routing//:lanelet2_routing": "@lanelet2_routing//:lanelet2_routing_library",
    "@lanelet2_traffic_rules//:lanelet2_traffic_rules": "@lanelet2_traffic_rules//:lanelet2_traffic_rules_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

HEADERS = ["include/lanelet2_examples/internal/ExampleHelpers.h"]

cc_library(
    name = "example_helpers",
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values(),
)

[
    cc_binary(
        name = example,
        srcs = ["src/{}/main.cpp".format(example)],
        data = [":ament_index"],
        dynamic_deps = [":transitive_dynamic_deps"],
        local_defines = ['PKG_DIR=\\".\\"'],
        deps = DEPENDENCIES.values() + [":example_helpers"],
    )
    for example in [
        "01_dealing_with_lanelet_primitives",
        "02_regulatory_elements",
        "03_lanelet_map",
        "04_reading_and_writing",
        "05_traffic_rules",
        "06_routing",
        "07_matching",
    ]
]

### PACKAGING

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@lanelet2_core//:ament_package",
        "@lanelet2_io//:ament_package",
        "@lanelet2_matching//:ament_package",
        "@lanelet2_projection//:ament_package",
        "@lanelet2_routing//:ament_package",
        "@lanelet2_traffic_rules//:ament_package",
    ],
)

ament_package(
    name = "ament_package",
    build_type = "cmake",
    cmake_export_targets = False,
    executables = [
        ":01_dealing_with_lanelet_primitives",
        ":02_regulatory_elements",
        ":03_lanelet_map",
        ":04_reading_and_writing",
        ":05_traffic_rules",
        ":06_routing",
        ":07_matching",
    ],
    headers = HEADERS,
    include_prefix = "",
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_core//:ament_package",
        "@lanelet2_core//:ament_package",
        "@lanelet2_io//:ament_package",
        "@lanelet2_matching//:ament_package",
        "@lanelet2_projection//:ament_package",
        "@lanelet2_python//:ament_package",
        "@lanelet2_routing//:ament_package",
        "@lanelet2_traffic_rules//:ament_package",
        "@mrt_cmake_modules//:ament_package",
        "@ros2cli//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
