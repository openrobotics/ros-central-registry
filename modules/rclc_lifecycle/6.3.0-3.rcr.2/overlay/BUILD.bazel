load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/rclc_lifecycle/rclc_lifecycle.h",
        "include/rclc_lifecycle/visibility_control.h",
    ],
    includes = ["src/rcl"],
)

HEADERS = [
    "include/rclc_lifecycle/rclc_lifecycle.h",
    "include/rclc_lifecycle/visibility_control.h",
]

DEPENDENCIES = {
    "@rcl_lifecycle//:rcl_lifecycle": "@rcl_lifecycle//:rcl_lifecycle_library",
    "@rclc//:rclc": "@rclc//:rclc_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

cc_library(
    name = "rclc_lifecycle_library",
    srcs = ["src/rclc_lifecycle/rclc_lifecycle.c"],
    hdrs = HEADERS,
    defines = ["RCLC_LIFECYCLE_MAX_STRING_LENGTH=20"],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@lifecycle_msgs//:c",
        "@std_msgs//:c",
    ],
)

cc_shared_library(
    name = "rclc_lifecycle",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rclc_lifecycle_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rclc_lifecycle"],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "ament_cmake",
        "rcl",
        "rcl_lifecycle",
        "rcutils",
        "rosidl_generator_c",
    ],
    headers = HEADERS,
    include_prefix = "",
    libraries = [":rclc_lifecycle"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@osrf_testing_tools_cpp//:ament_package",
        "@rcl_lifecycle//:ament_package",
        "@rclc//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
