load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

exports_files([
    "fixtures/param_list_hang_node.py",
    "fixtures/parameter_delete_node.py",
    "fixtures/parameter_node.py",
    "test_api.py",
    "test_copyright.py",
    "test_flake8.py",
    "test_pep257.py",
    "test_verb_delete.py",
    "test_verb_dump.py",
    "test_verb_get.py",
    "test_verb_list.py",
    "test_verb_load.py",
    "test_verb_set.py",
    "test_xmllint.py",
])

[py_pytest(
    name = test.removesuffix(".py"),
    srcs = ["{0}.py".format(test)],
    data = [
        "fixtures/param_list_hang_node.py",
        "fixtures/parameter_delete_node.py",
        "fixtures/parameter_node.py",
    ],
    tags = [
        "manual",
        "xfail",
    ] if test != "test_api" else [],
    deps = [
        "//:ros2param",
        "@launch",
        "@launch_ros",
        "@launch_testing",
        "@launch_testing_ros",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@ros2cli",
    ],
) for test in [
    "test_api",
    "test_verb_delete",
    "test_verb_dump",
    "test_verb_get",
    "test_verb_list",
    "test_verb_load",
    "test_verb_set",
]]
