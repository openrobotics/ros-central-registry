load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {}

CC_DEPS = []

cc_library(
    name = "moveit_task_constructor_capabilities_library",
    srcs = ["src/execute_task_solution_capability.cpp"],
    hdrs = [],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = ["test"],
    local_defines = ros_local_defines() + [
        "NDEBUG",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "moveit_task_constructor_capabilities",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":moveit_task_constructor_capabilities_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":moveit_task_constructor_capabilities"],
    package_xml = "package.xml",
    plugin_category = "moveit_ros_move_group",
    plugins = ["capabilities_plugin_description.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@controller_manager//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@moveit_configs_utils//:ament_package",
        "@moveit_core//:ament_package",
        "@moveit_resources_panda_moveit_config//:ament_package",
        "@moveit_ros_move_group//:ament_package",
        "@moveit_ros_planning//:ament_package",
        "@moveit_task_constructor_core//:ament_package",
        "@moveit_task_constructor_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp_action//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "moveit_core",
        "moveit_ros_move_group",
        "moveit_ros_planning",
        "moveit_task_constructor_core",
        "moveit_task_constructor_msgs",
        "pluginlib",
        "rclcpp_action",
        "std_msgs",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    libraries = [":moveit_task_constructor_capabilities"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@controller_manager//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@moveit_configs_utils//:ament_package",
        "@moveit_core//:ament_package",
        "@moveit_resources_panda_moveit_config//:ament_package",
        "@moveit_ros_move_group//:ament_package",
        "@moveit_ros_planning//:ament_package",
        "@moveit_task_constructor_core//:ament_package",
        "@moveit_task_constructor_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp_action//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
