load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@moveit_core//:moveit_exceptions": "@moveit_core//:moveit_exceptions_library",
    "@moveit_core//:moveit_kinematic_constraints": "@moveit_core//:moveit_kinematic_constraints_library",
    "@moveit_core//:moveit_planning_interface": "@moveit_core//:moveit_planning_interface_library",
    "@moveit_core//:moveit_planning_scene": "@moveit_core//:moveit_planning_scene_library",
    "@moveit_core//:moveit_robot_model": "@moveit_core//:moveit_robot_model_library",
    "@moveit_core//:moveit_robot_state": "@moveit_core//:moveit_robot_state_library",
    "@moveit_core//:moveit_robot_trajectory": "@moveit_core//:moveit_robot_trajectory_library",
    "@moveit_core//:moveit_trajectory_processing": "@moveit_core//:moveit_trajectory_processing_library",
    "@moveit_core//:moveit_utils": "@moveit_core//:moveit_utils_library",
    "@moveit_ros_move_group//:moveit_move_group_capabilities_base": "@moveit_ros_move_group//:moveit_move_group_capabilities_base_library",
    "@moveit_ros_planning//:moveit_cpp": "@moveit_ros_planning//:moveit_cpp_library",
    "@moveit_ros_planning//:moveit_plan_execution": "@moveit_ros_planning//:moveit_plan_execution_library",
    "@moveit_ros_planning//:moveit_planning_scene_monitor": "@moveit_ros_planning//:moveit_planning_scene_monitor_library",
    "@moveit_ros_planning//:moveit_trajectory_execution_manager": "@moveit_ros_planning//:moveit_trajectory_execution_manager_library",
    "@moveit_task_constructor_core//:moveit_task_constructor_core": "@moveit_task_constructor_core//:moveit_task_constructor_core_library",
    "@moveit_task_constructor_msgs//:cc_shared": "@moveit_task_constructor_msgs//:cc",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

CC_DEPS = [
    "@rosdistro//cc:fmt",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

collect_transitive_dynamic_deps(
    name = "test_transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":moveit_task_constructor_capabilities"],
)

cc_library(
    name = "moveit_task_constructor_capabilities_library",
    srcs = [
        "src/execute_task_solution_capability.cpp",
        "src/execute_task_solution_capability.h",
    ],
    hdrs = [],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = ["test"],
    local_defines = ros_local_defines() + [
        "NDEBUG",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "moveit_task_constructor_capabilities",
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@moveit_task_constructor_core//:transitive_dynamic_deps",
        "@moveit_task_constructor_msgs//:cc_shared",
        "@std_msgs//:cc_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":moveit_task_constructor_capabilities_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":moveit_task_constructor_capabilities"],
    package_xml = "package.xml",
    plugin_category = "moveit_ros_move_group",
    plugins = ["capabilities_plugin_description.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@controller_manager//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@moveit_configs_utils//:ament_package",
        "@moveit_core//:ament_package",
        "@moveit_resources_panda_moveit_config//:ament_package",
        "@moveit_ros_move_group//:ament_package",
        "@moveit_ros_planning//:ament_package",
        "@moveit_task_constructor_core//:ament_package",
        "@moveit_task_constructor_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp_action//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "moveit_core",
        "moveit_ros_move_group",
        "moveit_ros_planning",
        "moveit_task_constructor_core",
        "moveit_task_constructor_msgs",
        "pluginlib",
        "rclcpp_action",
        "std_msgs",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    libraries = [":moveit_task_constructor_capabilities"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@controller_manager//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@moveit_configs_utils//:ament_package",
        "@moveit_core//:ament_package",
        "@moveit_resources_panda_moveit_config//:ament_package",
        "@moveit_ros_move_group//:ament_package",
        "@moveit_ros_planning//:ament_package",
        "@moveit_task_constructor_core//:ament_package",
        "@moveit_task_constructor_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp_action//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
