load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

filegroup(
    name = "interface_templates",
    srcs = [
        "resource/idl__rosidl_typesupport_protobuf_c.hpp.em",
        "resource/idl__type_support.cpp.em",
        "resource/msg__rosidl_typesupport_protobuf_c.hpp.em",
        "resource/msg__type_support.cpp.em",
        "resource/srv__rosidl_typesupport_protobuf_c.hpp.em",
        "resource/srv__type_support.cpp.em",
        "resource/tmpl_forward_declarations.em",
        "resource/tmpl_include_directories.em",
    ],
)

exports_files(srcs = ["resource/rosidl_typesupport_protobuf_c__visibility_control.h.in"])

DEPENDENCIES = {
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
    "@rosidl_runtime_cpp//:rosidl_runtime_cpp": "@rosidl_runtime_cpp//:rosidl_runtime_cpp_library",
    "@rosidl_typesupport_interface//:rosidl_typesupport_interface": "@rosidl_typesupport_interface//:rosidl_typesupport_interface_library",
    "@rosidl_typesupport_protobuf//:rosidl_typesupport_protobuf": "@rosidl_typesupport_protobuf//:rosidl_typesupport_protobuf_library",
}

cc_library(
    name = "rosidl_typesupport_protobuf_c_library",
    srcs = [
        "src/identifier.cpp",
        "src/to_ros_c_string.cpp",
        "src/wstring_conversion.cpp",
    ],
    hdrs = [
        "include/rosidl_typesupport_protobuf_c/identifier.hpp",
        "include/rosidl_typesupport_protobuf_c/to_ros_c_string.hpp",
        "include/rosidl_typesupport_protobuf_c/wstring_conversion.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines() + ["ROSIDL_TYPESUPPORT_PROTOBUF_BUILDING_DLL"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rosidl_typesupport_protobuf_c",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rosidl_typesupport_protobuf_c_library"],
)

py_library(
    name = "rosidl_typesupport_protobuf_c_py",
    srcs = ["rosidl_typesupport_protobuf_c/__init__.py"],
    deps = [
        "@rosidl_pycommon",
        "@rosidl_typesupport_protobuf//:rosidl_typesupport_protobuf_py",
    ],
)

genrule(
    name = "cli_rename",
    srcs = ["bin/rosidl_typesupport_protobuf_c"],
    outs = ["bin/rosidl_typesupport_protobuf_c.py"],
    cmd = "cp $(location :bin/rosidl_typesupport_protobuf_c) $(location :bin/rosidl_typesupport_protobuf_c.py)",
)

py_binary(
    name = "cli",
    srcs = [":bin/rosidl_typesupport_protobuf_c.py"],
    main = ":bin/rosidl_typesupport_protobuf_c.py",
    deps = [":rosidl_typesupport_protobuf_c_py"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rosidl_typesupport_protobuf_c"],
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@rmw//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_adapter_proto//:ament_package",
        "@rosidl_cmake//:ament_package",
        "@rosidl_generator_cpp//:ament_package",
        "@rosidl_parser//:ament_package",
        "@rosidl_pycommon//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
        "@rosidl_typesupport_interface//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
        "@rosidl_typesupport_protobuf//:ament_package",
    ],
)
