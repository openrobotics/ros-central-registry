load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@ortools_vendor//:ortools": "@ortools_vendor//:ortools_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@ortools_vendor//:_gen_textual_hdrs",
    "@rosdistro//cc:boost.algorithm",
    "@rosdistro//cc:boost.math",
    "@rosdistro//cc:boost.optional",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:nlohmann_json",
]

cc_library(
    name = "matplot_library",
    srcs = [":gen_fields2cover_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_extra_66",
        ":gen_geos_c_h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "include/fields2cover",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "matplot",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":matplot_library"],
)

cc_library(
    name = "steering_functions_library",
    srcs = [":gen_fields2cover_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_extra_66",
        ":gen_geos_c_h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "include/fields2cover",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "steering_functions",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":steering_functions_library"],
)

cc_library(
    name = "Fields2Cover_library",
    srcs = [":gen_fields2cover_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_extra_66",
        ":gen_geos_c_h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "include/fields2cover",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "MATPLOT_BUILD_HIGH_RESOLUTION_WORLD_MAP",
        "NDEBUG",
        "NOMINMAX",
        "OR_TOOLS_AS_DYNAMIC_LIB",
        "USE_BOP",
        "USE_GLOP",
        "USE_LP_PARSER",
        "USE_MATH_OPT",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":matplot_library",
        ":steering_functions_library",
    ],
)

cc_shared_library(
    name = "Fields2Cover",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":Fields2Cover_library"],
)

write_file(
    name = "gen_fields2cover_stub_cpp",
    out = "_gen/fields2cover_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

write_file(
    name = "gen_extra_66",
    out = "_gen/include/matplot/detail/exports.h",
    content = ["\n#ifndef MATPLOT_EXPORTS_H\n#define MATPLOT_EXPORTS_H\n\n#ifdef SHARED_EXPORTS_BUILT_AS_STATIC\n#  define MATPLOT_EXPORTS\n#  define MATPLOT_NO_EXPORT\n#else\n#  ifndef MATPLOT_EXPORTS\n#    ifdef matplot_EXPORTS\n        /* We are building this library */\n#      define MATPLOT_EXPORTS __attribute__((visibility(\"default\")))\n#    else\n        /* We are using this library */\n#      define MATPLOT_EXPORTS __attribute__((visibility(\"default\")))\n#    endif\n#  endif\n\n#  ifndef MATPLOT_NO_EXPORT\n#    define MATPLOT_NO_EXPORT __attribute__((visibility(\"hidden\")))\n#  endif\n#endif\n\n#ifndef MATPLOT_DEPRECATED\n#  define MATPLOT_DEPRECATED __attribute__ ((__deprecated__))\n#endif\n\n#ifndef MATPLOT_DEPRECATED_EXPORT\n#  define MATPLOT_DEPRECATED_EXPORT MATPLOT_EXPORTS MATPLOT_DEPRECATED\n#endif\n\n#ifndef MATPLOT_DEPRECATED_NO_EXPORT\n#  define MATPLOT_DEPRECATED_NO_EXPORT MATPLOT_NO_EXPORT MATPLOT_DEPRECATED\n#endif\n\n/* NOLINTNEXTLINE(readability-avoid-unconditional-preprocessor-if) */\n#if 0 /* DEFINE_NO_DEPRECATED */\n#  ifndef MATPLOT_NO_DEPRECATED\n#    define MATPLOT_NO_DEPRECATED\n#  endif\n#endif\n\n#endif /* MATPLOT_EXPORTS_H */\n"],
)

write_file(
    name = "gen_geos_c_h",
    out = "_gen/include/geos_c.h",
    content = ["#ifndef RCR_GEOS_C_H_\n#define RCR_GEOS_C_H_\nextern \"C\" {\ntypedef struct GEOSContextHandle_HS * GEOSContextHandle_t;\ntypedef struct GEOSGeom_t GEOSGeometry;\ntypedef struct GEOSCoordSeq_t GEOSCoordSequence;\ntypedef void (*GEOSMessageHandler)(const char * fmt, ...);\ninline GEOSContextHandle_t GEOS_init_r() { return reinterpret_cast<GEOSContextHandle_t>(1); }\ninline void GEOS_finish_r(GEOSContextHandle_t) {}\ninline void initGEOS(GEOSMessageHandler, GEOSMessageHandler) {}\ninline void finishGEOS() {}\ninline GEOSMessageHandler GEOSContext_setNoticeHandler_r(GEOSContextHandle_t, GEOSMessageHandler h) { return h; }\ninline GEOSMessageHandler GEOSContext_setErrorHandler_r(GEOSContextHandle_t, GEOSMessageHandler h) { return h; }\ninline GEOSCoordSequence * GEOSCoordSeq_create(unsigned int, unsigned int) { return reinterpret_cast<GEOSCoordSequence *>(1); }\ninline GEOSCoordSequence * GEOSCoordSeq_create_r(GEOSContextHandle_t, unsigned int, unsigned int) { return reinterpret_cast<GEOSCoordSequence *>(1); }\ninline int GEOSCoordSeq_setX(GEOSCoordSequence *, unsigned int, double) { return 1; }\ninline int GEOSCoordSeq_setY(GEOSCoordSequence *, unsigned int, double) { return 1; }\ninline int GEOSCoordSeq_setX_r(GEOSContextHandle_t, GEOSCoordSequence *, unsigned int, double) { return 1; }\ninline int GEOSCoordSeq_setY_r(GEOSContextHandle_t, GEOSCoordSequence *, unsigned int, double) { return 1; }\ninline GEOSGeometry * GEOSGeom_createLinearRing(GEOSCoordSequence *) { return reinterpret_cast<GEOSGeometry *>(1); }\ninline GEOSGeometry * GEOSGeom_createLinearRing_r(GEOSContextHandle_t, GEOSCoordSequence *) { return reinterpret_cast<GEOSGeometry *>(1); }\ninline GEOSGeometry * GEOSGeom_createPolygon(GEOSGeometry *, GEOSGeometry **, unsigned int) { return reinterpret_cast<GEOSGeometry *>(1); }\ninline GEOSGeometry * GEOSGeom_createPolygon_r(GEOSContextHandle_t, GEOSGeometry *, GEOSGeometry **, unsigned int) { return reinterpret_cast<GEOSGeometry *>(1); }\ninline int GEOSNormalize(GEOSGeometry *) { return 0; }\ninline int GEOSNormalize_r(GEOSContextHandle_t, GEOSGeometry *) { return 0; }\ninline char GEOSIntersects(const GEOSGeometry *, const GEOSGeometry *) { return 1; }\ninline char GEOSIntersects_r(GEOSContextHandle_t, const GEOSGeometry *, const GEOSGeometry *) { return 1; }\ninline GEOSGeometry * GEOSIntersection(const GEOSGeometry *, const GEOSGeometry *) { return reinterpret_cast<GEOSGeometry *>(1); }\ninline GEOSGeometry * GEOSIntersection_r(GEOSContextHandle_t, const GEOSGeometry *, const GEOSGeometry *) { return reinterpret_cast<GEOSGeometry *>(1); }\ninline int GEOSArea(const GEOSGeometry *, double * area) { if (area) *area = 0.0; return 1; }\ninline int GEOSArea_r(GEOSContextHandle_t, const GEOSGeometry *, double * area) { if (area) *area = 0.0; return 1; }\ninline void GEOSGeom_destroy(GEOSGeometry *) {}\ninline void GEOSGeom_destroy_r(GEOSContextHandle_t, GEOSGeometry *) {}\n}\n#endif\n"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":matplot",
        ":steering_functions",
        ":Fields2Cover",
    ],
    package_xml = "package.xml",
    sonames = {
        "matplot": [
            "libmatplot.so.1",
            "libmatplot.so.1.2.0",
        ],
    },
    deps = [
        "@ortools_vendor//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    egg_info = False,
    headers = [
        ":gen_extra_66",
    ] + glob(["include/**"]),
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":matplot",
        ":steering_functions",
        ":Fields2Cover",
    ],
    package_xml = "package.xml",
    sonames = {
        "matplot": [
            "libmatplot.so.1",
            "libmatplot.so.1.2.0",
        ],
    },
    deps = [":ament_index"] + [
        "@ortools_vendor//:ament_package",
    ],
)
