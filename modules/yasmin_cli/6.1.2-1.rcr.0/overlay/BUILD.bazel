load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "yasmin_cli",
    srcs = [
        "yasmin_cli/__init__.py",
        "yasmin_cli/command/__init__.py",
        "yasmin_cli/command/yasmin.py",
        "yasmin_cli/completer.py",
        "yasmin_cli/verb/__init__.py",
        "yasmin_cli/verb/_xml_utils.py",
        "yasmin_cli/verb/edit.py",
        "yasmin_cli/verb/info.py",
        "yasmin_cli/verb/list.py",
        "yasmin_cli/verb/print.py",
        "yasmin_cli/verb/run.py",
        "yasmin_cli/verb/test.py",
        "yasmin_cli/verb/validate.py",
        "yasmin_cli/verb/viewer.py",
    ],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@rclpy",
        "@ros2cli",
        "@yasmin_plugins_manager",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":yasmin_cli"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_index_python//:ament_package",
        "@rclpy//:ament_package",
        "@ros2cli//:ament_package",
        "@rosdistro//:ament_package",
        "@yasmin//:ament_package",
        "@yasmin_editor//:ament_package",
        "@yasmin_factory//:ament_package",
        "@yasmin_plugins_manager//:ament_package",
        "@yasmin_viewer//:ament_package",
    ],
)
