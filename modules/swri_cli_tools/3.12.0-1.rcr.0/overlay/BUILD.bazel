load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "swri_cli_tools",
    srcs = [
        "swri_cli_tools/__init__.py",
        "swri_cli_tools/api/__init__.py",
        "swri_cli_tools/api/_node_info.py",
        "swri_cli_tools/api/_parameter_info.py",
        "swri_cli_tools/command/__init__.py",
        "swri_cli_tools/command/swri.py",
        "swri_cli_tools/document/__init__.py",
        "swri_cli_tools/document/_document.py",
        "swri_cli_tools/verb/__init__.py",
        "swri_cli_tools/verb/document.py",
    ],
    imports = ["."],
    deps = [
        "@marti_introspection_msgs//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@ros2cli",
        "@ros2node",
        "@ros2param",
        "@ros2topic",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":swri_cli_tools"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@marti_introspection_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@ros2cli//:ament_package",
        "@ros2node//:ament_package",
        "@ros2param//:ament_package",
        "@ros2topic//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
