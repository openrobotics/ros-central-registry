load("@launch_testing//:defs.bzl", "launch_test")
load("@pip_ros//:requirements.bzl", "requirement")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

launch_test(
    name = "test_disparity_node",
    src = "test_disparity_node.py",
    data = [
        "data/README.md",
        "data/aloe-L.png",
        "data/aloe-R.png",
        "data/aloe-disp.png",
        "fixtures/disparity_image_publisher.py",
        "fixtures/stereo_image_publisher.py",
    ] + [
        "//:ament_index",
        "//:disparity_node",
        "//:point_cloud_node",
        "@image_proc//:ament_index",
        "@rclcpp_components//:ament_index",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [
        "@launch_ros",
        "@rclpy",
        "@rules_python//python/runfiles",
        "@sensor_msgs//:py",
        "@stereo_msgs//:py",
        requirement("numpy"),
        requirement("opencv-python"),
    ],
)

