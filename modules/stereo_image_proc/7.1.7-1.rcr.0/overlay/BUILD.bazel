load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@launch_testing//:defs.bzl", "launch_test")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### LIBRARIES

HEADERS = glob(
    [
        "include/**/*.h",
        "include/**/*.hpp",
    ],
    allow_empty = True,
)

DEPENDENCIES = {
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@image_geometry//:image_geometry": "@image_geometry//:image_geometry_library",
    "@image_proc//:image_proc": "@image_proc//:image_proc_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
}

cc_library(
    name = "stereo_image_proc_library",
    srcs = [
        "src/stereo_image_proc/disparity_node.cpp",
        "src/stereo_image_proc/point_cloud_node.cpp",
        "src/stereo_image_proc/stereo_processor.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@sensor_msgs//:cc",
        "@stereo_msgs//:cc",
    ],
)

cc_shared_library(
    name = "stereo_image_proc",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":stereo_image_proc_library"],
    deps = [":stereo_image_proc_library"],
)

### COMPONENTS REGISTER

rclcpp_components_register_node(
    name = "disparity_node",
    component = ":stereo_image_proc",
    node_name = "disparity_node",
    plugin = "stereo_image_proc::DisparityNode",
)

rclcpp_components_register_node(
    name = "point_cloud_node",
    component = ":stereo_image_proc",
    node_name = "point_cloud_node",
    plugin = "stereo_image_proc::PointCloudNode",
)

### AMENT INDEX

ament_index(
    name = "ament_index",
    components = [
        ":disparity_node_record",
        ":point_cloud_node_record",
    ],
    data = glob(["launch/**"]),
    executables = [
        ":disparity_node",
        ":point_cloud_node",
    ],
    export_name = "stereo_image_proc",
    libraries = [":stereo_image_proc"],
    package_xml = "package.xml",
    plugin_category = "rclcpp_components",
)

launch_ros_binary(
    name = "stereo_image_proc_launch",
    src = "launch/stereo_image_proc.launch.py",
    data = [
        ":ament_index",
        "@image_proc//:ament_index",
        "@rclcpp_components//:ament_index",
    ],
)

### TESTING

# Tagged manual/xfail: test fixture stereo_image_publisher.py imports cv2 from
# @pip_ros opencv-python (compiled against NumPy 1.x), which fails under NumPy 2.5.2.
[
    launch_test(
        name = name,
        src = "test/{}.py".format(name),
        data = glob([
            "test/fixtures/**",
            "test/data/**",
        ]) + [
            ":ament_index",
            ":disparity_node",
            ":point_cloud_node",
            "@image_proc//:ament_index",
            "@rclcpp_components//:ament_index",
        ],
        tags = [
            "manual",
            "xfail",
        ],
        deps = [
            "@launch_ros",
            "@rclpy",
            "@rules_python//python/runfiles",
            "@sensor_msgs//:py",
            "@stereo_msgs//:py",
            requirement("numpy"),
            requirement("opencv-python"),
        ],
    )
    for name in [
        "test_disparity_node",
        "test_point_cloud_node",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_targets = False,
    executables = [
        ":disparity_node",
        ":point_cloud_node",
    ],
    headers = HEADERS,
    libraries = [":stereo_image_proc"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@image_geometry//:ament_package",
        "@image_proc//:ament_package",
        "@image_transport//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@message_filters//:ament_package",
        "@python_cmake_module//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclpy//:ament_package",
        "@ros_testing//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@stereo_msgs//:ament_package",
    ],
)
