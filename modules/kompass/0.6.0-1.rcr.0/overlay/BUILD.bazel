load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

py_library(
    name = "kompass",
    srcs = [
        "kompass/__init__.py",
        "kompass/_external_types.py",
        "kompass/actions.py",
        "kompass/callbacks.py",
        "kompass/cli.py",
        "kompass/components/__init__.py",
        "kompass/components/_modes.py",
        "kompass/components/_vision_follower.py",
        "kompass/components/component.py",
        "kompass/components/controller.py",
        "kompass/components/defaults.py",
        "kompass/components/drive_manager.py",
        "kompass/components/map_server.py",
        "kompass/components/mapper.py",
        "kompass/components/motion_server.py",
        "kompass/components/planner.py",
        "kompass/components/ros.py",
        "kompass/components/utils.py",
        "kompass/config.py",
        "kompass/control.py",
        "kompass/data_types.py",
        "kompass/executable.py",
        "kompass/monitor.py",
        "kompass/robot.py",
        "kompass/ros.py",
        "kompass/utils.py",
    ],
    imports = ["."],
    deps = [
        "@automatika_ros_sugar//:py",
        "@kompass_interfaces//:py",
        requirement("numpy"),
        requirement("opencv-python"),
        requirement("packaging"),
        requirement("pyyaml"),
    ],
)

ament_package(
    name = "ament_package",
    console_scripts = {
        "cli": "kompass.cli:main",
        "executable": "kompass.executable:main",
        "turtlebot3_test": "recipes.turtlebot3:kompass_bringup",
    },
    data = [
        "params/turtlebot3.json",
        "params/turtlebot3.toml",
        "params/turtlebot3.yaml",
    ],
    package_xml = "package.xml",
    python = [":kompass"],
    setup_cfg = "setup.cfg",
    deps = [
        "@automatika_ros_sugar//:ament_package",
        "@kompass_interfaces//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
