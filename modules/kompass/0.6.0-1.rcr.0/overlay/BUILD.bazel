load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "kompass",
    srcs = glob(["kompass/**/*.py"]),
    imports = ["."],
    deps = [
        "@automatika_ros_sugar//:py",
        "@kompass_interfaces//:py",
        requirement("numpy"),
        requirement("opencv-python"),
        requirement("packaging"),
        requirement("pyyaml"),
    ],
)

py_pytest(
    name = "test_path_control",
    srcs = ["test/test_path_control.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":kompass"],
)

py_pytest(
    name = "test_planner",
    srcs = ["test/test_planner.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":kompass"],
)

py_pytest(
    name = "test_vision_tracking",
    srcs = ["test/test_vision_tracking.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":kompass"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "cli": "kompass.cli:main",
        "executable": "kompass.executable:main",
        "turtlebot3_test": "recipes.turtlebot3:kompass_bringup",
    },
    data = [
        "params/turtlebot3.json",
        "params/turtlebot3.toml",
        "params/turtlebot3.yaml",
    ],
    package_xml = "package.xml",
    python = [":kompass"],
    deps = [
        "@automatika_ros_sugar//:ament_package",
        "@kompass_interfaces//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
