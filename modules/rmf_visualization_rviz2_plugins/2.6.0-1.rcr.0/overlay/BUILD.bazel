load("@ament_cmake//:defs.bzl", "ament_cmake_export_include_directories")
load("@qt//:qt.bzl", "qt_cc_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@resource_retriever//:resource_retriever": "@resource_retriever//:resource_retriever_library",
    "@rmf_traffic_ros2//:rmf_traffic_ros2": "@rmf_traffic_ros2//:rmf_traffic_ros2_library",
    "@rmf_utils//:rmf_utils": "@rmf_utils//:rmf_utils_library",
    "@rosdistro//cc:OgreMain": "@rosdistro//cc:OgreMain_library",
    "@rosdistro//cc:OgreOverlay": "@rosdistro//cc:OgreOverlay_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:curl": "@rosdistro//cc:curl_library",
    "@rosdistro//cc:libuuid": "@rosdistro//cc:libuuid_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:proj": "@rosdistro//cc:proj_library",
    "@rosdistro//cc:sqlite3": "@rosdistro//cc:sqlite3_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
    "@rviz_common//:rviz_common": "@rviz_common//:rviz_common_library",
    "@rviz_default_plugins//:rviz_default_plugins": "@rviz_default_plugins//:rviz_default_plugins_library",
    "@rviz_rendering//:rviz_rendering": "@rviz_rendering//:rviz_rendering_library",
}

CC_DEPS = [
    "@qtbase//:widgets",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rmf_door_msgs//:cc",
    "@rmf_lift_msgs//:cc",
    "@rmf_traffic_msgs//:cc",
    "@rmf_visualization_msgs//:cc",
    "@rosdistro//cc:eigen",
]

qt_cc_library(
    name = "rmf_visualization_rviz2_plugins_library",
    srcs = [
        "src/DoorPanel.cpp",
        "src/LiftPanel.cpp",
        "src/NegotiationModel.cpp",
        "src/SchedulePanel.cpp",
    ],
    hdrs = [
        "src/DoorPanel.hpp",
        "src/LiftPanel.hpp",
        "src/SchedulePanel.hpp",
    ] + [
        "src/NegotiationModel.hpp",
        "src/StandardNames.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
    ],
    local_defines = ros_local_defines() + [
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "RVIZ_DEFAULT_PLUGINS_BUILDING_LIBRARY",
        "_FILE_OFFSET_BITS=64",
    ],
    moc_hdrs = [
        "src/DoorPanel.hpp",
        "src/LiftPanel.hpp",
        "src/SchedulePanel.hpp",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rmf_visualization_rviz2_plugins",
    dynamic_deps = DEPENDENCIES.keys() + [
        "@qtbase//:widgets_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":rmf_visualization_rviz2_plugins_library"],
)

ament_cmake_export_include_directories(
    name = "ament_cmake_export_include_directories_extras",
    include_dirs = ["include"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":rmf_visualization_rviz2_plugins",
    ],
    package_xml = "package.xml",
    plugin_category = "rviz_common",
    plugins = ["plugin_description.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@resource_retriever//:ament_package",
        "@rmf_door_msgs//:ament_package",
        "@rmf_lift_msgs//:ament_package",
        "@rmf_traffic_msgs//:ament_package",
        "@rmf_traffic_ros2//:ament_package",
        "@rmf_utils//:ament_package",
        "@rmf_visualization_msgs//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_default_plugins//:ament_package",
        "@rviz_rendering//:ament_package",
    ],
)

ament_package(
    cmake = [
        ":ament_cmake_export_include_directories_extras",
    ],
    cmake_export_dependencies_list = [
        "rclcpp",
        "rviz_common",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    libraries = [
        ":rmf_visualization_rviz2_plugins",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@resource_retriever//:ament_package",
        "@rmf_door_msgs//:ament_package",
        "@rmf_lift_msgs//:ament_package",
        "@rmf_traffic_msgs//:ament_package",
        "@rmf_traffic_ros2//:ament_package",
        "@rmf_utils//:ament_package",
        "@rmf_visualization_msgs//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_default_plugins//:ament_package",
        "@rviz_rendering//:ament_package",
    ],
)
