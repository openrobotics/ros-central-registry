    includes = [
        "include",
        "include/nav2_lifecycle_manager",
        "test",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":nav2_lifecycle_manager_core_library"],
)

