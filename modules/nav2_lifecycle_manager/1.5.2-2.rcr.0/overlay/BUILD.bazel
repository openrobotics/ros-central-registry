cc_library(
    name = "nav2_lifecycle_manager_core_library",
    srcs = [
        "src/lifecycle_manager.cpp",
        "src/lifecycle_manager_client.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
