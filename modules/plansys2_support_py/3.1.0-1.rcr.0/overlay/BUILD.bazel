load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

py_library(
    name = "plansys2_support_py",
    srcs = [
        "plansys2_support_py/ActionExecutorClient.py",
        "plansys2_support_py/DomainExpertClient.py",
        "plansys2_support_py/ExecutorClient.py",
        "plansys2_support_py/Parser.py",
        "plansys2_support_py/Planner.py",
        "plansys2_support_py/PlannerClient.py",
        "plansys2_support_py/ProblemExpertClient.py",
        "plansys2_support_py/__init__.py",
        "plansys2_support_py/core/PlanSolverBase.py",
        "plansys2_support_py/core/PluginProvider.py",
        "plansys2_support_py/core/__init__.py",
    ],
    imports = ["."],
    deps = [
        "@lifecycle_msgs//:py",
        "@plansys2_msgs//:py",
        "@rclpy",
    ],
)

ament_package(
    name = "ament_package",
    build_type = "ament_python",
    console_scripts = {"planner": "plansys2_support_py.Planner:main"},
    package_xml = "package.xml",
    python = [":plansys2_support_py"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@plansys2_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
