load("@rosidl_default_generators//:defs.bzl", "ros_service")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

exports_files([
    "DebugLocalPlan.srv",
    "GenerateTrajectory.srv",
    "GenerateTwists.srv",
    "GetCriticScore.srv",
    "ScoreTrajectory.srv",
])

ros_service(
    name = "DebugLocalPlan",
    src = "DebugLocalPlan.srv",
    deps = [
        "//msg:LocalPlanEvaluation",
        "@geometry_msgs//msg:PoseStamped",
        "@nav_2d_msgs//msg:Twist2D",
        "@nav_msgs//msg:Path",
    ],
)

ros_service(
    name = "GenerateTrajectory",
    src = "GenerateTrajectory.srv",
    deps = [
        "//msg:Trajectory2D",
        "@geometry_msgs//msg:Pose",
        "@nav_2d_msgs//msg:Twist2D",
    ],
)

ros_service(
    name = "GenerateTwists",
    src = "GenerateTwists.srv",
    deps = [
        "@nav_2d_msgs//msg:Twist2D",
    ],
)

ros_service(
    name = "GetCriticScore",
    src = "GetCriticScore.srv",
    deps = [
        "//msg:CriticScore",
        "//msg:Trajectory2D",
        "@geometry_msgs//msg:PoseStamped",
        "@nav_2d_msgs//msg:Twist2D",
        "@nav_msgs//msg:Path",
    ],
)

ros_service(
    name = "ScoreTrajectory",
    src = "ScoreTrajectory.srv",
    deps = [
        "//msg:Trajectory2D",
        "//msg:TrajectoryScore",
        "@geometry_msgs//msg:PoseStamped",
        "@nav_2d_msgs//msg:Twist2D",
        "@nav_msgs//msg:Path",
    ],
)
