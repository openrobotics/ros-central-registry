load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

# TODO: rig_reconfigure fetches imgui docking branch (v1.89.8-docking) via
# CMake FetchContent, which is not yet available from @rosdistro//cc, so the
# rig_reconfigure executable cannot be built yet.

register_ament_files(
    name = "ament_files_0",
    files = [
        "resource/rig_reconfigure.png",
        "resource/rig_reconfigure_text.png",
    ],
    prefix = "share/rig_reconfigure/resource",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_1",
    files = ["resource/rig_reconfigure.svg"],
    prefix = "share/icons/hicolor/scalable/apps",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_2",
    files = ["resource/rig_reconfigure.desktop"],
    prefix = "share/applications",
    strip_prefix = "*",
)

ament_index(
    name = "ament_index",
    data = [
        ":ament_files_0",
        ":ament_files_1",
        ":ament_files_2",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
    ],
)
