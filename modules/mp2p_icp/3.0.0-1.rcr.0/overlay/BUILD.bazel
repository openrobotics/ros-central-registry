# mp2p_icp is a metapackage (upstream's CMakeLists.txt builds no targets): it
# only pulls in mp2p_icp_core (headless libraries and CLI apps) and
# mp2p_icp_viz (GUI apps) so existing <depend>mp2p_icp</depend> consumers keep
# getting both.

load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [
        "@mp2p_icp_core//:ament_package",
        "@mp2p_icp_viz//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
