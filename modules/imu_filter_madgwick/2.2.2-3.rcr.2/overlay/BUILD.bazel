load("@rosdistro//ament:ament_resource.bzl", "register_ament_resource")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
)

DEPENDENCIES = {
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:static_transform_broadcaster_node": "@tf2_ros//:static_transform_broadcaster_node_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "imu_filter_madgwick_library",
    srcs = [
        "src/imu_filter.cpp",
        "src/imu_filter_ros.cpp",
        "src/stateless_orientation.cpp",
    ],
    hdrs = [
        "include/imu_filter_madgwick/base_node.hpp",
        "include/imu_filter_madgwick/imu_filter.h",
        "include/imu_filter_madgwick/imu_filter_ros.h",
        "include/imu_filter_madgwick/stateless_orientation.h",
        "include/imu_filter_madgwick/visibility_control.h",
        "include/imu_filter_madgwick/world_frame.h",
    ],
    includes = [
        "include",
        "include/imu_filter_madgwick",
        "test",
    ],
    local_defines = ros_local_defines() + ["IMU_FILTER_MADGWICK_CPP_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "imu_filter_madgwick",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":imu_filter_madgwick_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":imu_filter_madgwick"],
)

cc_binary(
    name = "imu_filter_madgwick_node",
    srcs = ["src/imu_filter_node.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/imu_filter_madgwick",
        "test",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":imu_filter_madgwick_library"],
)

register_ament_resource(
    name = "res_rclcpp_components",
    category = "rclcpp_components",
    content = "ImuFilterMadgwickRos;lib/libimu_filter_madgwick.so\n",
)

ament_index(
    name = "ament_index",
    data = [
        "config/imu_filter.yaml",
        "//launch:launch_files",
    ],
    libraries = [":imu_filter_madgwick"],
    package_xml = "package.xml",
    deps = [
        ":res_rclcpp_components",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_name = "export_imu_filter_madgwick",
    executables = [":imu_filter_madgwick_node"],
    headers = [
        "include/imu_filter_madgwick/base_node.hpp",
        "include/imu_filter_madgwick/imu_filter.h",
        "include/imu_filter_madgwick/imu_filter_ros.h",
        "include/imu_filter_madgwick/stateless_orientation.h",
        "include/imu_filter_madgwick/visibility_control.h",
        "include/imu_filter_madgwick/world_frame.h",
    ],
    include_prefix = "",
    libraries = [":imu_filter_madgwick"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
