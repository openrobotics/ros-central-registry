load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "imu_filter.launch.py",
        "imu_filter_component.launch.py",
    ],
)

launch_ros_binary(
    name = "imu_filter_launch",
    src = "imu_filter.launch.py",
    data = [
        "//:ament_index",
        "//:imu_filter_madgwick_node",
    ],
    deps = ["@ament_index_python"],
)

launch_ros_binary(
    name = "imu_filter_component_launch",
    src = "imu_filter_component.launch.py",
    data = [
        "//:ament_index",
        "@rclcpp_components//:ament_index",
        "@rclcpp_components//:component_container",
    ],
    deps = [
        "@ament_index_python",
        requirement("pyyaml"),
    ],
)
