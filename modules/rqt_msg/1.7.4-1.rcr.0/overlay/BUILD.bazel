load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### DATA

ament_index(
    name = "ament_index",
    data = ["resource/messages.ui"] + ["plugin.xml"],
    package_xml = "package.xml",
    deps = ["@rqt_gui_py//:ament_index"],
)

### LIBRARIES

py_library(
    name = "rqt_msg",
    srcs = [
        "src/rqt_msg/__init__.py",
        "src/rqt_msg/main.py",
        "src/rqt_msg/messages.py",
        "src/rqt_msg/messages_tree_model.py",
        "src/rqt_msg/messages_tree_view.py",
        "src/rqt_msg/messages_widget.py",
    ],
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@ament_index_python",
        "@python_qt_binding",
        "@rclpy",
        "@rosidl_runtime_py",
        "@rqt_console",
        "@rqt_gui",
        "@rqt_gui_py",
        "@rqt_py_common",
    ],
)

### EXECUTABLES

py_binary(
    name = "gui",
    srcs = ["src/rqt_msg/main.py"],
    args = ["--force-discover"],
    main = "src/rqt_msg/main.py",
    deps = [":rqt_msg"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"rqt_msg": "rqt_msg.main:main"},
    package_xml = "package.xml",
    python = [":rqt_msg"],
    python_strip_prefix = "src",
    setup_cfg = "setup.cfg",
    deps = [
        ":ament_index",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_xmllint//:ament_package",
        "@python_qt_binding//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_py//:ament_package",
        "@rqt_console//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@rqt_py_common//:ament_package",
    ],
)
