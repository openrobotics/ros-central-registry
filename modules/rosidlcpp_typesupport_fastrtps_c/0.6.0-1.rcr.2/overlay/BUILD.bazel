load("@rosdistro//ament:ament_resource.bzl", "register_ament_resource")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rosidlcpp_generator_core//:rosidlcpp_generator_core": "@rosidlcpp_generator_core//:rosidlcpp_generator_core_library",
    "@rosidlcpp_parser//:rosidlcpp_parser": "@rosidlcpp_parser//:rosidlcpp_parser_library",
}

CC_DEPS = [
    "@rosdistro//cc:fmt",
    "@rosdistro//cc:nlohmann_json",
]

cc_library(
    name = "rosidlcpp_typesupport_fastrtps_c_library",
    hdrs = ["include/rosidlcpp_typesupport_fastrtps_c/rosidlcpp_typesupport_fastrtps_c.hpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/rosidlcpp_typesupport_fastrtps_c",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "rosidlcpp_typesupport_fastrtps_c",
    srcs = [
        "include/rosidlcpp_typesupport_fastrtps_c/rosidlcpp_typesupport_fastrtps_c.hpp",
        "src/rosidlcpp_typesupport_fastrtps_c/rosidlcpp_typesupport_fastrtps_c.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/rosidlcpp_typesupport_fastrtps_c",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

register_ament_resource(
    name = "res_rosidl_generator_packages",
    category = "rosidl_generator_packages",
    content = "",
)

ament_index(
    name = "ament_index",
    data = [
        "resource/idl__rosidl_typesupport_fastrtps_c.h.template",
        "resource/idl__type_support_c.cpp.template",
        "resource/msg__rosidl_typesupport_fastrtps_c.h.template",
        "resource/msg__type_support_c.cpp.template",
        "resource/rosidl_typesupport_fastrtps_c__visibility_control.h.in",
        "resource/srv__rosidl_typesupport_fastrtps_c.h.template",
        "resource/srv__type_support_c.cpp.template",
    ],
    lib_data = [
        ":rosidlcpp_typesupport_fastrtps_c",
    ],
    package_xml = "package.xml",
    deps = [
        ":res_rosidl_generator_packages",
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@rmw//:ament_package",
        "@rosidl_generator_c//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
        "@rosidl_typesupport_fastrtps_cpp//:ament_package",
        "@rosidl_typesupport_interface//:ament_package",
        "@rosidlcpp_generator_core//:ament_package",
        "@rosidlcpp_parser//:ament_package",
    ],
)

ament_package(
    cmake = [
        "cmake/rosidlcpp_typesupport_fastrtps_c_generate_interfaces.cmake",
    ],
    cmake_export_dependencies_list = [
        "rosidl_runtime_c",
        "fastcdr",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    cmake_extras = ["rosidlcpp_typesupport_fastrtps_c-extras.cmake"],
    headers = ["include/rosidlcpp_typesupport_fastrtps_c/rosidlcpp_typesupport_fastrtps_c.hpp"],
    include_prefix = "",
    package_xml = "package.xml",
    programs = [
        ":rosidlcpp_typesupport_fastrtps_c",
    ],
    deps = [":ament_index"] + [
        ":res_rosidl_generator_packages",
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@rmw//:ament_package",
        "@rosidl_generator_c//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
        "@rosidl_typesupport_fastrtps_cpp//:ament_package",
        "@rosidl_typesupport_interface//:ament_package",
        "@rosidlcpp_generator_core//:ament_package",
        "@rosidlcpp_parser//:ament_package",
    ],
)
