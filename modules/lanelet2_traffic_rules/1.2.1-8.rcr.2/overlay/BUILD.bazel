load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@lanelet2_core//:lanelet2_core": "@lanelet2_core//:lanelet2_core_library",
}

CC_DEPS = [
]

HEADERS = [
    "include/lanelet2_traffic_rules/Exceptions.h",
    "include/lanelet2_traffic_rules/GenericTrafficRules.h",
    "include/lanelet2_traffic_rules/GermanTrafficRules.h",
    "include/lanelet2_traffic_rules/TrafficRules.h",
    "include/lanelet2_traffic_rules/TrafficRulesFactory.h",
]

cc_library(
    name = "lanelet2_traffic_rules_library",
    srcs = [
        "src/GenericTrafficRules.cpp",
        "src/GermanTrafficRules.cpp",
        "src/TrafficRulesFactory.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "lanelet2_traffic_rules",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":lanelet2_traffic_rules_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":lanelet2_traffic_rules"],
)

# mrt_add_tests(test): one gtest per test/*.cpp.
cc_test(
    name = "lanelet2_traffic_rules-gtest-lanelet2_traffic_rules",
    srcs = [
        "test/lanelet2_traffic_rules.cpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["test"],
    deps = [
        ":lanelet2_traffic_rules_library",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_index(
    name = "ament_index",
    libraries = [":lanelet2_traffic_rules"],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    build_type = "cmake",
    cmake_export_targets = False,
    headers = HEADERS,
    include_prefix = "",
    libraries = [":lanelet2_traffic_rules"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_core//:ament_package",
        "@lanelet2_core//:ament_package",
        "@mrt_cmake_modules//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
