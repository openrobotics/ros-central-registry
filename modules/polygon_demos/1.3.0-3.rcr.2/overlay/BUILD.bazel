load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@color_util//:color_util": "@color_util//:color_util_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@polygon_msgs//:cc_shared": "@polygon_msgs//:cc",
    "@polygon_utils//:polygon_utils": "@polygon_utils//:polygon_utils_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

CC_DEPS = [
    "@angles//:angles",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "demo",
    srcs = ["src/polygon_demo.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

ament_index(
    name = "ament_index",
    data = [
        "config/demo_polygons.rviz",
        "//launch:launch_files",
    ],
    lib_data = [":demo"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@angles//:ament_package",
        "@color_util//:ament_package",
        "@geometry_msgs//:ament_package",
        "@polygon_msgs//:ament_package",
        "@polygon_rviz_plugins//:ament_package",
        "@polygon_utils//:ament_package",
        "@rclcpp//:ament_package",
        "@rviz2//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_default_plugins//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@angles//:ament_package",
        "@color_util//:ament_package",
        "@geometry_msgs//:ament_package",
        "@polygon_msgs//:ament_package",
        "@polygon_rviz_plugins//:ament_package",
        "@polygon_utils//:ament_package",
        "@rclcpp//:ament_package",
        "@rviz2//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_default_plugins//:ament_package",
    ],
)
