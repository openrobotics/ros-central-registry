load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PACKAGING

default_generators(
    dependencies = [
        "@autoware_common_msgs",
        "@autoware_perception_msgs",
        "@autoware_planning_msgs",
        "@autoware_vehicle_msgs",
        "@builtin_interfaces",
        "@geometry_msgs",
        "@std_msgs",
        "@unique_identifier_msgs",
    ],
    package_xml = "package.xml",
    deps = [
        "//msg:CandidateTrajectories",
        "//msg:CandidateTrajectory",
        "//msg:ControlPoint",
        "//msg:GeneratorInfo",
        "//msg:MetricReport",
        "//msg:PathPointWithLaneId",
        "//msg:PathWithLaneId",
        "//msg:PlanningFactor",
        "//msg:PlanningFactorArray",
        "//msg:RiskLevel",
        "//msg:RouteState",
        "//msg:SafetyFactor",
        "//msg:SafetyFactorArray",
        "//msg:Scenario",
        "//msg:ScoredCandidateTrajectories",
        "//msg:ScoredCandidateTrajectory",
        "//msg:ValidationReport",
        "//msg:ValidationReportArray",
        "//msg:VelocityLimit",
        "//msg:VelocityLimitClearCommand",
        "//msg:VelocityLimitConstraints",
        "//srv:ClearRoute",
        "//srv:LoadPlugin",
        "//srv:SetLaneletRoute",
        "//srv:SetWaypointRoute",
        "//srv:UnloadPlugin",
    ],
)

rosidl_ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@autoware_common_msgs//:ament_package",
        "@autoware_perception_msgs//:ament_package",
        "@autoware_planning_msgs//:ament_package",
        "@autoware_vehicle_msgs//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
        "@unique_identifier_msgs//:ament_package",
    ],
)
