load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "_root_test_files_0",
    srcs = [
        "config/crane-x7_links.csv",
        "config/ng_has_same_groups.yaml",
        "config/ng_has_same_joints.yaml",
        "config/ng_no_joint_config.yaml",
        "config/ng_no_joint_id.yaml",
        "config/ng_no_joint_operating_mode.yaml",
        "config/ng_no_joints.yaml",
        "config/ng_write_current_without_reading_position.yaml",
        "config/ng_write_velocity_without_reading_position.yaml",
        "config/ok_blank.yaml",
        "config/ok_has_dynamixel_name.yaml",
        "config/ok_single_joint.yaml",
        "config/ok_two_groups_four_joints.yaml",
        "config/sciurus17_links.csv",
        "config/test_links.csv",
    ],
)

[cc_test(
    name = test_name,
    size = "small",
    srcs = [test_name + ".cpp"],
    data = ["//:ament_index"],
    deps = [
        "//:rt_manipulators_cpp_library",
        "@rosdistro//cc:googletest",
    ],
) for test_name in [
    "test_joint",
    "test_kinematics_utils",
    "test_kinematics",
    "test_config_file_parser",
    "test_dynamixel_x",
    "test_dynamixel_xh",
    "test_dynamixel_p",
]]
