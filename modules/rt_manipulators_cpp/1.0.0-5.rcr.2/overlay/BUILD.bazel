load("@rosdistro//ament:ament_index.bzl", "ament_index")
load("@rosdistro//ament:ament_package.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

filegroup(
    name = "package_xml",
    srcs = ["package.xml"],
)

filegroup(
    name = "headers",
    srcs = [
        "include/config_file_parser.hpp",
        "include/dynamixel_base.hpp",
        "include/dynamixel_p.hpp",
        "include/dynamixel_ph42.hpp",
        "include/dynamixel_x.hpp",
        "include/dynamixel_xh430.hpp",
        "include/dynamixel_xh540.hpp",
        "include/dynamixel_xm430.hpp",
        "include/dynamixel_xm540.hpp",
        "include/hardware.hpp",
        "include/hardware_communicator.hpp",
        "include/hardware_joints.hpp",
        "include/joint.hpp",
        "include/kinematics.hpp",
        "include/kinematics_utils.hpp",
        "include/link.hpp",
    ],
)

cc_library(
    name = "rt_manipulators_cpp_prefixed_headers",
    hdrs = [":headers"],
    include_prefix = "rt_manipulators_cpp",
    strip_include_prefix = "include",
)

cc_library(
    name = "rt_manipulators_cpp_library",
    srcs = [
        "src/config_file_parser.cpp",
        "src/dynamixel_p.cpp",
        "src/dynamixel_ph42.cpp",
        "src/dynamixel_x.cpp",
        "src/dynamixel_xh430.cpp",
        "src/dynamixel_xh540.cpp",
        "src/dynamixel_xm430.cpp",
        "src/dynamixel_xm540.cpp",
        "src/hardware.cpp",
        "src/hardware_communicator.cpp",
        "src/hardware_joints.cpp",
        "src/joint.cpp",
        "src/kinematics.cpp",
        "src/kinematics_utils.cpp",
    ],
    hdrs = [":headers"],
    includes = ["include"],
    deps = [
        ":rt_manipulators_cpp_prefixed_headers",
        "@dynamixel_sdk//:dynamixel_sdk_library",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:yaml-cpp_library",
    ],
)

cc_shared_library(
    name = "rt_manipulators_cpp",
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "librt_manipulators_cpp.so",
    deps = [":rt_manipulators_cpp_library"],
)

ament_index(
    name = "ament_index",
    data = ["//test:_root_test_files_0"],
    libraries = [":rt_manipulators_cpp"],
    package_xml = ":package_xml",
)

ament_package(
    cmake_export_dependencies_list = [
        "Eigen3",
        "dynamixel_sdk",
        "eigen3_cmake_module",
        "yaml-cpp",
        "yaml_cpp_vendor",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_rt_manipulators_cpp",
    headers = [":headers"],
    libraries = [":rt_manipulators_cpp"],
    package_xml = ":package_xml",
    deps = [
        "@dynamixel_sdk//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@yaml_cpp_vendor//:ament_package",
    ],
)
