load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@ros2_medkit_fault_reporter//:fault_reporter_lib": "@ros2_medkit_fault_reporter//:fault_reporter_lib_library",
}

CC_DEPS = [
    "@action_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@ros2_medkit_msgs//:cc",
]

exports_files([
    "test_action_status_bridge.cpp",
    "test_integration.test.py",
])

cc_test(
    name = "test_action_status_bridge",
    srcs = ["test_action_status_bridge.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + ["test_integration.test.py"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["GTEST_HAS_PTHREAD=1"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:action_status_bridge_lib_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

launch_ros_test(
    name = "test_integration",
    src = "test_integration.test.py",
    data = [
        "//:action_status_bridge_node",
        "//:ament_index",
        "@ros2_medkit_fault_manager//:ament_index",
        "@ros2_medkit_fault_manager//:fault_manager_node",
    ],
    deps = [
        "@action_msgs//:py",
        "@ament_index_python",
        "@rclpy",
        "@ros2_medkit_msgs//:py",
        "@unique_identifier_msgs//:py",
    ],
)
