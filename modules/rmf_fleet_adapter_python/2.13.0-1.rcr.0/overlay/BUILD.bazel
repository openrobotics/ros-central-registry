load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@rmf_battery//:rmf_battery": "@rmf_battery//:rmf_battery_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rmf_fleet_adapter//:rmf_fleet_adapter": "@rmf_fleet_adapter//:rmf_fleet_adapter_library",
    "@rmf_traffic//:rmf_traffic": "@rmf_traffic//:rmf_traffic_library",
    "@rmf_traffic_ros2//:rmf_traffic_ros2": "@rmf_traffic_ros2//:rmf_traffic_ros2_library",
    "@rmf_utils//:rmf_utils": "@rmf_utils//:rmf_utils_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
}

CC_DEPS = [
    "@rmf_task_msgs//:cc",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:nlohmann_json",
    "@rosdistro//cc:pybind11",
    "@rosdistro//cc:pybind11_json",
    "@rules_python//python/cc:current_py_cc_headers",
]

cc_library(
    name = "rmf_adapter.cpython-314-x86_64-linux-gnu_library",
    srcs = [
        "src/adapter.cpp",
        "src/battery/battery.cpp",
        "src/geometry/shapes.cpp",
        "src/graph/graph.cpp",
        "src/graph/lane.cpp",
        "src/nodes/nodes.cpp",
        "src/planner/planner.cpp",
        "src/schedule/schedule.cpp",
        "src/tests.cpp",
        "src/types/types.cpp",
        "src/vehicletraits/vehicletraits.cpp",
    ],
    hdrs = [
        "include/rmf_fleet_adapter_python/PyRobotCommandHandle.hpp",
        "include/rmf_fleet_adapter_python/geometry/PyConvexShape.hpp",
        "include/rmf_fleet_adapter_python/geometry/PyShape.hpp",
        "include/rmf_fleet_adapter_python/graph/PyEvent.hpp",
        "include/rmf_fleet_adapter_python/graph/PyExecutor.hpp",
        "include/rmf_fleet_adapter_python/graph/PyOrientationConstraint.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/rmf_fleet_adapter_python",
    ],
    local_defines = ros_local_defines() + [
        'BUILT_AGAINST_NUMPY_VERSION=\\"2.3.5\\"',
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rmf_adapter.cpython-314-x86_64-linux-gnu",
    dynamic_deps = DEPENDENCIES.keys(),
    shared_lib_name = "rmf_adapter.so",
    deps = [":rmf_adapter.cpython-314-x86_64-linux-gnu_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_py",
    dynamic_deps = [":rmf_adapter.cpython-314-x86_64-linux-gnu"],
)

register_ament_files(
    name = "ament_files_0",
    files = [":rmf_adapter.cpython-314-x86_64-linux-gnu"],
    prefix = "lib/python/site-packages",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_1",
    files = ["scripts/__init__.py"],
    prefix = "lib/python/site-packages/rmf_fleet_adapter_python",
    strip_prefix = "*",
)

ament_index(
    name = "ament_index",
    data = [
        ":ament_files_0",
        ":ament_files_1",
    ],
    lib_data = [
        "scripts/rmf_msg_observer.py",
        "scripts/schedule_blockade_nodes.py",
        "scripts/test_adapter.py",
        "scripts/test_delivery.py",
        "scripts/test_loop.py",
        "scripts/test_utils.py",
        "scripts/traffic_light.py",
    ],
    # The extension's RUNPATH does not survive being symlinked into
    # lib/python/site-packages, so ship its transitive shared libraries in
    # lib/ (which is on LD_LIBRARY_PATH).
    libraries = [":transitive_dynamic_deps_py"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_pytest//:ament_package",
        "@pybind11_vendor//:ament_package",
        "@rclpy//:ament_package",
        "@rmf_fleet_adapter//:ament_package",
        "@rmf_task_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_pytest//:ament_package",
        "@pybind11_vendor//:ament_package",
        "@rclpy//:ament_package",
        "@rmf_fleet_adapter//:ament_package",
        "@rmf_task_msgs//:ament_package",
    ],
)
