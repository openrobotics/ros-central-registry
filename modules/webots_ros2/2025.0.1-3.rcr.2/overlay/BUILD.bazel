load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

py_library(
    name = "webots_ros2",
    srcs = [
        "webots_ros2/__init__.py",
    ],
    imports = ["."],
)

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            "CHANGELOG.rst",
            "README.md",
            "package.xml",
            "resource/webots_ros2",
            "setup.cfg",
            "setup.py",
            "test/test_copyright.py",
            "webots_ros2/__init__.py",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
    ]
]

### PACKAGING

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":webots_ros2"],
    setup_cfg = "setup.cfg",
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
        "@webots_ros2_control//:ament_package",
        "@webots_ros2_crazyflie//:ament_package",
        "@webots_ros2_driver//:ament_package",
        "@webots_ros2_epuck//:ament_package",
        "@webots_ros2_husarion//:ament_package",
        "@webots_ros2_importer//:ament_package",
        "@webots_ros2_mavic//:ament_package",
        "@webots_ros2_msgs//:ament_package",
        "@webots_ros2_tesla//:ament_package",
        "@webots_ros2_tests//:ament_package",
        "@webots_ros2_tiago//:ament_package",
        "@webots_ros2_turtlebot//:ament_package",
        "@webots_ros2_universal_robot//:ament_package",
    ],
)
