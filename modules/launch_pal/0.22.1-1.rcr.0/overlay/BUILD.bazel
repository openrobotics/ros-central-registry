load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

py_library(
    name = "launch_pal",
    srcs = glob(["launch_pal/**/*.py"]),
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@launch",
        "@launch_ros",
        requirement("pyyaml"),
    ],
)

ament_index(
    name = "ament_index",
    data = ["config/robot_configuration.yaml"],
    package_xml = "package.xml",
)

py_pytest(
    name = "test_arg_utils",
    srcs = ["test/test_arg_utils.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":launch_pal"],
)

