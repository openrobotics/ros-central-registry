load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

py_library(
    name = "launch_pal",
    srcs = [
        "launch_pal/__init__.py",
        "launch_pal/actions/__init__.py",
        "launch_pal/actions/check_public_sim.py",
        "launch_pal/actions/validate_launch_args.py",
        "launch_pal/actions/validate_xacro_args.py",
        "launch_pal/arg_utils.py",
        "launch_pal/calibration_utils.py",
        "launch_pal/composition_utils.py",
        "launch_pal/conditions/__init__.py",
        "launch_pal/conditions/if_node_running.py",
        "launch_pal/conditions/unless_node_running.py",
        "launch_pal/include_utils.py",
        "launch_pal/logging_utils.py",
        "launch_pal/pal_parameters.py",
        "launch_pal/param_utils.py",
        "launch_pal/robot_arguments/__init__.py",
        "launch_pal/robot_arguments/common.py",
        "launch_pal/robot_arguments/robot.py",
        "launch_pal/robot_utils.py",
        "launch_pal/substitutions/__init__.py",
        "launch_pal/substitutions/concat_substitution.py",
        "launch_pal/substitutions/load_file.py",
        "launch_pal/substitutions/robot_info_file.py",
    ],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@launch",
        "@launch_ros",
        requirement("pyyaml"),
    ],
)

ament_index(
    name = "ament_index",
    data = ["config/robot_configuration.yaml"],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":launch_pal"],
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
