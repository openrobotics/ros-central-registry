load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "socket_can_bridge.launch.xml",
        "socket_can_receiver.launch.py",
        "socket_can_sender.launch.py",
    ],
)

launch_ros_binary(
    name = "socket_can_bridge_launch",
    src = "socket_can_bridge.launch.xml",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":socket_can_receiver_launch",
        ":socket_can_sender_launch",
        "//:socket_can_receiver_node_exe",
        "//:socket_can_sender_node_exe",
        "@lifecycle_msgs//:py",
    ],
)

launch_ros_binary(
    name = "socket_can_receiver_launch",
    src = "socket_can_receiver.launch.py",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//:socket_can_receiver_node_exe",
        "@lifecycle_msgs//:py",
    ],
)

launch_ros_binary(
    name = "socket_can_sender_launch",
    src = "socket_can_sender.launch.py",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//:socket_can_sender_node_exe",
        "@lifecycle_msgs//:py",
    ],
)
