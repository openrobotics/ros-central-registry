load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@can_msgs//:cc_shared": "@can_msgs//:cc",
    "@lifecycle_msgs//:cc_shared": "@lifecycle_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@ros2_socketcan_msgs//:cc_shared": "@ros2_socketcan_msgs//:cc",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "ros2_socketcan_library",
    srcs = [
        "src/socket_can_common.cpp",
        "src/socket_can_id.cpp",
        "src/socket_can_receiver.cpp",
        "src/socket_can_sender.cpp",
    ],
    hdrs = [
        "include/ros2_socketcan/socket_can_common.hpp",
        "include/ros2_socketcan/socket_can_id.hpp",
        "include/ros2_socketcan/socket_can_receiver.hpp",
        "include/ros2_socketcan/socket_can_receiver_node.hpp",
        "include/ros2_socketcan/socket_can_sender.hpp",
        "include/ros2_socketcan/socket_can_sender_node.hpp",
        "include/ros2_socketcan/visibility_control.hpp",
    ],
    includes = [
        ".",
        "include",
        "include/ros2_socketcan",
    ],
    local_defines = ros_local_defines(),
    target_compatible_with = ["@platforms//os:linux"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ros2_socketcan",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":ros2_socketcan_library"],
)

cc_library(
    name = "socket_can_receiver_node_library",
    srcs = ["src/socket_can_receiver_node.cpp"],
    hdrs = [
        "include/ros2_socketcan/socket_can_common.hpp",
        "include/ros2_socketcan/socket_can_id.hpp",
        "include/ros2_socketcan/socket_can_receiver.hpp",
        "include/ros2_socketcan/socket_can_receiver_node.hpp",
        "include/ros2_socketcan/socket_can_sender.hpp",
        "include/ros2_socketcan/socket_can_sender_node.hpp",
        "include/ros2_socketcan/visibility_control.hpp",
    ],
    includes = [
        ".",
        "include",
        "include/ros2_socketcan",
    ],
    local_defines = ros_local_defines(),
    target_compatible_with = ["@platforms//os:linux"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":ros2_socketcan_library"],
)

cc_shared_library(
    name = "socket_can_receiver_node",
    dynamic_deps = DEPENDENCIES.keys() + [":ros2_socketcan"],
    exports_filter = ["//:__subpackages__"],
    deps = [":socket_can_receiver_node_library"],
)

cc_library(
    name = "socket_can_sender_node_library",
    srcs = ["src/socket_can_sender_node.cpp"],
    hdrs = [
        "include/ros2_socketcan/socket_can_common.hpp",
        "include/ros2_socketcan/socket_can_id.hpp",
        "include/ros2_socketcan/socket_can_receiver.hpp",
        "include/ros2_socketcan/socket_can_receiver_node.hpp",
        "include/ros2_socketcan/socket_can_sender.hpp",
        "include/ros2_socketcan/socket_can_sender_node.hpp",
        "include/ros2_socketcan/visibility_control.hpp",
    ],
    includes = [
        ".",
        "include",
        "include/ros2_socketcan",
    ],
    local_defines = ros_local_defines(),
    target_compatible_with = ["@platforms//os:linux"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":ros2_socketcan_library",
        ":socket_can_receiver_node_library",
    ],
)

cc_shared_library(
    name = "socket_can_sender_node",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":ros2_socketcan",
        ":socket_can_receiver_node",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":socket_can_sender_node_library"],
)

rclcpp_components_register_node(
    name = "socket_can_receiver_node_exe",
    component = ":socket_can_receiver_node",
    data = [
        ":ament_index",
    ],
    node_name = "socket_can_receiver_node_exe",
    plugin = "drivers::socketcan::SocketCanReceiverNode",
)

rclcpp_components_register_node(
    name = "socket_can_sender_node_exe",
    component = ":socket_can_receiver_node",
    data = [
        ":ament_index",
    ],
    node_name = "socket_can_sender_node_exe",
    plugin = "drivers::socketcan::SocketCanReceiverNode",
)

rclcpp_components_register_nodes(
    name = "socket_can_sender_node_components",
    component = ":socket_can_sender_node",
    plugins = ["drivers::socketcan::SocketCanSenderNode"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":socket_can_sender_node"] + [
        ":ros2_socketcan",
        ":socket_can_receiver_node",
    ],
)

ament_index(
    name = "ament_index",
    components = [
        ":socket_can_receiver_node_exe_record",
        ":socket_can_sender_node_exe_record",
        ":socket_can_sender_node_components",
    ],
    data = ["//launch:launch_files"],
    libraries = [
        ":ros2_socketcan",
        ":socket_can_receiver_node",
        ":socket_can_sender_node",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@can_msgs//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2_socketcan_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "can_msgs",
        "lifecycle_msgs",
        "rclcpp",
        "rclcpp_components",
        "rclcpp_lifecycle",
        "ros2_socketcan_msgs",
    ],
    cmake_export_targets = False,
    executables = [
        ":socket_can_receiver_node_exe",
        ":socket_can_sender_node_exe",
    ],
    headers = [
        "include/ros2_socketcan/socket_can_common.hpp",
        "include/ros2_socketcan/socket_can_id.hpp",
        "include/ros2_socketcan/socket_can_receiver.hpp",
        "include/ros2_socketcan/socket_can_receiver_node.hpp",
        "include/ros2_socketcan/socket_can_sender.hpp",
        "include/ros2_socketcan/socket_can_sender_node.hpp",
        "include/ros2_socketcan/visibility_control.hpp",
    ],
    libraries = [
        ":ros2_socketcan",
        ":socket_can_receiver_node",
        ":socket_can_sender_node",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@can_msgs//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2_socketcan_msgs//:ament_package",
    ],
)
