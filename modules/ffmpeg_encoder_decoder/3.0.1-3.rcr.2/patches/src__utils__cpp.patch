+static AVCodecID fallback_codec_id(const std::string & name)
+{
+  if (
+    name == "libx264" || name == "libx264rgb" || name == "h264" || name == "h264_nvenc" ||
+    name == "h264_vaapi" || name == "h264_nvmpi" || name == "h264_cuvid" || name == "h264_qsv" ||
+    name == "h264_v4l2m2m") {
+    return AV_CODEC_ID_H264;
+  }
+  if (
+    name == "libx265" || name == "hevc" || name == "hevc_nvenc" || name == "hevc_vaapi" ||
+    name == "hevc_cuvid" || name == "hevc_qsv" || name == "hevc_v4l2m2m") {
+    return AV_CODEC_ID_HEVC;
+  }
+  const AVCodecDescriptor * desc = nullptr;
+  while ((desc = avcodec_descriptor_next(desc)) != nullptr) {
+    if (desc->name == name) {
+      return desc->id;
+    }
+  }
+  return AV_CODEC_ID_NONE;
+}
