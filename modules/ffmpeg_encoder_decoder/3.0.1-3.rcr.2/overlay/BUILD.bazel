load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@ffmpeg_image_transport_msgs//:cc_shared": "@ffmpeg_image_transport_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:ffmpeg_avcodec_shared": "@rosdistro//cc:ffmpeg_avcodec",
    "@rosdistro//cc:ffmpeg_avformat_shared": "@rosdistro//cc:ffmpeg_avformat",
    "@rosdistro//cc:ffmpeg_avutil_shared": "@rosdistro//cc:ffmpeg_avutil",
    "@rosdistro//cc:ffmpeg_swresample_shared": "@rosdistro//cc:ffmpeg_swresample",
    "@rosdistro//cc:ffmpeg_swscale_shared": "@rosdistro//cc:ffmpeg_swscale",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "ffmpeg_encoder_decoder_library",
    srcs = [
        "src/decoder.cpp",
        "src/encoder.cpp",
        "src/tdiff.cpp",
        "src/utils.cpp",
    ],
    hdrs = [
        "include/ffmpeg_encoder_decoder/decoder.hpp",
        "include/ffmpeg_encoder_decoder/encoder.hpp",
        "include/ffmpeg_encoder_decoder/pts_map.hpp",
        "include/ffmpeg_encoder_decoder/safe_param.hpp",
        "include/ffmpeg_encoder_decoder/tdiff.hpp",
        "include/ffmpeg_encoder_decoder/types.hpp",
        "include/ffmpeg_encoder_decoder/utils.hpp",
        "test/encoder_decoder_tester.hpp",
    ] + [
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/ffmpeg_encoder_decoder",
    ],
    local_defines = ros_local_defines() + [
        "USE_AV_FLAGS",
        "USE_CV_BRIDGE_HPP",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "ffmpeg_encoder_decoder_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_shared_library(
    name = "ffmpeg_encoder_decoder",
    dynamic_deps = [
        ":ffmpeg_encoder_decoder_dynamic_deps",
        "@ffmpeg_image_transport_msgs//:cc_shared",
        "@sensor_msgs//:cc_shared",
        "@std_msgs//:cc_shared",
    ],
    deps = [":ffmpeg_encoder_decoder_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ffmpeg_encoder_decoder"],
)

ament_index(
    name = "ament_index",
    libraries = [":ffmpeg_encoder_decoder"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@ffmpeg_image_transport_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_environment//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

cc_test(
    name = "ffmpeg_encoder_decoder_test",
    srcs = [
        "test/encoder_decoder_test.cpp",
        "test/encoder_decoder_tester.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/ffmpeg_encoder_decoder",
    ],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "USE_AV_FLAGS",
        "USE_CV_BRIDGE_HPP",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":ffmpeg_encoder_decoder_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "OpenCV",
        "LIBAV",
        "cv_bridge",
        "rclcpp",
        "sensor_msgs",
        "std_msgs",
    ],
    cmake_export_name = "ffmpeg_encoder_decoderTargets",
    cmake_extras = ["ffmpeg_encoder_decoder-extras.cmake"],
    headers = [
        "include/ffmpeg_encoder_decoder/decoder.hpp",
        "include/ffmpeg_encoder_decoder/encoder.hpp",
        "include/ffmpeg_encoder_decoder/pts_map.hpp",
        "include/ffmpeg_encoder_decoder/safe_param.hpp",
        "include/ffmpeg_encoder_decoder/tdiff.hpp",
        "include/ffmpeg_encoder_decoder/types.hpp",
        "include/ffmpeg_encoder_decoder/utils.hpp",
    ],
    include_prefix = "",
    libraries = [":ffmpeg_encoder_decoder"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@ffmpeg_image_transport_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_environment//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
