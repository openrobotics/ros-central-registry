load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

exports_files([
    "gtest_value_printers.cpp",
    "gtest_value_printers.h",
    "models.cpp",
    "models.h",
    "stage_mockups.cpp",
    "stage_mockups.h",
])

COPTS = ["-Wno-missing-template-arg-list-after-template-kw"]

LOCAL_DEFINES = ros_local_defines() + [
    "GTEST_HAS_PTHREAD=1",
    "NDEBUG",
    "_FILE_OFFSET_BITS=64",
]

TEST_DEPS = [
    "//:gtest_utils_library",
    "//:moveit_task_constructor_core_library",
    "//:moveit_task_constructor_core_stages_library",
    "@rosdistro//cc:bazel_test_helper",
    "@rosdistro//cc:googletest",
]

# mtc_add_gtest / mtc_add_gmock in upstream test/CMakeLists.txt
[
    cc_test(
        name = "moveit_task_constructor_core-" + test.replace("_", "-"),
        srcs = [test + ".cpp"],
        copts = COPTS,
        data = ["//:ament_index"],
        dynamic_deps = ["//:transitive_dynamic_deps"],
        local_defines = LOCAL_DEFINES,
        deps = TEST_DEPS,
    )
    for test in [
        "test_container",
        "test_cost_queue",
        "test_cost_terms",
        "test_fallback",
        "test_interface_state",
        "test_limit_solutions",
        "test_mockups",
        "test_pipeline_planner",
        "test_properties",
        "test_pruning",
        "test_serial",
        "test_stage",
        "test_storage",
    ]
]

# Upstream builds these as gtest executables driven by test.launch.py (they
# need a running move_group), so they are built here but run via launch tests.
[
    cc_binary(
        name = "moveit_task_constructor_core-" + test.replace("_", "-"),
        testonly = True,
        srcs = [test + ".cpp"],
        copts = COPTS,
        data = ["//:ament_index"],
        dynamic_deps = ["//:transitive_dynamic_deps"],
        local_defines = LOCAL_DEFINES,
        deps = TEST_DEPS,
    )
    for test in [
        "test_move_relative",
        "test_move_to",
    ]
]

# Integration test executables (upstream only builds them; running requires
# robot-specific moveit configs that are not packaged).
[
    cc_binary(
        name = test,
        testonly = True,
        srcs = [test + ".cpp"],
        copts = COPTS,
        dynamic_deps = ["//:transitive_dynamic_deps"],
        local_defines = LOCAL_DEFINES,
        deps = TEST_DEPS,
    )
    for test in [
        "pick_pa10",
        "pick_pr2",
        "pick_ur5",
    ]
]

launch_ros_test(
    name = "test-move-to",
    src = "test.launch.py",
    data = [
        ":moveit_task_constructor_core-test-move-to",
        "//:ament_index",
        "//:pymoveit_mtc.cpython-314-x86_64-linux-gnu",
    ],
    deps = [
        "//:moveit",
        "@geometry_msgs//:py",
        "@moveit_configs_utils",
        "@moveit_py//:moveit",
        "@moveit_task_constructor_msgs//:py",
        "@visualization_msgs//:py",
    ],
)

launch_ros_test(
    name = "test-move-relative",
    src = "test.launch.py",
    data = [
        ":moveit_task_constructor_core-test-move-relative",
        "//:ament_index",
        "//:pymoveit_mtc.cpython-314-x86_64-linux-gnu",
    ],
    deps = [
        "//:moveit",
        "@geometry_msgs//:py",
        "@moveit_configs_utils",
        "@moveit_py//:moveit",
        "@moveit_task_constructor_msgs//:py",
        "@visualization_msgs//:py",
    ],
)
