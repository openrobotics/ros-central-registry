load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = ["demo_nodes.launch.py"],
)

launch_ros_binary(
    name = "demo_nodes_launch",
    src = "demo_nodes.launch.py",
    data = [
        "//:ament_index",
        "//:demo_brake_actuator",
        "//:demo_brake_pressure_sensor",
        "//:demo_calibration_service",
        "//:demo_door_status_sensor",
        "//:demo_engine_temp_sensor",
        "//:demo_lidar_sensor",
        "//:demo_light_controller",
        "//:demo_long_calibration_action",
        "//:demo_rpm_sensor",
    ],
    deps = ["//:ros2_medkit_test_utils"],
)
