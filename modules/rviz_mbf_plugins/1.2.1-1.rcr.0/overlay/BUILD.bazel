load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@mbf_msgs//:cc_shared": "@mbf_msgs//:cc",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rosdistro//cc:OgreMain": "@rosdistro//cc:OgreMain_library",
    "@rosdistro//cc:OgreOverlay": "@rosdistro//cc:OgreOverlay_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:curl": "@rosdistro//cc:curl_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rviz_common//:rviz_common": "@rviz_common//:rviz_common_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "rviz_mbf_plugins_library",
    srcs = ["src/mbf_goal_actions_panel.cpp"],
    hdrs = ["include/rviz_mbf_plugins/mbf_goal_actions_panel.hpp"],
    includes = [
        "include",
        "include/rviz_mbf_plugins",
    ],
    local_defines = ros_local_defines() + [
        "RVIZ_MBF_PLUGINS_BUILDING_LIBRARY",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rviz_mbf_plugins",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rviz_mbf_plugins_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":rviz_mbf_plugins"],
    package_xml = "package.xml",
    plugin_category = "rviz_common",
    plugins = ["plugins_description.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mbf_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rviz_common//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    cmake_export_name = "export_rviz_mbf_plugins",
    headers = ["include/rviz_mbf_plugins/mbf_goal_actions_panel.hpp"],
    include_prefix = "",
    libraries = [":rviz_mbf_plugins"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mbf_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rviz_common//:ament_package",
    ],
)
