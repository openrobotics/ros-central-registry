load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = [
    "include/depth_image_proc/conversions.hpp",
    "include/depth_image_proc/convert_metric.hpp",
    "include/depth_image_proc/depth_traits.hpp",
    "include/depth_image_proc/point_cloud_xyz.hpp",
    "include/depth_image_proc/point_cloud_xyz_radial.hpp",
    "include/depth_image_proc/point_cloud_xyzi.hpp",
    "include/depth_image_proc/point_cloud_xyzi_radial.hpp",
    "include/depth_image_proc/point_cloud_xyzrgb.hpp",
    "include/depth_image_proc/point_cloud_xyzrgb_radial.hpp",
    "include/depth_image_proc/visibility.h",
]

DEPENDENCIES = {
    "@class_loader//:class_loader": "@class_loader//:class_loader_library",
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@image_geometry//:image_geometry": "@image_geometry//:image_geometry_library",
    "@image_proc//:image_proc": "@image_proc//:image_proc_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:opencv_contrib_aruco": "@rosdistro//cc:opencv_contrib_aruco_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

cc_library(
    name = "depth_image_proc_library",
    srcs = [
        "src/conversions.cpp",
        "src/convert_metric.cpp",
        "src/crop_foremost.cpp",
        "src/disparity.cpp",
        "src/point_cloud_xyz.cpp",
        "src/point_cloud_xyz_radial.cpp",
        "src/point_cloud_xyzi.cpp",
        "src/point_cloud_xyzi_radial.cpp",
        "src/point_cloud_xyzrgb.cpp",
        "src/point_cloud_xyzrgb_radial.cpp",
        "src/register.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:eigen",
        "@sensor_msgs//:cc",
        "@stereo_msgs//:cc",
    ],
)

cc_shared_library(
    name = "depth_image_proc",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":depth_image_proc_library"],
)

COMPONENTS = [
    ("convert_metric_node", "depth_image_proc::ConvertMetricNode"),
    ("crop_foremost_node", "depth_image_proc::CropForemostNode"),
    ("disparity_node", "depth_image_proc::DisparityNode"),
    ("point_cloud_xyz_node", "depth_image_proc::PointCloudXyzNode"),
    ("point_cloud_xyzrgb_node", "depth_image_proc::PointCloudXyzrgbNode"),
    ("point_cloud_xyzi_node", "depth_image_proc::PointCloudXyziNode"),
    ("point_cloud_xyz_radial_node", "depth_image_proc::PointCloudXyzRadialNode"),
    ("point_cloud_xyzi_radial_node", "depth_image_proc::PointCloudXyziRadialNode"),
    ("point_cloud_xyzrgb_radial_node", "depth_image_proc::PointCloudXyzrgbRadialNode"),
    ("register_node", "depth_image_proc::RegisterNode"),
]

[rclcpp_components_register_node(
    name = node_name,
    component = ":depth_image_proc",
    node_name = node_name,
    plugin = plugin,
) for node_name, plugin in COMPONENTS]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":depth_image_proc"],
)

ament_index(
    name = "ament_index",
    components = [":{}_record".format(node_name) for node_name, _ in COMPONENTS],
    data = ["//launch:launch_files"],
    executables = [":{}".format(node_name) for node_name, _ in COMPONENTS],
    libraries = [":depth_image_proc"],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    cmake_export_targets = False,
    headers = HEADERS,
    libraries = [":depth_image_proc"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@class_loader//:ament_package",
        "@cv_bridge//:ament_package",
        "@image_geometry//:ament_package",
        "@image_proc//:ament_package",
        "@image_transport//:ament_package",
        "@message_filters//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@stereo_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_eigen//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
