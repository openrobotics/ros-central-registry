load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "apm.launch.xml",
        "apm_config.yaml",
        "apm_pluginlists.yaml",
        "apm_with_terrain.launch.xml",
        "multi_uas.launch.xml",
        "node.launch.xml",
        "px4.launch.xml",
        "px4_config.yaml",
        "px4_pluginlists.yaml",
        "test_compose.launch.py",
    ],
)

launch_ros_binary(
    name = "apm.launch",
    src = "apm.launch.xml",
    data = [
        "//:ament_index",
        "//:mavros_node",
    ],
    deps = ["//:mavros_py"],
)

launch_ros_binary(
    name = "apm_with_terrain.launch",
    src = "apm_with_terrain.launch.xml",
    data = [
        "//:ament_index",
        "//:mavros_node",
    ],
    deps = ["//:mavros_py"],
)

launch_ros_binary(
    name = "multi_uas.launch",
    src = "multi_uas.launch.xml",
    data = [
        "//:ament_index",
        "//:mavros_node",
    ],
    deps = ["//:mavros_py"],
)

launch_ros_binary(
    name = "node.launch",
    src = "node.launch.xml",
    data = [
        "//:ament_index",
        "//:mavros_node",
    ],
    deps = ["//:mavros_py"],
)

launch_ros_binary(
    name = "px4.launch",
    src = "px4.launch.xml",
    data = [
        "//:ament_index",
        "//:mavros_node",
    ],
    deps = ["//:mavros_py"],
)

launch_ros_binary(
    name = "test_compose_launch",
    src = "test_compose.launch.py",
    data = [
        "//:ament_index",
        "//:mavros",
        "@rclcpp_components//:ament_index",
        "@rclcpp_components//:component_container_mt",
    ],
    deps = ["//:mavros_py"],
)
