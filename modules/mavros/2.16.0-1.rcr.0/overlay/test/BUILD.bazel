cc_library(
    name = "test_helpers",
    testonly = True,
    hdrs = [
        "test_plugin_helpers.hpp",
    ],
    includes = ["."],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "libmavros-frame-conversions-test",
    srcs = ["test_frame_conversions.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "mavros_py/__init__.py",
        "mavros_py/test_mission.py",
        "mavros_py/test_param.py",
        "mavros_py/testdata/CMAC-circuit.txt",
        "mavros_py/testdata/mavproxy.parm",
        "mavros_py/testdata/missionplanner.parm",
        "mavros_py/testdata/qgroundcontrol.params",
        "mavros_py/testdata/simple.plan",
        "test_plugin_params.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "MAVROS_HAVE_EVENTS_CBG_EXECUTOR",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":test_helpers",
        "//:mavros_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

