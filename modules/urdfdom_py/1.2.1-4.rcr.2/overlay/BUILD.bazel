load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "urdfdom_py",
    srcs = glob(["src/urdf_parser_py/**/*.py"]),
    imports = ["src"],
    deps = [
        "@rclpy",
        requirement("lxml"),
        requirement("pyyaml"),
    ],
)

py_pytest(
    name = "test_urdf",
    srcs = ["test/test_urdf.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    deps = [":urdfdom_py"],
)

py_pytest(
    name = "test_urdf_error",
    srcs = ["test/test_urdf_error.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    deps = [":urdfdom_py"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"display_urdf": "urdf_parser_py.display_urdf:main"},
    package_xml = "package.xml",
    python = [":urdfdom_py"],
    python_strip_prefix = "src",
    deps = [
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
