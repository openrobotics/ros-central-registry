load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "urdfdom_py",
    srcs = [
        "src/urdf_parser_py/__init__.py",
        "src/urdf_parser_py/display_urdf.py",
        "src/urdf_parser_py/sdf.py",
        "src/urdf_parser_py/urdf.py",
        "src/urdf_parser_py/xml_reflection/__init__.py",
        "src/urdf_parser_py/xml_reflection/basics.py",
        "src/urdf_parser_py/xml_reflection/core.py",
    ],
    imports = ["src"],
    deps = [
        "@rclpy",
        requirement("lxml"),
        requirement("pyyaml"),
    ],
)

ament_package(
    name = "ament_package",
    console_scripts = {"display_urdf": "urdf_parser_py.display_urdf:main"},
    package_xml = "package.xml",
    python = [":urdfdom_py"],
    python_strip_prefix = "src",
    deps = [
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
