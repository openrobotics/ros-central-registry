load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = ["include/raspimouse/raspimouse_component.hpp"]

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

MSG_DEPENDENCIES = [
    "@geometry_msgs//:cc",
    "@lifecycle_msgs//:cc",
    "@nav_msgs//:cc",
    "@raspimouse_msgs//:cc",
    "@std_msgs//:cc",
    "@std_srvs//:cc",
]

cc_library(
    name = "raspimouse_component_library",
    srcs = ["src/raspimouse_component.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["RASPIMOUSE_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + MSG_DEPENDENCIES,
)

cc_shared_library(
    name = "raspimouse_component",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":raspimouse_component_library"],
)

rclcpp_components_register_nodes(
    name = "raspimouse_component_nodes",
    component = ":raspimouse_component",
    plugins = ["raspimouse::Raspimouse"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":raspimouse_component"],
)

cc_binary(
    name = "raspimouse",
    srcs = ["src/raspimouse.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + MSG_DEPENDENCIES + [":raspimouse_component_library"],
)

DATA = ["config/params.yaml"] + ["//launch:launch_files"]

ament_index(
    name = "ament_index",
    components = [":raspimouse_component_nodes"],
    data = DATA,
    executables = [":raspimouse"],
    libraries = [":raspimouse_component"],
    package_xml = "package.xml",
    deps = ["@raspimouse_msgs//:ament_index"],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "geometry_msgs",
        "nav_msgs",
        "raspimouse_msgs",
        "rclcpp",
        "rclcpp_components",
        "rclcpp_lifecycle",
        "rosidl_default_runtime",
        "std_msgs",
        "std_srvs",
        "tf2",
        "tf2_ros",
    ],
    cmake_export_has_library_target = True,
    cmake_export_name = "export_raspimouse_component",
    headers = HEADERS,
    include_prefix = "",
    libraries = [":raspimouse_component"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@raspimouse_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
