load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "yasmin_plugins_manager",
    srcs = [
        "yasmin_plugins_manager/__init__.py",
        "yasmin_plugins_manager/cache.py",
        "yasmin_plugins_manager/discovery_node.py",
        "yasmin_plugins_manager/plugin_info.py",
        "yasmin_plugins_manager/plugin_manager.py",
    ],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@rclpy",
        requirement("lxml"),
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"discover_plugins": "yasmin_plugins_manager.discovery_node:main"},
    package_xml = "package.xml",
    python = [":yasmin_plugins_manager"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_index_python//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@yasmin//:ament_package",
        "@yasmin_factory//:ament_package",
    ],
)
