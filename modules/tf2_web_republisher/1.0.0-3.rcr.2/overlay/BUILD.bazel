load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
    "@tf2_web_republisher_interfaces//:cc_shared": "@tf2_web_republisher_interfaces//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "tf2_web_republisher_library",
    srcs = ["src/tf2_web_republisher.cpp"],
    hdrs = ["include/tf2_web_republisher/tf2_web_republisher.hpp"],
    includes = [
        "include",
        "include/tf2_web_republisher",
        "test",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "tf2_web_republisher",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":tf2_web_republisher_library"],
)

rclcpp_components_register_node(
    name = "tf2_web_republisher_node",
    component = ":tf2_web_republisher",
    node_name = "tf2_web_republisher_node",
    plugin = "tf2_web_republisher::TFRepublisher",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":tf2_web_republisher"],
)

ament_index(
    name = "ament_index",
    components = [":tf2_web_republisher_node_record"],
    lib_data = [":tf2_web_republisher_node"],
    libraries = [":tf2_web_republisher"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rclcpp_components//:ament_package",
        "@tf2//:ament_package",
        "@tf2_ros//:ament_package",
        "@tf2_web_republisher_interfaces//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "geometry_msgs",
        "rclcpp",
        "rclcpp_action",
        "rclcpp_components",
        "tf2",
        "tf2_ros",
        "tf2_web_republisher_interfaces",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_tf2_web_republisher",
    headers = ["include/tf2_web_republisher/tf2_web_republisher.hpp"],
    include_prefix = "",
    libraries = [":tf2_web_republisher"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rclcpp_components//:ament_package",
        "@tf2//:ament_package",
        "@tf2_ros//:ament_package",
        "@tf2_web_republisher_interfaces//:ament_package",
    ],
)
