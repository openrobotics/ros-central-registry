load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@@sensor_msgs+//:cc",
    "@mrpt_hwdrivers//:mrpt_hwdrivers_library",
    "@mrpt_libros_bridge//:mrpt_libros_bridge_library",
    "@mrpt_msgs//:cc",
    "@mrpt_sensorlib//:mrpt_sensorlib_library",
    "@novatel_oem6_msgs//:cc",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "mrpt_sensor_gnss_novatel_node",
    srcs = [":gen_mrpt_sensor_gnss_novatel_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

write_file(
    name = "gen_mrpt_sensor_gnss_novatel_stub_cpp",
    out = "_gen/mrpt_sensor_gnss_novatel_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    data = ["launch/mrpt_sensor_gnss_novatel.launch.py"],
    lib_data = [":mrpt_sensor_gnss_novatel_node"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@mrpt_hwdrivers//:ament_package",
        "@mrpt_libros_bridge//:ament_package",
        "@mrpt_msgs//:ament_package",
        "@mrpt_sensorlib//:ament_package",
        "@novatel_oem6_msgs//:ament_package",
        "@rclcpp_components//:ament_package",
        "@ros_environment//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

launch_ros_binary(
    name = "mrpt_sensor_gnss_novatel.launch.py",
    src = "launch/mrpt_sensor_gnss_novatel.launch.py",
    data = [
        ":ament_index",
        "@rclcpp_components//:ament_index",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@mrpt_hwdrivers//:ament_package",
        "@mrpt_libros_bridge//:ament_package",
        "@mrpt_msgs//:ament_package",
        "@mrpt_sensorlib//:ament_package",
        "@novatel_oem6_msgs//:ament_package",
        "@rclcpp_components//:ament_package",
        "@ros_environment//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
