    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:lz4": "@rosdistro//cc:lz4_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
}

CC_DEPS = [
    "@autoware_utils_tf//:autoware_utils_tf_library",
    "@pcl_conversions//:pcl_conversions_library",
    "@pcl_ros//:pcl_ros_filter_library",
    "@pcl_ros//:pcl_ros_tf_library",
    "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:pcl_common",
    "@rosdistro//cc:pcl_features",
    "@rosdistro//cc:pcl_filters",
    "@rosdistro//cc:pcl_io",
    "@rosdistro//cc:pcl_kdtree",
    "@rosdistro//cc:pcl_ml",
    "@rosdistro//cc:pcl_octree",
    "@rosdistro//cc:pcl_sample_consensus",
    "@rosdistro//cc:pcl_search",
    "@rosdistro//cc:pcl_segmentation",
    "@rosdistro//cc:pcl_surface",
