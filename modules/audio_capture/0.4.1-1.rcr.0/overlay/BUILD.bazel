load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@audio_common_msgs//:cc_shared": "@audio_common_msgs//:cc",
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:boost.thread_shared": "@rosdistro//cc:boost.thread_library",
    "@rosdistro//cc:gstreamer": "@rosdistro//cc:gstreamer_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "audio_capture_library",
    srcs = [
        "src/audio_capture_node.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "audio_capture",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":audio_capture_library"],
    deps = [":audio_capture_library"],
)

rclcpp_components_register_node(
    name = "audio_capture_node",
    component = ":audio_capture",
    data = [":ament_index"],
    node_name = "audio_capture_node",
    plugin = "audio_capture::AudioCaptureNode",
)

ament_index(
    name = "ament_index",
    components = [":audio_capture_node_record"],
    data = ["//launch:launch_files"],
    libraries = [":audio_capture"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@audio_common_msgs//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@launch_xml//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_targets = False,
    executables = [":audio_capture_node"],
    libraries = [":audio_capture"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@audio_common_msgs//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@launch_xml//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
    ],
)
