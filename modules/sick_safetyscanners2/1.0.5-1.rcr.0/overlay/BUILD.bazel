load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rviz2//:ament_package",
        "@sensor_msgs//:ament_package",
        "@sick_safetyscanners2_interfaces//:ament_package",
        "@sick_safetyscanners_base//:ament_package",
        "@xacro//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    colcon_hooks = False,
    install_package_xml = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rviz2//:ament_package",
        "@sensor_msgs//:ament_package",
        "@sick_safetyscanners2_interfaces//:ament_package",
        "@sick_safetyscanners_base//:ament_package",
        "@xacro//:ament_package",
    ],
)

launch_ros_binary(
    name = "launch_sick_safetyscanners2_launch_py",
    src = "launch/sick_safetyscanners2_launch.py",
    data = [":ament_index"],
)

launch_ros_binary(
    name = "launch_sick_safetyscanners2_lifecycle_launch_py",
    src = "launch/sick_safetyscanners2_lifecycle_launch.py",
    data = [":ament_index"],
)

launch_ros_binary(
    name = "launch_view_nanoscan3_launch_py",
    src = "launch/view_nanoscan3.launch.py",
    data = [
        ":ament_index",
        "@robot_state_publisher//:ament_index",
        "@rviz2//:ament_index",
        "@xacro//:ament_index",
    ],
)

launch_ros_binary(
    name = "launch_view_nanoscan3_launch_xml",
    src = "launch/view_nanoscan3.launch.xml",
    data = [
        ":ament_index",
        "@robot_state_publisher//:ament_index",
        "@rviz2//:ament_index",
        "@xacro//:ament_index",
    ],
)
