load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
]

cc_library(
    name = "video_to_image_msg_publisher_library",
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/video_to_image_msg_publisher",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "video_to_image_msg_publisher",
    srcs = [
        "src/v2imp.cpp",
        "src/v2imp_node.cpp",
    ] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/video_to_image_msg_publisher",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

pkg_files(
    name = "pkg_files_share_0",
    srcs = ["config/video_to_image_msg_publisher.yaml"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "share/video_to_image_msg_publisher/config/config",
)

ament_index(
    name = "ament_index",
    data = [
        "config/video_to_image_msg_publisher.yaml",
        "launch/video_to_image_msg_publisher.launch.py",
    ],
    lib_data = [":video_to_image_msg_publisher"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@rclcpp//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)

launch_ros_binary(
    name = "video_to_image_msg_publisher.launch.py",
    src = "launch/video_to_image_msg_publisher.launch.py",
    data = [":ament_index"],
)

ament_package(
    cmake_export_dependencies_list = [
        "cv_bridge",
        "rclcpp",
        "sensor_msgs",
    ],
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
        ],
        allow_empty = True,
    ),
    install = [":pkg_files_share_0"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@rclcpp//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
