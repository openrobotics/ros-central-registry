load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

# Mirrors ament_package(CONFIG_EXTRAS "ament_cmake_ros-extras.cmake.in"): configure_file(@ONLY) of the template.
genrule(
    name = "extras_cmake",
    srcs = ["ament_cmake_ros-extras.cmake.in"],
    outs = ["ament_cmake_ros-extras.cmake"],
    cmd = "sed -e 's|@PROJECT_NAME@|ament_cmake_ros|g' -e 's|@PYTHON_INSTALL_DIR@|lib/python3.14/site-packages|g' $< > $@",
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = glob(["cmake/**"]) + [":extras_cmake"],
    cmake_export_dependencies_list = [
        "ament_cmake",
        "ament_cmake_ros_core",
    ],
    cmake_extras = ["ament_cmake_ros-extras.cmake"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_ros_core//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rmw_test_fixture_implementation//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
