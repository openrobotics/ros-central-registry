load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

# Map of shared library (key) to its static library (value).
DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
    "@rosdistro//cc:glfw": "@rosdistro//cc:glfw_library",
    "@rosdistro//cc:mujoco": "@rosdistro//cc:mujoco_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@mujoco_ros2_control_msgs//:cc",
    "@rosdistro//cc:opengl_headers",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
    "@std_srvs//:cc",
    "@visualization_msgs//:cc",
]

COPTS = [
    "-Wno-missing-template-arg-list-after-template-kw",
]

# Header-only interface for external plugin implementations (upstream
# INTERFACE target mujoco_ros2_control_plugins).
cc_library(
    name = "mujoco_ros2_control_plugins",
    hdrs = ["include/mujoco_ros2_control_plugins/mujoco_ros2_control_plugins_base.hpp"],
    includes = ["include"],
    deps = [
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:mujoco_library",
    ],
)

cc_library(
    name = "mujoco_ros2_control_plugins_impl_library",
    srcs = [
        "src/base_velocity_plugin.cpp",
        "src/camera_plugin.cpp",
        "src/external_wrench_plugin.cpp",
        "src/free_joint_state_publisher_plugin.cpp",
        "src/heartbeat_publisher_plugin.cpp",
        "src/mujoco_3d_lidar_plugin.cpp",
        "src/rangefinder_lidar_plugin.cpp",
    ],
    hdrs = [
        "src/base_velocity_plugin.hpp",
        "src/camera_plugin.hpp",
        "src/external_wrench_plugin.hpp",
        "src/free_joint_state_publisher_plugin.hpp",
        "src/heartbeat_publisher_plugin.hpp",
        "src/mujoco_3d_lidar_plugin.hpp",
        "src/rangefinder_lidar_plugin.hpp",
    ],
    copts = COPTS,
    includes = ["src"],
    local_defines = ros_local_defines() + [
        "REALTIME_TOOLS_VERSION_MAJOR=5",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":mujoco_ros2_control_plugins"],
    alwayslink = True,
)

cc_shared_library(
    name = "mujoco_ros2_control_plugins_impl",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mujoco_ros2_control_plugins_impl_library"],
)

TEST_DYNAMIC_DEPS = DEPENDENCIES.keys() + [
    ":mujoco_ros2_control_plugins_impl",
    "@ament_index_cpp//:ament_index_cpp",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = TEST_DYNAMIC_DEPS,
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mujoco_ros2_control_plugins_impl",
    ],
    package_xml = "package.xml",
    plugins = ["mujoco_ros2_control_plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@backward_ros//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mujoco_3d_lidar//:ament_package",
        "@mujoco_ros2_control_msgs//:ament_package",
        "@mujoco_vendor//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@realtime_tools//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)

TEST_DEPS = DEPENDENCIES.values() + CC_DEPS + [
    ":mujoco_ros2_control_plugins_impl_library",
    "@ament_index_cpp//:ament_index_cpp_library",
    "@rosdistro//cc:bazel_test_helper",
    "@rosdistro//cc:googletest",
]

[cc_test(
    name = name,
    srcs = ["test/%s.cpp" % name],
    copts = COPTS,
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines() + ["GTEST_HAS_PTHREAD=1"],
    # test_camera_plugin renders offscreen with OpenGL, which the hermetic test
    # environment does not provide.
    tags = ["manual"] if name == "test_camera_plugin" else [],
    deps = TEST_DEPS,
) for name in [
    "test_3d_lidar_plugin",
    "test_base_velocity_plugin",
    "test_camera_plugin",
    "test_external_wrench_plugin",
    "test_free_joint_state_publisher_plugin",
]]

ament_package(
    cmake_export_dependencies_list = [
        "mujoco_vendor",
        "pluginlib",
        "rclcpp",
        "ros2_control_cmake",
    ],
    cmake_export_has_library_target = True,
    cmake_export_interface_targets = ["mujoco_ros2_control_plugins"],
    cmake_export_libraries = False,
    cmake_export_name = "export_mujoco_ros2_control_plugins",
    headers = ["include/mujoco_ros2_control_plugins/mujoco_ros2_control_plugins_base.hpp"],
    include_prefix = "",
    libraries = [
        ":mujoco_ros2_control_plugins_impl",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@backward_ros//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mujoco_3d_lidar//:ament_package",
        "@mujoco_ros2_control_msgs//:ament_package",
        "@mujoco_vendor//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@realtime_tools//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
