load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

TEST_DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosbag2_compression_zstd//:rosbag2_compression_zstd": "@rosbag2_compression_zstd//:rosbag2_compression_zstd_library",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosbag2_interfaces//:cc_shared": "@rosbag2_interfaces//:cc",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosbag2_test_common//:rosbag2_test_common": "@rosbag2_test_common//:rosbag2_test_common_library",
    "@rosbag2_transport//:rosbag2_transport": "@rosbag2_transport//:rosbag2_transport_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@test_msgs//:cc_shared": "@test_msgs//:cc",
}

[cc_test(
    name = test.removesuffix(".py"),
    srcs = ["rosbag2_tests/{0}.cpp".format(src)] + ["rosbag2_tests/record_fixture.hpp"],
    data = ["//:_test_data_0"] + ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines() + [
        '_TEST_RESOURCES_DIR_PATH=\\"../rosbag2_tests+/test/rosbag2_tests\\"',
        '_SRC_RESOURCES_DIR_PATH=\\"../rosbag2_tests+/resources\\"',
    ],
    deps = TEST_DEPENDENCIES.values() + [
        "@rosdistro//cc:googletest",
    ],
) for test, src in {
    "test_converter": "test_converter",
    "test_reindex": "test_reindexer",
    "test_rosbag2_cpp_api": "test_rosbag2_cpp_api",
    "test_rosbag2_cpp_get_service_info": "test_rosbag2_cpp_get_service_info",
    "test_rosbag2_storage_api": "test_rosbag2_storage_api",
}.items()]

[cc_test(
    name = test.removesuffix(".py"),
    size = "large",
    srcs = ["rosbag2_tests/{0}.cpp".format(test)] + ["rosbag2_tests/record_fixture.hpp"],
    data = ["//:_test_data_1"] + [
        "//:ament_index",
        "@ros2bag//:ros2",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines() + [
        '_TEST_RESOURCES_DIR_PATH=\\"../rosbag2_tests+/test/rosbag2_tests\\"',
        '_SRC_RESOURCES_DIR_PATH=\\"../rosbag2_tests+/resources\\"',
    ],
    # The record end-to-end test is flaky under parallel test load (passes when
    # run alone), so run it exclusively.
    tags = ["no-sandbox"] if test == "test_rosbag2_play_end_to_end" else (["exclusive"] if test == "test_rosbag2_record_end_to_end" else []),
    deps = TEST_DEPENDENCIES.values() + [
        "@rosdistro//cc:googletest",
    ],
) for test in [
    "test_rosbag2_info_end_to_end",
    "test_rosbag2_play_end_to_end",
    "test_rosbag2_record_end_to_end",
]]
