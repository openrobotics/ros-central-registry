#!/bin/bash
# Find the directory of this script
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

if [ -f "$DIR/../ros2cli/ros2" ]; then
  exec "$DIR/../ros2cli/ros2" "$@"
elif [ -f "$DIR/../ros2cli+/ros2" ]; then
  exec "$DIR/../ros2cli+/ros2" "$@"
else
  echo "Error: Cannot find ros2 binary in runfiles sibling directories." >&2
  echo "DIR is: $DIR" >&2
  echo "Contents of DIR/.. :" >&2
  ls -la "$DIR/.." >&2
  exit 1
fi
