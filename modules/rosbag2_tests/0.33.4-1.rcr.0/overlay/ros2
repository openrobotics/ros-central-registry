#!/bin/sh
# `ros2` shim for the end-to-end tests. rosbag2_test_common's
# process_execution_helpers (RCR patch) resolve `ros2` as
# $TEST_SRCDIR/rosbag2_tests+/ros2; forward to ros2cli's entry point (with the
# `bag` command loaded) from the @ros2bag runfiles next to this package's.
#
# The tests chdir() into the bag directory before invoking us, so the
# workspace's relative LD_LIBRARY_PATH=lib (which points at the runfiles
# root's lib/ when the test starts) must be made absolute here.
runfiles="$(cd "$(dirname "$0")/.." && pwd)"
LD_LIBRARY_PATH="${runfiles}/_main/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export LD_LIBRARY_PATH
exec "${runfiles}/ros2bag+/ros2" "$@"
