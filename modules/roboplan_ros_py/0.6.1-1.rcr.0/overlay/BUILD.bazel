load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

py_library(
    name = "roboplan_ros_py",
    srcs = glob(["roboplan_ros_py/**/*.py"]),
    imports = ["."],
    deps = [
        "@builtin_interfaces//:py",
        "@rclpy",
        "@roboplan//:roboplan_py",
        "@sensor_msgs//:py",
        "@trajectory_msgs//:py",
    ],
)

py_pytest(
    name = "test_kinematics",
    srcs = ["test/test_kinematics.py"],
    data = [":ament_index"],
    deps = [":roboplan_ros_py"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@builtin_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@roboplan//:ament_package",
        "@roboplan_ros_cpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@trajectory_msgs//:ament_package",
    ],
)

ament_package(
    package_xml = "package.xml",
    python = [":roboplan_ros_py"],
    deps = [
        ":ament_index",
        "@builtin_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@roboplan//:ament_package",
        "@roboplan_ros_cpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@trajectory_msgs//:ament_package",
    ],
)
