load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@gtsam//:_gen_textual_hdrs",
    "@gtsam//:cephes-gtsam_library",
    "@gtsam//:gtsam_library",
    "@gtsam//:metis-gtsam_library",
    "@mrpt_poses//:mrpt_poses_library",
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:boost.timer",
]

cc_library(
    name = "mola_gtsam_factors_library",
    srcs = [":gen_mola_gtsam_factors_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/mola_gtsam_factors",
        "src",
    ],
    local_defines = ros_local_defines() + ["NDEBUG"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_gtsam_factors",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":mola_gtsam_factors_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

write_file(
    name = "gen_mola_gtsam_factors_stub_cpp",
    out = "_gen/mola_gtsam_factors_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mola_gtsam_factors",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_gtsam_factors": [
            "libmola_gtsam_factors.so.3.0",
            "libmola_gtsam_factors.so.3.0.2",
        ],
    },
    deps = [
        "@gtsam//:ament_package",
        "@mola_common//:ament_package",
        "@mrpt_poses//:ament_package",
    ],
)

cc_test(
    name = "run_test_imu_helpers",
    srcs = [":gen_mola_gtsam_factors_stub_cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        ":ament_index",
    ] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/mola_gtsam_factors",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "MOLA_MODULE_SOURCE_DIR=\\\"tests\\\"",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":mola_gtsam_factors_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [
        ":mola_gtsam_factors",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_gtsam_factors": [
            "libmola_gtsam_factors.so.3.0",
            "libmola_gtsam_factors.so.3.0.2",
        ],
    },
    deps = [":ament_index"] + [
        "@gtsam//:ament_package",
        "@mola_common//:ament_package",
        "@mrpt_poses//:ament_package",
    ],
)
