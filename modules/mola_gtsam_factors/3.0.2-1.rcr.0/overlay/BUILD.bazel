load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
)

DEPENDENCIES = {}

CC_DEPS = [
    "@gtsam//:_gen_textual_hdrs",
    "@gtsam//:cephes-gtsam_library",
    "@gtsam//:gtsam_library",
    "@gtsam//:metis-gtsam_library",
    "@mrpt_poses//:mrpt_poses_library",
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:boost.timer",
]

cc_library(
    name = "mola_gtsam_factors_library",
    srcs = [
        "src/FactorAngularVelocityIntegration.cpp",
        "src/FactorConstLocalVelocity.cpp",
        "src/FactorGnssEnu.cpp",
        "src/FactorGnssMapEnu.cpp",
        "src/FactorTrapezoidalIntegrator.cpp",
        "src/FactorTricycleKinematic.cpp",
        "src/MapGravityFactor.cpp",
        "src/MeasuredGravityFactor.cpp",
        "src/Pose3RotationFactor.cpp",
        "src/imu_helpers.cpp",
        "src/register.cpp",
    ],
    hdrs = [
        "include/mola_gtsam_factors/FactorAngularVelocityIntegration.h",
        "include/mola_gtsam_factors/FactorConstLocalVelocity.h",
        "include/mola_gtsam_factors/FactorGnssEnu.h",
        "include/mola_gtsam_factors/FactorGnssMapEnu.h",
        "include/mola_gtsam_factors/FactorTrapezoidalIntegrator.h",
        "include/mola_gtsam_factors/FactorTricycleKinematic.h",
        "include/mola_gtsam_factors/MapGravityFactor.h",
        "include/mola_gtsam_factors/MeasuredGravityFactor.h",
        "include/mola_gtsam_factors/Pose3RotationFactor.h",
        "include/mola_gtsam_factors/gtsam_detect_version.h",
        "include/mola_gtsam_factors/id.h",
        "include/mola_gtsam_factors/imu_helpers.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/mola_gtsam_factors",
        "src",
    ],
    local_defines = ros_local_defines() + ["NDEBUG"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_gtsam_factors",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":mola_gtsam_factors_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    libraries = [":mola_gtsam_factors"],
    package_xml = "package.xml",
    sonames = {"mola_gtsam_factors": [
        "libmola_gtsam_factors.so.3.0",
        "libmola_gtsam_factors.so.3.0.2",
    ]},
    deps = [
        "@gtsam//:ament_package",
        "@mola_common//:ament_package",
        "@mrpt_poses//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/mola_gtsam_factors/FactorAngularVelocityIntegration.h",
        "include/mola_gtsam_factors/FactorConstLocalVelocity.h",
        "include/mola_gtsam_factors/FactorGnssEnu.h",
        "include/mola_gtsam_factors/FactorGnssMapEnu.h",
        "include/mola_gtsam_factors/FactorTrapezoidalIntegrator.h",
        "include/mola_gtsam_factors/FactorTricycleKinematic.h",
        "include/mola_gtsam_factors/MapGravityFactor.h",
        "include/mola_gtsam_factors/MeasuredGravityFactor.h",
        "include/mola_gtsam_factors/Pose3RotationFactor.h",
        "include/mola_gtsam_factors/gtsam_detect_version.h",
        "include/mola_gtsam_factors/id.h",
        "include/mola_gtsam_factors/imu_helpers.h",
    ],
    include_prefix = "",
    libraries = [":mola_gtsam_factors"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@gtsam//:ament_package",
        "@mola_common//:ament_package",
        "@mrpt_poses//:ament_package",
    ],
)
