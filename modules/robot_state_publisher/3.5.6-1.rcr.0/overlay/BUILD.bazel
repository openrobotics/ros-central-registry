load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@kdl_parser//:kdl_parser": "@kdl_parser//:kdl_parser_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
    "@urdf//:urdf": "@urdf//:urdf_library",
}

cc_library(
    name = "robot_state_publisher_node_library",
    srcs = ["src/robot_state_publisher.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@builtin_interfaces//:cc",
        "@geometry_msgs//:cc",
        "@rcl_interfaces//:cc",
        "@sensor_msgs//:cc",
        "@std_msgs//:cc",
    ],
)

cc_shared_library(
    name = "robot_state_publisher_node",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":robot_state_publisher_node_library"],
    deps = [":robot_state_publisher_node_library"],
)

### COMPONENTS

rclcpp_components_register_node(
    name = "robot_state_publisher",
    component = ":robot_state_publisher_node",
    executor = "SingleThreadedExecutor",
    node_name = "robot_state_publisher",
    plugin = "robot_state_publisher::RobotStatePublisher",
)

### TRANSITIVE DYNAMIC DEPS

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":robot_state_publisher_node",
    ],
    visibility = ["//visibility:private"],
)

