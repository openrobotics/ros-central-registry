load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "rsp-launch-urdf-file.xml",
        "rsp-launch-urdf-file1.py",
        "rsp-launch-urdf-file2.py",
        "rsp-launch-urdf-inline.py",
        "rsp-launch-urdf-inline.xml",
        "rsp-launch-xacro-api.py",
        "rsp-launch-xacro-command-subst.py",
        "rsp-launch-xacro-command-subst.xml",
        "rsp-launch-xacro-popen.py",
    ],
)

launch_ros_binary(
    name = "rsp_launch_urdf_file1_launch",
    src = "rsp-launch-urdf-file1.py",
    data = [
        "//:ament_index",
        "//:robot_state_publisher",
    ],
)

launch_ros_binary(
    name = "rsp_launch_urdf_file2_launch",
    src = "rsp-launch-urdf-file2.py",
    data = [
        "//:ament_index",
        "//:robot_state_publisher",
    ],
    deps = ["@ament_index_python"],
)

launch_ros_binary(
    name = "rsp_launch_urdf_inline_launch",
    src = "rsp-launch-urdf-inline.py",
    data = [
        "//:ament_index",
        "//:robot_state_publisher",
    ],
)

launch_ros_binary(
    name = "rsp_launch_xacro_api_launch",
    src = "rsp-launch-xacro-api.py",
    data = [
        "//:ament_index",
        "//:robot_state_publisher",
    ],
    deps = ["@xacro//:xacro_lib"],
)

launch_ros_binary(
    name = "rsp_launch_xacro_command_subst_launch",
    src = "rsp-launch-xacro-command-subst.py",
    data = [
        "//:ament_index",
        "//:robot_state_publisher",
        "@xacro",
        "@xacro//:ament_index",
    ],
)

launch_ros_binary(
    name = "rsp_launch_xacro_popen_launch",
    src = "rsp-launch-xacro-popen.py",
    data = [
        "//:ament_index",
        "//:robot_state_publisher",
    ],
)
