load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rmf_obstacle_msgs//:cc",
    "@rmf_visualization_msgs//:cc",
    "@std_msgs//:cc",
    "@vision_msgs//:cc",
    "@visualization_msgs//:cc",
]

cc_library(
    name = "obstacle_visualizer_library",
    srcs = ["src/ObstacleVisualizer.cpp"],
    hdrs = ["src/ObstacleVisualizer.hpp"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "obstacle_visualizer",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":obstacle_visualizer_library"],
)

rclcpp_components_register_node(
    name = "obstacle_visualizer_node",
    component = ":obstacle_visualizer",
    node_name = "obstacle_visualizer_node",
    plugin = "ObstacleVisualizer",
)

ament_index(
    name = "ament_index",
    components = [":obstacle_visualizer_node_record"],
    lib_data = [":obstacle_visualizer_node"],
    libraries = [":obstacle_visualizer"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rmf_obstacle_msgs//:ament_package",
        "@rmf_utils//:ament_package",
        "@rmf_visualization_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@vision_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    libraries = [":obstacle_visualizer"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rmf_obstacle_msgs//:ament_package",
        "@rmf_utils//:ament_package",
        "@rmf_visualization_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@vision_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
