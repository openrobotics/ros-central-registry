load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            "CHANGELOG.rst",
            "README.md",
            "package.xml",
            "resource/driver_test.urdf",
            "resource/webots_ros2_tests",
            "setup.cfg",
            "setup.py",
            "test/test_copyright.py",
            "test/test_system_driver.py",
            "test/test_system_epuck.py",
            "test/test_system_epuck_with_tools.py",
            "test/test_system_mavic.py",
            "test/test_system_rosbot.py",
            "test/test_system_rosbot_xl.py",
            "test/test_system_tesla.py",
            "test/test_system_tiago.py",
            "test/test_system_turtlebot.py",
            "test/test_system_turtlebot_tutorial_navigation.py",
            "test/test_system_turtlebot_tutorial_slam.py",
            "test/test_system_universal_robot.py",
            "webots_ros2_tests/__init__.py",
            "webots_ros2_tests/plugin_test.py",
            "webots_ros2_tests/utils.py",
            "worlds/.driver_test.wbproj",
            "worlds/driver_test.wbt",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclpy//:ament_package",
        "@ros2bag//:ament_package",
        "@rosbag2_storage_default_plugins//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2_ros//:ament_package",
        "@webots_ros2_driver//:ament_package",
        "@webots_ros2_epuck//:ament_package",
        "@webots_ros2_husarion//:ament_package",
        "@webots_ros2_mavic//:ament_package",
        "@webots_ros2_tesla//:ament_package",
        "@webots_ros2_tiago//:ament_package",
        "@webots_ros2_turtlebot//:ament_package",
        "@webots_ros2_universal_robot//:ament_package",
    ],
)
