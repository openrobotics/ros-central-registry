load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

write_file(
    name = "pkg_info",
    out = "ros2doctor-0.40.9.egg-info/PKG-INFO",
    content = [
        "Metadata-Version: 2.1",
        "Name: ros2doctor",
        "Version: 0.40.9",
    ],
)

write_file(
    name = "entry_points_txt",
    out = "ros2doctor-0.40.9.egg-info/entry_points.txt",
    content = [
        "[ros2cli.command]",
        "doctor = ros2doctor.command.doctor:DoctorCommand",
        "wtf = ros2doctor.command.doctor:WtfCommand",
        "",
        "[ros2doctor.checks]",
        "PlatformCheck = ros2doctor.api.platform:PlatformCheck",
        "NetworkCheck = ros2doctor.api.network:NetworkCheck",
        "TopicCheck = ros2doctor.api.topic:TopicCheck",
        "QoSCompatibilityCheck = ros2doctor.api.qos_compatibility:QoSCompatibilityCheck",
        "PackageCheck = ros2doctor.api.package:PackageCheck",
        "",
        "[ros2doctor.report]",
        "PlatformReport = ros2doctor.api.platform:PlatformReport",
        "RosdistroReport = ros2doctor.api.platform:RosdistroReport",
        "NetworkReport = ros2doctor.api.network:NetworkReport",
        "RMWReport = ros2doctor.api.rmw:RMWReport",
        "TopicReport = ros2doctor.api.topic:TopicReport",
        "ServiceReport = ros2doctor.api.service:ServiceReport",
        "ActionReport = ros2doctor.api.action:ActionReport",
        "QoSCompatibilityReport = ros2doctor.api.qos_compatibility:QoSCompatibilityReport",
        "PackageReport = ros2doctor.api.package:PackageReport",
        "EnvironmentReport = ros2doctor.api.environment:EnvironmentReport",
        "",
        "[ros2cli.extension_point]",
        "ros2doctor.verb = ros2doctor.verb:VerbExtension",
        "",
        "[ros2doctor.verb]",
        "hello = ros2doctor.verb.hello:HelloVerb",
    ],
)

py_library(
    name = "ros2doctor",
    srcs = [
        "ros2doctor/__init__.py",
        "ros2doctor/api/__init__.py",
        "ros2doctor/api/action.py",
        "ros2doctor/api/environment.py",
        "ros2doctor/api/format.py",
        "ros2doctor/api/network.py",
        "ros2doctor/api/package.py",
        "ros2doctor/api/platform.py",
        "ros2doctor/api/qos_compatibility.py",
        "ros2doctor/api/rmw.py",
        "ros2doctor/api/service.py",
        "ros2doctor/api/topic.py",
        "ros2doctor/command/__init__.py",
        "ros2doctor/command/doctor.py",
        "ros2doctor/verb/__init__.py",
        "ros2doctor/verb/hello.py",
    ],
    data = ["ros2doctor/py.typed"] + [
        ":ament_index",
        ":entry_points_txt",
        ":pkg_info",
    ],
    imports = ["."],
    deps = [
        "@rclpy",
        "@ros2cli",
        "@std_msgs//:py",
    ],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "README.md",
        "package.xml",
        "resource/ros2doctor",
        "ros2doctor/__init__.py",
        "ros2doctor/api/__init__.py",
        "ros2doctor/api/action.py",
        "ros2doctor/api/environment.py",
        "ros2doctor/api/format.py",
        "ros2doctor/api/network.py",
        "ros2doctor/api/package.py",
        "ros2doctor/api/platform.py",
        "ros2doctor/api/qos_compatibility.py",
        "ros2doctor/api/rmw.py",
        "ros2doctor/api/service.py",
        "ros2doctor/api/topic.py",
        "ros2doctor/command/__init__.py",
        "ros2doctor/command/doctor.py",
        "ros2doctor/py.typed",
        "ros2doctor/verb/__init__.py",
        "ros2doctor/verb/hello.py",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
    "xmllint",
]]

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":ros2doctor"] + ["ros2doctor/py.typed"],
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclpy//:ament_package",
        "@ros2action//:ament_package",
        "@ros2cli//:ament_package",
        "@ros_environment//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
