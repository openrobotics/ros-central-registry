load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

py_library(
    name = "simple_launch",
    srcs = glob(["simple_launch/**/*.py"]),
    imports = ["."],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    data = glob(["example/**"]),
    executables = glob(["scripts/*"]),
    package_xml = "package.xml",
    python = [":simple_launch"],
    deps = [
        "@ament_cmake_python//:ament_package",
        "@ament_index_python//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@rosdistro//:ament_package",
        "@xacro//:ament_package",
    ],
)
