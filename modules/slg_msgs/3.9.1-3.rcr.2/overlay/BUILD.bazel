load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "slg_core",
    hdrs = [
        "include/slg_msgs/point2D.hpp",
        "include/slg_msgs/polygon.hpp",
        "include/slg_msgs/segment2D.hpp",
    ],
    includes = ["include"],
    deps = [
        ":cc",
        "@geometry_msgs//:cc",
        "@std_msgs//:cc",
    ],
)

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:Segment",
        "//msg:SegmentArray",
    ],
)

rosidl_ament_package(
    name = "ament_package",
    headers = [
        "include/slg_msgs/point2D.hpp",
        "include/slg_msgs/polygon.hpp",
        "include/slg_msgs/segment2D.hpp",
    ],
    interface_library = "slg_core",
    interface_library_export = "slg_core",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
