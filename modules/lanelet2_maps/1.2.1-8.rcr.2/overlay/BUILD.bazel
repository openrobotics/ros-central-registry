load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

# Data-only package: upstream installs res/ (example maps) under share/.
ament_index(
    name = "ament_index",
    data = [
        "res/mapping_example.osm",
        "res/mapping_example-debug.osm",
    ],
    package_xml = "package.xml",
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_core//:ament_package",
        "@lanelet2_core//:ament_package",
        "@mrt_cmake_modules//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
