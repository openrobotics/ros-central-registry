--- a/test/motion_loader_test.cpp
+++ b/test/motion_loader_test.cpp
@@ -48,7 +48,18 @@
 
   // load parameters
   const auto test_path = std::filesystem::absolute(__FILE__).parent_path().string();
-  const std::string config_path = test_path + "/play_motion2_config.yaml";
+  std::string config_path = test_path + "/play_motion2_config.yaml";
+  if (!std::filesystem::exists(config_path)) {
+    // Under Bazel __FILE__ is relative to the execroot, which is not the test's
+    // working directory; fall back to the runfiles-relative location.
+    // External repos are compiled as external/<repo>/... but their runfiles
+    // live at ../<repo>/ relative to the test's working directory.
+    std::string file = __FILE__;
+    if (file.rfind("external/", 0) == 0) {
+      file = "../" + file.substr(sizeof("external/") - 1);
+    }
+    config_path = std::filesystem::path(file).parent_path().string() + "/play_motion2_config.yaml";
+  }
 
