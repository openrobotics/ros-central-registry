write_file(
    name = "gen_passthrough_controller_parameters_hpp",
    out = "_gen/include/play_motion2/passthrough_controller_parameters.hpp",
    content = ["#pragma once\n#include <memory>\n#include <string>\n#include <vector>\n#include \"rclcpp/rclcpp.hpp\"\n#include \"rclcpp_lifecycle/lifecycle_node.hpp\"\nnamespace passthrough_controller {\nstruct Params {\n  std::vector<std::string> interfaces;\n};\nclass ParamListener {\n public:\n  template <typename NodeT>\n  explicit ParamListener(const NodeT &) {}\n  Params get_params() const { return Params{}; }\n};\n}  // namespace passthrough_controller\n"],
)

write_file(
    name = "gen_move_group_interface_hpp",
    out = "_gen/include/moveit_ros_planning_interface/moveit/move_group_interface/move_group_interface.hpp",
    content = ["#pragma once\n#include <moveit/move_group_interface/move_group_interface.hpp>\n"],
)

cc_library(
    name = "client_library",
    srcs = ["src/play_motion2/client.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_move_group_interface_hpp",
        ":gen_passthrough_controller_parameters_hpp",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/play_motion2",
    ],
    local_defines = ros_local_defines() + [
        "HARDWARE_INTERFACE_VERSION_MAJOR=6",
        "MOVEIT_VERSION_MAJOR=2",
        "MOVEIT_VERSION_MINOR=15",
        "RCLCPP_VERSION_MAJOR=32",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

