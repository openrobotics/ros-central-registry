load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load(":defs.bzl", "generate_version_h")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

exports_files(["defs.bzl"])

CMAKE_FILES = [
    "ament_generate_version_header.cmake",
    "generate_version_header.cmake.in",
    "version.h.in",
]

generate_version_h(
    name = "some_lib_version_h",
    out = "include/ament_generate_version_header/version.hpp",
)

cc_library(
    name = "some_lib",
    testonly = True,
    hdrs = [":some_lib_version_h"],
    includes = ["include"],
)

ament_package(
    name = "ament_package",
    cmake = ["ament_cmake_gen_version_h-extras.cmake"] + ["//cmake:" + f for f in CMAKE_FILES],
    cmake_extras = ["ament_cmake_gen_version_h-extras.cmake"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_package",
        "@rosdistro//:ament_package",
    ],
)
