load("@qt//:qt.bzl", "qt_cc_library")
load("@rosdistro//ament:ament_resource.bzl", "register_ament_resource")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@cartographer//:cartographer": "@cartographer//:cartographer_library",
    "@cartographer_ros_msgs//:cc_shared": "@cartographer_ros_msgs//:cc",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:OgreMain": "@rosdistro//cc:OgreMain_library",
    "@rviz_common//:rviz_common": "@rviz_common//:rviz_common_library",
    "@rviz_rendering//:rviz_rendering": "@rviz_rendering//:rviz_rendering_library",
}

HEADERS = [
    "include/cartographer_rviz/drawable_submap.h",
    "include/cartographer_rviz/ogre_slice.h",
    "include/cartographer_rviz/submaps_display.h",
]

# add_library(cartographer_rviz SHARED ...) with CMAKE_AUTOMOC; upstream links
# the cartographer_ros library (static here, see cartographer_ros).
qt_cc_library(
    name = "cartographer_rviz_library",
    srcs = [
        "src/drawable_submap.cpp",
        "src/ogre_slice.cpp",
        "src/submaps_display.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    moc_hdrs = HEADERS,
    deps = DEPENDENCIES.values() + [
        "@cartographer_ros//:cartographer_ros_library",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtbase//:widgets",
        "@rosdistro//cc:absl_memory",
        "@rosdistro//cc:absl_synchronization",
        "@rosdistro//cc:eigen",
    ],
    alwayslink = True,
)

cc_shared_library(
    name = "cartographer_rviz",
    dynamic_deps = DEPENDENCIES.keys() + [
        "@cartographer_ros//:transitive_dynamic_deps",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:widgets_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":cartographer_rviz_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":cartographer_rviz"],
)

# register_rviz_ogre_media_exports(DIRECTORIES "ogre_media/materials/glsl120"
#                                              "ogre_media/materials/scripts")
register_ament_resource(
    name = "rviz_ogre_media_exports",
    category = "rviz_ogre_media_exports",
    content = "\n".join([
        "cartographer_rviz/ogre_media/materials/glsl120",
        "cartographer_rviz/ogre_media/materials/scripts",
    ]) + "\n",
)

### PACKAGING

ament_index(
    name = "ament_index",
    data = [
        "ogre_media/materials/glsl120/glsl120.program",
        "ogre_media/materials/glsl120/submap.frag",
        "ogre_media/materials/glsl120/submap.vert",
        "ogre_media/materials/scripts/submap.material",
    ],
    libraries = [":cartographer_rviz"],
    package_xml = "package.xml",
    plugin_category = "rviz_common",
    plugins = ["rviz_plugin_description.xml"],
    deps = [":rviz_ogre_media_exports"],
)

ament_package(
    name = "ament_package",
    headers = HEADERS,
    include_prefix = "",
    libraries = [":cartographer_rviz"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@cartographer//:ament_package",
        "@cartographer_ros//:ament_package",
        "@cartographer_ros_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_ogre_vendor//:ament_package",
        "@rviz_rendering//:ament_package",
    ],
)
