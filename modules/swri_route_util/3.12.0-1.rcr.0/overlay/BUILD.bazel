load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@swri_geometry_util//:swri_geometry_util": "@swri_geometry_util//:swri_geometry_util_library",
    "@swri_math_util//:swri_math_util": "@swri_math_util//:swri_math_util_library",
    "@swri_transform_util//:swri_transform_util": "@swri_transform_util//:swri_transform_util_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@marti_common_msgs//:cc",
    "@marti_nav_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@std_msgs//:cc",
    "@visualization_msgs//:cc",
]

cc_library(
    name = "swri_route_util_library",
    srcs = [
        "src/route.cpp",
        "src/route_point.cpp",
        "src/route_speeds.cpp",
        "src/util.cpp",
        "src/visualization.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/swri_route_util",
    ],
    local_defines = ros_local_defines() + [
        "USE_NEW_TF2_ROS_CTORS=0",
        "USE_NEW_TF2_TOMSG=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "swri_route_util",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["@@//:__subpackages__"],
    deps = [":swri_route_util_library"],
)

cc_library(
    name = "swri_route_util_nodes_library",
    srcs = ["src/nodes/obstacle_marker_node.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/swri_route_util",
    ],
    local_defines = ros_local_defines() + [
        "COMPOSITION_BUILDING_DLL",
        "USE_NEW_TF2_ROS_CTORS=0",
        "USE_NEW_TF2_TOMSG=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":swri_route_util_library"],
)

cc_shared_library(
    name = "swri_route_util_nodes",
    dynamic_deps = DEPENDENCIES.keys() + [":swri_route_util"],
    deps = [":swri_route_util_nodes_library"],
)

rclcpp_components_register_node(
    name = "obstacle_marker_node",
    component = ":swri_route_util_nodes",
    node_name = "obstacle_marker_node",
    plugin = "swri_route_util::ObstacleMarkerNode",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":swri_route_util"],
)

ament_index(
    name = "ament_index",
    components = [":obstacle_marker_node_record"],
    lib_data = [
        ":obstacle_marker_node",
    ],
    libraries = [
        ":swri_route_util",
        ":swri_route_util_nodes",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@geometry_msgs//:ament_package",
        "@marti_common_msgs//:ament_package",
        "@marti_nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@std_msgs//:ament_package",
        "@swri_geometry_util//:ament_package",
        "@swri_math_util//:ament_package",
        "@swri_transform_util//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)

cc_test(
    name = "test_visualization",
    srcs = ["test/test_visualization.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/swri_route_util",
    ],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "USE_NEW_TF2_ROS_CTORS=0",
        "USE_NEW_TF2_TOMSG=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":swri_route_util_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "ament_cmake",
        "geometry_msgs",
        "marti_common_msgs",
        "marti_nav_msgs",
        "rclcpp",
        "rclcpp_components",
        "std_msgs",
        "swri_math_util",
        "swri_transform_util",
        "tf2_geometry_msgs",
        "visualization_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_swri_route_util",
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    libraries = [
        ":swri_route_util",
        ":swri_route_util_nodes",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@geometry_msgs//:ament_package",
        "@marti_common_msgs//:ament_package",
        "@marti_nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@std_msgs//:ament_package",
        "@swri_geometry_util//:ament_package",
        "@swri_math_util//:ament_package",
        "@swri_transform_util//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
