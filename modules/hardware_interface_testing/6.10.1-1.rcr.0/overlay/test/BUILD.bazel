load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@control_msgs//:cc_shared": "@control_msgs//:cc",
    "@hardware_interface//:hardware_interface": "@hardware_interface//:hardware_interface_library",
    "@lifecycle_msgs//:cc_shared": "@lifecycle_msgs//:cc",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@ros2_control_test_assets//:ros2_control_test_assets",
    "@rosdistro//cc:fmt",
]

exports_files([
    "test_components/test_actuator.cpp",
    "test_components/test_actuator_exclusive_interfaces.cpp",
    "test_components/test_components.xml",
    "test_components/test_sensor.cpp",
    "test_components/test_system.cpp",
    "test_resource_manager.cpp",
    "test_resource_manager.hpp",
    "test_resource_manager_prepare_perform_switch.cpp",
    "test_rm_exception_handling.cpp",
])

cc_library(
    name = "test_components_library",
    srcs = [
        "test_components/test_actuator.cpp",
        "test_components/test_actuator_exclusive_interfaces.cpp",
        "test_components/test_sensor.cpp",
        "test_components/test_system.cpp",
    ],
    hdrs = ["test_resource_manager.hpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = ["."],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + ["//:_test_root_headers"],
)

cc_shared_library(
    name = "test_components",
    dynamic_deps = [
        "//:transitive_dynamic_deps",
        "@control_msgs//:cc_shared",
        "@lifecycle_msgs//:cc_shared",
    ],
    deps = [":test_components_library"],
)

cc_test(
    name = "test_resource_manager",
    srcs = ["test_resource_manager.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + ["test_components/test_components.xml"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "ROS2_CONTROL_STRICT_TIMING_TESTS=1",
        "_FILE_OFFSET_BITS=64",
    ],
    # Flaky under parallel test load (passes when run alone), so run it exclusively.
    tags = ["exclusive"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":test_components_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

cc_test(
    name = "test_resource_manager_prepare_perform_switch",
    srcs = ["test_resource_manager_prepare_perform_switch.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + ["test_components/test_components.xml"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":test_components_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

cc_test(
    name = "test_rm_exception_handling",
    srcs = ["test_rm_exception_handling.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + ["test_components/test_components.xml"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":test_components_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)
