load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

alias(
    name = "foxglove_library",
    actual = "@rosdistro//cc:foxglove_sdk_library",
)

alias(
    name = "foxglove",
    actual = "@rosdistro//cc:foxglove_sdk",
)

alias(
    name = "foxglove_sdk_vendor_cpp_library",
    actual = "@rosdistro//cc:foxglove_sdk_library",
)

alias(
    name = "foxglove_sdk_vendor_cpp",
    actual = "@rosdistro//cc:foxglove_sdk",
)

ament_index(
    name = "ament_index",
    libraries = [
        ":foxglove_sdk_vendor_cpp",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
    ],
)

ament_package(
    cmake = [
        "foxglove_sdk_vendor-extras.cmake",
    ],
    cmake_export_dependencies = False,
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "foxglove_sdk_vendorTargets",
    cmake_extras = ["foxglove_sdk_vendor-extras.cmake"],
    cmake_strip_prefix = "",
    include_prefix = "",
    libraries = [
        ":foxglove_sdk_vendor_cpp",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
