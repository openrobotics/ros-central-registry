load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@diagnostic_msgs//:cc",
    "@rcl_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@std_msgs//:cc",
]

cc_library(
    name = "diagnostic_aggregator_library",
    srcs = [
        "src/aggregator.cpp",
        "src/analyzer_group.cpp",
        "src/status_item.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    includes = [
        "include",
        "include/diagnostic_aggregator",
    ],
    local_defines = ros_local_defines() + [
        "DIAGNOSTIC_AGGREGATOR_BUILDING_DLL",
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "diagnostic_aggregator",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":diagnostic_aggregator_library"],
)

cc_library(
    name = "diagnostic_aggregator_analyzers_library",
    srcs = [
        "src/discard_analyzer.cpp",
        "src/generic_analyzer.cpp",
        "src/ignore_analyzer.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    includes = [
        "include",
        "include/diagnostic_aggregator",
    ],
    local_defines = ros_local_defines() + [
        "DIAGNOSTIC_AGGREGATOR_BUILDING_DLL",
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":diagnostic_aggregator_library"],
)

cc_shared_library(
    name = "diagnostic_aggregator_analyzers",
    dynamic_deps = DEPENDENCIES.keys() + [":diagnostic_aggregator"],
    deps = [":diagnostic_aggregator_analyzers_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":diagnostic_aggregator"],
)

cc_binary(
    name = "add_analyzer",
    srcs = ["src/add_analyzer.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/diagnostic_aggregator",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "aggregator_node",
    srcs = ["src/aggregator_node.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/diagnostic_aggregator",
    ],
    local_defines = ros_local_defines() + [
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":diagnostic_aggregator_library"],
)

py_library(
    name = "diagnostic_aggregator_py",
    srcs = glob(["diagnostic_aggregator/**/*.py"]),
    imports = ["."],
    deps = [
        "@diagnostic_msgs//:py",
        "@launch_pytest",
        "@launch_testing_ros",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

write_file(
    name = "gen_extra_1",
    out = "_gen/share/diagnostic_aggregator/example.launch.py",
    content = ["\"\"\"Launch analyzer loader with parameters from yaml.\"\"\"\n\nimport launch\nimport launch_ros.actions\n\nanalyzer_params_filepath = \"/usr/local/google/home/simmers/development/ros-central-registry/release/lyrical/2026-10-05/install/diagnostic_aggregator/share/diagnostic_aggregator/example_analyzers.yaml\"\nadd_analyzer_params_filepath = \"/usr/local/google/home/simmers/development/ros-central-registry/release/lyrical/2026-10-05/install/diagnostic_aggregator/share/diagnostic_aggregator/example_add_analyzers.yaml\"\n\n\ndef generate_launch_description():\n    aggregator = launch_ros.actions.Node(\n        package='diagnostic_aggregator',\n        executable='aggregator_node',\n        output='screen',\n        parameters=[analyzer_params_filepath])\n    add_analyzer = launch_ros.actions.Node(\n        package='diagnostic_aggregator',\n        executable='add_analyzer',\n        output='screen',\n        parameters=[add_analyzer_params_filepath]\n    )\n    diag_publisher = launch_ros.actions.Node(\n        package='diagnostic_aggregator',\n        executable='example_pub.py')\n    return launch.LaunchDescription([\n        aggregator,\n        add_analyzer,\n        diag_publisher,\n        launch.actions.RegisterEventHandler(\n            event_handler=launch.event_handlers.OnProcessExit(\n                target_action=aggregator,\n                on_exit=[launch.actions.EmitEvent(\n                    event=launch.events.Shutdown())],\n            )),\n    ])\n"],
)

pkg_files(
    name = "pkg_files_extra_0",
    srcs = ["example/example_pub.py"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "lib/diagnostic_aggregator",
)

pkg_files(
    name = "pkg_files_extra_1",
    srcs = [":gen_extra_1"],
    prefix = "share/diagnostic_aggregator",
)

pkg_files(
    name = "pkg_files_share_2",
    srcs = ["example/example_add_analyzers.yaml"],
    prefix = "share/diagnostic_aggregator",
)

pkg_files(
    name = "pkg_files_share_3",
    srcs = ["example/example_analyzers.yaml"],
    prefix = "share/diagnostic_aggregator",
)

ament_index(
    name = "ament_index",
    lib_data = [
        ":add_analyzer",
        ":aggregator_node",
    ],
    libraries = [
        ":diagnostic_aggregator",
        ":diagnostic_aggregator_analyzers",
    ],
    package_xml = "package.xml",
    plugins = ["plugin_description.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@launch_pytest//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@pluginlib//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

py_pytest(
    name = "test_test_critical_pub.py",
    srcs = ["test/test_critical_pub.py"],
    args = [
        "-p",
        "launch_testing.pytest.hooks",
    ],
    data = [
        ":add_analyzer",
        ":aggregator_node",
        ":ament_index",
    ],
    deps = [
        ":diagnostic_aggregator_py",
        "@diagnostic_msgs//:py",
        "@launch_pytest",
        "@launch_testing_ros",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

py_pytest(
    name = "test_discard_behavior",
    srcs = ["test/test_discard_behavior.py"],
    args = [
        "-p",
        "launch_pytest.plugin",
    ],
    data = [
        ":add_analyzer",
        ":aggregator_node",
        ":ament_index",
    ],
    deps = [
        ":diagnostic_aggregator_py",
        "@diagnostic_msgs//:py",
        "@launch_pytest",
        "@launch_testing_ros",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

py_pytest(
    name = "test_publish_values",
    srcs = ["test/test_publish_values.py"],
    args = [
        "-p",
        "launch_pytest.plugin",
    ],
    data = [
        ":add_analyzer",
        ":aggregator_node",
        ":ament_index",
    ],
    deps = [
        ":diagnostic_aggregator_py",
        "@diagnostic_msgs//:py",
        "@launch_pytest",
        "@launch_testing_ros",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "ament_cmake",
        "ament_cmake_python",
        "diagnostic_msgs",
        "pluginlib",
        "rclcpp",
        "rclpy",
        "std_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    cmake_export_name = "diagnostic_aggregatorTargets",
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    install = [
        ":pkg_files_extra_0",
        ":pkg_files_extra_1",
        ":pkg_files_share_2",
        ":pkg_files_share_3",
    ],
    libraries = [
        ":diagnostic_aggregator",
        ":diagnostic_aggregator_analyzers",
    ],
    package_xml = "package.xml",
    python = [":diagnostic_aggregator_py"],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@launch_pytest//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@pluginlib//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
