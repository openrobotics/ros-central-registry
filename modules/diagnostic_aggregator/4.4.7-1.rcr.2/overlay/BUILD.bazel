load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@diagnostic_msgs//:cc_shared": "@diagnostic_msgs//:cc",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rcl_interfaces//:cc_shared": "@rcl_interfaces//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "diagnostic_aggregator_library",
    srcs = [
        "src/aggregator.cpp",
        "src/analyzer_group.cpp",
        "src/status_item.cpp",
    ],
    hdrs = [
        "include/diagnostic_aggregator/aggregator.hpp",
        "include/diagnostic_aggregator/analyzer.hpp",
        "include/diagnostic_aggregator/analyzer_group.hpp",
        "include/diagnostic_aggregator/discard_analyzer.hpp",
        "include/diagnostic_aggregator/generic_analyzer.hpp",
        "include/diagnostic_aggregator/generic_analyzer_base.hpp",
        "include/diagnostic_aggregator/ignore_analyzer.hpp",
        "include/diagnostic_aggregator/other_analyzer.hpp",
        "include/diagnostic_aggregator/status_item.hpp",
        "include/diagnostic_aggregator/visibility_control.hpp",
    ],
    includes = [
        "include",
        "include/diagnostic_aggregator",
    ],
    local_defines = ros_local_defines() + [
        "DIAGNOSTIC_AGGREGATOR_BUILDING_DLL",
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "diagnostic_aggregator",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":diagnostic_aggregator_library"],
)

cc_library(
    name = "diagnostic_aggregator_analyzers_library",
    srcs = [
        "src/discard_analyzer.cpp",
        "src/generic_analyzer.cpp",
        "src/ignore_analyzer.cpp",
    ],
    hdrs = [
        "include/diagnostic_aggregator/aggregator.hpp",
        "include/diagnostic_aggregator/analyzer.hpp",
        "include/diagnostic_aggregator/analyzer_group.hpp",
        "include/diagnostic_aggregator/discard_analyzer.hpp",
        "include/diagnostic_aggregator/generic_analyzer.hpp",
        "include/diagnostic_aggregator/generic_analyzer_base.hpp",
        "include/diagnostic_aggregator/ignore_analyzer.hpp",
        "include/diagnostic_aggregator/other_analyzer.hpp",
        "include/diagnostic_aggregator/status_item.hpp",
        "include/diagnostic_aggregator/visibility_control.hpp",
    ],
    includes = [
        "include",
        "include/diagnostic_aggregator",
    ],
    local_defines = ros_local_defines() + [
        "DIAGNOSTIC_AGGREGATOR_BUILDING_DLL",
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":diagnostic_aggregator_library"],
)

cc_shared_library(
    name = "diagnostic_aggregator_analyzers",
    dynamic_deps = DEPENDENCIES.keys() + [":diagnostic_aggregator"],
    exports_filter = ["//:__subpackages__"],
    deps = [":diagnostic_aggregator_analyzers_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":diagnostic_aggregator_analyzers"] + [":diagnostic_aggregator"],
)

cc_binary(
    name = "add_analyzer",
    srcs = ["src/add_analyzer.cpp"] + [
        "include/diagnostic_aggregator/aggregator.hpp",
        "include/diagnostic_aggregator/analyzer.hpp",
        "include/diagnostic_aggregator/analyzer_group.hpp",
        "include/diagnostic_aggregator/discard_analyzer.hpp",
        "include/diagnostic_aggregator/generic_analyzer.hpp",
        "include/diagnostic_aggregator/generic_analyzer_base.hpp",
        "include/diagnostic_aggregator/ignore_analyzer.hpp",
        "include/diagnostic_aggregator/other_analyzer.hpp",
        "include/diagnostic_aggregator/status_item.hpp",
        "include/diagnostic_aggregator/visibility_control.hpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/diagnostic_aggregator",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "aggregator_node",
    srcs = ["src/aggregator_node.cpp"],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/diagnostic_aggregator",
    ],
    local_defines = ros_local_defines() + [
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":diagnostic_aggregator_library"],
)

py_library(
    name = "diagnostic_aggregator_py",
    srcs = ["diagnostic_aggregator/__init__.py"],
    imports = ["."],
    deps = [
        "@diagnostic_msgs//:py",
        "@launch_pytest",
        "@launch_testing_ros",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

expand_template(
    name = "example_launch_py",
    out = "_gen/share/diagnostic_aggregator/example.launch.py",
    substitutions = {
        "@ADD_ANALYZER_PARAMS_FILEPATH@": "share/diagnostic_aggregator/example_add_analyzers.yaml",
        "@ANALYZER_PARAMS_FILEPATH@": "share/diagnostic_aggregator/example_analyzers.yaml",
    },
    template = "example/example.launch.py.in",
)

ament_index(
    name = "ament_index",
    data = [
        "example/example_add_analyzers.yaml",
        "example/example_analyzers.yaml",
        ":example_launch_py",
    ],
    data_strip_prefix = "example",
    lib_data = [
        ":add_analyzer",
        "example/example_pub.py",
    ],
    libraries = [
        ":diagnostic_aggregator",
        ":diagnostic_aggregator_analyzers",
    ],
    package_xml = "package.xml",
    plugins = ["plugin_description.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@launch_pytest//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@pluginlib//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "ament_cmake",
        "ament_cmake_python",
        "diagnostic_msgs",
        "pluginlib",
        "rclcpp",
        "rclpy",
        "std_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    cmake_export_name = "diagnostic_aggregatorTargets",
    executables = [
        ":aggregator_node",
    ],
    headers = [
        "include/diagnostic_aggregator/aggregator.hpp",
        "include/diagnostic_aggregator/analyzer.hpp",
        "include/diagnostic_aggregator/analyzer_group.hpp",
        "include/diagnostic_aggregator/discard_analyzer.hpp",
        "include/diagnostic_aggregator/generic_analyzer.hpp",
        "include/diagnostic_aggregator/generic_analyzer_base.hpp",
        "include/diagnostic_aggregator/ignore_analyzer.hpp",
        "include/diagnostic_aggregator/other_analyzer.hpp",
        "include/diagnostic_aggregator/status_item.hpp",
        "include/diagnostic_aggregator/visibility_control.hpp",
    ],
    include_prefix = "",
    libraries = [
        ":diagnostic_aggregator",
        ":diagnostic_aggregator_analyzers",
    ],
    package_xml = "package.xml",
    python = [":diagnostic_aggregator_py"],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@launch_pytest//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@pluginlib//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
