load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

launch_ros_test(
    name = "test_test_critical_pub",
    src = "test_critical_pub.py",
    data = [
        "//:add_analyzer",
        "//:aggregator_node",
        "//:ament_index",
    ],
    deps = [
        "//:diagnostic_aggregator_py",
        "@diagnostic_msgs//:py",
        "@launch_pytest",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

py_pytest(
    name = "test_discard_behavior",
    srcs = ["test_discard_behavior.py"],
    args = [
        "-p",
        "launch_pytest.plugin",
    ],
    data = ["//:ament_index"],
    deps = [
        "//:diagnostic_aggregator_py",
        "@diagnostic_msgs//:py",
        "@launch_pytest",
        "@launch_testing_ros",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

py_pytest(
    name = "test_publish_values",
    srcs = ["test_publish_values.py"],
    args = [
        "-p",
        "launch_pytest.plugin",
    ],
    data = ["//:ament_index"],
    deps = [
        "//:diagnostic_aggregator_py",
        "@diagnostic_msgs//:py",
        "@launch_pytest",
        "@launch_testing_ros",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)
