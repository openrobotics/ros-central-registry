load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### PYTHON MODULES

ament_index(
    name = "ament_index",
    data = [
        "resource/dock_widget_title_bar.ui",
        "resource/perspective_create.ui",
        "resource/ros_org_vertical.png",
    ],
    package_xml = "package.xml",
)

py_library(
    name = "qt_gui",
    srcs = [
        "src/qt_gui/__init__.py",
        "src/qt_gui/about_handler.py",
        "src/qt_gui/application_context.py",
        "src/qt_gui/application_dbus_interface.py",
        "src/qt_gui/composite_plugin_provider.py",
        "src/qt_gui/container_manager.py",
        "src/qt_gui/dock_widget.py",
        "src/qt_gui/dock_widget_container.py",
        "src/qt_gui/dock_widget_title_bar.py",
        "src/qt_gui/dockable_main_window.py",
        "src/qt_gui/errors.py",
        "src/qt_gui/help_provider.py",
        "src/qt_gui/icon_loader.py",
        "src/qt_gui/main.py",
        "src/qt_gui/main_window.py",
        "src/qt_gui/menu_manager.py",
        "src/qt_gui/minimized_dock_widgets_toolbar.py",
        "src/qt_gui/perspective_manager.py",
        "src/qt_gui/perspective_manager_dbus_interface.py",
        "src/qt_gui/plugin.py",
        "src/qt_gui/plugin_context.py",
        "src/qt_gui/plugin_descriptor.py",
        "src/qt_gui/plugin_handler.py",
        "src/qt_gui/plugin_handler_container.py",
        "src/qt_gui/plugin_handler_dbus_service.py",
        "src/qt_gui/plugin_handler_direct.py",
        "src/qt_gui/plugin_handler_xembed.py",
        "src/qt_gui/plugin_handler_xembed_client.py",
        "src/qt_gui/plugin_handler_xembed_container.py",
        "src/qt_gui/plugin_instance_id.py",
        "src/qt_gui/plugin_manager.py",
        "src/qt_gui/plugin_manager_dbus_interface.py",
        "src/qt_gui/plugin_menu.py",
        "src/qt_gui/plugin_provider.py",
        "src/qt_gui/recursive_plugin_provider.py",
        "src/qt_gui/reload_importer.py",
        "src/qt_gui/reparent_event.py",
        "src/qt_gui/ros_package_helper.py",
        "src/qt_gui/settings.py",
        "src/qt_gui/settings_proxy.py",
        "src/qt_gui/settings_proxy_dbus_service.py",
        "src/qt_gui/window_changed_signaler.py",
    ],
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@ament_index_python",
        "@python_qt_binding",
        requirement("packaging"),
        requirement("catkin-pkg"),
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":qt_gui"],
    python_strip_prefix = "src",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@python_qt_binding//:ament_package",
        "@rosdistro//:ament_package",
        "@tango_icons_vendor//:ament_package",
    ],
)
