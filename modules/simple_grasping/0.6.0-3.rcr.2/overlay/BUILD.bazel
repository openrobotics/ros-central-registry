cc_library(
    name = "simple_grasping_library",
    srcs = [
        "src/cloud_tools.cpp",
        "src/object_support_segmentation.cpp",
        "src/shape_extraction.cpp",
        "src/shape_grasp_planner.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/simple_grasping",
    ],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "simple_grasping",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":simple_grasping_library"],
)

