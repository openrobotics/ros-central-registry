load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@mrpt_expr//:mrpt_expr_library",
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
]

cc_library(
    name = "mrpt_config_library",
    srcs = [
        "src/CConfigFile.cpp",
        "src/CConfigFileBase.cpp",
        "src/CConfigFileMemory.cpp",
        "src/CConfigFilePrefixer.cpp",
        "src/CLoadableOptions.cpp",
        "src/config_parser.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":gen_extra_6"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "3rdparty/simpleini",
        "_gen/include",
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_config",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mrpt_config_library"],
)

cc_library(
    name = "_bindings.cpython-314-x86_64-linux-gnu_library",
    srcs = ["python_bindings/mrpt_config_py.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":gen_extra_6"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "3rdparty/simpleini",
        "_gen/include",
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":mrpt_config_library"],
)

cc_shared_library(
    name = "_bindings.cpython-314-x86_64-linux-gnu",
    dynamic_deps = DEPENDENCIES.keys(),
    shared_lib_name = "mrpt/config/_bindings.so",
    deps = [":_bindings.cpython-314-x86_64-linux-gnu_library"],
)

py_library(
    name = "mrpt",
    srcs = glob(["python/mrpt/**/*.py"]),
    imports = ["python"],
    deps = ["@mrpt_expr//:mrpt"],
)

write_file(
    name = "gen_extra_6",
    out = "_gen/include/mrpt/config/config.h",
    content = ["/* +---------------------------------------------------------------------------+\n   |                     Mobile Robot Programming Toolkit (MRPT)               |\n   |                          https://www.mrpt.org/                            |\n   |                                                                           |\n   | Copyright (c) 2005-2026, Individual contributors, see AUTHORS file        |\n   | See: https://www.mrpt.org/Authors - All rights reserved.                  |\n   | Released under BSD License. See details in https://www.mrpt.org/License   |\n   +---------------------------------------------------------------------------+\n */\n\n#pragma once\n\n// clang-format off\n\n#define MRPT_HAS_SIMPLEINI 1\n#define MRPT_HAS_SIMPLEINI_SYSTEM 0\n\n// clang-format on\n"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_config",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_config": [
            "libmrpt_config.so.3.3",
            "libmrpt_config.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_common//:ament_package",
        "@mrpt_expr//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    egg_info = False,
    headers = [
        ":gen_extra_6",
    ] + glob(["include/**"]),
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mrpt_config",
    ],
    package_xml = "package.xml",
    python = [
        ":mrpt",
        ":_bindings.cpython-314-x86_64-linux-gnu",
    ],
    python_strip_prefix = "python",
    sonames = {
        "mrpt_config": [
            "libmrpt_config.so.3.3",
            "libmrpt_config.so.3.3.1",
        ],
    },
    deps = [":ament_index"] + [
        "@mrpt_common//:ament_package",
        "@mrpt_expr//:ament_package",
    ],
)
