load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "detect.launch.py",
        "detector_only.launch.py",
    ],
)

launch_ros_binary(
    name = "detect_launch",
    src = "detect.launch.py",
    data = [
        "//:ament_index",
        "@apriltag_draw//:ament_index",
    ],
    deps = [
        "@rclcpp_components//:component_container",
    ],
)

launch_ros_binary(
    name = "detector_only_launch",
    src = "detector_only.launch.py",
    deps = [
        "//:apriltag_detector_node",
    ],
)
