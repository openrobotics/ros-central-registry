load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/pal_statistics/pal_statistics.hpp",
        "include/pal_statistics/pal_statistics_macros.hpp",
        "include/pal_statistics/pal_statistics_utils.hpp",
        "include/pal_statistics/registration_utils.hpp",
        "include/pal_statistics/static_circular_buffer.hpp",
        "src/lock_free_queue.hpp",
        "src/registration_list.hpp",
    ],
    includes = ["src"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

cc_library(
    name = "pal_statistics_library",
    srcs = [
        "src/lock_free_queue.hpp",
        "src/pal_statistics.cpp",
        "src/pal_statistics_macros.cpp",
        "src/pal_statistics_utils.cpp",
        "src/registration_list.cpp",
        "src/registration_list.hpp",
    ],
    hdrs = [
        "include/pal_statistics/pal_statistics.hpp",
        "include/pal_statistics/pal_statistics_macros.hpp",
        "include/pal_statistics/pal_statistics_utils.hpp",
        "include/pal_statistics/registration_utils.hpp",
        "include/pal_statistics/static_circular_buffer.hpp",
    ],
    includes = ["include"],
    deps = [
        "@pal_statistics_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
        "@rosdistro//cc:boost.bimap",
        "@rosdistro//cc:boost.lockfree",
    ],
)

cc_shared_library(
    name = "pal_statistics",
    dynamic_deps = [
        "@pal_statistics_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_lifecycle//:rclcpp_lifecycle",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":pal_statistics_library"],
)

py_library(
    name = "pal_statistics_py",
    srcs = [
        "pal_statistics/__init__.py",
        "pal_statistics/statistics_registry.py",
    ],
    data = [":ament_index"],
    imports = ["."],
    deps = [
        "@pal_statistics_msgs//:py",
        "@rclpy",
    ],
)

TEST_DEPENDENCIES = {
    ":pal_statistics": ":pal_statistics_library",
    "@pal_statistics_msgs//:cc_shared": "@pal_statistics_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
)

HEADERS = [
    "include/pal_statistics/pal_statistics.hpp",
    "include/pal_statistics/pal_statistics_macros.hpp",
    "include/pal_statistics/pal_statistics_utils.hpp",
    "include/pal_statistics/registration_utils.hpp",
    "include/pal_statistics/static_circular_buffer.hpp",
]

ament_package(
    name = "ament_package",
    cmake_export_targets = False,
    headers = HEADERS,
    libraries = [":pal_statistics"],
    package_xml = "package.xml",
    python = [":pal_statistics_py"],
    deps = [
        ":ament_index",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@pal_statistics_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
