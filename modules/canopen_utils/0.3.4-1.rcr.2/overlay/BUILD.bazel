load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "canopen_utils",
    srcs = glob(["canopen_utils/**/*.py"]),
    imports = ["."],
    deps = [
        "@canopen_interfaces//:py",
        "@lifecycle_msgs//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "cyclic_tester": "canopen_utils.cyclic_tester:main",
        "simple_tester": "canopen_utils.simple_rpdo_tpdo_tester:main",
    },
    package_xml = "package.xml",
    python = [":canopen_utils"],
    deps = [
        "@ament_lint_auto//:ament_package",
        "@canopen_interfaces//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
