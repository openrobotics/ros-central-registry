load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "depthimage_to_laserscan-launch.py",
        "depthimage_to_laserscan_composed-launch.py",
    ],
)

launch_ros_binary(
    name = "depthimage_to_laserscan_launch",
    src = "depthimage_to_laserscan-launch.py",
    deps = [
        "//:depthimage_to_laserscan_node",
        "@ament_index_python",
    ],
)

launch_ros_binary(
    name = "depthimage_to_laserscan_composed_launch",
    src = "depthimage_to_laserscan_composed-launch.py",
    data = [
        "//:ament_index",
    ],
    deps = [
        "//:node_depthimage_to_laserscan",
        "@ament_index_python",
        "@rclcpp_components//:component_container",
        requirement("pyyaml"),
    ],
)
