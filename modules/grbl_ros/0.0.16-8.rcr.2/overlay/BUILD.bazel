load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

# Tests tagged xfail + manual: known failures under Bazel (see reasons).
_xfail_names = [
    "test_flake8",  # test assertion fails under Bazel: AssertionError: Found ...
    "test_pep257",  # test assertion fails under Bazel: AssertionError: Found ...
]

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["test/test_{0}.py".format(linter)],
    data = [
        ".github/workflows/docs.yml",
        ".github/workflows/greetings.yml",
        ".github/workflows/release.yml",
        ".github/workflows/release-candidate.yml",
        ".github/workflows/ros_ci.yml",
        "CHANGELOG.rst",
        "CONTRIBUTING.md",
        "LICENSE",
        "README.md",
        "config/cnc001.yaml",
        "docs/Makefile",
        "docs/command.rst",
        "docs/conf.py",
        "docs/configure.rst",
        "docs/control.rst",
        "docs/device.rst",
        "docs/index.rst",
        "docs/init.rst",
        "docs/logging.rst",
        "grbl_ros/__init__.py",
        "grbl_ros/_command.py",
        "grbl_ros/_configure.py",
        "grbl_ros/_control.py",
        "grbl_ros/_logging.py",
        "grbl_ros/device.py",
        "grbl_ros/manager.py",
        "grbl_ros/service.py",
        "package.xml",
        "requirements.txt",
        "resource/grbl_ros",
        "setup.cfg",
        "setup.py",
        "test/test_copyright.py",
        "test/test_flake8.py",
        "test/test_pep257.py",
    ],
    tags = [
        "manual",
        "xfail",
    ] if "test_{0}".format(linter) in _xfail_names else [],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
]]

py_library(
    name = "grbl_ros",
    srcs = [
        "grbl_ros/__init__.py",
        "grbl_ros/_command.py",
        "grbl_ros/_configure.py",
        "grbl_ros/_control.py",
        "grbl_ros/_logging.py",
        "grbl_ros/device.py",
        "grbl_ros/manager.py",
        "grbl_ros/service.py",
    ],
    imports = ["."],
    deps = [
        "@grbl_msgs//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "config/cnc001.yaml",
        "//launch:launch_files",
    ],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    console_scripts = {
        "grbl_manager": "grbl_ros.manager:main",
        "grbl_node": "grbl_ros.device:main",
        "grbl_service": "grbl_ros.service:main",
    },
    package_xml = "package.xml",
    python = [":grbl_ros"],
    deps = [":ament_index"] + [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@grbl_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
