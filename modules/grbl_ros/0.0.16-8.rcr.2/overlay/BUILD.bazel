load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
    ]
]

py_library(
    name = "grbl_ros",
    srcs = glob(["grbl_ros/**/*.py"]),
    imports = ["."],
    deps = [
        "@grbl_msgs//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "config/cnc001.yaml",
        "launch/grbl_ros.launch.py",
    ],
    package_xml = "package.xml",
)

launch_ros_binary(
    name = "grbl_ros.launch.py",
    src = "launch/grbl_ros.launch.py",
    data = [":ament_index"],
    deps = [":grbl_ros"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "grbl_manager": "grbl_ros.manager:main",
        "grbl_node": "grbl_ros.device:main",
        "grbl_service": "grbl_ros.service:main",
    },
    data = [
        "config/cnc001.yaml",
        "launch/grbl_ros.launch.py",
    ],
    package_xml = "package.xml",
    python = [":grbl_ros"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@grbl_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
