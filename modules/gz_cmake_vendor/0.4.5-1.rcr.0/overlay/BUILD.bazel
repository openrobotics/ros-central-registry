# gz_cmake_vendor: gz-cmake (CMake helper modules for the Gazebo libraries) has no Bazel Central
# Registry module and is only meaningful for CMake consumers, so this package is
# metadata only (package.xml + environment hooks): nothing is installed under
# opt/gz_cmake_vendor/.

load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc/gz:defs.bzl", "gz_vendor_hooks")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### INSTALL LAYOUT

ENV_HOOKS = gz_vendor_hooks(
    name = "install_hooks",
    gz_config_path = False,
    pythonpath = False,
    vendor = "gz_cmake_vendor",
)

### PACKAGING

ament_package(
    name = "ament_package",
    env_hooks = ENV_HOOKS,
    install = [":install_hooks"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_test//:ament_package",
        "@ament_cmake_vendor_package//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
