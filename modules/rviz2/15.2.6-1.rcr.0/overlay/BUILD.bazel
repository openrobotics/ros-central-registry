load("@pip_ros//:requirements.bzl", "requirement")
load("@qt//:qt.bzl", "qt_cc_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

exports_files(["scripts/rviz1_to_rviz2.py"])

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:OgreMain": "@rosdistro//cc:OgreMain_library",
    "@rosdistro//cc:OgreOverlay": "@rosdistro//cc:OgreOverlay_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:curl": "@rosdistro//cc:curl_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rviz_common//:rviz_common": "@rviz_common//:rviz_common_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

qt_cc_binary(
    name = "rviz2",
    srcs = ["src/main.cpp"],
    data = [
        "@rviz_common//:ament_index",
        "@rviz_default_plugins//:ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    linkopts = select({
        "@platforms//os:linux": ["-Wl,--allow-shlib-undefined"],
        "//conditions:default": [],
    }),
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@qtbase//:widgets",
        "@qtsvg//:svg",
    ],
)

py_binary(
    name = "rviz1_to_rviz2",
    srcs = ["scripts/rviz1_to_rviz2.py"],
    main = "scripts/rviz1_to_rviz2.py",
    deps = [requirement("pyyaml")],
)

ament_index(
    name = "ament_index",
    executables = [
        ":rviz2",
        "scripts/rviz1_to_rviz2.py",
    ],
    package_xml = "package.xml",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_rclcpp",
    dynamic_deps = ["@rclcpp//:rclcpp"],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    package_xml = "package.xml",
    programs = [":rviz2"],
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_default_plugins//:ament_package",
        "@rviz_ogre_vendor//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
