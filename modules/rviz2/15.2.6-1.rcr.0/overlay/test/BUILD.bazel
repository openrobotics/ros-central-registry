load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

cc_binary(
    name = "send_lots_of_points_node",
    testonly = True,
    srcs = ["tools/send_lots_of_points_node.cpp"],
    dynamic_deps = [
        "//:transitive_dynamic_deps_rclcpp",
        "@qtbase//:widgets_shared",
    ],
    local_defines = ros_local_defines(),
    deps = [
        "@geometry_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@sensor_msgs//:cc",
    ],
)

py_pytest(
    name = "rviz1_to_2_check",
    srcs = ["tools/rviz1_to_2_check.py"],
    data = ["//:scripts/rviz1_to_rviz2.py"] + [
        "tools/configs/all_ros1.rviz",
        "tools/configs/all_supported_configs.rviz",
        "tools/configs/fuse_simple_tutorial.rviz",
        "tools/configs/range_sensor_tutorial.rviz",
    ],
    env = {
        "_CONFIG_PATH": "../rviz2+/test/tools/configs",
        "_SCRIPT_PATH": "$(rootpath //:scripts/rviz1_to_rviz2.py)",
    },
    deps = [requirement("pyyaml")],
)
