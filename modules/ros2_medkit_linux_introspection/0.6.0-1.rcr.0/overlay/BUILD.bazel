CC_DEPS = [
    "@rosdistro//cc:nlohmann_json",
    "@rosdistro//cc:tl_expected",
]

cc_library(
    name = "medkit_linux_utils_library",
    srcs = [":gen_ros2_medkit_linux_introspection_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        ".",
        "include",
        "include/ros2_medkit_linux_introspection",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

