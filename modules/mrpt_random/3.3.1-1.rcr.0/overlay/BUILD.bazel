load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
]

cc_library(
    name = "mrpt_random_library",
    srcs = ["src/RandomGenerator.cpp"],
    hdrs = [
        "include/mrpt/random.h",
        "include/mrpt/random/RandomGenerators.h",
        "include/mrpt/random/portable_uniform_distribution.h",
        "include/mrpt/random/random_shuffle.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_random",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mrpt_random_library"],
)

cc_library(
    name = "_bindings_library",
    srcs = ["python_bindings/mrpt_random_py.cpp"],
    hdrs = [
        "include/mrpt/random.h",
        "include/mrpt/random/RandomGenerators.h",
        "include/mrpt/random/portable_uniform_distribution.h",
        "include/mrpt/random/random_shuffle.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":mrpt_random_library"],
)

cc_shared_library(
    name = "_bindings",
    dynamic_deps = DEPENDENCIES.keys() + [":mrpt_random"],
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "mrpt/random/_bindings.so",
    deps = [":_bindings_library"],
)

py_library(
    name = "mrpt",
    srcs = ["python/mrpt/random/__init__.py"],
    imports = ["python"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_random",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_random": [
            "libmrpt_random.so.3.3",
            "libmrpt_random.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_common//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    egg_info = False,
    headers = [
        "include/mrpt/random.h",
        "include/mrpt/random/RandomGenerators.h",
        "include/mrpt/random/portable_uniform_distribution.h",
        "include/mrpt/random/random_shuffle.h",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mrpt_random",
    ],
    package_xml = "package.xml",
    python = [
        ":mrpt",
        ":_bindings",
    ],
    python_strip_prefix = "python",
    sonames = {
        "mrpt_random": [
            "libmrpt_random.so.3.3",
            "libmrpt_random.so.3.3.1",
        ],
    },
    deps = [":ament_index"] + [
        "@mrpt_common//:ament_package",
    ],
)
