load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@mbf_abstract_nav//:mbf_abstract_server": "@mbf_abstract_nav//:mbf_abstract_server_library",
    "@mbf_test_utility//:mbf_test_utility_sim": "@mbf_test_utility//:mbf_test_utility_sim_library",
    "@mbf_utility//:mbf_utility": "@mbf_utility//:mbf_utility_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_ros//:static_transform_broadcaster_node": "@tf2_ros//:static_transform_broadcaster_node_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@mbf_abstract_core//:mbf_abstract_core",
    "@mbf_msgs//:cc",
    "@mbf_simple_core//:mbf_simple_core_library",
    "@nav_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@std_msgs//:cc",
    "@std_srvs//:cc",
]

exports_files([
    "plugins/mbf_simple_nav_test_plugins.xml",
    "plugins/test_controller.cpp",
    "plugins/test_plan_refiner.cpp",
    "plugins/test_planner.cpp",
    "plugins/test_recovery.cpp",
    "simple_nav_integration_test.cpp",
])

cc_library(
    name = "mbf_simple_nav_test_plugins_library",
    srcs = [
        "plugins/test_controller.cpp",
        "plugins/test_plan_refiner.cpp",
        "plugins/test_planner.cpp",
        "plugins/test_recovery.cpp",
    ],
    hdrs = [],
    includes = ["."],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + ["//:_test_root_headers"],
)

cc_shared_library(
    name = "mbf_simple_nav_test_plugins",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mbf_simple_nav_test_plugins_library"],
)

cc_test(
    name = "mbf_simple_nav_integration_test",
    srcs = ["simple_nav_integration_test.cpp"],
    data = ["//:ament_index"] + ["plugins/mbf_simple_nav_test_plugins.xml"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:mbf_simple_nav_lib_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
