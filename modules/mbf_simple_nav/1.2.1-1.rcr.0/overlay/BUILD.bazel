load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = ["include/mbf_simple_nav/simple_navigation_server.h"],
    includes = [
        ".",
        "include",
        "include/mbf_simple_nav",
    ],
)

DEPENDENCIES = {
    "@mbf_abstract_nav//:mbf_abstract_server": "@mbf_abstract_nav//:mbf_abstract_server_library",
    "@mbf_test_utility//:mbf_test_utility_sim": "@mbf_test_utility//:mbf_test_utility_sim_library",
    "@mbf_utility//:mbf_utility": "@mbf_utility//:mbf_utility_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_ros//:static_transform_broadcaster_node": "@tf2_ros//:static_transform_broadcaster_node_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@mbf_abstract_core//:mbf_abstract_core",
    "@mbf_msgs//:cc",
    "@mbf_simple_core//:mbf_simple_core_library",
    "@nav_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@std_msgs//:cc",
    "@std_srvs//:cc",
]

cc_library(
    name = "mbf_simple_nav_lib_library",
    srcs = ["src/simple_navigation_server.cpp"],
    hdrs = ["include/mbf_simple_nav/simple_navigation_server.h"],
    includes = [
        ".",
        "include",
        "include/mbf_simple_nav",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mbf_simple_nav_lib",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mbf_simple_nav_lib_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":mbf_simple_nav_lib"],
)

cc_binary(
    name = "mbf_simple_nav_node",
    srcs = ["src/simple_server_node.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/mbf_simple_nav",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":mbf_simple_nav_lib_library"],
)

ament_index(
    name = "ament_index",
    lib_data = [":mbf_simple_nav_node"],
    libraries = [
        ":mbf_simple_nav_lib",
        "//test:mbf_simple_nav_test_plugins",
    ],
    package_xml = "package.xml",
    plugin_category = "mbf_simple_core",
    plugins = ["//test:plugins/mbf_simple_nav_test_plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mbf_abstract_core//:ament_package",
        "@mbf_abstract_nav//:ament_package",
        "@mbf_msgs//:ament_package",
        "@mbf_simple_core//:ament_package",
        "@mbf_test_utility//:ament_package",
        "@mbf_utility//:ament_package",
        "@nav_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "geometry_msgs",
        "mbf_abstract_core",
        "mbf_abstract_nav",
        "mbf_msgs",
        "mbf_simple_core",
        "mbf_utility",
        "nav_msgs",
        "pluginlib",
        "rclcpp",
        "rclcpp_action",
        "std_msgs",
        "std_srvs",
        "tf2",
        "tf2_ros",
    ],
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    cmake_export_name = "export_mbf_simple_nav",
    headers = ["include/mbf_simple_nav/simple_navigation_server.h"],
    include_prefix = "",
    libraries = [
        ":mbf_simple_nav_lib",
        "//test:mbf_simple_nav_test_plugins",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mbf_abstract_core//:ament_package",
        "@mbf_abstract_nav//:ament_package",
        "@mbf_msgs//:ament_package",
        "@mbf_simple_core//:ament_package",
        "@mbf_test_utility//:ament_package",
        "@mbf_utility//:ament_package",
        "@nav_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
