load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

py_library(
    name = "crazyflie_server_py",
    srcs = [
        "crazyflie_server_py/__init__.py",
        "crazyflie_server_py/crazyflie_server.py",
    ],
    imports = ["."],
    deps = [
        "@crazyflie_interfaces//:py",
        "@geometry_msgs//:py",
        "@motion_capture_tracking_interfaces//:py",
        "@nav_msgs//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        "@std_srvs//:py",
    ],
)

ament_package(
    name = "ament_package",
    build_type = "ament_python",
    console_scripts = {
        "crazyflie_server": "crazyflie_server_py.crazyflie_server:main",
    },
    package_xml = "package.xml",
    python = [":crazyflie_server_py"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@crazyflie_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@motion_capture_tracking_interfaces//:ament_package",
        "@nav_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
