load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### LIBRARIES

ament_index(
    name = "ament_index",
    data = ["resource/simple_settings_dialog.ui"],
    package_xml = "package.xml",
)

py_library(
    name = "qt_gui_py_common",
    srcs = [
        "src/qt_gui_py_common/__init__.py",
        "src/qt_gui_py_common/checkbox_group.py",
        "src/qt_gui_py_common/console_text_edit.py",
        "src/qt_gui_py_common/exclusive_options_group.py",
        "src/qt_gui_py_common/simple_settings_dialog.py",
        "src/qt_gui_py_common/worker_thread.py",
    ],
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@python_qt_binding",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":qt_gui_py_common"],
    python_strip_prefix = "src",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@python_qt_binding//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
