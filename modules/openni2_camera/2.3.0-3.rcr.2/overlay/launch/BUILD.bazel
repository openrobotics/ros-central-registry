load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "camera_only.launch.py",
        "camera_with_cloud.launch.py",
        "camera_with_cloud_norgb.launch.py",
        "tfs.launch.py",
    ],
)

launch_ros_binary(
    name = "camera_only_launch",
    src = "camera_only.launch.py",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":tfs_launch",
        "//:openni2_camera_driver",
        "@rclcpp_components//:component_container",
    ],
)

launch_ros_binary(
    name = "camera_with_cloud_launch",
    src = "camera_with_cloud.launch.py",
    data = [
        "@depth_image_proc//:ament_index",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":tfs_launch",
        "//:openni2_camera_driver",
        "@rclcpp_components//:component_container",
    ],
)

launch_ros_binary(
    name = "camera_with_cloud_norgb_launch",
    src = "camera_with_cloud_norgb.launch.py",
    data = [
        "@depth_image_proc//:ament_index",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":tfs_launch",
        "//:openni2_camera_driver",
        "@rclcpp_components//:component_container",
    ],
)

launch_ros_binary(
    name = "tfs_launch",
    src = "tfs.launch.py",
    data = [
        "//:ament_index_extra",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@tf2_ros//:static_transform_publisher",
    ],
)
