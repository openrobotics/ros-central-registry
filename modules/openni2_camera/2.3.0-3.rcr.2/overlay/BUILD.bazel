load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@camera_info_manager//:camera_info_manager": "@camera_info_manager//:camera_info_manager_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
}

CC_DEPS = [
    "@builtin_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
]

cc_library(
    name = "openni2_wrapper_library",
    srcs = [
        "src/openni2_convert.cpp",
        "src/openni2_device.cpp",
        "src/openni2_device_info.cpp",
        "src/openni2_device_manager.cpp",
        "src/openni2_exception.cpp",
        "src/openni2_frame_listener.cpp",
        "src/openni2_timer_filter.cpp",
        "src/openni2_video_mode.cpp",
    ],
    hdrs = [
        "include/openni2_camera/openni2_convert.h",
        "include/openni2_camera/openni2_device.h",
        "include/openni2_camera/openni2_device_info.h",
        "include/openni2_camera/openni2_device_manager.h",
        "include/openni2_camera/openni2_driver.h",
        "include/openni2_camera/openni2_exception.h",
        "include/openni2_camera/openni2_frame_listener.h",
        "include/openni2_camera/openni2_timer_filter.h",
        "include/openni2_camera/openni2_video_mode.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "_gen/include/openni2_camera",
        "_gen/include/openni2_camera/openni2_camera",
        "include",
        "include/openni2_camera",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":cc"],
)

cc_shared_library(
    name = "openni2_wrapper",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":openni2_wrapper_library"],
)

cc_library(
    name = "openni2_camera_lib_library",
    srcs = ["src/openni2_driver.cpp"],
    hdrs = [
        "include/openni2_camera/openni2_convert.h",
        "include/openni2_camera/openni2_device.h",
        "include/openni2_camera/openni2_device_info.h",
        "include/openni2_camera/openni2_device_manager.h",
        "include/openni2_camera/openni2_driver.h",
        "include/openni2_camera/openni2_exception.h",
        "include/openni2_camera/openni2_frame_listener.h",
        "include/openni2_camera/openni2_timer_filter.h",
        "include/openni2_camera/openni2_video_mode.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "_gen/include/openni2_camera",
        "_gen/include/openni2_camera/openni2_camera",
        "include",
        "include/openni2_camera",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":cc",
        ":openni2_wrapper_library",
    ],
)

cc_shared_library(
    name = "openni2_camera_lib",
    dynamic_deps = DEPENDENCIES.keys() + [":openni2_wrapper"],
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":openni2_camera_lib_library"],
)

rclcpp_components_register_node(
    name = "openni2_camera_driver",
    component = ":openni2_camera_lib",
    node_name = "openni2_camera_driver",
    plugin = "openni2_wrapper::OpenNI2Driver",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":openni2_wrapper"],
)

cc_binary(
    name = "list_devices",
    srcs = ["src/list_devices.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "_gen/include/openni2_camera",
        "_gen/include/openni2_camera/openni2_camera",
        "include",
        "include/openni2_camera",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":cc",
        ":openni2_wrapper_library",
    ],
)

cc_binary(
    name = "usb_reset",
    srcs = ["src/usb_reset.c"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "_gen/include/openni2_camera",
        "_gen/include/openni2_camera/openni2_camera",
        "include",
        "include/openni2_camera",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":cc"],
)

default_generators(
    package_xml = "package.xml",
    deps = ["//srv:GetSerial"],
)

ament_index(
    name = "ament_index_extra",
    components = [":openni2_camera_driver_record"],
    data = ["//launch:launch_files"],
    export_name = "openni2_camera",
    lib_data = [
        ":list_devices",
        ":openni2_camera_driver",
        ":usb_reset",
    ],
    libraries = [
        ":openni2_wrapper",
        ":openni2_camera_lib",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@camera_info_manager//:ament_package",
        "@depth_image_proc//:ament_package",
        "@image_transport//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)

rosidl_ament_package(
    cmake_export_dependencies_list = [
        "builtin_interfaces",
        "camera_info_manager",
        "fastcdr",
        "image_transport",
        "rclcpp",
        "rcutils",
        "rmw",
        "rosidl_runtime_c",
        "rosidl_runtime_cpp",
        "rosidl_typesupport_c",
        "rosidl_typesupport_cpp",
        "rosidl_typesupport_fastrtps_c",
        "rosidl_typesupport_fastrtps_cpp",
        "rosidl_typesupport_interface",
        "sensor_msgs",
        "service_msgs",
    ],
    headers = [
        "include/openni2_camera/openni2_convert.h",
        "include/openni2_camera/openni2_device.h",
        "include/openni2_camera/openni2_device_info.h",
        "include/openni2_camera/openni2_device_manager.h",
        "include/openni2_camera/openni2_driver.h",
        "include/openni2_camera/openni2_exception.h",
        "include/openni2_camera/openni2_frame_listener.h",
        "include/openni2_camera/openni2_timer_filter.h",
        "include/openni2_camera/openni2_video_mode.h",
    ],
    include_prefix = "",
    libraries = [
        ":openni2_wrapper",
        ":openni2_camera_lib",
    ],
    package_xml = "package.xml",
    deps = [":ament_index_extra"] + [
        "@ament_cmake//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@camera_info_manager//:ament_package",
        "@depth_image_proc//:ament_package",
        "@image_transport//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
