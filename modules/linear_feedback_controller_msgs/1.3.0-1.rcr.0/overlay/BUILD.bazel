package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-2-Clause",
    ],
)

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:Contact",
        "//msg:Control",
        "//msg:Sensor",
    ],
)

cc_library(
    name = "linear_feedback_controller_msgs_conversion",
    hdrs = ["include/linear_feedback_controller_msgs/eigen_conversions.hpp"],
    includes = ["include"],
    deps = [
        ":cc",
        "@rosdistro//cc:eigen",
        "@tf2_eigen//:tf2_eigen_library",
    ],
)

py_library(
    name = "linear_feedback_controller_msgs_py",
    srcs = glob(["linear_feedback_controller_msgs_py/**/*.py"]),
    imports = ["."],
    deps = [":py"],
)

cc_test(
    name = "test_eigen_conversions",
    srcs = [
        "tests/gtest_main.cpp",
        "tests/test_eigen_conversions.cpp",
    ],
    deps = [
        ":linear_feedback_controller_msgs_conversion",
        "@rosdistro//cc:googletest",
    ],
)

py_pytest(
    name = "test_numpy_conversions",
    srcs = ["tests/test_numpy_conversions.py"],
    deps = [
        ":linear_feedback_controller_msgs_py",
        ":py",
    ],
)

write_file(
    name = "meta_include_linear_feedback_controller_msgs_config_hh",
    out = "_meta/include/linear/feedback/controller/msgs/config.hh",
    content = [
        "/*",
        " * This file has been automatically generated by the jrl-cmakemodules.",
        " * Please see https://github.com/jrl-umi3218/jrl-cmakemodules/blob/master/config.hh.cmake for details.",
        "*/",
        "",
        "#ifndef LINEAR_FEEDBACK_CONTROLLER_MSGS_CONFIG_HH",
        "# define LINEAR_FEEDBACK_CONTROLLER_MSGS_CONFIG_HH",
        "",
        "// Package version (header).",
        "# define LINEAR_FEEDBACK_CONTROLLER_MSGS_VERSION_UNKNOWN_TAG 0 // Used to mention that the current version is unknown.",
        "# define LINEAR_FEEDBACK_CONTROLLER_MSGS_VERSION \"1.3.0\"",
        "# define LINEAR_FEEDBACK_CONTROLLER_MSGS_MAJOR_VERSION 1",
        "# define LINEAR_FEEDBACK_CONTROLLER_MSGS_MINOR_VERSION 3",
        "# define LINEAR_FEEDBACK_CONTROLLER_MSGS_PATCH_VERSION 0",
        "",
        "#define LINEAR_FEEDBACK_CONTROLLER_MSGS_VERSION_AT_LEAST(major, minor, patch) (LINEAR_FEEDBACK_CONTROLLER_MSGS_MAJOR_VERSION>major || (LINEAR_FEEDBACK_CONTROLLER_MSGS_MAJOR_VERSION>=major && \\",
        "                                                             (LINEAR_FEEDBACK_CONTROLLER_MSGS_MINOR_VERSION>minor || (LINEAR_FEEDBACK_CONTROLLER_MSGS_MINOR_VERSION>=minor && \\",
        "                                                                                                     LINEAR_FEEDBACK_CONTROLLER_MSGS_PATCH_VERSION>=patch))))",
        "",
        "#define LINEAR_FEEDBACK_CONTROLLER_MSGS_VERSION_AT_MOST(major, minor, patch) (LINEAR_FEEDBACK_CONTROLLER_MSGS_MAJOR_VERSION<major || (LINEAR_FEEDBACK_CONTROLLER_MSGS_MAJOR_VERSION<=major && \\",
        "                                                            (LINEAR_FEEDBACK_CONTROLLER_MSGS_MINOR_VERSION<minor || (LINEAR_FEEDBACK_CONTROLLER_MSGS_MINOR_VERSION<=minor && \\",
        "                                                                                                     LINEAR_FEEDBACK_CONTROLLER_MSGS_PATCH_VERSION<=patch))))",
        "",
        "// Handle portable symbol export.",
        "// Defining manually which symbol should be exported is required",
        "// under Windows whether MinGW or MSVC is used.",
        "//",
        "// The headers then have to be able to work in two different modes:",
        "// - dllexport when one is building the library,",
        "// - dllimport for clients using the library.",
        "//",
        "// On Linux, set the visibility accordingly. If C++ symbol visibility",
        "// is handled by the compiler, see: http://gcc.gnu.org/wiki/Visibility",
        "//",
        "// Explicit template instantiation on Windows need to add",
        "// dllexport on the definition and dllimport on the declaration.",
        "// The XXX_EXPLICIT_INSTANTIATION_DECLARATION_DLLAPI macro",
        "// should be set on the declaration while",
        "// the XXX_EXPLICIT_INSTANTIATION_DEFINITION_DLLAPI macro",
        "// should be set on the definition.",
        "# if defined _WIN32 || defined __CYGWIN__",
        "// On Microsoft Windows, use dllimport and dllexport to tag symbols.",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_DLLIMPORT __declspec(dllimport)",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_DLLEXPORT __declspec(dllexport)",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_DLLLOCAL",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT __declspec(dllimport)",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT __declspec(dllimport)",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT __declspec(dllexport)",
        "# else",
        "// On Linux, for GCC >= 4, tag symbols using GCC extension.",
        "#  if __GNUC__ >= 4",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_DLLIMPORT __attribute__ ((visibility(\"default\")))",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_DLLEXPORT __attribute__ ((visibility(\"default\")))",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_DLLLOCAL  __attribute__ ((visibility(\"hidden\")))",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT __attribute__ ((visibility(\"default\")))",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT __attribute__ ((visibility(\"default\")))",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT",
        "#  else",
        "// Otherwise (GCC < 4 or another compiler is used), export everything.",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_DLLIMPORT",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_DLLEXPORT",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_DLLLOCAL",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT",
        "#  endif // __GNUC__ >= 4",
        "# endif // defined _WIN32 || defined __CYGWIN__",
        "",
        "# ifdef LINEAR_FEEDBACK_CONTROLLER_MSGS_STATIC",
        "// If one is using the library statically, get rid of",
        "// extra information and use standard explicit template",
        "// instantiation keyword.",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_DLLAPI",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_LOCAL",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DECLARATION extern template",
        "# else",
        "// Depending on whether one is building or using the",
        "// library define DLLAPI to import or export and",
        "// define the right explicit template instantiation keyword.",
        "#  ifdef linear_feedback_controller_msgs_EXPORTS",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_DLLAPI LINEAR_FEEDBACK_CONTROLLER_MSGS_DLLEXPORT",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DECLARATION_DLLAPI LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DEFINITION_DLLAPI LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT",
        "#  else",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_DLLAPI LINEAR_FEEDBACK_CONTROLLER_MSGS_DLLIMPORT",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DECLARATION_DLLAPI LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DEFINITION_DLLAPI LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT",
        "#  endif // LINEAR_FEEDBACK_CONTROLLER_MSGS_EXPORTS",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_LOCAL LINEAR_FEEDBACK_CONTROLLER_MSGS_DLLLOCAL",
        "# endif // LINEAR_FEEDBACK_CONTROLLER_MSGS_STATIC",
        "#endif //! LINEAR_FEEDBACK_CONTROLLER_MSGS_CONFIG_HH",
    ],
)

write_file(
    name = "meta_include_linear_feedback_controller_msgs_deprecated_hh",
    out = "_meta/include/linear/feedback/controller/msgs/deprecated.hh",
    content = [
        "/*",
        " * This file has been automatically generated by the jrl-cmakemodules.",
        " * Please see https://github.com/jrl-umi3218/jrl-cmakemodules/blob/master/deprecated.hh.cmake for details.",
        "*/",
        "",
        "#ifndef LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED_HH",
        "# define LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED_HH",
        "",
        "// Define a suffix which can be used to tag a type, a function or a a",
        "// variable as deprecated (i.e. it will emit a warning when using it).",
        "//",
        "// Tagging a function as deprecated:",
        "//  void foo () LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED;",
        "//",
        "// Tagging a type as deprecated:",
        "//  class Foo {};",
        "//  typedef Foo Bar LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED;",
        "//",
        "// Tagging a variable as deprecated:",
        "//  int a LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED = 0;",
        "//",
        "// The use of a macro is required as this is /not/ a standardized",
        "// feature of C++ language or preprocessor, even if most of the",
        "// compilers support it.",
        "# if defined(__cplusplus) && (__cplusplus >= 201402L)",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED [[deprecated]]",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED_MESSAGE(message) [[deprecated(#message)]]",
        "# elif defined(__GNUC__) || defined(__clang__)",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED __attribute__ ((deprecated))",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED_MESSAGE(message) __attribute__ (( deprecated(#message) ))",
        "# else",
        "#  if defined(_MSC_VER) && !defined(__INTEL_COMPILER)",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED __declspec (deprecated)",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED_MESSAGE(message) __declspec ( deprecated(#message) )",
        "#  else",
        "// If the compiler is not recognized, drop the feature.",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED /* nothing */",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED_MESSAGE(message)",
        "#  endif // __MSVC__",
        "# endif // __cplusplus",
        "",
        "# if defined(__GNUC__) || defined(__clang__)",
        "#  ifndef LINEAR_FEEDBACK_CONTROLLER_MSGS_PRAGMA",
        "#   define LINEAR_FEEDBACK_CONTROLLER_MSGS_PRAGMA(X) _Pragma(#X)",
        "#  endif",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED_HEADER(MSG) LINEAR_FEEDBACK_CONTROLLER_MSGS_PRAGMA(GCC warning MSG)",
        "# elif defined(_MSC_VER) && !defined(__INTEL_COMPILER)",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_STRINGIZE_(MSG) #MSG",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_STRINGIZE(MSG) LINEAR_FEEDBACK_CONTROLLER_MSGS_STRINGIZE_(MSG)",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED_HEADER(MSG) \\",
        "    __pragma(message(__FILE__ \"(\" LINEAR_FEEDBACK_CONTROLLER_MSGS_STRINGIZE(__LINE__) \") : Warning: \" MSG))",
        "# else",
        "#  define LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED_HEADER(MSG)",
        "# endif",
        "",
        "#endif //! LINEAR_FEEDBACK_CONTROLLER_MSGS_DEPRECATED_HH",
    ],
)

