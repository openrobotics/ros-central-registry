load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-2-Clause"],
)

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:Contact",
        "//msg:Control",
        "//msg:Sensor",
    ],
)

cc_library(
    name = "linear_feedback_controller_msgs_conversion",
    hdrs = ["include/linear_feedback_controller_msgs/eigen_conversions.hpp"],
    includes = ["include"],
    deps = [
        ":cc",
        "@rosdistro//cc:eigen",
        "@tf2_eigen//:tf2_eigen_library",
    ],
)

py_library(
    name = "linear_feedback_controller_msgs_py",
    srcs = [
        "linear_feedback_controller_msgs_py/__init__.py",
        "linear_feedback_controller_msgs_py/lfc_py_types.py",
        "linear_feedback_controller_msgs_py/numpy_conversions.py",
    ],
    imports = ["."],
    deps = [":py"],
)

rosidl_ament_package(
    name = "ament_package",
    cmake_export_has_library_target = True,
    headers = ["include/linear_feedback_controller_msgs/eigen_conversions.hpp"],
    include_prefix = "",
    interface_library = "linear_feedback_controller_msgs_conversion",
    interface_library_export = "export_linear_feedback_controller_msgs",
    interface_library_link_libraries = [
        "Eigen3::Eigen",
        "tf2_eigen::tf2_eigen",
        "linear_feedback_controller_msgs::linear_feedback_controller_msgs__rosidl_typesupport_cpp",
    ],
    package_xml = "package.xml",
    python = [":linear_feedback_controller_msgs_py"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_flake8//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pep257//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@jrl_cmakemodules//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2_eigen//:ament_package",
    ],
)
