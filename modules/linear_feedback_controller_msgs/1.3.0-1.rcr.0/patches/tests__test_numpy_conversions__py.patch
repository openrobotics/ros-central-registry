+    class _Time:
+        def __init__(self, *, seconds: int = 0, nanoseconds: int = 0):
+            self._sec = int(seconds)
+            self._nanosec = int(nanoseconds)
+
+        @classmethod
+        def from_msg(cls, msg: TimeMsg) -> "_Time":
