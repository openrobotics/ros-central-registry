load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

### PACKAGING

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:ComponentStatus",
        "//srv:ChangeParameter",
        "//srv:ChangeParameters",
        "//srv:ConfigureFromFile",
        "//srv:ExecuteMethod",
        "//srv:ReplaceTopic",
