load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

### PACKAGING

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:ComponentStatus",
        "//srv:ChangeParameter",
        "//srv:ChangeParameters",
        "//srv:ConfigureFromFile",
        "//srv:ExecuteMethod",
        "//srv:ReplaceTopic",
    ],
)

rosidl_ament_package(
    name = "ament_package",
    executables = [
        "scripts/create_service",
        "scripts/ui_node_executable",
    ],
    package_xml = "package.xml",
    python = glob(["ros_sugar/**"]),
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch//:ament_package",
        "@launch_testing//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
