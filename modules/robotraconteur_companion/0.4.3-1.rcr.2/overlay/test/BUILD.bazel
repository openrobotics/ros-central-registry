load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

CC_DEPS = [
    "@robotraconteur//:RobotRaconteurCore_library",
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.predef",
    "@rosdistro//cc:boost.program_options",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:eigen",
]

cc_test(
    name = "test_device_connector",
    srcs = ["test_device_connector.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = ["//:ament_index"] + [
        "CMakeLists.txt",
        "experimental.testing.companion.test_task_generator.robdef",
        "sawyer_robot_default_config.yml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines() + ["GTEST_HAS_PTHREAD=1"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:RobotRaconteurCompanion_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

