_RR_ROBDEF_FILES = [
    "robdef/group1/" + s + ".robdef"
    for s in _RR_SERVICE_NAMES_GROUP1
]

_RR_THUNK_SRCS = [
    "_gen/include/RobotRaconteurCompanion/StdRobDef/group1/" + s.replace(".", "__") + "_stubskel.cpp"
    for s in _RR_SERVICE_NAMES_GROUP1
]

_RR_THUNK_HDRS = [
    "_gen/include/RobotRaconteurCompanion/StdRobDef/group1/" + s.replace(".", "__") + ".h"
    for s in _RR_SERVICE_NAMES_GROUP1
] + [
    "_gen/include/RobotRaconteurCompanion/StdRobDef/group1/" + s.replace(".", "__") + "_stubskel.h"
    for s in _RR_SERVICE_NAMES_GROUP1
]

# The group1 robdefs, for test/'s thunk generation (upstream passes
# robdef/group1 as an INCLUDE_DIRS entry for its AUTO_IMPORT).
filegroup(
    name = "robdef_group1",
    srcs = _RR_ROBDEF_FILES,
)

genrule(
    name = "gen_robdef_thunk",
    srcs = _RR_ROBDEF_FILES,
    outs = _RR_THUNK_SRCS + _RR_THUNK_HDRS,
    cmd = (
        "mkdir -p $(RULEDIR)/_gen/include/RobotRaconteurCompanion/StdRobDef/group1 && " +
        "$(location @robotraconteur//:_bin/RobotRaconteurGen) --thunksource --lang=cpp " +
        "--output-dir $(RULEDIR)/_gen/include/RobotRaconteurCompanion/StdRobDef/group1 " +
        "--cpp-extra-include=RobotRaconteurCompanion/StdRobDef/StdRobDef_Macros.h " +
        "$(SRCS)"
    ),
    tools = ["@robotraconteur//:_bin/RobotRaconteurGen"],
)

