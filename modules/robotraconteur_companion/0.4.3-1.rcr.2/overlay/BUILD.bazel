cc_library(
    name = "RobotRaconteurCompanion_library",
    srcs = [
        "src/AttributesUtil.cpp",
        "src/DateTimeUtil.cpp",
        "src/DeviceConnector.cpp",
        "src/EigenConverters.cpp",
        "src/IdentifierUtil.cpp",
        "src/InfoFileLoader.cpp",
        "src/LocalIdentifiersManager.cpp",
        "src/StdRobDefAll.cpp",
        "src/UuidUtil.cpp",
        "src/yaml_loader_enums.cpp",
        "src/yaml_loader_impl.cpp",
    ] + _RR_THUNK_SRCS,
    hdrs = _PUBLIC_HDRS + _RR_THUNK_HDRS,
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "_gen/include/RobotRaconteurCompanion/StdRobDef/group1",
        "include",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "RobotRaconteurCompanion",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":RobotRaconteurCompanion_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

register_ament_files(
    name = "ament_files_group1",
    files = _RR_ROBDEF_FILES,
    prefix = "share/robotraconteur/robdef/standard_robdef/group1",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_group2",
    files = [
        "robdef/group2/com.robotraconteur.a1.robotics.planning.robdef",
        "robdef/group2/com.robotraconteur.a1.robotics.scene.robdef",
    ],
    prefix = "share/robotraconteur/robdef/standard_robdef/group2",
    strip_prefix = "*",
)

ament_index(
    name = "ament_index",
    data = [
        ":ament_files_group1",
        ":ament_files_group2",
    ],
    libraries = [":RobotRaconteurCompanion"],
    package_xml = "package.xml",
    sonames = {"RobotRaconteurCompanion": [
        "libRobotRaconteurCompanion.so.0.4",
        "libRobotRaconteurCompanion.so.0.4.3",
    ]},
    deps = ["@robotraconteur//:ament_package"],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = _PUBLIC_HDRS + _RR_THUNK_HDRS,
    include_prefix = "",
    install_package_xml = False,
    libraries = [":RobotRaconteurCompanion"],
    package_xml = "package.xml",
    deps = [":ament_index"] + ["@robotraconteur//:ament_package"],
)
