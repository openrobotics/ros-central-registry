load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@io_context//:io_context": "@io_context//:io_context_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:asio": "@rosdistro//cc:asio_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@udp_msgs//:cc_shared": "@udp_msgs//:cc",
}

NODE_DEPENDENCIES = {
    "@lifecycle_msgs//:cc_shared": "@lifecycle_msgs//:cc",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
}

HEADERS = [
    "include/udp_driver/udp_driver.hpp",
    "include/udp_driver/udp_receiver_node.hpp",
    "include/udp_driver/udp_sender_node.hpp",
    "include/udp_driver/udp_socket.hpp",
    "include/udp_driver/visibility_control.hpp",
]

# ament_auto_add_library(udp_driver SHARED ...)
cc_library(
    name = "udp_driver_library",
    srcs = [
        "src/udp_driver.cpp",
        "src/udp_socket.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + NODE_DEPENDENCIES.values(),
)

cc_shared_library(
    name = "udp_driver",
    dynamic_deps = DEPENDENCIES.keys() + NODE_DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":udp_driver_library"],
)

# ament_auto_add_library(udp_driver_nodes SHARED ...)
cc_library(
    name = "udp_driver_nodes_library",
    srcs = [
        "src/udp_receiver_node.cpp",
        "src/udp_sender_node.cpp",
    ],
    local_defines = ros_local_defines(),
    deps = [":udp_driver_library"],
    alwayslink = True,
)

cc_shared_library(
    name = "udp_driver_nodes",
    dynamic_deps = DEPENDENCIES.keys() + NODE_DEPENDENCIES.keys() + [":udp_driver"],
    exports_filter = ["//:__subpackages__"],
    deps = [":udp_driver_nodes_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + NODE_DEPENDENCIES.keys() + [":udp_driver"],
)

COMPONENTS = {
    "udp_receiver_node_exe": "drivers::udp_driver::UdpReceiverNode",
    "udp_sender_node_exe": "drivers::udp_driver::UdpSenderNode",
}

[rclcpp_components_register_node(
    name = exe,
    component = ":udp_driver_nodes",
    data = [":ament_index"],
    node_name = exe,
    plugin = plugin,
) for exe, plugin in COMPONENTS.items()]

# ament_auto_add_executable(udp_bridge_node_exe src/udp_bridge_node.cpp)
cc_binary(
    name = "udp_bridge_node_exe",
    srcs = ["src/udp_bridge_node.cpp"],
    data = [":ament_index"],
    dynamic_deps = [
        ":transitive_dynamic_deps",
        ":udp_driver_nodes",
    ],
    local_defines = ros_local_defines(),
    deps = [":udp_driver_nodes_library"],
)

### TESTS

[cc_test(
    name = name,
    srcs = ["test/{0}.cpp".format(name)],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    # xfail: test_udp_driver_nodes publishes its 10 messages on a 10 ms timer
    # without waiting for the (never spun) sender node's subscription to be
    # discovered, so the final packet is lost and the sum never reaches 45.
    tags = [
        "manual",
        "xfail",
    ] if name == "test_udp_driver_nodes" else [],
    deps = [
        ":udp_driver_library",
        ":udp_driver_nodes_library",
        "@rosdistro//cc:googletest",
    ],
) for name in [
    "test_udp_data",
    "test_udp_driver",
    "test_udp_driver_nodes",
    "test_udp_socket",
]]

### PACKAGING

ament_index(
    name = "ament_index",
    components = [":{0}_record".format(exe) for exe in COMPONENTS],
    data = ["params/example_udp_params.yml"],
    libraries = [
        ":udp_driver",
        ":udp_driver_nodes",
    ],
    package_xml = "package.xml",
)

ament_package(
    build_type = "cmake",
    cmake = ["udp_driver-extras.cmake"],
    cmake_export_targets = False,
    cmake_extras = ["udp_driver-extras.cmake"],
    components = [":{0}_record".format(exe) for exe in COMPONENTS],
    executables = [":udp_bridge_node_exe"] + [":" + exe for exe in COMPONENTS],
    headers = HEADERS,
    include_prefix = "",
    libraries = [
        ":udp_driver",
        ":udp_driver_nodes",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@asio_cmake_module//:ament_package",
        "@io_context//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@std_msgs//:ament_package",
        "@udp_msgs//:ament_package",
    ],
)
