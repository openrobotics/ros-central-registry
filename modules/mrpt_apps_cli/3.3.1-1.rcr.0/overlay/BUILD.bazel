    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@mrpt_common//:ament_package",
        "@mrpt_libapps_cli//:ament_package",
    ],
)

genrule(
    name = "tar",
    srcs = [":raw_tar"],
    outs = ["tar.tar.gz"],
    cmd = "tmpdir=$$(mktemp -d) && tar -xzf $(location :raw_tar) -C $$tmpdir && rm -rf $$tmpdir/opt/ros/lyrical/mrpt_apps_cli/share/mrpt_apps_cli/hook/cmake_prefix_path* && tar -czf $@ -C $$tmpdir opt && rm -rf $$tmpdir",
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    install_package_xml = False,
    package_xml = "package.xml",
    programs = [
        ":_bin/carmen2rawlog",
        ":_bin/carmen2simplemap",
        ":_bin/gps2rawlog",
        ":_bin/image2gridmap",
        ":_bin/mrpt-ini2yaml",
        ":_bin/mrpt-yaml2ini",
        ":_bin/observations2map",
        ":_bin/rawlog-edit",
        ":_bin/rawlog-grabber",
        ":_bin/ros-map-yaml2mrpt",
        ":_bin/simul-beacons",
        ":_bin/simul-gridmap",
    ],
    tar_name = "raw_tar",
    deps = [":ament_index"] + [
        "@mrpt_common//:ament_package",
        "@mrpt_libapps_cli//:ament_package",
    ],
)
