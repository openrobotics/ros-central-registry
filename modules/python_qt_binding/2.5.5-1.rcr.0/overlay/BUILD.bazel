load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### PYTHON MODULE

genrule(
    name = "generate_version_py",
    outs = ["src/python_qt_binding/version.py"],
    cmd = "echo \"QT_MAJOR_VERSION = 6\" > $@",
)

py_library(
    name = "python_qt_binding",
    srcs = [
        "src/python_qt_binding/__init__.py",
        "src/python_qt_binding/binding_helper.py",
    ] + [
        ":generate_version_py",
    ],
    imports = ["src"],
    deps = [
        requirement("PySide6-Essentials"),
    ],
)

### PACKAGING

genrule(
    name = "python_qt_binding_extras_cmake",
    outs = ["cmake/python_qt_binding-extras.cmake"],
    cmd = "echo 'set(python_qt_binding_QT_MAJOR_VERSION \"6\" CACHE STRING \"The major version of Qt to use (5 or 6)\")' > $@",
)

ament_package(
    name = "ament_package",
    cmake = [
        "cmake/pyproject.toml.in",
        "cmake/shiboken_helper.cmake",
        "cmake/sip_helper.cmake",
        ":python_qt_binding_extras_cmake",
    ],
    cmake_extras = ["python_qt_binding-extras.cmake"],
    cmake_strip_prefix = "cmake",
    package_xml = "package.xml",
    python = [":python_qt_binding"],
    python_strip_prefix = "src",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
