load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### DATA

ament_index(
    name = "ament_index",
    data = [
        "examples/example.launch.py",
        "examples/includes_example.launch.py",
    ],
    package_xml = "package.xml",
)

### PYTHON MODULE

py_library(
    name = "ros2launch",
    srcs = [
        "ros2launch/__init__.py",
        "ros2launch/api/__init__.py",
        "ros2launch/api/api.py",
        "ros2launch/command/__init__.py",
        "ros2launch/command/launch.py",
        "ros2launch/option/__init__.py",
    ],
    data = [":ament_index"],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@launch",
        "@launch_ros",
        "@launch_xml",
        "@launch_yaml",
        "@ros2cli",
        "@ros2pkg",
    ],
)

### TESTS

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            "CHANGELOG.rst",
            "examples/example.launch.py",
            "examples/includes_example.launch.py",
            "package.xml",
            "pytest.ini",
            "resource/ros2launch",
            "ros2launch/__init__.py",
            "ros2launch/api/__init__.py",
            "ros2launch/api/api.py",
            "ros2launch/command/__init__.py",
            "ros2launch/command/launch.py",
            "ros2launch/option/__init__.py",
            "setup.py",
            "test/test_copyright.py",
            "test/test_flake8.py",
            "test/test_pep257.py",
            "test/test_xmllint.py",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":ros2launch"],
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_xml//:ament_package",
        "@launch_yaml//:ament_package",
        "@ros2cli//:ament_package",
        "@ros2pkg//:ament_package",
        "@rosdistro//:ament_package",
    ],
)

launch_ros_binary(
    name = "examples_example_launch_py",
    src = "examples/example.launch.py",
    data = [":ament_index"],
    deps = [
        "@demo_nodes_cpp//:listener",
        "@demo_nodes_cpp//:talker",
    ],
)

launch_ros_binary(
    name = "examples_includes_example_launch_py",
    src = "examples/includes_example.launch.py",
    deps = [":examples_example_launch_py"],
)
