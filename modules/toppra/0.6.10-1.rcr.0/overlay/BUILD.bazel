load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
]

cc_library(
    name = "toppra_library",
    srcs = [
        "src/toppra/algorithm.cpp",
        "src/toppra/algorithm/toppra.cpp",
        "src/toppra/constraint.cpp",
        "src/toppra/constraint/cartesian_velocity_norm.cpp",
        "src/toppra/constraint/joint_torque.cpp",
        "src/toppra/constraint/linear_joint_acceleration.cpp",
        "src/toppra/constraint/linear_joint_velocity.cpp",
        "src/toppra/geometric_path.cpp",
        "src/toppra/geometric_path/piecewise_poly_path.cpp",
        "src/toppra/parametrizer.cpp",
        "src/toppra/parametrizer/const_accel.cpp",
        "src/toppra/parametrizer/spline.cpp",
        "src/toppra/solver.cpp",
        "src/toppra/solver/glpk-wrapper.cpp",
        "src/toppra/solver/qpOASES-wrapper.cpp",
        "src/toppra/solver/seidel.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":gen_extra_9"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "_gen/include/toppra",
        "bindings",
        "src",
        "tests",
    ],
    local_defines = ros_local_defines() + ["TOPPRA_WARN_ON"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "toppra",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":toppra_library"],
)

cc_library(
    name = "toppra_int.cpython-314-x86_64-linux-gnu_library",
    srcs = [":gen_toppra_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":gen_extra_9"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "_gen/include/toppra",
        "bindings",
        "src",
        "tests",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":toppra_library"],
)

cc_shared_library(
    name = "toppra_int.cpython-314-x86_64-linux-gnu",
    dynamic_deps = DEPENDENCIES.keys(),
    shared_lib_name = "toppra_int/toppra_int.so",
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":toppra_int.cpython-314-x86_64-linux-gnu_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

write_file(
    name = "gen_toppra_stub_cpp",
    out = "_gen/toppra_stub.cpp",
    content = ["extern \"C\" void PyInit_toppra_int(void) {}\n"],
)

write_file(
    name = "gen_extra_9",
    out = "_gen/include/toppra/export.hpp",
    content = ["\n#ifndef TOPPRA_EXPORT_H\n#define TOPPRA_EXPORT_H\n\n#ifdef TOPPRA_STATIC_DEFINE\n#  define TOPPRA_EXPORT\n#  define TOPPRA_NO_EXPORT\n#else\n#  ifndef TOPPRA_EXPORT\n#    ifdef toppra_EXPORTS\n        /* We are building this library */\n#      define TOPPRA_EXPORT __attribute__((visibility(\"default\")))\n#    else\n        /* We are using this library */\n#      define TOPPRA_EXPORT __attribute__((visibility(\"default\")))\n#    endif\n#  endif\n\n#  ifndef TOPPRA_NO_EXPORT\n#    define TOPPRA_NO_EXPORT __attribute__((visibility(\"hidden\")))\n#  endif\n#endif\n\n#ifndef TOPPRA_DEPRECATED\n#  define TOPPRA_DEPRECATED __attribute__ ((__deprecated__))\n#endif\n\n#ifndef TOPPRA_DEPRECATED_EXPORT\n#  define TOPPRA_DEPRECATED_EXPORT TOPPRA_EXPORT TOPPRA_DEPRECATED\n#endif\n\n#ifndef TOPPRA_DEPRECATED_NO_EXPORT\n#  define TOPPRA_DEPRECATED_NO_EXPORT TOPPRA_NO_EXPORT TOPPRA_DEPRECATED\n#endif\n\n/* NOLINTNEXTLINE(readability-avoid-unconditional-preprocessor-if) */\n#if 0 /* DEFINE_NO_DEPRECATED */\n#  ifndef TOPPRA_NO_DEPRECATED\n#    define TOPPRA_NO_DEPRECATED\n#  endif\n#endif\n\n#endif /* TOPPRA_EXPORT_H */\n"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":toppra",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_python//:ament_package",
    ],
)

cc_test(
    name = "all_tests",
    srcs = [
        "tests/gtest_main.cpp",
        "tests/test_algorithm.cpp",
        "tests/test_constraints.cpp",
        "tests/test_cubic_spline.cpp",
        "tests/test_hermite_spline.cpp",
        "tests/test_issue_198.cpp",
        "tests/test_parametrizer.cpp",
        "tests/test_poly_geometric_path.cpp",
        "tests/test_solver.cpp",
        "tests/test_spline_parametrizer.cpp",
        "tests/test_toppra_approach.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        ":ament_index",
        ":toppra_int.cpython-314-x86_64-linux-gnu",
    ] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "_gen/include/toppra",
        "bindings",
        "src",
        "tests",
    ],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "TOPPRA_WARN_ON",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":toppra_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    egg_info = False,
    headers = [
        "src/toppra/algorithm.hpp",
        "src/toppra/algorithm/toppra.hpp",
        "src/toppra/constraint.hpp",
        "src/toppra/constraint/cartesian_velocity_norm.hpp",
        "src/toppra/constraint/cartesian_velocity_norm/pinocchio.hpp",
        "src/toppra/constraint/joint_torque.hpp",
        "src/toppra/constraint/joint_torque/pinocchio.hpp",
        "src/toppra/constraint/linear_joint_acceleration.hpp",
        "src/toppra/constraint/linear_joint_velocity.hpp",
        ":gen_extra_9",
        "src/toppra/geometric_path.hpp",
        "src/toppra/geometric_path/piecewise_poly_path.hpp",
        "src/toppra/parametrizer.hpp",
        "src/toppra/parametrizer/const_accel.hpp",
        "src/toppra/parametrizer/spline.hpp",
        "src/toppra/solver.hpp",
        "src/toppra/solver/glpk-wrapper.hpp",
        "src/toppra/solver/qpOASES-wrapper.hpp",
        "src/toppra/solver/seidel.hpp",
        "src/toppra/toppra.hpp",
    ],
    headers_strip_prefix = "src",
    include_prefix = "",
    libraries = [
        ":toppra",
    ],
    package_xml = "package.xml",
    python = [":toppra_int.cpython-314-x86_64-linux-gnu"],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_python//:ament_package",
    ],
)
