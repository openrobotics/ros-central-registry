load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {}

CC_DEPS = [
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
]

cc_test(
    name = "all_tests",
    srcs = [
        "gtest_main.cpp",
        "test_algorithm.cpp",
        "test_constraints.cpp",
        "test_cubic_spline.cpp",
        "test_hermite_spline.cpp",
        "test_issue_198.cpp",
        "test_parametrizer.cpp",
        "test_poly_geometric_path.cpp",
        "test_solver.cpp",
        "test_spline_parametrizer.cpp",
        "test_toppra_approach.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        "//:ament_index",
        "//:toppra_int.cpython-314-x86_64-linux-gnu",
    ] + [
        "CMakeLists.txt",
        "test_cubic_spline_gendata.py",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "TOPPRA_WARN_ON",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:toppra_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
