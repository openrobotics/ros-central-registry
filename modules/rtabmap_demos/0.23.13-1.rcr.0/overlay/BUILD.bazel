load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

ament_index(
    name = "ament_index",
    data = [
        "config/demo_robot_mapping.rviz",
        "config/find_object.ini",
        "data/books/4.png",
        "data/books/5.png",
        "data/books/6.png",
        "data/books/7.png",
        "data/books/8.png",
        "params/champ_nav2_params.yaml",
        "params/fusioncore_tb3.yaml",
        "params/fusioncore_tb3_bridge.yaml",
        "params/humble/turtlebot3_rgbd_nav2_params.yaml",
        "params/humble/turtlebot3_rgbd_scan_nav2_params.yaml",
        "params/humble/turtlebot3_scan_nav2_params.yaml",
        "params/isaac_nav2_params.yaml",
        "params/isaac_vslam_nav2_params.yaml",
        "params/turtlebot3_fusioncore_icp_nav2_params.yaml",
        "params/turtlebot3_nav2_params.yaml",
        "params/turtlebot3_rgbd_nav2_params.yaml",
        "params/turtlebot3_rgbd_scan_nav2_params.yaml",
        "params/turtlebot3_scan_nav2_params.yaml",
        "//launch:launch_files",
    ],
    package_xml = "package.xml",
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@compressed_depth_image_transport//:ament_package",
        "@compressed_image_transport//:ament_package",
        "@nav2_bringup//:ament_package",
        "@rtabmap_odom//:ament_package",
        "@rtabmap_rviz_plugins//:ament_package",
        "@rtabmap_slam//:ament_package",
        "@rtabmap_util//:ament_package",
        "@rtabmap_viz//:ament_package",
    ],
)
