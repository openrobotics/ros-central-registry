load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = [
        "ament_vitis-extras.cmake",
        "cmake/firmware_data_path.cmake",
        "cmake/firmware_soc_path.cmake",
        "cmake/hls_path.cmake",
        "cmake/platform_repo_paths.cmake",
        "cmake/ros_vitis.cmake",
        "cmake/ros_xrt.cmake",
        "cmake/vitis_acceleration_kernel.cmake",
        "cmake/vitis_hls.cmake",
        "cmake/vitis_link_kernel.cmake",
        "cmake/vitis_path.cmake",
        "cmake/vivado_path.cmake",
        "cmake/vpp_path.cmake",
    ],
    cmake_extras = ["ament_vitis-extras.cmake"],
    package_xml = "package.xml",
    deps = [
        "@ament_acceleration//:ament_package",
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
