load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

exports_files([
    "fixtures/fibonacci_action_introspection.py",
    "fixtures/fibonacci_action_server.py",
    "test_api.py",
    "test_cli.py",
    "test_copyright.py",
    "test_echo.py",
    "test_flake8.py",
    "test_pep257.py",
    "test_xmllint.py",
])

[py_pytest(
    name = test.removesuffix(".py"),
    srcs = ["{0}.py".format(test)],
    data = [
        "fixtures/fibonacci_action_introspection.py",
        "fixtures/fibonacci_action_server.py",
    ],
    tags = [
        "manual",
        "xfail",
    ] if test in [
        "test_cli",
        "test_echo",
    ] else [],
    deps = [
        "//:ros2action",
        "@launch",
        "@launch_testing",
        "@launch_testing_ros",
        requirement("pyyaml"),
    ],
) for test in [
    "test_api",
    "test_cli",
    "test_echo",
]]
