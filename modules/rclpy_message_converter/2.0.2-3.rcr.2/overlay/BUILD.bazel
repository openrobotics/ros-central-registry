load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

py_library(
    name = "rclpy_message_converter",
    srcs = [
        "rclpy_message_converter/__init__.py",
        "rclpy_message_converter/json_message_converter.py",
        "rclpy_message_converter/message_converter.py",
    ],
    imports = ["."],
    deps = [
        "@builtin_interfaces//:py",
        "@geometry_msgs//:py",
        "@rclpy",
        "@rclpy_message_converter_msgs//:py",
        "@rosidl_parser",
        "@rosidl_runtime_py",
        "@std_msgs//:py",
        "@std_srvs//:py",
        "@tf2_msgs//:py",
        requirement("numpy"),
    ],
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":rclpy_message_converter"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rclpy_message_converter_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_parser//:ament_package",
        "@rosidl_runtime_py//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2_msgs//:ament_package",
    ],
)
