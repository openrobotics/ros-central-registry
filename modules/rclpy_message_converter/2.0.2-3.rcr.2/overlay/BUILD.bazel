package(default_visibility = ["//visibility:public"])

py_library(
    name = "rclpy_message_converter",
    srcs = glob(["rclpy_message_converter/**/*.py"]),
    imports = ["."],
    deps = [
        "@builtin_interfaces//:py",
        "@geometry_msgs//:py",
        "@rclpy",
        "@rclpy_message_converter_msgs//:py",
        "@rosidl_parser",
        "@rosidl_runtime_py",
        "@std_msgs//:py",
        "@std_srvs//:py",
        "@tf2_msgs//:py",
        requirement("numpy"),
    ],
)

py_pytest(
    name = "test_json_message_converter",
    srcs = ["test/test_json_message_converter.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    deps = [":rclpy_message_converter"],
)

py_pytest(
    name = "test_message_converter",
    srcs = ["test/test_message_converter.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    deps = [":rclpy_message_converter"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":rclpy_message_converter"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rclpy_message_converter_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_parser//:ament_package",
        "@rosidl_runtime_py//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2_msgs//:ament_package",
    ],
)
