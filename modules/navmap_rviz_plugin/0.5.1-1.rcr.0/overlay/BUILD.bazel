load("@qt//:qt.bzl", "qt_cc_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@navmap_ros//:navmap_ros": "@navmap_ros//:navmap_ros_library",
    "@navmap_core//:navmap_core": "@navmap_core//:navmap_core_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:OgreMain": "@rosdistro//cc:OgreMain_library",
    "@rosdistro//cc:OgreOverlay": "@rosdistro//cc:OgreOverlay_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:curl": "@rosdistro//cc:curl_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rviz_common//:rviz_common": "@rviz_common//:rviz_common_library",
    "@rviz_default_plugins//:rviz_default_plugins": "@rviz_default_plugins//:rviz_default_plugins_library",
    "@rviz_rendering//:rviz_rendering": "@rviz_rendering//:rviz_rendering_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@navmap_ros_interfaces//:cc",
    "@qtbase//:widgets",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
    "@visualization_msgs//:cc",
]

qt_cc_library(
    name = "navmap_rviz_plugin_library",
    srcs = [
        "src/navmap_rviz_plugin/NavMapDisplay.cpp",
        "src/navmap_rviz_plugin/navmap_goal_tool.cpp",
        "src/navmap_rviz_plugin/navmap_pose_tool.cpp",
    ],
    hdrs = [
        "include/navmap_rviz_plugin/NavMapDisplay.hpp",
        "include/navmap_rviz_plugin/navmap_goal_tool.hpp",
    ] + [
        "include/navmap_rviz_plugin/navmap_pose_tool.hpp",
    ],
    copts = [
        "-include",
        "char_traits_patch.h",
    ],
    includes = [
        "_gen/include",
        "_gen/include/navmap_ros",
        "include",
        "include/navmap_rviz_plugin",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    moc_hdrs = [
        "include/navmap_rviz_plugin/NavMapDisplay.hpp",
        "include/navmap_rviz_plugin/navmap_goal_tool.hpp",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "navmap_rviz_plugin",
    dynamic_deps = DEPENDENCIES.keys() + [
        "@qtbase//:widgets_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":navmap_rviz_plugin_library"],
)

ament_index(
    name = "ament_index",
    data = [
        "icons/classes/NavMapSetGoal.png",
        "resource/navmap_rviz_plugin_description.xml",
    ],
    data_strip_prefix = "resource",
    libraries = [
        ":navmap_rviz_plugin",
    ],
    package_xml = "package.xml",
    plugin_category = "rviz_common",
    plugins = ["resource/navmap_rviz_plugin_description.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@geometry_msgs//:ament_package",
        "@navmap_core//:ament_package",
        "@navmap_ros//:ament_package",
        "@navmap_ros_interfaces//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_default_plugins//:ament_package",
        "@rviz_rendering//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "Qt6",
        "geometry_msgs",
        "navmap_ros_interfaces",
        "pluginlib",
        "rclcpp",
        "rviz_common",
        "rviz_default_plugins",
        "rviz_rendering",
        "std_msg",
    ],
    cmake_export_include_directories = False,
    cmake_export_name = "export_navmap_rviz_plugin",
    libraries = [
        ":navmap_rviz_plugin",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@geometry_msgs//:ament_package",
        "@navmap_core//:ament_package",
        "@navmap_ros//:ament_package",
        "@navmap_ros_interfaces//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_default_plugins//:ament_package",
        "@rviz_rendering//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
