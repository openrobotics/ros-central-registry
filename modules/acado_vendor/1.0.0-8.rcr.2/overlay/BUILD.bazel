load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
]

cc_library(
    name = "acado_casadi_library",
    srcs = [],
    hdrs = [],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines() + [
        "ACADO_CMAKE_BUILD",
        "ACADO_HAS_CXX11",
        "LINUX",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_library(
    name = "acado_toolkit_s_library",
    srcs = [],
    hdrs = [],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines() + [
        "ACADO_CMAKE_BUILD",
        "ACADO_HAS_CXX11",
        "LINUX",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":acado_casadi_library"],
)

cc_shared_library(
    name = "acado_toolkit_s",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":acado_toolkit_s_library"],
)

cc_library(
    name = "hpmpc_library",
    srcs = [],
    hdrs = [],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines() + ["TARGET_C99_4X4"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "hpmpc",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":hpmpc_library"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    colcon_hooks = False,
    install_package_xml = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
    ],
)
