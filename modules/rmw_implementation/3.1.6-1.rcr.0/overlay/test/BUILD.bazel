load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
}

cc_test(
    name = "test_functions",
    srcs = ["test_functions.cpp"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    target_compatible_with = select({
        "//:rmw_dynamic": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = DEPENDENCIES.values() + [
        "//:rmw_implementation_dynamic_library",
        "@rosdistro//cc:googletest",
    ],
)

[cc_test(
    name = "benchmark_symbols__" + rmw,
    srcs = ["benchmark/benchmark_symbols.cpp"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    env = {"RMW_IMPLEMENTATION": rmw},
    tags = ["manual"],
    target_compatible_with = select({
        "//:rmw_dynamic": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = DEPENDENCIES.values() + [
        "//:rmw_implementation_dynamic_library",
        "@google_benchmark//:benchmark_main",
        "@performance_test_fixture",
    ],
) for rmw in [
    "rmw_fastrtps_cpp",
    "rmw_fastrtps_dynamic_cpp",
    "rmw_cyclonedds_cpp",
    "rmw_zenoh_cpp",
]]
