load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
    "@urdfdom_headers//:urdfdom_headers": "@urdfdom_headers//:urdfdom_headers_library",
    "@visualization_msgs//:cc_shared": "@visualization_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "rviz_marker_tools_library",
    srcs = ["src/marker_creation.cpp"],
    hdrs = ["include/rviz_marker_tools/marker_creation.h"] + [],
    includes = [
        "_gen/include",
        "_gen/include/urdf_model",
        "include",
        "include/rviz_marker_tools",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rviz_marker_tools",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rviz_marker_tools_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":rviz_marker_tools"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@geometry_msgs//:ament_package",
        "@moveit_common//:ament_package",
        "@rclcpp//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2_eigen//:ament_package",
        "@urdfdom_headers//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "tf2_eigen",
        "urdfdom_headers",
        "geometry_msgs",
        "std_msgs",
        "visualization_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = ["include/rviz_marker_tools/marker_creation.h"],
    include_prefix = "",
    libraries = [":rviz_marker_tools"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@geometry_msgs//:ament_package",
        "@moveit_common//:ament_package",
        "@rclcpp//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2_eigen//:ament_package",
        "@urdfdom_headers//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
