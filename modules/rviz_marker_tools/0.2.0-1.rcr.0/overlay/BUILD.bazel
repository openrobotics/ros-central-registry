write_file(
    name = "gen_urdf_model_link_h",
    out = "_gen/include/urdf_model/link.h",
    content = ["#ifndef RCR_URDF_MODEL_LINK_H_\n#define RCR_URDF_MODEL_LINK_H_\n#include <string>\nnamespace urdf {\nstruct Vector3 {\n  double x{0.0}, y{0.0}, z{0.0};\n  Vector3() = default;\n  Vector3(double x_, double y_, double z_) : x(x_), y(y_), z(z_) {}\n};\nclass Geometry {\n public:\n  enum { SPHERE, BOX, CYLINDER, MESH, CAPSULE } type;\n  virtual ~Geometry() = default;\n};\nclass Sphere : public Geometry {\n public:\n  Sphere() { type = SPHERE; }\n  double radius{0.0};\n};\nclass Box : public Geometry {\n public:\n  Box() { type = BOX; }\n  Vector3 dim;\n};\nclass Cylinder : public Geometry {\n public:\n  Cylinder() { type = CYLINDER; }\n  double length{0.0};\n  double radius{0.0};\n};\nclass Capsule : public Geometry {\n public:\n  Capsule() { type = CAPSULE; }\n  double length{0.0};\n  double radius{0.0};\n};\nclass Mesh : public Geometry {\n public:\n  Mesh() { type = MESH; }\n  std::string filename;\n  Vector3 scale{1.0, 1.0, 1.0};\n};\n}  // namespace urdf\n#endif\n"],
)

