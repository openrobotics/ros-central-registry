        allow_empty = True,
    ) + [
        ":gen_nanobind_h",
        ":gen_nanobind_stl_filesystem_h",
        ":gen_nanobind_stl_string_h",
    ],
    copts = ["-std=c++20"],
    includes = [
        "_gen/include",
        "bindings/include",
        "include",
        "include/roboplan_example_models",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

