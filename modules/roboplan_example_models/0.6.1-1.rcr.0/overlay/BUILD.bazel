    out = "_gen/lib/cmake/roboplan_example_models/roboplan_example_modelsTargets-noconfig.cmake",
    content = ["#----------------------------------------------------------------\n# Generated CMake target import file.\n#----------------------------------------------------------------\n\n# Commands may need to know the format version.\nset(CMAKE_IMPORT_FILE_VERSION 1)\n\n# Import target \"roboplan_example_models::roboplan_example_models\" for configuration \"\"\nset_property(TARGET roboplan_example_models::roboplan_example_models APPEND PROPERTY IMPORTED_CONFIGURATIONS NOCONFIG)\nset_target_properties(roboplan_example_models::roboplan_example_models PROPERTIES\n  IMPORTED_LOCATION_NOCONFIG \"${_IMPORT_PREFIX}/lib/libroboplan_example_models.so\"\n  IMPORTED_SONAME_NOCONFIG \"libroboplan_example_models.so\"\n  )\n\nlist(APPEND _cmake_import_check_targets roboplan_example_models::roboplan_example_models )\nlist(APPEND _cmake_import_check_files_for_roboplan_example_models::roboplan_example_models \"${_IMPORT_PREFIX}/lib/libroboplan_example_models.so\" )\n\n# Commands beyond this point should not need to know the version.\nset(CMAKE_IMPORT_FILE_VERSION)\n"],
)

