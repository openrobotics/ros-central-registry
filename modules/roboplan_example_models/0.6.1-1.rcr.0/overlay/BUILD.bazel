genrule(
    name = "tar",
    srcs = [":raw_tar"],
    outs = ["tar.tar.gz"],
    cmd = "tmpdir=$$(mktemp -d) && tar -xzf $(location :raw_tar) -C $$tmpdir && rm -f $$tmpdir/opt/ros/lyrical/roboplan_example_models/share/roboplan_example_models/environment/pythonpath.dsv $$tmpdir/opt/ros/lyrical/roboplan_example_models/share/roboplan_example_models/environment/pythonpath.sh && tar -czf $@ -C $$tmpdir opt && rm -rf $$tmpdir",
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    egg_info = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    install = [
        ":pkg_files_extra_0",
        ":pkg_files_extra_1",
        ":pkg_files_extra_2",
        ":pkg_files_extra_3",
        ":pkg_files_extra_4",
    ],
    libraries = [":roboplan_example_models"],
    package_xml = "package.xml",
    python = [
        ":roboplan",
        ":_example_models_ext.cpython-314-x86_64-linux-gnu",
        "bindings/python/roboplan/example_models/_example_models_ext.pyi",
        "bindings/python/roboplan/example_models/py.typed",
    ],
    python_strip_prefix = "bindings/python",
    tar_name = "raw_tar",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
    ],
)
