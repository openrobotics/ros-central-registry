load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

cc_library(
    name = "validation",
    hdrs = ["include/geographic_msgs/validation.hpp"],
    includes = ["include"],
    deps = [":cc"],
)

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:BoundingBox",
        "//msg:GeoPath",
        "//msg:GeoPoint",
        "//msg:GeoPointStamped",
        "//msg:GeoPose",
        "//msg:GeoPoseStamped",
        "//msg:GeoPoseWithCovariance",
        "//msg:GeoPoseWithCovarianceStamped",
        "//msg:GeographicMap",
        "//msg:GeographicMapChanges",
        "//msg:KeyValue",
        "//msg:MapFeature",
        "//msg:RouteNetwork",
        "//msg:RoutePath",
        "//msg:RouteSegment",
        "//msg:WayPoint",
        "//srv:GetGeoPath",
        "//srv:GetGeographicMap",
        "//srv:GetRoutePlan",
        "//srv:UpdateGeographicMap",
    ],
)

rosidl_ament_package(
    name = "ament_package",
    data = ["geographic_msgs_mapping_rule.yaml"],
    headers = ["include/geographic_msgs/validation.hpp"],
    interface_library = "validation",
    interface_library_link_libraries = ["geographic_msgs::geographic_msgs__rosidl_typesupport_cpp"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
        "@unique_identifier_msgs//:ament_package",
    ],
)
