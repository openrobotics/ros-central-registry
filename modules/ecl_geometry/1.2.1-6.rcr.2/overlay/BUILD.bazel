cc_library(
    name = "ecl_geometry_library",
    srcs = [
        "src/lib/angle.cpp",
        "src/lib/cubic_spline.cpp",
        "src/lib/cubic_spline_blueprints.cpp",
        "src/lib/linear_segment.cpp",
        "src/lib/odometry_helper.cpp",
        "src/lib/pascals_triangle.cpp",
        "src/lib/polynomial.cpp",
        "src/lib/polynomial_blueprints.cpp",
        "src/lib/pose2d.cpp",
        "src/lib/smooth_linear_spline.cpp",
        "src/lib/tension_function.cpp",
        "src/lib/tension_spline.cpp",
        "src/lib/tension_spline_blueprints.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src/test",
    ],
    local_defines = ros_local_defines() + [
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "SOPHUS_USE_BASIC_LOGGING=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ecl_geometry",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":ecl_geometry_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

