        "src/lib/polynomial.cpp",
        "src/lib/polynomial_blueprints.cpp",
        "src/lib/pose2d.cpp",
        "src/lib/smooth_linear_spline.cpp",
        "src/lib/tension_function.cpp",
        "src/lib/tension_spline.cpp",
        "src/lib/tension_spline_blueprints.cpp",
    ],
    hdrs = [
        "include/ecl/geometry.hpp",
        "include/ecl/geometry/angle.hpp",
        "include/ecl/geometry/cartesian_point.hpp",
        "include/ecl/geometry/cubic_spline.hpp",
        "include/ecl/geometry/function_math.hpp",
        "include/ecl/geometry/homogeneous_point.hpp",
        "include/ecl/geometry/legacy_pose2d.hpp",
        "include/ecl/geometry/legacy_pose3d.hpp",
        "include/ecl/geometry/linear_segment.hpp",
        "include/ecl/geometry/macros.hpp",
        "include/ecl/geometry/odometry.hpp",
        "include/ecl/geometry/odometry_helper.hpp",
        "include/ecl/geometry/odometry_typedefs.hpp",
        "include/ecl/geometry/pascals_triangle.hpp",
        "include/ecl/geometry/polynomial.hpp",
        "include/ecl/geometry/pose2d.hpp",
        "include/ecl/geometry/smooth_linear_spline.hpp",
        "include/ecl/geometry/spline_function.hpp",
        "include/ecl/geometry/tension_function.hpp",
        "include/ecl/geometry/tension_spline.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src/test",
    ],
    local_defines = ros_local_defines() + [
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "SOPHUS_USE_BASIC_LOGGING=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ecl_geometry",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":ecl_geometry_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ecl_geometry"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":ecl_geometry",
    ],
    package_xml = "package.xml",
    sonames = {
        "ecl_geometry": ["libecl_geometry.so.1.2.1"],
