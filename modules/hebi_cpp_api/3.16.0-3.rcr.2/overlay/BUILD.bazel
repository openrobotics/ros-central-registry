        "include/hebi_cpp_api/vector_3_f.hpp",
        "include/hebi_cpp_api/version.cpp",
        "include/hebi_cpp_api/version.hpp",
    ],
    headers_strip_prefixes = [
        "hebi/include->hebi_cpp_api",
        "include",
    ],
    include_prefix = "",
    libraries = [
        ":hebic++",
        ":static_hebic++-static_a",
