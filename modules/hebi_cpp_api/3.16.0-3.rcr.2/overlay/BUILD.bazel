load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "hebic++_library",
    srcs = [
        "include/hebi_cpp_api/arm/arm.cpp",
        "include/hebi_cpp_api/arm/kinematics_helper.cpp",
        "include/hebi_cpp_api/command.cpp",
        "include/hebi_cpp_api/feedback.cpp",
        "include/hebi_cpp_api/group.cpp",
        "include/hebi_cpp_api/group_command.cpp",
        "include/hebi_cpp_api/group_feedback.cpp",
        "include/hebi_cpp_api/group_info.cpp",
        "include/hebi_cpp_api/info.cpp",
        "include/hebi_cpp_api/log_file.cpp",
        "include/hebi_cpp_api/lookup.cpp",
        "include/hebi_cpp_api/mac_address.cpp",
        "include/hebi_cpp_api/message_helpers.cpp",
        "include/hebi_cpp_api/rapidyaml/rapidyaml-0.5.0.cpp",
        "include/hebi_cpp_api/robot_config.cpp",
        "include/hebi_cpp_api/robot_model.cpp",
        "include/hebi_cpp_api/trajectory.cpp",
        "include/hebi_cpp_api/util/file.cpp",
        "include/hebi_cpp_api/util/mobile_io.cpp",
        "include/hebi_cpp_api/version.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    includes = [
        "hebi/include",
        "include",
        "include/hebi_cpp_api",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "hebic++",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":hebic++_library"],
)

cc_library(
    name = "hebic++-static_library",
    srcs = [
        "include/hebi_cpp_api/arm/arm.cpp",
        "include/hebi_cpp_api/arm/kinematics_helper.cpp",
        "include/hebi_cpp_api/command.cpp",
        "include/hebi_cpp_api/feedback.cpp",
        "include/hebi_cpp_api/group.cpp",
        "include/hebi_cpp_api/group_command.cpp",
        "include/hebi_cpp_api/group_feedback.cpp",
        "include/hebi_cpp_api/group_info.cpp",
        "include/hebi_cpp_api/info.cpp",
        "include/hebi_cpp_api/log_file.cpp",
        "include/hebi_cpp_api/lookup.cpp",
        "include/hebi_cpp_api/mac_address.cpp",
        "include/hebi_cpp_api/message_helpers.cpp",
        "include/hebi_cpp_api/rapidyaml/rapidyaml-0.5.0.cpp",
        "include/hebi_cpp_api/robot_config.cpp",
        "include/hebi_cpp_api/robot_model.cpp",
        "include/hebi_cpp_api/trajectory.cpp",
        "include/hebi_cpp_api/util/file.cpp",
        "include/hebi_cpp_api/util/mobile_io.cpp",
        "include/hebi_cpp_api/version.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    includes = [
        "hebi/include",
        "include",
        "include/hebi_cpp_api",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

genrule(
    name = "static_hebic++-static_a",
    srcs = [":hebic++-static_library"],
    outs = ["libhebic++-static.a"],
    cmd = "for f in $(SRCS); do case $$f in *.a) cp $$f $@; break;; esac; done",
)

ament_index(
    name = "ament_index",
    libraries = [
        ":hebic++",
        ":static_hebic++-static_a",
        "hebi/lib/linux_x86_64/libhebi.so",
        "hebi/lib/linux_x86_64/libhebi.so.2",
        "hebi/lib/linux_x86_64/libhebi.so.2.23",
        "hebi/lib/linux_x86_64/libhebi.so.2.23.1",
    ],
    package_xml = "package.xml",
    sonames = {
        "hebic++": [
            "libhebic++.so.3",
            "libhebic++.so.3.12.2",
        ],
    },
    deps = [
        "@ament_cmake//:ament_package",
    ],
)

