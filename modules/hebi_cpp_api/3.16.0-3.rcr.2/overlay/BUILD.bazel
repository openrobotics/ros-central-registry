        "include/hebi_cpp_api/lookup.hpp",
        "include/hebi_cpp_api/mac_address.cpp",
        "include/hebi_cpp_api/mac_address.hpp",
        "include/hebi_cpp_api/message_helpers.cpp",
        "include/hebi_cpp_api/message_helpers.hpp",
        "include/hebi_cpp_api/quaternion_f.hpp",
        "include/hebi_cpp_api/rapidyaml/rapidyaml-0.5.0.cpp",
