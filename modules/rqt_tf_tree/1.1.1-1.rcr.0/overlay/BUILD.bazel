load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "rqt_tf_tree",
    srcs = [
        "src/rqt_tf_tree/__init__.py",
        "src/rqt_tf_tree/dotcode_tf.py",
        "src/rqt_tf_tree/main.py",
        "src/rqt_tf_tree/tf_tree.py",
    ],
    imports = ["src"],
    deps = [
        "@python_qt_binding",
        "@qt_dotgraph",
        "@rclpy",
        "@rqt_graph",
        "@rqt_gui",
        "@rqt_gui_py",
        "@tf2_msgs//:py",
        "@tf2_ros_py",
        requirement("pyyaml"),
    ],
)

ament_package(
    name = "ament_package",
    console_scripts = {"rqt_tf_tree": "rqt_tf_tree.main:main"},
    data = [
        "plugin.xml",
        "resource/RosTfTree.ui",
    ],
    executables = ["resource/rqt_tf_tree"],
    package_xml = "package.xml",
    python = [":rqt_tf_tree"],
    python_strip_prefix = "src",
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@python_qt_binding//:ament_package",
        "@qt_dotgraph//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_graph//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@tf2_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@tf2_ros_py//:ament_package",
    ],
)
