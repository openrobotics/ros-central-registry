load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@launch_testing_ros//:defs.bzl", "launch_ros_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "georeference.test",
        "initialize_origin.launch.xml",
        "local_xy_util.test",
        "local_xy_util.test.py",
        "transform_manager.test",
        "transform_manager.test.py",
        "transform_util.test",
        "utm_util.test",
    ],
)

launch_ros_binary(
    name = "initialize_origin.launch",
    src = "initialize_origin.launch.xml",
    data = ["//:ament_index"],
    deps = ["//:swri_transform_util_py"],
)

launch_ros_test(
    name = "launch_transform_manager_test",
    src = "transform_manager.test.py",
    data = [
        "//:ament_index",
        "//test:_bin/georeference_test",
        "//test:_bin/local_xy_util_test",
        "//test:_bin/transform_util_test",
        "//test:_bin/utm_util_test",
        "//test:transform_manager_test",
        "@tf2_ros//:ament_index",
        "@tf2_ros//:static_transform_publisher",
    ],
    deps = [
        "//:swri_transform_util_py",
        "@ament_index_python",
        "@diagnostic_msgs//:py",
        "@geographic_msgs//:py",
        "@geometry_msgs//:py",
        "@gps_msgs//:py",
        "@marti_nav_msgs//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@sensor_msgs//:py",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_py",
    ],
)

launch_ros_test(
    name = "launch_local_xy_util_test",
    src = "local_xy_util.test.py",
    data = [
        "//:ament_index",
        "//test:_bin/georeference_test",
        "//test:_bin/local_xy_util_test",
        "//test:_bin/transform_util_test",
        "//test:_bin/utm_util_test",
        "//test:transform_manager_test",
    ],
    deps = [
        "//:swri_transform_util_py",
        "@ament_index_python",
        "@diagnostic_msgs//:py",
        "@geographic_msgs//:py",
        "@geometry_msgs//:py",
        "@gps_msgs//:py",
        "@marti_nav_msgs//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@sensor_msgs//:py",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_py",
    ],
)
