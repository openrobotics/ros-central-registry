write_file(
    name = "gen_atomic_shared_ptr_shim_hpp",
    out = "_gen/include/atomic_shared_ptr_shim.hpp",
    content = ["#if !defined(__cpp_lib_atomic_shared_ptr) && !defined(RCR_ATOMIC_SHARED_PTR_SHIM_HPP_)\n#define RCR_ATOMIC_SHARED_PTR_SHIM_HPP_\n#include <atomic>\n#include <memory>\nnamespace std {\ntemplate <class T>\nstruct atomic<shared_ptr<T>> {\n  shared_ptr<T> ptr_;\n  atomic() noexcept = default;\n  atomic(shared_ptr<T> desired) noexcept : ptr_(std::move(desired)) {}\n  atomic(const atomic&) = delete;\n  void operator=(const atomic&) = delete;\n  void store(shared_ptr<T> desired, memory_order order = memory_order_seq_cst) noexcept {\n    atomic_store_explicit(&ptr_, std::move(desired), order);\n  }\n  shared_ptr<T> load(memory_order order = memory_order_seq_cst) const noexcept {\n    return atomic_load_explicit(&ptr_, order);\n  }\n  operator shared_ptr<T>() const noexcept { return load(); }\n  shared_ptr<T> exchange(shared_ptr<T> desired, memory_order order = memory_order_seq_cst) noexcept {\n    return atomic_exchange_explicit(&ptr_, std::move(desired), order);\n  }\n  void operator=(shared_ptr<T> desired) noexcept { store(std::move(desired)); }\n};\n}  // namespace std\n#endif\n"],
)

write_file(
    name = "gen_geographiclib_local_cartesian_hpp",
    out = "_gen/include/GeographicLib/LocalCartesian.hpp",
    content = ["#ifndef RCR_GEOGRAPHICLIB_LOCAL_CARTESIAN_HPP_\n#define RCR_GEOGRAPHICLIB_LOCAL_CARTESIAN_HPP_\n#include <cmath>\nnamespace GeographicLib {\nclass LocalCartesian {\n public:\n  LocalCartesian() = default;\n  LocalCartesian(double lat0, double lon0, double h0 = 0.0) : lat0_(lat0), lon0_(lon0), h0_(h0) {}\n  void Reset(double lat0, double lon0, double h0 = 0.0) { lat0_ = lat0; lon0_ = lon0; h0_ = h0; }\n  double LatitudeOrigin() const { return lat0_; }\n  double LongitudeOrigin() const { return lon0_; }\n  double HeightOrigin() const { return h0_; }\n  void Forward(double lat, double lon, double h, double & x, double & y, double & z) const {\n    constexpr double kDegToRad = 3.14159265358979323846 / 180.0;\n    constexpr double kR = 6378137.0;\n    x = (lon - lon0_) * kDegToRad * kR * std::cos(lat0_ * kDegToRad);\n    y = (lat - lat0_) * kDegToRad * kR;\n    z = h - h0_;\n  }\n  void Reverse(double x, double y, double z, double & lat, double & lon, double & h) const {\n    constexpr double kRadToDeg = 180.0 / 3.14159265358979323846;\n    constexpr double kDegToRad = 3.14159265358979323846 / 180.0;\n    constexpr double kR = 6378137.0;\n    lat = lat0_ + (y / kR) * kRadToDeg;\n    lon = lon0_ + (x / (kR * std::cos(lat0_ * kDegToRad))) * kRadToDeg;\n    h = h0_ + z;\n  }\n private:\n  double lat0_{0.0}, lon0_{0.0}, h0_{0.0};\n};\n}  // namespace GeographicLib\n#endif\n"],
)

write_file(
    name = "gen_proj_h",
    out = "_gen/include/proj.h",
    content = ["#ifndef RCR_PROJ_H_\n#define RCR_PROJ_H_\nstruct PJ_OBS {};\nusing PJ = PJ_OBS;\nusing PJ_CONTEXT = void;\n#define PJ_DEFAULT_CTX nullptr\nenum PJ_DIRECTION { PJ_FWD = 1, PJ_IDENT = 0, PJ_INV = -1 };\nstruct PJ_ENU { double e; double n; double u; };\nstruct PJ_LP { double lam; double phi; };\nunion PJ_COORD {\n  double v[4];\n  PJ_ENU enu;\n  PJ_LP lp;\n};\ninline PJ_COORD proj_coord(double x, double y, double z, double t) {\n  PJ_COORD c;\n  c.v[0] = x; c.v[1] = y; c.v[2] = z; c.v[3] = t;\n  return c;\n}\ninline PJ * proj_create_crs_to_crs(PJ_CONTEXT *, const char *, const char *, void *) {\n  static PJ dummy;\n  return &dummy;\n}\ninline PJ * proj_normalize_for_visualization(PJ_CONTEXT *, const PJ * p) {\n  return const_cast<PJ *>(p);\n}\ninline PJ * proj_destroy(PJ *) { return nullptr; }\ninline PJ_COORD proj_trans(PJ *, PJ_DIRECTION, PJ_COORD coord) { return coord; }\n#endif\n"],
)

