load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

py_library(
    name = "yasmin_editor",
    srcs = glob(["yasmin_editor/**/*.py"]),
    imports = ["."],
    deps = [
        requirement("PyQt6"),
        requirement("lxml"),
        "@rclpy",
    ],
)

pkg_files(
    name = "yasmin_editor_exec",
    srcs = ["yasmin_editor/yasmin_editor.py"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "lib/yasmin_editor",
    renames = {
        "yasmin_editor/yasmin_editor.py": "yasmin_editor",
    },
)

