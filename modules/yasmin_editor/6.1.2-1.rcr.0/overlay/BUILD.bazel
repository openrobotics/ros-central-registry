        "test/test_blackboard_logic_helpers.py",
    ],
    data = [
        "test/runtime_test.xml",
        "test/test.xml",
    ],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    deps = [":yasmin_editor"],
)

