load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

exports_files([
    "test_copyright.py",
    "test_flake8.py",
    "test_helpers.py",
    "test_pep257.py",
    "test_qos_conversions.py",
    "test_ros2cli_daemon.py",
    "test_ros2cli_direct.py",
    "test_strategy.py",
    "test_xmllint.py",
])

[py_pytest(
    name = test.removesuffix(".py"),
    srcs = ["{0}.py".format(test)],
    deps = [
        "//:ros2cli",
        "@test_msgs//:py",
        requirement("pyyaml"),
    ],
) for test in [
    "test_helpers",
    "test_qos_conversions",
    "test_ros2cli_daemon",
    "test_ros2cli_direct",
    "test_strategy",
]]
