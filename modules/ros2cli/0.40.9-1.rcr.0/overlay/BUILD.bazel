load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

write_file(
    name = "pkg_info",
    out = "ros2cli-0.40.6.egg-info/PKG-INFO",
    content = [
        "Metadata-Version: 2.1",
        "Name: ros2cli",
        "Version: 0.40.6",
    ],
)

write_file(
    name = "entry_points_txt",
    out = "ros2cli-0.40.6.egg-info/entry_points.txt",
    content = [
        "[ros2cli.command]",
        "daemon = ros2cli.command.daemon:DaemonCommand",
        "extension_points = ros2cli.command.extension_points:ExtensionPointsCommand",
        "extensions = ros2cli.command.extensions:ExtensionsCommand",
        "",
        "[ros2cli.extension_point]",
        "ros2cli.command = ros2cli.command:CommandExtension",
        "ros2cli.daemon.verb = ros2cli.verb.daemon:VerbExtension",
        "",
        "[ros2cli.daemon.verb]",
        "start = ros2cli.verb.daemon.start:StartVerb",
        "status = ros2cli.verb.daemon.status:StatusVerb",
        "stop = ros2cli.verb.daemon.stop:StopVerb",
        "",
        "[console_scripts]",
        "ros2 = ros2cli.cli:main",
        "_ros2_daemon = ros2cli.daemon:main",
    ],
)

py_library(
    name = "ros2cli",
    srcs = [
        "ros2cli/__init__.py",
        "ros2cli/cli.py",
        "ros2cli/command/__init__.py",
        "ros2cli/command/daemon.py",
        "ros2cli/command/extension_points.py",
        "ros2cli/command/extensions.py",
        "ros2cli/daemon/__init__.py",
        "ros2cli/daemon/daemonize.py",
        "ros2cli/entry_points.py",
        "ros2cli/helpers.py",
        "ros2cli/node/__init__.py",
        "ros2cli/node/daemon.py",
        "ros2cli/node/direct.py",
        "ros2cli/node/network_aware.py",
        "ros2cli/node/strategy.py",
        "ros2cli/plugin_system.py",
        "ros2cli/qos.py",
        "ros2cli/verb/__init__.py",
        "ros2cli/verb/daemon/__init__.py",
        "ros2cli/verb/daemon/start.py",
        "ros2cli/verb/daemon/status.py",
        "ros2cli/verb/daemon/stop.py",
        "ros2cli/xmlrpc/__init__.py",
        "ros2cli/xmlrpc/client.py",
        "ros2cli/xmlrpc/local_server.py",
        "ros2cli/xmlrpc/marshal/__init__.py",
        "ros2cli/xmlrpc/marshal/generic.py",
        "ros2cli/xmlrpc/marshal/rclpy.py",
    ],
    data = ["ros2cli/py.typed"] + [
        ":ament_index",
        ":entry_points_txt",
        ":pkg_info",
    ],
    imports = ["."],
    deps = [
        "@rclpy",
        requirement("argcomplete"),
        requirement("packaging"),
        requirement("psutil"),
    ],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "colcon.pkg",
        "completion/ros2-argcomplete.bash",
        "completion/ros2-argcomplete.fish",
        "completion/ros2-argcomplete.zsh",
        "package.xml",
        "resource/package.dsv",
        "resource/ros2cli",
        "ros2cli/__init__.py",
        "ros2cli/cli.py",
        "ros2cli/command/__init__.py",
        "ros2cli/command/daemon.py",
        "ros2cli/command/extension_points.py",
        "ros2cli/command/extensions.py",
        "ros2cli/daemon/__init__.py",
        "ros2cli/daemon/daemonize.py",
        "ros2cli/entry_points.py",
        "ros2cli/helpers.py",
        "ros2cli/node/__init__.py",
        "ros2cli/node/daemon.py",
        "ros2cli/node/direct.py",
        "ros2cli/node/network_aware.py",
        "ros2cli/node/strategy.py",
        "ros2cli/plugin_system.py",
        "ros2cli/py.typed",
        "ros2cli/qos.py",
        "ros2cli/verb/__init__.py",
        "ros2cli/verb/daemon/__init__.py",
        "ros2cli/verb/daemon/start.py",
        "ros2cli/verb/daemon/status.py",
        "ros2cli/verb/daemon/stop.py",
        "ros2cli/xmlrpc/__init__.py",
        "ros2cli/xmlrpc/client.py",
        "ros2cli/xmlrpc/local_server.py",
        "ros2cli/xmlrpc/marshal/__init__.py",
        "ros2cli/xmlrpc/marshal/generic.py",
        "ros2cli/xmlrpc/marshal/rclpy.py",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
    "xmllint",
]]

ament_package(
    name = "ament_package",
    console_programs = {
        "_ros2_daemon": "ros2cli.daemon:main",
        "ros2": "ros2cli.cli:main",
    },
    env_hooks = [
        "environment/ros2-argcomplete.bash",
        "environment/ros2-argcomplete.fish",
        "environment/ros2-argcomplete.zsh",
    ],
    package_xml = "package.xml",
    python = [":ros2cli"] + ["ros2cli/py.typed"],
    deps = [
        ":ament_index",
        ":ros2cli",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@rclpy//:ament_package",
        "@rmw_test_fixture_implementation//:ament_package",
        "@rosdistro//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
