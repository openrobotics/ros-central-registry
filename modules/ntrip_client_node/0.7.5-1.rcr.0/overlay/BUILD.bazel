load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:curl": "@rosdistro//cc:curl_library",
}

CC_DEPS = [
    "@@rcl_interfaces+//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rtcm_msgs//:cc",
    "@std_msgs//:cc",
]

cc_library(
    name = "ntrip_client_components_library",
    srcs = ["src/ntrip_client_node.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/ntrip_client_node",
    ],
    local_defines = ros_local_defines() + ["NTRIP_CLIENT_NODE_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ntrip_client_components",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":ntrip_client_components_library"],
)

rclcpp_components_register_node(
    name = "ntrip_client_node",
    component = ":ntrip_client_components",
    node_name = "ntrip_client_node",
    plugin = "ublox_dgnss::NTRIPClientNode",
)

ament_index(
    name = "ament_index",
    components = [":ntrip_client_node_record"],
    lib_data = [":ntrip_client_node"],
    libraries = [":ntrip_client_components"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rtcm_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    libraries = [":ntrip_client_components"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rtcm_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
