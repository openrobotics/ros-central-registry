load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosidl_default_generators//:defs.bzl", "default_generators")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

### PACKAGING

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:ActuatorUniqueIdReq",
        "//msg:AutoZeroCalCmd",
        "//msg:ConfigureOutputsKdFreqDeadbandCmd",
        "//msg:ConfigureOutputsKpKiCmd",
        "//msg:ConfigureOutputsPwmFreqCmd",
        "//msg:EnhancedPositionRpt",
        "//msg:MotorCurrentRpt",
        "//msg:MotorOverCurrentConfigCmd",
        "//msg:PositionCmd",
        "//msg:PositionReachErrorTimeConfigCmd",
        "//msg:PositionRpt",
        "//msg:PriorityConfigCmd",
        "//msg:ReassignCommandIdCmd",
        "//msg:ReassignReportIdCmd",
        "//msg:ReportIndex",
        "//msg:ReportPollReq",
        "//msg:ResetCmd",
        "//msg:ScheduledReportRatesReq",
        "//msg:SoftwareRevisionRpt",
        "//msg:SoftwareVersionReq",
        "//msg:UniqueDeviceIdRpt",
        "//msg:ZeroingMessageRpt",
    ],
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@ros_environment//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
