load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### LIBRARIES

HEADERS = [
    "include/laser_proc/laser_proc.hpp",
    "include/laser_proc/laser_proc_component.hpp",
    "include/laser_proc/laser_publisher.hpp",
    "include/laser_proc/visibility_control.hpp",
]

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

MSG_DEPENDENCIES = [
    "@sensor_msgs//:cc",
]

cc_library(
    name = "laser_proc_library",
    srcs = [
        "src/laser_proc.cpp",
        "src/laser_publisher.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["LASER_PROC_BUILDING_LIBRARY"],
    deps = DEPENDENCIES.values() + MSG_DEPENDENCIES,
)

cc_shared_library(
    name = "laser_proc",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":laser_proc_library"],
)

COMPONENT_DEPENDENCIES = {
    "@class_loader//:class_loader": "@class_loader//:class_loader_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
}

cc_library(
    name = "laser_proc_component_library",
    srcs = ["src/laser_proc_component.cpp"],
    local_defines = ros_local_defines(),
    deps = COMPONENT_DEPENDENCIES.values() + [":laser_proc_library"],
)

cc_shared_library(
    name = "laser_proc_component",
    dynamic_deps = DEPENDENCIES.keys() + COMPONENT_DEPENDENCIES.keys() + [":laser_proc"],
    exports_filter = ["//:__subpackages__"],
    deps = [":laser_proc_component_library"],
)

### COMPONENTS

rclcpp_components_register_node(
    name = "laser_proc_node",
    component = ":laser_proc_component",
    node_name = "laser_proc_node",
    plugin = "laser_proc::LaserProcComponent",
)

### AMENT INDEX

ament_index(
    name = "ament_index",
    components = [":laser_proc_node_record"],
    executables = [":laser_proc_node"],
    libraries = [
        ":laser_proc",
        ":laser_proc_component",
    ],
    package_xml = "package.xml",
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rclcpp",
        "sensor_msgs",
    ],
    cmake_export_targets = False,
    components = [":laser_proc_node_record"],
    executables = [":laser_proc_node"],
    headers = HEADERS,
    include_prefix = "",
    libraries = [
        ":laser_proc",
        ":laser_proc_component",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@class_loader//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
