load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARY

HEADERS = glob([
    "include/**/*.h",
    "include/**/*.hpp",
])

cc_library(
    name = "rosidl_buffer_library",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
)

cc_shared_library(
    name = "rosidl_buffer",
    exports_filter = [":rosidl_buffer_library"],
    deps = [":rosidl_buffer_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rosidl_buffer"],
    visibility = ["//visibility:private"],
)

### TESTING

[
    cc_test(
        name = test,
        srcs = [
            "test/non_cpu_buffer_impl.hpp",
            "test/{}.cpp".format(test),
        ],
        dynamic_deps = [":transitive_dynamic_deps"],
        local_defines = ros_local_defines(),
        deps = [
            ":rosidl_buffer_library",
            "@rosdistro//cc:googletest",
        ],
    )
    for test in [
        "test_buffer",
        "test_c_helpers",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    headers = HEADERS,
    libraries = [":rosidl_buffer"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
