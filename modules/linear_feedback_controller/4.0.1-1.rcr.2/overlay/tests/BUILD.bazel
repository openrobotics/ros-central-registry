cc_test(
    name = "test_lf_controller",
    srcs = ["test_lf_controller.cpp"] + [
        "utils/eigen.hpp",
        "utils/eigen_conversions.hpp",
        "utils/lf_controller.hpp",
        "utils/linear_feedback_controller.hpp",
        "utils/mock_robot_model_builder.hpp",
        "utils/mock_robot_model_builder_smart.hpp",
        "utils/mutation.hpp",
        "utils/pd_controller.hpp",
        "utils/print_to.hpp",
        "utils/robot_model.hpp",
    ] + [
        "//:generated_parameters_gen",
        "//:joint_state_estimator_generated_parameters_gen",
        "//:jrl_headers",
        "//:passthrough_controller_generated_parameters_gen",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "pd_plus_controller.py",
        "pd_plus_controller.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines() + [
        "COAL_HAS_OCTOMAP",
        "COAL_HAVE_OCTOMAP",
        "GTEST_HAS_PTHREAD=1",
        "LINEAR_FEEDBACK_CONTROLLER_IS_SHARED",
        "OCTOMAP_MAJOR_VERSION=1",
        "OCTOMAP_MINOR_VERSION=10",
        "OCTOMAP_PATCH_VERSION=0",
        "PINOCCHIO_ENABLE_TEMPLATE_INSTANTIATION",
        "PINOCCHIO_URDFDOM_HEADERS_MAJOR_VERSION=3",
        "PINOCCHIO_URDFDOM_HEADERS_MINOR_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_PATCH_VERSION=0",
        "PINOCCHIO_WITH_COLLISION",
        "PINOCCHIO_WITH_HPP_FCL",
        "PINOCCHIO_WITH_URDFDOM",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:linear_feedback_controller_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

