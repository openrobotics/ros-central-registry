load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

filegroup(
    name = "package_xml",
    srcs = ["package.xml"],
)

filegroup(
    name = "share_files",
    srcs = glob(["launch/*"]),
)

cc_binary(
    name = "ld08_driver",
    srcs = glob([
        "include/*.hpp",
        "src/*.cpp",
    ]),
    includes = ["include"],
    deps = [
        "@rclcpp//:rclcpp_library",
        "@sensor_msgs//:cc",
    ],
)

genrule(
    name = "export_include_dirs_cmake",
    outs = ["ament_cmake_export_include_directories-extras.cmake"],
    cmd = """cat << 'EOF' > $@
# generated from ament_cmake_export_include_directories/cmake/ament_cmake_export_include_directories-extras.cmake.in

set(_exported_include_dirs "$${ld08_driver_DIR}/../../../include")

# append include directories to ld08_driver_INCLUDE_DIRS
# warn about not existing paths
if(NOT _exported_include_dirs STREQUAL "")
  find_package(ament_cmake_core QUIET REQUIRED)
  foreach(_exported_include_dir $${_exported_include_dirs})
    if(NOT IS_DIRECTORY "$${_exported_include_dir}")
      message(WARNING "Package 'ld08_driver' exports the include directory '$${_exported_include_dir}' which doesn't exist")
    endif()
    normalize_path(_exported_include_dir "$${_exported_include_dir}")
    list(APPEND ld08_driver_INCLUDE_DIRS "$${_exported_include_dir}")
  endforeach()
endif()
EOF
""",
)

ament_index(
    name = "ament_index",
    data = [":share_files"],
    executables = [":ld08_driver"],
    package_xml = ":package_xml",
)

ament_package(
    cmake = [":export_include_dirs_cmake"],
    cmake_extras = ["ament_cmake_export_include_directories-extras.cmake"],
    cmake_strip_prefix = "",
    data = [":share_files"],
    executables = [":ld08_driver"],
    package_xml = ":package_xml",
    deps = [
        "@rclcpp//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
