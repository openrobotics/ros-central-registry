load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@can_msgs//:cc_shared": "@can_msgs//:cc",
    "@diagnostic_msgs//:cc_shared": "@diagnostic_msgs//:cc",
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@ros2_socketcan_msgs//:cc_shared": "@ros2_socketcan_msgs//:cc",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "off_highway_can_library",
    srcs = [
        "src/can_message.cpp",
        "src/crc.cpp",
        "src/receiver.cpp",
        "src/sender.cpp",
    ],
    hdrs = [
        "include/off_highway_can/can_message.hpp",
        "include/off_highway_can/crc.hpp",
        "include/off_highway_can/external/can_encode_decode_inl.h",
        "include/off_highway_can/helper.hpp",
        "include/off_highway_can/impl/can_message_impl.hpp",
        "include/off_highway_can/impl/receiver_impl.hpp",
        "include/off_highway_can/impl/sender_impl.hpp",
        "include/off_highway_can/j1939.hpp",
        "include/off_highway_can/receiver.hpp",
        "include/off_highway_can/sender.hpp",
    ],
    includes = [
        ".",
        "include",
        "include/off_highway_can",
    ],
    local_defines = ros_local_defines() + ["RCLCPP_LOG_MIN_SEVERITY=1"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "off_highway_can",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":off_highway_can_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":off_highway_can"],
)

ament_index(
    name = "ament_index",
    libraries = [":off_highway_can"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@can_msgs//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@rclcpp//:ament_package",
        "@ros2_socketcan_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "can_msgs",
        "diagnostic_updater",
        "rclcpp",
        "ros2_socketcan_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_off_highway_can",
    headers = [
        "include/off_highway_can/can_message.hpp",
        "include/off_highway_can/crc.hpp",
        "include/off_highway_can/external/can_encode_decode_inl.h",
        "include/off_highway_can/helper.hpp",
        "include/off_highway_can/impl/can_message_impl.hpp",
        "include/off_highway_can/impl/receiver_impl.hpp",
        "include/off_highway_can/impl/sender_impl.hpp",
        "include/off_highway_can/j1939.hpp",
        "include/off_highway_can/receiver.hpp",
        "include/off_highway_can/sender.hpp",
    ],
    include_prefix = "",
    libraries = [":off_highway_can"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@can_msgs//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@rclcpp//:ament_package",
        "@ros2_socketcan_msgs//:ament_package",
    ],
)
