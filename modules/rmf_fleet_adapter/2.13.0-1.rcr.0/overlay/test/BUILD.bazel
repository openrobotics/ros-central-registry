load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@backward_ros//:backward": "@backward_ros//:backward_library",
    "@nlohmann_json_schema_validator_vendor//:nlohmann_json_schema_validator": "@nlohmann_json_schema_validator_vendor//:nlohmann_json_schema_validator_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
}

CC_DEPS = [
    "@builtin_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rmf_api_msgs//:rmf_api_msgs",
    "@rmf_battery//:rmf_battery_library",
    "@rmf_building_map_msgs//:cc",
    "@rmf_dispenser_msgs//:cc",
    "@rmf_door_msgs//:cc",
    "@rmf_fleet_msgs//:cc",
    "@rmf_ingestor_msgs//:cc",
    "@rmf_lift_msgs//:cc",
    "@rmf_reservation_msgs//:cc",
    "@rmf_task//:rmf_task_library",
    "@rmf_task_msgs//:cc",
    "@rmf_task_ros2//:rmf_task_ros2_library",
    "@rmf_task_sequence//:rmf_task_sequence_library",
    "@rmf_traffic//:rmf_traffic_library",
    "@rmf_traffic_ros2//:rmf_traffic_ros2_library",
    "@rmf_utils//:rmf_utils_library",
    "@rmf_websocket//:rmf_websocket_library",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:nlohmann_json",
    "@std_msgs//:cc",
]

# Also built as the installed lib/rmf_fleet_adapter/test_read_only_adapter
# executable in the root package (upstream add_executable).
exports_files(["test_read_only_adapter.cpp"])

cc_test(
    name = "test_rmf_fleet_adapter",
    srcs = [
        "main.cpp",
        "mock/MockRobotCommand.hpp",
        "phases/MockAdapterFixture.cpp",
        "phases/MockAdapterFixture.hpp",
        "phases/test_DispenseItem.cpp",
        "phases/test_DoorClose.cpp",
        "phases/test_DoorOpen.cpp",
        "phases/test_IngestItem.cpp",
        "phases/test_RequestLift.cpp",
        "services/test_FindEmergencyPullover.cpp",
        "services/test_FindPath.cpp",
        "services/test_Negotiate.cpp",
        "tasks/test_Delivery.cpp",
        "tasks/test_Loop.cpp",
        "test_Task.cpp",
        "thread_cooldown.hpp",
    ],
    # Exclude "Scenario: Emergency Pullover" due to hardcoded 1s future wait timeout under Catch2
    args = ["~Scenario: Emergency Pullover"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
        "-include",
        "iterator",
    ],
    data = ["//:ament_index"] + [
        "README.md",
        "resources/office_nav.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ['TEST_RESOURCES_DIR=\\"../rmf_fleet_adapter+/test/resources/\\"'],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:rmf_fleet_adapter_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
