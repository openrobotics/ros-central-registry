load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "fleet_adapter.launch.xml",
        "robot_state_aggregator.composition.launch.xml",
        "robot_state_aggregator.launch.xml",
    ],
)

launch_ros_binary(
    name = "fleet_adapter_launch_xml",
    src = "fleet_adapter.launch.xml",
    deps = [
        "//:full_control",
        "//:mock_traffic_light",
        "//:read_only",
        "//:read_only_blockade",
    ],
)

launch_ros_binary(
    name = "robot_state_aggregator_composition_launch_xml",
    src = "robot_state_aggregator.composition.launch.xml",
    deps = ["//:robot_state_aggregator"],
)

launch_ros_binary(
    name = "robot_state_aggregator_launch_xml",
    src = "robot_state_aggregator.launch.xml",
    deps = [
        ":robot_state_aggregator_composition_launch_xml",
        "//:robot_state_aggregator",
    ],
)
