load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_binary(
    name = "test_huge_joint_space_jump.py",
    srcs = ["scripts/test_huge_joint_space_jump.py"],
    data = [":ament_index"],
    main = "scripts/test_huge_joint_space_jump.py",
    deps = [
        "@rclpy",
        "@ros_gz_bridge//:ros_gz_bridge_py",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "config/servo.yaml",
        "config/test_huge_joint_space_jump_config.yaml",
        "config/test_trajectory_goal_publishers_config.yaml",
        "//launch:launch_files",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_index_python//:ament_package",
        "@controller_manager//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@joint_state_publisher//:ament_package",
        "@joint_trajectory_controller//:ament_package",
        "@kortex_description//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@parallel_gripper_controller//:ament_package",
        "@rclpy//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@robotiq_description//:ament_package",
        "@ros_gz_bridge//:ament_package",
        "@ros_gz_sim//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
        "@urdf//:ament_package",
        "@xacro//:ament_package",
    ],
)

ament_package(
    name = "ament_package",
    executables = [":test_huge_joint_space_jump.py"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_index_python//:ament_package",
        "@controller_manager//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@joint_state_publisher//:ament_package",
        "@joint_trajectory_controller//:ament_package",
        "@kortex_description//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@parallel_gripper_controller//:ament_package",
        "@rclpy//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@robotiq_description//:ament_package",
        "@ros_gz_bridge//:ament_package",
        "@ros_gz_sim//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
        "@urdf//:ament_package",
        "@xacro//:ament_package",
    ],
)
