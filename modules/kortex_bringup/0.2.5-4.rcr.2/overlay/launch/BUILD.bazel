load("@launch_ros//:defs.bzl", "launch_ros_binary")

launch_ros_binary(
    name = "gen3_launch_py",
    src = "gen3.launch.py",
    data = [":kortex_control_launch_py"],
)

launch_ros_binary(
    name = "gen3_lite_launch_py",
    src = "gen3_lite.launch.py",
    data = [":kortex_control_launch_py"],
)

launch_ros_binary(
    name = "kortex_control_launch_py",
    src = "kortex_control.launch.py",
    data = [
        "@controller_manager//:ament_index",
        "@robot_state_publisher//:ament_index",
        "@rviz2//:ament_index",
        "@xacro//:ament_index",
    ],
)

launch_ros_binary(
    name = "kortex_sim_control_launch_py",
    src = "kortex_sim_control.launch.py",
    data = [
        "@controller_manager//:ament_index",
        "@robot_state_publisher//:ament_index",
        "@robotiq_description//:ament_index",
        "@ros_gz_bridge//:ament_index",
        "@ros_gz_sim//:ament_index",
        "@ros_gz_sim//launch:gz_sim_launch",
        "@rviz2//:ament_index",
        "@xacro//:ament_index",
    ],
    deps = ["@ros_gz_sim//launch:gz_sim_launch"],
)

launch_ros_binary(
    name = "test_huge_joint_space_jump_launch_py",
    src = "test_huge_joint_space_jump.launch.py",
)

launch_ros_binary(
    name = "test_joint_trajectory_controller_launch_py",
    src = "test_joint_trajectory_controller.launch.py",
)
