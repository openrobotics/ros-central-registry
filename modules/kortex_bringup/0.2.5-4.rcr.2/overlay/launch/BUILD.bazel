load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "gen3.launch.py",
        "gen3_lite.launch.py",
        "kortex_control.launch.py",
        "kortex_sim_control.launch.py",
        "test_huge_joint_space_jump.launch.py",
        "test_joint_trajectory_controller.launch.py",
    ],
)

launch_ros_binary(
    name = "gen3_launch_py",
    src = "gen3.launch.py",
    deps = [":kortex_control_launch_py"],
)

launch_ros_binary(
    name = "gen3_lite_launch_py",
    src = "gen3_lite.launch.py",
    deps = [":kortex_control_launch_py"],
)

launch_ros_binary(
    name = "kortex_control_launch_py",
    src = "kortex_control.launch.py",
    data = ["//:ament_index"],
    deps = [
        "@controller_manager//:ros2_control_node",
        "@controller_manager//:spawner",
        "@robot_state_publisher",
        "@rviz2",
        "@xacro",
    ],
)

launch_ros_binary(
    name = "kortex_sim_control_launch_py",
    src = "kortex_sim_control.launch.py",
    data = ["//:ament_index"],
    deps = [
        "@ament_index_python",
        "@controller_manager//:spawner",
        "@robot_state_publisher",
        "@ros_gz_bridge//:parameter_bridge",
        "@ros_gz_sim//:create",
        "@ros_gz_sim//launch:gz_sim_launch",
        "@rviz2",
        "@xacro",
    ],
)

launch_ros_binary(
    name = "test_huge_joint_space_jump_launch_py",
    src = "test_huge_joint_space_jump.launch.py",
    deps = ["//:test_huge_joint_space_jump.py"],
)

launch_ros_binary(
    name = "test_joint_trajectory_controller_launch_py",
    src = "test_joint_trajectory_controller.launch.py",
    data = ["//:ament_index"],
)
