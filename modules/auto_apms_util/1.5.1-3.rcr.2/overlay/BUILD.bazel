    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

CC_DEPS = [
    "@action_msgs//:cc",
    "@auto_apms_interfaces//:cc",
    "@generate_parameter_library//:generate_parameter_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
]

cc_library(
    name = "auto_apms_util_library",
    srcs = [
        "src/action_wrapper.cpp",
        "src/filesystem.cpp",
        "src/logging.cpp",
        "src/resource.cpp",
        "src/string.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ) + [
        ":gen_extra_3",
        ":gen_extra_4",
    ],
    copts = ["-std=c++20"],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/auto_apms_util",
        "include",
        "include/auto_apms_util",
    ],
    local_defines = ros_local_defines() + [
        "_AUTO_APMS_UTIL__ACTION_PARAM_FEEDBACK_RATE=\\\"feedback_rate\\\"",
        "_AUTO_APMS_UTIL__ACTION_PARAM_LOOP_RATE=\\\"loop_rate\\\"",
        "_AUTO_APMS_UTIL__RESOURCE_TYPE_NAME__PLUGINLIB=\\\"auto_apms_util__pluginlib__plugins\\\"",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "auto_apms_util",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":auto_apms_util_library"],
    deps = [":auto_apms_util_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

py_library(
    name = "auto_apms_util_py",
    srcs = glob(["auto_apms_util/**/*.py"]),
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@auto_apms_interfaces//:py",
    ],
)

