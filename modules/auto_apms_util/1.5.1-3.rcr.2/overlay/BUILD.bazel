load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines", "ros_version_header")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@generate_parameter_library//:rclcpp_lifecycle": "@generate_parameter_library//:rclcpp_lifecycle_library",
    "@generate_parameter_library//:rsl": "@generate_parameter_library//:rsl_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

CC_DEPS = [
    "@action_msgs//:cc",
    "@auto_apms_interfaces//:cc",
    "@generate_parameter_library//:generate_parameter_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
]

cc_library(
    name = "auto_apms_util_library",
    srcs = [
        "src/action_wrapper.cpp",
        "src/filesystem.cpp",
        "src/logging.cpp",
        "src/resource.cpp",
        "src/string.cpp",
    ],
    hdrs = [
        "include/auto_apms_util/action_client_wrapper.hpp",
        "include/auto_apms_util/action_context.hpp",
        "include/auto_apms_util/action_wrapper.hpp",
        "include/auto_apms_util/container.hpp",
        "include/auto_apms_util/exceptions.hpp",
        "include/auto_apms_util/filesystem.hpp",
        "include/auto_apms_util/logging.hpp",
        "include/auto_apms_util/resource.hpp",
        "include/auto_apms_util/string.hpp",
        "include/auto_apms_util/yaml.hpp",
    ] + [
        ":action_wrapper_params_gen",
        ":version_header",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/auto_apms_util",
        "include",
        "include/auto_apms_util",
    ],
    local_defines = ros_local_defines() + [
        '_AUTO_APMS_UTIL__ACTION_PARAM_FEEDBACK_RATE=\\"feedback_rate\\"',
        '_AUTO_APMS_UTIL__ACTION_PARAM_LOOP_RATE=\\"loop_rate\\"',
        '_AUTO_APMS_UTIL__RESOURCE_TYPE_NAME__PLUGINLIB=\\"auto_apms_util__pluginlib__plugins\\"',
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "auto_apms_util",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":auto_apms_util_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":auto_apms_util"],
)

py_library(
    name = "auto_apms_util_py",
    srcs = [
        "auto_apms_util/__init__.py",
        "auto_apms_util/resources.py",
    ],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@auto_apms_interfaces//:py",
    ],
)

cmake_configure_file(
    name = "action_wrapper_params_yaml",
    src = "config/action_wrapper_params.yaml.in",
    out = "action_wrapper_params.yaml",
    defines = [
        "_AUTO_APMS_UTIL__ACTION_PARAM_LOOP_RATE=loop_rate",
        "_AUTO_APMS_UTIL__ACTION_PARAM_FEEDBACK_RATE=feedback_rate",
    ],
)

generate_parameter_library(
    name = "action_wrapper_params",
    yaml_file = ":action_wrapper_params_yaml",
)

ros_version_header(
    name = "version_header",
    out = "_gen/include/auto_apms_util/auto_apms_util/version.hpp",
)

ament_index(
    name = "ament_index",
    data = ["//launch:launch_files"],
    libraries = [":auto_apms_util"],
    package_xml = "package.xml",
    deps = [
        "@action_msgs//:ament_package",
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_index_python//:ament_package",
        "@auto_apms_interfaces//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rcpputils//:ament_package",
        "@yaml_cpp_vendor//:ament_package",
    ],
)

ament_package(
    cmake = [
        "cmake/register_plugins.cmake",
        "cmake/register_plugins_hook.cmake",
    ],
    cmake_export_dependencies_list = [
        "ament_index_cpp",
        "fmt",
        "pluginlib",
        "rclcpp",
        "rclcpp_action",
        "rclcpp_lifecycle",
        "rcpputils",
        "rsl",
        "tcb_span",
        "tl-expected",
        "yaml-cpp",
        "yaml_cpp_vendor",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_auto_apms_util",
    cmake_extras = ["auto_apms_util-extras.cmake"],
    headers = [
        "include/auto_apms_util/action_client_wrapper.hpp",
        "include/auto_apms_util/action_context.hpp",
        "include/auto_apms_util/action_wrapper.hpp",
        ":action_wrapper_params_gen",
        ":version_header",
        "include/auto_apms_util/container.hpp",
        "include/auto_apms_util/exceptions.hpp",
        "include/auto_apms_util/filesystem.hpp",
        "include/auto_apms_util/logging.hpp",
        "include/auto_apms_util/resource.hpp",
        "include/auto_apms_util/string.hpp",
        "include/auto_apms_util/yaml.hpp",
    ],
    include_prefix = "",
    libraries = [":auto_apms_util"],
    package_xml = "package.xml",
    python = [":auto_apms_util_py"],
    deps = [":ament_index"] + [
        "@action_msgs//:ament_package",
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_index_python//:ament_package",
        "@auto_apms_interfaces//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rcpputils//:ament_package",
        "@yaml_cpp_vendor//:ament_package",
    ],
)
