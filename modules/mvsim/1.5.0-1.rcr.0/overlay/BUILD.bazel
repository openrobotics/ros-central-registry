cc_library(
    name = "box2d_library",
    srcs = [":gen_mvsim_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_atomic_shared_ptr_shim_hpp",
        ":gen_gl_h",
        ":gen_glfw3_h",
        ":gen_glu_h",
        ":gen_mvsim_protos_hdrs",
        ":gen_tbb_blocked_range2d_h",
        ":gen_tbb_blocked_range_h",
        ":gen_tbb_global_control_h",
        ":gen_tbb_parallel_for_each_h",
        ":gen_tbb_parallel_for_h",
        ":gen_tbb_parallel_reduce_h",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
        "-include",
        "atomic_shared_ptr_shim.hpp",
    ],
    includes = [
        "_gen/include",
        "_gen/include/mvsim",
        "externals/box2d/include",
        "externals/box2d/src",
        "externals/rapidxml",
        "modules/comms/include",
        "modules/comms/src",
        "modules/raytracer/include",
        "modules/raytracer/src",
        "modules/simulator/include",
        "modules/simulator/src",
        "mvsim_node_src/include",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

