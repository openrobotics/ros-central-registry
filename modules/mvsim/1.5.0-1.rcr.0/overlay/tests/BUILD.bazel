cc_test(
    name = "run_test_dataset_gen_e2e",
    srcs = [
        "test_dataset_gen_e2e.cpp",
        "test_utils.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        "//:ament_index",
        "//:pymvsim_comms.cpython-314-x86_64-linux-gnu",
    ] + [
        "CMakeLists.txt",
        "test-still-lidar2d.py",
        "test-still-lidar2d.world.xml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines() + [
        'MVSIM_DATASET_GEN_EXE_PATH=\\"lib/mvsim/mvsim-dataset-gen\\"',
        "MVSIM_HAS_PROTOBUF",
        "MVSIM_HAS_ROS",
        "MVSIM_HAS_ZMQ",
        'MVSIM_TEST_DIR=\\"tests\\"',
        'MVSIM_TUTORIAL_DIR=\\"tests/../mvsim_tutorial\\"',
        "NDEBUG",
    ],
    # xfail: fails under Bazel: 21 test(s) FAILED.
    tags = [
        "manual",
        "xfail",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:box2d_library",
        "//:mvsim-comms_library",
        "//:mvsim-msgs_library",
        "//:mvsim-simulator_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

