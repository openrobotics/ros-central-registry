load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosgraph_msgs//:cc_shared": "@rosgraph_msgs//:cc",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:static_transform_broadcaster_node": "@tf2_ros//:static_transform_broadcaster_node_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "laser_simulator_library",
    srcs = ["src/laser_simulator.cpp"],
    hdrs = [
        "include/mobile_robot_simulator/laser_simulator.h",
        "include/mobile_robot_simulator/mobile_robot_simulator.h",
    ],
    includes = [
        "include",
        "include/mobile_robot_simulator",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "laser_simulator",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":laser_simulator_library"],
)

cc_library(
    name = "mobile_robot_simulator_library",
    srcs = ["src/mobile_robot_simulator.cpp"],
    hdrs = [
        "include/mobile_robot_simulator/laser_simulator.h",
        "include/mobile_robot_simulator/mobile_robot_simulator.h",
    ],
    includes = [
        "include",
        "include/mobile_robot_simulator",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mobile_robot_simulator",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mobile_robot_simulator_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":laser_simulator",
        ":mobile_robot_simulator",
    ],
)

cc_binary(
    name = "laser_scanner_simulator_node",
    srcs = ["src/laser_simulator_node.cpp"],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/mobile_robot_simulator",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":laser_simulator_library"],
)

cc_binary(
    name = "mobile_robot_simulator_node",
    srcs = ["src/mobile_robot_simulator_node.cpp"],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/mobile_robot_simulator",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":mobile_robot_simulator_library"],
)

ament_index(
    name = "ament_index",
    data = ["//launch:launch_files"],
    libraries = [
        ":laser_simulator",
        ":mobile_robot_simulator",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch_ros//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rosgraph_msgs//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "geometry_msgs",
        "nav_msgs",
        "rclcpp",
        "rosgraph_msgs",
        "tf2_ros",
        "sensor_msgs",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    executables = [
        ":laser_scanner_simulator_node",
        ":mobile_robot_simulator_node",
    ],
    libraries = [
        ":laser_simulator",
        ":mobile_robot_simulator",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch_ros//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rosgraph_msgs//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
