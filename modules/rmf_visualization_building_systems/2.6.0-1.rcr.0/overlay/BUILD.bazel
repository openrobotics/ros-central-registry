load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            "CHANGELOG.rst",
            "package.xml",
            "resource/rmf_visualization_building_systems",
            "rmf_visualization_building_systems/__init__.py",
            "rmf_visualization_building_systems/rmf_visualization_building_systems.py",
            "setup.cfg",
            "setup.py",
            "test/test_copyright.py",
            "test/test_flake8.py",
            "test/test_pep257.py",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
    ]
]

py_library(
    name = "rmf_visualization_building_systems",
    srcs = [
        "rmf_visualization_building_systems/__init__.py",
        "rmf_visualization_building_systems/rmf_visualization_building_systems.py",
    ],
    imports = ["."],
    deps = [
        "@geometry_msgs//:py",
        "@rmf_building_map_msgs//:py",
        "@rmf_door_msgs//:py",
        "@rmf_lift_msgs//:py",
        "@rmf_visualization_msgs//:py",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"rmf_visualization_building_systems": "rmf_visualization_building_systems.rmf_visualization_building_systems:main"},
    executables = ["resource/rmf_visualization_building_systems"],
    package_xml = "package.xml",
    python = [":rmf_visualization_building_systems"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rmf_building_map_msgs//:ament_package",
        "@rmf_door_msgs//:ament_package",
        "@rmf_lift_msgs//:ament_package",
        "@rmf_visualization_msgs//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
