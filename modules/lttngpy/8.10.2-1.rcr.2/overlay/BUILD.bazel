load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

# TODO(asymingt): LTTNGPY_DISABLED is enabled until liblttng-ctl is packaged in rosdistro.
cmake_configure_file(
    name = "config_hpp",
    src = "src/lttngpy/config.hpp.in",
    out = "src/lttngpy/config.hpp",
    defines = [
        "LTTNGPY_DISABLED=1",
        "LTTNG_CTL_VERSION=",
        "LTTNG_CTL_VERSION_MAJOR=0",
        "LTTNG_CTL_VERSION_MINOR=0",
        "LTTNG_CTL_VERSION_PATCH=0",
    ],
)

cc_library(
    name = "_lttngpy_pybind11_library",
    srcs = [
        "src/lttngpy/_lttngpy_pybind11.cpp",
        "src/lttngpy/status.cpp",
    ],
    hdrs = glob(["src/lttngpy/*.hpp"]) + [":config_hpp"],
    includes = ["src"],
    deps = [
        "@rosdistro//cc:pybind11",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_shared_library(
    name = "_lttngpy_pybind11",
    exports_filter = [":_lttngpy_pybind11_library"],
    shared_lib_name = "lttngpy/_lttngpy_pybind11.so",
    deps = [":_lttngpy_pybind11_library"],
)

py_library(
    name = "lttngpy",
    srcs = glob(["lttngpy/**/*.py"]),
    data = [":_lttngpy_pybind11"],
    imports = ["."],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    package_xml = "package.xml",
    python = [
        ":lttngpy",
        ":_lttngpy_pybind11",
    ],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
        "@rpyutils//:ament_package",
    ],
)
