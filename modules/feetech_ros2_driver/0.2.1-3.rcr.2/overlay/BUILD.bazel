cc_library(
    name = "serial_port_library",
    srcs = [":gen_feetech_ros2_driver_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "feetech_driver/include",
        "include",
        "include/feetech_ros2_driver",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "serial_port",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
