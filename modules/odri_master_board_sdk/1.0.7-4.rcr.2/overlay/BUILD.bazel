    content = ["/*\n * This file has been automatically generated by the jrl-cmakemodules.\n * Please see https://github.com/jrl-umi3218/jrl-cmakemodules/blob/master/deprecated.hh.cmake for details.\n*/\n\n#ifndef ODRI_MASTER_BOARD_SDK_DEPRECATED_HH\n# define ODRI_MASTER_BOARD_SDK_DEPRECATED_HH\n\n// Define a suffix which can be used to tag a type, a function or a a\n// variable as deprecated (i.e. it will emit a warning when using it).\n//\n// Tagging a function as deprecated:\n//  void foo () ODRI_MASTER_BOARD_SDK_DEPRECATED;\n//\n// Tagging a type as deprecated:\n//  class Foo {};\n//  typedef Foo Bar ODRI_MASTER_BOARD_SDK_DEPRECATED;\n//\n// Tagging a variable as deprecated:\n//  int a ODRI_MASTER_BOARD_SDK_DEPRECATED = 0;\n//\n// The use of a macro is required as this is /not/ a standardized\n// feature of C++ language or preprocessor, even if most of the\n// compilers support it.\n# if defined(__cplusplus) && (__cplusplus >= 201402L)\n#  define ODRI_MASTER_BOARD_SDK_DEPRECATED [[deprecated]]\n#  define ODRI_MASTER_BOARD_SDK_DEPRECATED_MESSAGE(message) [[deprecated(#message)]]\n# elif defined(__GNUC__) || defined(__clang__)\n#  define ODRI_MASTER_BOARD_SDK_DEPRECATED __attribute__ ((deprecated))\n#  define ODRI_MASTER_BOARD_SDK_DEPRECATED_MESSAGE(message) __attribute__ (( deprecated(#message) ))\n# else\n#  if defined(_MSC_VER) && !defined(__INTEL_COMPILER)\n#   define ODRI_MASTER_BOARD_SDK_DEPRECATED __declspec (deprecated)\n#   define ODRI_MASTER_BOARD_SDK_DEPRECATED_MESSAGE(message) __declspec ( deprecated(#message) )\n#  else\n// If the compiler is not recognized, drop the feature.\n#   define ODRI_MASTER_BOARD_SDK_DEPRECATED /* nothing */\n#   define ODRI_MASTER_BOARD_SDK_DEPRECATED_MESSAGE(message)\n#  endif // __MSVC__\n# endif // __cplusplus\n\n# if defined(__GNUC__) || defined(__clang__)\n#  ifndef ODRI_MASTER_BOARD_SDK_PRAGMA\n#   define ODRI_MASTER_BOARD_SDK_PRAGMA(X) _Pragma(#X)\n#  endif\n#  define ODRI_MASTER_BOARD_SDK_DEPRECATED_HEADER(MSG) ODRI_MASTER_BOARD_SDK_PRAGMA(GCC warning MSG)\n# elif defined(_MSC_VER) && !defined(__INTEL_COMPILER)\n#  define ODRI_MASTER_BOARD_SDK_STRINGIZE_(MSG) #MSG\n#  define ODRI_MASTER_BOARD_SDK_STRINGIZE(MSG) ODRI_MASTER_BOARD_SDK_STRINGIZE_(MSG)\n#  define ODRI_MASTER_BOARD_SDK_DEPRECATED_HEADER(MSG) \\\n    __pragma(message(__FILE__ \"(\" ODRI_MASTER_BOARD_SDK_STRINGIZE(__LINE__) \") : Warning: \" MSG))\n# else\n#  define ODRI_MASTER_BOARD_SDK_DEPRECATED_HEADER(MSG)\n# endif\n\n#endif //! ODRI_MASTER_BOARD_SDK_DEPRECATED_HH\n"],
