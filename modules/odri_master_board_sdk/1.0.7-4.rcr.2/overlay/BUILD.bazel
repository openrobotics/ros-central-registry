http://gcc.gnu.org/wiki/Visibility\n//\n// Explicit template instantiation on Windows need to add\n// dllexport on the definition and dllimport on the declaration.\n// The XXX_EXPLICIT_INSTANTIATION_DECLARATION_DLLAPI macro\n// should be set on the declaration while\n// the XXX_EXPLICIT_INSTANTIATION_DEFINITION_DLLAPI macro\n// should be set on the definition.\n# if defined _WIN32 || defined __CYGWIN__\n// On Microsoft Windows, use dllimport and dllexport to tag symbols.\n#  define ODRI_MASTER_BOARD_SDK_DLLIMPORT __declspec(dllimport)\n#  define ODRI_MASTER_BOARD_SDK_DLLEXPORT __declspec(dllexport)\n#  define ODRI_MASTER_BOARD_SDK_DLLLOCAL\n#  define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT __declspec(dllimport)\n#  define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT\n#  define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT __declspec(dllimport)\n#  define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT __declspec(dllexport)\n# else\n// On Linux, for GCC >= 4, tag symbols using GCC extension.\n#  if __GNUC__ >= 4\n#   define ODRI_MASTER_BOARD_SDK_DLLIMPORT __attribute__ ((visibility(\"default\")))\n#   define ODRI_MASTER_BOARD_SDK_DLLEXPORT __attribute__ ((visibility(\"default\")))\n#   define ODRI_MASTER_BOARD_SDK_DLLLOCAL  __attribute__ ((visibility(\"hidden\")))\n#   define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT __attribute__ ((visibility(\"default\")))\n#   define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT __attribute__ ((visibility(\"default\")))\n#   define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT\n#   define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT\n#  else\n// Otherwise (GCC < 4 or another compiler is used), export everything.\n#   define ODRI_MASTER_BOARD_SDK_DLLIMPORT\n#   define ODRI_MASTER_BOARD_SDK_DLLEXPORT\n#   define ODRI_MASTER_BOARD_SDK_DLLLOCAL\n#   define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT\n#   define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT\n#   define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT\n#   define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT\n#  endif // __GNUC__ >= 4\n# endif // defined _WIN32 || defined __CYGWIN__\n\n# ifdef ODRI_MASTER_BOARD_SDK_STATIC\n// If one is using the library statically, get rid of\n// extra information and use standard explicit template\n// instantiation keyword.\n#  define ODRI_MASTER_BOARD_SDK_DLLAPI\n#  define ODRI_MASTER_BOARD_SDK_LOCAL\n#  define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DECLARATION extern template\n# else\n// Depending on whether one is building or using the\n// library define DLLAPI to import or export and\n// define the right explicit template instantiation keyword.\n#  ifdef odri_master_board_sdk_EXPORTS\n#   define ODRI_MASTER_BOARD_SDK_DLLAPI ODRI_MASTER_BOARD_SDK_DLLEXPORT\n#   define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DECLARATION_DLLAPI ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT\n#   define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DEFINITION_DLLAPI ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT\n#  else\n#   define ODRI_MASTER_BOARD_SDK_DLLAPI ODRI_MASTER_BOARD_SDK_DLLIMPORT\n#   define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DECLARATION_DLLAPI ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT\n#   define ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DEFINITION_DLLAPI ODRI_MASTER_BOARD_SDK_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT\n#  endif // ODRI_MASTER_BOARD_SDK_EXPORTS\n#  define ODRI_MASTER_BOARD_SDK_LOCAL ODRI_MASTER_BOARD_SDK_DLLLOCAL\n# endif // ODRI_MASTER_BOARD_SDK_STATIC\n#endif //! ODRI_MASTER_BOARD_SDK_CONFIG_HH\n"],
