MASTER_BOARD_SDK_PRAGMA(GCC warning MSG)\n# elif defined(_MSC_VER) && !defined(__INTEL_COMPILER)\n#  define ODRI_MASTER_BOARD_SDK_STRINGIZE_(MSG) #MSG\n#  define ODRI_MASTER_BOARD_SDK_STRINGIZE(MSG) ODRI_MASTER_BOARD_SDK_STRINGIZE_(MSG)\n#  define ODRI_MASTER_BOARD_SDK_DEPRECATED_HEADER(MSG) \\\n    __pragma(message(__FILE__ \"(\" ODRI_MASTER_BOARD_SDK_STRINGIZE(__LINE__) \") : Warning: \" MSG))\n# else\n#  define ODRI_MASTER_BOARD_SDK_DEPRECATED_HEADER(MSG)\n# endif\n\n#endif //! ODRI_MASTER_BOARD_SDK_DEPRECATED_HH\n"],
