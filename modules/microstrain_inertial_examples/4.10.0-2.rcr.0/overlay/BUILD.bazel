load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

ament_index(
    name = "ament_index",
    data = ["//launch:launch_files"] + [
        "config/cv7/cv7.yml",
        "config/cv7/display.rviz",
        "config/cv7_gnss_ins/cv7_gnss_ins.yml",
        "config/cv7_gnss_ins/display.rviz",
        "config/cv7_ins/cv7_ins.yml",
        "config/cv7_ins/display.rviz",
        "config/cv7_ins_nmea_aux/cv7_ins.yml",
        "config/cv7_ins_nmea_aux/display.rviz",
        "config/gq7/display.rviz",
        "config/gq7/gq7.yml",
        "config/gx5_15/display.rviz",
        "config/gx5_15/gx5_15.yml",
        "config/gx5_25/display.rviz",
        "config/gx5_25/gx5_25.yml",
        "config/gx5_45/display.rviz",
        "config/gx5_45/gx5_45.yml",
    ],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@microstrain_inertial_driver//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
        "@rviz_imu_plugin//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
