load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = [
        "launch/cv7_gnss_ins_launch.py",
        "launch/cv7_ins_launch.py",
        "launch/cv7_ins_nmea_aux_launch.py",
        "launch/cv7_launch.py",
        "launch/gq7_launch.py",
        "launch/gx5_15_launch.py",
        "launch/gx5_25_launch.py",
        "launch/gx5_45_launch.py",
    ] + glob(["config/**"]),
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@microstrain_inertial_driver//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
        "@rviz_imu_plugin//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
