load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
}

cc_library(
    name = "image_geometry_library",
    srcs = [
        "src/pinhole_camera_model.cpp",
        "src/stereo_camera_model.cpp",
    ],
    hdrs = [
        "include/image_geometry/pinhole_camera_model.hpp",
        "include/image_geometry/stereo_camera_model.hpp",
        "include/image_geometry/visibility_control.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + ["@sensor_msgs//:cc"],
)

cc_shared_library(
    name = "image_geometry",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":image_geometry_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":image_geometry"],
)

py_library(
    name = "image_geometry_py",
    srcs = [
        "image_geometry/__init__.py",
        "image_geometry/cameramodels.py",
    ],
    imports = ["."],
    deps = ["@sensor_msgs//:py"],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "OpenCV",
        "sensor_msgs",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_image_geometry",
    headers = [
        "include/image_geometry/pinhole_camera_model.hpp",
        "include/image_geometry/stereo_camera_model.hpp",
        "include/image_geometry/visibility_control.hpp",
    ],
    libraries = [":image_geometry"],
    package_xml = "package.xml",
    python = [":image_geometry_py"],
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
