load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {"@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library"}

cc_test(
    name = "image_geometry-utest",
    srcs = ["utest.cpp"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        "//:image_geometry_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "image_geometry-utest-equi",
    srcs = ["utest_equi.cpp"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        "//:image_geometry_library",
        "@rosdistro//cc:googletest",
    ],
)

py_pytest(
    name = "test_directed",
    srcs = ["directed.py"],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [
        "//:image_geometry_py",
        requirement("deprecated"),
        requirement("opencv-python"),
    ],
)
