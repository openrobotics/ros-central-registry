load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.h"])

# Upstream builds the same sources as both rotconvstatic and rotconvshared;
# only rotconvshared is installed/exported.
cc_library(
    name = "rotconvshared_library",
    srcs = [
        "src/rot_conv.cpp",
        "src/rot_conv_extras.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    deps = [
        "@rosdistro//cc:eigen",
    ],
)

cc_shared_library(
    name = "rotconvshared",
    exports_filter = [":rotconvshared_library"],
    deps = [":rotconvshared_library"],
)

alias(
    name = "rot_conv",
    actual = ":rotconvshared",
)

### EXECUTABLES

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rotconvshared"],
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "rot_conv_sample_shared",
    srcs = ["test/rot_conv_sample.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":rotconvshared_library"],
)

### TESTS

cc_test(
    name = "test_rot_conv",
    srcs = ["test/test_rot_conv.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":rotconvshared_library",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "eigen3_cmake_module",
        "Eigen3",
    ],
    cmake_export_targets = False,
    headers = HEADERS,
    include_prefix = "",
    libraries = [":rotconvshared"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
