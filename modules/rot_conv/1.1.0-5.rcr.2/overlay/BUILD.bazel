load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = [
    "include/rot_conv/rot_conv.h",
    "include/rot_conv/rot_conv_extras.h",
    "include/rot_conv/rot_conv_frames.h",
    "include/rot_conv/rot_conv_impl.h",
]

cc_library(
    name = "rotconvshared_library",
    srcs = [
        "src/rot_conv.cpp",
        "src/rot_conv_extras.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    deps = ["@rosdistro//cc:eigen"],
)

cc_shared_library(
    name = "rotconvshared",
    exports_filter = ["//:__subpackages__"],
    deps = [":rotconvshared_library"],
)

alias(
    name = "rot_conv",
    actual = ":rotconvshared",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rotconvshared"],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "Eigen3",
        "eigen3_cmake_module",
    ],
    cmake_export_targets = False,
    headers = HEADERS,
    include_prefix = "",
    libraries = [":rotconvshared"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
