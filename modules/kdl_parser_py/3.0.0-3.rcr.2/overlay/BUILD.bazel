load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            ".travis.yml",
            "CHANGELOG.rst",
            "CONTRIBUTING.md",
            "LICENSE",
            "README.md",
            "kdl_parser_py/__init__.py",
            "kdl_parser_py/urdf.py",
            "package.xml",
            "resource/kdl_parser_py",
            "setup.cfg",
            "setup.py",
            "test/test.urdf",
            "test/test_copyright.py",
            "test/test_flake8.py",
            "test/test_kdl_parser.py",
            "test/test_pep257.py",
            "test/test_xmllint.py",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

py_library(
    name = "kdl_parser_py",
    srcs = [
        "kdl_parser_py/__init__.py",
        "kdl_parser_py/urdf.py",
    ],
    imports = ["."],
    deps = [
        "@urdfdom_py",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":kdl_parser_py"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@python_orocos_kdl_vendor//:ament_package",
        "@rosdistro//:ament_package",
        "@urdfdom_py//:ament_package",
    ],
)
