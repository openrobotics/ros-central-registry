cc_library(
    name = "nav2_util_core_library",
    srcs = [
        "src/array_parser.cpp",
        "src/controller_utils.cpp",
        "src/costmap.cpp",
        "src/lifecycle_service_client.cpp",
        "src/odometry_utils.cpp",
        "src/path_utils.cpp",
        "src/robot_utils.cpp",
        "src/string_utils.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/nav2_util",
        "src",
        "test",
        "test/regression",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "nav2_util_core",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":nav2_util_core_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
