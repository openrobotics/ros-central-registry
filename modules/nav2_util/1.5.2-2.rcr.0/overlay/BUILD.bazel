    "@tf2_msgs//:cc_shared": "@tf2_msgs//:cc",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@angles//:angles",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "nav2_util_core_library",
    srcs = [
        "src/array_parser.cpp",
        "src/controller_utils.cpp",
        "src/costmap.cpp",
        "src/lifecycle_service_client.cpp",
        "src/odometry_utils.cpp",
        "src/path_utils.cpp",
        "src/robot_utils.cpp",
        "src/string_utils.cpp",
    ],
    hdrs = [
        "include/nav2_util/array_parser.hpp",
        "include/nav2_util/controller_utils.hpp",
        "include/nav2_util/costmap.hpp",
        "include/nav2_util/execution_timer.hpp",
        "include/nav2_util/geometry_utils.hpp",
        "include/nav2_util/lifecycle_service_client.hpp",
        "include/nav2_util/line_iterator.hpp",
        "include/nav2_util/occ_grid_utils.hpp",
        "include/nav2_util/occ_grid_values.hpp",
        "include/nav2_util/odometry_utils.hpp",
        "include/nav2_util/parameter_handler.hpp",
        "include/nav2_util/path_utils.hpp",
        "include/nav2_util/raytrace_line_2d.hpp",
        "include/nav2_util/robot_utils.hpp",
        "include/nav2_util/smoother_utils.hpp",
        "include/nav2_util/string_utils.hpp",
        "include/nav2_util/twist_publisher.hpp",
        "include/nav2_util/twist_subscriber.hpp",
        "src/base_footprint_publisher.hpp",
    ],
    includes = [
        "include",
        "include/nav2_util",
        "src",
        "test",
        "test/regression",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "nav2_util_core",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":nav2_util_core_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":nav2_util_core"],
)

cc_binary(
    name = "lifecycle_bringup",
    srcs = ["src/lifecycle_bringup_commandline.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/nav2_util",
        "src",
        "test",
        "test/regression",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":nav2_util_core_library"],
)

ament_index(
    name = "ament_index",
    lib_data = [":lifecycle_bringup"],
    libraries = [":nav2_util_core"],
    package_xml = "package.xml",
    deps = [
