load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

HEADERS = glob(["include/**/*.hpp"])

cc_library(
    name = "sound_play",
    hdrs = HEADERS,
    includes = ["include"],
    deps = [
        "@rclcpp//:rclcpp_library",
        "@sound_play_msgs//:cc",
    ],
)

py_library(
    name = "sound_play_py",
    srcs = glob(["sound_play/**/*.py"]),
    imports = ["."],
    deps = [
        "@action_msgs//:py",
        "@ament_index_python",
        "@rclpy",
        "@sound_play_msgs//:py",
    ],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = ["@rclcpp//:rclcpp"],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "sound_play_test",
    srcs = ["test/sound_play_mock_test.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":sound_play",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rosidl_default_runtime",
        "sound_play_msgs",
    ],
    cmake_export_targets = False,
    data = glob([
        "launch/**",
        "sounds/**",
    ]),
    executables = [
        "scripts/is_speaking.py",
        "scripts/play.py",
        "scripts/playbuiltin.py",
        "scripts/say.py",
        "scripts/shutup.py",
        "scripts/soundplay_node.py",
    ],
    headers = HEADERS,
    include_prefix = "",
    package_xml = "package.xml",
    python = [":sound_play_py"],
    deps = [
        "@action_msgs//:ament_package",
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_index_python//:ament_package",
        "@launch_xml//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sound_play_msgs//:ament_package",
    ],
)
