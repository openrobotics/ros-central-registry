load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = ["include/sound_play/sound_play.hpp"]

cc_library(
    name = "sound_play",
    hdrs = HEADERS,
    includes = ["include"],
    deps = [
        "@rclcpp//:rclcpp_library",
        "@sound_play_msgs//:cc",
    ],
)

py_library(
    name = "sound_play_py",
    srcs = [
        "sound_play/__init__.py",
        "sound_play/libsoundplay.py",
    ],
    imports = ["."],
    deps = [
        "@action_msgs//:py",
        "@ament_index_python",
        "@rclpy",
        "@sound_play_msgs//:py",
    ],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = ["@rclcpp//:rclcpp"],
)

ament_index(
    name = "ament_index",
    data = [
        "sounds/BACKINGUP.ogg",
        "sounds/NEEDS_PLUGGING.ogg",
        "sounds/NEEDS_PLUGGING_BADLY.ogg",
        "sounds/NEEDS_UNPLUGGING.ogg",
        "sounds/NEEDS_UNPLUGGING_BADLY.ogg",
        "sounds/say-beep.wav",
    ] + ["//launch:launch_files"],
    executables = [
        "scripts/is_speaking.py",
        "scripts/play.py",
        "scripts/playbuiltin.py",
        "scripts/say.py",
        "scripts/shutup.py",
        "scripts/soundplay_node.py",
    ],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rosidl_default_runtime",
        "sound_play_msgs",
    ],
    cmake_export_targets = False,
    headers = HEADERS,
    include_prefix = "",
    package_xml = "package.xml",
    python = [":sound_play_py"],
    deps = [":ament_index"] + [
        "@action_msgs//:ament_package",
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_index_python//:ament_package",
        "@launch_xml//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sound_play_msgs//:ament_package",
    ],
)
