load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

pkg_files(
    name = "stripped_share",
    srcs = glob(["launch/**"]),
    prefix = "share/rmf_visualization",
    strip_prefix = strip_prefix.from_pkg("launch"),
)

### PACKAGING

ament_package(
    name = "ament_package",
    install = [":stripped_share"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@launch_xml//:ament_package",
        "@rmf_visualization_building_systems//:ament_package",
        "@rmf_visualization_fleet_states//:ament_package",
        "@rmf_visualization_floorplans//:ament_package",
        "@rmf_visualization_navgraphs//:ament_package",
        "@rmf_visualization_obstacles//:ament_package",
        "@rmf_visualization_rviz2_plugins//:ament_package",
        "@rmf_visualization_schedule//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
