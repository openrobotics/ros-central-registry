load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = ["visualization.launch.xml"],
)

launch_ros_binary(
    name = "visualization_launch_xml",
    src = "visualization.launch.xml",
    data = ["//:ament_index"],
    deps = [
        "@rmf_visualization_building_systems//:lib/rmf_visualization_building_systems",
        "@rmf_visualization_fleet_states//:fleetstates_visualizer_node",
        "@rmf_visualization_floorplans//:floorplan_visualizer_node",
        "@rmf_visualization_navgraphs//:navgraph_visualizer_node",
        "@rmf_visualization_obstacles//:obstacle_visualizer_node",
        "@rmf_visualization_schedule//:schedule_visualizer_node",
        "@rviz2",
    ],
)
