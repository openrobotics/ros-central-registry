+#if defined(__APPLE__)
+constexpr double kExpectedRateScale = 0.65;
+#else
+constexpr double kExpectedRateScale = 1.0;
+#endif
+
 TEST( TfBuffer, namespaceValidation )
 {
   TfBuffer buffer;
@@ -481,7 +490,7 @@
 
