load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = [
    "include/image_rotate/image_flip.hpp",
    "include/image_rotate/image_rotate_node.hpp",
    "include/image_rotate/visibility.h",
]

DEPENDENCIES = {
    "@class_loader//:class_loader": "@class_loader//:class_loader_library",
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@rcl_interfaces//:cc_shared": "@rcl_interfaces//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

cc_library(
    name = "image_rotate_library",
    srcs = ["src/image_rotate_node.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "image_rotate",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":image_rotate_library"],
)

cc_library(
    name = "image_flip_library",
    srcs = ["src/image_flip.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "image_flip",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":image_flip_library"],
)

rclcpp_components_register_node(
    name = "node_image_rotate",
    component = ":image_rotate",
    node_name = "image_rotate_node",
    plugin = "image_rotate::ImageRotateNode",
)

rclcpp_components_register_node(
    name = "image_flip_node",
    component = ":image_flip",
    data = [":ament_index"],
    node_name = "image_flip_node",
    plugin = "image_rotate::ImageFlipNode",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":image_rotate",
        ":image_flip",
    ],
)

cc_binary(
    name = "image_rotate_bin",
    srcs = ["src/image_rotate.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [":image_rotate_library"],
)

genrule(
    name = "image_rotate_exe",
    srcs = [":image_rotate_bin"],
    outs = ["bin/image_rotate"],
    cmd = "cp $< $@ && chmod +x $@",
    executable = True,
)

ament_index(
    name = "ament_index",
    components = [
        ":node_image_rotate_record",
        ":image_flip_node_record",
    ],
    data = ["//launch:launch_files"],
    export_name = "image_rotate",
    lib_data = [":image_rotate_exe"],
    libraries = [
        ":image_rotate",
        ":image_flip",
    ],
    package_xml = "package.xml",
    plugin_category = "rclcpp_components",
    deps = [
        "@image_transport//:ament_index_package",
        "@image_transport//:ament_index_plugin",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_targets = False,
    executables = [
        ":image_rotate_exe",
        ":image_flip_node",
    ],
    headers = HEADERS,
    libraries = [
        ":image_rotate",
        ":image_flip",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@class_loader//:ament_package",
        "@cv_bridge//:ament_package",
        "@geometry_msgs//:ament_package",
        "@image_transport//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
