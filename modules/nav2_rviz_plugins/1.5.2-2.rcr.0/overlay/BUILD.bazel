        "include/nav2_rviz_plugins/route_tool.hpp",
        "include/nav2_rviz_plugins/selector.hpp",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "nav2_rviz_plugins",
    dynamic_deps = DEPENDENCIES.keys() + [
        "@qtbase//:concurrent_shared",
        "@qtbase//:widgets_shared",
        "@qtscxml//:statemachine_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":nav2_rviz_plugins_library"],
)

