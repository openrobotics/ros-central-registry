qt_cc_library(
    name = "nav2_rviz_plugins_library",
    srcs = [
        "src/costmap_cost_tool.cpp",
        "src/docking_panel.cpp",
        "src/goal_tool.cpp",
        "src/nav2_panel.cpp",
        "src/particle_cloud_display/flat_weighted_arrows_array.cpp",
        "src/particle_cloud_display/particle_cloud_display.cpp",
        "src/route_tool.cpp",
