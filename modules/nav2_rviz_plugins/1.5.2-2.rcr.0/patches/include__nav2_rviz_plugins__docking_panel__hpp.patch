--- a/include/nav2_rviz_plugins/docking_panel.hpp
+++ b/include/nav2_rviz_plugins/docking_panel.hpp
@@ -172,11 +172,20 @@
 
   void run() override
   {
+    // Stop polling once the context is shut down (e.g. Ctrl-C before docking
+    // became available), so the thread finishes and nothing downstream tries to
+    // use the dead context.
     while (!dock_active_) {
+      if (!rclcpp::ok()) {
+        return;
+      }
       dock_active_ = dock_client_->wait_for_action_server(std::chrono::seconds(1));
     }
 
     while (!undock_active_) {
+      if (!rclcpp::ok()) {
+        return;
+      }
       undock_active_ = undock_client_->wait_for_action_server(std::chrono::seconds(1));
     }
 
