load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

cc_test(
    name = "test_memory_tools",
    srcs = ["memory_tools/test_memory_tools.cpp"],
    dynamic_deps = ["//:memory_tools_interpose"],
    deps = [
        "//:memory_tools",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_parse_environment_variable",
    srcs = [
        "test_runner/test_parse_environment_variable.cpp",
        "//:src/test_runner/parse_environment_variable.hpp",
    ],
    deps = ["@rosdistro//cc:googletest"],
)

cc_binary(
    name = "assert_env_vars",
    srcs = [
        "test_runner/assert_env_vars.cpp",
        "//:src/test_runner/get_environment_variable.hpp",
        "//:src/test_runner/parse_environment_variable.hpp",
        "//:src/test_runner/starts_with.hpp",
    ],
    deps = ["@rosdistro//cc:googletest"],
)

genrule(
    name = "generate_script",
    outs = ["autogenerated_script.sh"],
    cmd = "\necho '#!/bin/bash\nset -euo pipefail\n$${TEST_SRCDIR}/osrf_testing_tools_cpp+/test_runner --env FOO=bar PING=pong --append-env FOO=baz -- $${TEST_SRCDIR}/osrf_testing_tools_cpp+/test/assert_env_vars --env FOO=bar:baz PING=pong' > $@\n",
    tools = [
        ":assert_env_vars",
        "//:test_runner",
    ],
)
