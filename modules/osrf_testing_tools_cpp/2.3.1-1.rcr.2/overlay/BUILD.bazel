load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

exports_files([
    "src/test_runner/get_environment_variable.hpp",
    "src/test_runner/parse_environment_variable.hpp",
    "src/test_runner/starts_with.hpp",
])

cc_library(
    name = "memory_tools_core",
    srcs = [
        "src/memory_tools/count_function_occurrences_in_backtrace.hpp",
        "src/memory_tools/custom_memory_functions.cpp",
        "src/memory_tools/custom_memory_functions.hpp",
        "src/memory_tools/dispatch_callback.hpp",
        "src/memory_tools/implementation_monitoring_override.cpp",
        "src/memory_tools/implementation_monitoring_override.hpp",
        "src/memory_tools/initialize.cpp",
        "src/memory_tools/memory_tools.cpp",
        "src/memory_tools/memory_tools_service.cpp",
        "src/memory_tools/memory_tools_service_factory.hpp",
        "src/memory_tools/memory_tools_service_impl.hpp",
        "src/memory_tools/monitoring.cpp",
        "src/memory_tools/print_backtrace.hpp",
        "src/memory_tools/register_hooks.cpp",
        "src/memory_tools/safe_fwrite.hpp",
        "src/memory_tools/stack_trace.cpp",
        "src/memory_tools/stack_trace_impl.hpp",
        "src/memory_tools/test_lib.cpp",
        "src/memory_tools/testing_helpers.cpp",
        "src/memory_tools/vendor/bombela/backward-cpp/backward.cpp",
        "src/memory_tools/vendor/bombela/backward-cpp/backward.hpp",
        "src/memory_tools/verbosity.cpp",
    ],
    hdrs = [
        "include/osrf_testing_tools_cpp/demangle.hpp",
        "include/osrf_testing_tools_cpp/macros.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/gtest_quickstart.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/initialize.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/is_working.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/memory_tools.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/memory_tools_service.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/monitoring.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/register_hooks.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/stack_trace.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/testing_helpers.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/verbosity.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/visibility_control.hpp",
        "include/osrf_testing_tools_cpp/scope_exit.hpp",
    ] + [
        "src/memory_tools/impl/apple.cpp",
        "src/memory_tools/impl/linux.cpp",
        "src/memory_tools/impl/static_allocator.hpp",
        "src/memory_tools/impl/unix_common.cpp",
        "src/memory_tools/impl/unix_common.hpp",
        "src/memory_tools/impl/unsupported_os.cpp",
    ],
    includes = [
        "include",
        "src",
    ],
    linkopts = select({
        "@platforms//os:windows": ["-ldbghelp"],
        "//conditions:default": [],
    }),
    local_defines = ["OSRF_TESTING_TOOLS_CPP_MEMORY_TOOLS_BUILDING_DLL"],
)

cc_library(
    name = "memory_tools",
    srcs = ["src/memory_tools/is_working.cpp"],
    local_defines = ["OSRF_TESTING_TOOLS_CPP_MEMORY_TOOLS_BUILDING_DLL"],
    deps = [":memory_tools_core"],
)

cc_shared_library(
    name = "memory_tools_interpose",
    exports_filter = [":memory_tools_core"],
    deps = [":memory_tools_core"],
)

cc_binary(
    name = "test_runner",
    srcs = [
        "src/test_runner/execute_process.hpp",
        "src/test_runner/get_environment_variable.hpp",
        "src/test_runner/main.cpp",
        "src/test_runner/parse_environment_variable.hpp",
        "src/test_runner/starts_with.hpp",
    ],
)

sh_test(
    name = "test_test_runner",
    size = "small",
    srcs = ["//test:autogenerated_script.sh"],
    data = [
        ":test_runner",
        "//test:assert_env_vars",
    ],
)

cc_shared_library(
    name = "memory_tools_shared",
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "libmemory_tools.so",
    deps = [":memory_tools"],
)

[write_file(
    name = "cmake_" + f.replace(".", "_").replace("-", "_"),
    out = "cmake/" + f,
    content = [""],
) for f in [
    "memory_toolsExport-noconfig.cmake",
    "memory_toolsExport.cmake",
    "memory_tools_interposeExport-noconfig.cmake",
    "memory_tools_interposeExport.cmake",
    "osrf_testing_tools_cppConfig.cmake",
    "osrf_testing_tools_cppConfigVersion.cmake",
    "test_runnerExport-noconfig.cmake",
    "test_runnerExport.cmake",
]]

ament_package(
    name = "ament_package",
    build_type = "cmake",
    cmake = [
        "cmake/osrf_testing_tools_cpp_add_test.cmake",
        "cmake/osrf_testing_tools_cpp_extract_and_build_googletest.cmake",
        "cmake/osrf_testing_tools_cpp_get_googletest_versions.cmake",
        "cmake/osrf_testing_tools_cpp_require_googletest.cmake",
    ] + [
        ":cmake_memory_toolsExport_cmake",
        ":cmake_memory_toolsExport_noconfig_cmake",
        ":cmake_memory_tools_interposeExport_cmake",
        ":cmake_memory_tools_interposeExport_noconfig_cmake",
        ":cmake_osrf_testing_tools_cppConfigVersion_cmake",
        ":cmake_osrf_testing_tools_cppConfig_cmake",
        ":cmake_test_runnerExport_cmake",
        ":cmake_test_runnerExport_noconfig_cmake",
    ],
    data = [
        "vendor/google/googletest/googletest-external-project-add.cmake.in",
        "vendor/google/googletest/release-1.14.0.tar.gz",
    ],
    executables = [":test_runner"],
    headers = [
        "include/osrf_testing_tools_cpp/demangle.hpp",
        "include/osrf_testing_tools_cpp/macros.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/gtest_quickstart.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/initialize.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/is_working.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/memory_tools.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/memory_tools_service.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/monitoring.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/register_hooks.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/stack_trace.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/testing_helpers.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/verbosity.hpp",
        "include/osrf_testing_tools_cpp/memory_tools/visibility_control.hpp",
        "include/osrf_testing_tools_cpp/scope_exit.hpp",
    ],
    include_prefix = "",
    libraries = [
        ":memory_tools_shared",
        ":memory_tools_interpose",
    ],
    package_xml = "package.xml",
    deps = ["@rosdistro//:ament_package"],
)
