load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

cc_library(
    name = "memory_tools",
    srcs = [
        "src/memory_tools/count_function_occurrences_in_backtrace.hpp",
        "src/memory_tools/custom_memory_functions.cpp",
        "src/memory_tools/custom_memory_functions.hpp",
        "src/memory_tools/dispatch_callback.hpp",
        "src/memory_tools/implementation_monitoring_override.cpp",
        "src/memory_tools/implementation_monitoring_override.hpp",
        "src/memory_tools/initialize.cpp",
        "src/memory_tools/is_working.cpp",
        "src/memory_tools/memory_tools.cpp",
        "src/memory_tools/memory_tools_service.cpp",
        "src/memory_tools/memory_tools_service_factory.hpp",
        "src/memory_tools/memory_tools_service_impl.hpp",
        "src/memory_tools/monitoring.cpp",
        "src/memory_tools/print_backtrace.hpp",
        "src/memory_tools/register_hooks.cpp",
        "src/memory_tools/safe_fwrite.hpp",
        "src/memory_tools/stack_trace.cpp",
        "src/memory_tools/stack_trace_impl.hpp",
        "src/memory_tools/test_lib.cpp",
        "src/memory_tools/testing_helpers.cpp",
        "src/memory_tools/vendor/bombela/backward-cpp/backward.cpp",
        "src/memory_tools/vendor/bombela/backward-cpp/backward.hpp",
        "src/memory_tools/verbosity.cpp",
    ],
    hdrs = glob(["include/**/*.hpp"]) + [
        "src/memory_tools/impl/apple.cpp",
        "src/memory_tools/impl/linux.cpp",
        "src/memory_tools/impl/static_allocator.hpp",
        "src/memory_tools/impl/unix_common.cpp",
        "src/memory_tools/impl/unix_common.hpp",
        "src/memory_tools/impl/unsupported_os.cpp",
    ],
    includes = [
        "include",
        "src",
    ],
    # The vendored backward-cpp (vendor/bombela/backward-cpp/backward.cpp)
    # has a real Windows stack-unwinding backend using DbgHelp.dll's
    # Sym*/StackWalk64 APIs, it's just never linked against dbghelp.
    linkopts = select({
        "@platforms//os:windows": ["-ldbghelp"],
        "//conditions:default": [],
    }),
    # memory_tools' public API is gated on the OSRF_TESTING_TOOLS_CPP_MEMORY_TOOLS
    # _BUILDING_DLL macro (its visibility_control.hpp), so define it while
    # compiling this library to dllexport the symbols on Windows; consumers omit
    # it and get dllimport.
    local_defines = ["OSRF_TESTING_TOOLS_CPP_MEMORY_TOOLS_BUILDING_DLL"],
)

# Built as a genuine shared library (rather than a cc_library baked directly
# into each consuming cc_test) so it can be injected via DYLD_INSERT_LIBRARIES
# on Darwin. Apple's __DATA,__interpose mechanism only reliably intercepts
# malloc/realloc/calloc/free calls made from *other* loaded images (e.g. a
# dependency's own .dylib) when the interposing code is loaded as an early
# dylib; a copy statically linked into the test binary only interposes calls
# made directly from that binary.
#
# Consumers must reach this via dynamic_deps (not deps) so they share this
# exact loaded instance of :memory_tools -- otherwise the interposed
# malloc/free calls increment counters in this dylib's copy of memory_tools'
# global state while the consumer reads its own separately-linked copy,
# which never moves off zero.
cc_shared_library(
    name = "memory_tools_interpose",
    exports_filter = [":memory_tools"],
    deps = [":memory_tools"],
)

cc_test(
    name = "test_memory_tools",
    srcs = ["test/memory_tools/test_memory_tools.cpp"],
    # Reach memory_tools through the interpose shared library (per the comment
    # above) rather than statically: on Windows the test TU sees the public API
    # as dllimport, so the symbols must come from memory_tools_interpose.dll's
    # import library; a static :memory_tools in deps leaves them undefined.
    dynamic_deps = [":memory_tools_interpose"],
    deps = [
        ":memory_tools",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_parse_environment_variable",
    srcs = [
        "src/test_runner/parse_environment_variable.hpp",
        "test/test_runner/test_parse_environment_variable.cpp",
    ],
    deps = ["@rosdistro//cc:googletest"],
)

cc_binary(
    name = "test_runner",
    srcs = glob([
        "src/test_runner/*.hpp",
        "src/test_runner/*.cpp",
    ]),
)

cc_binary(
    name = "assert_env_vars",
    srcs = [
        "src/test_runner/get_environment_variable.hpp",
        "src/test_runner/parse_environment_variable.hpp",
        "src/test_runner/starts_with.hpp",
        "test/test_runner/assert_env_vars.cpp",
    ],
    deps = [
        "@rosdistro//cc:googletest",
    ],
)

genrule(
    name = "generate_script",
    outs = ["autogenerated_script.sh"],
    cmd = """
echo '#!/bin/bash
set -euo pipefail
$${TEST_SRCDIR}/osrf_testing_tools_cpp+/test_runner --env FOO=bar PING=pong --append-env FOO=baz -- \
$${TEST_SRCDIR}/osrf_testing_tools_cpp+/assert_env_vars --env FOO=bar:baz PING=pong' > $(location :autogenerated_script.sh)
""",
    tools = [
        ":assert_env_vars",
        ":test_runner",
    ],
)

sh_test(
    name = "test_test_runner",
    size = "small",
    srcs = [":autogenerated_script.sh"],
    data = [
        ":assert_env_vars",
        ":test_runner",
    ],
)

### PACKAGING

# Upstream installs memory_tools both as a regular shared library
# (libmemory_tools.so) and as the DYLD_INSERT_LIBRARIES-friendly interpose
# library above; this is the former, built from the same objects.
cc_shared_library(
    name = "memory_tools_shared",
    exports_filter = [":memory_tools"],
    shared_lib_name = "libmemory_tools.so",
    deps = [":memory_tools"],
)

[
    write_file(
        name = "cmake_" + f.replace(".", "_").replace("-", "_"),
        out = "cmake/" + f,
        content = [""],
    )
    for f in [
        "memory_toolsExport-noconfig.cmake",
        "memory_toolsExport.cmake",
        "memory_tools_interposeExport-noconfig.cmake",
        "memory_tools_interposeExport.cmake",
        "osrf_testing_tools_cppConfig.cmake",
        "osrf_testing_tools_cppConfigVersion.cmake",
        "test_runnerExport-noconfig.cmake",
        "test_runnerExport.cmake",
    ]
]

ament_package(
    name = "ament_package",
    build_type = "cmake",
    cmake = glob(["cmake/**"]) + [
        ":cmake_memory_toolsExport_cmake",
        ":cmake_memory_toolsExport_noconfig_cmake",
        ":cmake_memory_tools_interposeExport_cmake",
        ":cmake_memory_tools_interposeExport_noconfig_cmake",
        ":cmake_osrf_testing_tools_cppConfigVersion_cmake",
        ":cmake_osrf_testing_tools_cppConfig_cmake",
        ":cmake_test_runnerExport_cmake",
        ":cmake_test_runnerExport_noconfig_cmake",
    ],
    data = glob(["vendor/**"]),
    executables = [":test_runner"],
    headers = glob(["include/**"]),
    include_prefix = "",
    libraries = [
        ":memory_tools_shared",
        ":memory_tools_interpose",
    ],
    package_xml = "package.xml",
    deps = [
        "@rosdistro//:ament_package",
    ],
)
