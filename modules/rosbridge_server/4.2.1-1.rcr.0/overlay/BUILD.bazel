load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "rosbridge_server",
    srcs = [
        "src/rosbridge_server/__init__.py",
        "src/rosbridge_server/client_manager.py",
        "src/rosbridge_server/websocket_handler.py",
    ],
    imports = ["src"],
    deps = [
        "@rcl_interfaces//:py",
        "@rclpy",
        "@rosapi",
        "@rosbridge_library",
        "@rosbridge_msgs//:py",
        "@std_msgs//:py",
    ],
)

ament_index(
    name = "ament_index",
    data = ["//launch:launch_files"],
    executables = [
        "scripts/rosbridge_websocket",
        "scripts/rosbridge_websocket.py",
    ],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":rosbridge_server"],
    python_strip_prefix = "src",
    deps = [":ament_index"] + [
        "@action_msgs//:ament_package",
        "@ament_cmake_mypy//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@example_interfaces//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosapi//:ament_package",
        "@rosbridge_library//:ament_package",
        "@rosbridge_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
