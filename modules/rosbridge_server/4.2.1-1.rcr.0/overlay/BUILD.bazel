load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

py_library(
    name = "rosbridge_server",
    srcs = glob(["src/rosbridge_server/**/*.py"]),
    imports = ["src"],
    deps = [
        "@rcl_interfaces//:py",
        "@rclpy",
        "@rosapi",
        "@rosbridge_library",
        "@rosbridge_msgs//:py",
        "@std_msgs//:py",
    ],
)

py_pytest(
    name = "test_stress_clients",
    srcs = ["test/test_stress_clients.py"],
    tags = ["manual"],
    deps = [
        ":rosbridge_server",
    ],
)

launch_ros_test(
    name = "test_websocket_event_loop_starvation.test.py",
    src = "test/websocket/common.py",
    data = [
        "test/websocket/event_loop_starvation.test.py",
        "test/websocket/starvation_load_publisher.py",
        ":ament_index",
    ],
    tags = ["manual"],
    deps = [":rosbridge_server"],
)

