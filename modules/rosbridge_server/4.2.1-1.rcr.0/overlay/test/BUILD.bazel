load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

py_pytest(
    name = "test_stress_clients",
    srcs = ["test_stress_clients.py"],
    tags = ["manual"],
    deps = ["//:rosbridge_server"],
)

launch_ros_test(
    name = "test_websocket_event_loop_starvation_test",
    src = "websocket/common.py",
    data = [
        "websocket/event_loop_starvation.test.py",
        "websocket/starvation_load_publisher.py",
        "//:ament_index",
    ],
    tags = ["manual"],
    deps = [
        "//:rosbridge_server",
        "@launch//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
    ],
)

