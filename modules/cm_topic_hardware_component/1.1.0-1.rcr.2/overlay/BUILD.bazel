load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@ros2_control_test_assets//:ros2_control_test_assets",
    "@hardware_interface//:hardware_interface_library",
    "@pal_statistics_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:fmt",
]

cc_library(
    name = "cm_topic_hardware_component_library",
    srcs = ["src/cm_topic_hardware_component.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/cm_topic_hardware_component",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "cm_topic_hardware_component",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":cm_topic_hardware_component_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    libraries = [
        ":cm_topic_hardware_component",
    ],
    package_xml = "package.xml",
    plugin_category = "hardware_interface",
    plugins = ["cm_topic_hardware_component_plugin_description.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@hardware_interface//:ament_package",
        "@pal_statistics_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@ros2_control_test_assets//:ament_package",
    ],
)

cc_test(
    name = "cm_topic_hardware_component_test",
    srcs = ["test/cm_topic_hardware_component_test.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/cm_topic_hardware_component",
    ],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":cm_topic_hardware_component_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "hardware_interface",
        "pal_statistics_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "cm_topic_hardware_componentTargets",
    libraries = [
        ":cm_topic_hardware_component",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@hardware_interface//:ament_package",
        "@pal_statistics_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@ros2_control_test_assets//:ament_package",
    ],
)
