load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

cc_test(
    name = "benchmark_malloc_realloc",
    timeout = "moderate",
    srcs = [
        "benchmark/benchmark_malloc_realloc.cpp",
        "benchmark/macros.h",
    ],
    tags = ["manual"],
    deps = [
        "//:performance_test_fixture",
