cc_library(
    name = "dwb_critics_library",
    srcs = [
        "src/alignment_util.cpp",
        "src/base_obstacle.cpp",
        "src/goal_align.cpp",
        "src/goal_dist.cpp",
        "src/map_grid.cpp",
        "src/obstacle_footprint.cpp",
        "src/oscillation.cpp",
        "src/path_align.cpp",
        "src/path_dist.cpp",
        "src/prefer_forward.cpp",
        "src/rotate_to_goal.cpp",
        "src/twirling.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/dwb_critics",
        "test",
    ],
    local_defines = ros_local_defines() + [
        "BTCPP_LIBRARY_VERSION=\\\"4.10.0\\\"",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "dwb_critics",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":dwb_critics_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":dwb_critics"],
)

ament_index(
    name = "ament_index",
    libraries = [":dwb_critics"],
    package_xml = "package.xml",
    plugin_category = "dwb_core",
    plugins = ["default_critics.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@angles//:ament_package",
        "@backward_ros//:ament_package",
        "@costmap_queue//:ament_package",
        "@dwb_core//:ament_package",
        "@dwb_msgs//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav2_common//:ament_package",
        "@nav2_costmap_2d//:ament_package",
        "@nav2_ros_common//:ament_package",
        "@nav2_util//:ament_package",
        "@nav_2d_msgs//:ament_package",
        "@nav_2d_utils//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
    ],
)

