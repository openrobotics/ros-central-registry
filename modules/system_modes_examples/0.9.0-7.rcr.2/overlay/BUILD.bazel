load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        "@lifecycle_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_lifecycle//:rclcpp_lifecycle",
    ],
)

# add_executable(drive_base ...) / add_executable(manipulator ...)
[cc_binary(
    name = name,
    srcs = ["src/{0}.cpp".format(name)],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = [
        "@lifecycle_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    ],
) for name in [
    "drive_base",
    "manipulator",
]]

ament_index(
    name = "ament_index",
    data = [
        "example_modes.yaml",
        "launch/drive_base.launch.py",
        "launch/example_system.launch.py",
        "launch/example_system_start_drive_base.launch.py",
        "launch/example_system_started.launch.py",
        "launch/manipulator.launch.py",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_flake8//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pep257//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@launch//:ament_package",
        "@launch_system_modes//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2launch//:ament_package",
        "@system_modes//:ament_package",
        "@system_modes_msgs//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    colcon_hooks = False,
    executables = [
        ":drive_base",
        ":manipulator",
    ],
    install_package_xml = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_flake8//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pep257//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@launch//:ament_package",
        "@launch_system_modes//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2launch//:ament_package",
        "@system_modes//:ament_package",
        "@system_modes_msgs//:ament_package",
    ],
)

[launch_ros_binary(
    name = "launch_{0}_launch_py".format(name),
    src = "launch/{0}.launch.py".format(name),
    data = [":ament_index"],
    deps = [":" + name],
) for name in [
    "drive_base",
    "manipulator",
]]

launch_ros_binary(
    name = "launch_example_system_launch_py",
    src = "launch/example_system.launch.py",
    data = [":ament_index"],
    deps = [
        ":launch_drive_base_launch_py",
        ":launch_manipulator_launch_py",
        "@system_modes//launch:mode_manager_launch",
    ],
)

[launch_ros_binary(
    name = "launch_{0}_launch_py".format(name),
    src = "launch/{0}.launch.py".format(name),
    data = [":ament_index"],
    deps = [
        ":drive_base",
        ":manipulator",
        "@launch_system_modes",
        "@system_modes//launch:mode_manager_launch",
    ],
) for name in [
    "example_system_start_drive_base",
    "example_system_started",
]]
