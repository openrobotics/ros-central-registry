load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "bno055_launch.py",
        "heading_control_launch.py",
    ],
)

launch_ros_binary(
    name = "bno055_launch",
    src = "bno055_launch.py",
    data = [
        "//:ament_index",
        "//:bno055_lifecycle_publisher_node",
        "//:bno055_publisher_node",
        "@rclcpp_components//:ament_index",
    ],
    deps = ["@ament_index_python"],
)

launch_ros_binary(
    name = "heading_control_launch",
    src = "heading_control_launch.py",
    data = [
        "//:ament_index",
        "//:bno055_heading_control_components",
        "//:bno055_heading_control_node",
        "//:bno055_lifecycle_heading_control_node",
        "//:bno055_lifecycle_publisher_node",
        "//:bno055_publisher_node",
        "//:bno055_publisher_node_container",
        "@rclcpp_components//:ament_index",
        "@rclcpp_components//:component_container_mt",
    ],
    deps = ["@ament_index_python"],
)
