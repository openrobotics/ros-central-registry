load("@rosdistro//ament:defs.bzl", "ament_package", "register_ament_resource")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

exports_files([
    "aspects.bzl",
    "defs.bzl",
    "types.bzl",
])

# These are the templates used for per-message header and source generation.
filegroup(
    name = "interface_templates",
    srcs = [
        "resource/action__builder.hpp.em",
        "resource/action__struct.hpp.em",
        "resource/action__traits.hpp.em",
        "resource/action__type_support.hpp.em",
        "resource/idl.hpp.em",
        "resource/idl__builder.hpp.em",
        "resource/idl__struct.hpp.em",
        "resource/idl__traits.hpp.em",
        "resource/idl__type_support.hpp.em",
        "resource/msg__builder.hpp.em",
        "resource/msg__struct.hpp.em",
        "resource/msg__traits.hpp.em",
        "resource/msg__type_support.hpp.em",
        "resource/srv__builder.hpp.em",
        "resource/srv__struct.hpp.em",
        "resource/srv__traits.hpp.em",
        "resource/srv__type_support.hpp.em",
    ],
)

# Template used for per-package visibility header generation.
filegroup(
    name = "visibility_control_template",
    srcs = ["resource/rosidl_generator_cpp__visibility_control.hpp.in"],
)

# The runtime library the generated C++ bindings call into, re-exported so
# rosidl_core_generators (which does not depend on rosidl_runtime_cpp
# itself) can link interface packages against it.
alias(
    name = "runtime_library",
    actual = "@rosidl_runtime_cpp//:rosidl_runtime_cpp_library",
)

alias(
    name = "runtime_dynamic_deps",
    actual = "@rosidl_runtime_cpp//:transitive_dynamic_deps",
)

# This is the python library that does the bulk of the work for converting
# the .msg, .srv, .action files to the generic .idl representation.
py_library(
    name = "rosidl_generator_cpp",
    srcs = [
        "rosidl_generator_cpp/__init__.py",
        "rosidl_generator_cpp/cli.py",
    ],
    deps = [
        "@ament_index_python",
        "@rosidl_cli",
        "@rosidl_generator_c",
        "@rosidl_generator_type_description",
        "@rosidl_parser",
        "@rosidl_pycommon",
    ],
)

# The py_binary target does not accept files without the .py or .py3 suffix.
# This rule simply renames the file to make it usable.
genrule(
    name = "cli_rename",
    srcs = ["bin/rosidl_generator_cpp"],
    outs = ["bin/rosidl_generator_cpp.py"],
    cmd = "cp $(location :bin/rosidl_generator_cpp) $(location :bin/rosidl_generator_cpp.py)",
)

# This makes the setup script executable, and ensures that eny downstream
# consumers of this script bring in the correct dependencies.
py_binary(
    name = "cli",
    srcs = [":bin/rosidl_generator_cpp.py"],
    main = ":bin/rosidl_generator_cpp.py",
    deps = [":rosidl_generator_cpp"],
)

# Mirrors ament_package(CONFIG_EXTRAS "rosidl_generator_cpp-extras.cmake.in"): configure_file(@ONLY) of the template.
genrule(
    name = "extras_cmake",
    srcs = ["rosidl_generator_cpp-extras.cmake.in"],
    outs = ["rosidl_generator_cpp-extras.cmake"],
    cmd = "sed -e 's|@PROJECT_NAME@|rosidl_generator_cpp|g' -e 's|@PYTHON_INSTALL_DIR@|lib/python3.14/site-packages|g' $< > $@",
)

# ament_index_register_resource() registrations, as ament_cmake installs them.

### PACKAGING

register_ament_resource(
    name = "res_rosidl_generator_packages",
    category = "rosidl_generator_packages",
    content = "",
)

ament_package(
    name = "ament_package",
    cmake = [
        ":extras_cmake",
    ] + [
        "cmake/register_cpp.cmake",
        "cmake/rosidl_generator_cpp_generate_interfaces.cmake",
    ],
    cmake_export_dependencies = False,
    cmake_extras = ["rosidl_generator_cpp-extras.cmake"],
    data = [
        ":res_rosidl_generator_packages",
    ] + [
        "resource/action__builder.hpp.em",
        "resource/action__struct.hpp.em",
        "resource/action__traits.hpp.em",
        "resource/action__type_support.hpp.em",
        "resource/idl.hpp.em",
        "resource/idl__builder.hpp.em",
        "resource/idl__struct.hpp.em",
        "resource/idl__traits.hpp.em",
        "resource/idl__type_support.hpp.em",
        "resource/msg__builder.hpp.em",
        "resource/msg__struct.hpp.em",
        "resource/msg__traits.hpp.em",
        "resource/msg__type_support.hpp.em",
        "resource/rosidl_generator_cpp__visibility_control.hpp.in",
        "resource/srv__builder.hpp.em",
        "resource/srv__struct.hpp.em",
        "resource/srv__traits.hpp.em",
        "resource/srv__type_support.hpp.em",
    ],
    lib_data = ["bin/rosidl_generator_cpp"],
    package_xml = "package.xml",
    python = [
        "rosidl_generator_cpp/__init__.py",
        "rosidl_generator_cpp/cli.py",
        "rosidl_generator_cpp/py.typed",
    ],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_core//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_cli//:ament_package",
        "@rosidl_cmake//:ament_package",
        "@rosidl_generator_c//:ament_package",
        "@rosidl_generator_type_description//:ament_package",
        "@rosidl_parser//:ament_package",
        "@rosidl_pycommon//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
    ],
)
