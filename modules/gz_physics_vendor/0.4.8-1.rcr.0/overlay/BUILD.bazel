# gz_physics_vendor: vendors gz-physics (version 9) from the Bazel Central
# Registry module `gz-physics` (shared library wrappers live in
# @rosdistro//cc/gz) and installs it like colcon's ament_vendor() does
# (opt/gz_physics_vendor/...). The engine plugins (dartsim, bullet,
# bullet-featherstone, tpe) are self-contained shared objects built by the
# BCR module; the sdf/mesh/heightmap components are header-only and part of
# libgz-physics.so.

load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc/gz:defs.bzl", "gz_install_files", "gz_install_headers", "gz_vendor_hooks")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES (gz-physics::core, ::sdf, ::mesh, ::heightmap)

alias(
    name = "gz_physics",
    actual = "@rosdistro//cc/gz:gz-physics",
)

alias(
    name = "gz_physics_library",
    actual = "@rosdistro//cc/gz:gz-physics_library",
)

[
    alias(
        name = "gz_physics_%s_library" % component,
        actual = "@rosdistro//cc/gz:gz-physics-%s_library" % component,
    )
    for component in [
        "heightmap",
        "mesh",
        "sdf",
    ]
]

alias(
    name = "engine_plugins",
    actual = "@rosdistro//cc/gz:gz-physics_engine_plugins",
)

### INSTALL LAYOUT (opt/gz_physics_vendor/...)

VENDOR = "gz_physics_vendor"

PREFIX = "opt/" + VENDOR

gz_install_headers(
    name = "install_headers",
    prefix = PREFIX + "/include/gz/physics9",
    strip_prefixes = [
        "include",
        "heightmap/include",
        "mesh/include",
        "sdf/include",
    ],
    deps = [
        ":gz_physics_heightmap_library",
        ":gz_physics_library",
        ":gz_physics_mesh_library",
        ":gz_physics_sdf_library",
    ],
)

gz_install_files(
    name = "install_libraries",
    srcs = [":gz_physics"],
    flatten = True,
    prefix = PREFIX + "/lib",
)

gz_install_files(
    name = "install_engine_plugins",
    srcs = [":engine_plugins"],
    flatten = True,
    prefix = PREFIX + "/lib/gz-physics-9/engine-plugins",
)

ENV_HOOKS = gz_vendor_hooks(
    name = "install_hooks",
    pythonpath = False,
    vendor = VENDOR,
)

### PACKAGING

ament_package(
    name = "ament_package",
    env_hooks = ENV_HOOKS,
    install = [
        ":install_engine_plugins",
        ":install_headers",
        ":install_hooks",
        ":install_libraries",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_test//:ament_package",
        "@ament_cmake_vendor_package//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@gz_cmake_vendor//:ament_package",
        "@gz_common_vendor//:ament_package",
        "@gz_dartsim_vendor//:ament_package",
        "@gz_math_vendor//:ament_package",
        "@gz_plugin_vendor//:ament_package",
        "@gz_utils_vendor//:ament_package",
        "@rosdistro//:ament_package",
        "@sdformat_vendor//:ament_package",
    ],
)
