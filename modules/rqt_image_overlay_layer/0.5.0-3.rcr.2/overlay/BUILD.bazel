load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

collect_transitive_dynamic_deps(
    name = "dynamic_deps",
    dynamic_deps = [
        "@message_filters",
        "@pluginlib",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:widgets_shared",
        "@rclcpp",
        "@rcpputils",
        "@rosidl_runtime_cpp",
    ],
)

filegroup(
    name = "package_xml",
    srcs = ["package.xml"],
)

filegroup(
    name = "headers",
    srcs = [
        "include/rqt_image_overlay_layer/plugin.hpp",
        "include/rqt_image_overlay_layer/plugin_interface.hpp",
    ],
)

cc_library(
    name = "rqt_image_overlay_layer",
    hdrs = [":headers"],
    includes = ["include"],
    deps = [
        "@message_filters//:message_filters_library",
        "@pluginlib//:pluginlib_library",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtbase//:widgets",
        "@rclcpp//:rclcpp_library",
        "@rcpputils//:rcpputils_library",
        "@rosidl_runtime_cpp//:rosidl_runtime_cpp_library",
    ],
)

alias(
    name = "rqt_image_overlay_layer_library",
    actual = ":rqt_image_overlay_layer",
)

ament_index(
    name = "ament_index",
    package_xml = ":package_xml",
)

ament_package(
    cmake_export_interface = False,
    cmake_export_targets = False,
    headers = [":headers"],
    include_prefix = "",
    package_xml = ":package_xml",
    deps = [
        "@message_filters//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rcpputils//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
    ],
)
