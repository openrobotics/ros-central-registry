load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

exports_files(["defs.bzl"])

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = [
        "cmake/rosidl_auto_generate_interfaces.cmake",
        "cmake/rosidl_cmake-extras.cmake.in",
        "cmake/rosidl_cmake_aggregate_target-extras.cmake.in",
        "cmake/rosidl_cmake_aggregate_target_package_hook.cmake",
        "cmake/rosidl_cmake_export_typesupport_libraries-extras.cmake.in",
        "cmake/rosidl_cmake_export_typesupport_libraries_package_hook.cmake",
        "cmake/rosidl_cmake_export_typesupport_targets-extras.cmake.in",
        "cmake/rosidl_cmake_export_typesupport_targets_package_hook.cmake",
        "cmake/rosidl_cmake_package_hook.cmake",
        "cmake/rosidl_export_typesupport_libraries.cmake",
        "cmake/rosidl_export_typesupport_targets.cmake",
        "cmake/rosidl_find_package_idl.cmake",
        "cmake/rosidl_generate_interfaces.cmake",
        "cmake/rosidl_get_typesupport_target.cmake",
        "cmake/rosidl_write_generator_arguments.cmake",
        "cmake/string_camel_case_to_lower_case_underscore.cmake",
    ] + ["rosidl_cmake-extras.cmake"],
    cmake_extras = ["rosidl_cmake-extras.cmake"],
    package_xml = "package.xml",
    python = [
        "rosidl_cmake/__init__.py",
        "rosidl_cmake/py.typed",
    ],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_pycommon//:ament_package",
    ],
)
