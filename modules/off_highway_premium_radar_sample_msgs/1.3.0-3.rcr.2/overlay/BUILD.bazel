load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PACKAGING

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:DiagnosticsEthernetConfigurationInformation",
        "//msg:DoIpInformation",
        "//msg:EgoVehicleData",
        "//msg:EgoVehicleInput",
        "//msg:InterferenceIndicator",
        "//msg:LocationAttributes",
        "//msg:LocationAttributesHeader",
        "//msg:LocationAttributesPacket",
        "//msg:LocationDataHeader",
        "//msg:LocationDataPacket",
        "//msg:MeasurementCycleSyncData",
        "//msg:MisalignmentPacket",
        "//msg:OperationMode",
        "//msg:SensorBroadcast",
        "//msg:SensorBroadcastData",
        "//msg:SensorDtcInformation",
        "//msg:SensorEthernetConfigurationInformation",
        "//msg:SensorFeedback",
        "//msg:SensorFieldOfView",
        "//msg:SensorModulationPerformance",
        "//msg:SensorStateInformation",
        "//msg:Time",
        "//srv:MeasurementProgram",
        "//srv:SensorModeRequest",
    ],
)

rosidl_ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
