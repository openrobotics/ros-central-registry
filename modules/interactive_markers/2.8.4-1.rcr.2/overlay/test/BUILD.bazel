load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@visualization_msgs//:cc_shared": "@visualization_msgs//:cc",
}

cc_library(
    name = "interactive_marker_fixtures",
    srcs = ["interactive_markers/interactive_marker_fixtures.cpp"],
    hdrs = ["interactive_markers/interactive_marker_fixtures.hpp"],
    deps = ["@visualization_msgs//:cc"],
)

cc_test(
    name = "test_interactive_marker_server",
    srcs = [
        "interactive_markers/mock_interactive_marker_client.hpp",
        "interactive_markers/test_interactive_marker_server.cpp",
        "interactive_markers/timed_expect.hpp",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        ":interactive_marker_fixtures",
        "//:interactive_markers_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_interactive_marker_client",
    srcs = [
        "interactive_markers/mock_interactive_marker_server.hpp",
        "interactive_markers/test_interactive_marker_client.cpp",
        "interactive_markers/timed_expect.hpp",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        ":interactive_marker_fixtures",
        "//:interactive_markers_library",
        "@rosdistro//cc:googletest",
    ],
)
