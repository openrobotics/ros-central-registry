load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = [
    "include/interactive_markers/exceptions.hpp",
    "include/interactive_markers/interactive_marker_client.hpp",
    "include/interactive_markers/interactive_marker_server.hpp",
    "include/interactive_markers/menu_handler.hpp",
    "include/interactive_markers/message_context.hpp",
    "include/interactive_markers/tools.hpp",
    "include/interactive_markers/visibility_control.hpp",
]

DEPENDENCIES = {
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@visualization_msgs//:cc_shared": "@visualization_msgs//:cc",
}

cc_library(
    name = "interactive_markers_library",
    srcs = [
        "src/interactive_marker_client.cpp",
        "src/interactive_marker_server.cpp",
        "src/menu_handler.cpp",
        "src/message_context.cpp",
        "src/tools.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["INTERACTIVE_MARKERS_BUILDING_LIBRARY"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "interactive_markers",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":interactive_markers_library"],
)

py_library(
    name = "py",
    srcs = [
        "interactive_markers/__init__.py",
        "interactive_markers/interactive_marker_server.py",
        "interactive_markers/menu_handler.py",
    ],
    deps = ["@rclpy"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":interactive_markers",
        "@geometry_msgs//:cc_shared",
        "@std_msgs//:cc_shared",
        "@visualization_msgs//:cc_shared",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_interactive_markers",
    headers = HEADERS,
    libraries = [":interactive_markers"],
    package_xml = "package.xml",
    python = [":py"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
