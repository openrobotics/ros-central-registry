load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "config/f9p_ubx_config.toml",
        "config/f9r_ubx_config.toml",
        "config/x20p_ubx_config.toml",
        "launch/ntrip_client.launch.py",
        "launch/ublox_fb+r_base.launch.py",
        "launch/ublox_fb+r_rover.launch.py",
        "launch/ublox_mb+r_base.launch.py",
        "launch/ublox_mb+r_rover.launch.py",
        "launch/ublox_rover_hpposecef.launch.py",
        "launch/ublox_rover_hpposllh.launch.py",
        "launch/ublox_rover_hpposllh_navsatfix.launch.py",
        "launch/ublox_rover_hpposllh_satellite.launch.py",
        "launch/ublox_x20p_rover_hpposllh.launch.py",
        "launch/ublox_x20p_rover_hpposllh_navsatfix.launch.py",
    ],
    package_xml = "package.xml",
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [":ament_index"],
    )
    for f in glob(["launch/**"])
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    data = [
        "config/f9p_ubx_config.toml",
        "config/f9r_ubx_config.toml",
        "config/x20p_ubx_config.toml",
        "launch/ntrip_client.launch.py",
        "launch/ublox_fb+r_base.launch.py",
        "launch/ublox_fb+r_rover.launch.py",
        "launch/ublox_mb+r_base.launch.py",
        "launch/ublox_mb+r_rover.launch.py",
        "launch/ublox_rover_hpposecef.launch.py",
        "launch/ublox_rover_hpposllh.launch.py",
        "launch/ublox_rover_hpposllh_navsatfix.launch.py",
        "launch/ublox_rover_hpposllh_satellite.launch.py",
        "launch/ublox_x20p_rover_hpposllh.launch.py",
        "launch/ublox_x20p_rover_hpposllh_navsatfix.launch.py",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ntrip_client_node//:ament_package",
        "@rosdistro//:ament_package",
        "@ublox_dgnss_node//:ament_package",
        "@ublox_nav_sat_fix_hp_node//:ament_package",
        "@ublox_ubx_interfaces//:ament_package",
        "@ublox_ubx_msgs//:ament_package",
    ],
)
