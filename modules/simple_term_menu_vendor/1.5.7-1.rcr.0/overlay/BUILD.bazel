load("@rosdistro//ament:defs.bzl", "ament_package", "register_ament_files")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

py_library(
    name = "simple_term_menu_vendor",
    srcs = [
        "simple_term_menu_vendor/__init__.py",
        "simple_term_menu_vendor/simple_term_menu.py",
    ],
    imports = [
        ".",
        "simple_term_menu_vendor",
    ],
)

register_ament_files(
    name = "ament_files_0",
    files = [
        "simple_term_menu_vendor/simple_term_menu.py",
    ],
    prefix = "lib/python3.12/site-packages",
    strip_prefix = "*",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    data = [
        ":ament_files_0",
    ],
    package_xml = "package.xml",
    python = [":simple_term_menu_vendor"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
