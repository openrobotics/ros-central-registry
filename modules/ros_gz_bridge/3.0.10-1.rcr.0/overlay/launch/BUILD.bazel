load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "clock_bridge.launch.xml",
        "ros_gz_bridge.launch.py",
        "ros_gz_bridge.launch.xml",
    ],
)

launch_ros_binary(
    name = "clock_bridge.launch",
    src = "clock_bridge.launch.xml",
    data = [
        "//:ament_index",
    ],
    deps = [
        "//:bridge_node",
        "//:ros_gz_bridge_py",
        "@rclcpp_components//:component_container",
    ],
)

launch_ros_binary(
    name = "ros_gz_bridge.launch",
    src = "ros_gz_bridge.launch.xml",
    data = [
        "//:ament_index",
    ],
    deps = [
        "//:bridge_node",
        "//:ros_gz_bridge_py",
        "@rclcpp_components//:component_container",
    ],
)

launch_ros_binary(
    name = "ros_gz_bridge_launch",
    src = "ros_gz_bridge.launch.py",
    data = [
        "//:ament_index",
    ],
    deps = [
        "//:bridge_node",
        "//:ros_gz_bridge_py",
        "@rclcpp_components//:component_container",
    ],
)
