    includes = [
        ".",
        "_gen/include",
        "include",
        "tools",
    ],
    local_defines = ros_local_defines() + [
        "CV_BRDIGE_HAS_HPP",
        "ELPP_NO_DEFAULT_LOG_FILE",
        "LYRICAL",
        "NDEBUG",
        "RCLCPP_HAS_OnSetParametersCallbackType",
        "_FORTIFY_SOURCE=2",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "realsense2_camera",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = select({
        "@platforms//os:linux": [
            "-Wl,--allow-shlib-undefined",
            "-Wl,--unresolved-symbols=ignore-all",
        ],
        "//conditions:default": [],
    }),
    deps = [":realsense2_camera_library"],
)

rclcpp_components_register_node(
    name = "realsense2_camera_node",
    component = ":realsense2_camera",
    node_name = "realsense2_camera_node",
    plugin = "realsense2_camera::RealSenseNodeFactory",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

# Mirrors upstream CMakeLists.txt: file(WRITE global_settings.yaml ...) keyed
# off the USE_LIFECYCLE_NODE option (OFF by default).
genrule(
    name = "global_settings_yaml",
    outs = ["_gen/share/realsense2_camera/config/global_settings.yaml"],
    cmd = "echo 'use_lifecycle_node: false' > $@",
)

