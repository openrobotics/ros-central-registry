load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@lifecycle_msgs//:cc_shared": "@lifecycle_msgs//:cc",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@realsense2_camera_msgs//:cc_shared": "@realsense2_camera_msgs//:cc",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@std_srvs//:cc_shared": "@std_srvs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_msgs//:cc_shared": "@tf2_msgs//:cc",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "//:_gen_textual_hdrs",
    "@librealsense2//:realsense2_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

cc_test(
    name = "gtest_template",
    srcs = ["gtest_template.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "README.md",
        "d500/test_abort_triggered_calibration.py",
        "d500/test_dryrun_triggered_calibration.py",
        "d500/test_triggered_calibration.py",
        "live_camera/rosci.py",
        "live_camera/test_camera_aligned_tests.py",
        "live_camera/test_camera_all_profile_tests.py",
        "live_camera/test_camera_fps_tests.py",
        "live_camera/test_camera_imu_tests.py",
        "live_camera/test_camera_point_cloud_tests.py",
        "live_camera/test_camera_service_call.py",
        "live_camera/test_camera_tf_tests.py",
        "live_camera/test_d415_basic_tests.py",
        "live_camera/test_d455_basic_tests.py",
        "live_camera/test_d585s_safety_mode.py",
        "live_camera/test_live_record_db3_play.py",
        "post_processing_filters/test_align_depth.py",
        "rosbag/test_rosbag_all_topics_test.py",
        "rosbag/test_rosbag_basic_tests.py",
        "rosbag/test_rosbag_db3_play_test.py",
        "rosbag/test_rosbag_dec_point_tests.py",
        "rosbag/test_rosbag_depth_tests.py",
        "rosbag/test_rosbag_imu_test.py",
        "templates/test_integration_template.py",
        "templates/test_launch_template.py",
        "templates/test_parameterized_template.py",
        "utils/pytest_live_camera_utils.py",
        "utils/pytest_rs_utils.py",
        "utils/safety_camera_client.py",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "CV_BRDIGE_HAS_HPP",
        "GTEST_HAS_PTHREAD=1",
        "LYRICAL",
        "NDEBUG",
        "RCLCPP_HAS_OnSetParametersCallbackType",
        "_FORTIFY_SOURCE=2",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:realsense2_camera_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

# NOTE: Upstream's pytest tests (templates/test_*_template.py, rosbag/test_rosbag_*.py,
# post_processing_filters/test_align_depth.py) are non-hermetic integration tests that
# download external rosbag files from https://librealsense.realsenseai.com/rs-tests/ at
# module import time via get_rosbag_file_path(). They are omitted per RCR test guidelines.
