e * values, int, Manifold *) { if (values) param_blocks_.insert(values); }\n  bool HasParameterBlock(const double * values) const {\n    return param_blocks_.count(const_cast<double*>(values)) > 0;\n  }\n  void RemoveParameterBlock(const double * values) {\n    param_blocks_.erase(const_cast<double*>(values));\n  }\n  void RemoveResidualBlock(ResidualBlockId) {}\n  void SetManifold(double *, Manifold *) {}\n  void SetParameterization(double *, LocalParameterization *) {}\n  int NumParameterBlocks() const { return static_cast<int>(param_blocks_.size()); }\n  int NumResidualBlocks() const { return static_cast<int>(blocks_.size()); }\n  void SetParameterBlockConstant(const double * x) { const_blocks_.insert(const_cast<double*>(x)); }\n  void SetParameterBlockVariable(double * x) { const_blocks_.erase(x); }\n  bool IsParameterBlockConstant(const double * x) const { return const_blocks_.count(const_cast<double*>(x)) > 0; }\n  void SetParameterLowerBound(double *, int, double) {}\n  void SetParameterUpperBound(double *, int, double) {}\n  bool Evaluate(const EvaluateOptions &, double * cost, std::vector<double> *, std::vector<double> *, void *) {\n    if (cost) *cost = totalCost();\n    return true;\n  }\n  double totalCost() const {\n    double total = 0.0;\n    for (const auto & b : blocks_) {\n      std::vector<double> r(b.cost->num_residuals(), 0.0);\n      b.cost->Evaluate(b.params.data(), r.data(), nullptr);\n      for (double v : r) total += 0.5 * v * v;\n    }\n    return total;\n  }\n private:\n  std::vector<ResidualBlock> blocks_;\n  std::set<double*> param_blocks_;\n  std::set<double*> const_blocks_;\n};\nclass Solver {\n public:\n  struct Options {\n    MinimizerType minimizer_type{TRUST_REGION};\n    LineSearchDirectionType line_search_direction_type{LBFGS};\n    LineSearchType line_search_type{WOLFE};\n    NonlinearConjugateGradientType nonlinear_conjugate_gradient_type{FLETCHER_REEVES};\n    int max_lbfgs_rank{20};\n    bool use_approximate_eigenvalue_bfgs_