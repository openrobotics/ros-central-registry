cc_test(
    name = "chain_model_tests",
    srcs = ["chain_model_tests.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "CMakeLists.txt",
        "camera_info_publisher.py",
        "camera_info_tests_launch.py",
        "chain_manager_tests.yaml",
        "chain_manager_tests_launch.py",
        "error_block_tests.yaml",
        "error_block_tests2.yaml",
        "error_block_tests2_launch.py",
        "error_block_tests_launch.py",
        "feature_finder_loader_tests.yaml",
        "feature_finder_loader_tests_launch.py",
        "make_test_bag",
        "optimization_param_tests.yaml",
        "optimization_param_tests_launch.py",
        "poses_from_yaml_tests.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:robot_calibration_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

