load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

CC_DEPS = [
    "@diagnostic_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "autoware_utils_diagnostics_library",
    srcs = ["src/diagnostics_interface.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    includes = [
        ".",
        "include",
        "include/autoware_utils_diagnostics",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "autoware_utils_diagnostics",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":autoware_utils_diagnostics_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":autoware_utils_diagnostics"],
)

ament_index(
    name = "ament_index",
    libraries = [":autoware_utils_diagnostics"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@autoware_cmake//:ament_package",
        "@autoware_lint_common//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@rclcpp//:ament_package",
    ],
)

cc_test(
    name = "test_autoware_utils_diagnostics",
    srcs = [
        "test/cases/diagnostics_interface.cpp",
        "test/main.cpp",
    ] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/autoware_utils_diagnostics",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":autoware_utils_diagnostics_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "diagnostic_msgs",
        "rclcpp",
    ],
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
        ],
        allow_empty = True,
    ),
    libraries = [":autoware_utils_diagnostics"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@autoware_cmake//:ament_package",
        "@autoware_lint_common//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@rclcpp//:ament_package",
    ],
)
