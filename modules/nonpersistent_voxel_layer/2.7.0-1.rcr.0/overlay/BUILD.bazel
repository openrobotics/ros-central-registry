load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@laser_geometry//:laser_geometry": "@laser_geometry//:laser_geometry_library",
    "@nav2_costmap_2d//:layers": "@nav2_costmap_2d//:layers_library",
    "@nav2_costmap_2d//:nav2_costmap_2d_core": "@nav2_costmap_2d//:nav2_costmap_2d_core_library",
    "@nav2_msgs//:cc_shared": "@nav2_msgs//:cc",
    "@nav2_voxel_grid//:voxel_grid": "@nav2_voxel_grid//:voxel_grid_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "nonpersistent_voxel_layer_core_library",
    srcs = ["plugins/nonpersistent_voxel_layer.cpp"],
    hdrs = ["include/nonpersistent_voxel_layer/nonpersistent_voxel_layer.hpp"],
    includes = [
        "include",
        "include/nonpersistent_voxel_layer",
    ],
    local_defines = ros_local_defines() + [
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "nonpersistent_voxel_layer_core",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":nonpersistent_voxel_layer_core_library"],
)

ament_index(
    name = "ament_index",
    data = ["example/costmap_config.yaml"],
    libraries = [":nonpersistent_voxel_layer_core"],
    package_xml = "package.xml",
    plugin_category = "nav2_costmap_2d",
    plugins = ["costmap_plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@laser_geometry//:ament_package",
        "@nav2_costmap_2d//:ament_package",
        "@nav2_msgs//:ament_package",
        "@nav2_voxel_grid//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "laser_geometry",
        "pluginlib",
        "sensor_msgs",
        "nav2_msgs",
        "rclcpp",
        "nav2_voxel_grid",
        "nav2_costmap_2d",
    ],
    cmake_export_include_directories = False,
    cmake_export_targets = False,
    libraries = [":nonpersistent_voxel_layer_core"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@laser_geometry//:ament_package",
        "@nav2_costmap_2d//:ament_package",
        "@nav2_msgs//:ament_package",
        "@nav2_voxel_grid//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
