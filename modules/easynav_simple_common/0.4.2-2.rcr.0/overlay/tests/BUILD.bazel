load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
    "@yaets//:yaets": "@yaets//:yaets_library",
}

CC_DEPS = [
    "@easynav_common//:easynav_common_library",
    "@nav_msgs//:cc",
]

cc_test(
    name = "simple_maps_tests",
    srcs = ["simple_maps_tests.cpp"],
    data = ["//:ament_index"] + ["CMakeLists.txt"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["EASYNAV_DEBUG_WITH_YAETS"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:easynav_simple_common_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
