cc_library(
    name = "easynav_core_library",
    srcs = [
        "src/easynav_core/ControllerMethodBase.cpp",
        "src/easynav_core/LocalizerMethodBase.cpp",
        "src/easynav_core/MapsManagerBase.cpp",
        "src/easynav_core/MethodBase.cpp",
        "src/easynav_core/PlannerMethodBase.cpp",
    ],
    hdrs = [
        "include/easynav_core/ControllerMethodBase.hpp",
        "include/easynav_core/LocalizerMethodBase.hpp",
        "include/easynav_core/MapsManagerBase.hpp",
        "include/easynav_core/MethodBase.hpp",
        "include/easynav_core/PlannerMethodBase.hpp",
    ],
    includes = [
        "include",
        "include/easynav_core",
        "test",
    ],
    local_defines = ros_local_defines() + [
        "EASYNAV_DEBUG_WITH_YAETS",
        "GLAD_API_CALL_EXPORT",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "easynav_core",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":easynav_core_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":easynav_core"],
)

ament_index(
    name = "ament_index",
    libraries = [":easynav_core"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
