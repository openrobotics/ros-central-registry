load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = ["ur_moveit.launch.py"],
)

launch_ros_binary(
    name = "ur_moveit_launch",
    src = "ur_moveit.launch.py",
    data = [
        "//:ament_index",
        # Planner plugins MoveItConfigsBuilder loads from config/*_planning.yaml.
        # moveit_planners is a metapackage bundling ompl, chomp, stomp and pilz.
        "@moveit_planners//:ament_package",
        "@moveit_ros_move_group//:ament_index",
        "@moveit_ros_move_group//:move_group",
        "@moveit_servo//:ament_index",
        "@moveit_servo//:servo_node",
        "@rviz2",
        "@rviz2//:ament_index",
        "@ur_robot_driver//:ament_index",
        # warehouse_ros_sqlite::DatabaseConnection plugin used by move_group.
        "@warehouse_ros_sqlite//:ament_index",
    ],
    deps = [":ur_moveit_launch_deps"],
)

# Python modules ur_moveit.launch.py imports. Launch files that include it via
# IncludeLaunchDescription run it in their own interpreter, so they need these
# in their `deps` (and :ur_moveit_launch in `data` for the nodes it starts).
py_library(
    name = "ur_moveit_launch_deps",
    deps = [
        "@ament_index_python",
        "@moveit_configs_utils",
        requirement("pyyaml"),
    ],
)
