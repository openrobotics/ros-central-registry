load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

HEADERS = glob([
    "include/**/*.hpp",
    "include/**/*.h",
])

DEPENDENCIES = {
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rmw_dds_common//:rmw_dds_common": "@rmw_dds_common//:rmw_dds_common_library",
    "@rmw_fastrtps_shared_cpp//:rmw_fastrtps_shared_cpp": "@rmw_fastrtps_shared_cpp//:rmw_fastrtps_shared_cpp_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
    "@rosidl_typesupport_introspection_c//:rosidl_typesupport_introspection_c": "@rosidl_typesupport_introspection_c//:rosidl_typesupport_introspection_c_library",
    "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp": "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp_library",
    "@tracetools//:tracetools": "@tracetools//:tracetools_library",
    "@rosdistro//cc:fastcdr": "@rosdistro//cc:fastcdr_library",
    "@rosdistro//cc:fastdds": "@rosdistro//cc:fastdds_library",
}

cc_library(
    name = "rmw_fastrtps_dynamic_cpp_library",
    srcs = glob([
        "src/**/*.hpp",
        "src/**/*.cpp",
    ]),
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rmw_fastrtps_dynamic_cpp",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rmw_fastrtps_dynamic_cpp_library"],
    deps = [":rmw_fastrtps_dynamic_cpp_library"],
)

### TRANSITIVELY COLLECT ALL DYNAMIC DEPS TO ENSURE LINKING WORKS

# This is a workaround for the fact that dynamic_deps does not work transitively.
# So, if you have a (foo -> bar -> baz) dynamic_dep dep chain, the symbols from
# foo will not be available to baz at compile-time. This resolves that by running
# an aspect over the dynamic_deps attribute to collect everything in the chain.

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rmw_fastrtps_dynamic_cpp"],
    visibility = ["//visibility:private"],
)

### TESTING

cc_test(
    name = "test_get_native_entities",
    srcs = ["test/test_get_native_entities.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":rmw_fastrtps_dynamic_cpp_library",
        "@osrf_testing_tools_cpp//:memory_tools",
        "@rosdistro//cc:googletest",
        "@test_msgs//:c",
    ],
)

cc_test(
    name = "test_logging",
    srcs = ["test/test_logging.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":rmw_fastrtps_dynamic_cpp_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_deserialize_sequence_size",
    srcs = ["test/test_deserialize_sequence_size.cpp"] + glob(["src/**/*.hpp"]),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["src"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":rmw_fastrtps_dynamic_cpp_library",
        "@osrf_testing_tools_cpp//:memory_tools",
        "@rosdistro//cc:googletest",
        "@test_msgs//:c",
        "@test_msgs//:cc",
    ],
)

write_file(
    name = "resource_index_rmw_typesupport",
    out = "_resource_index/rmw_typesupport",
    content = ["rosidl_typesupport_fastrtps_c;rosidl_typesupport_introspection_c;rosidl_typesupport_fastrtps_cpp;rosidl_typesupport_introspection_cpp"],
)

write_file(
    name = "resource_index_rmw_typesupport_c",
    out = "_resource_index/rmw_typesupport_c",
    content = ["rosidl_typesupport_fastrtps_c;rosidl_typesupport_introspection_c"],
)

write_file(
    name = "resource_index_rmw_typesupport_cpp",
    out = "_resource_index/rmw_typesupport_cpp",
    content = ["rosidl_typesupport_fastrtps_cpp;rosidl_typesupport_introspection_cpp"],
)

# ament_index_register_resource() registrations, as ament_cmake installs them.
pkg_files(
    name = "resource_index",
    srcs = [
        ":resource_index_rmw_typesupport",
        ":resource_index_rmw_typesupport_c",
        ":resource_index_rmw_typesupport_cpp",
    ],
    renames = {
        ":resource_index_rmw_typesupport": "share/ament_index/resource_index/rmw_typesupport/rmw_fastrtps_dynamic_cpp",
        ":resource_index_rmw_typesupport_c": "share/ament_index/resource_index/rmw_typesupport_c/rmw_fastrtps_dynamic_cpp",
        ":resource_index_rmw_typesupport_cpp": "share/ament_index/resource_index/rmw_typesupport_cpp/rmw_fastrtps_dynamic_cpp",
    },
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = ["rmw_fastrtps_dynamic_cpp-extras.cmake"],
    cmake_extras = ["rmw_fastrtps_dynamic_cpp-extras.cmake"],
    headers = HEADERS,
    install = [":resource_index"],
    libraries = [":rmw_fastrtps_dynamic_cpp"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros_core//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@osrf_testing_tools_cpp//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rmw_dds_common//:ament_package",
        "@rmw_fastrtps_shared_cpp//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_buffer//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidl_typesupport_introspection_c//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
        "@test_msgs//:ament_package",
        "@tracetools//:ament_package",
    ],
)
