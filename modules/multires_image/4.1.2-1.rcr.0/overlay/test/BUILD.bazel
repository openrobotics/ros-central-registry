    "@qtsvg//:svg",
    "@qtbase//:widgets",
    "@qtbase//:opengl",
    "@qtbase//:openglwidgets",
]

cc_test(
    name = "test_queued_signals",
    srcs = ["test_queued_signals.cpp"] + [] + [
        "//:ui_QGLMap.h",
        "//:ui_multires_config.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        "//:ament_index",
        "//:multires_image",
        "//:multires_image_plugin",
        "//:multires_widget",
    ],
    dynamic_deps = [
        "//:transitive_dynamic_deps",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtsvg//:svg_shared",
        "@qtbase//:widgets_shared",
        "@qtbase//:opengl_shared",
        "@qtbase//:openglwidgets_shared",
    ],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "USE_NEW_TF2_ROS_CTORS=0",
        "USE_NEW_TF2_TOMSG=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:multires_image_library",
        "//:multires_widget_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

