genrule(
    name = "tar",
    srcs = [":raw_tar"],
    outs = ["tar.tar.gz"],
    cmd = "tmpdir=$$(mktemp -d) && tar -xzf $(location :raw_tar) -C $$tmpdir && rm -rf $$tmpdir/opt/ros/lyrical/multires_image/share/multires_image/hook && tar -czf $@ -C $$tmpdir opt && rm -rf $$tmpdir",
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    install_package_xml = False,
    package_xml = "package.xml",
    tar_name = "raw_tar",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@gps_msgs//:ament_package",
        "@mapviz//:ament_package",
        "@mapviz_interfaces//:ament_package",
        "@marti_common_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@swri_math_util//:ament_package",
        "@swri_transform_util//:ament_package",
        "@tf2//:ament_package",
