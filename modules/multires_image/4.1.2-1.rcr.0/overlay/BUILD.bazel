    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/multires_image",
    ],
    local_defines = ros_local_defines() + [
        "USE_NEW_TF2_ROS_CTORS=0",
        "USE_NEW_TF2_TOMSG=1",
        "WFlags=WindowFlags",
        "_FILE_OFFSET_BITS=64",
    ],
    moc_hdrs = ["include/multires_image/QGLMap.hpp"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":multires_image_library"],
)

cc_shared_library(
    name = "multires_widget",
    dynamic_deps = DEPENDENCIES.keys() + [":multires_image"] + [
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtsvg//:svg_shared",
        "@qtbase//:widgets_shared",
