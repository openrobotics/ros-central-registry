CC_DEPS = [
    "@gps_msgs//:cc",
    "@mapviz_interfaces//:cc",
    "@marti_common_msgs//:cc",
    "@qtbase//:core",
    "@qtbase//:gui",
    "@qtbase//:opengl",
    "@qtbase//:openglwidgets",
    "@qtbase//:widgets",
    "@qtsvg//:svg",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

genrule(
    name = "uic_QGLMap",
    srcs = ["src/QGLMap.ui"],
    outs = ["ui_QGLMap.h"],
    cmd = "$(execpath @qtbase//:uic) $< -o $@",
    tools = ["@qtbase//:uic"],
)

genrule(
    name = "uic_multires_config",
    srcs = ["src/multires_config.ui"],
    outs = ["ui_multires_config.h"],
    cmd = "$(execpath @qtbase//:uic) $< -o $@",
    tools = ["@qtbase//:uic"],
)

qt_cc_library(
    name = "multires_image_library",
    srcs = [
        "src/tile.cpp",
        "src/tile_cache.cpp",
        "src/tile_set.cpp",
        "src/tile_set_layer.cpp",
    ],
    hdrs = ["include/multires_image/tile_cache.hpp"] + [
        "include/multires_image/QGLMap.hpp",
        "include/multires_image/multires_image_plugin.hpp",
        "include/multires_image/multires_view.hpp",
        "include/multires_image/multires_view_node.hpp",
        "include/multires_image/tile.hpp",
        "include/multires_image/tile_set.hpp",
        "include/multires_image/tile_set_layer.hpp",
        "include/multires_image/tile_view.hpp",
        ":ui_QGLMap.h",
        ":ui_multires_config.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/multires_image",
    ],
    local_defines = ros_local_defines() + [
        "USE_NEW_TF2_ROS_CTORS=0",
        "USE_NEW_TF2_TOMSG=1",
        "WFlags=WindowFlags",
    ],
    moc_hdrs = ["include/multires_image/tile_cache.hpp"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "multires_image",
    dynamic_deps = DEPENDENCIES.keys() + [
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtsvg//:svg_shared",
        "@qtbase//:widgets_shared",
        "@qtbase//:opengl_shared",
        "@qtbase//:openglwidgets_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":multires_image_library"],
)

qt_cc_library(
    name = "multires_widget_library",
    srcs = [
        "src/QGLMap.cpp",
        "src/tile_view.cpp",
    ],
    hdrs = ["include/multires_image/QGLMap.hpp"] + [
        "include/multires_image/multires_image_plugin.hpp",
        "include/multires_image/multires_view.hpp",
        "include/multires_image/multires_view_node.hpp",
        "include/multires_image/tile.hpp",
        "include/multires_image/tile_cache.hpp",
        "include/multires_image/tile_set.hpp",
        "include/multires_image/tile_set_layer.hpp",
        "include/multires_image/tile_view.hpp",
        ":ui_QGLMap.h",
        ":ui_multires_config.h",
