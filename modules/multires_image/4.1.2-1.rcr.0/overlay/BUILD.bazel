cc_shared_library(
    name = "multires_image_plugin",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":multires_image",
        ":multires_widget",
    ] + [
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
