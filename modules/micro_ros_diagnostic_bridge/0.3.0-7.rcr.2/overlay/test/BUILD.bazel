load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {"@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library"}

genrule(
    name = "lookup_tables_h",
    srcs = [
        "lookup_tables.h.in",
        "test_lookup_table.yaml",
    ],
    outs = ["generated/micro_ros_diagnostic_bridge/lookup_tables.h"],
    cmd = "sed -e 's|@LOOKUP_TABLE_PATH@|$(rootpath test_lookup_table.yaml)|' $(location lookup_tables.h.in) > $@",
)

cc_library(
    name = "lookup_tables",
    hdrs = [":lookup_tables_h"],
    includes = ["generated"],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_diagnostic_bridge",
    timeout = "moderate",
    srcs = ["test_diagnostic_bridge.cpp"],
    data = ["test_lookup_table.yaml"] + ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":lookup_tables",
        "//:micro_ros_diagnostic_bridge_library",
        "@rosdistro//cc:googletest",
    ],
)
