load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

# Upstream compiles micro_ros_diagnostic_bridge.cpp straight into the
# executable (and again into the test); kept as a static library here.
cc_library(
    name = "micro_ros_diagnostic_bridge_library",
    srcs = ["src/micro_ros_diagnostic_bridge/micro_ros_diagnostic_bridge.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@diagnostic_msgs//:cc",
        "@micro_ros_diagnostic_msgs//:cc",
    ],
)

### EXECUTABLES

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "diagnostic_bridge",
    srcs = ["src/diagnostic_bridge_node.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [":micro_ros_diagnostic_bridge_library"],
)

### AMENT INDEX

DATA = glob(["launch/**"])

ament_index(
    name = "ament_index",
    data = DATA,
    executables = [":diagnostic_bridge"],
    package_xml = "package.xml",
    deps = [
        "@diagnostic_msgs//:ament_index",
        "@micro_ros_diagnostic_msgs//:ament_index",
    ],
)

### TESTS

# configure_file(test/lookup_tables.h.in ...): path of the yaml fixture,
# resolved relative to the test runfiles.
genrule(
    name = "lookup_tables_h",
    srcs = [
        "test/lookup_tables.h.in",
        "test/test_lookup_table.yaml",
    ],
    outs = ["test/generated/micro_ros_diagnostic_bridge/lookup_tables.h"],
    cmd = "sed -e 's|@LOOKUP_TABLE_PATH@|$(rootpath test/test_lookup_table.yaml)|' $(location test/lookup_tables.h.in) > $@",
)

cc_library(
    name = "lookup_tables",
    hdrs = [":lookup_tables_h"],
    includes = ["test/generated"],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_diagnostic_bridge",
    timeout = "moderate",
    srcs = ["test/test_diagnostic_bridge.cpp"],
    data = ["test/test_lookup_table.yaml"] + [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":lookup_tables",
        ":micro_ros_diagnostic_bridge_library",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

write_file(
    name = "_meta_file_0",
    out = "_gen_meta/share/micro_ros_diagnostic_bridge/cmake/ament_cmake_export_libraries-extras.cmake",
    content = [
        "# generated from ament_cmake_export_libraries/cmake/template/ament_cmake_export_libraries.cmake.in",
        "",
        "set(_exported_libraries \"\")",
        "set(_exported_library_names \"micro_ros_diagnostic_bridge;micro_ros_diagnostic_bridge\")",
        "",
        "# populate micro_ros_diagnostic_bridge_LIBRARIES",
        "if(NOT _exported_libraries STREQUAL \"\")",
        "  # loop over libraries, either target names or absolute paths",
        "  list(LENGTH _exported_libraries _length)",
        "  set(_i 0)",
        "  while(_i LESS _length)",
        "    list(GET _exported_libraries ${_i} _arg)",
        "",
        "    # pass linker flags along",
        "    if(\"${_arg}\" MATCHES \"^-\" AND NOT \"${_arg}\" MATCHES \"^-[l|framework]\")",
        "      list(APPEND micro_ros_diagnostic_bridge_LIBRARIES \"${_arg}\")",
        "      math(EXPR _i \"${_i} + 1\")",
        "      continue()",
        "    endif()",
        "",
        "    if(\"${_arg}\" MATCHES \"^(debug|optimized|general)$\")",
        "      # remember build configuration keyword",
        "      # and get following library",
        "      set(_cfg \"${_arg}\")",
        "      math(EXPR _i \"${_i} + 1\")",
        "      if(_i EQUAL _length)",
        "        message(FATAL_ERROR \"Package 'micro_ros_diagnostic_bridge' passes the build configuration keyword '${_cfg}' as the last exported library\")",
        "      endif()",
        "      list(GET _exported_libraries ${_i} _library)",
        "    else()",
        "      # the value is a library without a build configuration keyword",
        "      set(_cfg \"\")",
        "      set(_library \"${_arg}\")",
        "    endif()",
        "    math(EXPR _i \"${_i} + 1\")",
        "",
        "    if(NOT IS_ABSOLUTE \"${_library}\")",
        "      # search for library target relative to this CMake file",
        "      set(_lib \"NOTFOUND\")",
        "      find_library(",
        "        _lib NAMES \"${_library}\"",
        "        PATHS",
        "        # This is for packages that install libraries to destinations using GNUInstallDirs variables.",
        "        \"${micro_ros_diagnostic_bridge_DIR}/../../../lib\"",
        "        # Historically ROS packages have installed libraries to this hardcoded lib directory.",
        "        \"${micro_ros_diagnostic_bridge_DIR}/../../../lib\"",
        "        NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH",
        "      )",
        "",
        "      if(NOT _lib)",
        "        # warn about not existing library and ignore it",
        "        message(FATAL_ERROR \"Package 'micro_ros_diagnostic_bridge' exports the library '${_library}' which couldn't be found\")",
        "      elseif(NOT IS_ABSOLUTE \"${_lib}\")",
        "        # the found library must be an absolute path",
        "        message(FATAL_ERROR \"Package 'micro_ros_diagnostic_bridge' found the library '${_library}' at '${_lib}' which is not an absolute path\")",
        "      elseif(NOT EXISTS \"${_lib}\")",
        "        # the found library must exist",
        "        message(FATAL_ERROR \"Package 'micro_ros_diagnostic_bridge' found the library '${_lib}' which doesn't exist\")",
        "      else()",
        "        list(APPEND micro_ros_diagnostic_bridge_LIBRARIES ${_cfg} \"${_lib}\")",
        "      endif()",
        "",
        "    else()",
        "      if(NOT EXISTS \"${_library}\")",
        "        # the found library must exist",
        "        message(WARNING \"Package 'micro_ros_diagnostic_bridge' exports the library '${_library}' which doesn't exist\")",
        "      else()",
        "        list(APPEND micro_ros_diagnostic_bridge_LIBRARIES ${_cfg} \"${_library}\")",
        "      endif()",
        "    endif()",
        "  endwhile()",
        "endif()",
        "",
        "# find_library() library names with optional LIBRARY_DIRS",
        "# and add the libraries to micro_ros_diagnostic_bridge_LIBRARIES",
        "if(NOT _exported_library_names STREQUAL \"\")",
        "  # loop over library names",
        "  # but remember related build configuration keyword if available",
        "  list(LENGTH _exported_library_names _length)",
        "  set(_i 0)",
        "  while(_i LESS _length)",
        "    list(GET _exported_library_names ${_i} _arg)",
        "    # pass linker flags along",
        "    if(\"${_arg}\" MATCHES \"^-\" AND NOT \"${_arg}\" MATCHES \"^-[l|framework]\")",
        "      list(APPEND micro_ros_diagnostic_bridge_LIBRARIES \"${_arg}\")",
        "      math(EXPR _i \"${_i} + 1\")",
        "      continue()",
        "    endif()",
        "",
        "    if(\"${_arg}\" MATCHES \"^(debug|optimized|general)$\")",
        "      # remember build configuration keyword",
        "      # and get following library name",
        "      set(_cfg \"${_arg}\")",
        "      math(EXPR _i \"${_i} + 1\")",
        "      if(_i EQUAL _length)",
        "        message(FATAL_ERROR \"Package 'micro_ros_diagnostic_bridge' passes the build configuration keyword '${_cfg}' as the last exported target\")",
        "      endif()",
        "      list(GET _exported_library_names ${_i} _library)",
        "    else()",
        "      # the value is a library target without a build configuration keyword",
        "      set(_cfg \"\")",
        "      set(_library \"${_arg}\")",
        "    endif()",
        "    math(EXPR _i \"${_i} + 1\")",
        "",
        "    # extract optional LIBRARY_DIRS from library name",
        "    string(REPLACE \":\" \";\" _library_dirs \"${_library}\")",
        "    list(GET _library_dirs 0 _library_name)",
        "    list(REMOVE_AT _library_dirs 0)",
        "",
        "    set(_lib \"NOTFOUND\")",
        "    if(NOT _library_dirs)",
        "      # search for library in the common locations",
        "      find_library(",
        "        _lib",
        "        NAMES \"${_library_name}\"",
        "      )",
        "      if(NOT _lib)",
        "        # warn about not existing library and later ignore it",
        "        message(WARNING \"Package 'micro_ros_diagnostic_bridge' exports library '${_library_name}' which couldn't be found\")",
        "      endif()",
        "    else()",
        "      # search for library in the specified directories",
        "      find_library(",
        "        _lib",
        "        NAMES \"${_library_name}\"",
        "        PATHS ${_library_dirs}",
        "        NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH",
        "      )",
        "      if(NOT _lib)",
        "        # warn about not existing library and later ignore it",
        "        message(WARNING",
        "          \"Package 'micro_ros_diagnostic_bridge' exports library '${_library_name}' with LIBRARY_DIRS '${_library_dirs}' which couldn't be found\")",
        "      endif()",
        "    endif()",
        "    if(_lib)",
        "      list(APPEND micro_ros_diagnostic_bridge_LIBRARIES ${_cfg} \"${_lib}\")",
        "    endif()",
        "  endwhile()",
        "endif()",
        "",
        "# TODO(dirk-thomas) deduplicate micro_ros_diagnostic_bridge_LIBRARIES",
        "# while maintaining library order",
        "# as well as build configuration keywords",
        "# as well as linker flags",
    ],
    is_executable = False,
)

pkg_files(
    name = "meta_files_0",
    srcs = [":_meta_file_0"],
    prefix = "share/micro_ros_diagnostic_bridge/cmake",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "ament_cmake",
        "micro_ros_diagnostic_msgs",
        "rosidl_generator_c",
        "rcl",
        "rcutils",
    ],
    cmake_export_has_library_target = True,
    cmake_export_targets = False,
    cmake_extras = ["ament_cmake_export_libraries-extras.cmake"],
    data = DATA,
    executables = [":diagnostic_bridge"],
    headers = HEADERS,
    include_prefix = "",
    install = [":meta_files_0"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@micro_ros_diagnostic_msgs//:ament_package",
        "@osrf_testing_tools_cpp//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_environment//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
