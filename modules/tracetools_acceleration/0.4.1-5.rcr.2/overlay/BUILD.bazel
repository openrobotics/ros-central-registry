load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
]

cc_library(
    name = "tracetools_acceleration_library",
    srcs = [":gen_tracetools_acceleration_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":gen_extra_0"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "_gen/include/tracetools_acceleration",
        "include",
        "include/tracetools_acceleration",
    ],
    local_defines = ros_local_defines() + ["tracetools_acceleration_VERSION=\\\"0.4.1\\\""],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "tracetools_acceleration",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":tracetools_acceleration_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":tracetools_acceleration"],
)

cc_binary(
    name = "status",
    srcs = [":gen_tracetools_acceleration_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":gen_extra_0"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "_gen/include/tracetools_acceleration",
        "include",
        "include/tracetools_acceleration",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":tracetools_acceleration_library"],
)

write_file(
    name = "gen_tracetools_acceleration_stub_cpp",
    out = "_gen/tracetools_acceleration_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

write_file(
    name = "gen_extra_0",
    out = "_gen/include/tracetools_acceleration/config.h",
    content = ["// Copyright 2021 Xilinx®\n// Copyright 2019 Robert Bosch GmbH\n//\n// Licensed under the Apache License, Version 2.0 (the \"License\");\n// you may not use this file except in compliance with the License.\n// You may obtain a copy of the License at\n//\n//     http://www.apache.org/licenses/LICENSE-2.0\n//\n// Unless required by applicable law or agreed to in writing, software\n// distributed under the License is distributed on an \"AS IS\" BASIS,\n// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n// See the License for the specific language governing permissions and\n// limitations under the License.\n\n#ifndef TRACETOOLS_ACCELERATION__CONFIG_H_\n#define TRACETOOLS_ACCELERATION__CONFIG_H_\n\n/* #undef TRACETOOLS_DISABLED */\n#define TRACETOOLS_LTTNG_ENABLED\n\n#endif  // TRACETOOLS_ACCELERATION__CONFIG_H_\n"],
)

write_file(
    name = "gen_cmake_5",
    out = "_gen/share/tracetools_acceleration/cmake/ament_cmake_export_include_directories-extras.cmake",
    content = ["# generated from ament_cmake_export_include_directories/cmake/ament_cmake_export_include_directories-extras.cmake.in\n\nset(_exported_include_dirs \"${tracetools_acceleration_DIR}/../../../include\")\n\n# append include directories to tracetools_acceleration_INCLUDE_DIRS\n# warn about not existing paths\nif(NOT _exported_include_dirs STREQUAL \"\")\n  find_package(ament_cmake_core QUIET REQUIRED)\n  foreach(_exported_include_dir ${_exported_include_dirs})\n    if(NOT IS_DIRECTORY \"${_exported_include_dir}\")\n      message(WARNING \"Package 'tracetools_acceleration' exports the include directory '${_exported_include_dir}' which doesn't exist\")\n    endif()\n    normalize_path(_exported_include_dir \"${_exported_include_dir}\")\n    list(APPEND tracetools_acceleration_INCLUDE_DIRS \"${_exported_include_dir}\")\n  endforeach()\nendif()\n"],
)

write_file(
    name = "gen_cmake_6",
    out = "_gen/share/tracetools_acceleration/cmake/ament_cmake_export_link_flags-extras.cmake",
    content = ["# generated from ament_cmake_export_link_flags/cmake/ament_cmake_export_link_flags-extras.cmake.in\n\nset(_exported_link_flags \"-rdynamic\")\n\n# append link_flags to tracetools_acceleration_LINK_FLAGS\nif(NOT \"${_exported_link_flags} \" STREQUAL \" \")\n  foreach(_link_flag ${_exported_link_flags})\n    list(APPEND tracetools_acceleration_LINK_FLAGS \"${_link_flag}\")\n  endforeach()\nendif()\n"],
)

pkg_files(
    name = "pkg_files_extra_0",
    srcs = [":gen_extra_0"],
    prefix = "include/tracetools_acceleration",
)

pkg_files(
    name = "pkg_files_inc_1",
    srcs = ["include/tracetools_acceleration/tp_call.h"],
    prefix = "include/tracetools_acceleration",
)

pkg_files(
    name = "pkg_files_inc_2",
    srcs = ["include/tracetools_acceleration/tracetools.h"],
    prefix = "include/tracetools_acceleration",
)

pkg_files(
    name = "pkg_files_inc_3",
    srcs = ["include/tracetools_acceleration/utils.hpp"],
    prefix = "include/tracetools_acceleration",
)

pkg_files(
    name = "pkg_files_inc_4",
    srcs = ["include/tracetools_acceleration/visibility_control.hpp"],
    prefix = "include/tracetools_acceleration",
)

pkg_files(
    name = "pkg_files_cmake_5",
    srcs = [":gen_cmake_5"],
    prefix = "share/tracetools_acceleration/cmake",
)

pkg_files(
    name = "pkg_files_cmake_6",
    srcs = [":gen_cmake_6"],
    prefix = "share/tracetools_acceleration/cmake",
)

ament_index(
    name = "ament_index",
    lib_data = [":status"],
    libraries = [":tracetools_acceleration"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
    ],
)

cc_test(
    name = "test_status_tool",
    srcs = [":gen_tracetools_acceleration_stub_cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "_gen/include/tracetools_acceleration",
        "include",
        "include/tracetools_acceleration",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":tracetools_acceleration_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_name = "tracetools_acceleration_export",
    cmake_extras = ["ament_cmake_export_link_flags-extras.cmake"],
    install = [
        ":pkg_files_extra_0",
        ":pkg_files_inc_1",
        ":pkg_files_inc_2",
        ":pkg_files_inc_3",
        ":pkg_files_inc_4",
        ":pkg_files_cmake_5",
        ":pkg_files_cmake_6",
    ],
    libraries = [":tracetools_acceleration"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
    ],
)
