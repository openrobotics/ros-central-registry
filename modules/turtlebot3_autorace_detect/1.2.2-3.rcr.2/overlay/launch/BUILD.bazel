load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "detect_lane.launch.py",
        "detect_level_crossing.launch.py",
        "detect_sign.launch.py",
        "detect_traffic_light.launch.py",
    ],
)

launch_ros_binary(
    name = "detect_lane_launch",
    src = "detect_lane.launch.py",
    data = ["//:ament_index"],
    deps = [
        "//:detect_lane",
        "@ament_index_python",
    ],
)

launch_ros_binary(
    name = "detect_level_crossing_launch",
    src = "detect_level_crossing.launch.py",
    data = ["//:ament_index"],
    deps = [
        "//:detect_level_crossing",
        "@ament_index_python",
    ],
)

launch_ros_binary(
    name = "detect_sign_launch",
    src = "detect_sign.launch.py",
    data = ["//:ament_index"],
    deps = [
        "//:detect_construction_sign",
        "//:detect_intersection_sign",
        "//:detect_level_crossing_sign",
        "//:detect_parking_sign",
        "//:detect_tunnel_sign",
    ],
)

launch_ros_binary(
    name = "detect_traffic_light_launch",
    src = "detect_traffic_light.launch.py",
    data = ["//:ament_index"],
    deps = [
        "//:detect_traffic_light",
        "@ament_index_python",
    ],
)
