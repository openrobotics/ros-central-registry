load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = ["include/dataspeed_can_msg_filters/ApproximateTime.hpp"]

cc_library(
    name = "dataspeed_can_msg_filters",
    hdrs = HEADERS,
    includes = ["include"],
    deps = [
        "@can_msgs//:cc",
        "@rclcpp//:rclcpp_library",
    ],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = ["@rclcpp//:rclcpp"],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    cmake_export_targets = False,
    headers = HEADERS,
    include_prefix = "",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@can_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
