# Mirrors cmake/PangolinFactory.cmake: PangolinRegisterFactory(<interface> ...)
# calls collect factory names per interface (here: the drivers enabled in this
# build), and create_factory_registry_file_now() renders one
# RegisterFactories<interface>.h per interface.
PANGO_FACTORIES = {
    "VideoInterface": [
        "TestVideo",
        "ImagesVideo",
        "SplitVideo",
        "TruncateVideo",
        "PangoVideo",
        "DebayerVideo",
        "ShiftVideo",
        "TransformVideo",
        "UnpackVideo",
        "PackVideo",
        "JoinVideo",
        "MergeVideo",
        "JsonVideo",
        "MjpegVideo",
        "ThreadVideo",
        "FirewireVideo",
        "DeinterlaceVideo",
        "V4lVideo",
        # Listed twice upstream: components/pango_video/CMakeLists.txt registers
        # FfmpegVideo on its own, then again together with FfmpegVideoConvert.
        "FfmpegVideo",
        "FfmpegVideo",
        "FfmpegVideoConvert",
        "OpenNiVideo",
        "OpenNi2Video",
    ],
    "VideoOutputInterface": [
        "ImagesVideoOutput",
        "PangoVideoOutput",
        "FfmpegVideoOutput",
    ],
    "WindowInterface": [
        "X11Window",
        "WaylandWindow",
        "HeadlessWindow",
    ],
}

[genrule(
    name = "register_factories_" + interface,
    outs = ["_gen/include/pangolin/factory/RegisterFactories%s.h" % interface],
    cmd = "printf '%s\\n' " + " ".join(["'%s'" % line for line in (
        [
            "// CMake generated file. Do Not Edit.",
            "",
            "#pragma once",
            "",
            "namespace pangolin {",
            "",
            "  // Forward declarations",
        ] + ["  bool Register%sFactory();" % f for f in factories] + [
            "",
            "",
            "  inline bool RegisterFactories%s() {" % interface,
            "    bool success = true;",
        ] + ["    success &= Register%sFactory();" % f for f in factories] + [
            "    return success;",
            "  }",
            "",
            "",
            "} // pangolin",
        ]
    )]) + " > $@",
) for interface, factories in PANGO_FACTORIES.items()]

