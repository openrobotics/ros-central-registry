# Port of pangolin's CMake build (CMakeLists.txt + components/*/CMakeLists.txt)
# for Linux with desktop OpenGL through libepoxy (upstream's `_LINUX_` branch).
# Every component becomes a `<component>_library` cc_library plus a
# `<component>` cc_shared_library, with the same component-to-component and
# third-party link edges as upstream's target_link_libraries().

load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

COPTS = [
    "-Wno-parentheses",
    "-Wno-null-pointer-arithmetic",
    "-Wno-null-pointer-subtraction",
    "-Wno-missing-template-arg-list-after-template-kw",
]

HDR_PATTERNS = [
    "**/*.h",
    "**/*.hpp",
    "**/*.inl",
]

# Mirrors cmake/PangolinFactory.cmake: PangolinRegisterFactory(<interface> ...)
# calls collect factory names per interface (here: the drivers enabled in this
# build), and create_factory_registry_file_now() renders one
# RegisterFactories<interface>.h per interface.
PANGO_FACTORIES = {
    "VideoInterface": [
        "TestVideo",
        "ImagesVideo",
        "SplitVideo",
        "TruncateVideo",
        "PangoVideo",
        "DebayerVideo",
        "ShiftVideo",
        "TransformVideo",
        "UnpackVideo",
        "PackVideo",
        "JoinVideo",
        "MergeVideo",
        "JsonVideo",
        "MjpegVideo",
        "ThreadVideo",
        "FirewireVideo",
        "DeinterlaceVideo",
        "V4lVideo",
        # Listed twice upstream: components/pango_video/CMakeLists.txt registers
        # FfmpegVideo on its own, then again together with FfmpegVideoConvert.
        "FfmpegVideo",
        "FfmpegVideo",
        "FfmpegVideoConvert",
        "UvcVideo",
    ],
    "VideoOutputInterface": [
        "ImagesVideoOutput",
        "PangoVideoOutput",
        "FfmpegVideoOutput",
    ],
    "WindowInterface": [
        "X11Window",
        "HeadlessWindow",
    ],
}

[genrule(
    name = "register_factories_" + interface,
    outs = ["_gen/include/pangolin/factory/RegisterFactories%s.h" % interface],
    cmd = "printf '%s\\n' " + " ".join(["'%s'" % line for line in (
        [
            "// CMake generated file. Do Not Edit.",
            "",
            "#pragma once",
            "",
            "namespace pangolin {",
            "",
            "  // Forward declarations",
        ] + ["  bool Register%sFactory();" % f for f in factories] + [
            "",
            "",
            "  inline bool RegisterFactories%s() {" % interface,
            "    bool success = true;",
        ] + ["    success &= Register%sFactory();" % f for f in factories] + [
            "    return success;",
            "  }",
            "",
            "",
            "} // pangolin",
        ]
    )]) + " > $@",
) for interface, factories in PANGO_FACTORIES.items()]

# cmake/EmbedBinaryFiles.cmake: embed_binary_files_rule(fonts.cpp src/fonts/*.ttf)
genrule(
    name = "embed_fonts",
    srcs = glob(["components/pango_opengl/src/fonts/*.ttf"]),
    outs = ["_gen/src/fonts.cpp"],
    cmd = " ".join([
        "for f in $(SRCS); do",
        "n=$$(basename \"$$f\" | tr '. ' '__');",
        "printf 'extern const unsigned char %s[] = {' \"$$n\";",
        "od -An -v -tx1 \"$$f\" | sed -e 's/\\([0-9a-f][0-9a-f]\\)/0x\\1,/g' | tr -d ' \\n';",
        "printf '};\\nextern const unsigned %s_size = sizeof(%s);\\n' \"$$n\" \"$$n\";",
        "done > $@",
    ]),
)

# cmake/EmbedShaderFiles.cmake: embed_shader_files_rule(shaders.cpp shaders/*.glsl*)
# Keys are the shader paths relative to the source root, with a leading '/'
# (upstream strips ${PROJECT_SOURCE_DIR}).
genrule(
    name = "embed_shaders",
    srcs = glob(["components/pango_opengl/shaders/*.glsl*"]),
    outs = ["_gen/src/shaders.cpp"],
    cmd = " ".join([
        "{",
        "printf '#include <unordered_map>\\n#include <string>\\n\\nnamespace pangolin {\\n';",
        "printf 'const std::unordered_map<std::string,const char*>& GetBuiltinShaders() {\\n';",
        "printf '\\tstatic const std::unordered_map<std::string,const char*> builtin_shaders = {\\n';",
        "for f in $(SRCS); do",
        "printf '{ \"/components/%s\",\\n R\"SHADER_SOURCE(\\n' \"$${f#*/components/}\";",
        "cat \"$$f\";",
        "printf ')SHADER_SOURCE\" },\\n';",
        "done;",
        "printf '\\t};\\n\\treturn builtin_shaders;\\n}\\n}\\n';",
        "} > $@",
    ]),
)

cc_library(
    name = "pango_factory_headers",
    hdrs = [":register_factories_" + interface for interface in PANGO_FACTORIES],
    includes = ["_gen/include"],
)

