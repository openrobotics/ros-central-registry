    "VideoJsonPrint": ["tools/VideoJson/main-print.cpp"],
    "VideoJsonTransform": ["tools/VideoJson/main-transform.cpp"],
    "VideoViewer": ["tools/VideoViewer/main.cpp"],
}.items()]

# BUILD_TESTS: components/*/tests, linked against Catch2::Catch2WithMain.
[cc_test(
    name = name,
    srcs = [src],
    copts = COPTS,
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        lib + "_library",
        "@rosdistro//cc:catch2_main",
    ],
) for name, src, lib in [
    ("test_uris", "components/pango_core/tests/tests_uri.cpp", ":pango_core"),
    ("test_vars", "components/pango_vars/tests/test_all.cpp", ":pango_vars"),
    ("test_video_uris", "components/pango_video/tests/tests_video_uri.cpp", ":pango_video"),
    ("test_video_loading", "components/pango_video/tests/tests_video_loading.cpp", ":pango_video"),
]]

