load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "depth_demo_launch.py",
        "fragmentation_demo_launch.py",
        "reliability_demo_launch.py",
    ],
)

launch_ros_binary(
    name = "depth_demo_launch",
    src = "depth_demo_launch.py",
    data = ["//:ament_index"],
    deps = ["//:data_publisher"],
)

launch_ros_binary(
    name = "fragmentation_demo_launch",
    src = "fragmentation_demo_launch.py",
    data = ["//:ament_index"],
    deps = ["//:data_publisher"],
)

launch_ros_binary(
    name = "reliability_demo_launch",
    src = "reliability_demo_launch.py",
    data = ["//:ament_index"],
    deps = ["//:data_publisher"],
)
