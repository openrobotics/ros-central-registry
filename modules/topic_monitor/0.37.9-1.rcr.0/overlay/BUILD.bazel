load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PYTHON MODULE

py_library(
    name = "topic_monitor_lib",
    srcs = glob(["topic_monitor/**/*.py"]),
    data = glob(["launch/*"]),
    imports = ["."],
    deps = [
        "@example_interfaces//:py",
        "@launch",
        "@launch_ros",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

### EXECUTABLES

py_binary(
    name = "data_publisher",
    srcs = ["topic_monitor/scripts/data_publisher.py"],
    main = "topic_monitor/scripts/data_publisher.py",
    deps = [
        ":topic_monitor_lib",
    ],
)

py_binary(
    name = "topic_monitor_cli",
    srcs = ["topic_monitor/scripts/topic_monitor.py"],
    main = "topic_monitor/scripts/topic_monitor.py",
    deps = [
        ":topic_monitor_lib",
    ],
)

### DATA

ament_index(
    name = "ament_index",
    data = glob(["launch/*_launch.py"]),
    executables = [
        ":data_publisher",
        ":topic_monitor_cli",
    ],
    package_xml = "package.xml",
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [":ament_index"],
        deps = [":topic_monitor_lib"],
    )
    for f in glob(["launch/*_launch.py"])
]

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = [
            ":topic_monitor_lib",
            "@ament_{0}".format(linter),
        ],
    )
    for linter in [
        "flake8",
        "mypy",
        "pep257",
        "xmllint",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "data_publisher": "topic_monitor.scripts.data_publisher:main",
        "topic_monitor": "topic_monitor.scripts.topic_monitor:main",
    },
    data = glob(["launch/*_launch.py"]),
    package_xml = "package.xml",
    python = [":topic_monitor_lib"],
    deps = [
        ":ament_index",
        "@ament_flake8//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@example_interfaces//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
