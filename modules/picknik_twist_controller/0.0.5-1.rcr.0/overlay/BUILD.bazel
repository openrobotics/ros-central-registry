load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@controller_interface//:controller_interface": "@controller_interface//:controller_interface_library",
    "@example_interfaces//:cc_shared": "@example_interfaces//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@hardware_interface//:hardware_interface": "@hardware_interface//:hardware_interface_library",
    "@hardware_interface//:mock_components": "@hardware_interface//:mock_components_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libcap": "@rosdistro//cc:libcap_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:fmt",
]

cc_library(
    name = "picknik_twist_controller_library",
    srcs = ["src/picknik_twist_controller.cpp"],
    hdrs = [
        "include/picknik_twist_controller/picknik_twist_controller.hpp",
        "include/picknik_twist_controller/visibility_control.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/picknik_twist_controller",
    ],
    local_defines = ros_local_defines() + [
        "PICKNIK_TWIST_CONTROLLER_BUILDING_LIBRARY",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "picknik_twist_controller",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":picknik_twist_controller_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":picknik_twist_controller"],
    package_xml = "package.xml",
    plugin_category = "controller_interface",
    plugins = ["controller_plugins.xml"],
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@controller_interface//:ament_package",
        "@example_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@hardware_interface//:ament_package",
        "@rclcpp//:ament_package",
        "@realtime_tools//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "controller_interface",
        "hardware_interface",
        "geometry_msgs",
        "example_interfaces",
        "realtime_tools",
    ],
    cmake_export_targets = False,
    headers = [
        "include/picknik_twist_controller/picknik_twist_controller.hpp",
        "include/picknik_twist_controller/visibility_control.h",
    ],
    include_prefix = "",
    libraries = [":picknik_twist_controller"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@controller_interface//:ament_package",
        "@example_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@hardware_interface//:ament_package",
        "@rclcpp//:ament_package",
        "@realtime_tools//:ament_package",
    ],
)
