load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@backward_ros//:backward": "@backward_ros//:backward_library",
    "@kdl_parser//:kdl_parser": "@kdl_parser//:kdl_parser_library",
    "@kinematics_interface//:kinematics_interface": "@kinematics_interface//:kinematics_interface_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@tf2_eigen_kdl//:tf2_eigen_kdl": "@tf2_eigen_kdl//:tf2_eigen_kdl_library",
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "kinematics_interface_kdl_library",
    srcs = ["src/kinematics_interface_kdl.cpp"],
    hdrs = ["include/kinematics_interface_kdl/kinematics_interface_kdl.hpp"] + [
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/kinematics_interface_kdl",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "kinematics_interface_kdl",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":kinematics_interface_kdl_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":kinematics_interface_kdl"],
)

ament_index(
    name = "ament_index",
    libraries = [":kinematics_interface_kdl"],
    package_xml = "package.xml",
    plugin_category = "kinematics_interface",
    plugins = ["kinematics_interface_kdl.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@backward_ros//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@kdl_parser//:ament_package",
        "@kinematics_interface//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@tf2_eigen_kdl//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "Eigen3",
        "kdl_parser",
        "kinematics_interface",
        "pluginlib",
        "tf2_eigen_kdl",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_kinematics_interface_kdl",
    headers = ["include/kinematics_interface_kdl/kinematics_interface_kdl.hpp"],
    libraries = [":kinematics_interface_kdl"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@backward_ros//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@kdl_parser//:ament_package",
        "@kinematics_interface//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@tf2_eigen_kdl//:ament_package",
    ],
)
