load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

CC_DEPS = [
]

cc_library(
    name = "color_util_library",
    srcs = ["src/convert.cpp"],
    hdrs = [
        "include/color_util/blend.hpp",
        "include/color_util/convert.hpp",
        "include/color_util/named_colors.hpp",
        "include/color_util/types.hpp",
    ],
    includes = [
        ".",
        "include",
        "include/color_util",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "color_util",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":color_util_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":color_util"],
)

py_library(
    name = "color_util_py",
    srcs = [
        "color_util/__init__.py",
        "color_util/blend.py",
        "color_util/convert.py",
        "color_util/named_colors.py",
        "color_util/types.py",
    ],
    imports = ["."],
    deps = ["@std_msgs//:py"],
)

ament_index(
    name = "ament_index",
    libraries = [":color_util"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_color_util",
    headers = [
        "include/color_util/blend.hpp",
        "include/color_util/convert.hpp",
        "include/color_util/named_colors.hpp",
        "include/color_util/types.hpp",
    ],
    include_prefix = "",
    libraries = [":color_util"],
    package_xml = "package.xml",
    python = [":color_util_py"],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
