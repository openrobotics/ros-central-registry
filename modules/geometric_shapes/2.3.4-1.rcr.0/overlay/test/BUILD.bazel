load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@resource_retriever//:resource_retriever": "@resource_retriever//:resource_retriever_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
}

CC_DEPS = [
    "@eigen_stl_containers//:eigen_stl_containers",
    "@geometry_msgs//:cc",
    "@random_numbers//:random_numbers_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:assimp",
    "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.math",
    "@rosdistro//cc:boost.variant",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fcl",
    "@rosdistro//cc:octomap",
    "@rosdistro//cc:qhull_r",
    "@shape_msgs//:cc",
    "@visualization_msgs//:cc",
]

[cc_test(
    name = test_name,
    srcs = [test_name + ".cpp"] + [] + ["//:gen_test_resources_config_h"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "CMakeLists.txt",
        "resources/box.dae",
        "resources/config.h.in",
        "resources/cube.stl",
        "resources/forearm_roll.stl",
        "resources/triangle.stl",
        "resources/triangle_10m.dae",
        "resources/triangle_1m.dae",
        "resources/triangle_no_unit.dae",
        "resources/triangle_no_up.dae",
        "resources/triangle_x_up.dae",
        "resources/triangle_y_up.dae",
        "resources/triangle_z_up.dae",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:geometric_shapes_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
) for test_name in [
    "test_basics",
    "test_body_operations",
    "test_bounding_box",
    "test_bounding_cylinder",
    "test_bounding_sphere",
    "test_create_mesh",
    "test_loaded_meshes",
    "test_point_inclusion",
    "test_ray_intersection",
    "test_shapes",
]]
