load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/geometric_shapes/aabb.h",
        "include/geometric_shapes/bodies.h",
        "include/geometric_shapes/body_operations.h",
        "include/geometric_shapes/check_isometry.h",
        "include/geometric_shapes/mesh_operations.h",
        "include/geometric_shapes/obb.h",
        "include/geometric_shapes/shape_extents.h",
        "include/geometric_shapes/shape_messages.h",
        "include/geometric_shapes/shape_operations.h",
        "include/geometric_shapes/shape_to_marker.h",
        "include/geometric_shapes/shapes.h",
        "include/geometric_shapes/solid_primitive_dims.h",
    ] + [":gen_test_resources_config_h"],
    includes = ["_gen/include"],
)

DEPENDENCIES = {
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@random_numbers//:random_numbers": "@random_numbers//:random_numbers_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@resource_retriever//:resource_retriever": "@resource_retriever//:resource_retriever_library",
    "@rosdistro//cc:assimp_shared": "@rosdistro//cc:assimp",
    "@rosdistro//cc:boost.chrono_shared": "@rosdistro//cc:boost.chrono",
    "@rosdistro//cc:boost.container_shared": "@rosdistro//cc:boost.container",
    "@rosdistro//cc:boost.filesystem_shared": "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.thread_shared": "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:ccd_shared": "@rosdistro//cc:ccd",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:curl": "@rosdistro//cc:curl_library",
    "@rosdistro//cc:fcl_shared": "@rosdistro//cc:fcl",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:octomap_shared": "@rosdistro//cc:octomap",
    "@rosdistro//cc:qhull_r_shared": "@rosdistro//cc:qhull_r",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
    "@shape_msgs//:cc_shared": "@shape_msgs//:cc",
    "@visualization_msgs//:cc_shared": "@visualization_msgs//:cc",
}

CC_DEPS = [
    "@eigen_stl_containers//:eigen_stl_containers",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.math",
    "@rosdistro//cc:boost.variant",
    "@rosdistro//cc:eigen",
]

expand_template(
    name = "gen_test_resources_config_h",
    out = "_gen/include/resources/config.h",
    substitutions = {
        "@TEST_RESOURCES_DIR@": "../geometric_shapes+/test/resources",
    },
    template = "//test:resources/config.h.in",
)

cc_library(
    name = "geometric_shapes_library",
    srcs = [
        "src/aabb.cpp",
        "src/bodies.cpp",
        "src/body_operations.cpp",
        "src/mesh_operations.cpp",
        "src/obb.cpp",
        "src/shape_extents.cpp",
        "src/shape_operations.cpp",
        "src/shape_to_marker.cpp",
        "src/shapes.cpp",
    ],
    hdrs = [
        "include/geometric_shapes/aabb.h",
        "include/geometric_shapes/bodies.h",
        "include/geometric_shapes/body_operations.h",
        "include/geometric_shapes/check_isometry.h",
        "include/geometric_shapes/mesh_operations.h",
        "include/geometric_shapes/obb.h",
        "include/geometric_shapes/shape_extents.h",
        "include/geometric_shapes/shape_messages.h",
        "include/geometric_shapes/shape_operations.h",
        "include/geometric_shapes/shape_to_marker.h",
        "include/geometric_shapes/shapes.h",
        "include/geometric_shapes/solid_primitive_dims.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/geometric_shapes",
    ],
    local_defines = ros_local_defines() + ["NDEBUG"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "geometric_shapes",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":geometric_shapes_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":geometric_shapes"],
)

ament_index(
    name = "ament_index",
    libraries = [":geometric_shapes"],
    package_xml = "package.xml",
    sonames = {"geometric_shapes": ["libgeometric_shapes.so.2.3.4"]},
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_cmake//:ament_package",
        "@console_bridge_vendor//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@eigen_stl_containers//:ament_package",
        "@geometry_msgs//:ament_package",
        "@random_numbers//:ament_package",
        "@rclcpp//:ament_package",
        "@resource_retriever//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@shape_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "Boost",
        "Eigen3",
        "console_bridge",
        "console_bridge_vendor",
        "eigen3_cmake_module",
        "eigen_stl_containers",
        "geometry_msgs",
        "random_numbers",
        "rclcpp",
        "resource_retriever",
        "shape_msgs",
        "visualization_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/geometric_shapes/aabb.h",
        "include/geometric_shapes/bodies.h",
        "include/geometric_shapes/body_operations.h",
        "include/geometric_shapes/check_isometry.h",
        "include/geometric_shapes/mesh_operations.h",
        "include/geometric_shapes/obb.h",
        "include/geometric_shapes/shape_extents.h",
        "include/geometric_shapes/shape_messages.h",
        "include/geometric_shapes/shape_operations.h",
        "include/geometric_shapes/shape_to_marker.h",
        "include/geometric_shapes/shapes.h",
        "include/geometric_shapes/solid_primitive_dims.h",
    ],
    include_prefix = "",
    libraries = [":geometric_shapes"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_cmake//:ament_package",
        "@console_bridge_vendor//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@eigen_stl_containers//:ament_package",
        "@geometry_msgs//:ament_package",
        "@random_numbers//:ament_package",
        "@rclcpp//:ament_package",
        "@resource_retriever//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@shape_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
