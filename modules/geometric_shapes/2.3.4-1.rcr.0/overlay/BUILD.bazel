cc_library(
    name = "geometric_shapes_library",
    srcs = [":gen_geometric_shapes_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_octomap_color_octree_h",
        ":gen_octomap_h",
        ":gen_octomap_msgs_conversions_h",
        ":gen_octomap_octree_key_h",
        ":gen_octomap_ros_conversions_hpp",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
