load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rosgraph_monitor_msgs//:cc_shared": "@rosgraph_monitor_msgs//:cc",
    "@rosidl_runtime_cpp//:rosidl_runtime_cpp": "@rosidl_runtime_cpp//:rosidl_runtime_cpp_library",
    "@rosidl_typesupport_cpp//:rosidl_typesupport_cpp": "@rosidl_typesupport_cpp//:rosidl_typesupport_cpp_library",
}

CC_DEPS = [
]

cc_library(
    name = "rmw_stats_shim_library",
    srcs = [
        "src/shim.cpp",
        "src/stat_collector.cpp",
        "src/timer.cpp",
    ],
    hdrs = [
        "include/rmw_stats_shim/rolling_mean_accumulator.hpp",
        "include/rmw_stats_shim/shim.h",
        "include/rmw_stats_shim/stat_collector.hpp",
        "include/rmw_stats_shim/timer.hpp",
    ],
    includes = [
        "include",
        "include/rmw_stats_shim",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rmw_stats_shim",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rmw_stats_shim_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":rmw_stats_shim"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosgraph_monitor_msgs//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
        "@rosidl_typesupport_cpp//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "rmw_stats_shimTargets",
    headers = [
        "include/rmw_stats_shim/rolling_mean_accumulator.hpp",
        "include/rmw_stats_shim/shim.h",
        "include/rmw_stats_shim/stat_collector.hpp",
        "include/rmw_stats_shim/timer.hpp",
    ],
    include_prefix = "",
    libraries = [":rmw_stats_shim"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosgraph_monitor_msgs//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
        "@rosidl_typesupport_cpp//:ament_package",
    ],
)
