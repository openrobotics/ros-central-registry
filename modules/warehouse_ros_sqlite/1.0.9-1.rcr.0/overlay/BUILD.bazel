}

CC_DEPS = [
    "@class_loader//:class_loader_Test_Fviz_library",
    "@class_loader//:class_loader_headers",
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
