cc_library(
    name = "warehouse_ros_sqlite_library",
    srcs = [
        "src/database_connection.cpp",
        "src/message_collection_helper.cpp",
        "src/metadata.cpp",
        "src/query.cpp",
        "src/result_iteration_helper.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ) + [":gen_extra_0"],
    copts = ["-std=c++20"],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/warehouse_ros_sqlite",
        "include",
        "include/warehouse_ros_sqlite",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "warehouse_ros_sqlite",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":warehouse_ros_sqlite_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":warehouse_ros_sqlite"],
)

write_file(
    name = "gen_extra_0",
    out = "_gen/include/warehouse_ros_sqlite/warehouse_ros_sqlite_export.hpp",
    content = ["\n#ifndef WAREHOUSE_ROS_SQLITE_EXPORT_H\n#define WAREHOUSE_ROS_SQLITE_EXPORT_H\n\n#ifdef WAREHOUSE_ROS_SQLITE_STATIC_DEFINE\n#  define WAREHOUSE_ROS_SQLITE_EXPORT\n#  define WAREHOUSE_ROS_SQLITE_NO_EXPORT\n#else\n#  ifndef WAREHOUSE_ROS_SQLITE_EXPORT\n#    ifdef warehouse_ros_sqlite_EXPORTS\n        /* We are building this library */\n#      define WAREHOUSE_ROS_SQLITE_EXPORT __attribute__((visibility(\"default\")))\n#    else\n        /* We are using this library */\n#      define WAREHOUSE_ROS_SQLITE_EXPORT __attribute__((visibility(\"default\")))\n#    endif\n#  endif\n\n#  ifndef WAREHOUSE_ROS_SQLITE_NO_EXPORT\n#    define WAREHOUSE_ROS_SQLITE_NO_EXPORT __attribute__((visibility(\"hidden\")))\n#  endif\n#endif\n\n#ifndef WAREHOUSE_ROS_SQLITE_DEPRECATED\n#  define WAREHOUSE_ROS_SQLITE_DEPRECATED __attribute__ ((__deprecated__))\n#endif\n\n#ifndef WAREHOUSE_ROS_SQLITE_DEPRECATED_EXPORT\n#  define WAREHOUSE_ROS_SQLITE_DEPRECATED_EXPORT WAREHOUSE_ROS_SQLITE_EXPORT WAREHOUSE_ROS_SQLITE_DEPRECATED\n#endif\n\n#ifndef WAREHOUSE_ROS_SQLITE_DEPRECATED_NO_EXPORT\n#  define WAREHOUSE_ROS_SQLITE_DEPRECATED_NO_EXPORT WAREHOUSE_ROS_SQLITE_NO_EXPORT WAREHOUSE_ROS_SQLITE_DEPRECATED\n#endif\n\n/* NOLINTNEXTLINE(readability-avoid-unconditional-preprocessor-if) */\n#if 0 /* DEFINE_NO_DEPRECATED */\n#  ifndef WAREHOUSE_ROS_SQLITE_NO_DEPRECATED\n#    define WAREHOUSE_ROS_SQLITE_NO_DEPRECATED\n#  endif\n#endif\n\n#endif /* WAREHOUSE_ROS_SQLITE_EXPORT_H */\n"],
)

pkg_files(
    name = "pkg_files_extra_0",
    srcs = [":gen_extra_0"],
    prefix = "include/warehouse_ros_sqlite",
)

ament_index(
    name = "ament_index",
    libraries = [":warehouse_ros_sqlite"],
    package_xml = "package.xml",
    plugin_category = "warehouse_ros",
