load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_exports_header", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@class_loader//:class_loader": "@class_loader//:class_loader_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:boost.chrono_shared": "@rosdistro//cc:boost.chrono",
    "@rosdistro//cc:boost.container_shared": "@rosdistro//cc:boost.container",
    "@rosdistro//cc:boost.filesystem_shared": "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.thread_shared": "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:boringssl": "@rosdistro//cc:boringssl_crypto_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:sqlite3": "@rosdistro//cc:sqlite3_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@warehouse_ros//:warehouse_ros": "@warehouse_ros//:warehouse_ros_library",
}

CC_DEPS = [
    "@class_loader//:class_loader_headers",
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.format",
    "@rosdistro//cc:boost.smart_ptr",
    "@rosdistro//cc:boost.variant",
    "@rosdistro//cc:boringssl_ssl_library",
]

cc_library(
    name = "warehouse_ros_sqlite_library",
    srcs = [
        "src/database_connection.cpp",
        "src/message_collection_helper.cpp",
        "src/metadata.cpp",
        "src/query.cpp",
        "src/result_iteration_helper.cpp",
    ],
    hdrs = [
        "include/warehouse_ros_sqlite/database_connection.hpp",
        "include/warehouse_ros_sqlite/exceptions.hpp",
        "include/warehouse_ros_sqlite/impl/variant.hpp",
        "include/warehouse_ros_sqlite/message_collection_helper.hpp",
        "include/warehouse_ros_sqlite/metadata.hpp",
        "include/warehouse_ros_sqlite/query.hpp",
        "include/warehouse_ros_sqlite/result_iteration_helper.hpp",
        "include/warehouse_ros_sqlite/utils.hpp",
    ] + [":warehouse_ros_sqlite_export_hpp"],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/warehouse_ros_sqlite",
        "include",
        "include/warehouse_ros_sqlite",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "warehouse_ros_sqlite",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":warehouse_ros_sqlite_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":warehouse_ros_sqlite"],
)

ros_exports_header(
    name = "warehouse_ros_sqlite_export_hpp",
    out = "_gen/include/warehouse_ros_sqlite/warehouse_ros_sqlite_export.hpp",
    library = "warehouse_ros_sqlite",
)

ament_index(
    name = "ament_index",
    libraries = [":warehouse_ros_sqlite"],
    package_xml = "package.xml",
    plugin_category = "warehouse_ros",
    plugins = ["sqlite_database_connection_plugin_description.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@class_loader//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@warehouse_ros//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "OpenSSL",
        "SQLite3",
        "ament_cmake",
        "class_loader",
        "rclcpp",
        "warehouse_ros",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_warehouse_ros_sqlite",
    headers = [":warehouse_ros_sqlite_export_hpp"],
    include_prefix = "",
    libraries = [":warehouse_ros_sqlite"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@class_loader//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@warehouse_ros//:ament_package",
    ],
)
