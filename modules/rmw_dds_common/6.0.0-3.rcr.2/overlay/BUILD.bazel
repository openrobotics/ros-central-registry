load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

exports_files(["package.xml"])

### LIBRARY

HEADERS = glob([
    "include/**/*.h",
    "include/**/*.hpp",
])

DEPENDENCIES = {
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rmw_security_common//:rmw_security_common": "@rmw_security_common//:rmw_security_common_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
}

cc_library(
    name = "rmw_dds_common_library",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "//msg:c",
        "//msg:cc",
    ],
)

cc_shared_library(
    name = "rmw_dds_common",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rmw_dds_common_library"],
    deps = [":rmw_dds_common_library"],
)

### TRANSITIVELY COLLECT ALL DYNAMIC DEPS TO ENSURE LINKING WORKS

# This is a workaround for the fact that dynamic_deps does not work transitively.
# So, if you have a (foo -> bar -> baz) dynamic_dep dep chain, the symbols from
# foo will not be available to baz at compile-time. This resolves that by running
# an aspect over the dynamic_deps attribute to collect everything in the chain.

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rmw_dds_common"],
    visibility = ["//visibility:private"],
)

### TESTING

cc_test(
    name = "benchmark_graph_cache",
    timeout = "short",
    srcs = ["test/benchmark/benchmark_graph_cache.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["include"],
    local_defines = ros_local_defines(),
    tags = ["manual"],
    deps = DEPENDENCIES.values() + [
        ":rmw_dds_common_library",
        "@google_benchmark//:benchmark_main",
        "@osrf_testing_tools_cpp//:memory_tools",
        "@performance_test_fixture",
    ],
)

[
    cc_test(
        name = test,
        timeout = "short",
        srcs = [
            "test/allocator_testing_utils.h",
            "test/" + test + ".cpp",
        ],
        dynamic_deps = [":transitive_dynamic_deps"],
        local_defines = ros_local_defines(),
        deps = DEPENDENCIES.values() + [
            ":rmw_dds_common_library",
            "@osrf_testing_tools_cpp//:memory_tools",
            "@rosdistro//cc:googletest",
        ],
    )
    for test in [
        "test_gid_utils",
        "test_graph_cache",
        "test_qos",
        "test_time_utils",
    ]
]

### PACKAGING

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:Gid",
        "//msg:NodeEntitiesInfo",
        "//msg:ParticipantEntitiesInfo",
    ],
)

rosidl_ament_package(
    name = "ament_package",
    headers = HEADERS,
    interface_library = "rmw_dds_common_library",
    interface_library_export = "rmw_dds_common_library",
    interface_library_link_libraries = [
        "rcutils::rcutils",
        "rmw_security_common::rmw_security_common_library",
        "rmw::rmw",
        "rmw_dds_common::rmw_dds_common__rosidl_typesupport_cpp",
    ],
    interface_library_location = "lib/librmw_dds_common.so",
    libraries = [":rmw_dds_common"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@osrf_testing_tools_cpp//:ament_package",
        "@performance_test_fixture//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rmw_security_common//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
    ],
)
