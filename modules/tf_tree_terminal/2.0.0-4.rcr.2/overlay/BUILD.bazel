package(default_visibility = ["//visibility:public"])

py_library(
    name = "tf_tree_terminal",
    srcs = glob(["tf_tree_terminal/**/*.py"]),
    imports = ["."],
    deps = [
        "@geometry_msgs//:py",
        "@rclpy",
        requirement("pyyaml"),
    ],
)

py_pytest(
    name = "test_tf_tree_cli",
    srcs = ["test/test_tf_tree_cli.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":tf_tree_terminal"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_programs = {"tf-tree": "tf_tree_terminal.tree_node:main"},
    console_scripts = {"show": "tf_tree_terminal.tree_node:main"},
    executables = ["bin/tf-tree"],
    package_xml = "package.xml",
    python = [":tf_tree_terminal"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
