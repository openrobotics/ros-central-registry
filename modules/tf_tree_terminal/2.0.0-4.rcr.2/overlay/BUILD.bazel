load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

py_library(
    name = "tf_tree_terminal",
    srcs = [
        "tf_tree_terminal/__init__.py",
        "tf_tree_terminal/tree_node.py",
    ],
    imports = ["."],
    deps = [
        "@geometry_msgs//:py",
        "@rclpy",
        requirement("pyyaml"),
    ],
)

ament_package(
    name = "ament_package",
    console_programs = {"tf-tree": "tf_tree_terminal.tree_node:main"},
    console_scripts = {"show": "tf_tree_terminal.tree_node:main"},
    executables = ["bin/tf-tree"],
    package_xml = "package.xml",
    python = [":tf_tree_terminal"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
