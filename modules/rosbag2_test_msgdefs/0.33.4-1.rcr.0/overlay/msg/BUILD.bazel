load("@rosidl_default_generators//:defs.bzl", "ros_idl", "ros_message")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BasicIdl.idl",
    "BasicMsg.msg",
    "ComplexIdl.idl",
    "ComplexMsg.msg",
    "ComplexMsgDependsOnIdl.msg",
    "ComplexWithRelativeDep.idl",
])

ros_idl(
    name = "BasicIdl",
    src = "BasicIdl.idl",
)

ros_message(
    name = "BasicMsg",
    src = "BasicMsg.msg",
)

ros_idl(
    name = "ComplexIdl",
    src = "ComplexIdl.idl",
    deps = [
        ":BasicIdl",
    ],
)

ros_message(
    name = "ComplexMsg",
    src = "ComplexMsg.msg",
    deps = [
        ":BasicMsg",
    ],
)

ros_message(
    name = "ComplexMsgDependsOnIdl",
    src = "ComplexMsgDependsOnIdl.msg",
    deps = [
        ":BasicIdl",
    ],
)

ros_idl(
    name = "ComplexWithRelativeDep",
    src = "ComplexWithRelativeDep.idl",
    deps = [
        ":BasicIdl",
    ],
)
