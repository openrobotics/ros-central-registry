load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@dynamixel_sdk//:dynamixel_sdk": "@dynamixel_sdk//:dynamixel_sdk_library",
}

CC_DEPS = [
]

cc_library(
    name = "dynamixel_workbench_toolbox_library",
    srcs = [
        "src/dynamixel_workbench_toolbox/dynamixel_driver.cpp",
        "src/dynamixel_workbench_toolbox/dynamixel_item.cpp",
        "src/dynamixel_workbench_toolbox/dynamixel_tool.cpp",
        "src/dynamixel_workbench_toolbox/dynamixel_workbench.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    includes = [
        "include",
        "include/dynamixel_workbench_toolbox",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "dynamixel_workbench_toolbox",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":dynamixel_workbench_toolbox_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":dynamixel_workbench_toolbox"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@dynamixel_sdk//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = ["dynamixel_sdk"],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_dynamixel_workbench_toolbox",
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
        ],
        allow_empty = True,
    ),
    libraries = [":dynamixel_workbench_toolbox"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@dynamixel_sdk//:ament_package",
    ],
)
