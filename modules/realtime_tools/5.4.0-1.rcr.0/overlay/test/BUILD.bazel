    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.lockfree",
    "@rosdistro//cc:fmt",
    "@test_msgs//:cc",
]

cc_test(
    name = "lock_free_queue_tests",
    srcs = ["lock_free_queue_tests.cpp"] + ["test_async_function_handler.hpp"],
    data = ["//:ament_index"] + [
        "realtime_publisher.test",
        "realtime_server_goal_handle.test",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:realtime_tools_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

