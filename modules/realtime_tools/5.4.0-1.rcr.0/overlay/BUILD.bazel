    copts = [
        "-std=c++20",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/sys",
        "include",
        "include/realtime_tools",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "thread_priority",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":thread_priority_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

write_file(
    name = "gen_sys_capability_h",
    out = "_gen/include/sys/capability.h",
    content = ["#ifndef RCR_SYS_CAPABILITY_H_\n#define RCR_SYS_CAPABILITY_H_\nusing cap_value_t = int;\nusing cap_t = void *;\nconstexpr int CAP_EFFECTIVE = 0;\nconstexpr int CAP_SET = 1;\nconstexpr int CAP_IPC_LOCK = 14;\ninline cap_t cap_get_proc() { return nullptr; }\ninline int cap_set_flag(cap_t, int, int, const cap_value_t *, int) { return -1; }\ninline int cap_set_proc(cap_t) { return -1; }\ninline int cap_free(void *) { return 0; }\n#endif\n"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":realtime_tools",
        ":thread_priority",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@rclcpp//:ament_package",
