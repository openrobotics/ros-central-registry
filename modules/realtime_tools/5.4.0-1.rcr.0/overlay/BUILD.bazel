load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/realtime_tools/async_function_handler.hpp",
        "include/realtime_tools/lock_free_queue.hpp",
        "include/realtime_tools/mutex.hpp",
        "include/realtime_tools/realtime_buffer.hpp",
        "include/realtime_tools/realtime_helpers.hpp",
        "include/realtime_tools/realtime_publisher.hpp",
        "include/realtime_tools/realtime_server_goal_handle.hpp",
        "include/realtime_tools/realtime_thread_safe_box.hpp",
    ],
    includes = [],
    deps = ["@rosdistro//cc:libcap_library"],
)

DEPENDENCIES = {
    "@lifecycle_msgs//:cc_shared": "@lifecycle_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:libcap": "@rosdistro//cc:libcap_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@test_msgs//:cc_shared": "@test_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.lockfree",
    "@rosdistro//cc:fmt",
]

cc_library(
    name = "realtime_tools_library",
    srcs = ["src/realtime_helpers.cpp"],
    hdrs = [
        "include/realtime_tools/async_function_handler.hpp",
        "include/realtime_tools/lock_free_queue.hpp",
        "include/realtime_tools/mutex.hpp",
        "include/realtime_tools/realtime_buffer.hpp",
        "include/realtime_tools/realtime_helpers.hpp",
        "include/realtime_tools/realtime_publisher.hpp",
        "include/realtime_tools/realtime_server_goal_handle.hpp",
        "include/realtime_tools/realtime_thread_safe_box.hpp",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/sys",
        "include",
        "include/realtime_tools",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "realtime_tools",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":realtime_tools_library"],
)

cc_library(
    name = "thread_priority_library",
    srcs = ["src/realtime_helpers.cpp"],
    hdrs = [
        "include/realtime_tools/async_function_handler.hpp",
        "include/realtime_tools/lock_free_queue.hpp",
        "include/realtime_tools/mutex.hpp",
        "include/realtime_tools/realtime_buffer.hpp",
        "include/realtime_tools/realtime_helpers.hpp",
        "include/realtime_tools/realtime_publisher.hpp",
        "include/realtime_tools/realtime_server_goal_handle.hpp",
        "include/realtime_tools/realtime_thread_safe_box.hpp",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/sys",
        "include",
        "include/realtime_tools",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "thread_priority",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":thread_priority_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":realtime_tools",
        ":thread_priority",
    ],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":realtime_tools",
        ":thread_priority",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@test_msgs//:ament_package",
    ],
)

ament_package(
    cmake = ["cmake/realtime_tools-extras.cmake"],
    cmake_export_dependencies_list = [
        "Threads",
        "fmt",
        "rclcpp",
        "rclcpp_action",
        "rcpputils",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_realtime_tools",
    cmake_extras = ["realtime_tools-extras.cmake"],
    headers = [
        "include/realtime_tools/async_function_handler.hpp",
        "include/realtime_tools/lock_free_queue.hpp",
        "include/realtime_tools/mutex.hpp",
        "include/realtime_tools/realtime_buffer.hpp",
        "include/realtime_tools/realtime_helpers.hpp",
        "include/realtime_tools/realtime_publisher.hpp",
        "include/realtime_tools/realtime_server_goal_handle.hpp",
        "include/realtime_tools/realtime_thread_safe_box.hpp",
    ],
    libraries = [
        ":realtime_tools",
        ":thread_priority",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
