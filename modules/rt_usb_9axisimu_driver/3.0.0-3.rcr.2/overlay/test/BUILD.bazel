load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

_FAKEIT_FILES = [
    "include/boost/fakeit.hpp",
    "include/catch/fakeit.hpp",
    "include/cute/fakeit.hpp",
    "include/doctest/fakeit.hpp",
    "include/gtest/fakeit.hpp",
    "include/mettle/fakeit.hpp",
    "include/mstest/fakeit.hpp",
    "include/nunit/fakeit.hpp",
    "include/qtest/fakeit.hpp",
    "include/standalone/fakeit.hpp",
    "include/tpunit/fakeit.hpp",
    "lib/cmake/FakeIt/FakeItConfig.cmake",
    "lib/cmake/FakeIt/FakeItConfigVersion.cmake",
]

cc_test(
    name = "test_driver",
    size = "small",
    srcs = [
        "fakeit.hpp",
        "test_driver.cpp",
    ],
    includes = ["."],
    deps = [
        "//:rt_usb_9axisimu_driver_component_library",
        "@rosdistro//cc:googletest",
    ],
)

genrule(
    name = "fakeit_install_gen",
    srcs = ["fakeit.hpp"],
    outs = ["fakeit_install/" + f for f in _FAKEIT_FILES],
    cmd = " && ".join(["cp $(location fakeit.hpp) $(location fakeit_install/" + f + ")" for f in _FAKEIT_FILES]),
)
