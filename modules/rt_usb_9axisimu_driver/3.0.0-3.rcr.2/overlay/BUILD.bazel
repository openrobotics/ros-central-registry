load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = [
    "include/rt_usb_9axisimu_driver/rt_usb_9axisimu.hpp",
    "include/rt_usb_9axisimu_driver/rt_usb_9axisimu_driver.hpp",
    "include/rt_usb_9axisimu_driver/rt_usb_9axisimu_driver_component.hpp",
    "include/rt_usb_9axisimu_driver/visibility_control.h",
]

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@std_srvs//:cc_shared": "@std_srvs//:cc",
}

cc_library(
    name = "rt_usb_9axisimu_driver_component_library",
    srcs = [
        "src/rt_usb_9axisimu_driver.cpp",
        "src/rt_usb_9axisimu_driver_component.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["RT_USB_9AXISIMU_DRIVER_BUILDING_DLL"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rt_usb_9axisimu_driver_component",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rt_usb_9axisimu_driver_component_library"],
)

rclcpp_components_register_nodes(
    name = "rt_usb_9axisimu_driver_component_nodes",
    component = ":rt_usb_9axisimu_driver_component",
    plugins = ["rt_usb_9axisimu_driver::Driver"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":rt_usb_9axisimu_driver_component"],
)

cc_binary(
    name = "rt_usb_9axisimu_driver",
    srcs = ["src/rt_usb_9axisimu_driver_node.cpp"],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [":rt_usb_9axisimu_driver_component_library"],
)

DATA = ["//launch:launch_files"]

ament_index(
    name = "ament_index",
    components = [":rt_usb_9axisimu_driver_component_nodes"],
    data = DATA,
    libraries = [":rt_usb_9axisimu_driver_component"],
    package_xml = "package.xml",
)

pkg_files(
    name = "fakeit_install_files",
    srcs = ["//test:fakeit_install_gen"],
    strip_prefix = "fakeit_install",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rclcpp",
        "rclcpp_components",
        "rclcpp_lifecycle",
        "sensor_msgs",
        "std_msgs",
        "std_srvs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_name = "export_rt_usb_9axisimu_driver",
    executables = [
        ":rt_usb_9axisimu_driver",
    ],
    headers = HEADERS,
    include_prefix = "",
    install = [":fakeit_install_files"],
    libraries = [":rt_usb_9axisimu_driver_component"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
