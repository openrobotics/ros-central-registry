load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

py_library(
    name = "test_joy_twist",
    srcs = ["test_joy_twist.py"],
    imports = ["."],
    deps = [
        "@geometry_msgs//:py",
        "@launch_testing_ros",
        "@sensor_msgs//:py",
    ],
)

[launch_ros_test(
    name = "test_{0}_joy_launch_test".format(name),
    src = "{0}_joy_launch_test.py".format(name),
    deps = [
        ":test_joy_twist",
        "//:teleop_node",
        "@rules_python//python/runfiles",
    ],
) for name in [
    "differential",
    "holonomic",
    "no_enable",
    "no_require_enable",
    "only_turbo",
    "publish_stamped_twist",
    "six_dof",
    "turbo_angular_enable",
    "turbo_enable",
]]
