load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

genrule(
    name = "generate_export_header",
    outs = ["include/teleop_twist_joy/teleop_twist_joy_export.h"],
    cmd = "echo -e '#pragma once\\n#define TELEOP_TWIST_JOY_EXPORT' > $@",
)

HEADERS = [":generate_export_header"] + glob(
    [
        "include/**/*.hpp",
        "include/**/*.h",
    ],
    allow_empty = True,
)

cc_library(
    name = "teleop_twist_joy_library",
    srcs = ["src/teleop_twist_joy.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = [
        "@geometry_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@sensor_msgs//:cc",
    ],
)

cc_shared_library(
    name = "teleop_twist_joy",
    dynamic_deps = [
        "@rclcpp",
        "@rclcpp_components",
    ],
    exports_filter = [":teleop_twist_joy_library"],
    deps = [":teleop_twist_joy_library"],
)

rclcpp_components_register_node(
    name = "node_teleop_twist_joy",
    component = ":teleop_twist_joy",
    executor = "SingleThreadedExecutor",
    node_name = "teleop_twist_joy_node",
    plugin = "teleop_twist_joy::TeleopTwistJoy",
)

cc_binary(
    name = "teleop_node",
    srcs = ["src/teleop_node.cpp"],
    local_defines = ros_local_defines(),
    deps = [
        ":teleop_twist_joy_library",
        "@rclcpp//:rclcpp_library",
    ],
)

### AMENT INDEX

ament_index(
    name = "ament_index",
    components = [":node_teleop_twist_joy_record"],
    data = glob([
        "config/**",
        "launch/**",
    ]),
    lib_data = [":teleop_node"],
    libraries = [":teleop_twist_joy"],
    package_xml = "package.xml",
)

### TESTS

py_library(
    name = "test_joy_twist",
    srcs = ["test/test_joy_twist.py"],
    imports = ["test"],
    deps = [
        "@geometry_msgs//:py",
        "@launch_testing_ros",
        "@sensor_msgs//:py",
    ],
)

[
    py_pytest(
        name = "test_" + f.split("/")[-1],
        srcs = [f],
        args = [
            "-p",
            "launch_testing.pytest.hooks",
            "-p",
            "launch_testing_ros_pytest_entrypoint",
        ],
        data = [
            ":ament_index",
            ":teleop_node",
        ],
        deps = [
            ":test_joy_twist",
            "@geometry_msgs//:py",
            "@launch_ros",
            "@launch_testing_ros",
            "@rules_python//python/runfiles",
            "@sensor_msgs//:py",
        ],
    )
    for f in glob(["test/*_launch_test.py"])
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    cmake_export_name = "export_teleop_twist_joy",
    components = [":node_teleop_twist_joy_record"],
    data = glob([
        "config/**",
        "launch/**",
    ]),
    executables = [":teleop_node"],
    headers = HEADERS,
    libraries = [":teleop_twist_joy"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@joy//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
