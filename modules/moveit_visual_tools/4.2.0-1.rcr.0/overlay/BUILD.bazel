cc_library(
    name = "moveit_visual_tools_library",
    srcs = [
        "src/imarker_end_effector.cpp",
        "src/imarker_robot_state.cpp",
        "src/moveit_visual_tools.cpp",
    ],
    hdrs = [
        "include/moveit_visual_tools/imarker_end_effector.h",
        "include/moveit_visual_tools/imarker_robot_state.h",
        "include/moveit_visual_tools/moveit_visual_tools.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/moveit_visual_tools",
    ],
    local_defines = ros_local_defines() + [
        "NDEBUG",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "moveit_visual_tools",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":moveit_visual_tools_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "moveit_visual_tools_demo",
    srcs = ["src/moveit_visual_tools_demo.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/moveit_visual_tools",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines() + [
        "NDEBUG",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":moveit_visual_tools_library"],
)

