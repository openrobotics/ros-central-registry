cc_library(
    name = "ffw_swerve_drive_controller_library",
    srcs = [
        "src/marker_visualize.cpp",
        "src/odometry.cpp",
        "src/speed_limiter.cpp",
        "src/swerve_drive_controller.cpp",
    ],
    hdrs = [
        "include/ffw_swerve_drive_controller/marker_visualize.hpp",
        "include/ffw_swerve_drive_controller/odometry.hpp",
        "include/ffw_swerve_drive_controller/speed_limiter.hpp",
        "include/ffw_swerve_drive_controller/swerve_drive_controller.hpp",
    ] + [":swerve_drive_controller_parameter_gen"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "_gen/include/ffw_swerve_drive_controller",
        "include",
        "include/ffw_swerve_drive_controller",
    ],
    local_defines = ros_local_defines() + [
        "RCPPUTILS_VERSION_MAJOR=2",
        "RCPPUTILS_VERSION_MINOR=14",
        "SWERVE_DRIVE_CONTROLLER_BUILDING_LIBRARY",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

