load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
)

DEPENDENCIES = {
    "@mola_kernel//:mola_kernel": "@mola_kernel//:mola_kernel_library",
    "@mrpt_maps//:mrpt_maps": "@mrpt_maps//:mrpt_maps_library",
    "@mrpt_math//:mrpt_math": "@mrpt_math//:mrpt_math_library",
    "@mrpt_poses//:mrpt_poses": "@mrpt_poses//:mrpt_poses_library",
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "mola_input_mulran_dataset_library",
    srcs = ["src/MulranDataset.cpp"],
    hdrs = ["include/mola_input_mulran_dataset/MulranDataset.h"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/mola_input_mulran_dataset",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=3",
        "MOLA_PATCH_VERSION=0",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_input_mulran_dataset",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mola_input_mulran_dataset_library"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mola_input_mulran_dataset",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_input_mulran_dataset": [
            "libmola_input_mulran_dataset.so.3.1",
            "libmola_input_mulran_dataset.so.3.1.0",
        ],
    },
    deps = [
        "@mola_common//:ament_package",
        "@mola_kernel//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_math//:ament_package",
        "@mrpt_poses//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = ["include/mola_input_mulran_dataset/MulranDataset.h"],
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mola_input_mulran_dataset",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_input_mulran_dataset": [
            "libmola_input_mulran_dataset.so.3.1",
            "libmola_input_mulran_dataset.so.3.1.0",
        ],
    },
    deps = [":ament_index"] + [
        "@mola_common//:ament_package",
        "@mola_kernel//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_math//:ament_package",
        "@mrpt_poses//:ament_package",
    ],
)
