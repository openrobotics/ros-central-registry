load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

generate_parameter_library(
    name = "ackermann_steering_controller_parameters",
    yaml_file = "src/ackermann_steering_controller.yaml",
)

DEPENDENCIES = {
    "@backward_ros//:backward": "@backward_ros//:backward_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    ":ackermann_steering_controller_parameters",
    "@ros2_control_test_assets//:ros2_control_test_assets",
    "@control_msgs//:cc",
    "@controller_interface//:controller_interface_library",
    "@controller_manager//:controller_manager_library",
    "@generate_parameter_library//:generate_parameter_library",
    "@hardware_interface//:hardware_interface_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
    "@std_srvs//:cc",
    "@steering_controllers_library//:steering_controllers_library_library",
]

cc_library(
    name = "ackermann_steering_controller_library",
    srcs = ["src/ackermann_steering_controller.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":ackermann_steering_controller_parameters_gen",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/ackermann_steering_controller",
        "include",
        "include/ackermann_steering_controller",
    ],
    local_defines = ros_local_defines() + [
        "RCPPUTILS_VERSION_MAJOR=2",
        "RCPPUTILS_VERSION_MINOR=14",
        "TEST_FILES_DIRECTORY=\\\"test\\\"",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ackermann_steering_controller",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":ackermann_steering_controller_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    libraries = [
        ":ackermann_steering_controller",
    ],
    package_xml = "package.xml",
    plugin_category = "controller_interface",
    plugins = ["ackermann_steering_controller.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@backward_ros//:ament_package",
        "@control_msgs//:ament_package",
        "@controller_interface//:ament_package",
        "@controller_manager//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@hardware_interface//:ament_package",
        "@hardware_interface_testing//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@ros2_control_test_assets//:ament_package",
        "@std_srvs//:ament_package",
        "@steering_controllers_library//:ament_package",
    ],
)

cc_test(
