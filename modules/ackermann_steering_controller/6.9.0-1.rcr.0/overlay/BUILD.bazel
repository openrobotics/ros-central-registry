    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        ":ament_index",
    ] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/ackermann_steering_controller",
        "include",
        "include/ackermann_steering_controller",
    ],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "RCPPUTILS_VERSION_MAJOR=2",
        "RCPPUTILS_VERSION_MINOR=14",
        "TEST_FILES_DIRECTORY=\\\"test\\\"",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":ackermann_steering_controller_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

