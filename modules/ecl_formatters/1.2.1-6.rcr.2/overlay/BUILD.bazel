load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@ecl_exceptions//:ecl_exceptions": "@ecl_exceptions//:ecl_exceptions_library",
}

CC_DEPS = [
    "@ecl_config//:ecl_config",
    "@ecl_config//:ecl_config_library",
    "@ecl_converters//:ecl_converters_library",
]

cc_library(
    name = "ecl_formatters_library",
    srcs = ["src/lib/strings.cpp"],
    hdrs = [
        "include/ecl/formatters.hpp",
        "include/ecl/formatters/common.hpp",
        "include/ecl/formatters/floats.hpp",
        "include/ecl/formatters/macros.hpp",
        "include/ecl/formatters/number.hpp",
        "include/ecl/formatters/strings.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ecl_formatters",
    # ecl_converters is header-only; reuse its collected dynamic deps so that
    # ecl_type_traits (pulled in via ecl_converters_library) is linked
    # dynamically instead of being statically embedded in this library.
    dynamic_deps = DEPENDENCIES.keys() + ["@ecl_converters//:transitive_dynamic_deps"],
    exports_filter = ["//:__subpackages__"],
    deps = [":ecl_formatters_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":ecl_formatters",
        "@ecl_converters//:transitive_dynamic_deps",
    ],
)

cc_binary(
    name = "demo_formatters",
    srcs = ["src/examples/formatters.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":ecl_formatters_library"],
)

ament_index(
    name = "ament_index",
    lib_data = [
        ":demo_formatters",
    ],
    libraries = [
        ":ecl_formatters",
    ],
    package_xml = "package.xml",
    sonames = {
        "ecl_formatters": ["libecl_formatters.so.1.2.1"],
    },
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@ecl_build//:ament_package",
        "@ecl_config//:ament_package",
        "@ecl_converters//:ament_package",
        "@ecl_exceptions//:ament_package",
        "@ecl_license//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "ecl_config",
        "ecl_converters",
        "ecl_exceptions",
    ],
    headers = [
        "include/ecl/formatters.hpp",
        "include/ecl/formatters/common.hpp",
        "include/ecl/formatters/floats.hpp",
        "include/ecl/formatters/macros.hpp",
        "include/ecl/formatters/number.hpp",
        "include/ecl/formatters/strings.hpp",
    ],
    include_prefix = "",
    libraries = [
        ":ecl_formatters",
    ],
    package_xml = "package.xml",
    sonames = {
        "ecl_formatters": ["libecl_formatters.so.1.2.1"],
    },
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@ecl_build//:ament_package",
        "@ecl_config//:ament_package",
        "@ecl_converters//:ament_package",
        "@ecl_exceptions//:ament_package",
        "@ecl_license//:ament_package",
    ],
)
