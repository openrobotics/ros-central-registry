load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "ros2controlcli",
    srcs = [
        "ros2controlcli/__init__.py",
        "ros2controlcli/api/__init__.py",
        "ros2controlcli/command/__init__.py",
        "ros2controlcli/command/control.py",
        "ros2controlcli/verb/__init__.py",
        "ros2controlcli/verb/cleanup_controller.py",
        "ros2controlcli/verb/list_controller_types.py",
        "ros2controlcli/verb/list_controllers.py",
        "ros2controlcli/verb/list_hardware_components.py",
        "ros2controlcli/verb/list_hardware_interfaces.py",
        "ros2controlcli/verb/load_controller.py",
        "ros2controlcli/verb/reload_controller_libraries.py",
        "ros2controlcli/verb/set_controller_state.py",
        "ros2controlcli/verb/set_hardware_component_state.py",
        "ros2controlcli/verb/switch_controllers.py",
        "ros2controlcli/verb/unload_controller.py",
        "ros2controlcli/verb/view_controller_chains.py",
        "ros2controlcli/verb/view_hardware_status.py",
    ],
    imports = ["."],
    deps = [
        "@control_msgs//:py",
        "@controller_manager_msgs//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@ros2cli",
        "@ros2node",
        "@ros2param",
        "@rosidl_runtime_py",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":ros2controlcli"],
    deps = [
        "@control_msgs//:ament_package",
        "@controller_manager//:ament_package",
        "@controller_manager_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@ros2cli//:ament_package",
        "@ros2node//:ament_package",
        "@ros2param//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_py//:ament_package",
    ],
)
