        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_rplidar_wrapper",
    srcs = ["test_rplidar_wrapper.cpp"],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:rplidar_node_component_library",
        "//:rplidar_sdk_library",
