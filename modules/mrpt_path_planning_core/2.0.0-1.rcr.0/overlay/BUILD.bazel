load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@mrpt_containers//:mrpt_containers_library",
    "@mrpt_graphs//:mrpt_graphs_library",
    "@mrpt_maps//:mrpt_maps_library",
    "@mrpt_nav//:mrpt_nav_library",
]

cc_library(
    name = "mrpt_path_planning_library",
    srcs = [":gen_mrpt_path_planning_core_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines() + ["NDEBUG"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_path_planning",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":mrpt_path_planning_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

write_file(
    name = "gen_mrpt_path_planning_core_stub_cpp",
    out = "_gen/mrpt_path_planning_core_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_path_planning",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_path_planning": [
            "libmrpt_path_planning.so.2.0",
            "libmrpt_path_planning.so.2.0.0",
        ],
    },
    deps = [
        "@mrpt_containers//:ament_package",
        "@mrpt_graphs//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_nav//:ament_package",
    ],
)

cc_test(
    name = "run_test_astar_diffdrive",
    srcs = [":gen_mrpt_path_planning_core_stub_cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        ":ament_index",
    ] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "NDEBUG",
        "SELFDRIVING_MODULE_SOURCE_DIR=\\\"tests\\\"",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":mrpt_path_planning_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

