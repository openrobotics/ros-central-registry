load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {}

CC_DEPS = [
    "@mrpt_containers//:mrpt_containers_library",
    "@mrpt_graphs//:mrpt_graphs_library",
    "@mrpt_maps//:mrpt_maps_library",
    "@mrpt_nav//:mrpt_nav_library",
]

[
    cc_test(
        name = "run_" + test_name,
        srcs = [test_name + ".cpp"],
        copts = [
            "-O2",
            "-Wno-missing-template-arg-list-after-template-kw",
        ],
        data = ["//:ament_index"] + ["CMakeLists.txt"],
        dynamic_deps = ["//:transitive_dynamic_deps"],
        local_defines = ros_local_defines() + [
            "GTEST_HAS_PTHREAD=1",
            "NDEBUG",
            'SELFDRIVING_MODULE_SOURCE_DIR=\\"tests\\"',
        ],
        deps = DEPENDENCIES.values() + CC_DEPS + [
            "//:mrpt_path_planning_library",
            "@rosdistro//cc:bazel_test_helper",
            "@rosdistro//cc:googletest",
        ],
    )
    for test_name in [
        "test_astar_diffdrive",
        "test_astar_diffdrive_bidir",
        "test_astar_holonomic",
        "test_best_trajectory",
        "test_collision_grid_soundness",
        "test_cost_evaluator_waypoint",
        "test_costmap",
        "test_edge_interpolation",
        "test_heuristic",
        "test_motion_tree",
        "test_obstacle_cache",
        "test_reeds_shepp",
        "test_refine_trajectory",
        "test_trajectories",
        "test_trajectory_follower",
        "test_viz_svg",
    ]
]
