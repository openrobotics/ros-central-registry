load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

# Tests run with cwd = <runfiles>/_main, but this repository's own test data
# lives under <runfiles>/<canonical repo name>/ when it is an external module.
REPO_RUNFILES_PREFIX = "../%s/" % (repo_name() or "_main")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

exports_files(["src/odometry.cpp"])

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/diff_drive_controller/diff_drive_controller.hpp",
        "include/diff_drive_controller/odometry.hpp",
        "include/diff_drive_controller/speed_limiter.hpp",
    ],
    includes = [],
)

DEPENDENCIES = {
    "@backward_ros//:backward": "@backward_ros//:backward_library",
    "@control_toolbox//:control_toolbox": "@control_toolbox//:control_toolbox_library",
    "@controller_interface//:controller_interface": "@controller_interface//:controller_interface_library",
    "@controller_manager//:controller_manager": "@controller_manager//:controller_manager_library",
    "@generate_parameter_library//:rsl": "@generate_parameter_library//:rsl_library",
    "@hardware_interface//:hardware_interface": "@hardware_interface//:hardware_interface_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libcap": "@rosdistro//cc:libcap_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
}

CC_DEPS = [
    "@control_msgs//:cc",
    "@generate_parameter_library//:generate_parameter_library",
    "@geometry_msgs//:cc",
    "@lifecycle_msgs//:cc",
    "@nav_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@ros2_control_test_assets//:ros2_control_test_assets",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
    "@tf2_msgs//:cc",
]

cc_library(
    name = "diff_drive_controller_library",
    srcs = [
        "src/diff_drive_controller.cpp",
        "src/odometry.cpp",
    ],
    hdrs = [
        "include/diff_drive_controller/diff_drive_controller.hpp",
        "include/diff_drive_controller/odometry.hpp",
        "include/diff_drive_controller/speed_limiter.hpp",
    ] + [
        ":diff_drive_controller_parameters_gen",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/diff_drive_controller",
        "include",
        "include/diff_drive_controller",
    ],
    local_defines = ros_local_defines() + [
        "RCPPUTILS_VERSION_MAJOR=2",
        "RCPPUTILS_VERSION_MINOR=14",
        'TEST_FILES_DIRECTORY=\\"%stest\\"' % REPO_RUNFILES_PREFIX,
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "diff_drive_controller",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":diff_drive_controller_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":diff_drive_controller"],
)

generate_parameter_library(
    name = "diff_drive_controller_parameters",
    validate_header = "@control_toolbox//:include/control_filters/custom_validators.hpp",
    yaml_file = "src/diff_drive_controller_parameter.yaml",
)

ament_index(
    name = "ament_index",
    libraries = [":diff_drive_controller"],
    package_xml = "package.xml",
    plugin_category = "controller_interface",
    plugins = ["diff_drive_plugin.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@backward_ros//:ament_package",
        "@control_msgs//:ament_package",
        "@control_toolbox//:ament_package",
        "@controller_interface//:ament_package",
        "@controller_manager//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@geometry_msgs//:ament_package",
        "@hardware_interface//:ament_package",
        "@hardware_interface_testing//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rcpputils//:ament_package",
        "@realtime_tools//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@ros2_control_test_assets//:ament_package",
        "@tf2//:ament_package",
        "@tf2_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "control_msgs",
        "control_toolbox",
        "controller_interface",
        "fmt",
        "generate_parameter_library",
        "geometry_msgs",
        "hardware_interface",
        "nav_msgs",
        "pluginlib",
        "rclcpp",
        "rclcpp_lifecycle",
        "rcpputils",
        "realtime_tools",
        "rsl",
        "tcb_span",
        "tf2",
        "tf2_msgs",
        "tl-expected",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_diff_drive_controller",
    headers = [
        ":diff_drive_controller_parameters_gen",
        "include/diff_drive_controller/diff_drive_controller.hpp",
        "include/diff_drive_controller/odometry.hpp",
        "include/diff_drive_controller/speed_limiter.hpp",
    ],
    libraries = [":diff_drive_controller"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@backward_ros//:ament_package",
        "@control_msgs//:ament_package",
        "@control_toolbox//:ament_package",
        "@controller_interface//:ament_package",
        "@controller_manager//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@geometry_msgs//:ament_package",
        "@hardware_interface//:ament_package",
        "@hardware_interface_testing//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rcpputils//:ament_package",
        "@realtime_tools//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@ros2_control_test_assets//:ament_package",
        "@tf2//:ament_package",
        "@tf2_msgs//:ament_package",
    ],
)
