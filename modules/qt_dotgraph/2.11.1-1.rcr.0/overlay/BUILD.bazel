load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "qt_dotgraph",
    srcs = [
        "src/qt_dotgraph/__init__.py",
        "src/qt_dotgraph/colors.py",
        "src/qt_dotgraph/dot_shapes.py",
        "src/qt_dotgraph/dot_to_qt.py",
        "src/qt_dotgraph/edge_item.py",
        "src/qt_dotgraph/graph_item.py",
        "src/qt_dotgraph/node_item.py",
        "src/qt_dotgraph/pydotfactory.py",
        "src/qt_dotgraph/pygraphvizfactory.py",
    ],
    imports = ["src"],
    deps = [
        "@python_qt_binding",
        requirement("pydot"),
    ],
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":qt_dotgraph"],
    python_strip_prefix = "src",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@python_qt_binding//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
