package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "flake8",
        "xmllint",
    ]
]

py_library(
    name = "rqt_gauges",
    srcs = glob(["src/rqt_gauges/**/*.py"]),
    imports = ["src"],
    deps = [
        "@ament_index_python",
        "@qt_gui",
        "@qt_gui_py_common",
        "@rclpy",
        "@rqt_gui",
        "@rqt_gui_py",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"rqt_gauges": "rqt_gauges.main:main"},
    data = [
        "plugin.xml",
        "resource/bar.ui",
        "resource/dial.ui",
        "resource/rotational.ui",
    ],
    executables = ["resource/rqt_gauges"],
    package_xml = "package.xml",
    python = [":rqt_gauges"],
    python_strip_prefix = "src",
    deps = [
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_xmllint//:ament_package",
        "@qt_gui//:ament_package",
        "@qt_gui_py_common//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
    ],
)
