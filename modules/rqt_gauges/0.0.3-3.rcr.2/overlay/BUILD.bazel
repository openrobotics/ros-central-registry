load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            ".github/workflows/ci.yml",
            ".github/workflows/ci-format.yaml",
            ".pre-commit-config.yaml",
            "CHANGELOG.rst",
            "LICENSE",
            "README.md",
            "img/bar.png",
            "img/rqt.png",
            "img/speedometer.png",
            "img/steering_wheel.png",
            "package.xml",
            "plugin.xml",
            "pytest.ini",
            "resource/bar.ui",
            "resource/dial.ui",
            "resource/rotational.ui",
            "resource/rqt_gauges",
            "setup.cfg",
            "setup.py",
            "src/rqt_gauges/__init__.py",
            "src/rqt_gauges/bar.py",
            "src/rqt_gauges/bar_gauge.py",
            "src/rqt_gauges/base_widget.py",
            "src/rqt_gauges/dial.py",
            "src/rqt_gauges/dial_gauge.py",
            "src/rqt_gauges/main.py",
            "src/rqt_gauges/rotational.py",
            "src/rqt_gauges/rotational_gauge.py",
            "src/rqt_gauges/topic_q_line_edit.py",
            "src/rqt_gauges/utils.py",
            "test/test_flake8.py",
            "test/test_xmllint.py",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "flake8",
        "xmllint",
    ]
]

py_library(
    name = "rqt_gauges",
    srcs = [
        "src/rqt_gauges/__init__.py",
        "src/rqt_gauges/bar.py",
        "src/rqt_gauges/bar_gauge.py",
        "src/rqt_gauges/base_widget.py",
        "src/rqt_gauges/dial.py",
        "src/rqt_gauges/dial_gauge.py",
        "src/rqt_gauges/main.py",
        "src/rqt_gauges/rotational.py",
        "src/rqt_gauges/rotational_gauge.py",
        "src/rqt_gauges/topic_q_line_edit.py",
        "src/rqt_gauges/utils.py",
    ],
    imports = ["src"],
    deps = [
        "@ament_index_python",
        "@qt_gui",
        "@qt_gui_py_common",
        "@rclpy",
        "@rqt_gui",
        "@rqt_gui_py",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"rqt_gauges": "rqt_gauges.main:main"},
    data = [
        "plugin.xml",
        "resource/bar.ui",
        "resource/dial.ui",
        "resource/rotational.ui",
    ],
    executables = ["resource/rqt_gauges"],
    package_xml = "package.xml",
    python = [":rqt_gauges"],
    python_strip_prefix = "src",
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_xmllint//:ament_package",
        "@qt_gui//:ament_package",
        "@qt_gui_py_common//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
    ],
)
