load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

py_library(
    name = "open_manipulator_bringup",
    srcs = [
        "open_manipulator_bringup/__init__.py",
        "open_manipulator_bringup/joint_trajectory_executor.py",
        "open_manipulator_bringup/om_create_udev_rules.py",
    ],
    imports = ["."],
    deps = [
        "@rclpy",
        "@ros_gz_bridge//:ros_gz_bridge_py",
        requirement("numpy"),
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "config/omx_f/hardware_controller_manager.yaml",
        "config/omx_f/initial_positions.yaml",
        "config/omx_f_follower_ai/hardware_controller_manager.yaml",
        "config/omx_f_follower_ai/initial_positions.yaml",
        "config/omx_l_leader_ai/hardware_controller_manager.yaml",
        "config/omy_3m/hardware_controller_manager.yaml",
        "config/omy_3m/initial_positions.yaml",
        "config/omy_3m/pack_positions.yaml",
        "config/omy_3m/qc_positions.yaml",
        "config/omy_f3m/hardware_controller_manager.yaml",
        "config/omy_f3m/initial_positions.yaml",
        "config/omy_f3m_follower_ai/hardware_controller_manager.yaml",
        "config/omy_f3m_follower_ai/initial_positions.yaml",
        "config/omy_f3m_follower_ai/qc_positions.yaml",
        "config/omy_f3m_leader_ai/hardware_controller_manager.yaml",
        "config/omy_l100_follower_ai/hardware_controller_manager.yaml",
        "config/omy_l100_follower_ai/initial_positions.yaml",
        "config/omy_l100_leader_ai/hardware_controller_manager.yaml",
        "config/open_manipulator_x/hardware_controller_manager.yaml",
        "config/open_manipulator_x/initial_positions.yaml",
        "open-manipulator-cdc.rules",
        "worlds/empty_world.sdf",
        "//launch:launch_files",
    ],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    console_scripts = {
        "joint_trajectory_executor": "open_manipulator_bringup.joint_trajectory_executor:main",
        "om_create_udev_rules": "open_manipulator_bringup.om_create_udev_rules:main",
    },
    package_xml = "package.xml",
    python = [":open_manipulator_bringup"],
    deps = [":ament_index"] + [
        "@dynamixel_hardware_interface//:ament_package",
        "@gz_ros2_control//:ament_package",
        "@open_manipulator_description//:ament_package",
        "@rclpy//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@ros2_control//:ament_package",
        "@ros2_controllers//:ament_package",
        "@ros_gz_bridge//:ament_package",
        "@ros_gz_image//:ament_package",
        "@ros_gz_sim//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
        "@xacro//:ament_package",
    ],
)
