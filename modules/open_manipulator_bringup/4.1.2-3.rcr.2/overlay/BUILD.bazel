        "open-manipulator-cdc.rules",
        "worlds/empty_world.sdf",
    ],
    package_xml = "package.xml",
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [
            ":ament_index",
            "@robot_state_publisher//:ament_index",
        ],
        deps = [":open_manipulator_bringup"],
    )
    for f in glob(["launch/**"])
]

