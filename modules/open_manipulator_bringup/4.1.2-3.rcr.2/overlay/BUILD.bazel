load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "open_manipulator_bringup",
    srcs = glob(["open_manipulator_bringup/**/*.py"]),
    imports = ["."],
    deps = [
        "@rclpy",
        "@ros_gz_bridge//:ros_gz_bridge_py",
        requirement("numpy"),
    ],
)

ament_index(
    name = "ament_index",
    data = [
