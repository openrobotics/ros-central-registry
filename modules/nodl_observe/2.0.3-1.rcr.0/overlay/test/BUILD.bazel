load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@example_interfaces//:cc_shared": "@example_interfaces//:cc",
    "@rcl_action//:rcl_action": "@rcl_action//:rcl_action_library",
    "@rcl_interfaces//:cc_shared": "@rcl_interfaces//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosgraph_msgs//:cc_shared": "@rosgraph_msgs//:cc",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_test(
    name = "test_actions",
    srcs = ["test_actions.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "fixtures/README.md",
        "fixtures/base.mcap",
        "fixtures/humble_rmw_cyclonedds_cpp.mcap",
        "fixtures/humble_rmw_fastrtps_cpp.mcap",
        "fixtures/jazzy_rmw_fastrtps_cpp.mcap",
        "fixtures/rmw_cyclonedds_cpp.mcap",
        "mcap_fixtures.py",
        "test_observe_integration.py",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "ROS2_LYRICAL",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:nodl_observe_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

