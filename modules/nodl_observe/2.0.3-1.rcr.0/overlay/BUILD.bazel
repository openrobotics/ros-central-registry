package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rcl_action//:rcl_action": "@rcl_action//:rcl_action_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
}

CC_DEPS = [
    "@builtin_interfaces//:cc",
    "@example_interfaces//:cc",
    "@rcl_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosgraph_msgs//:cc",
    "@std_msgs//:cc",
]

cc_library(
    name = "nodl_observe_library",
    srcs = [":gen_nodl_observe_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/nodl_observe",
    ],
    local_defines = ros_local_defines() + ["ROS2_LYRICAL"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "nodl_observe",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":nodl_observe_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":nodl_observe"],
)

cc_binary(
    name = "observe",
    srcs = [":gen_nodl_observe_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/nodl_observe",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines() + ["ROS2_LYRICAL"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":nodl_observe_library"],
)

write_file(
    name = "gen_nodl_observe_stub_cpp",
    out = "_gen/nodl_observe_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

write_file(
    name = "gen_cmake_10",
    out = "_gen/share/nodl_observe/cmake/ament_cmake_export_include_directories-extras.cmake",
    content = ["# generated from ament_cmake_export_include_directories/cmake/ament_cmake_export_include_directories-extras.cmake.in\n\nset(_exported_include_dirs \"${nodl_observe_DIR}/../../../include/nodl_observe\")\n\n# append include directories to nodl_observe_INCLUDE_DIRS\n# warn about not existing paths\nif(NOT _exported_include_dirs STREQUAL \"\")\n  find_package(ament_cmake_core QUIET REQUIRED)\n  foreach(_exported_include_dir ${_exported_include_dirs})\n    if(NOT IS_DIRECTORY \"${_exported_include_dir}\")\n      message(WARNING \"Package 'nodl_observe' exports the include directory '${_exported_include_dir}' which doesn't exist\")\n    endif()\n    normalize_path(_exported_include_dir \"${_exported_include_dir}\")\n    list(APPEND nodl_observe_INCLUDE_DIRS \"${_exported_include_dir}\")\n  endforeach()\nendif()\n"],
)

