load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@example_interfaces//:cc_shared": "@example_interfaces//:cc",
    "@rcl_action//:rcl_action": "@rcl_action//:rcl_action_library",
    "@rcl_interfaces//:cc_shared": "@rcl_interfaces//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosgraph_msgs//:cc_shared": "@rosgraph_msgs//:cc",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "nodl_observe_library",
    srcs = [
        "src/actions.cpp",
        "src/endpoints.cpp",
        "src/observe.cpp",
        "src/parameters.cpp",
        "src/qos.cpp",
    ],
    hdrs = [
        "include/nodl_observe/actions.hpp",
        "include/nodl_observe/endpoints.hpp",
        "include/nodl_observe/observe.hpp",
        "include/nodl_observe/parameters.hpp",
        "include/nodl_observe/qos.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/nodl_observe",
    ],
    local_defines = ros_local_defines() + ["ROS2_LYRICAL"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "nodl_observe",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":nodl_observe_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":nodl_observe"],
)

cc_binary(
    name = "observe",
    srcs = ["src/observe_main.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/nodl_observe",
    ],
    local_defines = ros_local_defines() + ["ROS2_LYRICAL"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":nodl_observe_library",
        "@rosdistro//cc:cli11",
    ],
)

register_ament_files(
    name = "ament_files_0",
    files = ["include/nodl_observe/actions.hpp"],
    prefix = "include/nodl_observe",
    strip_prefix = "*",
)

