ament_index(
    name = "ament_index",
    lib_data = [":observe"],
    libraries = [":nodl_observe"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@example_interfaces//:ament_package",
        "@rcl_action//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@rmw//:ament_package",
        "@rmw_cyclonedds_cpp//:ament_package",
        "@rmw_fastrtps_cpp//:ament_package",
        "@rmw_implementation_cmake//:ament_package",
        "@rmw_zenoh_cpp//:ament_package",
        "@ros_environment//:ament_package",
        "@rosgraph_msgs//:ament_package",
