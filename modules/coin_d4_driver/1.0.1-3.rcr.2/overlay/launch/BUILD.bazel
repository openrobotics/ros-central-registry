load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "multi_lidar_node.launch.py",
        "single_lidar_node.launch.py",
    ],
)

launch_ros_binary(
    name = "multi_lidar_node_launch",
    src = "multi_lidar_node.launch.py",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//:multi_coin_d4_node",
        "@ament_index_python",
    ],
)

launch_ros_binary(
    name = "single_lidar_node_launch",
    src = "single_lidar_node.launch.py",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//:single_coin_d4_node",
        "@ament_index_python",
    ],
)
