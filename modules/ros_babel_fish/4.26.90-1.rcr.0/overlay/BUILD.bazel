load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

HEADERS = [
    "include/ros_babel_fish/babel_fish.hpp",
    "include/ros_babel_fish/detail/any_service_callback.hpp",
    "include/ros_babel_fish/detail/babel_fish_action.hpp",
    "include/ros_babel_fish/detail/babel_fish_action_client.hpp",
    "include/ros_babel_fish/detail/babel_fish_action_server.hpp",
    "include/ros_babel_fish/detail/babel_fish_publisher.hpp",
    "include/ros_babel_fish/detail/babel_fish_service.hpp",
    "include/ros_babel_fish/detail/babel_fish_service_client.hpp",
    "include/ros_babel_fish/detail/babel_fish_subscription.hpp",
    "include/ros_babel_fish/detail/topic.hpp",
    "include/ros_babel_fish/exceptions/babel_fish_exception.hpp",
    "include/ros_babel_fish/idl/exceptions.hpp",
    "include/ros_babel_fish/idl/providers/local_type_support_provider.hpp",
    "include/ros_babel_fish/idl/serialization.hpp",
    "include/ros_babel_fish/idl/type_support.hpp",
    "include/ros_babel_fish/idl/type_support_provider.hpp",
    "include/ros_babel_fish/macros.hpp",
    "include/ros_babel_fish/messages/array_message.hpp",
    "include/ros_babel_fish/messages/compound_message.hpp",
    "include/ros_babel_fish/messages/message.hpp",
    "include/ros_babel_fish/messages/message_type_traits.hpp",
    "include/ros_babel_fish/messages/message_types.hpp",
    "include/ros_babel_fish/messages/value_message.hpp",
    "include/ros_babel_fish/method_invoke_helpers.hpp",
]

DEFINES = [
    "RBF_WARN_ON_INCOMPATIBLE_TYPE",
    "RCLCPP_VERSION_MAJOR=32",
]

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosidl_runtime_cpp//:rosidl_runtime_cpp": "@rosidl_runtime_cpp//:rosidl_runtime_cpp_library",
    "@rosidl_typesupport_cpp//:rosidl_typesupport_cpp": "@rosidl_typesupport_cpp//:rosidl_typesupport_cpp_library",
    "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp": "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp_library",
}

cc_library(
    name = "ros_babel_fish_library",
    srcs = [
        "src/babel_fish.cpp",
        "src/detail/babel_fish_action_client.cpp",
        "src/detail/babel_fish_action_server.cpp",
        "src/detail/babel_fish_publisher.cpp",
        "src/detail/babel_fish_service.cpp",
        "src/detail/babel_fish_service_client.cpp",
        "src/detail/babel_fish_subscription.cpp",
        "src/detail/topic.cpp",
        "src/idl/providers/local_type_support_provider.cpp",
        "src/idl/serialization.cpp",
        "src/idl/type_support.cpp",
        "src/idl/type_support_provider.cpp",
        "src/logging.hpp",
        "src/messages/array_message.cpp",
        "src/messages/compound_message.cpp",
        "src/messages/message.cpp",
    ],
    hdrs = HEADERS,
    defines = DEFINES,
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "ros_babel_fish",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":ros_babel_fish_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":ros_babel_fish",
        "@geometry_msgs//:cc_shared",
    ],
)

[cc_binary(
    name = name,
    srcs = ["examples/{}.cpp".format(name)],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [":ros_babel_fish_library"],
) for name in [
    "action_client",
    "any_publisher",
    "service_client",
    "service_server",
    "troll_node",
]]

cc_binary(
    name = "any_subscriber",
    srcs = ["examples/any_subscriber.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":ros_babel_fish_library",
    ],
)

cc_binary(
    name = "benchmark_message",
    srcs = ["benchmark/message.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":ros_babel_fish_library",
        "@google_benchmark//:benchmark",
    ],
)

EXECUTABLES = [
    ":action_client",
    ":any_publisher",
    ":any_subscriber",
    ":benchmark_message",
    ":service_client",
    ":service_server",
    ":troll_node",
]

ament_index(
    name = "ament_index",
    executables = EXECUTABLES,
    libraries = [":ros_babel_fish"],
    package_xml = "package.xml",
    deps = [
        "@example_interfaces//:ament_index",
        "@geometry_msgs//:ament_index",
        "@ros_babel_fish_test_msgs//:ament_index",
        "@std_msgs//:ament_index",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rclcpp",
        "rclcpp_action",
        "rosidl_runtime_cpp",
        "rosidl_typesupport_cpp",
        "rosidl_typesupport_introspection_cpp",
    ],
    cmake_export_has_library_target = True,
    cmake_export_name = "export_ros_babel_fish",
    headers = HEADERS,
    include_prefix = "",
    libraries = [":ros_babel_fish"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@example_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rcpputils//:ament_package",
        "@ros_babel_fish_test_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
        "@rosidl_typesupport_cpp//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
