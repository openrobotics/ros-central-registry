+// The type support handles stored in Message-/ServiceTypeSupport are passed by pointer to rcl and
+// the middleware when creating entities. The middleware (e.g. rmw_fastrtps) keeps that pointer for
+// as long as the type stays registered with the participant, which can outlive both the entity and
+// the BabelFish instance that created it (e.g. another entity of the same type is still alive or
+// is being torn down asynchronously by an executor). To keep those pointers valid, type supports
+// are cached process-wide and shared between provider instances instead of being freed with them.
+bool same_type_support( const MessageTypeSupport &a, const MessageTypeSupport &b )
+{
+  return a.type_support_handle.data == b.type_support_handle.data &&
+         a.introspection_type_support_handle.data == b.introspection_type_support_handle.data;
+}
+
+bool same_type_support( const ServiceTypeSupport &a, const ServiceTypeSupport &b )
+{
+  return a.type_support_handle.data == b.type_support_handle.data &&
+         a.introspection_type_support_handle.data == b.introspection_type_support_handle.data;
+}
+
+bool same_type_support( const ActionTypeSupport &a, const ActionTypeSupport &b )
+{
+  return a.type_support_handle.goal_service_type_support ==
+             b.type_support_handle.goal_service_type_support &&
+         a.introspection_type_support_handle.goal_service_type_support ==
+             b.introspection_type_support_handle.goal_service_type_support;
+}
+
+template<typename T>
+std::shared_ptr<const T> get_or_insert_global_type_support( const std::string &name,
+                                                            const std::shared_ptr<const T> &candidate )
+{
+  static std::mutex mutex;
+  static std::unordered_map<std::string, std::shared_ptr<const T>> cache;
+  // Type supports replaced in the cache (same name, different handles) are retained as well since
+  // the middleware may still reference them.
+  static std::vector<std::shared_ptr<const T>> replaced;
+  std::lock_guard<std::mutex> lock( mutex );
+  auto it = cache.find( name );
+  if ( it != cache.end() ) {
+    if ( same_type_support( *it->second, *candidate ) )
+      return it->second;
+    replaced.push_back( it->second );
+  }
+  cache[name] = candidate;
+  return candidate;
+}
+} // namespace
 
