cc_library(
    name = "gz_custom_hardware_plugins_library",
    srcs = ["src/gz_custom_system.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/gz_ros2_control_demos",
    ],
    local_defines = ros_local_defines() + [
        "HAVE_PYBIND11",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "gz_custom_hardware_plugins",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":gz_custom_hardware_plugins_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

