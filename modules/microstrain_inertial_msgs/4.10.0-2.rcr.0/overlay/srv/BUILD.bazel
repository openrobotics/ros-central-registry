load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rosidl_default_generators//:defs.bzl", "ros_service")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

copy_file(
    name = "_copy_Mip3dmCaptureGyroBias",
    src = "//microstrain_inertial_msgs_common/srv:Mip3dmCaptureGyroBias.srv",
    out = "Mip3dmCaptureGyroBias.srv",
)

copy_file(
    name = "_copy_Mip3dmGpioStateRead",
    src = "//microstrain_inertial_msgs_common/srv:Mip3dmGpioStateRead.srv",
    out = "Mip3dmGpioStateRead.srv",
)

copy_file(
    name = "_copy_Mip3dmGpioStateWrite",
    src = "//microstrain_inertial_msgs_common/srv:Mip3dmGpioStateWrite.srv",
    out = "Mip3dmGpioStateWrite.srv",
)

copy_file(
    name = "_copy_MipBaseGetDeviceInformation",
    src = "//microstrain_inertial_msgs_common/srv:MipBaseGetDeviceInformation.srv",
    out = "MipBaseGetDeviceInformation.srv",
)

copy_file(
    name = "_copy_MipGnssReceiverReset",
    src = "//microstrain_inertial_msgs_common/srv:MipGnssReceiverReset.srv",
    out = "MipGnssReceiverReset.srv",
)

copy_file(
    name = "_copy_RawFileConfigRead",
    src = "//microstrain_inertial_msgs_common/srv:RawFileConfigRead.srv",
    out = "RawFileConfigRead.srv",
)

copy_file(
    name = "_copy_RawFileConfigWrite",
    src = "//microstrain_inertial_msgs_common/srv:RawFileConfigWrite.srv",
    out = "RawFileConfigWrite.srv",
)

ros_service(
    name = "Mip3dmCaptureGyroBias",
    src = "Mip3dmCaptureGyroBias.srv",
)

ros_service(
    name = "Mip3dmGpioStateRead",
    src = "Mip3dmGpioStateRead.srv",
)

ros_service(
    name = "Mip3dmGpioStateWrite",
    src = "Mip3dmGpioStateWrite.srv",
)

ros_service(
    name = "MipBaseGetDeviceInformation",
    src = "MipBaseGetDeviceInformation.srv",
    deps = [
        "//msg:MipBaseDeviceInfo",
    ],
)

ros_service(
    name = "RawFileConfigRead",
    src = "RawFileConfigRead.srv",
)

ros_service(
    name = "RawFileConfigWrite",
    src = "RawFileConfigWrite.srv",
)

ros_service(
    name = "MipGnssReceiverReset",
    src = "MipGnssReceiverReset.srv",
)
