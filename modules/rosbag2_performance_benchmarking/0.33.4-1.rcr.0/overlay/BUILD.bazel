load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosbag2_compression//:rosbag2_compression": "@rosbag2_compression//:rosbag2_compression_library",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosbag2_performance_benchmarking_msgs//:cc_shared": "@rosbag2_performance_benchmarking_msgs//:cc",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "benchmark_publishers",
    srcs = [
        "src/benchmark_publishers.cpp",
        "src/config_utils.cpp",
        "src/msg_utils/helpers.cpp",
    ] + [
        "include/msg_utils/helpers.hpp",
        "include/msg_utils/message_producer.hpp",
        "include/msg_utils/message_producer_factory.hpp",
        "include/rosbag2_performance_benchmarking/bag_config.hpp",
        "include/rosbag2_performance_benchmarking/byte_producer.hpp",
        "include/rosbag2_performance_benchmarking/config_utils.hpp",
        "include/rosbag2_performance_benchmarking/message_queue.hpp",
        "include/rosbag2_performance_benchmarking/producer_config.hpp",
        "include/rosbag2_performance_benchmarking/publisher_group_config.hpp",
        "include/rosbag2_performance_benchmarking/result_utils.hpp",
        "include/rosbag2_performance_benchmarking/thread_pool.hpp",
        "include/rosbag2_performance_benchmarking/writer_benchmark.hpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/rosbag2_performance_benchmarking",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "results_writer",
    srcs = [
        "src/config_utils.cpp",
        "src/result_utils.cpp",
        "src/results_writer.cpp",
    ] + [
        "include/msg_utils/helpers.hpp",
        "include/msg_utils/message_producer.hpp",
        "include/msg_utils/message_producer_factory.hpp",
        "include/rosbag2_performance_benchmarking/bag_config.hpp",
        "include/rosbag2_performance_benchmarking/byte_producer.hpp",
        "include/rosbag2_performance_benchmarking/config_utils.hpp",
        "include/rosbag2_performance_benchmarking/message_queue.hpp",
        "include/rosbag2_performance_benchmarking/producer_config.hpp",
        "include/rosbag2_performance_benchmarking/publisher_group_config.hpp",
        "include/rosbag2_performance_benchmarking/result_utils.hpp",
        "include/rosbag2_performance_benchmarking/thread_pool.hpp",
        "include/rosbag2_performance_benchmarking/writer_benchmark.hpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/rosbag2_performance_benchmarking",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "writer_benchmark",
    srcs = [
        "src/config_utils.cpp",
        "src/msg_utils/helpers.cpp",
        "src/result_utils.cpp",
        "src/writer_benchmark.cpp",
    ] + [
        "include/msg_utils/helpers.hpp",
        "include/msg_utils/message_producer.hpp",
        "include/msg_utils/message_producer_factory.hpp",
        "include/rosbag2_performance_benchmarking/bag_config.hpp",
        "include/rosbag2_performance_benchmarking/byte_producer.hpp",
        "include/rosbag2_performance_benchmarking/config_utils.hpp",
        "include/rosbag2_performance_benchmarking/message_queue.hpp",
        "include/rosbag2_performance_benchmarking/producer_config.hpp",
        "include/rosbag2_performance_benchmarking/publisher_group_config.hpp",
        "include/rosbag2_performance_benchmarking/result_utils.hpp",
        "include/rosbag2_performance_benchmarking/thread_pool.hpp",
        "include/rosbag2_performance_benchmarking/writer_benchmark.hpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/rosbag2_performance_benchmarking",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

ament_index(
    name = "ament_index",
    data = [
        "config/benchmarks/default_benchmark_producers.yaml",
        "config/benchmarks/default_no_transport.yaml",
        "config/benchmarks/dispatch_latency.yaml",
        "config/benchmarks/test/test_benchmark_producers.yaml",
        "config/benchmarks/test/test_no_transport.yaml",
        "config/producers/100MBs_raw.yaml",
        "config/producers/200MBs_raw.yaml",
        "config/producers/300MBs_raw.yaml",
        "config/producers/automotive.yaml",
        "config/producers/many_small_1000hz.yaml",
        "config/producers/many_small_200hz.yaml",
        "config/producers/many_small_400hz.yaml",
        "config/producers/many_small_600hz.yaml",
        "config/producers/many_small_800hz.yaml",
        "config/producers/mixed_110Mbs.yaml",
        "config/producers/mixed_110Mbs_low_pubs_count.yaml",
        "config/storage/storage_optimized.yaml",
        "config/storage/storage_resilient.yaml",
        "//launch:launch_files",
    ],
    lib_data = [
        ":benchmark_publishers",
        ":results_writer",
        ":writer_benchmark",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rmw//:ament_package",
        "@ros2bag//:ament_package",
        "@ros2launch//:ament_package",
        "@ros_testing//:ament_package",
        "@rosbag2_compression//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosbag2_performance_benchmarking_msgs//:ament_package",
        "@rosbag2_py//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_storage_default_plugins//:ament_package",
        "@rosbag2_test_common//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rmw//:ament_package",
        "@ros2bag//:ament_package",
        "@ros2launch//:ament_package",
        "@ros_testing//:ament_package",
        "@rosbag2_compression//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosbag2_performance_benchmarking_msgs//:ament_package",
        "@rosbag2_py//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_storage_default_plugins//:ament_package",
        "@rosbag2_test_common//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
