load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = ["benchmark_launch.py"],
)

launch_ros_binary(
    name = "benchmark_launch",
    src = "benchmark_launch.py",
    data = [
        "//:ament_index",
        "//:benchmark_publishers",
        "//:results_writer",
        "//:writer_benchmark",
    ],
    deps = [
        "@ament_index_python",
        "@rosbag2_py",
        requirement("psutil"),
        requirement("pyyaml"),
    ],
)
