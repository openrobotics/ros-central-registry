package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
    ]
]

py_library(
    name = "joy_tester",
    srcs = glob(["joy_tester/**/*.py"]),
    imports = ["."],
    deps = [
        "@rclpy",
        "@sensor_msgs//:py",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"test_joy": "joy_tester.test_joy:main"},
    package_xml = "package.xml",
    python = [":joy_tester"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
