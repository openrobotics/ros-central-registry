load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/point_cloud_msg_wrapper/default_field_generators.hpp",
    "include/point_cloud_msg_wrapper/field_generators.hpp",
    "include/point_cloud_msg_wrapper/field_properties.hpp",
    "include/point_cloud_msg_wrapper/point_cloud_msg_wrapper.hpp",
    "include/point_cloud_msg_wrapper/type_traits.hpp",
    "include/point_cloud_msg_wrapper/visibility_control.hpp",
]

cc_library(
    name = "point_cloud_msg_wrapper",
    hdrs = HEADERS,
    includes = ["include"],
    deps = ["@sensor_msgs//:cc"],
)

ament_package(
    name = "ament_package",
    cmake_export_interface = False,
    cmake_export_targets = False,
    headers = HEADERS,
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
