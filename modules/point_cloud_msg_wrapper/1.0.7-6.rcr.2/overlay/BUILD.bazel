load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

cc_library(
    name = "point_cloud_msg_wrapper",
    hdrs = HEADERS,
    includes = ["include"],
    deps = [
        "@sensor_msgs//:cc",
    ],
)

### TESTS

cc_test(
    name = "point_cloud_msg_wrapper_test",
    srcs = [
        "test/test_field_generators.cpp",
        "test/test_point_cloud_msg_wrapper.cpp",
    ],
    deps = [
        ":point_cloud_msg_wrapper",
        "@geometry_msgs//:cc",
        "@rosdistro//cc:googletest",
        "@sensor_msgs//:cc",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_interface = False,
    cmake_export_targets = False,
    headers = HEADERS,
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
