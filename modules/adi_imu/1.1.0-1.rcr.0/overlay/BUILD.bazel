load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

CC_DEPS = [
    "@rcl_interfaces//:cc",
    "@builtin_interfaces//:cc",
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "adi_imu_node",
    srcs = [":gen_adi_imu_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "_gen/include/adi_imu",
        "_gen/include/adi_imu/adi_imu",
        "include",
        "include/adi_imu",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":cc",
    ],
)

write_file(
    name = "gen_adi_imu_stub_cpp",
    out = "_gen/adi_imu_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:AccelGyroTempData",
        "//msg:ImuDiagDataADIS1646X",
        "//msg:ImuDiagDataADIS1647X",
        "//msg:ImuDiagDataADIS1650X",
        "//msg:ImuDiagDataADIS1654X",
        "//msg:ImuDiagDataADIS1655X",
        "//msg:ImuDiagDataADIS1657X",
        "//msg:ImuFullMeasuredData",
        "//msg:ImuIdentificationData",
        "//msg:VelAngTempData",
    ],
)

ament_index(
    name = "ament_index_extra",
    data = [
        "config/adis1646x/imu_config.yaml",
        "config/adis1647x/imu_config.yaml",
        "config/adis1650x/imu_config.yaml",
        "config/adis1654x/imu_config.yaml",
        "config/adis1655x/imu_config.yaml",
        "config/adis1657x/imu_config.yaml",
        "config/imu_covariance_config.yaml",
        "launch/imu_and_covariance.launch.py",
        "launch/imu_tof_fusion.launch.py",
        "launch/imu_with_madgwick_filter_rviz.launch.py",
        "rviz/imu_tof_fusion.rviz",
        "rviz/imu_with_madgwick_filter_rviz.rviz",
    ],
    export_name = "adi_imu",
    lib_data = [":adi_imu_node"],
    libraries = [
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_pep257//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

rosidl_ament_package(
    cmake_export_dependencies_list = [
        "builtin_interfaces",
        "geometry_msgs",
        "rosidl_runtime_c",
        "rosidl_typesupport_interface",
        "rcutils",
        "fastcdr",
        "rosidl_runtime_c",
        "rosidl_runtime_cpp",
        "rosidl_typesupport_fastrtps_c",
        "rosidl_typesupport_fastrtps_cpp",
        "rosidl_typesupport_interface",
        "rosidl_runtime_cpp",
        "fastcdr",
        "rmw",
        "rosidl_runtime_c",
        "rosidl_runtime_cpp",
        "rosidl_typesupport_fastrtps_cpp",
        "rosidl_typesupport_interface",
        "rosidl_runtime_c",
        "rosidl_typesupport_c",
        "rosidl_typesupport_interface",
        "rosidl_runtime_c",
        "rosidl_runtime_cpp",
        "rosidl_typesupport_c",
        "rosidl_typesupport_cpp",
        "rosidl_typesupport_interface",
        "rosidl_default_runtime",
    ],
    install = [
    ],
    libraries = [
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index_extra",
        "@rcl_interfaces//:ament_package",
    ] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_pep257//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [":ament_index"],
    )
    for f in glob(["launch/**"])
]
