load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "imu_and_covariance.launch.py",
        "imu_tof_fusion.launch.py",
        "imu_with_madgwick_filter_rviz.launch.py",
    ],
)

launch_ros_binary(
    name = "imu_and_covariance_launch",
    src = "imu_and_covariance.launch.py",
    data = [
        "//:adi_imu_node",
        "//:ament_index",
        "//:ament_index_extra",
    ],
)

launch_ros_binary(
    name = "imu_tof_fusion_launch",
    src = "imu_tof_fusion.launch.py",
    data = [
        "//:adi_imu_node",
        "//:ament_index",
        "//:ament_index_extra",
        "@imu_filter_madgwick//:ament_index",
        "@imu_filter_madgwick//:imu_filter_madgwick_node",
        "@rviz2",
        "@rviz2//:ament_index",
        "@tf2_ros//:ament_index",
        "@tf2_ros//:static_transform_publisher",
    ],
    deps = ["@ament_index_python"],
)

launch_ros_binary(
    name = "imu_with_madgwick_filter_rviz_launch",
    src = "imu_with_madgwick_filter_rviz.launch.py",
    data = [
        "//:adi_imu_node",
        "//:ament_index",
        "//:ament_index_extra",
        "@imu_filter_madgwick//:ament_index",
        "@imu_filter_madgwick//:imu_filter_madgwick_node",
        "@rviz2",
        "@rviz2//:ament_index",
    ],
    deps = ["@ament_index_python"],
)
