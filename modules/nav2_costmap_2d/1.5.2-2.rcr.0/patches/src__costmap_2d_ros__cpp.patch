-    // Make sure to sleep for the remainder of our cycle time
-    r.sleep();
+    // Make sure to sleep for the remainder of our cycle time (same semantics as
+    // rclcpp::Rate::sleep()), while staying responsive to deactivation.
+    rclcpp::Time now_time = clock->now();
+    if (now_time < last_interval) {
+      // Time jumped backwards (e.g. sim time reset); restart the cycle.
+      last_interval = now_time;
+    }
+    const rclcpp::Time next_interval = last_interval + period;
+    if (next_interval < now_time) {
+      // This cycle overran; don't try to catch up.
+      last_interval = now_time;
+      continue;
+    }
+    {
+      std::unique_lock<std::mutex> lock(map_update_thread_mutex_);
+      while (rclcpp::ok() && !map_update_thread_shutdown_) {
+        now_time = clock->now();
+        if (now_time >= next_interval || now_time < last_interval) {
+          break;
+        }
+        // Wait in short wall-clock slices: with sim time the clock can stop
+        // advancing altogether (e.g. the simulator has already exited).
+        const auto remaining =
+          std::chrono::nanoseconds((next_interval - now_time).nanoseconds());
+        map_update_thread_cv_.wait_for(
+          lock, std::min<std::chrono::nanoseconds>(remaining, 50ms));
+      }
+    }
+    last_interval = next_interval;
 
