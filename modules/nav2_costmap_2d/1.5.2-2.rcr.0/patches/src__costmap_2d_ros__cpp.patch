+  // Map thread stuff. Wake the update thread rather than letting it finish a
+  // clock sleep: on_deactivate() can run from rclcpp's pre-shutdown callbacks
+  // (nav2::LifecycleNode::on_rcl_preshutdown), i.e. before the context wakes
+  // clock sleepers, and with sim time stopped that sleep would never end --
+  // deadlocking the join() below and hanging the process on Ctrl-C.
+  {
+    std::lock_guard<std::mutex> lock(map_update_thread_mutex_);
+    map_update_thread_shutdown_ = true;
+  }
+  map_update_thread_cv_.notify_all();
 
   if (map_update_thread_->joinable()) {
     map_update_thread_->join();
@@ -544,7 +553,11 @@
 
   RCLCPP_DEBUG(get_logger(), "Entering loop");
 
-  nav2::Rate r(this, frequency);    // 200ms by default
+  // Paced like nav2::Rate (sim clock when use_sim_time, else steady), but the
+  // sleep below stays interruptible by on_deactivate(); see the comment there.
+  auto clock = nav2::selectSteadyOrSimClock(this);
+  const rclcpp::Duration period = rclcpp::Duration::from_seconds(1.0 / frequency);  // 200ms by default
+  rclcpp::Time last_interval = clock->now();
 
   while (rclcpp::ok() && !map_update_thread_shutdown_) {
