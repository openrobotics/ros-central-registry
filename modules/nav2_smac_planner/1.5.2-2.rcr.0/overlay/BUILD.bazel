= 0, int N3 = 0, int N4 = 0, int N5 = 0>\nclass SizedCostFunction : public CostFunction {\n public:\n  SizedCostFunction() {\n    set_num_residuals(kNumResiduals);\n    if (N0 > 0) mutable_parameter_block_sizes()->push_back(N0);\n    if (N1 > 0) mutable_parameter_block_sizes()->push_back(N1);\n    if (N2 > 0) mutable_parameter_block_sizes()->push_back(N2);\n    if (N3 > 0) mutable_parameter_block_sizes()->push_back(N3);\n    if (N4 > 0) mutable_parameter_block_sizes()->push_back(N4);\n    if (N5 > 0) mutable_parameter_block_sizes()->push_back(N5);\n  }\n  ~SizedCostFunction() override = default;\n};\nclass NormalPrior : public CostFunction {\n public:\n  NormalPrior(const Eigen::MatrixXd & A, const Eigen::VectorXd & b) : A_(A), b_(b) {\n    set_num_residuals(static_cast<int>(A_.rows()));\n    mutable_parameter_block_sizes()->push_back(static_cast<int>(b_.size()));\n  }\n  bool Evaluate(double const* const* parameters, double* residuals, double** jacobians) const override {\n    Eigen::Map<const Eigen::VectorXd> x(parameters[0], b_.size());\n    Eigen::Map<Eigen::VectorXd> r(residuals, A_.rows());\n    r = A_ * (x - b_);\n    if (jacobians && jacobians[0]) {\n      Eigen::Map<Eigen::Matrix<double, Eigen::Dynamic, Eigen::Dynamic, Eigen::RowMajor>> J(jacobians[0], A_.rows(), A_.cols());\n      J = A_;\n    }\n    return true;\n  }\n private:\n  Eigen::MatrixXd A_;\n  Eigen::VectorXd b_;\n};\ntemplate <typename CostFunctor, int kNumResiduals, int N0, int N1 = 0, int N2 = 0, int N3 = 0, int N4 = 0, int N5 = 0>\nclass AutoDiffCostFunction : public CostFunction {\n public:\n  explicit AutoDiffCostFunction(CostFunctor * functor, int num_residuals = kNumResiduals) : functor_(functor) {\n    set_num_residuals(num_residuals);\n    if (N0 > 0) mutable_parameter_block_sizes()->push_back(N0);\n    if (N1 > 0) mutable_parameter_block_sizes()->push_back(N1);\n    if (N2 > 0) mutable_parameter_block_sizes()->push_back(N2);\n    if (N3 > 0) mutable_parameter_block_sizes()->push_back(