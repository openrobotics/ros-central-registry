DEPENDENCIES = {}

CC_DEPS = []

cc_test(
    name = "test_a_star",
    srcs = ["test_a_star.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "3planners.png",
        "CMakeLists.txt",
        "path.png",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        'BTCPP_LIBRARY_VERSION=\\"4.10.0\\"',
        "GTEST_HAS_PTHREAD=1",
        "NDEBUG",
        "_FILE_OFFSET_BITS=64",
    ],
    # xfail: fails under Bazel: ClassLoader
    tags = [
        "manual",
        "xfail",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:nav2_smac_planner_common_library",
        "//:nav2_smac_planner_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

