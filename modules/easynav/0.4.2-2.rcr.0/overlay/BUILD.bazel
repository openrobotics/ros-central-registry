load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@easynav_common//:ament_package",
        "@easynav_controller//:ament_package",
        "@easynav_core//:ament_package",
        "@easynav_interfaces//:ament_package",
        "@easynav_localizer//:ament_package",
        "@easynav_maps_manager//:ament_package",
        "@easynav_planner//:ament_package",
        "@easynav_sensors//:ament_package",
        "@easynav_support_py//:ament_package",
        "@easynav_system//:ament_package",
        "@easynav_tools//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "easynav_common",
        "easynav_controller",
        "easynav_core",
        "easynav_interfaces",
        "easynav_maps_manager",
        "easynav_planner",
        "easynav_localizer",
        "easynav_sensors",
        "easynav_support_py",
        "easynav_system",
        "easynav_tools",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@easynav_common//:ament_package",
        "@easynav_controller//:ament_package",
        "@easynav_core//:ament_package",
        "@easynav_interfaces//:ament_package",
        "@easynav_localizer//:ament_package",
        "@easynav_maps_manager//:ament_package",
        "@easynav_planner//:ament_package",
        "@easynav_sensors//:ament_package",
        "@easynav_support_py//:ament_package",
        "@easynav_system//:ament_package",
        "@easynav_tools//:ament_package",
    ],
)
