load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
    "@rules_qt//:qt_core",
    "@rules_qt//:qt_gui",
    "@rules_qt//:qt_svg",
    "@rules_qt//:qt_widgets",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "turtle_nest",
    srcs = [":gen_turtle_nest_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_ui_addnodedialog_h",
        ":gen_ui_mainwindow_h",
        ":gen_ui_packageinfoform_h",
        ":gen_ui_packageswindow_h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "include",
        "include/turtle_nest",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

write_file(
    name = "gen_turtle_nest_stub_cpp",
    out = "_gen/turtle_nest_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

write_file(
    name = "gen_bin_extra_0",
    out = "_gen/bin/turtle-nest",
    content = [""],
    is_executable = True,
)

genrule(
    name = "gen_ui_addnodedialog_h",
    srcs = ["src/addnodedialog.ui"],
    outs = ["_gen/include/ui_addnodedialog.h"],
    cmd = select({
        "@rules_qt//:linux_x86_64": "$(location @qt_linux_x86_64//:uic) $(location src/addnodedialog.ui) -o $@",
        "@rules_qt//:linux_aarch64": "$(location @qt_linux_aarch64//:uic) $(location src/addnodedialog.ui) -o $@",
        "@platforms//os:windows": "$(location @qt_windows_x86_64//:uic) $(location src/addnodedialog.ui) -o $@",
        "@rules_qt//:osx_x86_64": "$(location @qt_mac_x86_64//:uic) $(location src/addnodedialog.ui) -o $@",
        "@rules_qt//:osx_arm64": "$(location @qt_mac_aarch64//:uic) $(location src/addnodedialog.ui) -o $@",
    }),
    tools = select({
        "@rules_qt//:linux_x86_64": ["@qt_linux_x86_64//:uic"],
        "@rules_qt//:linux_aarch64": ["@qt_linux_aarch64//:uic"],
        "@platforms//os:windows": ["@qt_windows_x86_64//:uic"],
        "@rules_qt//:osx_arm64": ["@qt_mac_aarch64//:uic"],
        "@rules_qt//:osx_x86_64": ["@qt_mac_x86_64//:uic"],
    }),
)

genrule(
    name = "gen_ui_mainwindow_h",
    srcs = ["src/mainwindow.ui"],
    outs = ["_gen/include/ui_mainwindow.h"],
    cmd = select({
        "@rules_qt//:linux_x86_64": "$(location @qt_linux_x86_64//:uic) $(location src/mainwindow.ui) -o $@",
        "@rules_qt//:linux_aarch64": "$(location @qt_linux_aarch64//:uic) $(location src/mainwindow.ui) -o $@",
        "@platforms//os:windows": "$(location @qt_windows_x86_64//:uic) $(location src/mainwindow.ui) -o $@",
        "@rules_qt//:osx_x86_64": "$(location @qt_mac_x86_64//:uic) $(location src/mainwindow.ui) -o $@",
        "@rules_qt//:osx_arm64": "$(location @qt_mac_aarch64//:uic) $(location src/mainwindow.ui) -o $@",
    }),
    tools = select({
        "@rules_qt//:linux_x86_64": ["@qt_linux_x86_64//:uic"],
        "@rules_qt//:linux_aarch64": ["@qt_linux_aarch64//:uic"],
        "@platforms//os:windows": ["@qt_windows_x86_64//:uic"],
        "@rules_qt//:osx_arm64": ["@qt_mac_aarch64//:uic"],
        "@rules_qt//:osx_x86_64": ["@qt_mac_x86_64//:uic"],
    }),
)

genrule(
    name = "gen_ui_packageinfoform_h",
    srcs = ["src/packageinfoform.ui"],
    outs = ["_gen/include/ui_packageinfoform.h"],
    cmd = select({
        "@rules_qt//:linux_x86_64": "$(location @qt_linux_x86_64//:uic) $(location src/packageinfoform.ui) -o $@",
        "@rules_qt//:linux_aarch64": "$(location @qt_linux_aarch64//:uic) $(location src/packageinfoform.ui) -o $@",
        "@platforms//os:windows": "$(location @qt_windows_x86_64//:uic) $(location src/packageinfoform.ui) -o $@",
        "@rules_qt//:osx_x86_64": "$(location @qt_mac_x86_64//:uic) $(location src/packageinfoform.ui) -o $@",
        "@rules_qt//:osx_arm64": "$(location @qt_mac_aarch64//:uic) $(location src/packageinfoform.ui) -o $@",
    }),
    tools = select({
        "@rules_qt//:linux_x86_64": ["@qt_linux_x86_64//:uic"],
        "@rules_qt//:linux_aarch64": ["@qt_linux_aarch64//:uic"],
        "@platforms//os:windows": ["@qt_windows_x86_64//:uic"],
        "@rules_qt//:osx_arm64": ["@qt_mac_aarch64//:uic"],
        "@rules_qt//:osx_x86_64": ["@qt_mac_x86_64//:uic"],
    }),
)

genrule(
    name = "gen_ui_packageswindow_h",
    srcs = ["src/packageswindow.ui"],
    outs = ["_gen/include/ui_packageswindow.h"],
    cmd = select({
        "@rules_qt//:linux_x86_64": "$(location @qt_linux_x86_64//:uic) $(location src/packageswindow.ui) -o $@",
        "@rules_qt//:linux_aarch64": "$(location @qt_linux_aarch64//:uic) $(location src/packageswindow.ui) -o $@",
        "@platforms//os:windows": "$(location @qt_windows_x86_64//:uic) $(location src/packageswindow.ui) -o $@",
        "@rules_qt//:osx_x86_64": "$(location @qt_mac_x86_64//:uic) $(location src/packageswindow.ui) -o $@",
        "@rules_qt//:osx_arm64": "$(location @qt_mac_aarch64//:uic) $(location src/packageswindow.ui) -o $@",
    }),
    tools = select({
        "@rules_qt//:linux_x86_64": ["@qt_linux_x86_64//:uic"],
        "@rules_qt//:linux_aarch64": ["@qt_linux_aarch64//:uic"],
        "@platforms//os:windows": ["@qt_windows_x86_64//:uic"],
        "@rules_qt//:osx_arm64": ["@qt_mac_aarch64//:uic"],
        "@rules_qt//:osx_x86_64": ["@qt_mac_x86_64//:uic"],
    }),
)

ament_index(
    name = "ament_index",
    executables = [
        ":gen_bin_extra_0",
    ],
    lib_data = [
        ":turtle_nest",
        "src/python_file_utils.py",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@tinyxml2_vendor//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    programs = [
        ":gen_bin_extra_0",
    ],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@tinyxml2_vendor//:ament_package",
    ],
)
