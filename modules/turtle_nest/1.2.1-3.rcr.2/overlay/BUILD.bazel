load("@qt//:qt.bzl", "qt_cc_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
    "@rules_python//python/cc:current_py_cc_libs",
    "@qtbase//:concurrent",
    "@qtbase//:core",
    "@qtbase//:gui",
    "@qtsvg//:svg",
    "@qtsvg//:svgwidgets",
    "@qtbase//:widgets",
]

cc_library(
    name = "turtle_nest_headers",
    hdrs = [
        "include/turtle_nest/addnodedialog.h",
        "include/turtle_nest/build_type_enum.h",
        "include/turtle_nest/file_utils.h",
        "include/turtle_nest/generate_cmake.h",
        "include/turtle_nest/generate_launch.h",
        "include/turtle_nest/generate_msgs_pkg.h",
        "include/turtle_nest/generate_params.h",
        "include/turtle_nest/generate_setup_py.h",
        "include/turtle_nest/mainwindow.h",
        "include/turtle_nest/modify_existing_pkg.h",
        "include/turtle_nest/node_type_enum.h",
        "include/turtle_nest/package_generators/base_package_generator.h",
        "include/turtle_nest/package_generators/cpp_package_generator.h",
        "include/turtle_nest/package_generators/mixed_cpp_python_package_generator.h",
        "include/turtle_nest/package_generators/package_generator_factory.h",
        "include/turtle_nest/package_generators/python_package_generator.h",
        "include/turtle_nest/package_xml_tools.h",
        "include/turtle_nest/packageinfo.h",
        "include/turtle_nest/packageinfoform.h",
        "include/turtle_nest/packageswindow.h",
        "include/turtle_nest/rospkgcreator.h",
        "include/turtle_nest/string_tools.h",
        ":gen_ui_addnodedialog_h",
        ":gen_ui_mainwindow_h",
        ":gen_ui_packageinfoform_h",
        ":gen_ui_packageswindow_h",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/turtle_nest",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

qt_cc_binary(
    name = "turtle_nest",
    srcs = [
        "src/addnodedialog.cpp",
        "src/file_utils.cpp",
        "src/generate_cmake.cpp",
        "src/generate_launch.cpp",
        "src/generate_msgs_pkg.cpp",
        "src/generate_params.cpp",
        "src/generate_setup_py.cpp",
        "src/main.cpp",
        "src/mainwindow.cpp",
        "src/modify_existing_pkg.cpp",
        "src/package_generators/cpp_package_generator.cpp",
        "src/package_generators/mixed_cpp_python_package_generator.cpp",
        "src/package_generators/package_generator_factory.cpp",
        "src/package_generators/python_package_generator.cpp",
        "src/package_xml_tools.cpp",
        "src/packageinfoform.cpp",
        "src/packageswindow.cpp",
        "src/rospkgcreator.cpp",
        "src/string_tools.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@qtbase//:concurrent_shared",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtsvg//:svg_shared",
        "@qtsvg//:svgwidgets_shared",
        "@qtbase//:widgets_shared",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/turtle_nest",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    moc_hdrs = [
        "include/turtle_nest/addnodedialog.h",
        "include/turtle_nest/mainwindow.h",
        "include/turtle_nest/packageinfoform.h",
        "include/turtle_nest/packageswindow.h",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":turtle_nest_headers"],
)

genrule(
    name = "gen_ui_addnodedialog_h",
    srcs = ["src/addnodedialog.ui"],
    outs = ["_gen/include/ui_addnodedialog.h"],
    cmd = "$(execpath @qtbase//:uic) $(location src/addnodedialog.ui) -o $@",
    tools = ["@qtbase//:uic"],
)

genrule(
    name = "gen_ui_mainwindow_h",
    srcs = ["src/mainwindow.ui"],
    outs = ["_gen/include/ui_mainwindow.h"],
    cmd = "$(execpath @qtbase//:uic) $(location src/mainwindow.ui) -o $@",
    tools = ["@qtbase//:uic"],
)

genrule(
    name = "gen_ui_packageinfoform_h",
    srcs = ["src/packageinfoform.ui"],
    outs = ["_gen/include/ui_packageinfoform.h"],
    cmd = "$(execpath @qtbase//:uic) $(location src/packageinfoform.ui) -o $@",
    tools = ["@qtbase//:uic"],
)

genrule(
    name = "gen_ui_packageswindow_h",
    srcs = ["src/packageswindow.ui"],
    outs = ["_gen/include/ui_packageswindow.h"],
    cmd = "$(execpath @qtbase//:uic) $(location src/packageswindow.ui) -o $@",
    tools = ["@qtbase//:uic"],
)

ament_index(
    name = "ament_index",
    lib_data = [
        ":turtle_nest",
        "src/python_file_utils.py",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@tinyxml2_vendor//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@tinyxml2_vendor//:ament_package",
    ],
)
