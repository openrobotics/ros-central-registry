load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

DEPENDENCIES = {
    "@gz_plugin_vendor//:gz_plugin": "@gz_plugin_vendor//:gz_plugin_library",
    "@gz_sim_vendor//:gz_sim": "@gz_sim_vendor//:gz_sim_library",
    "@rosdistro//cc/gz:gz-common": "@rosdistro//cc/gz:gz-common_library",
    "@rosdistro//cc/gz:gz-msgs": "@rosdistro//cc/gz:gz-msgs_library",
    "@rosdistro//cc/gz:sdformat": "@rosdistro//cc/gz:sdformat_library",
    "@rosdistro//cc:protobuf": "@rosdistro//cc:protobuf_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
}

CC_DEPS = [
    "@gz_plugin_vendor//:gz_plugin_register_library",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
    "@rosdistro//cc:spdlog",
]

cc_library(
    name = "leo_gz_differential_plugin_library",
    srcs = ["src/differential_system.cpp"],
    hdrs = [],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines() + ["HAVE_PYBIND11"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "leo_gz_differential_plugin",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":leo_gz_differential_plugin_library"],
)

register_ament_files(
    name = "ament_files_0",
    files = [
        "hooks/gz_sim_system_plugin_path.dsv",
    ],
    prefix = "environment",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_1",
    files = [
        "hooks/gz_sim_system_plugin_path.sh",
    ],
    prefix = "environment",
    strip_prefix = "*",
)

ament_index(
    name = "ament_index",
    data = [
        ":ament_files_0",
        ":ament_files_1",
    ],
    libraries = [
        ":leo_gz_differential_plugin",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@gz_plugin_vendor//:ament_package",
        "@gz_sim_vendor//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    libraries = [
        ":leo_gz_differential_plugin",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@gz_plugin_vendor//:ament_package",
        "@gz_sim_vendor//:ament_package",
    ],
)
