package(default_visibility = ["//visibility:public"])

py_library(
    name = "rqt_runtime_monitor",
    srcs = glob(["src/rqt_runtime_monitor/**/*.py"]),
    imports = ["src"],
    deps = [
        "@ament_index_python",
        "@diagnostic_msgs//:py",
        "@python_qt_binding",
        "@qt_gui",
        "@rclpy",
        "@rqt_gui",
        "@rqt_gui_py",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"rqt_runtime_monitor": "rqt_runtime_monitor.runtime_monitor:main"},
    data = [
        "plugin.xml",
        "resource/runtime_monitor_widget.ui",
    ],
    executables = ["resource/rqt_runtime_monitor"],
    package_xml = "package.xml",
    python = [":rqt_runtime_monitor"],
    python_strip_prefix = "src",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@python_qt_binding//:ament_package",
        "@qt_gui//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
    ],
)
