load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "smach_ros",
    srcs = glob(["smach_ros/**/*.py"]),
    imports = ["."],
    deps = [
        "@rclpy",
        "@smach",
        "@smach_msgs//:py",
        "@std_msgs//:py",
        "@std_srvs//:py",
    ],
)

py_test(
    name = "introspection_test",
    srcs = ["test/introspection_test.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    main = "test/introspection_test.py",
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":smach_ros"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":smach_ros"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@smach//:ament_package",
        "@smach_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
