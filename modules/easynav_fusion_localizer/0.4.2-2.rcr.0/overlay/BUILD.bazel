load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@rosdistro//cc:geographiclib": "@rosdistro//cc:geographiclib_library",
}

CC_DEPS = []

cc_library(
    name = "fusion_localizer_library",
    srcs = [
        "src/easynav_fusion_localizer/FusionLocalizer.cpp",
        "src/easynav_fusion_localizer/ukf_wrapper.cpp",
    ],
    hdrs = [
        "include/easynav_fusion_localizer/FusionLocalizer.hpp",
        "include/easynav_fusion_localizer/ukf_wrapper.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/easynav_fusion_localizer",
        "tests",
    ],
    local_defines = ros_local_defines() + [
        "EASYNAV_DEBUG_WITH_YAETS",
        "GLAD_API_CALL_EXPORT",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "fusion_localizer",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":fusion_localizer_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    data = [
        "maps/empty.png",
        "maps/empty.yaml",
        "maps/square.png",
        "maps/square.yaml",
    ],
    libraries = [":fusion_localizer"],
    package_xml = "package.xml",
    plugin_category = "easynav_core",
    plugins = ["easynav_fusion_localizer_plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@angles//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@easynav_common//:ament_package",
        "@easynav_core//:ament_package",
        "@easynav_localizer//:ament_package",
        "@easynav_sensors//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@robot_localization//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@yaets//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "Eigen3",
        "angles",
        "diagnostic_msgs",
        "diagnostic_updater",
        "easynav_common",
        "easynav_core",
        "easynav_localizer",
        "easynav_sensors",
        "geometry_msgs",
        "nav_msgs",
        "pluginlib",
        "rclcpp",
        "rclcpp_lifecycle",
        "robot_localization",
        "sensor_msgs",
        "std_srvs",
        "tf2",
        "tf2_geometry_msgs",
        "tf2_ros",
        "yaets",
    ],
    cmake_export_name = "export_easynav_fusion_localizer",
    headers = [
        "include/easynav_fusion_localizer/FusionLocalizer.hpp",
        "include/easynav_fusion_localizer/ukf_wrapper.hpp",
    ],
    include_prefix = "",
    libraries = [":fusion_localizer"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@angles//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@easynav_common//:ament_package",
        "@easynav_core//:ament_package",
        "@easynav_localizer//:ament_package",
        "@easynav_sensors//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@robot_localization//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@yaets//:ament_package",
    ],
)
