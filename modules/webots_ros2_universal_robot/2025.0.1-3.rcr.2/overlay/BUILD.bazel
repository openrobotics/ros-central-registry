ament_package(
    name = "ament_package",
    console_scripts = {
        "abb_controller": "webots_ros2_universal_robot.abb_controller:main",
        "ur5e_controller": "webots_ros2_universal_robot.ur5e_controller:main",
    },
    package_xml = "package.xml",
    python = [":webots_ros2_universal_robot"],
    setup_cfg = "setup.cfg",
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@control_msgs//:ament_package",
        "@controller_manager//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@joint_trajectory_controller//:ament_package",
        "@rclpy//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
        "@trajectory_msgs//:ament_package",
        "@webots_ros2_control//:ament_package",
        "@webots_ros2_driver//:ament_package",
        "@xacro//:ament_package",
    ],
)

launch_ros_binary(
    name = "launch_multirobot_launch_py",
    src = "launch/multirobot_launch.py",
    data = [
        ":ament_index",
        "@controller_manager//:ament_index",
        "@joint_state_broadcaster//:ament_index",
        "@joint_trajectory_controller//:ament_index",
        "@robot_state_publisher//:ament_index",
        "@webots_ros2_control//:ament_index",
        "@webots_ros2_driver//:ament_index",
    ],
    deps = [
        ":abb_controller",
        ":ur5e_controller",
        ":webots_ros2_universal_robot",
        "@controller_manager//:spawner",
        "@robot_state_publisher",
        "@webots_ros2_driver",
        "@webots_ros2_driver//:driver",
        "@webots_ros2_driver//:ros2_supervisor.py",
        "@xacro//:xacro_lib",
    ],
)

launch_ros_binary(
    name = "launch_robot_launch_robot_moveit_nodes_launch_py",
    src = "launch/robot_launch/robot_moveit_nodes_launch.py",
    data = [
        ":ament_index",
        "@moveit_ros_move_group//:ament_index",
        "@rviz2//:ament_index",
    ],
    deps = [
        ":launch_robot_launch_robot_nodes_launch_py",
        "@moveit_ros_move_group//:move_group",
        "@rviz2",
        requirement("pyyaml"),
    ],
)

launch_ros_binary(
    name = "launch_robot_launch_robot_nodes_launch_py",
