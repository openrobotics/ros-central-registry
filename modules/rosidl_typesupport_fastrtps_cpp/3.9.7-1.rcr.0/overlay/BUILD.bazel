load("@rosdistro//ament:defs.bzl", "ament_package", "register_ament_resource")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

filegroup(
    name = "interface_templates",
    srcs = [
        "resource/idl__rosidl_typesupport_fastrtps_cpp.hpp.em",
        "resource/idl__type_support.cpp.em",
        "resource/msg__rosidl_typesupport_fastrtps_cpp.hpp.em",
        "resource/msg__type_support.cpp.em",
        "resource/srv__rosidl_typesupport_fastrtps_cpp.hpp.em",
        "resource/srv__type_support.cpp.em",
    ],
)

exports_files(srcs = ["resource/rosidl_typesupport_fastrtps_cpp__visibility_control.h.in"])

HEADERS = [
    "include/rosidl_typesupport_fastrtps_cpp/buffer_serialization.hpp",
    "include/rosidl_typesupport_fastrtps_cpp/identifier.hpp",
    "include/rosidl_typesupport_fastrtps_cpp/message_type_support.h",
    "include/rosidl_typesupport_fastrtps_cpp/message_type_support_decl.hpp",
    "include/rosidl_typesupport_fastrtps_cpp/serialization_helpers.hpp",
    "include/rosidl_typesupport_fastrtps_cpp/service_type_support.h",
    "include/rosidl_typesupport_fastrtps_cpp/service_type_support_decl.hpp",
    "include/rosidl_typesupport_fastrtps_cpp/visibility_control.h",
]

DEPENDENCIES = {
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosdistro//cc:fastcdr": "@rosdistro//cc:fastcdr_library",
    "@rosidl_buffer_backend//:rosidl_buffer_backend": "@rosidl_buffer_backend//:rosidl_buffer_backend_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
    "@rosidl_runtime_cpp//:rosidl_runtime_cpp": "@rosidl_runtime_cpp//:rosidl_runtime_cpp_library",
    "@rosidl_typesupport_interface//:rosidl_typesupport_interface": "@rosidl_typesupport_interface//:rosidl_typesupport_interface_library",
}

cc_library(
    name = "rosidl_typesupport_fastrtps_cpp_library",
    srcs = ["src/identifier.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rosidl_typesupport_fastrtps_cpp",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rosidl_typesupport_fastrtps_cpp_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rosidl_typesupport_fastrtps_cpp"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "rosidl_typesupport_fastrtps_cpp_py",
    srcs = [
        "rosidl_typesupport_fastrtps_cpp/__init__.py",
        "rosidl_typesupport_fastrtps_cpp/cli.py",
    ],
    deps = [
        "@ament_index_python",
        "@rosidl_cli",
        "@rosidl_generator_cpp",
        "@rosidl_pycommon",
    ],
)

genrule(
    name = "cli_rename",
    srcs = ["bin/rosidl_typesupport_fastrtps_cpp"],
    outs = ["bin/rosidl_typesupport_fastrtps_cpp.py"],
    cmd = "cp $(location :bin/rosidl_typesupport_fastrtps_cpp) $(location :bin/rosidl_typesupport_fastrtps_cpp.py)",
)

py_binary(
    name = "cli",
    srcs = [":bin/rosidl_typesupport_fastrtps_cpp.py"],
    main = ":bin/rosidl_typesupport_fastrtps_cpp.py",
    deps = [":rosidl_typesupport_fastrtps_cpp_py"],
)

genrule(
    name = "extras_cmake",
    srcs = ["rosidl_typesupport_fastrtps_cpp-extras.cmake.in"],
    outs = ["rosidl_typesupport_fastrtps_cpp-extras.cmake"],
    cmd = "sed -e 's|@rosidl_typesupport_fastrtps_cpp_LIBRARY_TYPE@|SHARED|g' -e 's|@PROJECT_NAME@|rosidl_typesupport_fastrtps_cpp|g' -e 's|@PYTHON_INSTALL_DIR@|lib/python3.14/site-packages|g' $< > $@",
)

register_ament_resource(
    name = "res_rosidl_typesupport_cpp",
    category = "rosidl_typesupport_cpp",
    content = "",
)

ament_package(
    name = "ament_package",
    cmake = [":extras_cmake"] + ["cmake/rosidl_typesupport_fastrtps_cpp_generate_interfaces.cmake"],
    cmake_extras = ["rosidl_typesupport_fastrtps_cpp-extras.cmake"],
    data = [":res_rosidl_typesupport_cpp"] + [
        "resource/idl__rosidl_typesupport_fastrtps_cpp.hpp.em",
        "resource/idl__type_support.cpp.em",
        "resource/msg__rosidl_typesupport_fastrtps_cpp.hpp.em",
        "resource/msg__type_support.cpp.em",
        "resource/rosidl_typesupport_fastrtps_cpp__visibility_control.h.in",
        "resource/srv__rosidl_typesupport_fastrtps_cpp.hpp.em",
        "resource/srv__type_support.cpp.em",
    ],
    headers = HEADERS,
    include_prefix = "",
    lib_data = ["bin/rosidl_typesupport_fastrtps_cpp"],
    libraries = [":rosidl_typesupport_fastrtps_cpp"],
    package_xml = "package.xml",
    python = [
        "rosidl_typesupport_fastrtps_cpp/__init__.py",
        "rosidl_typesupport_fastrtps_cpp/cli.py",
    ],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros_core//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@osrf_testing_tools_cpp//:ament_package",
        "@performance_test_fixture//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_buffer_backend//:ament_package",
        "@rosidl_cli//:ament_package",
        "@rosidl_generator_c//:ament_package",
        "@rosidl_generator_cpp//:ament_package",
        "@rosidl_pycommon//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
        "@rosidl_typesupport_interface//:ament_package",
    ],
)
