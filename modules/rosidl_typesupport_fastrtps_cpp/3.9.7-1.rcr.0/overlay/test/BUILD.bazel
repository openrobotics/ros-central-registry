load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosdistro//cc:fastcdr": "@rosdistro//cc:fastcdr_library",
    "@rosidl_buffer_backend//:rosidl_buffer_backend": "@rosidl_buffer_backend//:rosidl_buffer_backend_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
    "@rosidl_runtime_cpp//:rosidl_runtime_cpp": "@rosidl_runtime_cpp//:rosidl_runtime_cpp_library",
}

py_pytest(
    name = "test_cli_extension",
    srcs = ["test_cli_extension.py"],
    data = ["//test/msg:Test.msg"],
    deps = [
        "//:rosidl_typesupport_fastrtps_cpp_py",
        "@rosidl_cli",
    ],
)

cc_test(
    name = "test_buffer_wire_compat",
    srcs = ["test_buffer_wire_compat.cpp"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "//:rosidl_typesupport_fastrtps_cpp_library",
        "@rosdistro//cc:googletest",
    ],
)
