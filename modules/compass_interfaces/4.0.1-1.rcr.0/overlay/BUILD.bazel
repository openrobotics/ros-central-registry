load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines", "ros_version_header")
load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@cras_cpp_common//:cras_string_utils": "@cras_cpp_common//:cras_string_utils_library",
    "@cras_cpp_common//:cras_time_utils": "@cras_cpp_common//:cras_time_utils_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@rosdistro//cc:fmt",
    "@std_msgs//:cc",
]

cc_library(
    name = "compass_interfaces_string_utils_library",
    srcs = ["src/string_utils.cpp"],
    hdrs = ["include/compass_interfaces/string_utils.hpp"] + [":version_h"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/compass_interfaces",
        "_gen/include/compass_interfaces/compass_interfaces",
        "include",
        "include/compass_interfaces",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":cc"],
)

cc_shared_library(
    name = "compass_interfaces_string_utils",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":compass_interfaces_string_utils_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":compass_interfaces_string_utils"],
)

ros_version_header(
    name = "version_h",
    out = "_gen/include/compass_interfaces/compass_interfaces/version.h",
)

pkg_files(
    name = "pkg_files_extra_19",
    srcs = [":version_h"],
    prefix = "include/compass_interfaces/compass_interfaces",
)

default_generators(
    package_xml = "package.xml",
    deps = ["//msg:Azimuth"],
)

ament_index(
    name = "ament_index_extra",
    export_name = "compass_interfaces",
    libraries = [":compass_interfaces_string_utils"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@cras_cpp_common//:ament_package",
        "@cras_lint//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

rosidl_ament_package(
    cmake_export_dependencies_list = [
        "cras_cpp_common",
        "fastcdr",
        "rcutils",
        "rmw",
        "rosidl_default_runtime",
        "rosidl_runtime_c",
        "rosidl_runtime_cpp",
        "rosidl_typesupport_c",
        "rosidl_typesupport_cpp",
        "rosidl_typesupport_fastrtps_c",
        "rosidl_typesupport_fastrtps_cpp",
        "rosidl_typesupport_interface",
        "std_msgs",
    ],
    cmake_export_has_library_target = True,
    headers = ["include/compass_interfaces/string_utils.hpp"],
    install = [":pkg_files_extra_19"],
    interface_library = "compass_interfaces_string_utils",
    interface_library_export = "export_compass_interfaces",
    interface_library_location = "lib/libcompass_interfaces_string_utils.so",
    libraries = [":compass_interfaces_string_utils"],
    package_xml = "package.xml",
    deps = [":ament_index_extra"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@cras_cpp_common//:ament_package",
        "@cras_lint//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
