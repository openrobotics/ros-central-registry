load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@cras_cpp_common//:cras_string_utils": "@cras_cpp_common//:cras_string_utils_library",
    "@cras_cpp_common//:cras_time_utils": "@cras_cpp_common//:cras_time_utils_library",
}

CC_DEPS = [
    "@rosdistro//cc:fmt",
    "@std_msgs//:cc",
]

cc_library(
    name = "compass_interfaces_string_utils_library",
    srcs = [
        "src/string_utils.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_extra_19",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/compass_interfaces",
        "_gen/include/compass_interfaces/compass_interfaces",
        "include",
        "include/compass_interfaces",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":cc",
    ],
)

cc_shared_library(
    name = "compass_interfaces_string_utils",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":compass_interfaces_string_utils_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

write_file(
    name = "gen_extra_19",
    out = "_gen/include/compass_interfaces/compass_interfaces/version.h",
    content = ["// Copyright 2015 Open Source Robotics Foundation, Inc.\n//\n// Licensed under the Apache License, Version 2.0 (the \"License\");\n// you may not use this file except in compliance with the License.\n// You may obtain a copy of the License at\n//\n//     http://www.apache.org/licenses/LICENSE-2.0\n//\n// Unless required by applicable law or agreed to in writing, software\n// distributed under the License is distributed on an \"AS IS\" BASIS,\n// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n// See the License for the specific language governing permissions and\n// limitations under the License.\n\n#ifndef COMPASS_INTERFACES__VERSION_H_\n#define COMPASS_INTERFACES__VERSION_H_\n\n/// \\def COMPASS_INTERFACES_VERSION_MAJOR\n/// Defines COMPASS_INTERFACES major version number\n#define COMPASS_INTERFACES_VERSION_MAJOR (4)\n\n/// \\def COMPASS_INTERFACES_VERSION_MINOR\n/// Defines COMPASS_INTERFACES minor version number\n#define COMPASS_INTERFACES_VERSION_MINOR (0)\n\n/// \\def COMPASS_INTERFACES_VERSION_PATCH\n/// Defines COMPASS_INTERFACES version patch number\n#define COMPASS_INTERFACES_VERSION_PATCH (1)\n\n/// \\def COMPASS_INTERFACES_VERSION_STR\n/// Defines COMPASS_INTERFACES version string\n#define COMPASS_INTERFACES_VERSION_STR \"4.0.1\"\n\n/// \\def COMPASS_INTERFACES_VERSION_GTE\n/// Defines a macro to check whether the version of COMPASS_INTERFACES is greater than or equal to\n/// the given version triple.\n#define COMPASS_INTERFACES_VERSION_GTE(major, minor, patch) ( \\\n     (major < COMPASS_INTERFACES_VERSION_MAJOR) ? true \\\n     : ((major > COMPASS_INTERFACES_VERSION_MAJOR) ? false \\\n     : ((minor < COMPASS_INTERFACES_VERSION_MINOR) ? true \\\n     : ((minor > COMPASS_INTERFACES_VERSION_MINOR) ? false \\\n     : ((patch < COMPASS_INTERFACES_VERSION_PATCH) ? true \\\n     : ((patch > COMPASS_INTERFACES_VERSION_PATCH) ? false \\\n     : true))))))\n\n#endif  // COMPASS_INTERFACES__VERSION_H_\n"],
)

pkg_files(
    name = "pkg_files_inc_18",
    srcs = ["include/compass_interfaces/string_utils.hpp"],
    prefix = "include/compass_interfaces/compass_interfaces",
)

pkg_files(
    name = "pkg_files_extra_19",
    srcs = [":gen_extra_19"],
    prefix = "include/compass_interfaces/compass_interfaces",
)

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:Azimuth",
    ],
)

ament_index(
    name = "ament_index_extra",
    export_name = "compass_interfaces",
    libraries = [
        ":compass_interfaces_string_utils",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@cras_cpp_common//:ament_package",
        "@cras_lint//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

cc_test(
    name = "test_string_utils",
    srcs = [
        "test/test_string_utils.cpp",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        ":ament_index",
        ":ament_index_extra",
        ":compass_interfaces_string_utils",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/compass_interfaces",
        "_gen/include/compass_interfaces/compass_interfaces",
        "include",
        "include/compass_interfaces",
    ],
    local_defines = ros_local_defines() + ["GTEST_HAS_PTHREAD=1"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":cc",
        ":compass_interfaces_string_utils_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

rosidl_ament_package(
    cmake_export_dependencies_list = [
        "std_msgs",
        "rosidl_runtime_c",
        "rosidl_typesupport_interface",
        "rcutils",
        "fastcdr",
        "rosidl_runtime_c",
        "rosidl_runtime_cpp",
        "rosidl_typesupport_fastrtps_c",
        "rosidl_typesupport_fastrtps_cpp",
        "rosidl_typesupport_interface",
        "rosidl_runtime_cpp",
        "fastcdr",
        "rmw",
        "rosidl_runtime_c",
        "rosidl_runtime_cpp",
        "rosidl_typesupport_fastrtps_cpp",
        "rosidl_typesupport_interface",
        "rosidl_runtime_c",
        "rosidl_typesupport_c",
        "rosidl_typesupport_interface",
        "rosidl_runtime_c",
        "rosidl_runtime_cpp",
        "rosidl_typesupport_c",
        "rosidl_typesupport_cpp",
        "rosidl_typesupport_interface",
        "cras_cpp_common",
        "rosidl_default_runtime",
    ],
    cmake_export_has_library_target = True,
    install = [
        ":pkg_files_inc_18",
        ":pkg_files_extra_19",
    ],
    interface_library = "compass_interfaces_string_utils",
    interface_library_export = "export_compass_interfaces",
    interface_library_location = "lib/libcompass_interfaces_string_utils.so",
    libraries = [
        ":compass_interfaces_string_utils",
    ],
    package_xml = "package.xml",
    deps = [":ament_index_extra"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@cras_cpp_common//:ament_package",
        "@cras_lint//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
