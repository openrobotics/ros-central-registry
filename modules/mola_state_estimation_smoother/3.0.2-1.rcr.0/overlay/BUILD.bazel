load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_package")

package(default_visibility = ["//visibility:public"])

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@gtsam//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@mola_bridge_ros2//:ament_package",
        "@mola_common//:ament_package",
        "@mola_gtsam_factors//:ament_package",
        "@mola_imu_preintegration//:ament_package",
        "@mola_kernel//:ament_package",
        "@mola_launcher//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@ros_environment//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

launch_ros_binary(
    name = "ros2_launchs_ros2_fuse_two_odometries_launch_py",
    src = "ros2-launchs/ros2-fuse-two-odometries.launch.py",
    data = [
        "@mola_launcher//:ament_index",
        "@rviz2//:ament_index",
    ],
)

launch_ros_binary(
    name = "ros2_launchs_ros2_state_estimator_launch_py",
    src = "ros2-launchs/ros2-state-estimator.launch.py",
    data = ["@mola_launcher//:ament_index"],
)
