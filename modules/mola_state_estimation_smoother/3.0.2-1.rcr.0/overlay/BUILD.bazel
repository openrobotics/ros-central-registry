load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
)

DEPENDENCIES = {
    "@gtsam//:cephes-gtsam": "@gtsam//:cephes-gtsam_library",
    "@gtsam//:gtsam": "@gtsam//:gtsam_library",
    "@gtsam//:gtsam_unstable": "@gtsam//:gtsam_unstable_library",
    "@gtsam//:metis-gtsam": "@gtsam//:metis-gtsam_library",
    "@mola_gtsam_factors//:mola_gtsam_factors": "@mola_gtsam_factors//:mola_gtsam_factors_library",
    "@mola_imu_preintegration//:mola_imu_preintegration": "@mola_imu_preintegration//:mola_imu_preintegration_library",
    "@mola_kernel//:mola_kernel": "@mola_kernel//:mola_kernel_library",
    "@mrpt_obs//:mrpt_obs": "@mrpt_obs//:mrpt_obs_library",
    "@rosdistro//cc:boost.filesystem_shared": "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.thread_shared": "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:boost.timer_shared": "@rosdistro//cc:boost.timer",
}

CC_DEPS = [
    "@gtsam//:_gen_textual_hdrs",
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:eigen",
]

HEADERS = [
    "include/mola_state_estimation_smoother/Parameters.h",
    "include/mola_state_estimation_smoother/StateEstimationSmoother.h",
    "include/mola_state_estimation_smoother/pose_pdf_to_string_with_sigmas.h",
]

DATA_FILES = [
    "mola-cli-launchs/demo_lidar_odom_plus_wheel_odom_fusion.yaml",
    "mola-cli-launchs/state_estimator_ros2.yaml",
    "params/state-estimation-smoother.yaml",
    "ros2-launchs/ros2-fuse-two-odometries.launch.py",
    "ros2-launchs/ros2-state-estimator.launch.py",
]

cc_library(
    name = "mola_state_estimation_smoother_library",
    srcs = [
        "src/FastPredictor.cpp",
        "src/FastPredictor.h",
        "src/Parameters.cpp",
        "src/Snapshot.h",
        "src/StateEstimationSmoother.cpp",
        "src/extrapolation.h",
        "src/pose_pdf_to_string_with_sigmas.cpp",
        "src/register.cpp",
    ],
    hdrs = HEADERS,
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        ".",
        "include",
        "include/mola_state_estimation_smoother",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=0",
        "MOLA_PATCH_VERSION=2",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_state_estimation_smoother",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mola_state_estimation_smoother_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":mola_state_estimation_smoother",
        "@rosdistro//cc:cli11_shared",
    ],
)

cc_binary(
    name = "mola-navstate-cli",
    srcs = ["apps/mola-navstate-cli.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":mola_state_estimation_smoother_library",
        "@rosdistro//cc:cli11",
    ],
)

### TESTS

[
    cc_test(
        name = test_name,
        srcs = ["tests/{}.cpp".format(test_name)],
        copts = ["-Wno-missing-template-arg-list-after-template-kw"],
        data = [":ament_index"],
        dynamic_deps = [":transitive_dynamic_deps"],
        deps = DEPENDENCIES.values() + CC_DEPS + [
            ":mola_state_estimation_smoother_library",
            "@rosdistro//cc:bazel_test_helper",
            "@rosdistro//cc:googletest",
        ],
    )
    for test_name in [
        "test-async-navstate",
        "test-finalized-trajectory",
        "test-gauge-anchors",
        "test-imu-gyro-abrupt-rotation",
        "test-imu-gyro-solver-stability",
        "test-keyframe-decimation",
        "test-kinematic-splice-no-triangle",
        "test-lidar-imu-leveling",
        "test-navstate-basic",
        "test-navstate-odom-gnss-fusion",
        "test-navstate-stamp-monotonic",
        "test-odometry-long-drift",
        "test-odometry-relative-same-keyframe",
        "test-pose-keyframe-decimation",
        "test-pose-robust-huber",
        "test-predict-twist-filter",
        "test-publish-map-to-odom",
        "test-relative-pose-factors",
        "test-relative-pose-increment-growth",
        "test-relative-pose-increment-sigma",
        "test-relative-pose-sigma-floor",
        "test-relative-source-map-to-odom",
        "test-relocalize-set-geo-reference",
        "test-static-gnss-imu-orientation",
        "test-twist-fusion",
        "test-two-odometries",
    ]
]

### PACKAGING

ament_index(
    name = "ament_index",
    data = DATA_FILES,
    libraries = [":mola_state_estimation_smoother"],
    package_xml = "package.xml",
    sonames = {"mola_state_estimation_smoother": [
        "libmola_state_estimation_smoother.so.3.0",
        "libmola_state_estimation_smoother.so.3.0.2",
    ]},
    deps = [
        "@geometry_msgs//:ament_package",
        "@gtsam//:ament_package",
        "@mola_bridge_ros2//:ament_package",
        "@mola_common//:ament_package",
        "@mola_gtsam_factors//:ament_package",
        "@mola_imu_preintegration//:ament_package",
        "@mola_kernel//:ament_package",
        "@mola_launcher//:ament_package",
        "@mrpt_obs//:ament_package",
        "@nav_msgs//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

ament_package(
    name = "ament_package",
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    data = DATA_FILES,
    executables = [":mola-navstate-cli"],
    headers = HEADERS,
    include_prefix = "",
    install_package_xml = False,
    libraries = [":mola_state_estimation_smoother"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@gtsam//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@mola_bridge_ros2//:ament_package",
        "@mola_common//:ament_package",
        "@mola_gtsam_factors//:ament_package",
        "@mola_imu_preintegration//:ament_package",
        "@mola_kernel//:ament_package",
        "@mola_launcher//:ament_package",
        "@mrpt_obs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@ros_environment//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

launch_ros_binary(
    name = "ros2_launchs_ros2_fuse_two_odometries_launch_py",
    src = "ros2-launchs/ros2-fuse-two-odometries.launch.py",
    data = [":ament_index"],
    deps = [
        ":mola-navstate-cli",
        "@mola_launcher//:mola-cli",
        "@rviz2",
    ],
)

launch_ros_binary(
    name = "ros2_launchs_ros2_state_estimator_launch_py",
    src = "ros2-launchs/ros2-state-estimator.launch.py",
    data = [":ament_index"],
    deps = [
        ":mola-navstate-cli",
        "@mola_launcher//:mola-cli",
    ],
)
