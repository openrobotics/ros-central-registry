load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "launch/ur_sim_control.launch.py",
        "launch/ur_sim_moveit.launch.py",
        "urdf/ur_gz.ros2_control.xacro",
        "urdf/ur_gz.urdf.xacro",
    ] + glob(["config/**"]),
    executables = ["@xacro//:xacro"],
    package_xml = "package.xml",
    deps = [
        "@ur_description//:ament_index",
    ],
)

py_pytest(
    name = "description",
    srcs = ["test/test_description.py"],
    data = [
        ":ament_index",
        "@ur_description//:ur_urdf_xacro",
        "@xacro",
    ],
    env = {"PATH": "bin:/usr/bin:/bin"},
    tags = [
        "manual",
        "xfail",
    ],
    deps = [
        "@launch_ros",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@gz_ros2_control//:ament_package",
        "@joint_state_publisher//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@ros_gz_bridge//:ament_package",
        "@ros_gz_sim//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
        "@ur_controllers//:ament_package",
        "@ur_description//:ament_package",
        "@ur_moveit_config//:ament_package",
        "@urdf//:ament_package",
        "@xacro//:ament_package",
    ],
)
