load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "ur_sim_control.launch.py",
        "ur_sim_moveit.launch.py",
    ],
)

launch_ros_binary(
    name = "ur_sim_control_launch",
    src = "ur_sim_control.launch.py",
    data = [
        "//:ament_index",
        "@controller_manager//:ament_index",
        # gz_ros2_control-system Gazebo plugin (found via LD_LIBRARY_PATH=lib).
        "@gz_ros2_control//:ament_index",
        "@robot_state_publisher",
        "@robot_state_publisher//:ament_index",
        "@ros_gz_bridge//:ament_index",
        "@ros_gz_bridge//:parameter_bridge",
        "@ros_gz_sim//:ament_index",
        "@ros_gz_sim//:create",
        "@ros_gz_sim//launch:gz_sim_launch",
        "@rviz2",
        "@rviz2//:ament_index",
        "@ur_controllers//:ament_index",
        "@ur_description//:ament_index",
        "@xacro",
        "@xacro//:ament_index",
    ],
    # Both launch files (transitively) include ros_gz_sim's gz_sim.launch.py,
    # which runs in this interpreter.
    deps = ["@ros_gz_sim//launch:gz_sim_launch_deps"],
)

launch_ros_binary(
    name = "ur_sim_moveit_launch",
    src = "ur_sim_moveit.launch.py",
    data = [
        ":ur_sim_control_launch",
        "//:ament_index",
        "@controller_manager//:ament_index",
        "@robot_state_publisher",
        "@robot_state_publisher//:ament_index",
        "@ros_gz_bridge//:ament_index",
        "@ros_gz_bridge//:parameter_bridge",
        "@ros_gz_sim//:ament_index",
        "@ros_gz_sim//:create",
        "@rviz2",
        "@rviz2//:ament_index",
        "@ur_description//:ament_index",
        "@ur_moveit_config//:ament_index",
        # Runfiles of the included launch: move_group, servo_node, ...
        "@ur_moveit_config//launch:ur_moveit_launch",
        "@xacro",
        "@xacro//:ament_index",
    ],
    # Includes ur_sim_control.launch.py (-> ros_gz_sim's gz_sim.launch.py) and
    # ur_moveit_config's ur_moveit.launch.py, which run in this interpreter.
    deps = [
        "@ros_gz_sim//launch:gz_sim_launch_deps",
        "@ur_moveit_config//launch:ur_moveit_launch_deps",
    ],
)
