load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/canopen_base_driver/base_driver.hpp",
    "include/canopen_base_driver/diagnostic_collector.hpp",
    "include/canopen_base_driver/lely_driver_bridge.hpp",
    "include/canopen_base_driver/lifecycle_base_driver.hpp",
    "include/canopen_base_driver/node_interfaces/node_canopen_base_driver.hpp",
    "include/canopen_base_driver/node_interfaces/node_canopen_base_driver_impl.hpp",
    "include/canopen_base_driver/visibility_control.h",
]

# Map of shared library (key) to its static library (value).
DEPENDENCIES = {
    "@canopen_core//:node_canopen_driver": "@canopen_core//:node_canopen_driver_library",
    "@canopen_interfaces//:cc_shared": "@canopen_interfaces//:cc",
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@lely_core_libraries//:lely-can": "@lely_core_libraries//:lely-can_library",
    "@lely_core_libraries//:lely-co": "@lely_core_libraries//:lely-co_library",
    "@lely_core_libraries//:lely-coapp": "@lely_core_libraries//:lely-coapp_library",
    "@lely_core_libraries//:lely-ev": "@lely_core_libraries//:lely-ev_library",
    "@lely_core_libraries//:lely-io2": "@lely_core_libraries//:lely-io2_library",
    "@lely_core_libraries//:lely-libc": "@lely_core_libraries//:lely-libc_library",
    "@lely_core_libraries//:lely-util": "@lely_core_libraries//:lely-util_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:boost.thread_shared": "@rosdistro//cc:boost.thread",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@std_srvs//:cc_shared": "@std_srvs//:cc",
}

CC_DEPS = [
    "@rosdistro//cc:boost.lockfree",
    "@rosdistro//cc:boost.optional",
]

COPTS = [
    "-Wno-missing-template-arg-list-after-template-kw",
]

cc_library(
    name = "lely_driver_bridge_library",
    srcs = ["src/lely_driver_bridge.cpp"],
    hdrs = HEADERS,
    copts = COPTS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    target_compatible_with = ["@platforms//os:linux"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "lely_driver_bridge",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":lely_driver_bridge_library"],
)

cc_library(
    name = "node_canopen_base_driver_library",
    srcs = ["src/node_interfaces/node_canopen_base_driver.cpp"],
    hdrs = HEADERS,
    copts = COPTS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    target_compatible_with = ["@platforms//os:linux"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":lely_driver_bridge_library"],
)

cc_shared_library(
    name = "node_canopen_base_driver",
    dynamic_deps = DEPENDENCIES.keys() + [":lely_driver_bridge"],
    exports_filter = ["//:__subpackages__"],
    deps = [":node_canopen_base_driver_library"],
)

cc_library(
    name = "base_driver_library",
    srcs = ["src/base_driver.cpp"],
    hdrs = HEADERS,
    copts = COPTS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["CANOPEN_base_DRIVER_BUILDING_LIBRARY"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":lely_driver_bridge_library",
        ":node_canopen_base_driver_library",
    ],
    alwayslink = True,
)

cc_shared_library(
    name = "base_driver",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":lely_driver_bridge",
        ":node_canopen_base_driver",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":base_driver_library"],
)

cc_library(
    name = "lifecycle_base_driver_library",
    srcs = ["src/lifecycle_base_driver.cpp"],
    hdrs = HEADERS,
    copts = COPTS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["CANOPEN_base_DRIVER_BUILDING_LIBRARY"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":lely_driver_bridge_library",
        ":node_canopen_base_driver_library",
    ],
    alwayslink = True,
)

cc_shared_library(
    name = "lifecycle_base_driver",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":lely_driver_bridge",
        ":node_canopen_base_driver",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":lifecycle_base_driver_library"],
)

rclcpp_components_register_nodes(
    name = "base_driver_components",
    component = ":base_driver",
    plugins = ["ros2_canopen::BaseDriver"],
)

rclcpp_components_register_nodes(
    name = "lifecycle_base_driver_components",
    component = ":lifecycle_base_driver",
    plugins = ["ros2_canopen::LifecycleBaseDriver"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":lely_driver_bridge",
        ":node_canopen_base_driver",
        "@canopen_core//:device_container",
        "@canopen_core//:node_canopen_master",
        "@rclcpp_components//:component_manager",
    ],
)

ament_index(
    name = "ament_index",
    components = [
        ":base_driver_components",
        ":lifecycle_base_driver_components",
    ],
    libraries = [
        ":lely_driver_bridge",
        ":node_canopen_base_driver",
        ":base_driver",
        ":lifecycle_base_driver",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@canopen_core//:ament_package",
        "@canopen_interfaces//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@lely_core_libraries//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "canopen_core",
        "canopen_interfaces",
        "diagnostic_updater",
        "lely_core_libraries",
        "rclcpp",
        "rclcpp_components",
        "rclcpp_lifecycle",
        "std_msgs",
        "std_srvs",
    ],
    cmake_export_name = "export_canopen_base_driver",
    headers = HEADERS,
    include_prefix = "",
    libraries = [
        ":lely_driver_bridge",
        ":node_canopen_base_driver",
        ":base_driver",
        ":lifecycle_base_driver",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@canopen_core//:ament_package",
        "@canopen_interfaces//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@lely_core_libraries//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
