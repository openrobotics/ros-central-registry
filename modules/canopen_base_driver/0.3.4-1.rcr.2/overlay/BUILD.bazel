load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {}

CC_DEPS = []

cc_library(
    name = "lely_driver_bridge_library",
    srcs = ["src/lely_driver_bridge.cpp"],
    hdrs = [
        "include/canopen_base_driver/base_driver.hpp",
        "include/canopen_base_driver/diagnostic_collector.hpp",
        "include/canopen_base_driver/lely_driver_bridge.hpp",
        "include/canopen_base_driver/lifecycle_base_driver.hpp",
        "include/canopen_base_driver/node_interfaces/node_canopen_base_driver.hpp",
        "include/canopen_base_driver/node_interfaces/node_canopen_base_driver_impl.hpp",
        "include/canopen_base_driver/visibility_control.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/canopen_base_driver",
        "test",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "lely_driver_bridge",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":lely_driver_bridge_library"],
)

cc_library(
    name = "node_canopen_base_driver_library",
    srcs = ["src/node_interfaces/node_canopen_base_driver.cpp"],
    hdrs = [
        "include/canopen_base_driver/base_driver.hpp",
        "include/canopen_base_driver/diagnostic_collector.hpp",
        "include/canopen_base_driver/lely_driver_bridge.hpp",
        "include/canopen_base_driver/lifecycle_base_driver.hpp",
        "include/canopen_base_driver/node_interfaces/node_canopen_base_driver.hpp",
        "include/canopen_base_driver/node_interfaces/node_canopen_base_driver_impl.hpp",
        "include/canopen_base_driver/visibility_control.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/canopen_base_driver",
        "test",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "node_canopen_base_driver",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":node_canopen_base_driver_library"],
)

cc_library(
    name = "base_driver_library",
    srcs = ["src/base_driver.cpp"],
    hdrs = [
        "include/canopen_base_driver/base_driver.hpp",
        "include/canopen_base_driver/diagnostic_collector.hpp",
        "include/canopen_base_driver/lely_driver_bridge.hpp",
        "include/canopen_base_driver/lifecycle_base_driver.hpp",
        "include/canopen_base_driver/node_interfaces/node_canopen_base_driver.hpp",
        "include/canopen_base_driver/node_interfaces/node_canopen_base_driver_impl.hpp",
        "include/canopen_base_driver/visibility_control.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/canopen_base_driver",
        "test",
    ],
    local_defines = ros_local_defines() + ["CANOPEN_base_DRIVER_BUILDING_LIBRARY"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "base_driver",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":base_driver_library"],
)

cc_library(
    name = "lifecycle_base_driver_library",
    srcs = ["src/lifecycle_base_driver.cpp"],
    hdrs = [
        "include/canopen_base_driver/base_driver.hpp",
        "include/canopen_base_driver/diagnostic_collector.hpp",
        "include/canopen_base_driver/lely_driver_bridge.hpp",
        "include/canopen_base_driver/lifecycle_base_driver.hpp",
        "include/canopen_base_driver/node_interfaces/node_canopen_base_driver.hpp",
        "include/canopen_base_driver/node_interfaces/node_canopen_base_driver_impl.hpp",
        "include/canopen_base_driver/visibility_control.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/canopen_base_driver",
        "test",
    ],
    local_defines = ros_local_defines() + ["CANOPEN_base_DRIVER_BUILDING_LIBRARY"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "lifecycle_base_driver",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":lifecycle_base_driver_library"],
)

rclcpp_components_register_nodes(
    name = "base_driver_components",
    component = ":base_driver",
    plugins = ["ros2_canopen::BaseDriver"],
)

rclcpp_components_register_nodes(
    name = "lifecycle_base_driver_components",
    component = ":lifecycle_base_driver",
    plugins = ["ros2_canopen::LifecycleBaseDriver"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    components = [
        ":base_driver_components",
        ":lifecycle_base_driver_components",
    ],
    libraries = [
        ":lely_driver_bridge",
        ":node_canopen_base_driver",
        ":base_driver",
        ":lifecycle_base_driver",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@canopen_core//:ament_package",
        "@canopen_interfaces//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@lely_core_libraries//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "canopen_core",
        "canopen_interfaces",
        "diagnostic_updater",
        "lely_core_libraries",
        "rclcpp",
        "rclcpp_components",
        "rclcpp_lifecycle",
        "std_msgs",
        "std_srvs",
    ],
    cmake_export_name = "export_canopen_base_driver",
    headers = [
        "include/canopen_base_driver/base_driver.hpp",
        "include/canopen_base_driver/diagnostic_collector.hpp",
        "include/canopen_base_driver/lely_driver_bridge.hpp",
        "include/canopen_base_driver/lifecycle_base_driver.hpp",
        "include/canopen_base_driver/node_interfaces/node_canopen_base_driver.hpp",
        "include/canopen_base_driver/node_interfaces/node_canopen_base_driver_impl.hpp",
        "include/canopen_base_driver/visibility_control.h",
    ],
    include_prefix = "",
    libraries = [
        ":lely_driver_bridge",
        ":node_canopen_base_driver",
        ":base_driver",
        ":lifecycle_base_driver",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@canopen_core//:ament_package",
        "@canopen_interfaces//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@lely_core_libraries//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
