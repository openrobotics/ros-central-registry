load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "apriltag_array_pose_estimation.launch.xml",
        "apriltag_ros.launch.xml",
        "hitch_estimation_apriltag_array.launch.xml",
        "hitch_joint_state_estimation.launch.xml",
    ],
)

launch_ros_binary(
    name = "apriltag_array_pose_estimation_launch",
    src = "apriltag_array_pose_estimation.launch.xml",
    data = [
        "//:ament_index",
        "//:apriltag_array_pose_estimation_node",
    ],
    deps = ["//:hitch_estimation_apriltag_array"],
)

launch_ros_binary(
    name = "apriltag_ros_launch",
    src = "apriltag_ros.launch.xml",
    data = [
        "//:ament_index",
        "@apriltag_ros//:ament_package",
    ],
    deps = ["//:hitch_estimation_apriltag_array"],
)

launch_ros_binary(
    name = "hitch_estimation_apriltag_array_launch",
    src = "hitch_estimation_apriltag_array.launch.xml",
    data = [
        ":apriltag_array_pose_estimation_launch",
        ":apriltag_ros_launch",
        ":hitch_joint_state_estimation_launch",
        "//:ament_index",
        "//:apriltag_array_pose_estimation_node",
        "//:hitch_joint_state_estimation_node",
    ],
    deps = ["//:hitch_estimation_apriltag_array"],
)

launch_ros_binary(
    name = "hitch_joint_state_estimation_launch",
    src = "hitch_joint_state_estimation.launch.xml",
    data = [
        "//:ament_index",
        "//:hitch_joint_state_estimation_node",
    ],
    deps = ["//:hitch_estimation_apriltag_array"],
)
