load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "hitch_estimation_apriltag_array",
    srcs = [
        "hitch_estimation_apriltag_array/__init__.py",
        "hitch_estimation_apriltag_array/apriltag_array_pose_estimation_node.py",
        "hitch_estimation_apriltag_array/hitch_joint_state_estimation_node.py",
    ],
    imports = ["."],
    deps = [
        "@apriltag_msgs//:py",
        "@geometry_msgs//:py",
        "@rclpy",
        "@sensor_msgs//:py",
        "@tf_transformations",
        requirement("numpy"),
    ],
)

py_binary(
    name = "apriltag_array_pose_estimation_node",
    srcs = ["hitch_estimation_apriltag_array/apriltag_array_pose_estimation_node.py"],
    main = "hitch_estimation_apriltag_array/apriltag_array_pose_estimation_node.py",
    deps = [":hitch_estimation_apriltag_array"],
)

py_binary(
    name = "hitch_joint_state_estimation_node",
    srcs = ["hitch_estimation_apriltag_array/hitch_joint_state_estimation_node.py"],
    main = "hitch_estimation_apriltag_array/hitch_joint_state_estimation_node.py",
    deps = [":hitch_estimation_apriltag_array"],
)

ament_index(
    name = "ament_index",
    data = ["config/params.yaml"] + ["//launch:launch_files"],
    package_xml = "package.xml",
    deps = [
        "@apriltag_msgs//:ament_package",
        "@apriltag_ros//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@tf_transformations//:ament_package",
    ],
)

ament_package(
    console_scripts = {
        "apriltag_array_pose_estimation_node": "hitch_estimation_apriltag_array.apriltag_array_pose_estimation_node:main",
        "hitch_joint_state_estimation_node": "hitch_estimation_apriltag_array.hitch_joint_state_estimation_node:main",
    },
    package_xml = "package.xml",
    python = [":hitch_estimation_apriltag_array"],
    deps = [
        ":ament_index",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@apriltag_msgs//:ament_package",
        "@apriltag_ros//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@tf_transformations//:ament_package",
    ],
)
