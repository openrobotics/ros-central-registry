load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@urdf//:urdf": "@urdf//:urdf_library",
}

cc_library(
    name = "sdformat_urdf_library",
    srcs = ["src/sdformat_urdf.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["SDFORMAT_URDF_BUILDING_LIBRARY"],
    deps = [
        "@rcutils//:rcutils_library",
        "@rosdistro//cc:sdformat",
        "@urdf//:urdf_library",
    ],
)

cc_shared_library(
    name = "sdformat_urdf",
    dynamic_deps = [
        "@rcutils//:rcutils",
        "@urdf//:urdf",
    ],
    exports_filter = [
        ":sdformat_urdf_library",
        "@@gz-math+//:__subpackages__",
        "@@gz-utils+//:__subpackages__",
        "@@sdformat+//:__subpackages__",
    ],
    deps = [":sdformat_urdf_library"],
)

cc_library(
    name = "sdformat_urdf_plugin_library",
    srcs = ["src/sdformat_urdf_plugin.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["SDFORMAT_URDF_PLUGIN_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + [
        ":sdformat_urdf_library",
        "@rosdistro//cc:sdformat",
        "@urdf_parser_plugin//:urdf_parser_plugin_library",
    ],
)

cc_shared_library(
    name = "sdformat_urdf_plugin",
    dynamic_deps = DEPENDENCIES.keys() + [":sdformat_urdf"],
    exports_filter = [":sdformat_urdf_plugin_library"],
    deps = [":sdformat_urdf_plugin_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":sdformat_urdf",
        ":sdformat_urdf_plugin",
    ],
    visibility = ["//visibility:private"],
)

