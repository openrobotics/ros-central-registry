load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/sdformat_urdf/sdformat_urdf.hpp",
        "include/sdformat_urdf/visibility_control.hpp",
    ],
    includes = ["generated_includes"],
)

HEADERS = [
    "include/sdformat_urdf/sdformat_urdf.hpp",
    "include/sdformat_urdf/visibility_control.hpp",
]

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@sdformat_vendor//:sdformat": "@sdformat_vendor//:sdformat_library",
    "@urdf//:urdf": "@urdf//:urdf_library",
    "@urdf_parser_plugin//:urdf_parser_plugin": "@urdf_parser_plugin//:urdf_parser_plugin_library",
}

cc_library(
    name = "sdformat_urdf_library",
    srcs = ["src/sdformat_urdf.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["SDFORMAT_URDF_BUILDING_LIBRARY"],
    deps = [
        "@rcutils//:rcutils_library",
        "@rosdistro//cc:tinyxml2_library",
        "@sdformat_vendor//:sdformat_library",
        "@urdf//:urdf_library",
    ],
)

cc_shared_library(
    name = "sdformat_urdf",
    dynamic_deps = [
        "@rcutils//:rcutils",
        "@rosdistro//cc/gz:gz-math",
        "@rosdistro//cc/gz:gz-utils",
        "@rosdistro//cc:tinyxml2",
        "@sdformat_vendor//:sdformat",
        "@urdf//:urdf",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":sdformat_urdf_library"],
)

cc_library(
    name = "sdformat_urdf_plugin_library",
    srcs = ["src/sdformat_urdf_plugin.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["SDFORMAT_URDF_PLUGIN_BUILDING_DLL"],
    deps = [
        ":sdformat_urdf_library",
        "@pluginlib//:pluginlib_library",
        "@rcutils//:rcutils_library",
        "@rosdistro//cc:tinyxml2_library",
        "@sdformat_vendor//:sdformat_library",
        "@urdf//:urdf_library",
        "@urdf_parser_plugin//:urdf_parser_plugin_library",
    ],
)

cc_shared_library(
    name = "sdformat_urdf_plugin",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":sdformat_urdf",
        "@rosdistro//cc/gz:gz-math",
        "@rosdistro//cc/gz:gz-utils",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":sdformat_urdf_plugin_library"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":sdformat_urdf",
        ":sdformat_urdf_plugin",
        "@rosdistro//cc/gz:gz-math",
        "@rosdistro//cc/gz:gz-utils",
        "@sdformat_vendor//:sdformat",
    ],
    package_xml = "package.xml",
    plugin_category = "urdf_parser_plugin",
    plugins = ["sdformat_urdf_plugin.xml"],
    deps = ["@urdf_parser_plugin//:ament_index"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":sdformat_urdf",
        ":sdformat_urdf_plugin",
        "@rosdistro//cc/gz:gz-math",
        "@rosdistro//cc/gz:gz-utils",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "pluginlib",
        "rcutils",
        "sdformat_vendor",
        "tinyxml2",
        "urdf_parser_plugin",
        "urdfdom_headers",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "sdformat_urdf-export",
    headers = HEADERS,
    include_prefix = "",
    libraries = [
        ":sdformat_urdf",
        ":sdformat_urdf_plugin",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@pluginlib//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
        "@sdformat_test_files//:ament_package",
        "@sdformat_vendor//:ament_package",
        "@urdf//:ament_package",
        "@urdf_parser_plugin//:ament_package",
    ],
)
