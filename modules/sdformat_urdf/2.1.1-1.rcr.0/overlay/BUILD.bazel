cmake_configure_file(
    name = "sdf_paths_hpp",
    src = "test/sdf_paths.hpp.in",
    out = "generated_includes/sdf_paths.hpp",
    defines = [
        "path_to_sdf_{}=../sdformat_test_files+/models/{}/{}.sdf".format(m, m, m)
        for m in MODELS
    ],
)

cc_library(
    name = "test_headers",
    hdrs = glob(["test/include/**/*.hpp"]) + [":sdf_paths_hpp"],
    includes = [
        "generated_includes",
        "test/include",
    ],
)

[
    cc_test(
        name = "sdf_{}_tests".format(test_name),
        srcs = ["test/{}_tests.cpp".format(test_name)],
        data = ["@sdformat_test_files//:models"],
        dynamic_deps = [":transitive_dynamic_deps"],
        deps = [
            ":sdformat_urdf_library",
            ":test_headers",
            "@rcutils//:rcutils_library",
            "@rosdistro//cc:googletest",
            "@rosdistro//cc:sdformat",
            "@urdf//:urdf_library",
        ],
    )
    for test_name in [
        "geometry",
        "graph",
        "joint",
        "link",
        "material",
        "model",
        "pose",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "pluginlib",
        "rcutils",
        "sdformat_vendor",
        "tinyxml2",
        "urdf_parser_plugin",
        "urdfdom_headers",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "sdformat_urdf-export",
    headers = HEADERS,
    include_prefix = "",
    libraries = [
        ":sdformat_urdf",
        ":sdformat_urdf_plugin",
    ],
    package_xml = "package.xml",
    plugin_category = "urdf_parser_plugin",
    plugins = ["sdformat_urdf_plugin.xml"],
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@pluginlib//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
        "@sdformat_test_files//:ament_package",
        "@sdformat_vendor//:ament_package",
        "@urdf//:ament_package",
        "@urdf_parser_plugin//:ament_package",
    ],
)
