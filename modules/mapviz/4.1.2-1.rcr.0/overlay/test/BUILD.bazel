cc_test(
    name = "test_display_loader",
    srcs = ["test_display_loader.cpp"] + [] + [
        "//:gen_ui_configitem_h",
        "//:gen_ui_configitem_h_sub",
        "//:gen_ui_mapviz_h",
        "//:gen_ui_mapviz_h_sub",
        "//:gen_ui_pluginselect_h",
        "//:gen_ui_pluginselect_h_sub",
        "//:ui_configitem_h",
        "//:ui_mapviz_h",
        "//:ui_pluginselect_h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"],
    dynamic_deps = [
        "//:transitive_dynamic_deps",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtsvg//:svg_shared",
        "@qtbase//:widgets_shared",
        "@qtbase//:opengl_shared",
        "@qtbase//:openglwidgets_shared",
    ],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "USE_NEW_TF2_ROS_CTORS=0",
        "USE_NEW_TF2_TOMSG=1",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:mapviz_core_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

