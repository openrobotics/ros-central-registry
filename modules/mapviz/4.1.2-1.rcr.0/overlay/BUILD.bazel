qt_cc_library(
    name = "mapviz_core_library",
    srcs = [
        "src/color_button.cpp",
        "src/config_item.cpp",
        "src/display_loader.cpp",
        "src/map_canvas.cpp",
        "src/mapviz.cpp",
        "src/mapviz_application.cpp",
        "src/select_frame_dialog.cpp",
        "src/select_service_dialog.cpp",
        "src/video_writer.cpp",
    ],
    hdrs = [
        "include/mapviz/color_button.hpp",
        "include/mapviz/config_item.hpp",
        "include/mapviz/map_canvas.hpp",
        "include/mapviz/mapviz.hpp",
        "include/mapviz/mapviz_plugin.hpp",
        "include/mapviz/select_frame_dialog.hpp",
        "include/mapviz/select_service_dialog.hpp",
        "include/mapviz/video_writer.hpp",
        "include/mapviz/widgets.hpp",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
        "-include",
        "rcr_qt_libc_shim.hpp",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/mapviz",
        "include",
        "include/mapviz",
    ],
    local_defines = ros_local_defines() + [
        "MAPVIZ_IMAGE_TRANSPORT_TAKES_NODE_REF",
