cc_binary(
    name = "mapviz",
    srcs = [
        "src/mapviz_main.cpp",
        ":gen_qrc_icons_cpp",
    ] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
