load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### DATA

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

### C++ LIBRARY

HEADERS = glob(["include/**/*.h"])

cc_library(
    name = "angles",
    hdrs = HEADERS,
    data = [":ament_index"],
    includes = ["include"],
)

### PYTHON MODULE

py_library(
    name = "angles_py",
    srcs = glob(["angles/**"]),
    data = [":ament_index"],
    imports = ["."],
)

### TESTS

cc_test(
    name = "test_utest_cc",
    srcs = ["test/utest.cpp"],
    deps = [
        ":angles",
        "@rosdistro//cc:googletest",
    ],
)

py_pytest(
    name = "test_utest_py",
    srcs = ["test/utest.py"],
    deps = [
        ":angles_py",
        "@rules_python//python/runfiles",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_name = "export_angles",
    headers = HEADERS,
    package_xml = "package.xml",
    python = [":angles_py"],
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
