load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@controller_interface//:controller_interface": "@controller_interface//:controller_interface_library",
    "@hardware_interface//:hardware_interface": "@hardware_interface//:hardware_interface_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@urdf//:urdf": "@urdf//:urdf_library",
}

CC_DEPS = [
    "@std_msgs//:cc",
    "@builtin_interfaces//:cc",
    "@control_msgs//:cc",
    "@generate_parameter_library//:generate_parameter_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
    "@sensor_msgs//:cc",
    "@trajectory_msgs//:cc",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_library(
    name = "joint_trajectory_command_broadcaster_library",
    srcs = ["src/joint_trajectory_command_broadcaster.cpp"],
    hdrs = [
        "include/joint_trajectory_command_broadcaster/joint_trajectory_command_broadcaster.hpp",
        "include/joint_trajectory_command_broadcaster/visibility_control.h",
    ] + [":joint_trajectory_command_broadcaster_parameters_gen"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "_gen/include/ffw_joint_trajectory_command_broadcaster",
        "include",
        "include/ffw_joint_trajectory_command_broadcaster",
    ],
    local_defines = ros_local_defines() + [
        "JOINT_TRAJECTORY_COMMAND_BROADCASTER_BUILDING_DLL",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "joint_trajectory_command_broadcaster",
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":joint_trajectory_command_broadcaster_library"],
)

generate_parameter_library(
    name = "joint_trajectory_command_broadcaster_parameters",
    yaml_file = "src/joint_trajectory_command_broadcaster_parameters.yaml",
)

ament_index(
    name = "ament_index",
    libraries = [
        ":joint_trajectory_command_broadcaster",
    ],
    package_xml = "package.xml",
    plugin_category = "controller_interface",
    plugins = ["joint_trajectory_command_plugin.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@backward_ros//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@control_msgs//:ament_package",
        "@controller_interface//:ament_package",
        "@controller_manager//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@hardware_interface//:ament_package",
        "@hardware_interface_testing//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rcutils//:ament_package",
        "@realtime_tools//:ament_package",
        "@ros2_control_test_assets//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@trajectory_msgs//:ament_package",
        "@urdf//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "fmt",
        "rclcpp",
        "rclcpp_lifecycle",
        "rsl",
        "tcb_span",
        "tl-expected",
        "builtin_interfaces",
        "controller_interface",
        "generate_parameter_library",
        "pluginlib",
        "rclcpp_lifecycle",
        "rcutils",
        "realtime_tools",
        "urdf",
        "trajectory_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_joint_trajectory_command_broadcaster",
    headers = [
        ":joint_trajectory_command_broadcaster_parameters_gen",
        "include/joint_trajectory_command_broadcaster/joint_trajectory_command_broadcaster.hpp",
        "include/joint_trajectory_command_broadcaster/visibility_control.h",
    ],
    include_prefix = "joint_trajectory_command_broadcaster",
    libraries = [
        ":joint_trajectory_command_broadcaster",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@backward_ros//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@control_msgs//:ament_package",
        "@controller_interface//:ament_package",
        "@controller_manager//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@hardware_interface//:ament_package",
        "@hardware_interface_testing//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rcutils//:ament_package",
        "@realtime_tools//:ament_package",
        "@ros2_control_test_assets//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@trajectory_msgs//:ament_package",
        "@urdf//:ament_package",
    ],
)
