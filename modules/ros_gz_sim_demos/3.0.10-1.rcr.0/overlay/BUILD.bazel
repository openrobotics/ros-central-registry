load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

filegroup(
    name = "data",
    srcs = [
        "config/air_pressure.yaml",
        "config/battery.yaml",
        "config/camera.yaml",
        "config/diff_drive.yaml",
        "config/gpu_lidar.yaml",
        "config/imu.yaml",
        "config/magnetometer.yaml",
        "config/navsat.yaml",
        "config/navsat_gpsfix.yaml",
        "config/rgbd_camera_bridge.yaml",
        "config/tf_bridge.yaml",
        "config/triggered_camera.yaml",
        "models/cardboard_box/materials/textures/cardboard_box.png",
        "models/cardboard_box/meshes/cardboard_box.dae",
        "models/cardboard_box/model.config",
        "models/cardboard_box/model.sdf",
        "models/cardboard_box/thumbnails/1.png",
        "models/cardboard_box/thumbnails/2.png",
        "models/cardboard_box/thumbnails/3.png",
        "models/cardboard_box/thumbnails/4.png",
        "models/cardboard_box/thumbnails/5.png",
        "models/double_pendulum_model.sdf",
        "models/rrbot.xacro",
        "models/vehicle/model.config",
        "models/vehicle/model.sdf",
        "rviz/camera.rviz",
        "rviz/depth_camera.rviz",
        "rviz/diff_drive.rviz",
        "rviz/gpu_lidar.rviz",
        "rviz/gpu_lidar_bridge.rviz",
        "rviz/imu.rviz",
        "rviz/joint_states.rviz",
        "rviz/rgbd_camera.rviz",
        "rviz/rgbd_camera_bridge.rviz",
        "rviz/robot_description_publisher.rviz",
        "rviz/tf_bridge.rviz",
        "rviz/vehicle.rviz",
        "worlds/default.sdf",
        "worlds/dvl.sdf",
        "worlds/vehicle.sdf",
    ] + ["//launch:launch_files"],
)

write_file(
    name = "env_hook",
    out = "ros_gz_sim_demos.dsv",
    content = ["prepend-non-duplicate;GZ_SIM_RESOURCE_PATH;share"],
)

register_ament_files(
    name = "ament_files_0",
    files = [":env_hook"],
    prefix = "environment",
    strip_prefix = "*",
)

ament_index(
    name = "ament_index",
    data = [
        ":ament_files_0",
        ":data",
    ] + ["//launch:launch_files"],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    data = [":data"],
    env_hooks = ["environment/ros_gz_sim_demos.dsv"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@gz_sim_vendor//:ament_package",
        "@image_transport_plugins//:ament_package",
        "@marine_acoustic_msgs//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@ros_gz_bridge//:ament_package",
        "@ros_gz_image//:ament_package",
        "@ros_gz_sim//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_image_view//:ament_package",
        "@rqt_plot//:ament_package",
        "@rqt_topic//:ament_package",
        "@rviz2//:ament_package",
        "@rviz_imu_plugin//:ament_package",
        "@sdformat_urdf//:ament_package",
        "@tf2_ros//:ament_package",
        "@xacro//:ament_package",
    ],
)
