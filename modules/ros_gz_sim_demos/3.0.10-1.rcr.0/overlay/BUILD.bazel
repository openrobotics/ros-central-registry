load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### DATA (launch files, bridge configs, models, worlds, rviz configs)

filegroup(
    name = "data",
    srcs = glob([
        "config/**",
        "launch/**",
        "models/**",
        "rviz/**",
        "worlds/**",
    ]),
)

# ament_environment_hooks(hooks/ros_gz_sim_demos.dsv.in): make the models in
# share/ discoverable by Gazebo.
write_file(
    name = "env_hook",
    out = "ros_gz_sim_demos.dsv",
    content = ["prepend-non-duplicate;GZ_SIM_RESOURCE_PATH;share"],
)

pkg_files(
    name = "install_env_hook",
    srcs = [":env_hook"],
    prefix = "share/ros_gz_sim_demos/environment",
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    data = [":data"],
    env_hooks = ["environment/ros_gz_sim_demos.dsv"],
    install = [":install_env_hook"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@gz_sim_vendor//:ament_package",
        "@image_transport_plugins//:ament_package",
        "@marine_acoustic_msgs//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@ros_gz_bridge//:ament_package",
        "@ros_gz_image//:ament_package",
        "@ros_gz_sim//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_image_view//:ament_package",
        "@rqt_plot//:ament_package",
        "@rqt_topic//:ament_package",
        "@rviz2//:ament_package",
        "@rviz_imu_plugin//:ament_package",
        "@sdformat_urdf//:ament_package",
        "@tf2_ros//:ament_package",
        "@xacro//:ament_package",
    ],
)
