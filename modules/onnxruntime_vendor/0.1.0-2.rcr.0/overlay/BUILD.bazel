                           \\\n  CreateTuple(OrtKernelContext* context, ArgPtrs& args, size_t num_input, size_t num_output, const std::string& ep) {                 \\\n    if (\"CPUExecutionProvider\" != ep) {                                                                                               \\\n      ORT_CXX_API_THROW(\"scalar input could only be applied to CPU EP\", OrtErrorCode::ORT_RUNTIME_EXCEPTION);                         \\\n    }                                                                                                                                 \\\n    args.push_back(std::make_unique<Custom::Tensor<data_type>>(context, ith_input, true));                                            \\\n    std::tuple<T> current = std::tuple<T>{reinterpret_cast<Custom::Tensor<data_type>*>(args.back().get())->AsScalar()};               \\\n    auto next = CreateTuple<ith_input + 1, ith_output, Ts...>(context, args, num_input, num_output, ep);                              \\\n    return std::tuple_cat(current, next);                                                                                             \\\n  }                                                                                                                                   \\\n  template <size_t ith_input, size_t ith_output, typename T, typename... Ts>                                                          \\\n  static typename std::enable_if<std::is_same<T, std::optional<data_type>>::value, std::tuple<T, Ts...>>::type                        \\\n  CreateTuple(OrtKernelContext* context, ArgPtrs& args, size_t num_input, size_t num_output, const std::string& ep) {                 \\\n    if (ith_input < num_input) {                                                                                                      \\\n      if (\"CPUExecutionProvider\" != ep) {                                                                                             \\\n        ORT_CXX_API_THROW(\"scalar input could only be applied to CPU EP\", OrtErrorCode::ORT_RUNTIME_EXCEPTION);                       \\\n      }                                                                                                                               \\\n      args.push_back(std::make_unique<Custom::Tensor<data_type>>(context, ith_input, true));                                          \\\n      std::tuple<T> current = std::tuple<T>{reinterpret_cast<Custom::Tensor<data_type>*>(args.back().get())->AsScalar()};             \\\n      auto next = CreateTuple<ith_input + 1, ith_output, Ts...>(context, args, num_input, num_output, ep);                            \\\n      return std::tuple_cat(current, next);                                                                                           \\\n    } else {                                                                                                                          \\\n      std::tuple<T> current = std::tuple<T>{};                                                                                        \\\n      auto next = CreateTuple<ith_input + 1, ith_output, Ts...>(context, args, num_input, num_output, ep);                            \\\n      return std::tuple_cat(current, next);                                                                                           \\\n    }                                                                                                                                 \\\n  }\n#define CREATE_TUPLE_OUTPUT(data_type)                                                                                          \\\n  template <size_t ith_input, size_t ith_output, typename T, typename... Ts>                                                    \\\n  static typename std::enable_if<std::is_same<T, Custom::Tensor<data_type>*>::value, std::tuple<T, Ts...>>::type                \\\n  CreateTuple(OrtKernelContext* context, ArgPtrs& args, size_t num_input, size_t num_output, const std::string