load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

register_ament_files(
    name = "ament_files_0",
    files = [
        "env-hooks/onnxruntime_vendor.dsv",
    ],
    prefix = "environment",
    strip_prefix = "*",
)

ament_index(
    name = "ament_index",
    data = [
        ":ament_files_0",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_vendor_package//:ament_package",
    ],
)

ament_package(
    cmake = [
        "onnxruntime_vendor-extras.cmake",
    ],
    cmake_extras = ["onnxruntime_vendor-extras.cmake"],
    cmake_strip_prefix = "",
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_vendor_package//:ament_package",
    ],
)
