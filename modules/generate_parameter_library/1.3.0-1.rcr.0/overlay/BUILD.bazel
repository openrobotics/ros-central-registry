load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load(":defs.bzl", "generate_parameter_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

cc_library(
    name = "generate_parameter_library",
    deps = [
        "@rclcpp//:rclcpp_library",
        "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
        "@rosdistro//cc:fmt",
        "@rosdistro//cc:tl_expected",
        "@rsl//:rsl_library",
        "@tcb_span",
    ],
)

# Upstream's CMake config re-exports rsl::rsl (ament_export_dependencies), so
# downstream packages' generated DEPENDENCIES name it via this package.
alias(
    name = "rsl",
    actual = "@rsl//:rsl",
)

alias(
    name = "rsl_library",
    actual = "@rsl//:rsl_library",
)

alias(
    name = "rclcpp_lifecycle",
    actual = "@rclcpp_lifecycle//:rclcpp_lifecycle",
)

alias(
    name = "rclcpp_lifecycle_library",
    actual = "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
)

generate_parameter_library(
    name = "test_parameters",
    yaml_file = "//test:test_parameters.yaml",
)

filegroup(
    name = "ament_index",
    srcs = [
        "cmake/generate_parameter_library.cmake",
        "generate_parameter_library-extras.cmake",
    ],
)

ament_package(
    name = "ament_package",
    cmake = [
        "cmake/generate_parameter_library.cmake",
        "generate_parameter_library-extras.cmake",
    ],
    cmake_export_dependencies = False,
    cmake_extras = ["generate_parameter_library-extras.cmake"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@generate_parameter_library_py//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rsl//:ament_package",
        "@tcb_span//:ament_package",
    ],
)
