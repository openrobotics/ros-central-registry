filegroup(
    name = "launch_files",
    srcs = LAUNCH_MODULES,
)

launch_ros_binary(
    name = "bringup_launch",
    src = "bringup_launch.py",
    data = [
        "//:ament_index",
    ],
    deps = [
        ":keepout_zone_launch",
        ":localization_launch",
