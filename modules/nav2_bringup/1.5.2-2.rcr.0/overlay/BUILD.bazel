load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

# Upstream installs the launch/ directory as the `nav2_bringup` Python package
# (`ament_python_install_package(nav2_bringup PACKAGE_DIR launch)`), so that
# e.g. bringup_launch.py can `from nav2_bringup.slam_launch import ...`.
# Mirror that layout by copying the sources under a `nav2_bringup/` module
# directory and exposing them as a py_library.
LAUNCH_MODULES = [
    "__init__.py",
    "bringup_launch.py",
    "cloned_multi_tb3_simulation_launch.py",
    "keepout_zone_launch.py",
    "localization_launch.py",
    "navigation_launch.py",
    "rviz_launch.py",
    "slam_launch.py",
    "speed_zone_launch.py",
    "tb3_loopback_simulation_launch.py",
    "tb3_simulation_launch.py",
    "tb4_loopback_simulation_launch.py",
    "tb4_simulation_launch.py",
    "unique_multi_tb3_simulation_launch.py",
]

[
    copy_file(
        name = "_nav2_bringup_py_" + f.removesuffix(".py"),
        src = "//launch:" + f,
        out = "_gen/py/nav2_bringup/" + f,
    )
    for f in LAUNCH_MODULES
]

py_library(
    name = "nav2_bringup",
    srcs = ["_gen/py/nav2_bringup/" + f for f in LAUNCH_MODULES],
    imports = ["_gen/py"],
    deps = [
        requirement("pyyaml"),
        "@launch",
        "@launch_ros",
        "@nav2_common",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "graphs/depot_graph.geojson",
        "graphs/turtlebot3_graph.geojson",
        "graphs/warehouse_graph.geojson",
        "maps/depot.pgm",
        "maps/depot.yaml",
        "maps/depot_keepout.pgm",
        "maps/depot_keepout.yaml",
        "maps/depot_speed.pgm",
        "maps/depot_speed.yaml",
        "maps/tb3_sandbox.pgm",
        "maps/tb3_sandbox.yaml",
        "maps/warehouse.pgm",
        "maps/warehouse.yaml",
        "maps/warehouse_keepout.pgm",
        "maps/warehouse_keepout.yaml",
        "maps/warehouse_speed.pgm",
        "maps/warehouse_speed.yaml",
        "params/nav2_params.yaml",
        "rviz/nav2_default_view.rviz",
        "//launch:launch_files",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ament_mypy//:ament_package",
        "@backward_ros//:ament_package",
        "@diff_drive_controller//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@nav2_common//:ament_package",
        "@nav2_loopback_sim//:ament_package",
        "@nav2_minimal_tb3_sim//:ament_package",
        "@nav2_minimal_tb4_sim//:ament_package",
        "@navigation2//:ament_package",
        "@ros_gz_bridge//:ament_package",
        "@ros_gz_sim//:ament_package",
        "@slam_toolbox//:ament_package",
        "@xacro//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    python = [":nav2_bringup"],
    python_strip_prefix = "_gen/py",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ament_mypy//:ament_package",
        "@backward_ros//:ament_package",
        "@diff_drive_controller//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@nav2_common//:ament_package",
        "@nav2_loopback_sim//:ament_package",
        "@nav2_minimal_tb3_sim//:ament_package",
        "@nav2_minimal_tb4_sim//:ament_package",
        "@navigation2//:ament_package",
        "@ros_gz_bridge//:ament_package",
        "@ros_gz_sim//:ament_package",
        "@slam_toolbox//:ament_package",
        "@xacro//:ament_package",
    ],
)
