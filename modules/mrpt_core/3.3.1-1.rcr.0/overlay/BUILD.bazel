load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
]

cc_library(
    name = "mrpt_core_library",
    srcs = [
        "src/Clock.cpp",
        "src/WorkerThreadsPool.cpp",
        "src/aligned_malloc.cpp",
        "src/backtrace.cpp",
        "src/cpu.cpp",
        "src/demangle.cpp",
        "src/exceptions.cpp",
        "src/format.cpp",
        "src/get_env.cpp",
        "src/reverse_bytes.cpp",
        "src/winerror2str.cpp",
    ],
    hdrs = [
        "include/mrpt/3rdparty/spimpl.h",
        "include/mrpt/core/Clock.h",
        "include/mrpt/core/SSE_macros.h",
        "include/mrpt/core/SSE_types.h",
        "include/mrpt/core/StackAlloc.h",
        "include/mrpt/core/Stringifyable.h",
        "include/mrpt/core/WorkerThreadsPool.h",
        "include/mrpt/core/abs_diff.h",
        "include/mrpt/core/aligned_allocator.h",
        "include/mrpt/core/aligned_std_basicstring.h",
        "include/mrpt/core/aligned_std_vector.h",
        "include/mrpt/core/alignment_req.h",
        "include/mrpt/core/backtrace.h",
        "include/mrpt/core/bit_cast.h",
        "include/mrpt/core/bits_math.h",
        "include/mrpt/core/bits_mem.h",
        "include/mrpt/core/byte_manip.h",
        "include/mrpt/core/common.h",
        "include/mrpt/core/constexpr_for.h",
        "include/mrpt/core/cpu.h",
        "include/mrpt/core/demangle.h",
        "include/mrpt/core/exceptions.h",
        "include/mrpt/core/format.h",
        "include/mrpt/core/from_string.h",
        "include/mrpt/core/get_env.h",
        "include/mrpt/core/initializer.h",
        "include/mrpt/core/integer_select.h",
        "include/mrpt/core/is_defined.h",
        "include/mrpt/core/is_shared_ptr.h",
        "include/mrpt/core/lock_helper.h",
        "include/mrpt/core/optional_ref.h",
        "include/mrpt/core/pimpl.h",
        "include/mrpt/core/reverse_bytes.h",
        "include/mrpt/core/round.h",
        "include/mrpt/core/safe_pointers.h",
        "include/mrpt/core/winerror2str.h",
        "include/mrpt/registerAllClasses.h",
    ] + [
        ":config_h",
        ":version_h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "MRPT_EXCEPTIONS_CALL_STACK_MAX_DEPTH=50U",
        "MRPT_EXCEPTIONS_WITH_CALL_STACK",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_core",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mrpt_core_library"],
)

cc_library(
    name = "_bindings_library",
    srcs = ["python_bindings/mrpt_core_py.cpp"],
    hdrs = [
        "include/mrpt/3rdparty/spimpl.h",
        "include/mrpt/core/Clock.h",
        "include/mrpt/core/SSE_macros.h",
        "include/mrpt/core/SSE_types.h",
        "include/mrpt/core/StackAlloc.h",
        "include/mrpt/core/Stringifyable.h",
        "include/mrpt/core/WorkerThreadsPool.h",
        "include/mrpt/core/abs_diff.h",
        "include/mrpt/core/aligned_allocator.h",
        "include/mrpt/core/aligned_std_basicstring.h",
        "include/mrpt/core/aligned_std_vector.h",
        "include/mrpt/core/alignment_req.h",
        "include/mrpt/core/backtrace.h",
        "include/mrpt/core/bit_cast.h",
        "include/mrpt/core/bits_math.h",
        "include/mrpt/core/bits_mem.h",
        "include/mrpt/core/byte_manip.h",
        "include/mrpt/core/common.h",
        "include/mrpt/core/constexpr_for.h",
        "include/mrpt/core/cpu.h",
        "include/mrpt/core/demangle.h",
        "include/mrpt/core/exceptions.h",
        "include/mrpt/core/format.h",
        "include/mrpt/core/from_string.h",
        "include/mrpt/core/get_env.h",
        "include/mrpt/core/initializer.h",
        "include/mrpt/core/integer_select.h",
        "include/mrpt/core/is_defined.h",
        "include/mrpt/core/is_shared_ptr.h",
        "include/mrpt/core/lock_helper.h",
        "include/mrpt/core/optional_ref.h",
        "include/mrpt/core/pimpl.h",
        "include/mrpt/core/reverse_bytes.h",
        "include/mrpt/core/round.h",
        "include/mrpt/core/safe_pointers.h",
        "include/mrpt/core/winerror2str.h",
        "include/mrpt/registerAllClasses.h",
    ] + [
        ":config_h",
        ":version_h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":mrpt_core_library"],
)

cc_shared_library(
    name = "_bindings",
    dynamic_deps = DEPENDENCIES.keys() + [":mrpt_core"],
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "mrpt/core/_bindings.so",
    deps = [":_bindings_library"],
)

py_library(
    name = "mrpt",
    srcs = ["python/mrpt/core/__init__.py"],
    imports = ["python"],
)

cmake_configure_file(
    name = "config_h",
    src = "config.h.in",
    out = "_gen/include/mrpt/core/config.h",
    defines = [
        "CMAKE_MRPT_BUILD_SHARED_LIB=#define MRPT_BUILT_AS_DLL",
        "CMAKE_MRPT_HAS_TBB=1",
        "EIGEN_MAX_ALIGN_BYTES=32",
        "EIGEN_MAX_STATIC_ALIGN_BYTES=32",
        "CMAKE_MRPT_WORD_SIZE=64",
        "CMAKE_MRPT_HAS_SSE4_A=0",
        "CMAKE_MRPT_HAS_NEON=0",
        "CMAKE_MRPT_IS_BIG_ENDIAN=0",
        "CMAKE_MRPT_IN_EMSCRIPTEN=0",
        "HAVE_SYS_TIME_H=1",
        "HAVE_PTHREAD_H=1",
        "HAVE_UNISTD_H=1",
        "HAVE_TIMEGM=1",
        "HAVE_STRTOK_R=1",
        "HAVE_LOCALTIME_R=1",
        "HAVE_LONG_DOUBLE=1",
        "CMAKE_MRPT_HAS_BFD=0",
    ] + select({
        "@platforms//cpu:x86_64": [
            "MRPT_ARCH_INTEL_COMPATIBLE=1",
            "CMAKE_MRPT_HAS_SSE2=1",
            "CMAKE_MRPT_HAS_SSE3=1",
            "CMAKE_MRPT_HAS_SSE4_1=1",
            "CMAKE_MRPT_HAS_SSE4_2=1",
            "CMAKE_MRPT_HAS_AVX=1",
            "CMAKE_MRPT_HAS_AVX2=1",
        ],
        "//conditions:default": [
            "MRPT_ARCH_INTEL_COMPATIBLE=0",
            "CMAKE_MRPT_HAS_SSE2=0",
            "CMAKE_MRPT_HAS_SSE3=0",
            "CMAKE_MRPT_HAS_SSE4_1=0",
            "CMAKE_MRPT_HAS_SSE4_2=0",
            "CMAKE_MRPT_HAS_AVX=0",
            "CMAKE_MRPT_HAS_AVX2=0",
        ],
    }) + select({
        "@platforms//os:linux": [
            "HAVE_LINUX_SERIAL_H=1",
            "HAVE_LINUX_INPUT_H=1",
            "HAVE_MALLOC_H=1",
            "HAVE_GETTID=1",
            "HAVE_SINCOS=1",
        ],
        "//conditions:default": [],
    }),
    undefines = [
        "HAVE_WINSOCK2_H",
        "HAVE_MALLOC_MALLOC_H",
        "HAVE_MKGMTIME",
        "HAVE_LRINT",
        "HAVE_ALIGNED_MALLOC",
        "HAVE_DECL_BFD_SECTION_FLAGS",
        "HAVE_DECL_BFD_GET_SECTION_FLAGS",
        "HAVE_DECL_BFD_GET_SECTION_VMA",
        "HAVE_DECL_BFD_SECTION_VMA",
        "HAVE_1_ARG_BFD_SECTION_SIZE",
    ] + select({
        "@platforms//os:linux": [],
        "//conditions:default": [
            "HAVE_LINUX_SERIAL_H",
            "HAVE_LINUX_INPUT_H",
            "HAVE_MALLOC_H",
            "HAVE_GETTID",
            "HAVE_SINCOS",
        ],
    }),
)

expand_template(
    name = "version_h",
    out = "_gen/include/mrpt/version.h",
    substitutions = {
        "${CMAKE_INSTALL_PREFIX}": ".",
        "${CMAKE_MRPT_COMPLETE_NAME}": "MRPT 3.3.1",
        "${CMAKE_MRPT_VERSION_CODE}": "0x30301",
        "${CMAKE_SOURCE_DATE_EPOCH}": "1790705864",
        "${mrpt_core_SOURCE_DIR}": ".",
    },
    template = "version.h.in",
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_core",
