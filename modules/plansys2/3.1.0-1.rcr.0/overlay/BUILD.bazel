load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@plansys2_bringup//:ament_package",
        "@plansys2_bt_actions//:ament_package",
        "@plansys2_core//:ament_package",
        "@plansys2_domain_expert//:ament_package",
        "@plansys2_executor//:ament_package",
        "@plansys2_lifecycle_manager//:ament_package",
        "@plansys2_msgs//:ament_package",
        "@plansys2_pddl_parser//:ament_package",
        "@plansys2_planner//:ament_package",
        "@plansys2_popf_plan_solver//:ament_package",
        "@plansys2_problem_expert//:ament_package",
        "@plansys2_support_py//:ament_package",
        "@plansys2_terminal//:ament_package",
        "@plansys2_tools//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@plansys2_bringup//:ament_package",
        "@plansys2_bt_actions//:ament_package",
        "@plansys2_core//:ament_package",
        "@plansys2_domain_expert//:ament_package",
        "@plansys2_executor//:ament_package",
        "@plansys2_lifecycle_manager//:ament_package",
        "@plansys2_msgs//:ament_package",
        "@plansys2_pddl_parser//:ament_package",
        "@plansys2_planner//:ament_package",
        "@plansys2_popf_plan_solver//:ament_package",
        "@plansys2_problem_expert//:ament_package",
        "@plansys2_support_py//:ament_package",
        "@plansys2_terminal//:ament_package",
        "@plansys2_tools//:ament_package",
    ],
)
