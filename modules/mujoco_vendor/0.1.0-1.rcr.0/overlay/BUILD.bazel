>\n\n    <body mocap=\"true\" pos=\"-.1 .05 0\" zaxis=\".5 0 1\">\n      <geom type=\"capsule\" size=\".1 .1\" material=\"matmarble\" group=\"1\" condim=\"1\"/>\n    </body>\n  </worldbody>\n</mujoco>\n"],
