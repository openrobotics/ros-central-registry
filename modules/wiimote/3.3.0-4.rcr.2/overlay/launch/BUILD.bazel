load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "feedback_test.launch.py",
        "turtlesim.launch.py",
        "wiimote_lifecycle.launch.py",
    ],
)

launch_ros_binary(
    name = "feedback_test_launch",
    src = "feedback_test.launch.py",
    data = [
        "//:ament_index",
        "//:wiimote_node",
        "@rclcpp_components//:ament_index",
    ],
    deps = ["@lifecycle_msgs//:py"],
)

launch_ros_binary(
    name = "turtlesim_launch",
    src = "turtlesim.launch.py",
    data = [
        "//:ament_index",
        "//:teleop_wiimote_node",
        "//:wiimote_node",
        "@rclcpp_components//:ament_index",
        "@turtlesim//:ament_index",
        "@turtlesim//:turtlesim_node",
    ],
    deps = ["@lifecycle_msgs//:py"],
)

launch_ros_binary(
    name = "wiimote_lifecycle_launch",
    src = "wiimote_lifecycle.launch.py",
    data = [
        "//:ament_index",
        "//:wiimote_node",
        "@rclcpp_components//:ament_index",
    ],
    deps = ["@lifecycle_msgs//:py"],
)
