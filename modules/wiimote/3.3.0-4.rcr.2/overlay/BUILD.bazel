load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
    "@std_srvs//:cc",
    "@wiimote_msgs//:cc",
]

cc_library(
    name = "teleop_wiimote_library",
    srcs = ["src/teleop_wiimote.cpp"],
    hdrs = [
        "include/wiimote/stat_vector_3d.hpp",
        "include/wiimote/teleop_wiimote.hpp",
        "include/wiimote/wiimote_controller.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/wiimote",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "teleop_wiimote",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":teleop_wiimote_library"],
)

cc_library(
    name = "wiimote_lib_library",
    srcs = [
        "src/stat_vector_3d.cpp",
        "src/wiimote_controller.cpp",
    ],
    hdrs = [
        "include/wiimote/stat_vector_3d.hpp",
        "include/wiimote/teleop_wiimote.hpp",
        "include/wiimote/wiimote_controller.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/wiimote",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "wiimote_lib",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":wiimote_lib_library"],
)

rclcpp_components_register_node(
    name = "teleop_wiimote_node",
    component = ":wiimote_lib",
    node_name = "teleop_wiimote_node",
    plugin = "WiimoteNode",
)

rclcpp_components_register_node(
    name = "wiimote_node",
    component = ":wiimote_lib",
    node_name = "wiimote_node",
    plugin = "WiimoteNode",
)

rclcpp_components_register_nodes(
    name = "teleop_wiimote_components",
    component = ":teleop_wiimote",
    plugins = ["TeleopWiimote"],
)

ament_index(
    name = "ament_index",
    components = [
        ":teleop_wiimote_node_record",
        ":wiimote_node_record",
        ":teleop_wiimote_components",
    ],
    data = [
        "config/teleop_wiimote_params.yaml",
        "config/wiimote_params.yaml",
        "//launch:launch_files",
    ],
    lib_data = [
        ":teleop_wiimote_node",
        ":wiimote_node",
        "nodes/feedback_tester.py",
    ],
    libraries = [
        ":teleop_wiimote",
        ":wiimote_lib",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@wiimote_msgs//:ament_package",
    ],
)

ament_package(
    cmake = ["wiimote-extras.cmake"],
    cmake_export_dependencies_list = [
        "rclcpp",
        "sensor_msgs",
        "std_msgs",
        "std_srvs",
        "wiimote",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_wiimote",
    cmake_extras = ["wiimote-extras.cmake"],
    cmake_strip_prefix = "",
    headers = [
        "include/wiimote/stat_vector_3d.hpp",
        "include/wiimote/teleop_wiimote.hpp",
        "include/wiimote/wiimote_controller.hpp",
    ],
    include_prefix = "",
    libraries = [
        ":teleop_wiimote",
        ":wiimote_lib",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@wiimote_msgs//:ament_package",
    ],
)
