load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

py_library(
    name = "rosapi",
    srcs = glob(["src/rosapi/**/*.py"]),
    imports = ["src"],
    deps = [
        "@builtin_interfaces//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@ros2action",
        "@ros2interface",
        "@ros2node",
        "@ros2service",
        "@ros2topic",
        "@rosapi_msgs//:py",
        "@rosbridge_library",
        "@rosidl_adapter",
        "@rosidl_runtime_py",
    ],
)

ament_index(
    name = "ament_index_test",
    testonly = True,
    package_xml = "package.xml",
    deps = [
        "@geometry_msgs//:ament_index",
        "@rosapi_msgs//:ament_index",
        "@sensor_msgs//:ament_index",
        "@shape_msgs//:ament_index",
    ],
)

# test_stringify_field_types.py queries std_msgs interfaces via ament_index,
# which rosapi's package.xml does not declare directly.
py_pytest(
    name = "rosapi_test_stringify_field_types",
    srcs = ["test/test_stringify_field_types.py"],
    data = [":ament_index_test"],
    tags = ["manual"],
    deps = [
        ":rosapi",
        "@geometry_msgs//:py",
        "@sensor_msgs//:py",
        "@shape_msgs//:py",
    ],
)

py_pytest(
    name = "rosapi_test_typedefs",
    srcs = ["test/test_typedefs.py"],
    data = [":ament_index_test"],
    deps = [
        ":rosapi",
        "@geometry_msgs//:py",
        "@sensor_msgs//:py",
        "@shape_msgs//:py",
    ],
)

ament_package(
    name = "ament_package",
    data = ["mapping_rules.yaml"],
    executables = ["scripts/rosapi_node"],
    package_xml = "package.xml",
    python = [":rosapi"],
    python_strip_prefix = "src",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_mypy//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rmw_dds_common//:ament_package",
        "@ros2action//:ament_package",
        "@ros2interface//:ament_package",
        "@ros2node//:ament_package",
        "@ros2service//:ament_package",
        "@ros2topic//:ament_package",
        "@rosapi_msgs//:ament_package",
        "@rosbridge_library//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_adapter//:ament_package",
        "@rosidl_runtime_py//:ament_package",
        "@sensor_msgs//:ament_package",
        "@shape_msgs//:ament_package",
    ],
)
