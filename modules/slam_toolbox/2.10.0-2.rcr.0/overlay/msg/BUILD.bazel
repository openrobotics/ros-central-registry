load("@rosidl_default_generators//:defs.bzl", "ros_message")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.msg"]))

ros_message(
    name = "GraphEdge",
    src = "GraphEdge.msg",
    deps = [
        "@geometry_msgs//msg:Pose",
    ],
)

ros_message(
    name = "GraphNode",
    src = "GraphNode.msg",
    deps = [
        "@geometry_msgs//msg:Pose",
    ],
)

ros_message(
    name = "LocalizedLaserScan",
    src = "LocalizedLaserScan.msg",
    deps = [
        "@geometry_msgs//msg:PoseWithCovarianceStamped",
        "@geometry_msgs//msg:TransformStamped",
        "@sensor_msgs//msg:LaserScan",
    ],
)

ros_message(
    name = "LoopClosureEvent",
    src = "LoopClosureEvent.msg",
    deps = [
        "@builtin_interfaces//msg:Time",
    ],
)

ros_message(
    name = "NewNodeEvent",
    src = "NewNodeEvent.msg",
    deps = [
        ":GraphEdge",
        "@builtin_interfaces//msg:Time",
        "@geometry_msgs//msg:Pose",
    ],
)

ros_message(
    name = "PoseGraph",
    src = "PoseGraph.msg",
    deps = [
        ":GraphEdge",
        ":GraphNode",
        "@std_msgs//msg:Header",
    ],
)
