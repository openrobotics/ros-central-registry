load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "lifelong_launch.py",
        "localization_launch.py",
        "merge_maps_kinematic_launch.py",
        "offline_launch.py",
        "online_async_decentralized_multirobot_launch.py",
        "online_async_launch.py",
        "online_sync_launch.py",
    ],
)

launch_ros_binary(
    name = "lifelong_launch",
    src = "lifelong_launch.py",
    data = [
        "//:ament_index",
        "//:ament_index_extra",
        "//:lifelong_slam_toolbox_node",
    ],
    deps = [
        "@ament_index_python",
        "@lifecycle_msgs//:py",
    ],
)

launch_ros_binary(
    name = "localization_launch",
    src = "localization_launch.py",
    data = [
        "//:ament_index",
        "//:ament_index_extra",
        "//:localization_slam_toolbox_node",
    ],
    deps = [
        "@ament_index_python",
        "@lifecycle_msgs//:py",
    ],
)

launch_ros_binary(
    name = "merge_maps_kinematic_launch",
    src = "merge_maps_kinematic_launch.py",
    data = [
        "//:ament_index",
        "//:ament_index_extra",
        "//:merge_maps_kinematic",
    ],
)

launch_ros_binary(
    name = "offline_launch",
