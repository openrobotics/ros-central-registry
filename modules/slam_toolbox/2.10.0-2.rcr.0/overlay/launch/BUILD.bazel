        "@ament_index_python",
        "@lifecycle_msgs//:py",
    ],
)

launch_ros_binary(
    name = "online_async_decentralized_multirobot_launch",
    src = "online_async_decentralized_multirobot_launch.py",
    data = [
        "//:ament_index",
        "//:ament_index_extra",
        "//:decentralized_multirobot_slam_toolbox_node",
    ],
    deps = [
        "@ament_index_python",
        "@lifecycle_msgs//:py",
    ],
