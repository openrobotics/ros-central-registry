load("@rosidl_default_generators//:defs.bzl", "ros_service")

package(default_visibility = ["//visibility:public"])

exports_files([
    "AddSubmap.srv",
    "Clear.srv",
    "ClearQueue.srv",
    "DeserializePoseGraph.srv",
    "LoopClosure.srv",
    "MergeMaps.srv",
    "Pause.srv",
    "Reset.srv",
    "SaveMap.srv",
    "SerializePoseGraph.srv",
    "ToggleInteractive.srv",
])

ros_service(
    name = "AddSubmap",
    src = "AddSubmap.srv",
)

ros_service(
    name = "Clear",
    src = "Clear.srv",
)

ros_service(
    name = "ClearQueue",
    src = "ClearQueue.srv",
)

ros_service(
    name = "DeserializePoseGraph",
    src = "DeserializePoseGraph.srv",
    deps = [
        "@geometry_msgs//msg:Pose",
    ],
)

ros_service(
    name = "LoopClosure",
    src = "LoopClosure.srv",
)

ros_service(
    name = "MergeMaps",
    src = "MergeMaps.srv",
)

ros_service(
    name = "Pause",
    src = "Pause.srv",
)

ros_service(
    name = "Reset",
    src = "Reset.srv",
)

ros_service(
    name = "SaveMap",
    src = "SaveMap.srv",
    deps = [
        "@std_msgs//msg:String",
    ],
)

ros_service(
    name = "SerializePoseGraph",
    src = "SerializePoseGraph.srv",
)

ros_service(
    name = "ToggleInteractive",
    src = "ToggleInteractive.srv",
)
