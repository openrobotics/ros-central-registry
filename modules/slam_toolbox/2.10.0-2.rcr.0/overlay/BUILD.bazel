  bool update_state_every_iteration{false};\n    bool IsValid(std::string * error = nullptr) const { if (error) error->clear(); return true; }\n  };\n  struct Summary {\n    double initial_cost{0.0};\n    double final_cost{0.0};\n    bool IsSolutionUsable() const { return true; }\n    std::string FullReport() const { return \"Ceres Summary\"; }\n    std::string BriefReport() const { return \"Ceres Summary\"; }\n  };\n};\ninline void Solve(const Solver::Options &, Problem * problem, Solver::Summary * summary) {\n  if (problem && summary) {\n    summary->initial_cost = problem->totalCost();\n    summary->final_cost = summary->initial_cost;\n  }\n}\n}  // namespace ceres\n#endif\n"],
