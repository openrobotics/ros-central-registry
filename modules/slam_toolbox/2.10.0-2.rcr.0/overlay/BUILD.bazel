load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosidl_default_generators//:defs.bzl", "default_generators")

package(default_visibility = ["//visibility:public"])

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:GraphEdge",
        "//msg:GraphNode",
        "//msg:LocalizedLaserScan",
        "//msg:LoopClosureEvent",
        "//msg:NewNodeEvent",
        "//msg:PoseGraph",
        "//srv:AddSubmap",
        "//srv:Clear",
        "//srv:ClearQueue",
        "//srv:DeserializePoseGraph",
        "//srv:LoopClosure",
        "//srv:MergeMaps",
        "//srv:Pause",
        "//srv:Reset",
        "//srv:SaveMap",
        "//srv:SerializePoseGraph",
        "//srv:ToggleInteractive",
    ],
)

