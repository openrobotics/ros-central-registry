load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### ENTRYPOINTS

py_binary(
    name = "setup",
    srcs = ["setup.py"],
    visibility = ["//visibility:private"],
    deps = [
        requirement("setuptools"),
    ],
)

genrule(
    name = "entry_points",
    srcs = [
        "CHANGELOG.rst",
        "ament_pep257/__init__.py",
        "ament_pep257/main.py",
        "ament_pep257/py.typed",
        "ament_pep257/pytest_marker.py",
        "doc/index.rst",
        "package.xml",
        "pytest.ini",
        "resource/ament_pep257",
        "setup.py",
        "test/test_flake8.py",
        "test/test_generate_pep257_report.py",
    ],
    outs = [
        "ament_pep257.egg-info/PKG-INFO",
        "ament_pep257.egg-info/entry_points.txt",
        "ament_pep257.egg-info/top_level.txt",
    ],
    cmd = "$(location :setup) egg_info --egg-base=. && mkdir -p $(@D)/ament_pep257.egg-info && cp -r ament_pep257.egg-info/* $(@D)/ament_pep257.egg-info/",
    tools = [":setup"],
    visibility = ["//visibility:private"],
)

### PYTHON MODULES

py_library(
    name = "ament_pep257",
    srcs = [
        "ament_pep257/__init__.py",
        "ament_pep257/main.py",
        "ament_pep257/pytest_marker.py",
    ],
    data = ["ament_pep257/py.typed"] + [":entry_points"],
    imports = ["."],
    deps = [
        "@ament_lint",
        requirement("pydocstyle"),
    ],
)

### PYTHON EXECUTABLES

py_console_script_binary(
    name = "cli",
    entry_points_txt = ":entry_points",
    pkg = ":ament_pep257",
    script = "ament_pep257",
)

### TESTS

py_pytest(
    name = "test_flake8",
    srcs = ["test/test_flake8.py"],
    data = [
        "CHANGELOG.rst",
        "ament_pep257/__init__.py",
        "ament_pep257/main.py",
        "ament_pep257/py.typed",
        "ament_pep257/pytest_marker.py",
        "doc/index.rst",
        "package.xml",
        "pytest.ini",
        "resource/ament_pep257",
        "setup.py",
        "test/test_flake8.py",
        "test/test_generate_pep257_report.py",
    ],
    deps = ["@ament_flake8"],
)

py_pytest(
    name = "test_generate_pep257_report",
    srcs = ["test/test_generate_pep257_report.py"],
    data = [
        "CHANGELOG.rst",
        "ament_pep257/__init__.py",
        "ament_pep257/main.py",
        "ament_pep257/py.typed",
        "ament_pep257/pytest_marker.py",
        "doc/index.rst",
        "package.xml",
        "pytest.ini",
        "resource/ament_pep257",
        "setup.py",
        "test/test_flake8.py",
        "test/test_generate_pep257_report.py",
    ],
    deps = [":ament_pep257"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_programs = {"ament_pep257": "ament_pep257.main:main_with_catch"},
    package_xml = "package.xml",
    python = [":ament_pep257"] + ["ament_pep257/py.typed"],
    deps = [
        "@ament_flake8//:ament_package",
        "@ament_lint//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
