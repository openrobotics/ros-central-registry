load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

py_library(
    name = "crazyflie_sim",
    srcs = glob(["crazyflie_sim/**/*.py"]),
    data = glob(
        [
            "crazyflie_sim/backend/data/**",
            "crazyflie_sim/visualization/**",
        ],
        exclude = ["**/*.py"],
    ),
    imports = ["."],
    deps = [
        "@crazyflie_interfaces//:py",
        "@rclpy",
    ],
)

pkg_files(
    name = "py_data_files",
    srcs = glob(
        [
            "crazyflie_sim/backend/data/**",
            "crazyflie_sim/visualization/**",
        ],
        exclude = ["**/*.py"],
    ),
    prefix = "lib/python3.12/site-packages",
    strip_prefix = strip_prefix.from_pkg(""),
)

ament_package(
    name = "ament_package",
    build_type = "ament_cmake",
    cmake_export_dependencies = False,
    console_scripts = {
        "crazyflie_server": "crazyflie_sim.crazyflie_server:main",
    },
    install = [":py_data_files"],
    package_xml = "package.xml",
    python = [":crazyflie_sim"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@crazyflie_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
