load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = [
    "include/urg_node/urg_c_wrapper.hpp",
    "include/urg_node/urg_node.hpp",
]

DEPENDENCIES = {
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@laser_proc//:laser_proc": "@laser_proc//:laser_proc_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@std_srvs//:cc_shared": "@std_srvs//:cc",
    "@urg_c//:urg_c": "@urg_c//:urg_c_library",
    "@urg_node_msgs//:cc_shared": "@urg_node_msgs//:cc",
}

MSG_DEPENDENCIES = [
]

cc_library(
    name = "urg_node_library",
    srcs = [
        "src/urg_c_wrapper.cpp",
        "src/urg_node.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + MSG_DEPENDENCIES + ["@rosdistro//cc:boost.crc"],
)

cc_shared_library(
    name = "urg_node",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":urg_node_library"],
)

rclcpp_components_register_node(
    name = "urg_node_driver",
    component = ":urg_node",
    node_name = "urg_node_driver",
    plugin = "urg_node::UrgNode",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":urg_node"],
)

cc_binary(
    name = "getID",
    srcs = ["src/get_id.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + MSG_DEPENDENCIES + [":urg_node_library"],
)

DATA = [
    "meshes/hokuyo_ust10.stl",
    "urdf/hokuyo_ust10.urdf.xacro",
] + ["//launch:launch_files"]

EXECUTABLES = [
    ":getID",
    ":urg_node_driver",
    "scripts/set_urg_ip.py",
]

ament_index(
    name = "ament_index",
    components = [":urg_node_driver_record"],
    data = DATA,
    executables = EXECUTABLES,
    libraries = [":urg_node"],
    package_xml = "package.xml",
    deps = ["@urg_node_msgs//:ament_index"],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "diagnostic_updater",
        "laser_proc",
        "rclcpp",
        "sensor_msgs",
        "std_srvs",
        "urg_c",
        "urg_node_msgs",
    ],
    cmake_export_targets = False,
    headers = HEADERS,
    include_prefix = "",
    libraries = [":urg_node"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@laser_proc//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@urdf//:ament_package",
        "@urg_c//:ament_package",
        "@urg_node_msgs//:ament_package",
    ],
)
