+def _find_lib_controller():
+    webots_home = os.environ.get('WEBOTS_HOME', '')
+    lib_name = os.path.basename(path)
+    candidates = []
+    if webots_home:
+        candidates.extend([
+            os.path.join(webots_home, path),
+            os.path.join(webots_home, 'lib', lib_name),
+            os.path.join(webots_home, lib_name),
+        ])
+    pkg_root = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..', '..', '..'))
+    candidates.extend([
+        os.path.join(pkg_root, lib_name),
+        os.path.join(pkg_root, 'lib', lib_name),
+        os.path.join(pkg_root, path),
+    ])
+    for candidate in candidates:
+        if os.path.isfile(candidate):
+            return candidate
+    return candidates[0] if candidates else lib_name
+
+
+wb = ctypes.cdll.LoadLibrary(_find_lib_controller())
 
