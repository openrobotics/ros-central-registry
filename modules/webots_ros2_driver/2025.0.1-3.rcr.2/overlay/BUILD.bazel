        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@tinyxml2_vendor//:ament_package",
        "@vision_msgs//:ament_package",
        "@webots_ros2_importer//:ament_package",
        "@webots_ros2_msgs//:ament_package",
    ],
