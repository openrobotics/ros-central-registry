load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "collision_detector_node.launch.py",
        "collision_monitor_node.launch.py",
    ],
)

launch_ros_binary(
    name = "collision_detector_node_launch",
    src = "collision_detector_node.launch.py",
    data = [
        "//:ament_index",
        "//:collision_detector",
        "//:collision_detector_core",
        "@nav2_lifecycle_manager//:ament_index",
        "@nav2_lifecycle_manager//:lifecycle_manager",
        "@nav2_lifecycle_manager//:nav2_lifecycle_manager_core",
        "@rclcpp_components//:ament_index",
    ],
    deps = [
        "@ament_index_python",
        "@nav2_common",
    ],
)

launch_ros_binary(
    name = "collision_monitor_node_launch",
    src = "collision_monitor_node.launch.py",
    data = [
        "//:ament_index",
        "//:collision_monitor",
        "//:collision_monitor_core",
        "@nav2_lifecycle_manager//:ament_index",
        "@nav2_lifecycle_manager//:lifecycle_manager",
        "@nav2_lifecycle_manager//:nav2_lifecycle_manager_core",
        "@rclcpp_components//:ament_index",
    ],
    deps = [
        "@ament_index_python",
        "@nav2_common",
    ],
)
