cc_library(
    name = "collision_detector_core_library",
    srcs = [
        "src/circle.cpp",
        "src/collision_detector_node.cpp",
        "src/costmap.cpp",
        "src/exclusion_zone.cpp",
        "src/kinematics.cpp",
        "src/pointcloud.cpp",
        "src/polygon.cpp",
        "src/polygon_source.cpp",
        "src/range.cpp",
        "src/scan.cpp",
        "src/source.cpp",
        "src/velocity_polygon.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/nav2_collision_monitor",
        "test",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

