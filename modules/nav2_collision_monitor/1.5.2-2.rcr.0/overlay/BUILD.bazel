rclcpp_components_register_nodes(
    name = "collision_detector_core_components",
    component = ":collision_detector_core",
    plugins = ["nav2_collision_monitor::CollisionDetector"],
)

rclcpp_components_register_nodes(
    name = "collision_monitor_core_components",
    component = ":collision_monitor_core",
    plugins = ["nav2_collision_monitor::CollisionMonitor"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":collision_detector_core",
        ":collision_monitor_core",
    ],
)

cc_binary(
    name = "collision_detector",
    srcs = ["src/collision_detector_main.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/nav2_collision_monitor",
        "test",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":collision_detector_core_library"],
)

