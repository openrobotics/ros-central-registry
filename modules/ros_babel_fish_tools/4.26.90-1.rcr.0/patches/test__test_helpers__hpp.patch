-    if ( pipe2( out_pipe, O_CLOEXEC ) != 0 || pipe2( err_pipe, O_CLOEXEC ) != 0 ||
-         pipe2( in_pipe, O_CLOEXEC ) != 0 ) {
+    if ( make_cloexec_pipe( out_pipe ) != 0 || make_cloexec_pipe( err_pipe ) != 0 ||
