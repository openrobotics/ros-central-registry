cc_library(
    name = "ros_babel_fish_tools_library",
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        ".",
        "include",
        "include/ros_babel_fish_tools",
        "src",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

