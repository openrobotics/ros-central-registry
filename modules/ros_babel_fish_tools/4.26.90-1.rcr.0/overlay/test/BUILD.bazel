load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@ros_babel_fish//:ros_babel_fish": "@ros_babel_fish//:ros_babel_fish_library",
    "@rosdistro//cc:lz4": "@rosdistro//cc:lz4_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosdistro//cc:zstd": "@rosdistro//cc:zstd_library",
}

CC_DEPS = [
    "@builtin_interfaces//:cc",
    "@example_interfaces//:cc",
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@ros_babel_fish_test_msgs//:cc",
    "@rosdistro//cc:nlohmann_json",
    "@std_msgs//:cc",
]

cc_library(
    name = "test_helpers",
    testonly = True,
    hdrs = [
        "test_helpers.hpp",
    ],
    includes = ["."],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_compression",
    srcs = ["compression.cpp"],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["RCLCPP_VERSION_MAJOR=32"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":test_helpers",
        "//:ros_babel_fish_tools_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

