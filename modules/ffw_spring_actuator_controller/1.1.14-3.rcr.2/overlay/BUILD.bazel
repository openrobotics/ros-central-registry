load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

generate_parameter_library(
    name = "spring_actuator_controller_parameters",
    yaml_file = "src/spring_actuator_controller_parameters.yaml",
)

DEPENDENCIES = {
    "@controller_interface//:controller_interface": "@controller_interface//:controller_interface_library",
    "@generate_parameter_library//:rsl": "@generate_parameter_library//:rsl_library",
    "@hardware_interface//:hardware_interface": "@hardware_interface//:hardware_interface_library",
    "@hardware_interface//:mock_components": "@hardware_interface//:mock_components_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libcap": "@rosdistro//cc:libcap_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@urdf//:urdf": "@urdf//:urdf_library",
}

CC_DEPS = [
    ":spring_actuator_controller_parameters",
    "@generate_parameter_library//:generate_parameter_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
]

cc_library(
    name = "spring_actuator_controller_library",
    srcs = ["src/spring_actuator_controller.cpp"],
    hdrs = [
        "include/spring_actuator_controller/spring_actuator_controller.hpp",
        "include/spring_actuator_controller/visibility_control.h",
    ] + [":spring_actuator_controller_parameters_gen"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "_gen/include/ffw_spring_actuator_controller",
        "include",
    ],
    local_defines = ros_local_defines() + [
        "_FILE_OFFSET_BITS=64",
        "_USE_MATH_DEFINES",
        "spring_actuator_controller_BUILDING_DLL",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "spring_actuator_controller",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":spring_actuator_controller_library"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":spring_actuator_controller",
    ],
    package_xml = "package.xml",
    plugin_category = "controller_interface",
    plugins = ["spring_actuator_plugin.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@controller_interface//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@hardware_interface//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@urdf//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "fmt",
        "rclcpp",
        "rclcpp_lifecycle",
        "rsl",
        "tcb_span",
        "tl-expected",
        "controller_interface",
        "generate_parameter_library",
        "hardware_interface",
        "pluginlib",
        "rclcpp",
        "rclcpp_lifecycle",
        "realtime_tools",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_spring_actuator_controller",
    headers = [
        "include/spring_actuator_controller/spring_actuator_controller.hpp",
        "include/spring_actuator_controller/visibility_control.h",
    ],
    include_prefix = "spring_actuator_controller",
    libraries = [
        ":spring_actuator_controller",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@controller_interface//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@hardware_interface//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@urdf//:ament_package",
    ],
)
