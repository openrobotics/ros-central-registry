load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":tf2_py_bindings"],
)

cc_library(
    name = "tf2_py_bindings_library",
    srcs = ["src/tf2_py.cpp"],
    deps = DEPENDENCIES.values() + [
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_shared_library(
    name = "tf2_py_bindings",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "tf2_py/_tf2_py.so",
    user_link_flags = select({
        "@platforms//os:osx": [
            "-undefined",
            "dynamic_lookup",
        ],
        "//conditions:default": [],
    }),
    deps = [":tf2_py_bindings_library"],
)

py_library(
    name = "tf2_py",
    srcs = ["tf2_py/__init__.py"],
    data = [
        ":tf2_py_bindings",
        ":transitive_dynamic_deps",
    ],
    imports = ["."],
    deps = [
        "@builtin_interfaces//:py",
        "@geometry_msgs//:py",
        "@rclpy",
        "@rpyutils",
    ],
)

genrule(
    name = "create_test_tf2_py",
    srcs = [":tf2_py_bindings"],
    outs = [
        "test_tf2_py/__init__.py",
        "test_tf2_py/_tf2_py.so",
    ],
    cmd = "\n    mkdir -p $$(dirname $(location test_tf2_py/__init__.py))\n    touch $(location test_tf2_py/__init__.py)\n    cp $(location :tf2_py_bindings) $(location test_tf2_py/_tf2_py.so)\n    ",
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [
        ":tf2_py",
        ":tf2_py_bindings",
    ],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rpyutils//:ament_package",
        "@tf2//:ament_package",
    ],
)
