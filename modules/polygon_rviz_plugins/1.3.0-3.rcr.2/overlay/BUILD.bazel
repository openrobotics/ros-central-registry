load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@color_util//:color_util": "@color_util//:color_util_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@polygon_msgs//:cc_shared": "@polygon_msgs//:cc",
    "@polygon_utils//:polygon_utils": "@polygon_utils//:polygon_utils_library",
    "@rosdistro//cc:OgreMain": "@rosdistro//cc:OgreMain_library",
    "@rosdistro//cc:OgreOverlay": "@rosdistro//cc:OgreOverlay_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:curl": "@rosdistro//cc:curl_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rviz_common//:rviz_common": "@rviz_common//:rviz_common_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "polygon_rviz_plugins_library",
    srcs = [
        "src/complex_polygon_display.cpp",
        "src/complex_polygons_display.cpp",
        "src/polygon3d_display.cpp",
        "src/polygon_display.cpp",
        "src/polygon_parts.cpp",
        "src/polygons_display.cpp",
    ],
    hdrs = [
        "include/polygon_rviz_plugins/complex_polygon_display.hpp",
        "include/polygon_rviz_plugins/complex_polygons_display.hpp",
        "include/polygon_rviz_plugins/polygon3d_display.hpp",
        "include/polygon_rviz_plugins/polygon_base.hpp",
        "include/polygon_rviz_plugins/polygon_display.hpp",
        "include/polygon_rviz_plugins/polygon_parts.hpp",
        "include/polygon_rviz_plugins/polygons_display.hpp",
        "include/polygon_rviz_plugins/validate_floats.hpp",
    ],
    includes = [
        "include",
        "include/polygon_rviz_plugins",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "polygon_rviz_plugins",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":polygon_rviz_plugins_library"],
)

ament_index(
    name = "ament_index",
    data = [
        "icons/classes/ComplexPolygon.png",
        "icons/classes/ComplexPolygons.png",
        "icons/classes/Polygon2D.png",
        "icons/classes/Polygon3D.png",
        "icons/classes/Polygons.png",
    ],
    libraries = [":polygon_rviz_plugins"],
    package_xml = "package.xml",
    plugin_category = "rviz_common",
    plugins = ["rviz_common_plugins.xml"],
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@color_util//:ament_package",
        "@geometry_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@polygon_msgs//:ament_package",
        "@polygon_utils//:ament_package",
        "@rviz_common//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_polygon_rviz_plugins",
    headers = [
        "include/polygon_rviz_plugins/complex_polygon_display.hpp",
        "include/polygon_rviz_plugins/complex_polygons_display.hpp",
        "include/polygon_rviz_plugins/polygon3d_display.hpp",
        "include/polygon_rviz_plugins/polygon_base.hpp",
        "include/polygon_rviz_plugins/polygon_display.hpp",
        "include/polygon_rviz_plugins/polygon_parts.hpp",
        "include/polygon_rviz_plugins/polygons_display.hpp",
        "include/polygon_rviz_plugins/validate_floats.hpp",
    ],
    include_prefix = "",
    libraries = [":polygon_rviz_plugins"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@color_util//:ament_package",
        "@geometry_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@polygon_msgs//:ament_package",
        "@polygon_utils//:ament_package",
        "@rviz_common//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
