        "ffw_sg2_follower_ai.launch.py",
        "ffw_sg2_follower_ai_gazebo.launch.py",
    ],
)

launch_ros_binary(
    name = "camera_launch",
    src = "camera.launch.py",
    data = [
        ":camera_realsense_launch",
        ":camera_zed_launch",
        "//:ament_index",
        "@rclcpp_components//:ament_index",
        "@rclcpp_components//:component_container_isolated",
        "@realsense2_camera//:ament_index",
        "@robot_state_publisher",
        "@robot_state_publisher//:ament_index",
    ],
    deps = [
        "//:ffw_bringup",
        "@ament_index_python",
        requirement("pyyaml"),
    ],
)

