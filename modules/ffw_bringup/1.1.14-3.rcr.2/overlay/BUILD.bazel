load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "ffw_bringup",
    srcs = glob(["ffw_bringup/**/*.py"]),
    imports = ["."],
    deps = [
        "@rclpy",
        "@ros_gz_bridge//:ros_gz_bridge_py",
        requirement("numpy"),
        requirement("pyyaml"),
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "config/common/common_stereo.yaml",
        "config/common/rs_serial.yaml",
        "config/common/zedm.yaml",
        "config/ffw_bg2_rev2_follower/ffw_bg2_follower_ai_hardware_controller.yaml",
        "config/ffw_bg2_rev2_follower/ffw_bg2_follower_initial_positions.yaml",
        "config/ffw_bg2_rev3_follower/ffw_bg2_follower_ai_hardware_controller.yaml",
        "config/ffw_bg2_rev3_follower/ffw_bg2_follower_initial_positions.yaml",
        "config/ffw_bg2_rev4_follower/ffw_bg2_follower_ai_hardware_controller.yaml",
        "config/ffw_bg2_rev4_follower/ffw_bg2_follower_initial_positions.yaml",
        "config/ffw_lg2_leader/ffw_lg2_leader_ai_hardware_controller.yaml",
        "config/ffw_sg2_rev1_follower/ffw_sg2_follower_ai_hardware_controller.yaml",
        "config/ffw_sg2_rev1_follower/ffw_sg2_follower_initial_positions.yaml",
        "launch/camera.launch.py",
        "launch/camera_realsense.launch.py",
        "launch/camera_zed.launch.py",
        "launch/ffw_bg2_ai.launch.py",
        "launch/ffw_bg2_follower_ai.launch.py",
        "launch/ffw_bg2_follower_ai_gazebo.launch.py",
        "launch/ffw_lg2_leader_ai.launch.py",
        "launch/ffw_sg2_ai.launch.py",
        "launch/ffw_sg2_follower_ai.launch.py",
        "launch/ffw_sg2_follower_ai_gazebo.launch.py",
        "worlds/empty_world.sdf",
    ],
    package_xml = "package.xml",
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [
            ":ament_index",
            "@robot_state_publisher//:ament_index",
        ],
        deps = [":ffw_bringup"],
    )
    for f in glob(["launch/**"])
]

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"joint_trajectory_executor": "ffw_bringup.joint_trajectory_executor:main"},
    data = [
        "config/common/common_stereo.yaml",
        "config/common/rs_serial.yaml",
        "config/common/zedm.yaml",
        "config/ffw_bg2_rev2_follower/ffw_bg2_follower_ai_hardware_controller.yaml",
        "config/ffw_bg2_rev2_follower/ffw_bg2_follower_initial_positions.yaml",
        "config/ffw_bg2_rev3_follower/ffw_bg2_follower_ai_hardware_controller.yaml",
        "config/ffw_bg2_rev3_follower/ffw_bg2_follower_initial_positions.yaml",
        "config/ffw_bg2_rev4_follower/ffw_bg2_follower_ai_hardware_controller.yaml",
        "config/ffw_bg2_rev4_follower/ffw_bg2_follower_initial_positions.yaml",
        "config/ffw_lg2_leader/ffw_lg2_leader_ai_hardware_controller.yaml",
        "config/ffw_sg2_rev1_follower/ffw_sg2_follower_ai_hardware_controller.yaml",
        "config/ffw_sg2_rev1_follower/ffw_sg2_follower_initial_positions.yaml",
        "launch/camera.launch.py",
        "launch/camera_realsense.launch.py",
        "launch/camera_zed.launch.py",
        "launch/ffw_bg2_ai.launch.py",
        "launch/ffw_bg2_follower_ai.launch.py",
        "launch/ffw_bg2_follower_ai_gazebo.launch.py",
        "launch/ffw_lg2_leader_ai.launch.py",
        "launch/ffw_sg2_ai.launch.py",
        "launch/ffw_sg2_follower_ai.launch.py",
        "launch/ffw_sg2_follower_ai_gazebo.launch.py",
        "worlds/empty_world.sdf",
    ],
    package_xml = "package.xml",
    python = [":ffw_bringup"],
    deps = [
        "@dynamixel_hardware_interface//:ament_package",
        "@ffw_description//:ament_package",
        "@gz_ros2_control//:ament_package",
        "@image_transport_plugins//:ament_package",
        "@rclpy//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@ros2_control//:ament_package",
        "@ros2_controllers//:ament_package",
        "@ros_gz_bridge//:ament_package",
        "@ros_gz_image//:ament_package",
        "@ros_gz_sim//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
        "@xacro//:ament_package",
    ],
)
