load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@mrpt_poses//:mrpt_poses": "@mrpt_poses//:mrpt_poses_library",
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
]

cc_library(
    name = "mrpt_tfest_library",
    srcs = [
        "src/TMatchingPair.cpp",
        "src/registerAllClasses.cpp",
        "src/se2_l2.SSE2.cpp",
        "src/se2_l2.cpp",
        "src/se2_l2_ransac.cpp",
        "src/se3_l2.cpp",
        "src/se3_l2_ransac.cpp",
    ],
    hdrs = [
        "include/mrpt/tfest.h",
        "include/mrpt/tfest/TMatchingPair.h",
        "include/mrpt/tfest/indiv-compat-decls.h",
        "include/mrpt/tfest/registerAllClasses.h",
        "include/mrpt/tfest/se2.h",
        "include/mrpt/tfest/se3.h",
        "src/se2_l2_internal.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_tfest",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mrpt_tfest_library"],
)

cc_library(
    name = "_bindings_library",
    srcs = ["python_bindings/mrpt_tfest_py.cpp"],
    hdrs = [
        "include/mrpt/tfest.h",
        "include/mrpt/tfest/TMatchingPair.h",
        "include/mrpt/tfest/indiv-compat-decls.h",
        "include/mrpt/tfest/registerAllClasses.h",
        "include/mrpt/tfest/se2.h",
        "include/mrpt/tfest/se3.h",
        "src/se2_l2_internal.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":mrpt_tfest_library"],
)

cc_shared_library(
    name = "_bindings",
    dynamic_deps = DEPENDENCIES.keys() + [":mrpt_tfest"],
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "mrpt/tfest/_bindings.so",
    deps = [":_bindings_library"],
)

py_library(
    name = "mrpt",
    srcs = ["python/mrpt/tfest/__init__.py"],
    imports = ["python"],
    deps = ["@mrpt_poses//:mrpt"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_tfest",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_tfest": [
            "libmrpt_tfest.so.3.3",
            "libmrpt_tfest.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_common//:ament_package",
        "@mrpt_poses//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    egg_info = False,
    headers = [
        "include/mrpt/tfest.h",
        "include/mrpt/tfest/TMatchingPair.h",
        "include/mrpt/tfest/indiv-compat-decls.h",
        "include/mrpt/tfest/registerAllClasses.h",
        "include/mrpt/tfest/se2.h",
        "include/mrpt/tfest/se3.h",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mrpt_tfest",
    ],
    package_xml = "package.xml",
    python = [
        ":mrpt",
        ":_bindings",
    ],
    python_strip_prefix = "python",
    sonames = {
        "mrpt_tfest": [
            "libmrpt_tfest.so.3.3",
            "libmrpt_tfest.so.3.3.1",
        ],
    },
    deps = [":ament_index"] + [
        "@mrpt_common//:ament_package",
        "@mrpt_poses//:ament_package",
    ],
)
