load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

py_library(
    name = "easynav_support_py",
    srcs = [
        "easynav_goalmanager_py/__init__.py",
        "easynav_goalmanager_py/goal_manager_client.py",
    ],
    imports = ["."],
    deps = [
        "@builtin_interfaces//:py",
        "@easynav_interfaces//:py",
        "@geometry_msgs//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

ament_package(
    name = "ament_package",
    build_type = "ament_python",
    console_scripts = {"goalmanager_demo": "easynav_goalmanager_py.demo_client:main"},
    package_xml = "package.xml",
    python = [":easynav_support_py"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_cmake_pytest//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@easynav_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
