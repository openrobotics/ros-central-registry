)

DEPENDENCIES = {
    "@mbf_utility//:mbf_utility": "@mbf_utility//:mbf_utility_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
}

CC_DEPS = [
    "@rcl_interfaces//:cc",
    "@geometry_msgs//:cc",
    "@mbf_abstract_core//:mbf_abstract_core",
    "@mbf_msgs//:cc",
    "@nav_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@std_msgs//:cc",
    "@std_srvs//:cc",
]

cc_library(
    name = "mbf_abstract_server_library",
    srcs = [
        "src/abstract_controller_execution.cpp",
        "src/abstract_execution_base.cpp",
        "src/abstract_navigation_server.cpp",
        "src/abstract_plan_refiner_execution.cpp",
        "src/abstract_planner_execution.cpp",
        "src/abstract_recovery_execution.cpp",
        "src/controller_action.cpp",
        "src/move_base_action.cpp",
        "src/plan_refiner_action.cpp",
        "src/planner_action.cpp",
        "src/recovery_action.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        ".",
        "include",
        "include/mbf_abstract_nav",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mbf_abstract_server",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mbf_abstract_server_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":mbf_abstract_server"],
)

ament_index(
    name = "ament_index",
    libraries = [":mbf_abstract_server"],
    package_xml = "package.xml",
