load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@mbf_utility//:mbf_utility": "@mbf_utility//:mbf_utility_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@mbf_abstract_core//:mbf_abstract_core",
    "@mbf_msgs//:cc",
    "@nav_msgs//:cc",
    "@rcl_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@std_msgs//:cc",
    "@std_srvs//:cc",
]

cc_library(
    name = "mbf_abstract_server_library",
    srcs = [
        "src/abstract_controller_execution.cpp",
        "src/abstract_execution_base.cpp",
        "src/abstract_navigation_server.cpp",
        "src/abstract_plan_refiner_execution.cpp",
        "src/abstract_planner_execution.cpp",
        "src/abstract_recovery_execution.cpp",
        "src/controller_action.cpp",
        "src/move_base_action.cpp",
        "src/plan_refiner_action.cpp",
        "src/planner_action.cpp",
        "src/recovery_action.cpp",
    ],
    hdrs = [
        "include/mbf_abstract_nav/abstract_action_base.hpp",
        "include/mbf_abstract_nav/abstract_controller_execution.h",
        "include/mbf_abstract_nav/abstract_execution_base.h",
        "include/mbf_abstract_nav/abstract_navigation_server.h",
        "include/mbf_abstract_nav/abstract_plan_refiner_execution.h",
        "include/mbf_abstract_nav/abstract_planner_execution.h",
        "include/mbf_abstract_nav/abstract_plugin_manager.h",
        "include/mbf_abstract_nav/abstract_recovery_execution.h",
        "include/mbf_abstract_nav/controller_action.h",
        "include/mbf_abstract_nav/impl/abstract_plugin_manager.tcc",
        "include/mbf_abstract_nav/move_base_action.h",
        "include/mbf_abstract_nav/plan_refiner_action.h",
        "include/mbf_abstract_nav/planner_action.h",
        "include/mbf_abstract_nav/recovery_action.h",
    ],
    includes = [
        ".",
        "include",
        "include/mbf_abstract_nav",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mbf_abstract_server",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mbf_abstract_server_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":mbf_abstract_server"],
)

ament_index(
    name = "ament_index",
    libraries = [":mbf_abstract_server"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mbf_abstract_core//:ament_package",
        "@mbf_msgs//:ament_package",
        "@mbf_utility//:ament_package",
        "@nav_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "geometry_msgs",
        "mbf_abstract_core",
        "mbf_msgs",
        "mbf_utility",
        "nav_msgs",
        "rclcpp",
        "rclcpp_action",
        "std_msgs",
        "std_srvs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    cmake_export_name = "export_mbf_abstract_nav",
    headers = [
        "include/mbf_abstract_nav/abstract_action_base.hpp",
        "include/mbf_abstract_nav/abstract_controller_execution.h",
        "include/mbf_abstract_nav/abstract_execution_base.h",
        "include/mbf_abstract_nav/abstract_navigation_server.h",
        "include/mbf_abstract_nav/abstract_plan_refiner_execution.h",
        "include/mbf_abstract_nav/abstract_planner_execution.h",
        "include/mbf_abstract_nav/abstract_plugin_manager.h",
        "include/mbf_abstract_nav/abstract_recovery_execution.h",
        "include/mbf_abstract_nav/controller_action.h",
        "include/mbf_abstract_nav/impl/abstract_plugin_manager.tcc",
        "include/mbf_abstract_nav/move_base_action.h",
        "include/mbf_abstract_nav/plan_refiner_action.h",
        "include/mbf_abstract_nav/planner_action.h",
        "include/mbf_abstract_nav/recovery_action.h",
    ],
    include_prefix = "",
    libraries = [":mbf_abstract_server"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mbf_abstract_core//:ament_package",
        "@mbf_msgs//:ament_package",
        "@mbf_utility//:ament_package",
        "@nav_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
