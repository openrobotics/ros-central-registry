load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

pkg_files(
    name = "install_licenses",
    srcs = glob(
        ["licenses/**"],
        exclude = ["**/CMakeLists.txt"],
    ),
    prefix = "share",
    strip_prefix = strip_prefix.from_pkg(""),
)

genrule(
    name = "gen_export_libs_cmake",
    outs = ["cmake/ament_cmake_export_libraries-extras.cmake"],
    cmd = """
        mkdir -p $(RULEDIR)/cmake
        cat <<'EOF' > $@
# generated from ament_cmake_export_libraries/cmake/template/ament_cmake_export_libraries.cmake.in
set(_exported_libraries "")
set(_exported_library_names "ecl_license")
EOF
    """,
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    cmake = [
        ":gen_export_libs_cmake",
    ],
    cmake_export_has_library_target = True,
    cmake_extras = ["ament_cmake_export_libraries-extras.cmake"],
    install = [
        ":install_licenses",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@rosdistro//:ament_package",
    ],
)
