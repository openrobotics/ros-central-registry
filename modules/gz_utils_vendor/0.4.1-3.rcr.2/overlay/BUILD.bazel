# gz_utils_vendor: vendors gz-utils (Gazebo utils, version 4). The library
# itself comes from the Bazel Central Registry module `gz-utils`, wrapped as
# shared libraries in @rosdistro//cc/gz; this package exposes them under the
# upstream CMake target names and installs them where colcon's ament_vendor()
# does (opt/gz_utils_vendor/{include,lib}).

load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc/gz:defs.bzl", "gz_install_files", "gz_install_headers", "gz_vendor_hooks")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES (gz-utils::core / gz-utils::log / gz-utils::cli)

[
    (
        alias(
            name = name,
            actual = "@rosdistro//cc/gz:" + target,
        ),
        alias(
            name = name + "_library",
            actual = "@rosdistro//cc/gz:" + target + "_library",
        ),
    )
    for name, target in [
        ("gz_utils", "gz-utils"),
        ("gz_utils_log", "gz-utils-log"),
    ]
]

alias(
    name = "gz_utils_cli_library",
    actual = "@rosdistro//cc/gz:gz-utils-cli_library",
)

alias(
    name = "cli11",
    actual = "@rosdistro//cc/gz:cli11",
)

### INSTALL LAYOUT (opt/gz_utils_vendor/...)

VENDOR = "gz_utils_vendor"

PREFIX = "opt/" + VENDOR

gz_install_headers(
    name = "install_headers",
    prefix = PREFIX + "/include/gz/utils4",
    strip_prefixes = ["cli/include/vendored-cli"],
    deps = [
        ":cli11",
        ":gz_utils_cli_library",
        ":gz_utils_library",
        ":gz_utils_log_library",
    ],
)

gz_install_files(
    name = "install_libraries",
    srcs = [
        ":gz_utils",
        ":gz_utils_log",
    ],
    flatten = True,
    prefix = PREFIX + "/lib",
)

ENV_HOOKS = gz_vendor_hooks(
    name = "install_hooks",
    pythonpath = False,
    vendor = VENDOR,
)

### PACKAGING

ament_package(
    name = "ament_package",
    env_hooks = ENV_HOOKS,
    install = [
        ":install_headers",
        ":install_hooks",
        ":install_libraries",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_test//:ament_package",
        "@ament_cmake_vendor_package//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@gz_cmake_vendor//:ament_package",
        "@rosdistro//:ament_package",
        "@spdlog_vendor//:ament_package",
    ],
)
