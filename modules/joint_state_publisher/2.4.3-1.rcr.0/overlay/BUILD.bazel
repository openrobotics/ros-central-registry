load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "LICENSE",
        "README.md",
        "joint_state_publisher/__init__.py",
        "joint_state_publisher/joint_state_publisher.py",
        "package.xml",
        "pytest.ini",
        "resource/joint_state_publisher",
        "setup.cfg",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "xmllint",
]]

py_library(
    name = "joint_state_publisher",
    srcs = [
        "joint_state_publisher/__init__.py",
        "joint_state_publisher/joint_state_publisher.py",
    ],
    imports = ["."],
    deps = [
        "@launch_testing",
        "@launch_testing_ros",
        "@rclpy",
        "@ros2topic",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        requirement("packaging"),
        requirement("pyyaml"),
    ],
)

write_file(
    name = "joint_state_publisher_bin",
    out = "_gen/lib/joint_state_publisher/joint_state_publisher",
    content = [
        "#!/usr/bin/env python3",
        "import sys",
        "from joint_state_publisher.joint_state_publisher import main",
        "if __name__ == '__main__':",
        "    sys.exit(main())",
        "",
    ],
    is_executable = True,
)

ament_index(
    name = "ament_index",
    lib_data = [":joint_state_publisher_bin"],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    console_scripts = {"joint_state_publisher": "joint_state_publisher.joint_state_publisher:main"},
    executables = ["resource/joint_state_publisher"],
    package_xml = "package.xml",
    python = [":joint_state_publisher"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclpy//:ament_package",
        "@ros2topic//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
