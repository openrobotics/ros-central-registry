### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"joint_state_publisher": "joint_state_publisher.joint_state_publisher:main"},
    executables = ["resource/joint_state_publisher"],
    package_xml = "package.xml",
    python = [":joint_state_publisher"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@launch_testing//:ament_package",
