load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "xmllint",
    ]
]

py_library(
    name = "joint_state_publisher",
    srcs = glob(["joint_state_publisher/**/*.py"]),
    imports = ["."],
    deps = [
        "@launch_testing",
        "@launch_testing_ros",
        "@rclpy",
        "@ros2topic",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        requirement("packaging"),
        requirement("pyyaml"),
    ],
)

launch_ros_test(
    name = "test_64_joint_robot",
    src = "test/test_64_joint_robot.py",
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":joint_state_publisher"],
)

