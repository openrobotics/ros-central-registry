load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:lz4": "@rosdistro//cc:lz4_library",
    "@rosdistro//cc:protobuf": "@rosdistro//cc:protobuf_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
}

CC_DEPS = [
    "@cv_bridge//:cv_bridge_library",
    "@geometry_msgs//:cc",
    "@nav_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:pcl_common",
    "@rosdistro//cc:pcl_features",
    "@rosdistro//cc:pcl_filters",
    "@rosdistro//cc:pcl_io",
    "@rosdistro//cc:pcl_kdtree",
    "@rosdistro//cc:pcl_ml",
    "@rosdistro//cc:pcl_octree",
    "@rosdistro//cc:pcl_registration",
    "@rosdistro//cc:pcl_sample_consensus",
    "@rosdistro//cc:pcl_search",
    "@rosdistro//cc:pcl_segmentation",
    "@rosdistro//cc:pcl_surface",
    "@rosdistro//cc:pcl_visualization",
    "@rtabmap_msgs//:cc",
    "@rtabmap_sync//:rtabmap_sync_library",
    "@std_msgs//:cc",
    "@std_srvs//:cc",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "rgbd_image_viewer",
    srcs = [
        "include/rtabmap_viz/GuiWrapper.h",
        "include/rtabmap_viz/PreferencesDialogROS.h",
        "include/rtabmap_viz/rgbd_image_viewer.hpp",
        "include/rtabmap_viz/visibility.h",
        "src/RGBDImageViewerNode.cpp",
        "src/rgbd_image_viewer.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/rtabmap_viz",
    ],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "rtabmap_viz",
    srcs = [
        "include/rtabmap_viz/GuiWrapper.h",
        "include/rtabmap_viz/PreferencesDialogROS.h",
        "include/rtabmap_viz/rgbd_image_viewer.hpp",
        "include/rtabmap_viz/visibility.h",
        "src/GuiNode.cpp",
        "src/GuiWrapper.cpp",
        "src/PreferencesDialogROS.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/rtabmap_viz",
    ],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

ament_index(
    name = "ament_index",
    lib_data = [
        ":rgbd_image_viewer",
        ":rtabmap_viz",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@cv_bridge//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_environment//:ament_package",
        "@rtabmap_msgs//:ament_package",
        "@rtabmap_sync//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@cv_bridge//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_environment//:ament_package",
        "@rtabmap_msgs//:ament_package",
        "@rtabmap_sync//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2//:ament_package",
    ],
)
