load("@qt//:qt.bzl", "qt_cc_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:lz4": "@rosdistro//cc:lz4_library",
    "@rosdistro//cc:pcl": "@rosdistro//cc:pcl_library",
    "@rosdistro//cc:protobuf": "@rosdistro//cc:protobuf_library",
    "@rosdistro//cc:vtk": "@rosdistro//cc:vtk_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
    "@rtabmap//:rtabmap_core": "@rtabmap//:rtabmap_core_library",
    "@rtabmap//:rtabmap_gui": "@rtabmap//:rtabmap_gui_library",
    "@rtabmap//:rtabmap_utilite": "@rtabmap//:rtabmap_utilite_library",
    "@rtabmap_msgs//:cc_shared": "@rtabmap_msgs//:cc",
    "@rtabmap_sync//:rtabmap_sync": "@rtabmap_sync//:rtabmap_sync_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@std_srvs//:cc_shared": "@std_srvs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
}

CC_DEPS = [
    "@cv_bridge//:cv_bridge_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:eigen",
    "@qtbase//:core",
    "@qtbase//:gui",
    "@qtbase//:widgets",
    "@rosdistro//cc:opencv_library",
    "@rtabmap//:_gen_textual_hdrs",
]

# cc_binary has no `includes`, so the package's own headers (included as
# <rtabmap_viz/...>) are exposed through a header-only library.
cc_library(
    name = "rtabmap_viz_headers",
    hdrs = glob([
        "include/rtabmap_viz/*.h",
        "include/rtabmap_viz/*.hpp",
    ]),
    includes = [
        "include",
        "include/rtabmap_viz",
    ],
    visibility = ["//visibility:private"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

qt_cc_binary(
    name = "rgbd_image_viewer",
    srcs = [
        "include/rtabmap_viz/GuiWrapper.h",
        "include/rtabmap_viz/PreferencesDialogROS.h",
        "include/rtabmap_viz/rgbd_image_viewer.hpp",
        "include/rtabmap_viz/visibility.h",
        "src/RGBDImageViewerNode.cpp",
        "src/rgbd_image_viewer.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "kiss_fft_scalar=double",
    ],
    moc_hdrs = ["include/rtabmap_viz/rgbd_image_viewer.hpp"],
    moc_srcs = [],
    deps = DEPENDENCIES.values() + CC_DEPS + [":rtabmap_viz_headers"],
)

qt_cc_binary(
    name = "rtabmap_viz",
    srcs = [
        "include/rtabmap_viz/GuiWrapper.h",
        "include/rtabmap_viz/PreferencesDialogROS.h",
        "include/rtabmap_viz/rgbd_image_viewer.hpp",
        "include/rtabmap_viz/visibility.h",
        "src/GuiNode.cpp",
        "src/GuiWrapper.cpp",
        "src/PreferencesDialogROS.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "kiss_fft_scalar=double",
    ],
    moc_hdrs = ["include/rtabmap_viz/PreferencesDialogROS.h"],
    moc_srcs = [],
    deps = DEPENDENCIES.values() + CC_DEPS + [":rtabmap_viz_headers"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = ["@rtabmap_sync//:ament_index"],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    executables = [
        ":rgbd_image_viewer",
        ":rtabmap_viz",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@cv_bridge//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_environment//:ament_package",
        "@rtabmap//:ament_package",
        "@rtabmap_msgs//:ament_package",
        "@rtabmap_sync//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2//:ament_package",
    ],
)
