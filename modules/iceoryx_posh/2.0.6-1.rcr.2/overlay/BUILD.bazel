    template = "cmake/iceoryx_posh_deployment.hpp.in",
)

expand_template(
    name = "iceoryx_versions_hpp",
    out = "include/iceoryx_versions.hpp",
    substitutions = {
        "@PROJECT_VERSION_MAJOR@": "2",
        "@PROJECT_VERSION_MINOR@": "0",
        "@PROJECT_VERSION_PATCH@": "6",
        "@IOX_VERSION_TWEAK@": "0",
        "@CMAKE_PROJECT_VERSION@": "2.0.6",
        "@ICEORYX_BUILDDATE@": "1970-01-01T00:00:00Z",
        "@ICEORYX_SHA1@": "5eefc15a968ac6aea6faa8f7c61d15abff29b2c4",
    },
    template = "cmake/iceoryx_versions.hpp.in",
)

