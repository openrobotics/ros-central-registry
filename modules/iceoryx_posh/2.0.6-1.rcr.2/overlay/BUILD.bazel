PRIVATE_HDRS = glob(
    [
        "source/**/*.hpp",
        "source/**/*.inl",
    ],
    allow_empty = True,
)

cc_library(
    name = "iceoryx_posh_library",
    srcs = POSH_SRCS + PRIVATE_HDRS,
    hdrs = HEADERS,
    includes = ["include"],
    linkopts = select({
        "@platforms//os:linux": [
            "-lpthread",
            "-lrt",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "@iceoryx_hoofs//:iceoryx_hoofs_library",
    ],
)

