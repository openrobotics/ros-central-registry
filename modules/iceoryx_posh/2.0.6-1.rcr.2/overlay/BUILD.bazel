    name = "iceoryx_posh",
    dynamic_deps = [
        "@iceoryx_hoofs//:iceoryx_hoofs",
        "@iceoryx_hoofs//:iceoryx_platform",
    ],
    exports_filter = [":iceoryx_posh_library"],
    deps = [":iceoryx_posh_library"],
)

cc_library(
    name = "iceoryx_posh_gateway_library",
    srcs = ["source/gateway/gateway_base.cpp"] + PRIVATE_HDRS,
