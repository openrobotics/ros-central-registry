### BINARIES

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":iceoryx_posh",
        ":iceoryx_posh_config",
        ":iceoryx_posh_gateway",
        ":iceoryx_posh_roudi",
    ],
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "iox-roudi",
    srcs = ["source/roudi/application/roudi_main.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":iceoryx_posh_config_library",
        ":iceoryx_posh_library",
        ":iceoryx_posh_roudi_library",
        "@iceoryx_hoofs//:iceoryx_hoofs_library",
    ],
)

### INSTALL METADATA

[
    write_file(
        name = "gen_" + f.replace("/", "_").replace(".", "_").replace("-", "_"),
        out = "_gen/" + f,
        content = [""],
    )
    for f in [
        "lib/cmake/iceoryx_posh/iceoryx_poshConfig.cmake",
        "lib/cmake/iceoryx_posh/iceoryx_poshConfigVersion.cmake",
        "lib/cmake/iceoryx_posh/iceoryx_poshTargets-noconfig.cmake",
        "lib/cmake/iceoryx_posh/iceoryx_poshTargets.cmake",
    ]
]

pkg_files(
    name = "cmake_gen_files",
    srcs = [
        ":gen_lib_cmake_iceoryx_posh_iceoryx_poshConfigVersion_cmake",
        ":gen_lib_cmake_iceoryx_posh_iceoryx_poshConfig_cmake",
        ":gen_lib_cmake_iceoryx_posh_iceoryx_poshTargets_cmake",
        ":gen_lib_cmake_iceoryx_posh_iceoryx_poshTargets_noconfig_cmake",
    ],
    strip_prefix = strip_prefix.from_pkg("_gen"),
)

pkg_files(
    name = "cmake_src_files",
    srcs = ["cmake/IceoryxPoshDeployment.cmake"],
    prefix = "lib/cmake/iceoryx_posh",
    strip_prefix = strip_prefix.from_pkg("cmake"),
)

pkg_files(
    name = "etc_files",
    srcs = ["etc/iceoryx/roudi_config_example.toml"],
    prefix = "etc",
    strip_prefix = strip_prefix.from_pkg("etc/iceoryx"),
)

pkg_files(
    name = "doc_license",
    srcs = ["LICENSE"],
    prefix = "share/doc/iceoryx_posh",
)

pkg_files(
    name = "doc_3rd_party",
    srcs = ["doc/3rd_party_licenses/cpptoml/LICENSE"],
    prefix = "share/doc/iceoryx_posh",
    strip_prefix = strip_prefix.from_pkg("doc"),
)

### PACKAGING

ament_package(
    name = "ament_package",
    build_type = "cmake",
    headers = HEADERS,
    headers_strip_prefix = "include",
    include_prefix = "iceoryx/v2.0.6",
    install = [
        ":cmake_gen_files",
        ":cmake_src_files",
        ":doc_3rd_party",
        ":doc_license",
        ":etc_files",
    ],
    install_package_xml = False,
    libraries = [
        ":iceoryx_posh",
        ":iceoryx_posh_config",
        ":iceoryx_posh_gateway",
        ":iceoryx_posh_roudi",
    ],
    package_xml = "package.xml",
    programs = [":iox-roudi"],
    deps = [
        "@iceoryx_hoofs//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
