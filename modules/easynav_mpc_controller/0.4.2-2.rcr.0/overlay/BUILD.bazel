cc_library(
    name = "easynav_mpc_controller_library",
    srcs = [
        "src/easynav_mpc_controller/MPCController.cpp",
        "src/easynav_mpc_controller/MPCOptimizer.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":gen_nlopt_hpp"],
    copts = ["-std=c++20"],
    includes = [
        "_gen/include",
        "include",
        "include/easynav_mpc_controller",
    ],
    local_defines = ros_local_defines() + [
        "EASYNAV_DEBUG_WITH_YAETS",
        "GLAD_API_CALL_EXPORT",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "easynav_mpc_controller",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":easynav_mpc_controller_library"],
)

write_file(
    name = "gen_nlopt_hpp",
    out = "_gen/include/nlopt.hpp",
    content = ["#ifndef RCR_NLOPT_HPP_\n#define RCR_NLOPT_HPP_\n#include <algorithm>\n#include <cmath>\n#include <vector>\nnamespace nlopt {\nenum algorithm { LN_COBYLA = 0, LD_MMA = 1, LD_SLSQP = 2, LN_BOBYQA = 3, LN_NELDERMEAD = 4 };\nenum result { FAILURE = -1, INVALID_ARGS = -2, OUT_OF_MEMORY = -3, ROUNDOFF_LIMITED = -4, FORCED_STOP = -5, SUCCESS = 1, STOPVAL_REACHED = 2, FTOL_REACHED = 3, XTOL_REACHED = 4, MAXEVAL_REACHED = 5, MAXTIME_REACHED = 6 };\nusing vfunc = double (*)(const std::vector<double> &, std::vector<double> &, void *);\nclass opt {\n public:\n  opt(algorithm, unsigned int n) : n_(n), lb_(n, -1e9), ub_(n, 1e9) {}\n  void set_min_objective(vfunc f, void * f_data) { f_ = f; f_data_ = f_data; }\n  void set_lower_bounds(const std::vector<double> & lb) { lb_ = lb; }\n  void set_upper_bounds(const std::vector<double> & ub) { ub_ = ub; }\n  void set_xtol_rel(double t) { xtol_rel_ = t; }\n  void set_ftol_rel(double t) { ftol_rel_ = t; }\n  void set_maxeval(int m) { maxeval_ = m; }\n  void set_maxtime(double t) { maxtime_ = t; }\n  result optimize(std::vector<double> & x, double & opt_f) {\n    if (!f_) return FAILURE;\n    std::vector<double> grad;\n    for (unsigned int i = 0; i < n_ && i < x.size(); ++i)\n      x[i] = std::clamp(x[i], lb_[i], ub_[i]);\n    opt_f = f_(x, grad, f_data_);\n    double step = 0.2;\n    int evals = 1;\n    for (int iter = 0; iter < 25 && evals < maxeval_; ++iter) {\n      bool improved = false;\n      for (unsigned int i = 0; i < n_ && i < x.size(); ++i) {\n        double orig = x[i];\n        for (double dir : {1.0, -1.0}) {\n          x[i] = std::clamp(orig + dir * step, lb_[i], ub_[i]);\n          double val = f_(x, grad, f_data_);\n          ++evals;\n          if (val < opt_f) { opt_f = val; orig = x[i]; improved = true; break; }\n          x[i] = orig;\n        }\n      }\n      if (!improved) step *= 0.5;\n      if (step < xtol_rel_) break;\n    }\n    return SUCCESS;\n  }\n private:\n  unsigned int n_;\n  std::vector<double> lb_, ub_;\n  vfunc f_{nullptr};\n  void * f_data_{nullptr};\n  double xtol_rel_{1e-3}, ftol_rel_{1e-3}, maxtime_{1.0};\n  int maxeval_{500};\n};\n}  // namespace nlopt\n#endif\n"],
)

