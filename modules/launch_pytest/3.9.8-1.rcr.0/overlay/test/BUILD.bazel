load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "_root_test_files_1",
    srcs = [
        "launch_pytest/examples/check_node_msgs.py",
        "launch_pytest/examples/function_scope.py",
        "launch_pytest/examples/module_scope.py",
        "launch_pytest/examples/pytest_hello_world.py",
    ],
)

filegroup(
    name = "_root_test_files_0",
    srcs = ["launch_pytest/examples/executables/talker.py"],
)

exports_files([
    "conftest.py",
    "launch_pytest/examples/check_node_msgs.py",
    "launch_pytest/examples/executables/talker.py",
    "launch_pytest/examples/function_scope.py",
    "launch_pytest/examples/module_scope.py",
    "launch_pytest/examples/pytest_hello_world.py",
    "launch_pytest/test_plugin.py",
    "launch_pytest/tools/test_process.py",
    "test_copyright.py",
    "test_flake8.py",
    "test_pep257.py",
    "test_xmllint.py",
])

py_pytest(
    name = "test_plugin",
    srcs = ["launch_pytest/test_plugin.py"],
    args = [
        "-p",
        "launch_pytest.plugin",
    ],
    data = ["//:ament_index"] + [
        "conftest.py",
        "launch_pytest/examples/check_node_msgs.py",
        "launch_pytest/examples/executables/talker.py",
        "launch_pytest/examples/function_scope.py",
        "launch_pytest/examples/module_scope.py",
        "launch_pytest/examples/pytest_hello_world.py",
        "launch_pytest/test_plugin.py",
        "launch_pytest/tools/test_process.py",
        "test_copyright.py",
        "test_flake8.py",
        "test_pep257.py",
        "test_xmllint.py",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = ["//:launch_pytest"],
)

py_pytest(
    name = "test_process",
    srcs = ["launch_pytest/tools/test_process.py"],
    args = [
        "-p",
        "launch_pytest.plugin",
    ],
    data = ["//:ament_index"] + [
        "conftest.py",
        "launch_pytest/examples/check_node_msgs.py",
        "launch_pytest/examples/executables/talker.py",
        "launch_pytest/examples/function_scope.py",
        "launch_pytest/examples/module_scope.py",
        "launch_pytest/examples/pytest_hello_world.py",
        "launch_pytest/test_plugin.py",
        "launch_pytest/tools/test_process.py",
        "test_copyright.py",
        "test_flake8.py",
        "test_pep257.py",
        "test_xmllint.py",
    ],
    deps = ["//:launch_pytest"],
)
