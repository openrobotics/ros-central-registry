load("@qt//:qt.bzl", "qt_cc_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@map_msgs//:cc_shared": "@map_msgs//:cc",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@octomap_msgs//:cc_shared": "@octomap_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:OgreMain": "@rosdistro//cc:OgreMain_library",
    "@rosdistro//cc:OgreOverlay": "@rosdistro//cc:OgreOverlay_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:octomap_shared": "@rosdistro//cc:octomap",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rviz_common//:rviz_common": "@rviz_common//:rviz_common_library",
    "@rviz_default_plugins//:rviz_default_plugins": "@rviz_default_plugins//:rviz_default_plugins_library",
    "@rviz_rendering//:rviz_rendering": "@rviz_rendering//:rviz_rendering_library",
}

CC_DEPS = [
    "@qtbase//:widgets",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

qt_cc_library(
    name = "occupancy_grid_display",
    srcs = ["src/occupancy_grid_display.cpp"],
    hdrs = ["include/octomap_rviz_plugins/occupancy_grid_display.hpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "include/octomap_rviz_plugins",
    ],
    local_defines = ros_local_defines() + [
        "OCTOMAP_RVIZ_PLUGINS_BUILDING_LIBRARY",
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    moc_hdrs = ["include/octomap_rviz_plugins/occupancy_grid_display.hpp"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

qt_cc_library(
    name = "occupancy_map_display",
    srcs = ["src/occupancy_map_display.cpp"],
    hdrs = ["include/octomap_rviz_plugins/occupancy_map_display.hpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "include/octomap_rviz_plugins",
    ],
    local_defines = ros_local_defines() + [
        "OCTOMAP_RVIZ_PLUGINS_BUILDING_LIBRARY",
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    moc_hdrs = ["include/octomap_rviz_plugins/occupancy_map_display.hpp"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_library(
    name = "octomap_rviz_plugins_library",
    hdrs = [
        "include/octomap_rviz_plugins/occupancy_grid_display.hpp",
        "include/octomap_rviz_plugins/occupancy_map_display.hpp",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/octomap_rviz_plugins",
    ],
    deps = [
        ":occupancy_grid_display",
        ":occupancy_map_display",
    ] + DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "link_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        "@qtbase//:widgets_shared",
    ],
)

cc_shared_library(
    name = "octomap_rviz_plugins",
    dynamic_deps = [
        ":link_dynamic_deps",
        "@map_msgs//:cc_shared",
        "@nav_msgs//:cc_shared",
        "@octomap_msgs//:cc_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":octomap_rviz_plugins_library"],
)

ament_index(
    name = "ament_index",
    data = [
        "icons/classes/ColorOccupancyGrid.png",
        "icons/classes/OccupancyGrid.png",
        "icons/classes/OccupancyGridStamped.png",
        "icons/classes/OccupancyMap.png",
        "icons/classes/OccupancyMapStamped.png",
    ],
    libraries = [":octomap_rviz_plugins"],
    package_xml = "package.xml",
    plugin_category = "rviz_common",
    plugins = ["plugins_description.xml"],
    deps = [
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@map_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@octomap_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_default_plugins//:ament_package",
        "@rviz_rendering//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "octomap_msgs",
        "rclcpp",
        "rviz_common",
        "rviz_default_plugins",
        "rviz_rendering",
    ],
    cmake_export_targets = False,
    headers = [
        "include/octomap_rviz_plugins/occupancy_grid_display.hpp",
        "include/octomap_rviz_plugins/occupancy_map_display.hpp",
    ],
    libraries = [":octomap_rviz_plugins"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@map_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@octomap_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_default_plugins//:ament_package",
        "@rviz_rendering//:ament_package",
    ],
)
