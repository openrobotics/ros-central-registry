### PACKAGING

COMPONENTS = [
    ("core", "src/core/include"),
    ("communication", "src/communication/include"),
    ("systems", "src/systems/include"),
    ("plants", "src/plants/include"),
    ("controllers", "src/controllers/include"),
    ("observers", "src/observers/include"),
    ("numerics", "src/numerics/include"),
    ("optimization", "src/optimization/include"),
    ("optimal_control", "src/optimal_control/include"),
    ("tasks", "src/tasks/include"),
]

[
    pkg_files(
        name = "install_hdrs_{}".format(comp),
        srcs = glob(
            [
                "{}/**/*.h".format(inc),
                "{}/**/*.hpp".format(inc),
            ],
            allow_empty = True,
        ),
        prefix = "include/control_box_rst",
        strip_prefix = strip_prefix.from_pkg(inc),
    )
    for comp, inc in COMPONENTS
]

pkg_files(
    name = "install_libs",
    srcs = [":corbo_{}".format(comp) for comp, _ in COMPONENTS],
    prefix = "lib/control_box_rst",
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "install_top_cmake",
    srcs = ["src/cmake/control_box_rstConfig.cmake"],
    prefix = "share/control_box_rst",
    strip_prefix = strip_prefix.files_only(),
)

[
    genrule(
        name = "gen_cmake_{}".format(comp),
        outs = [
            "share/control_box_rst/corbo_{0}/corbo_{0}Config.cmake".format(comp),
            "share/control_box_rst/corbo_{0}/corbo_{0}Config-release.cmake".format(comp),
        ],
        cmd = """
cat << 'EOF' > $(location share/control_box_rst/corbo_{0}/corbo_{0}Config.cmake)
# Generated by CMake
add_library(corbo_{0} STATIC IMPORTED)
include("$${{CMAKE_CURRENT_LIST_DIR}}/corbo_{0}Config-release.cmake")
EOF
cat << 'EOF' > $(location share/control_box_rst/corbo_{0}/corbo_{0}Config-release.cmake)
set_property(TARGET corbo_{0} APPEND PROPERTY IMPORTED_CONFIGURATIONS RELEASE)
EOF
""".format(comp),
    )
    for comp, _ in COMPONENTS
]

pkg_files(
    name = "install_comp_cmake",
    srcs = [":gen_cmake_{}".format(comp) for comp, _ in COMPONENTS],
    strip_prefix = strip_prefix.from_pkg(""),
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    build_type = "cmake",
    install = [
        ":install_comp_cmake",
        ":install_libs",
        ":install_top_cmake",
    ] + [":install_hdrs_{}".format(comp) for comp, _ in COMPONENTS],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@rosdistro//:ament_package",
    ],
)
