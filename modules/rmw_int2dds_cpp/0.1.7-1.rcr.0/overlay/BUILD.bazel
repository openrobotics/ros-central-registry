        "src/wait/rmw_wait.cpp",
        "src/wait/rmw_wait_set.cpp",
        "src/wait/waitset_registry.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/rmw_int2dds_cpp",
    ],
    local_defines = ros_local_defines() + ["RMW_INT2DDS_CPP_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rmw_int2dds_cpp",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":rmw_int2dds_cpp_library"],
)

collect_transitive_dynamic_deps(
