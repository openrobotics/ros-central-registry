load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@pinocchio//:pinocchio_collision": "@pinocchio//:pinocchio_collision_library",
    "@pinocchio//:pinocchio_default": "@pinocchio//:pinocchio_default_library",
    "@pinocchio//:pinocchio_parsers": "@pinocchio//:pinocchio_parsers_library",
    "@roboplan//:roboplan": "@roboplan//:roboplan_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
}

CC_DEPS = [
    "@rosdistro//cc:nanobind",
    "@builtin_interfaces//:cc",
    "@geometry_msgs//:cc",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:tl_expected",
    "@rules_python//python/cc:current_py_cc_headers",
    "@sensor_msgs//:cc",
    "@trajectory_msgs//:cc",
]

exports_files([
    "CMakeLists.txt",
    "resources/test_robot.srdf",
    "resources/test_robot.urdf",
    "test_type_conversions.cpp",
])

cc_test(
    name = "test_type_conversions_cpp",
    srcs = ["test_type_conversions.cpp"] + [] + [
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        "//:_cpp_ext.cpython-314-x86_64-linux-gnu",
        "//:ament_index",
    ] + [
        "CMakeLists.txt",
        "resources/test_robot.srdf",
        "resources/test_robot.urdf",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines() + [
        "COAL_HAS_OCTOMAP",
        "COAL_HAVE_OCTOMAP",
        "GTEST_HAS_PTHREAD=1",
        "OCTOMAP_MAJOR_VERSION=1",
        "OCTOMAP_MINOR_VERSION=10",
        "OCTOMAP_PATCH_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_MAJOR_VERSION=3",
        "PINOCCHIO_URDFDOM_HEADERS_MINOR_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_PATCH_VERSION=0",
        "PINOCCHIO_WITH_COLLISION",
        "PINOCCHIO_WITH_HPP_FCL",
        "PINOCCHIO_WITH_URDFDOM",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:roboplan_ros_cpp_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)
