load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/roboplan_ros_cpp/type_conversions.hpp",
    ] + [
    ],
    includes = [],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@pinocchio//:pinocchio_collision": "@pinocchio//:pinocchio_collision_library",
    "@pinocchio//:pinocchio_default": "@pinocchio//:pinocchio_default_library",
    "@pinocchio//:pinocchio_parsers": "@pinocchio//:pinocchio_parsers_library",
    "@roboplan//:roboplan": "@roboplan//:roboplan_library",
    "@roboplan_example_models//:roboplan_example_models": "@roboplan_example_models//:roboplan_example_models_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
    "@trajectory_msgs//:cc_shared": "@trajectory_msgs//:cc",
}

# Only the Python extension module uses nanobind (upstream CMake links it
# solely into bindings/); keep it out of the core shared library so it is
# not statically linked into both.
BINDINGS_DEPS = [
    "@rosdistro//cc:nanobind",
    "@rosdistro//cc:nanobind_eigen",
    "@rules_python//python/cc:current_py_cc_headers",
]

CC_DEPS = [
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:tl_expected",
]

cc_library(
    name = "roboplan_ros_cpp_library",
    srcs = ["src/type_conversions.cpp"],
    hdrs = [
        "include/roboplan_ros_cpp/type_conversions.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/roboplan_ros_cpp",
    ],
    local_defines = ros_local_defines() + [
        "COAL_HAS_OCTOMAP",
        "COAL_HAVE_OCTOMAP",
        "OCTOMAP_MAJOR_VERSION=1",
        "OCTOMAP_MINOR_VERSION=10",
        "OCTOMAP_PATCH_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_MAJOR_VERSION=3",
        "PINOCCHIO_URDFDOM_HEADERS_MINOR_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_PATCH_VERSION=0",
        "PINOCCHIO_WITH_COLLISION",
        "PINOCCHIO_WITH_HPP_FCL",
        "PINOCCHIO_WITH_URDFDOM",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "roboplan_ros_cpp",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":roboplan_ros_cpp_library"],
)

# Header-only nanobind type casters shared with downstream bindings (e.g.
# roboplan_ros_visualization). Kept separate from the core library so that
# nanobind is only ever linked into Python extension modules.
cc_library(
    name = "roboplan_ros_cpp_bindings_headers",
    hdrs = ["bindings/include/roboplan_ros_cpp_bindings/roboplan_ros_cpp_bindings.hpp"],
    includes = ["bindings/include"],
    deps = BINDINGS_DEPS + [":roboplan_ros_cpp_library"],
)

cc_library(
    name = "_cpp_ext_library",
    srcs = ["bindings/src/roboplan_ros_cpp_bindings.cpp"],
    hdrs = [
        "bindings/include/roboplan_ros_cpp_bindings/roboplan_ros_cpp_bindings.hpp",
        "include/roboplan_ros_cpp/type_conversions.hpp",
    ] + [
    ],
    includes = [
        "_gen/include",
        "bindings/include",
        "include",
        "include/roboplan_ros_cpp",
    ],
    local_defines = ros_local_defines() + [
        "COAL_HAS_OCTOMAP",
        "COAL_HAVE_OCTOMAP",
        "OCTOMAP_MAJOR_VERSION=1",
        "OCTOMAP_MINOR_VERSION=10",
        "OCTOMAP_PATCH_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_MAJOR_VERSION=3",
        "PINOCCHIO_URDFDOM_HEADERS_MINOR_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_PATCH_VERSION=0",
        "PINOCCHIO_WITH_COLLISION",
        "PINOCCHIO_WITH_HPP_FCL",
        "PINOCCHIO_WITH_URDFDOM",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + BINDINGS_DEPS + [":roboplan_ros_cpp_library"],
)

cc_shared_library(
    name = "_cpp_ext",
    dynamic_deps = DEPENDENCIES.keys() + [":roboplan_ros_cpp"],
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "roboplan_ros/cpp/_cpp_ext.so",
    deps = [":_cpp_ext_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":roboplan_ros_cpp",
        # The Python extension module is not a link-time dependency of
        # C++ consumers (it expects libpython symbols from the interpreter).
    ],
)

py_library(
    name = "roboplan_ros",
    srcs = ["bindings/python/roboplan_ros/cpp/__init__.py"],
    imports = ["bindings/python"],
    deps = [
        "@builtin_interfaces//:py",
        "@geometry_msgs//:py",
        "@pinocchio//:pinocchio_py",
        "@roboplan//:roboplan_py",
        "@roboplan_example_models//:roboplan",
        "@rosidl_generator_cpp",
        "@sensor_msgs//:py",
        "@trajectory_msgs//:py",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "//test:resources/test_robot.srdf",
        "//test:resources/test_robot.urdf",
    ],
    libraries = [":roboplan_ros_cpp"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@pinocchio//:ament_package",
        "@roboplan//:ament_package",
        "@roboplan_example_models//:ament_package",
        "@rosidl_generator_cpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_eigen//:ament_package",
        "@trajectory_msgs//:ament_package",
    ],
)

py_pytest(
    name = "test_type_conversions_py",
    srcs = ["bindings/test/test_type_conversions.py"],
    data = [
        ":_cpp_ext",
        ":ament_index",
    ],
    # xfail: Python module 'roboplan.core._core_ext' is not available in the Bazel build
    tags = [
        "manual",
        "xfail",
    ],
    deps = [
        ":roboplan_ros",
        "@builtin_interfaces//:py",
        "@geometry_msgs//:py",
        "@pinocchio//:pinocchio_py",
        "@roboplan//:roboplan_py",
        "@roboplan_example_models//:roboplan",
        "@rosidl_generator_cpp",
        "@sensor_msgs//:py",
        "@trajectory_msgs//:py",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "Eigen3",
        "geometry_msgs",
        "pinocchio",
        "roboplan",
        "tf2_eigen",
        "trajectory_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "roboplan_ros_cpp-targets",
    egg_info = False,
    headers = [
        "include/roboplan_ros_cpp/type_conversions.hpp",
        "bindings/include/roboplan_ros_cpp_bindings/roboplan_ros_cpp_bindings.hpp",
    ],
    headers_strip_prefixes = [
        "bindings/include",
        "include",
    ],
    include_prefix = "",
    libraries = [":roboplan_ros_cpp"],
    package_xml = "package.xml",
    python = [
        ":roboplan_ros",
        ":_cpp_ext",
        "bindings/python/roboplan_ros/cpp/_cpp_ext.pyi",
        "bindings/python/roboplan_ros/cpp/py.typed",
    ],
    python_env_hook = False,
    python_strip_prefix = "bindings/python",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@pinocchio//:ament_package",
        "@roboplan//:ament_package",
        "@roboplan_example_models//:ament_package",
        "@rosidl_generator_cpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_eigen//:ament_package",
        "@trajectory_msgs//:ament_package",
    ],
)
