cc_library(
    name = "roboplan_ros_cpp_library",
    srcs = ["src/type_conversions.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_nanobind_h",
        ":gen_nanobind_stl_filesystem_h",
        ":gen_nanobind_stl_string_h",
        ":gen_octomap_color_octree_h",
        ":gen_octomap_h",
        ":gen_octomap_msgs_conversions_h",
        ":gen_octomap_octree_key_h",
        ":gen_octomap_ros_conversions_hpp",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "bindings/include",
        "include",
        "include/roboplan_ros_cpp",
    ],
    local_defines = ros_local_defines() + [
        "COAL_HAS_OCTOMAP",
        "COAL_HAVE_OCTOMAP",
        "OCTOMAP_MAJOR_VERSION=1",
        "OCTOMAP_MINOR_VERSION=10",
        "OCTOMAP_PATCH_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_MAJOR_VERSION=3",
        "PINOCCHIO_URDFDOM_HEADERS_MINOR_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_PATCH_VERSION=0",
        "PINOCCHIO_WITH_COLLISION",
        "PINOCCHIO_WITH_HPP_FCL",
        "PINOCCHIO_WITH_URDFDOM",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "roboplan_ros_cpp",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":roboplan_ros_cpp_library"],
)

cc_library(
    name = "_cpp_ext.cpython-314-x86_64-linux-gnu_library",
