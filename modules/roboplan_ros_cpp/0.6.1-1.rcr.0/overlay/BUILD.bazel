onst { return !(*this == o); }\n  bool operator<(const OcTreeKey & o) const {\n    if (k[0] != o.k[0]) return k[0] < o.k[0];\n    if (k[1] != o.k[1]) return k[1] < o.k[1];\n    return k[2] < o.k[2];\n  }\n  struct KeyHash { std::size_t operator()(const OcTreeKey & key) const { return key.k[0] ^ (key.k[1] << 5) ^ (key.k[2] << 10); } };\n};\nusing KeySet = std::set<OcTreeKey>;\nusing KeyBoolMap = std::map<OcTreeKey, bool>;\nclass KeyRay {\npublic:\n  using iterator = std::vector<OcTreeKey>::iterator;\n  using const_iterator = std::vector<OcTreeKey>::const_iterator;\n  void reset() { ray_.clear(); }\n  iterator begin() { return ray_.begin(); }\n  iterator end() { return ray_.end(); }\n  const_iterator begin() const { return ray_.begin(); }\n  const_iterator end() const { return ray_.end(); }\n  std::size_t size() const { return ray_.size(); }\nprivate:\n  std::vector<OcTreeKey> ray_;\n};\nclass OcTreeNode {\npublic:\n  float getLogOdds() const { return 0.0f; }\n  void setLogOdds(float) {}\n  double getOccupancy() const { return 0.5; }\n  float getValue() const { return 0.0f; }\n  void setValue(float) {}\n  bool hasChildren() const { return false; }\n};\nclass ColorOcTreeNode : public OcTreeNode {\npublic:\n  struct Color {\n    uint8_t r = 255, g = 255, b = 255;\n    Color() = default;\n    Color(uint8_t r_, uint8_t g_, uint8_t b_) : r(r_), g(g_), b(b_) {}\n  };\n  Color getColor() const { return Color(); }\n  void setColor(Color) {}\n  void setColor(uint8_t, uint8_t, uint8_t) {}\n  bool isColorSet() const { return true; }\n};\nclass AbstractOcTree {\npublic:\n  virtual ~AbstractOcTree() = default;\n  virtual std::string getTreeType() const { return \"OcTree\"; }\n  double getResolution() const { return 0.1; }\n  virtual void setResolution(double) {}\n  virtual std::size_t size() const { return 0; }\n  virtual std::size_t memoryUsage() const { return 0; }\n  virtual void clear() {}\n  virtual void prune() {}\n  virtual void expand() {}\n  bool write(const std::string &