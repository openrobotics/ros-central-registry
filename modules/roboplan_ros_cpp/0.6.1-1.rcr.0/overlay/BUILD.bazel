            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_nanobind_h",
        ":gen_nanobind_stl_filesystem_h",
        ":gen_nanobind_stl_string_h",
        ":gen_octomap_color_octree_h",
        ":gen_octomap_h",
        ":gen_octomap_msgs_conversions_h",
        ":gen_octomap_octree_key_h",
        ":gen_octomap_ros_conversions_hpp",
    ],
    includes = [
        "_gen/include",
        "bindings/include",
        "include",
        "include/roboplan_ros_cpp",
    ],
    local_defines = ros_local_defines() + [
        "COAL_HAS_OCTOMAP",
        "COAL_HAVE_OCTOMAP",
        "OCTOMAP_MAJOR_VERSION=1",
        "OCTOMAP_MINOR_VERSION=10",
        "OCTOMAP_PATCH_VERSION=0",
