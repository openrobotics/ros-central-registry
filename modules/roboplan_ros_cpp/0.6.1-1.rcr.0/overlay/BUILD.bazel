ic const KeyBoolMap m; return m.begin(); }\n  KeyBoolMap::const_iterator changedKeysEnd() const { static const KeyBoolMap m; return m.end(); }\n  std::size_t getNumLeafNodes() const { return 0; }\n  std::size_t calcNumNodes() const { return 0; }\n  void getMetricMin(double & x, double & y, double & z) { x = y = z = 0; }\n  void getMetricMin(double & x, double & y, double & z) const { x = y = z = 0; }\n  void getMetricMax(double & x, double & y, double & z) { x = y = z = 0; }\n  void getMetricMax(double & x, double & y, double & z) const { x = y = z = 0; }\n  void getMetricSize(double & x, double & y, double & z) { x = y = z = 0; }\n  point3d getBBXMin() const { return point3d(); }\n  point3d getBBXMax() const { return point3d(); }\n  void setBBXMin(const point3d &) {}\n  void setBBXMax(const point3d &) {}\n  void useBBXLimit(bool) {}\n  bool bbxSet() const { return false; }\n  bool inBBX(const point3d &) const { return true; }\n  bool inBBX(const OcTreeKey &) const { return true; }\n  OcTreeKey coordToKey(const point3d &, unsigned = 16) const { return OcTreeKey(); }\n  OcTreeKey coordToKey(double, double, double, unsigned = 16) const { return OcTreeKey(); }\n  bool coordToKeyChecked(const point3d &, OcTreeKey &) const { return true; }\n  bool coordToKeyChecked(const point3d &, unsigned, OcTreeKey &) const { return true; }\n  bool coordToKeyChecked(double, double, double, OcTreeKey &) const { return true; }\n  bool coordToKeyChecked(double, double, double, unsigned, OcTreeKey &) const { return true; }\n  key_type coordToKey(double, unsigned = 16) const { return 0; }\n  point3d keyToCoord(const OcTreeKey &, unsigned = 16) const { return point3d(); }\n  double keyToCoord(key_type, unsigned = 16) const { return 0.0; }\n  OcTreeKey adjustKeyAtDepth(const OcTreeKey & k, unsigned) const { return k; }\n  key_type adjustKeyAtDepth(key_type k, unsigned) const { return k; }\n  NodeT * search(double, double, double, unsigned = 0) const { return nullptr; }\n  NodeT * search(cons