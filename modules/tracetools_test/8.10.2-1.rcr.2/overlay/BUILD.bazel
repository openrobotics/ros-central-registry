load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            ".coveragerc",
            "CHANGELOG.rst",
            "docs/Makefile",
            "docs/source/about.rst",
            "docs/source/api.rst",
            "docs/source/api/trace_test_case.rst",
            "docs/source/conf.py",
            "docs/source/index.rst",
            "package.xml",
            "resource/tracetools_test",
            "setup.cfg",
            "setup.py",
            "test/test_copyright.py",
            "test/test_flake8.py",
            "test/test_mypy.py",
            "test/test_pep257.py",
            "test/test_xmllint.py",
            "tracetools_test/__init__.py",
            "tracetools_test/case.py",
            "tracetools_test/mark_process.py",
            "tracetools_test/py.typed",
            "tracetools_test/utils.py",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "mypy",
        "pep257",
        "xmllint",
    ]
]

py_library(
    name = "tracetools_test",
    srcs = [
        "tracetools_test/__init__.py",
        "tracetools_test/case.py",
        "tracetools_test/mark_process.py",
        "tracetools_test/utils.py",
    ],
    imports = ["."],
    deps = [
        "@launch",
        "@launch_ros",
        "@tracetools_launch",
        "@tracetools_read",
        "@tracetools_trace",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":tracetools_test"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@rosdistro//:ament_package",
        "@tracetools_launch//:ament_package",
        "@tracetools_read//:ament_package",
        "@tracetools_trace//:ament_package",
    ],
)
