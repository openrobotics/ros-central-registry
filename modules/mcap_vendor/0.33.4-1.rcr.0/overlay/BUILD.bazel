load("@rosdistro//ament:defs.bzl", "ament_package")

package(default_visibility = ["//visibility:public"])

### PACKAGING

# Upstream builds libmcap.so from the FetchContent'd mcap sources and installs
# it (plus mcap's headers under include/mcap_vendor/mcap/); here the library
# is @rosdistro//cc:mcap, built from the BCR `mcap` module.
ament_package(
    name = "ament_package",
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    cmake_export_name = "mcap",
    headers = ["@rosdistro//cc:mcap_headers"],
    libraries = ["@rosdistro//cc:mcap"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@lz4_cmake_module//:ament_package",
        "@rosdistro//:ament_package",
        "@zstd_cmake_module//:ament_package",
    ],
)
