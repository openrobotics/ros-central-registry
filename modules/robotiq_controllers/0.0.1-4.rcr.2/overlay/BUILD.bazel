load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@controller_interface//:controller_interface_library",
    "@rosdistro//cc:fmt",
    "@std_srvs//:cc",
]

cc_library(
    name = "robotiq_controllers_library",
    srcs = ["src/robotiq_activation_controller.cpp"],
    hdrs = ["include/robotiq_controllers/robotiq_activation_controller.hpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/robotiq_controllers",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "robotiq_controllers",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":robotiq_controllers_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":robotiq_controllers"],
    package_xml = "package.xml",
    plugin_category = "controller_interface",
    plugins = ["controller_plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@controller_interface//:ament_package",
        "@std_srvs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "controller_interface",
        "std_srvs",
    ],
    cmake_export_name = "export_robotiq_controllers",
    headers = ["include/robotiq_controllers/robotiq_activation_controller.hpp"],
    include_prefix = "",
    libraries = [":robotiq_controllers"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@controller_interface//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
