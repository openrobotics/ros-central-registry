load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

py_library(
    name = "flexbe_core",
    srcs = glob(["flexbe_core/**/*.py"]),
    imports = ["."],
    deps = [
        "@flexbe_msgs//:py",
        "@rclpy",
        "@std_msgs//:py",
        "@std_srvs//:py",
        "@tf2_ros_py",
        requirement("catkin-pkg"),
    ],
)

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "flake8",
    ]
]

[
    py_pytest(
        name = test_name,
        srcs = ["test/{}.py".format(test_name)],
        data = glob(["test/**"]),
        imports = [
            ".",
            "test",
        ],
        deps = [
            ":flexbe_core",
            "@launch_ros",
            "@launch_testing",
        ],
    )
    for test_name in [
        "test_behavior_and_priority_guards",
        "test_behavior_library",
        "test_concurrency_container_exceptions",
        "test_core",
        "test_error_status",
        "test_exceptions",
        "test_exceptions_spin",
        "test_lockable_state_reentry",
        "test_logger",
        "test_logger_lifecycle",
        "test_manual_transition_validation",
        "test_priority_container_lifecycle",
        "test_proxies",
        "test_proxy_action_client",
        "test_proxy_action_client_cancel_callback",
        "test_proxy_action_client_send_goal",
        "test_proxy_publisher",
        "test_proxy_service_caller_shutdown",
        "test_proxy_subscriber_cached",
        "test_proxy_transform_listener",
        "test_rate_validation",
        "test_undeclared_outcome_guard",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":flexbe_core"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@flexbe_msgs//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2_ros_py//:ament_package",
    ],
)
