    name = "nav2_costmap_2d_client_library",
    actual = "@nav2_costmap_2d//:nav2_costmap_2d_client_library",
)

alias(
    name = "nav2_costmap_2d_core",
    actual = "@nav2_costmap_2d//:nav2_costmap_2d_core",
)

alias(
    name = "nav2_costmap_2d_core_library",
    actual = "@nav2_costmap_2d//:nav2_costmap_2d_core_library",
)

