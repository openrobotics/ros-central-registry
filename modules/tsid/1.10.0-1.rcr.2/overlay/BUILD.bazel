write_file(
    name = "gen_octomap_h",
    out = "_gen/include/octomap/octomap.h",
    content = ["#pragma once\n#include <cstdint>\n#include <cmath>\n#include <string>\n#include <vector>\n#include <set>\n#include <map>\n#include <istream>\n#include <ostream>\nnamespace octomap {\nusing key_type = uint16_t;\ninline float logodds(double p) { return static_cast<float>(std::log(p / (1.0 - p))); }\ninline double probability(double l) { return 1.0 / (1.0 + std::exp(-l)); }\nstruct point3d {\n  float x_ = 0, y_ = 0, z_ = 0;\n  point3d() = default;\n  point3d(float x, float y, float z) : x_(x), y_(y), z_(z) {}\n  const float & x() const { return x_; }\n  const float & y() const { return y_; }\n  const float & z() const { return z_; }\n  float & x() { return x_; }\n  float & y() { return y_; }\n  float & z() { return z_; }\n  float operator()(int i) const { return i == 0 ? x_ : (i == 1 ? y_ : z_); }\n  float & operator()(int i) { return i == 0 ? x_ : (i == 1 ? y_ : z_); }\n  float norm() const { return std::sqrt(x_*x_ + y_*y_ + z_*z_); }\n  point3d normalized() const { float n = norm(); return n > 0 ? point3d(x_/n, y_/n, z_/n) : *this; }\n  double distance(const point3d & o) const { return (*this - o).norm(); }\n  point3d operator+(const point3d & o) const { return point3d(x_+o.x_, y_+o.y_, z_+o.z_); }\n  point3d operator-(const point3d & o) const { return point3d(x_-o.x_, y_-o.y_, z_-o.z_); }\n  point3d operator*(float s) const { return point3d(x_*s, y_*s, z_*s); }\n  friend std::ostream & operator<<(std::ostream & os, const point3d & p) { return os << \"(\" << p.x_ << \" \" << p.y_ << \" \" << p.z_ << \")\"; }\n};\nusing Pointcloud = std::vector<point3d>;\nstruct OcTreeKey {\n  key_type k[3] = {0, 0, 0};\n  OcTreeKey() = default;\n  OcTreeKey(key_type a, key_type b, key_type c) { k[0] = a; k[1] = b; k[2] = c; }\n  key_type operator[](int i) const { return k[i]; }\n  key_type & operator[](int i) { return k[i]; }\n  bool operator==(const OcTreeKey & o) const { return k[0]==o.k[0] && k[1]==o.k[1] && k[2]==o.k[2]; }\n  bool operator!=(const OcTreeKey & o) c