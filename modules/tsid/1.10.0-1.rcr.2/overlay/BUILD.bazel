    content = ["/*\n * This file has been automatically generated by the jrl-cmakemodules.\n * Please see https://github.com/jrl-umi3218/jrl-cmakemodules/blob/master/config.hh.cmake for details.\n*/\n\n#ifndef TSID_CONFIG_HH\n# define TSID_CONFIG_HH\n\n// Package version (header).\n# define TSID_VERSION_UNKNOWN_TAG 0 // Used to mention that the current version is unknown.\n# define TSID_VERSION \"1.10.0\"\n# define TSID_MAJOR_VERSION 1\n# define TSID_MINOR_VERSION 10\n# define TSID_PATCH_VERSION 0\n\n#define TSID_VERSION_AT_LEAST(major, minor, patch) (TSID_MAJOR_VERSION>major || (TSID_MAJOR_VERSION>=major && \\\n                                                             (TSID_MINOR_VERSION>minor || (TSID_MINOR_VERSION>=minor && \\\n                                                                                                     TSID_PATCH_VERSION>=patch))))\n\n#define TSID_VERSION_AT_MOST(major, minor, patch) (TSID_MAJOR_VERSION<major || (TSID_MAJOR_VERSION<=major && \\\n                                                            (TSID_MINOR_VERSION<minor || (TSID_MINOR_VERSION<=minor && \\\n                                                                                                     TSID_PATCH_VERSION<=patch))))\n\n// Handle portable symbol export.\n// Defining manually which symbol should be exported is required\n// under Windows whether MinGW or MSVC is used.\n//\n// The headers then have to be able to work in two different modes:\n// - dllexport when one is building the library,\n// - dllimport for clients using the library.\n//\n// On Linux, set the visibility accordingly. If C++ symbol visibility\n// is handled by the compiler, see: http://gcc.gnu.org/wiki/Visibility\n//\n// Explicit template instantiation on Windows need to add\n// dllexport on the definition and dllimport on the declaration.\n// The XXX_EXPLICIT_INSTANTIATION_DECLARATION_DLLAPI macro\n// should be set on the declaration while\n// the XXX_EXPLICIT_INSTANTIATION_DEFINITION_DLLAPI macro\n// should be set on the definition.\n# if defined _WIN32 || defined __CYGWIN__\n// On Microsoft Windows, use dllimport and dllexport to tag symbols.\n#  define TSID_DLLIMPORT __declspec(dllimport)\n#  define TSID_DLLEXPORT __declspec(dllexport)\n#  define TSID_DLLLOCAL\n#  define TSID_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT __declspec(dllimport)\n#  define TSID_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT\n#  define TSID_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT __declspec(dllimport)\n#  define TSID_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT __declspec(dllexport)\n# else\n// On Linux, for GCC >= 4, tag symbols using GCC extension.\n#  if __GNUC__ >= 4\n#   define TSID_DLLIMPORT __attribute__ ((visibility(\"default\")))\n#   define TSID_DLLEXPORT __attribute__ ((visibility(\"default\")))\n#   define TSID_DLLLOCAL  __attribute__ ((visibility(\"hidden\")))\n#   define TSID_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT __attribute__ ((visibility(\"default\")))\n#   define TSID_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT __attribute__ ((visibility(\"default\")))\n#   define TSID_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT\n#   define TSID_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT\n#  else\n// Otherwise (GCC < 4 or another compiler is used), export everything.\n#   define TSID_DLLIMPORT\n#   define TSID_DLLEXPORT\n#   define TSID_DLLLOCAL\n#   define TSID_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT\n#   define TSID_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT\n#   define TSID_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT\n#   define TSID_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT\n#  endif // __GNUC__ >= 4\n# endif // defined _WIN32 || defined __CYGWIN__\n\n# ifdef TSID_STATIC\n// If one is using the library statically, get rid of\n// extra information and use standard explicit template\n// instantiation keyword.\n#  define TSID_DLLAPI\n#  define TSID_LOCAL\n#  define TSID_EXPLICIT_INSTANTIATION_DECLARATION extern template\n# else\n// Depending on whether one is building or using the\n// library define DLLAPI to import or export and\n// define the right explicit template instantiation keyword.\n#  ifdef tsid_EXPORTS\n#   define TSID_DLLAPI TSID_DLLEXPORT\n#   define TSID_EXPLICIT_INSTANTIATION_DECLARATION_DLLAPI TSID_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT\n#   define TSID_EXPLICIT_INSTANTIATION_DEFINITION_DLLAPI TSID_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT\n#  else\n#   define TSID_DLLAPI TSID_DLLIMPORT\n#   define TSID_EXPLICIT_INSTANTIATION_DECLARATION_DLLAPI TSID_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT\n#   define TSID_EXPLICIT_INSTANTIATION_DEFINITION_DLLAPI TSID_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT\n#  endif // TSID_EXPORTS\n#  define TSID_LOCAL TSID_DLLLOCAL\n# endif // TSID_STATIC\n#endif //! TSID_CONFIG_HH\n"],
