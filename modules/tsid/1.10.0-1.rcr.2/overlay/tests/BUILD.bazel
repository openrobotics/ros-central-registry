cc_test(
    name = "constraints",
    srcs = ["constraints.cpp"] + [] + [
        "//:jrl_headers",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        "//:ament_index",
        "//:tsid_pywrap.cpython-314-x86_64-linux-gnu",
    ] + [
        "CMakeLists.txt",
        "python/CMakeLists.txt",
        "python/generator.py",
        "python/test_Constraint.py",
        "python/test_Contact.py",
        "python/test_ContactPoint.py",
        "python/test_Deprecations.py",
        "python/test_Formulation.py",
        "python/test_Gravity.py",
        "python/test_Measured6DWrench.py",
        "python/test_RobotWrapper.py",
        "python/test_Solvers.py",
        "python/test_Tasks.py",
        "python/test_Trajectories.py",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines() + [
        "COAL_HAS_OCTOMAP",
        "COAL_HAVE_OCTOMAP",
        "EIGEN_RUNTIME_NO_MALLOC",
        "OCTOMAP_MAJOR_VERSION=1",
        "OCTOMAP_MINOR_VERSION=10",
        "OCTOMAP_PATCH_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_MAJOR_VERSION=3",
        "PINOCCHIO_URDFDOM_HEADERS_MINOR_VERSION=0",
        "PINOCCHIO_URDFDOM_HEADERS_PATCH_VERSION=0",
        "PINOCCHIO_WITH_COLLISION",
        "PINOCCHIO_WITH_HPP_FCL",
        "PINOCCHIO_WITH_URDFDOM",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:tsid_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

