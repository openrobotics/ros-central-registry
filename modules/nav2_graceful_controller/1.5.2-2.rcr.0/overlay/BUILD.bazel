CC_DEPS = [
    "@angles//:angles",
    "@nav2_core//:nav2_core_library",
    "@nav2_ros_common//:nav2_ros_common",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "smooth_control_law_library",
    srcs = ["src/smooth_control_law.cpp"],
    hdrs = [
        "include/nav2_graceful_controller/ego_polar_coords.hpp",
        "include/nav2_graceful_controller/graceful_controller.hpp",
        "include/nav2_graceful_controller/parameter_handler.hpp",
        "include/nav2_graceful_controller/smooth_control_law.hpp",
        "include/nav2_graceful_controller/utils.hpp",
    ],
    includes = [
        "include",
        "include/nav2_graceful_controller",
        "test",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "smooth_control_law",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":smooth_control_law_library"],
)

cc_library(
    name = "nav2_graceful_controller_library",
    srcs = [
        "src/graceful_controller.cpp",
        "src/parameter_handler.cpp",
        "src/utils.cpp",
    ],
    hdrs = [
        "include/nav2_graceful_controller/ego_polar_coords.hpp",
        "include/nav2_graceful_controller/graceful_controller.hpp",
        "include/nav2_graceful_controller/parameter_handler.hpp",
        "include/nav2_graceful_controller/smooth_control_law.hpp",
        "include/nav2_graceful_controller/utils.hpp",
    ],
    includes = [
        "include",
        "include/nav2_graceful_controller",
        "test",
    ],
    local_defines = ros_local_defines() + [
        'BTCPP_LIBRARY_VERSION=\\"4.10.0\\"',
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":smooth_control_law_library"],
)

cc_shared_library(
    name = "nav2_graceful_controller",
    dynamic_deps = DEPENDENCIES.keys() + [":smooth_control_law"],
    exports_filter = ["//:__subpackages__"],
    deps = [":nav2_graceful_controller_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":smooth_control_law",
        ":nav2_graceful_controller",
    ],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":smooth_control_law",
        ":nav2_graceful_controller",
    ],
    package_xml = "package.xml",
    plugin_category = "nav2_core",
