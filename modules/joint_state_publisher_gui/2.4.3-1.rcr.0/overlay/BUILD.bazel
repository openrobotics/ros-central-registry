load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "joint_state_publisher_gui",
    srcs = [
        "joint_state_publisher_gui/__init__.py",
        "joint_state_publisher_gui/flow_layout.py",
        "joint_state_publisher_gui/joint_state_publisher_gui.py",
    ],
    imports = ["."],
    deps = [
        "@joint_state_publisher",
        "@python_qt_binding",
        "@rclpy",
    ],
)

### PACKAGING

write_file(
    name = "joint_state_publisher_gui_bin",
    out = "_gen/lib/joint_state_publisher_gui/joint_state_publisher_gui",
    content = [
        "#!/usr/bin/env python3",
        "import sys",
        "from joint_state_publisher_gui.joint_state_publisher_gui import main",
        "if __name__ == '__main__':",
        "    sys.exit(main())",
        "",
    ],
    is_executable = True,
)

ament_index(
    name = "ament_index",
    lib_data = [":joint_state_publisher_gui_bin"],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    console_scripts = {"joint_state_publisher_gui": "joint_state_publisher_gui.joint_state_publisher_gui:main"},
    executables = ["resource/joint_state_publisher_gui"],
    package_xml = "package.xml",
    python = [":joint_state_publisher_gui"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@joint_state_publisher//:ament_package",
        "@python_qt_binding//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
