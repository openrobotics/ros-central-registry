load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "joint_state_publisher_gui_lib",
    srcs = [
        "joint_state_publisher_gui/__init__.py",
        "joint_state_publisher_gui/flow_layout.py",
        "joint_state_publisher_gui/joint_state_publisher_gui.py",
    ],
    data = [":ament_index"],
    imports = ["."],
    deps = [
        "@joint_state_publisher//:joint_state_publisher_lib",
        "@python_qt_binding",
        "@rclpy",
    ],
)

py_binary(
    name = "lib/joint_state_publisher_gui",
    srcs = ["joint_state_publisher_gui/joint_state_publisher_gui.py"],
    main = "joint_state_publisher_gui/joint_state_publisher_gui.py",
    deps = [":joint_state_publisher_gui_lib"],
)

alias(
    name = "joint_state_publisher_gui",
    actual = ":lib/joint_state_publisher_gui",
)

### PACKAGING

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    console_scripts = {"joint_state_publisher_gui": "joint_state_publisher_gui.joint_state_publisher_gui:main"},
    package_xml = "package.xml",
    python = [":joint_state_publisher_gui_lib"],
    setup_cfg = "setup.cfg",
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@joint_state_publisher//:ament_package",
        "@python_qt_binding//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
