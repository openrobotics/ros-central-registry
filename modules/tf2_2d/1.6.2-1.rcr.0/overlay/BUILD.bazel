load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

cc_library(
    name = "tf2_2d",
    hdrs = [
        "include/tf2_2d/rotation.h",
        "include/tf2_2d/rotation.hpp",
        "include/tf2_2d/rotation_impl.hpp",
        "include/tf2_2d/tf2_2d.h",
        "include/tf2_2d/tf2_2d.hpp",
        "include/tf2_2d/transform.h",
        "include/tf2_2d/transform.hpp",
        "include/tf2_2d/transform_impl.hpp",
        "include/tf2_2d/vector2.h",
        "include/tf2_2d/vector2.hpp",
        "include/tf2_2d/vector2_impl.hpp",
    ],
    includes = ["include"],
    deps = [
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:boost.array",
        "@rosdistro//cc:eigen",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
    ],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "Boost",
        "Eigen3",
    ],
    cmake_export_include_directories = False,
    cmake_export_name = "tf2_2d-export",
    headers = [
        "include/tf2_2d/rotation.h",
        "include/tf2_2d/rotation.hpp",
        "include/tf2_2d/rotation_impl.hpp",
        "include/tf2_2d/tf2_2d.h",
        "include/tf2_2d/tf2_2d.hpp",
        "include/tf2_2d/transform.h",
        "include/tf2_2d/transform.hpp",
        "include/tf2_2d/transform_impl.hpp",
        "include/tf2_2d/vector2.h",
        "include/tf2_2d/vector2.hpp",
        "include/tf2_2d/vector2_impl.hpp",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
