load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

cc_library(
    name = "tf2_2d",
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.hpp",
    ]),
    includes = ["include"],
    deps = [
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:boost.array",
        "@rosdistro//cc:eigen",
        "@tf2//:tf2_library",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
        "@tf2_ros//:tf2_ros_library",
    ],
)

[
    cc_test(
        name = t,
        srcs = ["test/" + t + ".cpp"],
        deps = [
            ":tf2_2d",
            "@rosdistro//cc:googletest",
        ],
    )
    for t in [
        "test_conversions",
        "test_rotation",
        "test_transform",
        "test_vector2",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "Boost",
        "Eigen3",
    ],
    cmake_export_include_directories = False,
    cmake_export_name = "tf2_2d-export",
    headers = glob([
        "include/**/*.h",
        "include/**/*.hpp",
    ]),
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
