load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "open_manipulator_teleop",
    srcs = glob(["open_manipulator_teleop/**/*.py"]),
    imports = ["."],
    deps = [
        "@control_msgs//:py",
        "@rclpy",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        "@trajectory_msgs//:py",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "omx_f_teleop": "open_manipulator_teleop.omx_f_teleop:main",
        "omy_3m_teleop": "open_manipulator_teleop.omy_3m_teleop:main",
        "omy_f3m_teleop": "open_manipulator_teleop.omy_f3m_teleop:main",
        "open_manipulator_x_teleop": "open_manipulator_teleop.open_manipulator_x_teleop:main",
    },
    package_xml = "package.xml",
    python = [":open_manipulator_teleop"],
    deps = [
        "@control_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@trajectory_msgs//:ament_package",
    ],
)
