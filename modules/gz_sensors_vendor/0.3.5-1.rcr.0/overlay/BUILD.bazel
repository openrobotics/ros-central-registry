# gz_sensors_vendor: vendors gz-sensors (version 10) from the Bazel Central
# Registry module `gz-sensors` (shared library wrappers live in
# @rosdistro//cc/gz) and installs it like colcon's ament_vendor() does
# (opt/gz_sensors_vendor/...). Upstream builds one shared library per sensor
# type; here all sensor components are bundled in libgz-sensors-all.so next
# to the core libgz-sensors.so.

load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc/gz:defs.bzl", "gz_install_files", "gz_install_headers", "gz_vendor_hooks")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES (gz-sensors::core and all sensor components)

[
    (
        alias(
            name = name,
            actual = "@rosdistro//cc/gz:" + target,
        ),
        alias(
            name = name + "_library",
            actual = "@rosdistro//cc/gz:" + target + "_library",
        ),
    )
    for name, target in [
        ("gz_sensors", "gz-sensors"),
        ("gz_sensors_all", "gz-sensors-all"),
    ]
]

### INSTALL LAYOUT (opt/gz_sensors_vendor/...)

VENDOR = "gz_sensors_vendor"

PREFIX = "opt/" + VENDOR

gz_install_headers(
    name = "install_headers",
    include_only = "gz/sensors",
    prefix = PREFIX + "/include/gz/sensors10",
    deps = [
        ":gz_sensors_all_library",
        ":gz_sensors_library",
    ],
)

gz_install_files(
    name = "install_libraries",
    srcs = [
        ":gz_sensors",
        ":gz_sensors_all",
    ],
    flatten = True,
    prefix = PREFIX + "/lib",
)

ENV_HOOKS = gz_vendor_hooks(
    name = "install_hooks",
    pythonpath = False,
    vendor = VENDOR,
)

### PACKAGING

ament_package(
    name = "ament_package",
    env_hooks = ENV_HOOKS,
    install = [
        ":install_headers",
        ":install_hooks",
        ":install_libraries",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_test//:ament_package",
        "@ament_cmake_vendor_package//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@gz_cmake_vendor//:ament_package",
        "@gz_common_vendor//:ament_package",
        "@gz_math_vendor//:ament_package",
        "@gz_msgs_vendor//:ament_package",
        "@gz_rendering_vendor//:ament_package",
        "@gz_tools_vendor//:ament_package",
        "@gz_transport_vendor//:ament_package",
        "@rosdistro//:ament_package",
        "@sdformat_vendor//:ament_package",
    ],
)
