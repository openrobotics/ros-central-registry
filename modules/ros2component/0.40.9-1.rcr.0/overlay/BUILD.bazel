load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

py_library(
    name = "ros2component",
    srcs = [
        "ros2component/__init__.py",
        "ros2component/api/__init__.py",
        "ros2component/command/__init__.py",
        "ros2component/command/component.py",
        "ros2component/verb/__init__.py",
        "ros2component/verb/list.py",
        "ros2component/verb/load.py",
        "ros2component/verb/standalone.py",
        "ros2component/verb/types.py",
        "ros2component/verb/unload.py",
    ],
    data = ["ros2component/py.typed"] + [":ament_index"],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@composition_interfaces//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@ros2cli",
        "@ros2node",
        "@ros2pkg",
    ],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "package.xml",
        "resource/ros2component",
        "ros2component/__init__.py",
        "ros2component/api/__init__.py",
        "ros2component/command/__init__.py",
        "ros2component/command/component.py",
        "ros2component/py.typed",
        "ros2component/verb/__init__.py",
        "ros2component/verb/list.py",
        "ros2component/verb/load.py",
        "ros2component/verb/standalone.py",
        "ros2component/verb/types.py",
        "ros2component/verb/unload.py",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
    "xmllint",
]]

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":ros2component"] + ["ros2component/py.typed"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@composition_interfaces//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclpy//:ament_package",
        "@ros2cli//:ament_package",
        "@ros2node//:ament_package",
        "@ros2param//:ament_package",
        "@ros2pkg//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
