write_file(
    name = "gen_uuid_h",
    out = "_gen/include/uuid/uuid.h",
    content = ["#ifndef RCR_UUID_UUID_H_\n#define RCR_UUID_UUID_H_\n#include <cstdio>\n#include <cstring>\n#include <random>\nusing uuid_t = unsigned char[16];\ninline void uuid_generate(unsigned char * out) {\n  std::random_device rd;\n  for (int i = 0; i < 16; ++i) out[i] = static_cast<unsigned char>(rd() & 0xFF);\n  out[6] = static_cast<unsigned char>((out[6] & 0x0F) | 0x40);\n  out[8] = static_cast<unsigned char>((out[8] & 0x3F) | 0x80);\n}\ninline void uuid_unparse(const unsigned char * uu, char * out) {\n  std::snprintf(out, 37, \"%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x\",\n    uu[0], uu[1], uu[2], uu[3], uu[4], uu[5], uu[6], uu[7],\n    uu[8], uu[9], uu[10], uu[11], uu[12], uu[13], uu[14], uu[15]);\n}\ninline void uuid_unparse_lower(const unsigned char * uu, char * out) { uuid_unparse(uu, out); }\ninline int uuid_parse(const char * in, unsigned char * uu) {\n  if (!in || std::strlen(in) != 36) return -1;\n  int v[16];\n  if (std::sscanf(in, \"%2x%2x%2x%2x-%2x%2x-%2x%2x-%2x%2x-%2x%2x%2x%2x%2x%2x\",\n    &v[0], &v[1], &v[2], &v[3], &v[4], &v[5], &v[6], &v[7],\n    &v[8], &v[9], &v[10], &v[11], &v[12], &v[13], &v[14], &v[15]) != 16) return -1;\n  for (int i = 0; i < 16; ++i) uu[i] = static_cast<unsigned char>(v[i]);\n  return 0;\n}\ninline int uuid_compare(const unsigned char * uu1, const unsigned char * uu2) { return std::memcmp(uu1, uu2, 16); }\ninline int uuid_is_null(const unsigned char * uu) {\n  for (int i = 0; i < 16; ++i) if (uu[i] != 0) return 0;\n  return 1;\n}\ninline void uuid_clear(unsigned char * uu) { std::memset(uu, 0, 16); }\ninline void uuid_copy(unsigned char * dst, const unsigned char * src) { std::memcpy(dst, src, 16); }\n#endif\n"],
)

write_file(
    name = "gen_proj_h",
    out = "_gen/include/proj.h",
    content = ["#ifndef RCR_PROJ_H_\n#define RCR_PROJ_H_\nstruct PJ_OBS {};\nusing PJ = PJ_OBS;\nusing PJ_CONTEXT = void;\n#define PJ_DEFAULT_CTX nullptr\nenum PJ_DIRECTION { PJ_FWD = 1, PJ_IDENT = 0, PJ_INV = -1 };\nstruct PJ_ENU { double e; double n; double u; };\nstruct PJ_LP { double lam; double phi; };\nstruct PJ_XY { double x; double y; };\nunion PJ_COORD {\n  double v[4];\n  PJ_ENU enu;\n  PJ_LP lp;\n  PJ_XY xy;\n};\ninline PJ_CONTEXT * proj_context_create() { return nullptr; }\ninline PJ_CONTEXT * proj_context_destroy(PJ_CONTEXT *) { return nullptr; }\ninline PJ_COORD proj_coord(double x, double y, double z, double t) {\n  PJ_COORD c;\n  c.v[0] = x; c.v[1] = y; c.v[2] = z; c.v[3] = t;\n  return c;\n}\ninline PJ * proj_create_crs_to_crs(PJ_CONTEXT *, const char *, const char *, void *) {\n  static PJ dummy;\n  return &dummy;\n}\ninline PJ * proj_normalize_for_visualization(PJ_CONTEXT *, const PJ * p) {\n  return const_cast<PJ *>(p);\n}\ninline PJ * proj_destroy(PJ *) { return nullptr; }\ninline PJ_COORD proj_trans(PJ *, PJ_DIRECTION, PJ_COORD coord) { return coord; }\n#endif\n"],
)

