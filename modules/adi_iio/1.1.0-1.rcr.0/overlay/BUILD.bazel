load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp": "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@std_msgs//:cc",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "adi_iio_node",
    srcs = [":gen_adi_iio_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "_gen/include/adi_iio",
        "_gen/include/adi_iio/adi_iio",
        "include",
        "include/adi_iio",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":cc",
    ],
)

write_file(
    name = "gen_adi_iio_stub_cpp",
    out = "_gen/adi_iio_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

default_generators(
    package_xml = "package.xml",
    deps = [
        "//srv:AttrDisableTopic",
        "//srv:AttrEnableTopic",
        "//srv:AttrReadString",
        "//srv:AttrWriteString",
        "//srv:BufferCreate",
        "//srv:BufferDestroy",
        "//srv:BufferDisableTopic",
        "//srv:BufferEnableTopic",
        "//srv:BufferRead",
        "//srv:BufferRefill",
        "//srv:BufferWrite",
        "//srv:ListAttributes",
        "//srv:ListChannels",
        "//srv:ListDevices",
        "//srv:ScanContext",
    ],
)

ament_index(
    name = "ament_index_extra",
    data = [
        "config/adi_iio.yaml",
        "launch/adi_iio_bringup.launch.py",
        "launch/visualize_iio_waveform.py",
    ],
    export_name = "adi_iio",
    lib_data = [":adi_iio_node"],
    libraries = [
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ament_pep257//:ament_package",
        "@launch//:ament_package",
        "@launch_pytest//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@ros2launch//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

rosidl_ament_package(
    cmake_export_dependencies_list = [
        "std_msgs",
