load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libiio": "@rosdistro//cc:libiio_library",
    "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp": "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@std_msgs//:cc",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "adi_iio_node",
    srcs = [
        "include/adi_iio/attr_publisher.hpp",
        "include/adi_iio/iio_attr_topic.hpp",
        "include/adi_iio/iio_buffer.hpp",
        "include/adi_iio/iio_node.hpp",
        "include/adi_iio/iio_path.hpp",
        "src/adi_iio.cpp",
        "src/attr_publisher.cpp",
        "src/iio_attr_topic.cpp",
        "src/iio_buffer.cpp",
        "src/iio_node.cpp",
        "src/iio_path.cpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "_gen/include/adi_iio",
        "_gen/include/adi_iio/adi_iio",
        "include",
        "include/adi_iio",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":cc"],
)

default_generators(
    package_xml = "package.xml",
    deps = [
        "//srv:AttrDisableTopic",
        "//srv:AttrEnableTopic",
        "//srv:AttrReadString",
        "//srv:AttrWriteString",
        "//srv:BufferCreate",
        "//srv:BufferDestroy",
        "//srv:BufferDisableTopic",
        "//srv:BufferEnableTopic",
        "//srv:BufferRead",
        "//srv:BufferRefill",
        "//srv:BufferWrite",
        "//srv:ListAttributes",
        "//srv:ListChannels",
        "//srv:ListDevices",
        "//srv:ScanContext",
    ],
)

ament_index(
    name = "ament_index_extra",
    data = [
        "config/adi_iio.yaml",
        "//launch:launch_files",
    ],
    export_name = "adi_iio",
    lib_data = [":adi_iio_node"],
    libraries = [],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ament_pep257//:ament_package",
        "@launch//:ament_package",
        "@launch_pytest//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@ros2launch//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

rosidl_ament_package(
    cmake_export_dependencies_list = [
        "fastcdr",
        "rcutils",
        "rmw",
        "rosidl_default_runtime",
        "rosidl_runtime_c",
        "rosidl_runtime_cpp",
        "rosidl_typesupport_c",
        "rosidl_typesupport_cpp",
        "rosidl_typesupport_fastrtps_c",
        "rosidl_typesupport_fastrtps_cpp",
        "rosidl_typesupport_interface",
        "service_msgs",
        "std_msgs",
    ],
    install = [],
    libraries = [],
    package_xml = "package.xml",
    deps = [":ament_index_extra"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ament_pep257//:ament_package",
        "@launch//:ament_package",
        "@launch_pytest//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@ros2launch//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
