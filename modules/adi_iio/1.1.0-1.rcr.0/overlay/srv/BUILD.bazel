load("@rosidl_default_generators//:defs.bzl", "ros_service")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

exports_files([
    "AttrDisableTopic.srv",
    "AttrEnableTopic.srv",
    "AttrReadString.srv",
    "AttrWriteString.srv",
    "BufferCreate.srv",
    "BufferDestroy.srv",
    "BufferDisableTopic.srv",
    "BufferEnableTopic.srv",
    "BufferRead.srv",
    "BufferRefill.srv",
    "BufferWrite.srv",
    "ListAttributes.srv",
    "ListChannels.srv",
    "ListDevices.srv",
    "ScanContext.srv",
])

ros_service(
    name = "AttrDisableTopic",
    src = "AttrDisableTopic.srv",
)

ros_service(
    name = "AttrEnableTopic",
    src = "AttrEnableTopic.srv",
)

ros_service(
    name = "AttrReadString",
    src = "AttrReadString.srv",
)

ros_service(
    name = "AttrWriteString",
    src = "AttrWriteString.srv",
)

ros_service(
    name = "BufferCreate",
    src = "BufferCreate.srv",
    deps = [
        "@std_msgs//msg:MultiArrayLayout",
    ],
)

ros_service(
    name = "BufferDestroy",
    src = "BufferDestroy.srv",
)

ros_service(
    name = "BufferDisableTopic",
    src = "BufferDisableTopic.srv",
)

ros_service(
    name = "BufferEnableTopic",
    src = "BufferEnableTopic.srv",
)

ros_service(
    name = "BufferRead",
    src = "BufferRead.srv",
    deps = [
        "@std_msgs//msg:Int32MultiArray",
    ],
)

ros_service(
    name = "BufferRefill",
    src = "BufferRefill.srv",
    deps = [
        "@std_msgs//msg:Int32MultiArray",
    ],
)

ros_service(
    name = "BufferWrite",
    src = "BufferWrite.srv",
    deps = [
        "@std_msgs//msg:Int32MultiArray",
    ],
)

ros_service(
    name = "ListAttributes",
    src = "ListAttributes.srv",
)

ros_service(
    name = "ListChannels",
    src = "ListChannels.srv",
)

ros_service(
    name = "ListDevices",
    src = "ListDevices.srv",
)

ros_service(
    name = "ScanContext",
    src = "ScanContext.srv",
)
