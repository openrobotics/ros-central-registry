load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = glob(["launch/**"]),
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@launch_xml//:ament_package",
        "@rmf_building_sim_gz_plugins//:ament_package",
        "@rmf_demos//:ament_package",
        "@rmf_robot_sim_gz_plugins//:ament_package",
        "@ros2launch//:ament_package",
        "@ros_gz_bridge//:ament_package",
        "@ros_gz_sim//:ament_package",
        "@rosdistro//:ament_package",
        "@teleop_twist_keyboard//:ament_package",
    ],
)
