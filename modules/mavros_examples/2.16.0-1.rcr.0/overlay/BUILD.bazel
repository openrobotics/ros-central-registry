load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
)

py_library(
    name = "mavros_examples",
    srcs = [
        "mavros_examples/__init__.py",
        "mavros_examples/flight_task_control.py",
        "mavros_examples/px4_offboard.py",
        "mavros_examples/waypoint_mission_manager.py",
    ],
    imports = ["."],
)

pkg_files(
    name = "renamed_programs",
    srcs = [
        "mavros_examples/flight_task_control.py",
        "mavros_examples/waypoint_mission_manager.py",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "lib/mavros_examples",
    renames = {
        "mavros_examples/flight_task_control.py": "flight_task_control",
        "mavros_examples/waypoint_mission_manager.py": "waypoint_mission_manager",
    },
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    install = [
        ":renamed_programs",
    ],
    package_xml = "package.xml",
    python = [":mavros_examples"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mavros//:ament_package",
        "@mavros_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@trajectory_msgs//:ament_package",
    ],
)
