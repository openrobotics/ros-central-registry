load("@rosidl_default_generators//:defs.bzl", "ros_action")

package(default_visibility = ["//visibility:public"])

ros_action(
    name = "SelfPresentation",
    src = "SelfPresentation.action",
)

ros_action(
    name = "ApplicationControl",
    src = "ApplicationControl.action",
)

ros_action(
    name = "LookAt",
    src = "LookAt.action",
    deps = [
        "@geometry_msgs//msg:PointStamped",
    ],
)

ros_action(
    name = "PointTrajectory",
    src = "PointTrajectory.action",
    deps = [
        "@builtin_interfaces//msg:Duration",
        "@geometry_msgs//msg:Point",
        "@std_msgs//msg:Header",
    ],
)

ros_action(
    name = "FaceOverlay",
    src = "FaceOverlay.action",
)
