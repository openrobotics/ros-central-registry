load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rosdistro//cc:boost.filesystem_shared": "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.iostreams_shared": "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:lz4": "@rosdistro//cc:lz4_library",
    "@rosdistro//cc:pcl": "@rosdistro//cc:pcl_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
    "@rosdistro//cc:zstd": "@rosdistro//cc:zstd_library",
}

CC_DEPS = [
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:eigen",
]

cc_test(
    name = "test_cloudini",
    srcs = [
        "test_field_encoders.cpp",
        "test_header.cpp",
        "test_intrinsics.cpp",
        "test_pcl.cpp",
        "test_ros_msg.cpp",
        "test_v6.cpp",
        "//:gen_data_path_hpp",
    ],
    data = ["//:ament_index"] + ([
        "CMakeLists.txt",
        "install/CMakeLists.txt",
        "subproject/CMakeLists.txt",
    ] + ["//:_test_data_0"]),
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:cloudini_lib_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)
