    name = "gen_cmake_1",
    out = "_gen/share/cloudini_lib/cmake/cloudini_libTargetsExport-release.cmake",
    content = ["#----------------------------------------------------------------\n# Generated CMake target import file for configuration \"Release\".\n#----------------------------------------------------------------\n\n# Commands may need to know the format version.\nset(CMAKE_IMPORT_FILE_VERSION 1)\n\n# Import target \"cloudini_lib::cloudini_lib\" for configuration \"Release\"\nset_property(TARGET cloudini_lib::cloudini_lib APPEND PROPERTY IMPORTED_CONFIGURATIONS RELEASE)\nset_target_properties(cloudini_lib::cloudini_lib PROPERTIES\n  IMPORTED_LINK_DEPENDENT_LIBRARIES_RELEASE \"LZ4::lz4_shared;zstd::libzstd_shared\"\n  IMPORTED_LOCATION_RELEASE \"${_IMPORT_PREFIX}/lib/libcloudini_lib.so\"\n  IMPORTED_SONAME_RELEASE \"libcloudini_lib.so\"\n  )\n\nlist(APPEND _cmake_import_check_targets cloudini_lib::cloudini_lib )\nlist(APPEND _cmake_import_check_files_for_cloudini_lib::cloudini_lib \"${_IMPORT_PREFIX}/lib/libcloudini_lib.so\" )\n\n# Commands beyond this point should not need to know the version.\nset(CMAKE_IMPORT_FILE_VERSION)\n"],
)

