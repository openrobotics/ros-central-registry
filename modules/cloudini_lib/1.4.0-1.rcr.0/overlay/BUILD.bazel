load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

filegroup(
    name = "_test_data_0",
    srcs = [
        "samples/dds_message.bin",
        "samples/lidar.pcd",
    ],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/cloudini_lib/basic_types.hpp",
        "include/cloudini_lib/cloudini.hpp",
        "include/cloudini_lib/contrib/ankerl/stl.h",
        "include/cloudini_lib/contrib/ankerl/unordered_dense.h",
        "include/cloudini_lib/contrib/nanocdr.hpp",
        "include/cloudini_lib/contrib/span.hpp",
        "include/cloudini_lib/encoding_utils.hpp",
        "include/cloudini_lib/field_decoder.hpp",
        "include/cloudini_lib/field_encoder.hpp",
        "include/cloudini_lib/intrinsics.hpp",
        "include/cloudini_lib/pcl_conversion.hpp",
        "include/cloudini_lib/ros_message_definitions.hpp",
        "include/cloudini_lib/ros_msg_utils.hpp",
        "include/cloudini_lib/wasm_functions.h",
        "include/cloudini_lib/yaml_parser.hpp",
        "src/chunk_writer.hpp",
        "src/codec_common.hpp",
        "src/v4_codec.hpp",
        "src/v5_codec.hpp",
        "src/v6_codec.hpp",
        "tools/include/mcap_converter.hpp",
        "tools/qt_app/bytearray_writable.hpp",
        "tools/qt_app/mainwindow.h",
    ] + [":gen_data_path_hpp"],
    includes = ["_gen/include"],
)

DEPENDENCIES = {
    "@rosdistro//cc:boost.filesystem_shared": "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.iostreams_shared": "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:lz4": "@rosdistro//cc:lz4_library",
    "@rosdistro//cc:pcl": "@rosdistro//cc:pcl_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
    "@rosdistro//cc:zstd": "@rosdistro//cc:zstd_library",
}

CC_DEPS = [
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "cloudini_lib_library",
    srcs = [
        "src/chunk_writer.cpp",
        "src/cloudini.cpp",
        "src/codec_common.cpp",
        "src/field_decoder.cpp",
        "src/field_encoder.cpp",
        "src/pcl_conversion.cpp",
        "src/ros_msg_utils.cpp",
        "src/v4_codec.cpp",
        "src/v5_codec.cpp",
        "src/v6_codec.cpp",
    ],
    hdrs = [
        "include/cloudini_lib/basic_types.hpp",
        "include/cloudini_lib/cloudini.hpp",
        "include/cloudini_lib/contrib/ankerl/stl.h",
        "include/cloudini_lib/contrib/ankerl/unordered_dense.h",
        "include/cloudini_lib/contrib/nanocdr.hpp",
        "include/cloudini_lib/contrib/span.hpp",
        "include/cloudini_lib/encoding_utils.hpp",
        "include/cloudini_lib/field_decoder.hpp",
        "include/cloudini_lib/field_encoder.hpp",
        "include/cloudini_lib/intrinsics.hpp",
        "include/cloudini_lib/pcl_conversion.hpp",
        "include/cloudini_lib/ros_message_definitions.hpp",
        "include/cloudini_lib/ros_msg_utils.hpp",
        "include/cloudini_lib/wasm_functions.h",
        "include/cloudini_lib/yaml_parser.hpp",
        "src/chunk_writer.hpp",
        "src/codec_common.hpp",
        "src/v4_codec.hpp",
        "src/v5_codec.hpp",
        "src/v6_codec.hpp",
        "tools/include/mcap_converter.hpp",
        "tools/qt_app/bytearray_writable.hpp",
        "tools/qt_app/mainwindow.h",
    ],
    includes = [
        "include",
        "include/cloudini_lib",
        "test",
    ],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "cloudini_lib",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":cloudini_lib_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":cloudini_lib"],
)

ament_index(
    name = "ament_index",
    libraries = [":cloudini_lib"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
    ],
)

expand_template(
    name = "gen_data_path_hpp",
    out = "_gen/include/data_path.hpp",
    substitutions = {
        "@DATA_PATH@": "samples",
    },
    template = "data_path.hpp.in",
)

ament_package(
    cmake_export_dependencies_list = [
        "PCL",
        "Threads",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/cloudini_lib/basic_types.hpp",
        "include/cloudini_lib/cloudini.hpp",
        "include/cloudini_lib/contrib/ankerl/stl.h",
        "include/cloudini_lib/contrib/ankerl/unordered_dense.h",
        "include/cloudini_lib/contrib/nanocdr.hpp",
        "include/cloudini_lib/contrib/span.hpp",
        "include/cloudini_lib/encoding_utils.hpp",
        "include/cloudini_lib/field_decoder.hpp",
        "include/cloudini_lib/field_encoder.hpp",
        "include/cloudini_lib/intrinsics.hpp",
        "include/cloudini_lib/pcl_conversion.hpp",
        "include/cloudini_lib/ros_message_definitions.hpp",
        "include/cloudini_lib/ros_msg_utils.hpp",
        "include/cloudini_lib/wasm_functions.h",
        "include/cloudini_lib/yaml_parser.hpp",
    ],
    include_prefix = "",
    libraries = [":cloudini_lib"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
    ],
)
