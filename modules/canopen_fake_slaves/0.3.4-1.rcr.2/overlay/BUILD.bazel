load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@lely_core_libraries//:lely-can": "@lely_core_libraries//:lely-can_library",
    "@lely_core_libraries//:lely-co": "@lely_core_libraries//:lely-co_library",
    "@lely_core_libraries//:lely-coapp": "@lely_core_libraries//:lely-coapp_library",
    "@lely_core_libraries//:lely-ev": "@lely_core_libraries//:lely-ev_library",
    "@lely_core_libraries//:lely-io2": "@lely_core_libraries//:lely-io2_library",
    "@lely_core_libraries//:lely-libc": "@lely_core_libraries//:lely-libc_library",
    "@lely_core_libraries//:lely-tap": "@lely_core_libraries//:lely-tap_library",
    "@lely_core_libraries//:lely-util": "@lely_core_libraries//:lely-util_library",
    "@lifecycle_msgs//:cc_shared": "@lifecycle_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "motion_generator_library",
    srcs = ["src/motion_generator.cpp"],
    hdrs = [
        "include/canopen_fake_slaves/base_slave.hpp",
        "include/canopen_fake_slaves/basic_slave.hpp",
        "include/canopen_fake_slaves/cia402_slave.hpp",
        "include/canopen_fake_slaves/motion_generator.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/canopen_fake_slaves",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "motion_generator",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":motion_generator_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":motion_generator"],
)

cc_binary(
    name = "basic_slave_node",
    srcs = ["src/basic_slave.cpp"] + [
        "include/canopen_fake_slaves/base_slave.hpp",
        "include/canopen_fake_slaves/basic_slave.hpp",
        "include/canopen_fake_slaves/cia402_slave.hpp",
        "include/canopen_fake_slaves/motion_generator.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/canopen_fake_slaves",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "cia402_slave_node",
    srcs = ["src/cia402_slave.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/canopen_fake_slaves",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":motion_generator_library"],
)

ament_index(
    name = "ament_index",
    data = [
        "config/cia402_slave.eds",
        "config/simple_slave.eds",
        "//launch:launch_files",
    ],
    lib_data = [
        ":basic_slave_node",
        ":cia402_slave_node",
        ":motion_generator",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@lely_core_libraries//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "lely_core_libraries",
        "lifecycle_msgs",
        "rclcpp",
        "rclcpp_lifecycle",
    ],
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/canopen_fake_slaves/base_slave.hpp",
        "include/canopen_fake_slaves/basic_slave.hpp",
        "include/canopen_fake_slaves/cia402_slave.hpp",
        "include/canopen_fake_slaves/motion_generator.hpp",
    ],
    include_prefix = "",
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@lely_core_libraries//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
    ],
)
