load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:LGPL-2.1-only",
    ],
)

cc_library(
    name = "tlsf",
    srcs = [
        "src/target.h",
        "src/tlsf.c",
    ],
    hdrs = ["include/tlsf/tlsf.h"],
    includes = [
        "include",
        "include/tlsf",
    ],
)

genrule(
    name = "tlsf_static",
    srcs = [":tlsf"],
    outs = ["static/libtlsf.a"],
    cmd = "for f in $(SRCS); do case $$f in *.a) cp $$f $@ ;; esac; done",
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_tlsf",
    headers = ["include/tlsf/tlsf.h"],
    libraries = [":tlsf_static"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
