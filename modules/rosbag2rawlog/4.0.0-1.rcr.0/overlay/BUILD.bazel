load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@@std_msgs+//:cc",
    "@mrpt_containers//:mrpt_containers_library",
    "@mrpt_libros_bridge//:mrpt_libros_bridge_library",
    "@mrpt_maps//:mrpt_maps_library",
    "@mrpt_msgs//:cc",
    "@nav_msgs//:cc",
    "@sensor_msgs//:cc",
    "@tf2_msgs//:cc",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "rosbag2rawlog",
    srcs = [":gen_rosbag2rawlog_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines() + [
        "CV_BRIDGE_VERSION=0x040100",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

write_file(
    name = "gen_rosbag2rawlog_stub_cpp",
    out = "_gen/rosbag2rawlog_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@cv_bridge//:ament_package",
        "@mrpt_containers//:ament_package",
        "@mrpt_libros_bridge//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    programs = [":rosbag2rawlog"],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@cv_bridge//:ament_package",
        "@mrpt_containers//:ament_package",
        "@mrpt_libros_bridge//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
