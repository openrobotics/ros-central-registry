load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@kdl_parser//:kdl_parser": "@kdl_parser//:kdl_parser_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:fcl_shared": "@rosdistro//cc:fcl_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@urdf//:urdf": "@urdf//:urdf_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
    "@visualization_msgs//:cc",
]

cc_library(
    name = "open_manipulator_collision_library",
    hdrs = ["include/open_manipulator_collision/self_collision_node.hpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/open_manipulator_collision",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "self_collision_node",
    srcs = [
        "include/open_manipulator_collision/self_collision_node.hpp",
        "src/self_collision_node.cpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/open_manipulator_collision",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

ament_index(
    name = "ament_index",
    data = ["//launch:launch_files"],
    data_strip_prefix = "launch",
    lib_data = [":self_collision_node"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@kdl_parser//:ament_package",
        "@rclcpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@urdf//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "kdl_parser",
        "rclcpp",
        "sensor_msgs",
        "std_msgs",
        "urdf",
        "visualization_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = ["include/open_manipulator_collision/self_collision_node.hpp"],
    include_prefix = "",
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@kdl_parser//:ament_package",
        "@rclcpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@urdf//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
