load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "xmllint",
    ]
]

py_library(
    name = "mouse_teleop",
    srcs = glob(["mouse_teleop/**/*.py"]),
    imports = ["."],
    deps = [
        "@geometry_msgs//:py",
        "@rclpy",
        requirement("numpy"),
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "config/mouse_teleop.yaml",
        "launch/mouse_teleop.launch.py",
    ],
    executables = ["resource/mouse_teleop"],
    package_xml = "package.xml",
)

launch_ros_binary(
    name = "mouse_teleop.launch.py",
    src = "launch/mouse_teleop.launch.py",
    data = [":ament_index"],
    deps = [":mouse_teleop"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"mouse_teleop": "mouse_teleop.mouse_teleop:main"},
    data = [
        "config/mouse_teleop.yaml",
        "launch/mouse_teleop.launch.py",
    ],
    executables = ["resource/mouse_teleop"],
    package_xml = "package.xml",
    python = [":mouse_teleop"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
