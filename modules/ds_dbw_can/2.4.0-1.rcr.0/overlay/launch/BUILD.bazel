load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "dbw.launch.xml",
        "offline.launch.xml",
    ],
)

launch_ros_binary(
    name = "dbw_launch",
    src = "dbw.launch.xml",
    data = [
        "//:ament_index",
        "//:dbw_node",
        "@dataspeed_can_usb//:ament_index",
        "@dataspeed_can_usb//:can_node",
        "@rclcpp_components//:ament_index",
        "@ros2_socketcan//:ament_index",
        "@ros2_socketcan//:socket_can_receiver_node_exe",
        "@ros2_socketcan//:socket_can_sender_node_exe",
    ],
)

launch_ros_binary(
    name = "offline_launch",
    src = "offline.launch.xml",
    data = [
        "//:ament_index",
        "//:dbw_node",
        "@dataspeed_can_usb//:ament_index",
        "@dataspeed_can_usb//:can_node",
        "@rclcpp_components//:ament_index",
        "@ros2_socketcan//:ament_index",
        "@ros2_socketcan//:socket_can_receiver_node_exe",
        "@ros2_socketcan//:socket_can_sender_node_exe",
    ],
)
