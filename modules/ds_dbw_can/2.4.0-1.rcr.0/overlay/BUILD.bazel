load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
}

CC_DEPS = [
    "@can_msgs//:cc",
    "@dataspeed_can_msg_filters//:dataspeed_can_msg_filters",
    "@ds_dbw_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

cc_library(
    name = "ds_dbw_can_library",
    srcs = [
        "src/CanSocket.cpp",
        ":gen_DbwNode_cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":gen_rcr_ds_dbw_can_shim_hpp"],
    copts = [
        "-std=gnu++23",
        "-Wno-missing-template-arg-list-after-template-kw",
        "-include",
        "rcr_ds_dbw_can_shim.hpp",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/ds_dbw_can",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ds_dbw_can",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":ds_dbw_can_library"],
)

rclcpp_components_register_node(
    name = "dbw_node",
    component = ":ds_dbw_can",
    node_name = "dbw_node",
    plugin = "ds_dbw_can::DbwNode",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ds_dbw_can"],
)

write_file(
    name = "gen_rcr_ds_dbw_can_shim_hpp",
    out = "_gen/include/rcr_ds_dbw_can_shim.hpp",
    content = ["#pragma once\n#include <unistd.h>\n#define can_dlc len\n#include <linux/can.h>\n"],
)

genrule(
    name = "gen_DbwNode_cpp",
    srcs = ["src/DbwNode.cpp"],
    outs = ["_gen/src/DbwNode.cpp"],
    cmd = "sed -e 's/case msg_steer_cmd_\\.ID:/case MsgSteerCmdUsr::ID:/g' -e 's/case msg_brake_cmd_\\.ID:/case MsgBrakeCmdUsr::ID:/g' -e 's/case msg_thrtl_cmd_\\.ID:/case MsgThrtlCmdUsr::ID:/g' -e 's/case msg_gear_cmd_\\.ID:/case MsgGearCmdUsr::ID:/g' $(location src/DbwNode.cpp) > $@",
)

pkg_files(
    name = "pkg_files_extra_0",
    srcs = ["scripts/brake_sine.py"],
