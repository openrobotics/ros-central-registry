load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/ds_dbw_can/CanMsgRecv.hpp",
        "include/ds_dbw_can/ModuleVersion.hpp",
        "include/ds_dbw_can/PlatformMap.hpp",
        "include/ds_dbw_can/PlatformVersion.hpp",
        "include/ds_dbw_can/SAE_J1850_crc.hpp",
        "include/ds_dbw_can/dispatch.hpp",
        "src/CanSocket.hpp",
        "src/DbwNode.hpp",
    ],
    includes = [],
    target_compatible_with = ["@platforms//os:linux"],
)

DEPENDENCIES = {
    "@can_msgs//:cc_shared": "@can_msgs//:cc",
    "@ds_dbw_msgs//:cc_shared": "@ds_dbw_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

CC_DEPS = [
    "@dataspeed_can_msg_filters//:dataspeed_can_msg_filters",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "ds_dbw_can_library",
    srcs = [
        "src/CanSocket.cpp",
        "src/DbwNode.cpp",
    ],
    hdrs = [
        "include/ds_dbw_can/CanMsgRecv.hpp",
        "include/ds_dbw_can/ModuleVersion.hpp",
        "include/ds_dbw_can/PlatformMap.hpp",
        "include/ds_dbw_can/PlatformVersion.hpp",
        "include/ds_dbw_can/SAE_J1850_crc.hpp",
        "include/ds_dbw_can/dispatch.hpp",
        "src/CanSocket.hpp",
        "src/DbwNode.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/ds_dbw_can",
        "src",
    ],
    local_defines = ros_local_defines(),
    target_compatible_with = ["@platforms//os:linux"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ds_dbw_can",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":ds_dbw_can_library"],
)

rclcpp_components_register_node(
    name = "dbw_node",
    component = ":ds_dbw_can",
    data = [
        ":ament_index",
    ],
    node_name = "dbw_node",
    plugin = "ds_dbw_can::DbwNode",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ds_dbw_can"],
)

register_ament_files(
    name = "ament_files_0",
    files = ["scripts/brake_sine.py"],
    prefix = "lib/ds_dbw_can/scripts",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_1",
    files = ["scripts/brake_sweep.py"],
    prefix = "lib/ds_dbw_can/scripts",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_2",
    files = ["scripts/brake_thrash.py"],
    prefix = "lib/ds_dbw_can/scripts",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_3",
    files = ["scripts/speed_sine_wave.py"],
    prefix = "lib/ds_dbw_can/scripts",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_4",
    files = ["scripts/speed_square_wave.py"],
    prefix = "lib/ds_dbw_can/scripts",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_5",
    files = ["scripts/throttle_sine.py"],
    prefix = "lib/ds_dbw_can/scripts",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_6",
    files = ["scripts/throttle_sweep.py"],
    prefix = "lib/ds_dbw_can/scripts",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_7",
    files = ["scripts/throttle_thrash.py"],
    prefix = "lib/ds_dbw_can/scripts",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_8",
    files = ["scripts/wheel_counts_per_km.py"],
    prefix = "lib/ds_dbw_can/scripts",
    strip_prefix = "*",
)

ament_index(
    name = "ament_index",
    components = [":dbw_node_record"],
    data = [
        ":ament_files_0",
        ":ament_files_1",
        ":ament_files_2",
        ":ament_files_3",
        ":ament_files_4",
        ":ament_files_5",
        ":ament_files_6",
        ":ament_files_7",
        ":ament_files_8",
        "//launch:launch_files",
    ],
    libraries = [":ds_dbw_can"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@can_msgs//:ament_package",
        "@dataspeed_can_msg_filters//:ament_package",
        "@dataspeed_can_usb//:ament_package",
        "@ds_dbw_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "can_msgs",
        "ds_dbw_msgs",
        "rclcpp",
        "rclcpp_components",
        "sensor_msgs",
        "std_msgs",
    ],
    cmake_export_libraries = False,
    cmake_export_targets = False,
    executables = [
        ":dbw_node",
    ],
    headers = [
        "include/ds_dbw_can/CanMsgRecv.hpp",
        "include/ds_dbw_can/ModuleVersion.hpp",
        "include/ds_dbw_can/PlatformMap.hpp",
        "include/ds_dbw_can/PlatformVersion.hpp",
        "include/ds_dbw_can/SAE_J1850_crc.hpp",
        "include/ds_dbw_can/dispatch.hpp",
    ],
    include_prefix = "",
    libraries = [":ds_dbw_can"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@can_msgs//:ament_package",
        "@dataspeed_can_msg_filters//:ament_package",
        "@dataspeed_can_usb//:ament_package",
        "@ds_dbw_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
