cc_test(
    name = "test_clock_publisher",
    srcs = ["test_clock_publisher.cpp"],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:loopback_simulator_core_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_loopback_simulator",
    srcs = ["test_loopback_simulator.cpp"],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:loopback_simulator_core_library",
