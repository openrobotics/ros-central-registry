load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

py_library(
    name = "ntrip_client",
    srcs = glob(["src/ntrip_client/**/*.py"]),
    imports = ["src"],
    deps = [
        "@nmea_msgs//:py",
        "@rclpy",
        "@rtcm_msgs//:py",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
    ],
)

pkg_files(
    name = "launch_files",
    srcs = glob(["launch/*"]),
    prefix = "share/ntrip_client",
)

### PACKAGING

ament_package(
    name = "ament_package",
    executables = glob(["scripts/*.py"]),
    install = [":launch_files"],
    package_xml = "package.xml",
    python = [":ntrip_client"],
    python_strip_prefix = "src",
    deps = [
        "@nmea_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rtcm_msgs//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
