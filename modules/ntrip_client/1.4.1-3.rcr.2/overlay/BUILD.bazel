load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

py_library(
    name = "ntrip_client",
    srcs = [
        "src/ntrip_client/__init__.py",
        "src/ntrip_client/nmea_parser.py",
        "src/ntrip_client/ntrip_base.py",
        "src/ntrip_client/ntrip_client.py",
        "src/ntrip_client/ntrip_serial_device.py",
        "src/ntrip_client/rtcm_parser.py",
    ],
    imports = ["src"],
    deps = [
        "@nmea_msgs//:py",
        "@rclpy",
        "@rtcm_msgs//:py",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
    ],
)

ament_package(
    name = "ament_package",
    data = ["//launch:launch_files"],
    executables = [
        "scripts/ntrip_ros.py",
        "scripts/ntrip_ros_base.py",
        "scripts/ntrip_serial_device_ros.py",
    ],
    package_xml = "package.xml",
    python = [":ntrip_client"],
    python_strip_prefix = "src",
    setup_cfg = "setup.cfg",
    deps = [
        "@nmea_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rtcm_msgs//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
