load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines", "ros_version_header")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@hardware_interface//:hardware_interface": "@hardware_interface//:hardware_interface_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libcap": "@rosdistro//cc:libcap_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@ros2_control_test_assets//:ros2_control_test_assets",
    "@rosdistro//cc:fmt",
]

cc_library(
    name = "transmission_interface_library",
    srcs = [
        "src/differential_transmission_loader.cpp",
        "src/four_bar_linkage_transmission_loader.cpp",
        "src/simple_transmission_loader.cpp",
    ],
    hdrs = [
        "include/transmission_interface/accessor.hpp",
        "include/transmission_interface/differential_transmission.hpp",
        "include/transmission_interface/differential_transmission_loader.hpp",
        "include/transmission_interface/exception.hpp",
        "include/transmission_interface/four_bar_linkage_transmission.hpp",
        "include/transmission_interface/four_bar_linkage_transmission_loader.hpp",
        "include/transmission_interface/handle.hpp",
        "include/transmission_interface/simple_transmission.hpp",
        "include/transmission_interface/simple_transmission_loader.hpp",
        "include/transmission_interface/transmission.hpp",
        "include/transmission_interface/transmission_interface_exception.hpp",
        "include/transmission_interface/transmission_loader.hpp",
    ] + [":version_h"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/transmission_interface",
        "_gen/include/transmission_interface/transmission_interface",
        "include",
        "include/transmission_interface",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "transmission_interface",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":transmission_interface_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":transmission_interface"],
)

ros_version_header(
    name = "version_h",
    out = "_gen/include/transmission_interface/transmission_interface/version.h",
)

ament_index(
    name = "ament_index",
    libraries = [":transmission_interface"],
    package_xml = "package.xml",
    plugins = ["ros2_control_plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@hardware_interface//:ament_package",
        "@pluginlib//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@ros2_control_test_assets//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "fmt",
        "hardware_interface",
        "pluginlib",
        "rclcpp",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_transmission_interface",
    headers = [":version_h"] + [
        "include/transmission_interface/accessor.hpp",
        "include/transmission_interface/differential_transmission.hpp",
        "include/transmission_interface/differential_transmission_loader.hpp",
        "include/transmission_interface/exception.hpp",
        "include/transmission_interface/four_bar_linkage_transmission.hpp",
        "include/transmission_interface/four_bar_linkage_transmission_loader.hpp",
        "include/transmission_interface/handle.hpp",
        "include/transmission_interface/simple_transmission.hpp",
        "include/transmission_interface/simple_transmission_loader.hpp",
        "include/transmission_interface/transmission.hpp",
        "include/transmission_interface/transmission_interface_exception.hpp",
        "include/transmission_interface/transmission_loader.hpp",
    ],
    include_prefix = "",
    libraries = [":transmission_interface"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@hardware_interface//:ament_package",
        "@pluginlib//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@ros2_control_test_assets//:ament_package",
    ],
)
