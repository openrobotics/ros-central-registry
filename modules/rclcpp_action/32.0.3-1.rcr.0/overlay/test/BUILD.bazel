load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rcl//:rcl": "@rcl//:rcl_library",
    "@rcl_action//:rcl_action": "@rcl_action//:rcl_action_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
}

TEST_DEPENDENCIES = {"@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library"}

[cc_test(
    name = name,
    timeout = "moderate",
    srcs = ["{}.cpp".format(name)] + ["mocking_utils/patch.hpp"],
    data = ["@test_msgs//:ament_index"],
    dynamic_deps = [
        "//:transitive_dynamic_deps",
        "//:transitive_dynamic_deps_test",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + TEST_DEPENDENCIES.values() + [
        "//:rclcpp_action_library",
        "@rosdistro//cc:googletest",
        "@rosdistro//cc:mimick",
        "@test_msgs//:cc",
    ],
) for name in [
    "test_client",
    "test_generic_client",
    "test_server_goal_handle",
    "test_server",
    "test_traits",
    "test_types",
]]

[cc_test(
    name = name,
    timeout = "moderate",
    srcs = ["benchmark/{}.cpp".format(name)],
    dynamic_deps = [
        "//:transitive_dynamic_deps",
        "//:transitive_dynamic_deps_test",
    ],
    local_defines = ros_local_defines(),
    tags = ["manual"],
    deps = DEPENDENCIES.values() + TEST_DEPENDENCIES.values() + [
        "//:rclcpp_action_library",
        "@google_benchmark//:benchmark_main",
        "@performance_test_fixture",
    ],
) for name in [
    "benchmark_action_client",
    "benchmark_action_server",
]]
