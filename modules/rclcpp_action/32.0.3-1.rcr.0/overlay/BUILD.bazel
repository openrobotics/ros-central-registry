load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/rclcpp_action/client.hpp",
    "include/rclcpp_action/client_base.hpp",
    "include/rclcpp_action/client_goal_handle.hpp",
    "include/rclcpp_action/client_goal_handle_impl.hpp",
    "include/rclcpp_action/create_client.hpp",
    "include/rclcpp_action/create_generic_client.hpp",
    "include/rclcpp_action/create_server.hpp",
    "include/rclcpp_action/exceptions.hpp",
    "include/rclcpp_action/generic_client.hpp",
    "include/rclcpp_action/generic_client_goal_handle.hpp",
    "include/rclcpp_action/qos.hpp",
    "include/rclcpp_action/rclcpp_action.hpp",
    "include/rclcpp_action/server.hpp",
    "include/rclcpp_action/server_goal_handle.hpp",
    "include/rclcpp_action/types.hpp",
    "include/rclcpp_action/visibility_control.hpp",
]

DEPENDENCIES = {
    "@action_msgs//:cc_shared": "@action_msgs//:cc",
    "@rcl//:rcl": "@rcl//:rcl_library",
    "@rcl_action//:rcl_action": "@rcl_action//:rcl_action_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
}

cc_library(
    name = "rclcpp_action_library",
    srcs = [
        "src/client_base.cpp",
        "src/create_generic_client.cpp",
        "src/generic_client.cpp",
        "src/generic_client_goal_handle.cpp",
        "src/qos.cpp",
        "src/server.cpp",
        "src/server_goal_handle.cpp",
        "src/types.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rclcpp_action",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rclcpp_action_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":rclcpp_action",
        "@action_msgs//:cc_shared",
    ],
)

TEST_DEPENDENCIES = {"@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library"}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_test",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
)

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [":rclcpp_action"],
    package_xml = "package.xml",
    deps = [
        "@action_msgs//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@mimick_vendor//:ament_package",
        "@performance_test_fixture//:ament_package",
        "@rcl//:ament_package",
        "@rcl_action//:ament_package",
        "@rclcpp//:ament_package",
        "@rcpputils//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
