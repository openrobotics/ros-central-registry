load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

DEPENDENCIES = {
    "@mqtt_client_interfaces//:cc_shared": "@mqtt_client_interfaces//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosx_introspection//:rosx_introspection": "@rosx_introspection//:rosx_introspection_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:fmt",
    "@rosdistro//cc:paho_mqtt_cpp",
]

cc_library(
    name = "mqtt_client_lib_library",
    srcs = ["src/MqttClient.cpp"],
    hdrs = ["include/mqtt_client/MqttClient.hpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/mqtt_client",
    ],
    local_defines = ros_local_defines() + [
        "_FILE_OFFSET_BITS=64",
        "span_CONFIG_SELECT_SPAN=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mqtt_client_lib",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mqtt_client_lib_library"],
)

rclcpp_components_register_node(
    name = "mqtt_client",
    component = ":mqtt_client_lib",
    data = [
        ":ament_index",
    ],
    node_name = "mqtt_client",
    plugin = "mqtt_client::MqttClient",
)

ament_index(
    name = "ament_index",
    components = [":mqtt_client_record"],
    data = [
        "config/params.aws.yaml",
        "config/params.fixed-type-and-qos.yaml",
        "config/params.json.yaml",
        "config/params.primitive.yaml",
        "config/params.primitive-fixed-type-and-qos.yaml",
        "config/params.yaml",
        "//launch:launch_files",
    ],
    libraries = [":mqtt_client_lib"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@mqtt_client_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rcpputils//:ament_package",
        "@rosx_introspection//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    executables = [
        ":mqtt_client",
    ],
    libraries = [":mqtt_client_lib"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@mqtt_client_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rcpputils//:ament_package",
        "@rosx_introspection//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
