load("@launch_testing_ros//:defs.bzl", "launch_ros_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

launch_ros_test(
    name = "test_torch_tensor_intra_pubsub_fastrtps_launch",
    src = "test_torch_tensor_intra_pubsub_fastrtps_launch.py",
    data = [
        "//:ament_index",
        "@rclcpp_components//:ament_index",
        "@rclcpp_components//:component_container",
    ],
    # xfail: test assertion fails under Bazel: AssertionError: False is not true : Failed to receive 5 messages within timeout (intra-process). Received: 0
    tags = [
        "manual",
        "xfail",
    ],
    deps = [
        "@rclpy",
        "@std_msgs//:py",
        "@tensor_msgs//:py",
    ],
)

launch_ros_test(
