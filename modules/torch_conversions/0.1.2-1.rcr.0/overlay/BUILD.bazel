load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = ["include/torch_conversions/torch_conversions.hpp"]

# Upstream's find_package(Torch) comes from libtorch_vendor, which downloads a
# prebuilt LibTorch. Here LibTorch is built from source (@rosdistro//cc:torch,
# CPU-only unless --config=cuda).
DEPENDENCIES = {
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosdistro//cc:torch": "@rosdistro//cc:torch_library",
    "@rosidl_buffer//:rosidl_buffer": "@rosidl_buffer//:rosidl_buffer_library",
    "@tensor_msgs//:cc_shared": "@tensor_msgs//:cc",
}

# Header-only, like upstream's INTERFACE library.
#
# torch_conversions.hpp enables its CUDA path only when
# __has_include("cuda_buffer/cuda_buffer_api.hpp") in the *consumer's*
# translation unit, mirroring upstream's optional find_package(cuda_buffer
# QUIET). package.xml doesn't depend on cuda_buffer, so neither does this
# target: a consumer that also depends on @cuda_buffer (Linux, --config=cuda)
# gets the CUDA path automatically.
cc_library(
    name = "torch_conversions",
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values(),
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    components = ["//test:component_nodes"],
    executables = [
        "//test:torch_tensor_publisher_node",
        "//test:torch_tensor_subscriber_node",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@libtorch_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rosidl_buffer//:ament_package",
        "@std_msgs//:ament_package",
        "@tensor_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "libtorch_vendor",
        "rcutils",
        "rmw",
        "rosidl_buffer",
        "tensor_msgs",
    ],
    cmake_export_libraries = False,
    headers = HEADERS,
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@libtorch_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rosidl_buffer//:ament_package",
        "@std_msgs//:ament_package",
        "@tensor_msgs//:ament_package",
    ],
)
