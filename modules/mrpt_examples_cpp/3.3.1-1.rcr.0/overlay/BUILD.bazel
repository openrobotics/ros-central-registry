cc_binary(
    name = "_bin/bayes_rejection_sampling_example",
    srcs = [":gen_mrpt_examples_cpp_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_gl_h",
        ":gen_glfw3_h",
        ":gen_glu_h",
        ":gen_octomap_color_octree_h",
        ":gen_octomap_h",
