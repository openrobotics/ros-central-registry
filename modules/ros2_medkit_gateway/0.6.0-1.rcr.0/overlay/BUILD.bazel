    srcs = ["test/test_auth_config.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":gen_atomic_shared_ptr_shim_hpp"],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
        "-include",
        "atomic_shared_ptr_shim.hpp",
    ],
    data = [
        ":ament_index",
        ":test_bad_version_plugin",
        ":test_gateway_plugin",
        ":test_minimal_plugin",
        ":test_no_symbols_plugin",
        ":test_null_factory_plugin",
        ":test_update_backend",
        ":test_version_only_plugin",
    ] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/ros2_medkit_gateway",
        "src/openapi",
        "src/vendored/cpp_httplib",
        "src/vendored/jwt_cpp/include",
        "src/vendored/mdns",
        "src/vendored/tl_expected/include",
    ],
    local_defines = ros_local_defines() + [
        "CPPHTTPLIB_OPENSSL_SUPPORT",
        "GATEWAY_VERSION_STRING=\\\"0.6.0\\\"",
        "GTEST_HAS_PTHREAD=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":gateway_core_library",
        ":gateway_ros2_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

