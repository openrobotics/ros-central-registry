load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "bringup.launch.py",
        "gateway.launch.py",
        "gateway_https.launch.py",
    ],
)

launch_ros_binary(
    name = "bringup_launch",
    src = "bringup.launch.py",
    data = ["//:ament_index"],
    deps = ["@ament_index_python"],
)

launch_ros_binary(
    name = "gateway_launch",
    src = "gateway.launch.py",
    data = [
        "@ros2_medkit_graph_provider//:ament_index",
    ],
    deps = [
        "//:gateway_node",
        "@ament_index_python",
    ],
)

launch_ros_binary(
    name = "gateway_https_launch",
    src = "gateway_https.launch.py",
    deps = [
        "//:gateway_node",
        "@ament_index_python",
    ],
)
