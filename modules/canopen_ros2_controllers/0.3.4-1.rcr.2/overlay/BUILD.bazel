load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
]

cc_library(
    name = "canopen_ros2_controllers_library",
    srcs = [":gen_canopen_ros2_controllers_stub_cpp"],
    hdrs = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/canopen_ros2_controllers",
    ],
    local_defines = ros_local_defines() + [
        "CANOPEN_PROXY_CONTROLLER_BUILDING_DLL",
        "_FILE_OFFSET_BITS=64",
        "_USE_MATH_DEFINES",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "canopen_ros2_controllers",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":canopen_ros2_controllers_library"],
)

write_file(
    name = "gen_canopen_ros2_controllers_stub_cpp",
    out = "_gen/canopen_ros2_controllers_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    libraries = [":canopen_ros2_controllers"],
    package_xml = "package.xml",
    plugin_category = "controller_interface",
    plugins = ["canopen_ros2_controllers.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@canopen_402_driver//:ament_package",
        "@canopen_interfaces//:ament_package",
        "@canopen_proxy_driver//:ament_package",
        "@controller_interface//:ament_package",
        "@controller_manager//:ament_package",
        "@hardware_interface//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@realtime_tools//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "canopen_402_driver",
        "canopen_interfaces",
        "canopen_proxy_driver",
        "controller_interface",
        "controller_manager",
        "hardware_interface",
        "pluginlib",
        "rclcpp",
        "rclcpp_lifecycle",
        "realtime_tools",
        "std_msgs",
        "std_srvs",
    ],
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [":canopen_ros2_controllers"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@canopen_402_driver//:ament_package",
        "@canopen_interfaces//:ament_package",
        "@canopen_proxy_driver//:ament_package",
        "@controller_interface//:ament_package",
        "@controller_manager//:ament_package",
        "@hardware_interface//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@realtime_tools//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
