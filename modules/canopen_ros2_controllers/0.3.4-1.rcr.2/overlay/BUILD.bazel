load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

# Map of shared library (key) to its static library (value).
DEPENDENCIES = {
    "@canopen_402_driver//:cia402_driver": "@canopen_402_driver//:cia402_driver_library",
    "@canopen_402_driver//:lely_motion_controller_bridge": "@canopen_402_driver//:lely_motion_controller_bridge_library",
    "@canopen_402_driver//:lifecycle_cia402_driver": "@canopen_402_driver//:lifecycle_cia402_driver_library",
    "@canopen_402_driver//:node_canopen_cia402_driver": "@canopen_402_driver//:node_canopen_cia402_driver_library",
    "@canopen_proxy_driver//:lifecycle_proxy_driver": "@canopen_proxy_driver//:lifecycle_proxy_driver_library",
    "@canopen_proxy_driver//:node_canopen_proxy_driver": "@canopen_proxy_driver//:node_canopen_proxy_driver_library",
    "@canopen_proxy_driver//:proxy_driver": "@canopen_proxy_driver//:proxy_driver_library",
    "@controller_interface//:controller_interface": "@controller_interface//:controller_interface_library",
    "@controller_manager//:controller_manager": "@controller_manager//:controller_manager_library",
    "@hardware_interface//:hardware_interface": "@hardware_interface//:hardware_interface_library",
    "@hardware_interface//:mock_components": "@hardware_interface//:mock_components_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
    "@realtime_tools//:thread_priority": "@realtime_tools//:thread_priority_library",
}

CC_DEPS = [
    "@canopen_interfaces//:cc",
    "@std_msgs//:cc",
    "@std_srvs//:cc",
]

cc_library(
    name = "canopen_ros2_controllers_library",
    srcs = [
        "src/canopen_proxy_controller.cpp",
        "src/cia402_device_controller.cpp",
    ],
    hdrs = [
        "include/canopen_ros2_controllers/canopen_proxy_controller.hpp",
        "include/canopen_ros2_controllers/cia402_device_controller.hpp",
        "include/canopen_ros2_controllers/visibility_control.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/canopen_ros2_controllers",
    ],
    local_defines = ros_local_defines() + [
        "CANOPEN_PROXY_CONTROLLER_BUILDING_DLL",
        "_FILE_OFFSET_BITS=64",
        "_USE_MATH_DEFINES",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
    alwayslink = True,
)

cc_shared_library(
    name = "canopen_ros2_controllers",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":canopen_ros2_controllers_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":canopen_ros2_controllers"],
    package_xml = "package.xml",
    plugin_category = "controller_interface",
    plugins = ["canopen_ros2_controllers.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@canopen_402_driver//:ament_package",
        "@canopen_interfaces//:ament_package",
        "@canopen_proxy_driver//:ament_package",
        "@controller_interface//:ament_package",
        "@controller_manager//:ament_package",
        "@hardware_interface//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@realtime_tools//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "canopen_402_driver",
        "canopen_interfaces",
        "canopen_proxy_driver",
        "controller_interface",
        "controller_manager",
        "hardware_interface",
        "pluginlib",
        "rclcpp",
        "rclcpp_lifecycle",
        "realtime_tools",
        "std_msgs",
        "std_srvs",
    ],
    cmake_export_targets = False,
    headers = [
        "include/canopen_ros2_controllers/canopen_proxy_controller.hpp",
        "include/canopen_ros2_controllers/cia402_device_controller.hpp",
        "include/canopen_ros2_controllers/visibility_control.h",
    ],
    include_prefix = "",
    libraries = [":canopen_ros2_controllers"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@canopen_402_driver//:ament_package",
        "@canopen_interfaces//:ament_package",
        "@canopen_proxy_driver//:ament_package",
        "@controller_interface//:ament_package",
        "@controller_manager//:ament_package",
        "@hardware_interface//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@realtime_tools//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
