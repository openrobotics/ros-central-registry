cc_library(
    name = "spatio_temporal_voxel_layer_core_library",
    srcs = [":gen_spatio_temporal_voxel_layer_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "_gen/include/spatio_temporal_voxel_layer",
        "_gen/include/spatio_temporal_voxel_layer/spatio_temporal_voxel_layer",
        "include",
        "include/spatio_temporal_voxel_layer",
    ],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "NDEBUG",
        "OPENVDB_ABI_VERSION_NUMBER=10",
        "OPENVDB_USE_DELAYED_LOADING",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":cc",
    ],
)

cc_shared_library(
    name = "spatio_temporal_voxel_layer_core",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":spatio_temporal_voxel_layer_core_library"],
)

write_file(
    name = "gen_spatio_temporal_voxel_layer_stub_cpp",
    out = "_gen/spatio_temporal_voxel_layer_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

