load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

COMPONENTS = {
    "talker_component": "composition::Talker",
    "listener_component": "composition::Listener",
    "node_like_listener_component": "composition::NodeLikeListener",
    "server_component": "composition::Server",
    "client_component": "composition::Client",
}

[cc_library(
    name = "{0}_library".format(component),
    srcs = ["src/{0}.cpp".format(component)],
    hdrs = [
        "include/composition/client_component.hpp",
        "include/composition/listener_component.hpp",
        "include/composition/node_like_listener_component.hpp",
        "include/composition/server_component.hpp",
        "include/composition/talker_component.hpp",
        "include/composition/visibility_control.h",
    ],
    includes = ["include"],
    local_defines = ros_local_defines() + ["COMPOSITION_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + ["@example_interfaces//:cc"],
) for component in COMPONENTS.keys()]

[cc_shared_library(
    name = component,
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":{0}_library".format(component)],
    deps = [":{0}_library".format(component)],
) for component in COMPONENTS.keys()]

[rclcpp_components_register_nodes(
    name = "{0}_nodes".format(component),
    component = ":{0}".format(component),
    plugins = [plugin],
) for component, plugin in COMPONENTS.items()]

collect_transitive_dynamic_deps(
    name = "composition_dynamic_deps",
    dynamic_deps = [
        ":talker_component",
        ":listener_component",
        ":server_component",
        ":client_component",
    ],
)

EXECUTABLES = [
    "manual_composition",
    "linktime_composition",
    "dlopen_composition",
]

[cc_binary(
    name = executable,
    srcs = ["src/{0}.cpp".format(executable)],
    dynamic_deps = [":composition_dynamic_deps"],
    deps = [
        ":client_component_library",
        ":listener_component_library",
        ":server_component_library",
        ":talker_component_library",
        "@rclcpp//:rclcpp_library",
    ],
) for executable in EXECUTABLES]

ament_index(
    name = "ament_index",
    components = [":{0}_nodes".format(c) for c in COMPONENTS.keys()],
    data = ["//launch:launch_files"],
    executables = [":{0}".format(e) for e in EXECUTABLES],
    libraries = [":{0}".format(c) for c in COMPONENTS.keys()],
    package_xml = "package.xml",
)

write_file(
    name = "rmw_test_fixture_implementation_py",
    out = "rmw_test_fixture_implementation.py",
    content = [
        "def rmw_test_isolation_start(): pass",
        "def rmw_test_isolation_stop(): pass",
    ],
)

py_library(
    name = "rmw_test_fixture_implementation",
    srcs = [":rmw_test_fixture_implementation_py"],
    imports = ["."],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    libraries = [":{0}".format(c) for c in COMPONENTS.keys()],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@example_interfaces//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rcutils//:ament_package",
        "@rmw_implementation_cmake//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
