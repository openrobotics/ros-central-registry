load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

py_library(
    name = "rqt_joint_trajectory_controller",
    srcs = [
        "rqt_joint_trajectory_controller/__init__.py",
        "rqt_joint_trajectory_controller/double_editor.py",
        "rqt_joint_trajectory_controller/joint_limits_urdf.py",
        "rqt_joint_trajectory_controller/joint_trajectory_controller.py",
        "rqt_joint_trajectory_controller/rqt_joint_trajectory_controller.py",
        "rqt_joint_trajectory_controller/update_combo.py",
        "rqt_joint_trajectory_controller/utils.py",
    ],
    imports = ["."],
    deps = [
        "@control_msgs//:py",
        "@controller_manager_msgs//:py",
        "@launch_testing",
        "@launch_testing_ros",
        "@python_qt_binding",
        "@qt_gui",
        "@rclpy",
        "@rqt_gui",
        "@rqt_gui_py",
        "@trajectory_msgs//:py",
        "@urdfdom_py",
    ],
)

ament_package(
    name = "ament_package",
    console_scripts = {"rqt_joint_trajectory_controller": "rqt_joint_trajectory_controller.rqt_joint_trajectory_controller:main"},
    data = [
        "plugin.xml",
        "resource/double_editor.ui",
        "resource/joint_trajectory_controller.ui",
        "resource/off.svg",
        "resource/on.svg",
        "resource/scope.png",
        "resource/scope.svg",
    ],
    executables = ["resource/rqt_joint_trajectory_controller"],
    package_xml = "package.xml",
    python = [":rqt_joint_trajectory_controller"],
    deps = [
        "@control_msgs//:ament_package",
        "@controller_manager_msgs//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@python_qt_binding//:ament_package",
        "@qt_gui//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@trajectory_msgs//:ament_package",
        "@urdfdom_py//:ament_package",
    ],
)
