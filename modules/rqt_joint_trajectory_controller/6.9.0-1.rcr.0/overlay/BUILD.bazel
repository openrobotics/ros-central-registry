package(default_visibility = ["//visibility:public"])

py_library(
    name = "rqt_joint_trajectory_controller",
    srcs = glob(["rqt_joint_trajectory_controller/**/*.py"]),
    imports = ["."],
    deps = [
        "@control_msgs//:py",
        "@controller_manager_msgs//:py",
        "@launch_testing",
        "@launch_testing_ros",
        "@python_qt_binding",
        "@qt_gui",
        "@rclpy",
        "@rqt_gui",
        "@rqt_gui_py",
        "@trajectory_msgs//:py",
        "@urdfdom_py",
    ],
)

py_pytest(
    name = "test_joint_limits_urdf",
    srcs = ["test/test_joint_limits_urdf.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":rqt_joint_trajectory_controller"],
)

py_pytest(
    name = "test_run_launch",
    srcs = ["test/test_run_launch.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":rqt_joint_trajectory_controller"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"rqt_joint_trajectory_controller": "rqt_joint_trajectory_controller.rqt_joint_trajectory_controller:main"},
    data = [
        "plugin.xml",
        "resource/double_editor.ui",
        "resource/joint_trajectory_controller.ui",
        "resource/off.svg",
        "resource/on.svg",
        "resource/scope.png",
        "resource/scope.svg",
    ],
    executables = ["resource/rqt_joint_trajectory_controller"],
    package_xml = "package.xml",
    python = [":rqt_joint_trajectory_controller"],
    deps = [
        "@control_msgs//:ament_package",
        "@controller_manager_msgs//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@python_qt_binding//:ament_package",
        "@qt_gui//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@trajectory_msgs//:ament_package",
        "@urdfdom_py//:ament_package",
    ],
)
