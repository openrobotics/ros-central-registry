load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = [
    "include/rplidar_node.hpp",
    "include/visibility.h",
]

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@std_srvs//:cc_shared": "@std_srvs//:cc",
}

MSG_DEPENDENCIES = [
]

cc_library(
    name = "rplidar_sdk",
    srcs = [
        "sdk/src/hal/thread.cpp",
        "sdk/src/rplidar_driver.cpp",
    ] + select({
        "@platforms//os:macos": [
            "sdk/src/arch/macOS/net_serial.cpp",
            "sdk/src/arch/macOS/net_socket.cpp",
            "sdk/src/arch/macOS/timer.cpp",
        ],
        "//conditions:default": [
            "sdk/src/arch/linux/net_serial.cpp",
            "sdk/src/arch/linux/net_socket.cpp",
            "sdk/src/arch/linux/timer.cpp",
        ],
    }),
    hdrs = [
        "sdk/include/rplidar.h",
        "sdk/include/rplidar_cmd.h",
        "sdk/include/rplidar_driver.h",
        "sdk/include/rplidar_protocol.h",
        "sdk/include/rptypes.h",
        "sdk/src/hal/abs_rxtx.h",
        "sdk/src/hal/assert.h",
        "sdk/src/hal/byteops.h",
        "sdk/src/hal/event.h",
        "sdk/src/hal/locker.h",
        "sdk/src/hal/socket.h",
        "sdk/src/hal/thread.h",
        "sdk/src/hal/types.h",
        "sdk/src/hal/util.h",
        "sdk/src/rplidar_driver_TCP.h",
        "sdk/src/rplidar_driver_impl.h",
        "sdk/src/rplidar_driver_serial.h",
        "sdk/src/sdkcommon.h",
    ] + select({
        "@platforms//os:macos": [
            "sdk/src/arch/macOS/arch_macOS.h",
            "sdk/src/arch/macOS/net_serial.h",
            "sdk/src/arch/macOS/thread.hpp",
            "sdk/src/arch/macOS/timer.h",
        ],
        "//conditions:default": [
            "sdk/src/arch/linux/arch_linux.h",
            "sdk/src/arch/linux/net_serial.h",
            "sdk/src/arch/linux/thread.hpp",
            "sdk/src/arch/linux/timer.h",
        ],
    }),
    defines = select({
        "@platforms//os:macos": ["_MACOS"],
        "//conditions:default": [],
    }),
    includes = [
        "sdk/include",
        "sdk/src",
    ],
    linkopts = ["-lpthread"],
)

cc_library(
    name = "rplidar_composition_node_library",
    srcs = ["src/rplidar_node.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + MSG_DEPENDENCIES + [":rplidar_sdk"],
)

cc_shared_library(
    name = "rplidar_composition_node",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rplidar_composition_node_library"],
)

rclcpp_components_register_nodes(
    name = "rplidar_composition_node_nodes",
    component = ":rplidar_composition_node",
    plugins = ["rplidar_ros::rplidar_node"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":rplidar_composition_node"],
)

cc_binary(
    name = "rplidar_composition",
    srcs = ["src/standalone_rplidar.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + MSG_DEPENDENCIES + [":rplidar_composition_node_library"],
)

DATA = ["rviz/rplidar.rviz"] + ["//launch:launch_files"]

ament_index(
    name = "ament_index",
    components = [":rplidar_composition_node_nodes"],
    data = DATA,
    executables = [":rplidar_composition"],
    libraries = [":rplidar_composition_node"],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rclcpp",
        "rclcpp_components",
        "sensor_msgs",
        "std_srvs",
    ],
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = HEADERS,
    libraries = [":rplidar_composition_node"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
