load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "webots_ros2_importer",
    srcs = [
        "webots_ros2_importer/__init__.py",
        "webots_ros2_importer/urdf2proto.py",
        "webots_ros2_importer/urdf2webots/setup.py",
        "webots_ros2_importer/urdf2webots/tests/sources/motoman/motoman_driver/src/move_to_joint.py",
        "webots_ros2_importer/urdf2webots/tests/test_export.py",
        "webots_ros2_importer/urdf2webots/tests/test_pep8.py",
        "webots_ros2_importer/urdf2webots/urdf2webots/__init__.py",
        "webots_ros2_importer/urdf2webots/urdf2webots/gazebo_materials.py",
        "webots_ros2_importer/urdf2webots/urdf2webots/importer.py",
        "webots_ros2_importer/urdf2webots/urdf2webots/math_utils.py",
        "webots_ros2_importer/urdf2webots/urdf2webots/parserURDF.py",
        "webots_ros2_importer/urdf2webots/urdf2webots/writeRobot.py",
        "webots_ros2_importer/xacro2proto.py",
    ],
    imports = ["."],
    deps = [
        "@builtin_interfaces//:py",
        requirement("numpy"),
        requirement("pillow"),
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "urdf2proto": "webots_ros2_importer.urdf2proto:main",
        "xacro2proto": "webots_ros2_importer.xacro2proto:main",
    },
    package_xml = "package.xml",
    python = [":webots_ros2_importer"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@rosdistro//:ament_package",
        "@xacro//:ament_package",
    ],
)

