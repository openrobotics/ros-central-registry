load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

py_library(
    name = "webots_ros2_importer",
    srcs = [
        "webots_ros2_importer/__init__.py",
        "webots_ros2_importer/urdf2proto.py",
        "webots_ros2_importer/urdf2webots/urdf2webots/__init__.py",
        "webots_ros2_importer/urdf2webots/urdf2webots/gazebo_materials.py",
        "webots_ros2_importer/urdf2webots/urdf2webots/importer.py",
        "webots_ros2_importer/urdf2webots/urdf2webots/math_utils.py",
        "webots_ros2_importer/urdf2webots/urdf2webots/parserURDF.py",
        "webots_ros2_importer/urdf2webots/urdf2webots/writeRobot.py",
        "webots_ros2_importer/xacro2proto.py",
    ],
    imports = [
        ".",
        "webots_ros2_importer/urdf2webots",
    ],
    deps = [
        "@builtin_interfaces//:py",
        "@xacro//:xacro_lib",
        requirement("numpy"),
        requirement("pillow"),
    ],
)

py_binary(
    name = "urdf2proto",
    srcs = ["webots_ros2_importer/urdf2proto.py"],
    main = "webots_ros2_importer/urdf2proto.py",
    deps = [":webots_ros2_importer"],
)

py_binary(
    name = "xacro2proto",
    srcs = ["webots_ros2_importer/xacro2proto.py"],
    main = "webots_ros2_importer/xacro2proto.py",
    deps = [":webots_ros2_importer"],
)

### PACKAGING

ament_index(
    name = "ament_index",
    executables = [
        ":urdf2proto",
        ":xacro2proto",
    ],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    console_scripts = {
        "urdf2proto": "webots_ros2_importer.urdf2proto:main",
        "xacro2proto": "webots_ros2_importer.xacro2proto:main",
    },
    package_xml = "package.xml",
    python = [":webots_ros2_importer"],
    setup_cfg = "setup.cfg",
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@launch_ros//:ament_package",
        "@rosdistro//:ament_package",
        "@xacro//:ament_package",
    ],
)
