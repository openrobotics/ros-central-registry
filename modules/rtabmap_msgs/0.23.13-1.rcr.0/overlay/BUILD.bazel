        "@geometry_msgs",
        "@sensor_msgs",
        "@std_msgs",
    ],
    package_xml = "package.xml",
    deps = [
        "//msg:CameraModel",
        "//msg:CameraModels",
        "//msg:EnvSensor",
        "//msg:GPS",
        "//msg:GlobalDescriptor",
        "//msg:Goal",
        "//msg:Info",
        "//msg:KeyPoint",
        "//msg:LandmarkDetection",
        "//msg:LandmarkDetections",
        "//msg:Link",
        "//msg:MapData",
        "//msg:MapGraph",
        "//msg:Node",
        "//msg:OdomInfo",
        "//msg:Path",
        "//msg:Point2f",
        "//msg:Point3f",
        "//msg:RGBDImage",
        "//msg:RGBDImages",
        "//msg:ScanDescriptor",
        "//msg:SensorData",
        "//msg:UserData",
        "//srv:AddLink",
        "//srv:CleanupLocalGrids",
        "//srv:DetectMoreLoopClosures",
        "//srv:GetMap",
        "//srv:GetMap2",
        "//srv:GetNodeData",
        "//srv:GetNodesInRadius",
        "//srv:GetPlan",
        "//srv:GlobalBundleAdjustment",
