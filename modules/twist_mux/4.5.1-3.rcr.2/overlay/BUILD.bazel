load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.algorithm",
    "@std_msgs//:cc",
    "@twist_mux_msgs//:cc",
    "@visualization_msgs//:cc",
]

cc_library(
    name = "twist_mux_library",
    hdrs = [
        "include/twist_mux/params_helpers.hpp",
        "include/twist_mux/topic_handle.hpp",
        "include/twist_mux/twist_mux.hpp",
        "include/twist_mux/twist_mux_diagnostics.hpp",
        "include/twist_mux/twist_mux_diagnostics_status.hpp",
        "include/twist_mux/utils.hpp",
    ],
    includes = [
        "include",
        "include/twist_mux",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "twist_marker",
    srcs = ["src/twist_marker.cpp"] + [
        "include/twist_mux/params_helpers.hpp",
        "include/twist_mux/topic_handle.hpp",
        "include/twist_mux/twist_mux.hpp",
        "include/twist_mux/twist_mux_diagnostics.hpp",
        "include/twist_mux/twist_mux_diagnostics_status.hpp",
        "include/twist_mux/utils.hpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/twist_mux",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "twist_mux",
    srcs = [
        "src/twist_mux.cpp",
        "src/twist_mux_diagnostics.cpp",
        "src/twist_mux_node.cpp",
    ] + [
        "include/twist_mux/params_helpers.hpp",
        "include/twist_mux/topic_handle.hpp",
        "include/twist_mux/twist_mux.hpp",
        "include/twist_mux/twist_mux_diagnostics.hpp",
        "include/twist_mux/twist_mux_diagnostics_status.hpp",
        "include/twist_mux/utils.hpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/twist_mux",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

ament_index(
    name = "ament_index",
    data = [
        "config/joystick.yaml",
        "config/twist_mux_locks.yaml",
        "config/twist_mux_topics.yaml",
        "//launch:launch_files",
    ],
    lib_data = [
        ":twist_marker",
        ":twist_mux",
        "scripts/joystick_relay.py",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@std_msgs//:ament_package",
        "@twist_mux_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "diagnostic_updater",
        "geometry_msgs",
        "rclcpp",
        "std_msgs",
        "visualization_msgs",
    ],
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/twist_mux/params_helpers.hpp",
        "include/twist_mux/topic_handle.hpp",
        "include/twist_mux/twist_mux.hpp",
        "include/twist_mux/twist_mux_diagnostics.hpp",
        "include/twist_mux/twist_mux_diagnostics_status.hpp",
        "include/twist_mux/utils.hpp",
    ],
    include_prefix = "",
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@std_msgs//:ament_package",
        "@twist_mux_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
