load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.algorithm",
    "@std_msgs//:cc",
    "@twist_mux_msgs//:cc",
    "@visualization_msgs//:cc",
]

cc_library(
    name = "twist_mux_library",
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/twist_mux",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "twist_marker",
    srcs = ["src/twist_marker.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/twist_mux",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "twist_mux",
    srcs = [
        "src/twist_mux.cpp",
        "src/twist_mux_diagnostics.cpp",
        "src/twist_mux_node.cpp",
    ] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/twist_mux",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

pkg_files(
    name = "pkg_files_extra_0",
    srcs = ["scripts/joystick_relay.py"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "lib/twist_mux",
)

ament_index(
    name = "ament_index",
    data = [
        "config/joystick.yaml",
        "config/twist_mux_locks.yaml",
        "config/twist_mux_topics.yaml",
        "launch/twist_mux.launch",
        "launch/twist_mux_launch.py",
    ],
    lib_data = [
        ":twist_marker",
        ":twist_mux",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@std_msgs//:ament_package",
        "@twist_mux_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)

py_pytest(
    name = "test_test_joystick_relay.py",
    srcs = ["test/test_joystick_relay.py"],
    args = [
        "-p",
        "launch_testing.pytest.hooks",
    ],
    data = [
        ":ament_index",
        ":twist_marker",
        ":twist_mux",
    ],
    deps = [
        "@diagnostic_updater//:diagnostic_updater_py",
        "@geometry_msgs//:py",
        "@launch",
        "@launch//:test_support",
        "@launch_testing",
        "@launch_testing_ros",
        "@std_msgs//:py",
        "@twist_mux_msgs//:py",
        "@visualization_msgs//:py",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "std_msgs",
        "geometry_msgs",
        "visualization_msgs",
        "diagnostic_updater",
    ],
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    install = [":pkg_files_extra_0"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@std_msgs//:ament_package",
        "@twist_mux_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
