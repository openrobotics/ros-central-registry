load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@pip_ros//:requirements.bzl", "requirement")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

launch_ros_test(
    name = "test_test_joystick_relay",
    src = "test_joystick_relay.py",
    data = [
        "//:ament_index",
        "//:twist_marker",
        "//:twist_mux",
    ],
    # xfail: fails under Bazel: ########################################
    tags = [
        "manual",
        "xfail",
    ],
    deps = [
        "@diagnostic_updater//:diagnostic_updater_py",
        "@geometry_msgs//:py",
        "@launch//:test_support",
        "@launch_ros",
        "@std_msgs//:py",
        "@twist_mux_msgs//:py",
        "@visualization_msgs//:py",
        requirement("numpy"),
        "@rclpy",
    ],
)
