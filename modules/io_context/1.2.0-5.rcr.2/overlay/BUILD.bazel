load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:asio": "@rosdistro//cc:asio_library",
}

cc_library(
    name = "io_context_library",
    srcs = [
        "src/io_context.cpp",
        "src/msg_converters/std_msgs.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@std_msgs//:cc",
        "@udp_msgs//:cc",
    ],
)

cc_shared_library(
    name = "io_context",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":io_context_library"],
    deps = [":io_context_library"],
)

### TESTS

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":io_context"],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_io_context",
    srcs = ["test/test_io_context.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":io_context_library",
        "@rosdistro//cc:googletest",
        "@std_msgs//:cc",
        "@udp_msgs//:cc",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = ["io_context-extras.cmake"],
    cmake_export_dependencies_list = [
        "rclcpp",
        "std_msgs",
        "udp_msgs",
        "asio_cmake_module",
    ],
    cmake_export_targets = False,
    cmake_extras = ["io_context-extras.cmake"],
    headers = HEADERS,
    libraries = [":io_context"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@asio_cmake_module//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
        "@udp_msgs//:ament_package",
    ],
)
