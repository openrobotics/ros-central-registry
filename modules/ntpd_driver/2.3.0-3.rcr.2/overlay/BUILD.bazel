load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:poco_foundation_shared": "@rosdistro//cc:poco_foundation",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "ntpddriver_library",
    srcs = ["src/NtpdShmDriver.cpp"],
    hdrs = ["include/ntpd_driver/NtpdShmDriver.hpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/ntpd_driver",
    ],
    local_defines = ros_local_defines() + [
        "POCO_CMAKE",
        "POCO_ENABLE_CPP11",
        "POCO_ENABLE_CPP14",
        "POCO_HAVE_FD_EPOLL",
        "POCO_OS_FAMILY_UNIX",
        "POCO_UNBUNDLED",
        "_FILE_OFFSET_BITS=64",
        "_LARGEFILE64_SOURCE",
        "_REENTRANT",
        "_THREAD_SAFE",
        "_XOPEN_SOURCE=500",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ntpddriver",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":ntpddriver_library"],
)

rclcpp_components_register_nodes(
    name = "ntpddriver_components",
    component = ":ntpddriver",
    plugins = ["ntpd_driver::NtpdShmDriver"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ntpddriver"],
)

cc_binary(
    name = "shm_driver",
    srcs = ["src/shm_driver_node.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/ntpd_driver",
    ],
    local_defines = ros_local_defines() + [
        "POCO_CMAKE",
        "POCO_ENABLE_CPP11",
        "POCO_ENABLE_CPP14",
        "POCO_HAVE_FD_EPOLL",
        "POCO_OS_FAMILY_UNIX",
        "POCO_UNBUNDLED",
        "_FILE_OFFSET_BITS=64",
        "_LARGEFILE64_SOURCE",
        "_REENTRANT",
        "_THREAD_SAFE",
        "_XOPEN_SOURCE=500",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":ntpddriver_library"],
)

ament_index(
    name = "ament_index",
    components = [":ntpddriver_components"],
    data = ["//launch:launch_files"],
    libraries = [":ntpddriver"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    executables = [
        ":shm_driver",
    ],
    libraries = [":ntpddriver"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
