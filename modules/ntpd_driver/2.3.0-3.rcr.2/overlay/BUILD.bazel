load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
]

cc_library(
    name = "ntpddriver_library",
    srcs = [":gen_ntpd_driver_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/ntpd_driver",
    ],
    local_defines = ros_local_defines() + [
        "POCO_CMAKE",
        "POCO_ENABLE_CPP11",
        "POCO_ENABLE_CPP14",
        "POCO_HAVE_FD_EPOLL",
        "POCO_OS_FAMILY_UNIX",
        "POCO_UNBUNDLED",
        "_FILE_OFFSET_BITS=64",
        "_LARGEFILE64_SOURCE",
        "_REENTRANT",
        "_THREAD_SAFE",
        "_XOPEN_SOURCE=500",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ntpddriver",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":ntpddriver_library"],
)

rclcpp_components_register_nodes(
    name = "ntpddriver_components",
    component = ":ntpddriver",
    plugins = ["ntpd_driver::NtpdShmDriver"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ntpddriver"],
)

cc_binary(
    name = "shm_driver",
    srcs = [":gen_ntpd_driver_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/ntpd_driver",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines() + [
        "POCO_CMAKE",
        "POCO_ENABLE_CPP11",
        "POCO_ENABLE_CPP14",
        "POCO_HAVE_FD_EPOLL",
        "POCO_OS_FAMILY_UNIX",
        "POCO_UNBUNDLED",
        "_FILE_OFFSET_BITS=64",
        "_LARGEFILE64_SOURCE",
        "_REENTRANT",
        "_THREAD_SAFE",
        "_XOPEN_SOURCE=500",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":ntpddriver_library"],
)

write_file(
    name = "gen_ntpd_driver_stub_cpp",
    out = "_gen/ntpd_driver_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    components = [":ntpddriver_components"],
    data = ["launch/chrony.launch.xml"],
    lib_data = [":shm_driver"],
    libraries = [":ntpddriver"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    libraries = [":ntpddriver"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
