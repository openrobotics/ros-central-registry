--- a/test/cases/stop_watch.cpp
+++ b/test/cases/stop_watch.cpp
@@ -19,14 +19,22 @@
 #include <chrono>
 #include <thread>
 
+// macOS timers are coalesced: each 10 ms sleep_for() can wake up to ~5 ms late,
+// so the tolerance has to cover the accumulated overshoot there.
+#if defined(__APPLE__)
+constexpr double kTocTolerance = 0.012;
+#else
+constexpr double kTocTolerance = 0.001;
+#endif
+
 TEST(TestStopWatch, Default)
 {
   autoware_utils_system::StopWatch sw;
   sw.tic();
   std::this_thread::sleep_for(std::chrono::milliseconds(10));
-  EXPECT_NEAR(sw.toc(), 0.01, 0.001);
+  EXPECT_NEAR(sw.toc(), 0.01, kTocTolerance);
   std::this_thread::sleep_for(std::chrono::milliseconds(10));
-  EXPECT_NEAR(sw.toc(), 0.02, 0.001);
+  EXPECT_NEAR(sw.toc(), 0.02, kTocTolerance);
 }
 
 TEST(TestStopWatch, Named)
@@ -34,9 +42,9 @@
   autoware_utils_system::StopWatch sw;
   sw.tic("foo");
   std::this_thread::sleep_for(std::chrono::milliseconds(10));
-  EXPECT_NEAR(sw.toc("foo"), 0.01, 0.001);
+  EXPECT_NEAR(sw.toc("foo"), 0.01, kTocTolerance);
   std::this_thread::sleep_for(std::chrono::milliseconds(10));
-  EXPECT_NEAR(sw.toc("foo"), 0.02, 0.001);
+  EXPECT_NEAR(sw.toc("foo"), 0.02, kTocTolerance);
 }
 
 TEST(TestStopWatch, Mixed)
@@ -46,8 +54,8 @@
   std::this_thread::sleep_for(std::chrono::milliseconds(10));
   sw.tic("bar");
   std::this_thread::sleep_for(std::chrono::milliseconds(10));
-  EXPECT_NEAR(sw.toc("foo"), 0.02, 0.001);
-  EXPECT_NEAR(sw.toc("bar"), 0.01, 0.001);
+  EXPECT_NEAR(sw.toc("foo"), 0.02, kTocTolerance);
+  EXPECT_NEAR(sw.toc("bar"), 0.01, kTocTolerance);
 }
 
