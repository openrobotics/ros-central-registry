load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "autoware_utils_system_library",
    srcs = ["src/backtrace.cpp"],
    hdrs = [
        "include/autoware_utils_system/backtrace.hpp",
        "include/autoware_utils_system/lru_cache.hpp",
        "include/autoware_utils_system/stop_watch.hpp",
    ],
    includes = ["include"],
    deps = ["@rclcpp//:rclcpp_library"],
)

cc_shared_library(
    name = "autoware_utils_system",
    dynamic_deps = ["@rclcpp"],
    exports_filter = ["//:__subpackages__"],
    deps = [":autoware_utils_system_library"],
)

ament_package(
    name = "ament_package",
    cmake_export_targets = False,
    headers = [
        "include/autoware_utils_system/backtrace.hpp",
        "include/autoware_utils_system/lru_cache.hpp",
        "include/autoware_utils_system/stop_watch.hpp",
    ],
    libraries = [":autoware_utils_system"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@autoware_cmake//:ament_package",
        "@autoware_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
