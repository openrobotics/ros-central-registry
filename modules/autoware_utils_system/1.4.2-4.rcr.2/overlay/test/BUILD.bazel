load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

cc_test(
    name = "test_autoware_utils_system",
    srcs = [
        "cases/backtrace.cpp",
        "cases/lru_cache.cpp",
        "cases/stop_watch.cpp",
        "main.cpp",
    ],
    # Flaky under parallel test load (passes when run alone), so run it exclusively.
    tags = ["exclusive"],
    deps = [
        "//:autoware_utils_system_library",
        "@rosdistro//cc:googletest",
    ],
)
