load("@qt//:qt.bzl", "qt_cc_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/vision_msgs_rviz_plugins/bounding_box_3d.hpp",
    "include/vision_msgs_rviz_plugins/bounding_box_3d_array.hpp",
    "include/vision_msgs_rviz_plugins/bounding_box_3d_common.hpp",
    "include/vision_msgs_rviz_plugins/detection_3d.hpp",
    "include/vision_msgs_rviz_plugins/detection_3d_array.hpp",
    "include/vision_msgs_rviz_plugins/detection_3d_common.hpp",
    "include/vision_msgs_rviz_plugins/visibility_control.hpp",
]

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:OgreMain": "@rosdistro//cc:OgreMain_library",
    "@rosdistro//cc:OgreOverlay": "@rosdistro//cc:OgreOverlay_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:curl": "@rosdistro//cc:curl_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rviz_common//:rviz_common": "@rviz_common//:rviz_common_library",
    "@rviz_default_plugins//:rviz_default_plugins": "@rviz_default_plugins//:rviz_default_plugins_library",
    "@rviz_rendering//:rviz_rendering": "@rviz_rendering//:rviz_rendering_library",
    "@vision_msgs//:cc_shared": "@vision_msgs//:cc",
}

qt_cc_library(
    name = "vision_msgs_rviz_plugins_library",
    srcs = [
        "src/bounding_box_3d.cpp",
        "src/bounding_box_3d_array.cpp",
        "src/detection_3d.cpp",
        "src/detection_3d_array.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + [
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "QT_NO_KEYWORDS",
        "RVIZ_DEFAULT_PLUGINS_BUILDING_LIBRARY",
    ],
    deps = DEPENDENCIES.values() + [
        "@qtbase//:widgets",
    ],
)

cc_shared_library(
    name = "vision_msgs_rviz_plugins",
    dynamic_deps = DEPENDENCIES.keys() + ["@qtbase//:widgets_shared"],
    exports_filter = ["//:__subpackages__"],
    deps = [":vision_msgs_rviz_plugins_library"],
)

DATA = [
    "conf/conf.rviz",
    "conf/example.yaml",
    "icons/classes/BoundingBox3D.png",
    "icons/classes/BoundingBox3DArray.png",
    "icons/classes/Detection3D.png",
    "icons/classes/Detection3DArray.png",
] + ["//launch:launch_files"]

ament_index(
    name = "ament_index",
    data = DATA,
    lib_data = [
        "samples/BoundingBox3D.py",
        "samples/BoundingBox3DArray.py",
        "samples/Detection3D.py",
        "samples/Detection3DArray.py",
    ],
    libraries = [":vision_msgs_rviz_plugins"],
    package_xml = "package.xml",
    plugin_category = "rviz_common",
    plugins = ["plugins_description.xml"],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rclcpp",
        "rviz_common",
        "rviz_rendering",
        "vision_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    headers = HEADERS,
    include_prefix = "",
    libraries = [":vision_msgs_rviz_plugins"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_default_plugins//:ament_package",
        "@rviz_rendering//:ament_package",
        "@vision_msgs//:ament_package",
        "@yaml_cpp_vendor//:ament_package",
    ],
)
