load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            ".coveragerc",
            ".github/workflows/test.yml",
            "CHANGELOG.rst",
            "CONTRIBUTING.md",
            "LICENSE",
            "README.md",
            "nodl_to_policy/__init__.py",
            "nodl_to_policy/command/__init__.py",
            "nodl_to_policy/command/nodl_to_policy.py",
            "nodl_to_policy/common/__init__.py",
            "nodl_to_policy/common/node.xml",
            "nodl_to_policy/common/node/logging.xml",
            "nodl_to_policy/common/node/parameters.xml",
            "nodl_to_policy/common/node/time.xml",
            "nodl_to_policy/common/profile.py",
            "nodl_to_policy/policy.py",
            "nodl_to_policy/verb/__init__.py",
            "nodl_to_policy/verb/convert.py",
            "package.xml",
            "pytest.ini",
            "resource/nodl_to_policy",
            "setup.cfg",
            "setup.py",
            "test/nodl_to_policy/command/test_nodl_to_policy.py",
            "test/nodl_to_policy/common/test_profile.py",
            "test/nodl_to_policy/conftest.py",
            "test/nodl_to_policy/fixtures/common_profile.xml",
            "test/nodl_to_policy/fixtures/test.nodl.xml",
            "test/nodl_to_policy/fixtures/test.policy.xml",
            "test/nodl_to_policy/fixtures/test_invalid.nodl.xml",
            "test/nodl_to_policy/test_policy.py",
            "test/nodl_to_policy/verb/test_convert.py",
            "test/test_copyright.py",
            "test/test_flake8.py",
            "test/test_mypy.py",
            "test/test_pep257.py",
            "test/test_pycodestyle.py",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "mypy",
        "pep257",
        "pycodestyle",
    ]
]

py_library(
    name = "nodl_to_policy",
    srcs = [
        "nodl_to_policy/__init__.py",
        "nodl_to_policy/command/__init__.py",
        "nodl_to_policy/command/nodl_to_policy.py",
        "nodl_to_policy/common/__init__.py",
        "nodl_to_policy/common/profile.py",
        "nodl_to_policy/policy.py",
        "nodl_to_policy/verb/__init__.py",
        "nodl_to_policy/verb/convert.py",
    ],
    imports = ["."],
    deps = [
        "@ros2cli",
        "@ros2nodl",
        "@ros2run",
        "@sros2",
        "@test_msgs//:py",
        requirement("argcomplete"),
        requirement("lxml"),
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":nodl_to_policy"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_pycodestyle//:ament_package",
        "@ros2cli//:ament_package",
        "@ros2nodl//:ament_package",
        "@ros2run//:ament_package",
        "@ros_testing//:ament_package",
        "@rosdistro//:ament_package",
        "@sros2//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
