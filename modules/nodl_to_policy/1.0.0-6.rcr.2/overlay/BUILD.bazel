load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "mypy",
        "pep257",
        "pycodestyle",
    ]
]

py_library(
    name = "nodl_to_policy",
    srcs = glob(["nodl_to_policy/**/*.py"]),
    imports = ["."],
    deps = [
        "@ros2cli",
        "@ros2nodl",
        "@ros2run",
        "@sros2",
        "@test_msgs//:py",
        requirement("argcomplete"),
        requirement("lxml"),
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":nodl_to_policy"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_pycodestyle//:ament_package",
        "@ros2cli//:ament_package",
        "@ros2nodl//:ament_package",
        "@ros2run//:ament_package",
        "@ros_testing//:ament_package",
        "@rosdistro//:ament_package",
        "@sros2//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
