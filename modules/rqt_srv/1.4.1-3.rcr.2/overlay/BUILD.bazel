load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

exports_files(["package.xml"])

### DATA

ament_index(
    name = "ament_index",
    data = ["plugin.xml"],
    package_xml = "package.xml",
)

### LIBRARIES

py_library(
    name = "rqt_srv",
    srcs = [
        "src/rqt_srv/__init__.py",
        "src/rqt_srv/main.py",
        "src/rqt_srv/services.py",
    ],
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@rqt_gui",
        "@rqt_gui_py",
        "@rqt_msg",
    ],
)

### EXECUTABLES

py_binary(
    name = "gui",
    srcs = ["src/rqt_srv/main.py"],
    args = ["--force-discover"],
    main = "src/rqt_srv/main.py",
    deps = [":rqt_srv"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"rqt_srv": "rqt_srv.main:main"},
    package_xml = "package.xml",
    python = [":rqt_srv"],
    python_strip_prefix = "src",
    setup_cfg = "setup.cfg",
    deps = [
        ":ament_index",
        "@ament_flake8//:ament_package",
        "@ament_xmllint//:ament_package",
        "@rosdistro//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@rqt_msg//:ament_package",
    ],
)
