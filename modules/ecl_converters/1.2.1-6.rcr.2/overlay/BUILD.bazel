load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@ecl_errors//:ecl_errors": "@ecl_errors//:ecl_errors_library",
    "@ecl_exceptions//:ecl_exceptions": "@ecl_exceptions//:ecl_exceptions_library",
    "@ecl_type_traits//:ecl_type_traits": "@ecl_type_traits//:ecl_type_traits_library",
}

CC_DEPS = [
    "@ecl_concepts//:ecl_concepts",
    "@ecl_concepts//:ecl_concepts_library",
    "@ecl_config//:ecl_config",
    "@ecl_config//:ecl_config_library",
    "@ecl_mpl//:ecl_mpl",
    "@ecl_mpl//:ecl_mpl_library",
]

cc_library(
    name = "ecl_converters_library",
    hdrs = [
        "include/ecl/converters.hpp",
        "include/ecl/converters/char.hpp",
        "include/ecl/converters/char_strings.hpp",
        "include/ecl/converters/converter.hpp",
        "include/ecl/converters/from_byte_array.hpp",
        "include/ecl/converters/integers.hpp",
        "include/ecl/converters/string.hpp",
        "include/ecl/converters/to_byte_array.hpp",
    ],
    includes = [
        "include",
        "src/test",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "demo_float_converters",
    srcs = ["src/examples/float_converters.cpp"] + [
        "include/ecl/converters.hpp",
        "include/ecl/converters/char.hpp",
        "include/ecl/converters/char_strings.hpp",
        "include/ecl/converters/converter.hpp",
        "include/ecl/converters/from_byte_array.hpp",
        "include/ecl/converters/integers.hpp",
        "include/ecl/converters/string.hpp",
        "include/ecl/converters/to_byte_array.hpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "src/test",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

ament_index(
    name = "ament_index",
    lib_data = [":demo_float_converters"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ecl_build//:ament_package",
        "@ecl_concepts//:ament_package",
        "@ecl_config//:ament_package",
        "@ecl_errors//:ament_package",
        "@ecl_exceptions//:ament_package",
        "@ecl_license//:ament_package",
        "@ecl_mpl//:ament_package",
        "@ecl_type_traits//:ament_package",
    ],
)

cc_test(
    name = "ecl_test_byte_array_converters",
    srcs = ["src/test/byte_array_converters.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "src/test",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":ecl_converters_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "ecl_test_converters",
    srcs = ["src/test/converters.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "src/test",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":ecl_converters_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "ecl_concepts",
        "ecl_config",
        "ecl_errors",
        "ecl_exceptions",
        "ecl_mpl",
        "ecl_type_traits",
    ],
    cmake_export_libraries = False,
    headers = [
        "include/ecl/converters.hpp",
        "include/ecl/converters/char.hpp",
        "include/ecl/converters/char_strings.hpp",
        "include/ecl/converters/converter.hpp",
        "include/ecl/converters/from_byte_array.hpp",
        "include/ecl/converters/integers.hpp",
        "include/ecl/converters/string.hpp",
        "include/ecl/converters/to_byte_array.hpp",
    ],
    include_prefix = "",
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ecl_build//:ament_package",
        "@ecl_concepts//:ament_package",
        "@ecl_config//:ament_package",
        "@ecl_errors//:ament_package",
        "@ecl_exceptions//:ament_package",
        "@ecl_license//:ament_package",
        "@ecl_mpl//:ament_package",
        "@ecl_type_traits//:ament_package",
    ],
)
