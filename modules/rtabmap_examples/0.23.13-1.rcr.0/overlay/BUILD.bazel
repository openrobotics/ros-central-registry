load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

ament_index(
    name = "ament_index",
    data = [
        "config/euroc_left.yaml",
        "config/euroc_right.yaml",
        "config/multi_rgbd_inertial_dataset.ini",
        "config/multi_rgbd_inertial_dataset_front.yaml",
        "config/multi_rgbd_inertial_dataset_left.yaml",
        "config/multi_rgbd_inertial_dataset_rear.yaml",
        "config/multi_rgbd_inertial_dataset_right.yaml",
        "config/slam_D405x2_config.rviz",
        "config/slam_D405x3_config.rviz",
        "//launch:launch_files",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@imu_filter_madgwick//:ament_package",
        "@realsense2_camera//:ament_package",
        "@rtabmap_odom//:ament_package",
        "@rtabmap_rviz_plugins//:ament_package",
        "@rtabmap_slam//:ament_package",
        "@rtabmap_util//:ament_package",
        "@rtabmap_viz//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@imu_filter_madgwick//:ament_package",
        "@realsense2_camera//:ament_package",
        "@rtabmap_odom//:ament_package",
        "@rtabmap_rviz_plugins//:ament_package",
        "@rtabmap_slam//:ament_package",
        "@rtabmap_util//:ament_package",
        "@rtabmap_viz//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
