load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "config/euroc_left.yaml",
        "config/euroc_right.yaml",
        "config/multi_rgbd_inertial_dataset.ini",
        "config/multi_rgbd_inertial_dataset_front.yaml",
        "config/multi_rgbd_inertial_dataset_left.yaml",
        "config/multi_rgbd_inertial_dataset_rear.yaml",
        "config/multi_rgbd_inertial_dataset_right.yaml",
        "config/slam_D405x2_config.rviz",
        "config/slam_D405x3_config.rviz",
        "launch/depthai.launch.py",
        "launch/depthai_color.launch.py",
        "launch/depthai_stereo.launch.py",
        "launch/euroc_datasets.launch.py",
        "launch/k4a.launch.py",
        "launch/kinect_xbox_360.launch.py",
        "launch/lidar3d.launch.py",
        "launch/lidar3d_assemble.launch.py",
        "launch/lidar3d_assemble_x2.launch.py",
        "launch/multi_rgbd_inertial_dataset.launch.py",
        "launch/realsense_d400.launch.py",
        "launch/realsense_d435i_color.launch.py",
        "launch/realsense_d435i_color_composition.launch.py",
        "launch/realsense_d435i_combined.launch.py",
        "launch/realsense_d435i_infra.launch.py",
        "launch/realsense_d435i_infra_composition.launch.py",
        "launch/realsense_d435i_stereo.launch.py",
        "launch/realsense_d435i_stereo_composition.launch.py",
        "launch/rgbdslam_datasets.launch.py",
        "launch/rtabmap_D405x2.launch.py",
        "launch/rtabmap_D405x3.launch.py",
        "launch/vlp16_zed.launch.py",
        "launch/zed.launch.py",
        "launch/zed_composition.launch.py",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@imu_filter_madgwick//:ament_package",
        "@realsense2_camera//:ament_package",
        "@rtabmap_odom//:ament_package",
        "@rtabmap_rviz_plugins//:ament_package",
        "@rtabmap_slam//:ament_package",
        "@rtabmap_util//:ament_package",
        "@rtabmap_viz//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [":ament_index"],
    )
    for f in glob(["launch/**"])
]

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@imu_filter_madgwick//:ament_package",
        "@realsense2_camera//:ament_package",
        "@rtabmap_odom//:ament_package",
        "@rtabmap_rviz_plugins//:ament_package",
        "@rtabmap_slam//:ament_package",
        "@rtabmap_util//:ament_package",
        "@rtabmap_viz//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
