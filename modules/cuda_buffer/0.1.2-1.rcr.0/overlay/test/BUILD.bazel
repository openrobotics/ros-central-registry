load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

# ament_add_gtest(test_cuda_buffer). Its fixture creates a CUDA stream and
# allocates device memory unconditionally, so it needs a GPU and driver:
# run it explicitly on a GPU host with
#   bazel test --config=cuda @cuda_buffer//test:test_cuda_buffer
cc_test(
    name = "test_cuda_buffer",
    srcs = ["test_cuda_buffer.cpp"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    tags = [
        "manual",
        "requires-gpu",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//:cuda_buffer_library",
        "@rosdistro//cc:cuda_driver",
        "@rosdistro//cc:cuda_runtime",
        "@rosdistro//cc:googletest",
    ],
)
