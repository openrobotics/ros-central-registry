### PACKAGING

ament_index(
    name = "ament_index",
    libraries = [":lanelet2_routing"],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    build_type = "cmake",
    cmake_export_targets = False,
    headers = HEADERS,
    include_prefix = "",
    libraries = [":lanelet2_routing"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_core//:ament_package",
        "@lanelet2_core//:ament_package",
        "@lanelet2_traffic_rules//:ament_package",
        "@mrt_cmake_modules//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
