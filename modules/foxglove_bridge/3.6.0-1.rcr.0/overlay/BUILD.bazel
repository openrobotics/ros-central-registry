load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@resource_retriever//:resource_retriever": "@resource_retriever//:resource_retriever_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp": "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp_library",
    "@rosx_introspection//:rosx_introspection": "@rosx_introspection//:rosx_introspection_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rcl_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:nlohmann_json",
    "@rosgraph_msgs//:cc",
    "@sensor_msgs//:cc",
    "@service_msgs//:cc",
    "@std_msgs//:cc",
    "@std_srvs//:cc",
    "@test_msgs//:cc",
]

alias(
    name = "foxglove_library",
    actual = "@rosdistro//cc:foxglove_sdk_library",
)

alias(
    name = "foxglove",
    actual = "@rosdistro//cc:foxglove_sdk",
)

alias(
    name = "foxglove_cpp_shared_library",
    actual = "@rosdistro//cc:foxglove_sdk_library",
)

alias(
    name = "foxglove_cpp_shared",
    actual = "@rosdistro//cc:foxglove_sdk",
)

cc_library(
    name = "foxglove_bridge_component_library",
    srcs = [
        "src/generic_client.cpp",
        "src/message_definition_cache.cpp",
        "src/param_utils.cpp",
        "src/parameter_interface.cpp",
        "src/ros2_foxglove_bridge.cpp",
    ],
    hdrs = [
        "include/foxglove_bridge/cdr_serializer.hpp",
        "include/foxglove_bridge/common.hpp",
        "include/foxglove_bridge/generic_client.hpp",
        "include/foxglove_bridge/message_definition_cache.hpp",
        "include/foxglove_bridge/param_utils.hpp",
        "include/foxglove_bridge/parameter_interface.hpp",
        "include/foxglove_bridge/ros2_foxglove_bridge.hpp",
        "include/foxglove_bridge/utils.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/foxglove_bridge",
    ],
    local_defines = ros_local_defines() + [
        "FOXGLOVE_REMOTE_ACCESS",
        "NDEBUG",
        "RESOURCE_RETRIEVER_VERSION_MAJOR=3",
        "RESOURCE_RETRIEVER_VERSION_MINOR=9",
        "RESOURCE_RETRIEVER_VERSION_PATCH=3",
        "_FILE_OFFSET_BITS=64",
        "span_CONFIG_SELECT_SPAN=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":foxglove_cpp_shared_library"],
)

cc_shared_library(
    name = "foxglove_bridge_component",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":foxglove_bridge_component_library"],
)

rclcpp_components_register_nodes(
    name = "foxglove_bridge_component_components",
    component = ":foxglove_bridge_component",
    plugins = ["foxglove_bridge::FoxgloveBridge"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "foxglove_bridge",
    srcs = ["src/ros2_foxglove_bridge_node.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/foxglove_bridge",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines() + [
        "FOXGLOVE_REMOTE_ACCESS",
        "NDEBUG",
        "_FILE_OFFSET_BITS=64",
        "span_CONFIG_SELECT_SPAN=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":foxglove_bridge_component_library",
        ":foxglove_cpp_shared_library",
    ],
)

ament_index(
    name = "ament_index",
    components = [":foxglove_bridge_component_components"],
    data = ["//launch:launch_files"],
    lib_data = [":foxglove_bridge"],
    libraries = [
        ":foxglove",
        ":foxglove_cpp_shared",
        ":foxglove_bridge_component",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@resource_retriever//:ament_package",
        "@ros_environment//:ament_package",
        "@rosgraph_msgs//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
        "@rosx_introspection//:ament_package",
        "@sensor_msgs//:ament_package",
        "@service_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@test_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_targets = False,
    headers = [
        "include/foxglove_bridge/cdr_serializer.hpp",
        "include/foxglove_bridge/common.hpp",
        "include/foxglove_bridge/generic_client.hpp",
        "include/foxglove_bridge/message_definition_cache.hpp",
        "include/foxglove_bridge/param_utils.hpp",
        "include/foxglove_bridge/parameter_interface.hpp",
        "include/foxglove_bridge/ros2_foxglove_bridge.hpp",
        "include/foxglove_bridge/utils.hpp",
        "include/foxglove_bridge/version.hpp.in",
    ],
    include_prefix = "",
    libraries = [
        ":foxglove",
        ":foxglove_cpp_shared",
        ":foxglove_bridge_component",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@resource_retriever//:ament_package",
        "@ros_environment//:ament_package",
        "@rosgraph_msgs//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
        "@rosx_introspection//:ament_package",
        "@sensor_msgs//:ament_package",
        "@service_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
