    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp": "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp_library",
    "@rosx_introspection//:rosx_introspection": "@rosx_introspection//:rosx_introspection_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rcl_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:nlohmann_json",
    "@rosdistro//cc:websocketpp",
    "@rosgraph_msgs//:cc",
    "@sensor_msgs//:cc",
    "@service_msgs//:cc",
    "@std_msgs//:cc",
    "@std_srvs//:cc",
    "@test_msgs//:cc",
]

cc_library(
    name = "foxglove_library",
    srcs = [":gen_foxglove_bridge_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/foxglove_bridge",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "foxglove",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":foxglove_library"],
)

cc_library(
    name = "foxglove_cpp_shared_library",
    srcs = [":gen_foxglove_bridge_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/foxglove_bridge",
    ],
    local_defines = ros_local_defines() + [
        "FOXGLOVE_REMOTE_ACCESS",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":foxglove_library"],
)

cc_shared_library(
    name = "foxglove_cpp_shared",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":foxglove_cpp_shared_library"],
)

cc_library(
    name = "foxglove_bridge_component_library",
    srcs = [":gen_foxglove_bridge_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/foxglove_bridge",
    ],
    local_defines = ros_local_defines() + [
        "FOXGLOVE_REMOTE_ACCESS",
        "NDEBUG",
        "RESOURCE_RETRIEVER_VERSION_MAJOR=3",
        "RESOURCE_RETRIEVER_VERSION_MINOR=9",
        "RESOURCE_RETRIEVER_VERSION_PATCH=3",
        "_FILE_OFFSET_BITS=64",
        "span_CONFIG_SELECT_SPAN=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":foxglove_cpp_shared_library"],
)

cc_shared_library(
    name = "foxglove_bridge_component",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":foxglove_bridge_component_library"],
)

rclcpp_components_register_nodes(
    name = "foxglove_bridge_component_components",
    component = ":foxglove_bridge_component",
    plugins = ["foxglove_bridge::FoxgloveBridge"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "foxglove_bridge",
    srcs = [":gen_foxglove_bridge_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/foxglove_bridge",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines() + [
        "FOXGLOVE_REMOTE_ACCESS",
        "NDEBUG",
        "_FILE_OFFSET_BITS=64",
        "span_CONFIG_SELECT_SPAN=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":foxglove_bridge_component_library",
        ":foxglove_cpp_shared_library",
    ],
)

write_file(
    name = "gen_foxglove_bridge_stub_cpp",
    out = "_gen/foxglove_bridge_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
