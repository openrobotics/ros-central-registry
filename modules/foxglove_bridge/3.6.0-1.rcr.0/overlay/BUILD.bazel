    components = [":foxglove_bridge_component_components"],
    data = [
        "launch/foxglove_bridge_launch.xml",
    ],
    lib_data = [
        ":foxglove_bridge",
    ],
    libraries = [
        ":foxglove",
        ":foxglove_cpp_shared",
        ":foxglove_bridge_component",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@resource_retriever//:ament_package",
        "@ros_environment//:ament_package",
        "@rosgraph_msgs//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
        "@rosx_introspection//:ament_package",
        "@sensor_msgs//:ament_package",
        "@service_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@test_msgs//:ament_package",
    ],
)

