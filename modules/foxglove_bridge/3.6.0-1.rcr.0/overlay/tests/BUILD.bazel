cc_test(
    name = "cdr_serializer_test",
    srcs = ["cdr_serializer_test.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "FOXGLOVE_REMOTE_ACCESS",
        "GTEST_HAS_PTHREAD=1",
        "NDEBUG",
        "_FILE_OFFSET_BITS=64",
        "span_CONFIG_SELECT_SPAN=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:foxglove_bridge_component_library",
        "//:foxglove_cpp_shared_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

