load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:gpsd": "@rosdistro//cc:gpsd_library",
}

CC_DEPS = [
    "@gps_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
]

cc_library(
    name = "gpsd_client_library",
    srcs = [
        "src/client.cpp",
        "src/gpsd_parser_factory.cpp",
        "src/parsers/gpsd_parser_base.cpp",
    ],
    hdrs = [
        "include/gpsd_client/gpsd_parser.hpp",
        "include/gpsd_client/gpsd_parser_factory.hpp",
        "include/gpsd_client/parsers/gpsd_parser_base.hpp",
        "include/gpsd_client/parsers/gpsd_parser_v16.hpp",
        "include/gpsd_client/parsers/gpsd_parser_v9.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/gpsd_client",
    ],
    local_defines = ros_local_defines() + ["COMPOSITION_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "gpsd_client",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":gpsd_client_library"],
)

rclcpp_components_register_nodes(
    name = "gpsd_client_components",
    component = ":gpsd_client",
    plugins = ["gpsd_client::GPSDClientComponent"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":gpsd_client"],
)

ament_index(
    name = "ament_index",
    components = [":gpsd_client_components"],
    data = [
        "config/gpsd_client.yaml",
        "//launch:launch_files",
    ],
    libraries = [":gpsd_client"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@gps_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "ament_cmake",
        "rclcpp",
    ],
    cmake_export_include_directories = False,
    cmake_export_targets = False,
    libraries = [":gpsd_client"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@gps_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
