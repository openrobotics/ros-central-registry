+// Keep re-publishing the dynamic transform and spinning until both buffers
+// hold the transforms they are expected to, or `timeout` elapses. Matching
+// between the broadcasters and listeners (even within one process) is
+// asynchronous, and under some RMWs (e.g. rmw_zenoh_cpp, which goes through a
+// router) it can take longer than the fixed 10 x 10 ms these tests used to
+// spin for, so a fixed iteration count is racy. The assertions that follow
+// still decide pass/fail; this only removes the timing assumption.
+template<typename ReadyFn>
+static void publish_and_spin_until(
+  rclcpp::executors::SingleThreadedExecutor & executor,
+  tf2_ros::TransformBroadcaster & broadcaster,
+  geometry_msgs::msg::TransformStamped & dynamic_trans,
+  const rclcpp::Clock::SharedPtr & clock,
+  ReadyFn && ready,
+  std::chrono::seconds timeout = std::chrono::seconds(10))
+{
+  const auto deadline = std::chrono::steady_clock::now() + timeout;
+  // Always do a few iterations so the dynamic buffer has recent data.
+  for (int i = 0; i < 10 || (!ready() && std::chrono::steady_clock::now() < deadline); ++i) {
+    dynamic_trans.header.stamp = clock->now();
+    broadcaster.sendTransform(dynamic_trans);
+
+    executor.spin_some();
+    rclcpp::sleep_for(std::chrono::milliseconds(10));
+  }
+}
+
