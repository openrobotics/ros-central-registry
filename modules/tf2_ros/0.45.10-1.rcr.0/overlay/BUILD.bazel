load("@ament_cmake_gen_version_h//:defs.bzl", "generate_version_h")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

generate_version_h(
    name = "version_h",
    out = "include/tf2_ros/version.h",
)

HEADERS = [
    "include/tf2_ros/async_buffer_interface.h",
    "include/tf2_ros/async_buffer_interface.hpp",
    "include/tf2_ros/buffer.h",
    "include/tf2_ros/buffer.hpp",
    "include/tf2_ros/buffer_client.h",
    "include/tf2_ros/buffer_client.hpp",
    "include/tf2_ros/buffer_interface.h",
    "include/tf2_ros/buffer_interface.hpp",
    "include/tf2_ros/buffer_server.h",
    "include/tf2_ros/buffer_server.hpp",
    "include/tf2_ros/create_timer_interface.h",
    "include/tf2_ros/create_timer_interface.hpp",
    "include/tf2_ros/create_timer_ros.h",
    "include/tf2_ros/create_timer_ros.hpp",
    "include/tf2_ros/message_filter.h",
    "include/tf2_ros/message_filter.hpp",
    "include/tf2_ros/qos.hpp",
    "include/tf2_ros/static_transform_broadcaster.h",
    "include/tf2_ros/static_transform_broadcaster.hpp",
    "include/tf2_ros/static_transform_broadcaster_node.hpp",
    "include/tf2_ros/static_transform_broadcaster_visibility_control.h",
    "include/tf2_ros/static_transform_broadcaster_visibility_control.hpp",
    "include/tf2_ros/transform_broadcaster.h",
    "include/tf2_ros/transform_broadcaster.hpp",
    "include/tf2_ros/transform_listener.h",
    "include/tf2_ros/transform_listener.hpp",
    "include/tf2_ros/visibility_control.h",
    "include/tf2_ros/visibility_control.hpp",
] + [":version_h"]

DEPENDENCIES = {
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_msgs//:cc_shared": "@tf2_msgs//:cc",
}

cc_library(
    name = "tf2_ros_library",
    srcs = [
        "src/buffer.cpp",
        "src/buffer_client.cpp",
        "src/buffer_server.cpp",
        "src/create_timer_ros.cpp",
        "src/static_transform_broadcaster.cpp",
        "src/transform_broadcaster.cpp",
        "src/transform_listener.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["TF2_ROS_BUILDING_DLL"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "tf2_ros",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":tf2_ros_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":tf2_ros",
        "@builtin_interfaces//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@tf2_msgs//:cc_shared",
    ],
)

cc_library(
    name = "static_transform_broadcaster_node_library",
    srcs = ["src/static_transform_broadcaster_node.cpp"],
    hdrs = [
        "include/tf2_ros/async_buffer_interface.h",
        "include/tf2_ros/async_buffer_interface.hpp",
        "include/tf2_ros/buffer.h",
        "include/tf2_ros/buffer.hpp",
        "include/tf2_ros/buffer_client.h",
        "include/tf2_ros/buffer_client.hpp",
        "include/tf2_ros/buffer_interface.h",
        "include/tf2_ros/buffer_interface.hpp",
        "include/tf2_ros/buffer_server.h",
        "include/tf2_ros/buffer_server.hpp",
        "include/tf2_ros/create_timer_interface.h",
        "include/tf2_ros/create_timer_interface.hpp",
        "include/tf2_ros/create_timer_ros.h",
        "include/tf2_ros/create_timer_ros.hpp",
        "include/tf2_ros/message_filter.h",
        "include/tf2_ros/message_filter.hpp",
        "include/tf2_ros/qos.hpp",
        "include/tf2_ros/static_transform_broadcaster.h",
        "include/tf2_ros/static_transform_broadcaster.hpp",
        "include/tf2_ros/static_transform_broadcaster_node.hpp",
        "include/tf2_ros/static_transform_broadcaster_visibility_control.h",
        "include/tf2_ros/static_transform_broadcaster_visibility_control.hpp",
        "include/tf2_ros/transform_broadcaster.h",
        "include/tf2_ros/transform_broadcaster.hpp",
        "include/tf2_ros/transform_listener.h",
        "include/tf2_ros/transform_listener.hpp",
        "include/tf2_ros/visibility_control.h",
        "include/tf2_ros/visibility_control.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines() + ["STATIC_TRANSFORM_BROADCASTER_BUILDING_DLL"],
    deps = [
        ":tf2_ros_library",
        "@geometry_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rclcpp_components//:rclcpp_components_library",
        "@tf2_msgs//:cc",
    ],
)

cc_shared_library(
    name = "static_transform_broadcaster_node",
    dynamic_deps = [
        ":tf2_ros",
        "@builtin_interfaces//:cc_shared",
        "@geometry_msgs//:cc_shared",
        "@rclcpp//:rclcpp",
        "@rclcpp_components//:rclcpp_components",
        "@tf2_msgs//:cc_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":static_transform_broadcaster_node_library"],
)

rclcpp_components_register_nodes(
    name = "static_transform_broadcaster_nodes",
    component = ":static_transform_broadcaster_node",
    plugins = ["tf2_ros::StaticTransformBroadcasterNode"],
)

cc_binary(
    name = "buffer_server",
    srcs = ["src/buffer_server_main.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [":tf2_ros_library"],
)

cc_binary(
    name = "static_transform_publisher",
    srcs = ["src/static_transform_broadcaster_program.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        ":static_transform_broadcaster_node_library",
        ":tf2_ros_library",
    ],
)

cc_binary(
    name = "tf2_echo",
    srcs = ["src/tf2_echo.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [":tf2_ros_library"],
)

cc_binary(
    name = "tf2_monitor",
    srcs = ["src/tf2_monitor.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        ":tf2_ros_library",
    ],
)

ament_index(
    name = "ament_index",
    components = [":static_transform_broadcaster_nodes"],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    cmake_export_name = "export_tf2_ros",
    executables = [
        ":buffer_server",
        ":static_transform_publisher",
        ":tf2_echo",
        ":tf2_monitor",
    ],
    headers = HEADERS,
    libraries = [
        ":tf2_ros",
        ":static_transform_broadcaster_node",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@message_filters//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rcpputils//:ament_package",
        "@rosdistro//:ament_package",
        "@rosgraph_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_msgs//:ament_package",
    ],
)
