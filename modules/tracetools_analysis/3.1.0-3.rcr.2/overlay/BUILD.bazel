load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "mypy",
        "pep257",
        "xmllint",
    ]
]

py_library(
    name = "tracetools_analysis",
    srcs = glob(["tracetools_analysis/**/*.py"]),
    imports = ["."],
    deps = [
        "@tracetools_read",
        "@tracetools_trace",
        requirement("numpy"),
        requirement("packaging"),
    ],
)

py_pytest(
    name = "test_autoprocessor",
    srcs = ["test/tracetools_analysis/test_autoprocessor.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":tracetools_analysis"],
)

py_pytest(
    name = "test_data_model_util",
