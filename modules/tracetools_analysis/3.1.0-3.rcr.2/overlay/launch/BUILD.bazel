load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "lifecycle_states.launch.py",
        "memory_usage.launch.py",
        "pingpong.launch.py",
        "profile.launch.py",
    ],
)

launch_ros_binary(
    name = "lifecycle_states_launch",
    src = "lifecycle_states.launch.py",
    data = ["//:ament_index"],
    deps = [
        "//:tracetools_analysis",
        "@tracetools_launch",
    ],
)

launch_ros_binary(
    name = "memory_usage_launch",
    src = "memory_usage.launch.py",
    data = ["//:ament_index"],
    deps = [
        "//:tracetools_analysis",
        "@tracetools_launch",
        "@tracetools_trace",
    ],
)

launch_ros_binary(
    name = "pingpong_launch",
    src = "pingpong.launch.py",
    data = ["//:ament_index"],
    deps = [
        "//:tracetools_analysis",
        "@tracetools_launch",
    ],
)

launch_ros_binary(
    name = "profile_launch",
    src = "profile.launch.py",
    data = ["//:ament_index"],
    deps = [
        "//:tracetools_analysis",
        "@tracetools_launch",
        "@tracetools_trace",
    ],
)
