load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "pep257",
    ]
]

py_library(
    name = "ackermann_nlmpc",
    srcs = glob(["ackermann_nlmpc/**/*.py"]),
    imports = ["."],
    deps = [
        "@ackermann_msgs//:py",
        "@ackermann_nlmpc_msgs//:py",
        "@geometry_msgs//:py",
        "@nav_msgs//:py",
        "@std_msgs//:py",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "codegen/autompc_ros.c",
        "launch/ackermann_nlmpc.launch.py",
    ],
    package_xml = "package.xml",
)

launch_ros_binary(
    name = "ackermann_nlmpc.launch.py",
    src = "launch/ackermann_nlmpc.launch.py",
    data = [":ament_index"],
    deps = [":ackermann_nlmpc"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "ackermann_nlmpc_node": "ackermann_nlmpc.ackermann_nlmpc_node:main",
        "ackermann_sim_node": "ackermann_nlmpc.ackermann_sim_node:main",
        "trajectory_converter_node": "ackermann_nlmpc.trajectory_converter_node:main",
    },
    data = [
        "codegen/autompc_ros.c",
        "launch/ackermann_nlmpc.launch.py",
    ],
    package_xml = "package.xml",
    python = [":ackermann_nlmpc"],
    deps = [
        "@ackermann_msgs//:ament_package",
        "@ackermann_nlmpc_msgs//:ament_package",
        "@ament_pep257//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
