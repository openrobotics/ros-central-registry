load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["test/test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "ackermann_nlmpc/__init__.py",
        "ackermann_nlmpc/ackermann_nlmpc_node.py",
        "ackermann_nlmpc/ackermann_sim_node.py",
        "ackermann_nlmpc/trajectory_converter_node.py",
        "ackermann_nlmpc/utils.py",
        "codegen/autompc_ros.c",
        "examples/circ_backward.py",
        "examples/circ_forward.py",
        "examples/park_backward.py",
        "examples/park_forward.py",
        "package.xml",
        "resource/ackermann_nlmpc",
        "setup.cfg",
        "setup.py",
        "test/test_pep257.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in ["pep257"]]

py_library(
    name = "ackermann_nlmpc",
    srcs = [
        "ackermann_nlmpc/__init__.py",
        "ackermann_nlmpc/ackermann_nlmpc_node.py",
        "ackermann_nlmpc/ackermann_sim_node.py",
        "ackermann_nlmpc/trajectory_converter_node.py",
        "ackermann_nlmpc/utils.py",
    ],
    imports = ["."],
    deps = [
        "@ackermann_msgs//:py",
        "@ackermann_nlmpc_msgs//:py",
        "@geometry_msgs//:py",
        "@nav_msgs//:py",
        "@std_msgs//:py",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "codegen/autompc_ros.c",
        "//launch:launch_files",
    ],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    console_scripts = {
        "ackermann_nlmpc_node": "ackermann_nlmpc.ackermann_nlmpc_node:main",
        "ackermann_sim_node": "ackermann_nlmpc.ackermann_sim_node:main",
        "trajectory_converter_node": "ackermann_nlmpc.trajectory_converter_node:main",
    },
    package_xml = "package.xml",
    python = [":ackermann_nlmpc"],
    deps = [":ament_index"] + [
        "@ackermann_msgs//:ament_package",
        "@ackermann_nlmpc_msgs//:ament_package",
        "@ament_pep257//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
