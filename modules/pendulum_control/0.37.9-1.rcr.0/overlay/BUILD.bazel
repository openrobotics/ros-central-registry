load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@pendulum_msgs//:cc_shared": "@pendulum_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_library(
    name = "pendulum_control_headers",
    hdrs = [
        "include/pendulum_control/pendulum_controller.hpp",
        "include/pendulum_control/pendulum_motor.hpp",
        "include/pendulum_control/rtt_executor.hpp",
    ],
    includes = ["include"],
)

cc_binary(
    name = "pendulum_demo",
    srcs = ["src/pendulum_demo.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":pendulum_control_headers",
        "@rttest",
        "@tlsf_cpp",
    ],
)

cc_binary(
    name = "pendulum_logger",
    srcs = ["src/pendulum_logger.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":pendulum_control_headers",
        "@rttest",
    ],
)

cc_binary(
    name = "pendulum_teleop",
    srcs = ["src/pendulum_teleop.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":pendulum_control_headers",
        "@rttest",
    ],
)

write_file(
    name = "rmw_test_fixture_implementation_py",
    out = "rmw_test_fixture_implementation.py",
    content = [
        "def rmw_test_isolation_start(): pass",
        "def rmw_test_isolation_stop(): pass",
    ],
)

py_library(
    name = "rmw_test_fixture_implementation",
    srcs = [":rmw_test_fixture_implementation_py"],
    imports = ["."],
)

launch_ros_test(
    name = "test_pendulum",
    src = "//test:test_pendulum_py",
    data = [
        "//test:pendulum_demo.regex",
        "//test:pendulum_logger.regex",
    ],
    deps = [
        ":pendulum_demo",
        ":pendulum_logger",
        ":rmw_test_fixture_implementation",
    ],
)

launch_ros_test(
    name = "test_pendulum_teleop",
    src = "//test:test_pendulum_teleop_py",
    data = [
        "//test:execute_with_delay.py",
        "//test:pendulum_demo_teleop.regex",
        "//test:pendulum_teleop.txt",
    ],
    deps = [
        ":pendulum_demo",
        ":pendulum_teleop",
        ":rmw_test_fixture_implementation",
        "@ros2run",
    ],
)

ament_package(
    name = "ament_package",
    executables = [
        ":pendulum_demo",
        ":pendulum_logger",
        ":pendulum_teleop",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@launch//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@pendulum_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rmw_implementation_cmake//:ament_package",
        "@ros2run//:ament_package",
        "@rosdistro//:ament_package",
        "@rttest//:ament_package",
        "@tlsf_cpp//:ament_package",
    ],
)
