load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "launch.py",
        "launch_teleop2.py",
        "teleop_launch.py",
    ],
)

launch_ros_binary(
    name = "launch_launch",
    src = "launch.py",
    data = [
        "@crazyflie_description//:ament_package",
        "@crazyflie_server_py//:ament_package",
        "@crazyflie_sim//:ament_package",
    ],
    deps = [
        "//:teleop",
        "@ament_index_python",
        "@crazyflie_server_cpp//:crazyflie_server",
        "@crazyflie_server_py",
        "@crazyflie_sim",
        "@joy//:joy_node",
        "@motion_capture_tracking//:motion_capture_tracking_node",
        "@rviz2",
    ],
)

launch_ros_binary(
    name = "launch_teleop2_launch",
    src = "launch_teleop2.py",
    deps = [
        "//:teleop",
        "@ament_index_python",
        "@joy//:joy_node",
        "@motion_capture_tracking//:motion_capture_tracking_node",
    ],
)

launch_ros_binary(
    name = "teleop_launch",
    src = "teleop_launch.py",
    deps = [
        "//:teleop",
        "@joy//:joy_node",
    ],
)
