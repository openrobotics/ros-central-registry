load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@backward_ros//:backward": "@backward_ros//:backward_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:fmt",
]

cc_library(
    name = "ros2_fmt_logger_library",
    hdrs = [
        "include/ros2_fmt_logger/logger.hpp",
        "include/ros2_fmt_logger/rclcpp_formatters.hpp",
        "include/ros2_fmt_logger/ros2_fmt_logger.hpp",
    ],
    includes = [
        ".",
        "include",
        "include/ros2_fmt_logger",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "demo_ros2_fmt_logger",
    srcs = ["demo/demo_ros2_fmt_logger.cpp"] + [
        "include/ros2_fmt_logger/logger.hpp",
        "include/ros2_fmt_logger/rclcpp_formatters.hpp",
        "include/ros2_fmt_logger/ros2_fmt_logger.hpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/ros2_fmt_logger",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

register_ament_files(
    name = "ament_files_0",
    files = ["include/ros2_fmt_logger/logger.hpp"],
    prefix = "include/ros2_fmt_logger",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_1",
    files = ["include/ros2_fmt_logger/rclcpp_formatters.hpp"],
    prefix = "include/ros2_fmt_logger",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_2",
    files = ["include/ros2_fmt_logger/ros2_fmt_logger.hpp"],
    prefix = "include/ros2_fmt_logger",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_3",
    files = ["include/ros2_fmt_logger/logger.hpp"],
    prefix = "include/ros2_fmt_logger/ros2_fmt_logger",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_4",
    files = ["include/ros2_fmt_logger/rclcpp_formatters.hpp"],
    prefix = "include/ros2_fmt_logger/ros2_fmt_logger",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_5",
    files = ["include/ros2_fmt_logger/ros2_fmt_logger.hpp"],
    prefix = "include/ros2_fmt_logger/ros2_fmt_logger",
    strip_prefix = "*",
)

ament_index(
    name = "ament_index",
    lib_data = [":demo_ros2_fmt_logger"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@backward_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rcutils//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "backward_ros",
        "fmt",
        "rclcpp",
        "rcutils",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        ":ament_files_0",
        ":ament_files_1",
        ":ament_files_2",
        ":ament_files_3",
        ":ament_files_4",
        ":ament_files_5",
    ],
    include_prefix = "",
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@backward_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rcutils//:ament_package",
    ],
)
