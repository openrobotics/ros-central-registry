load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@ecl_threads//:ecl_threads": "@ecl_threads//:ecl_threads_library",
}

CC_DEPS = [
    "@ecl_config",
]

HEADERS = [
    "include/ecl/sigslots.hpp",
    "include/ecl/sigslots/macros.hpp",
    "include/ecl/sigslots/manager.hpp",
    "include/ecl/sigslots/signal.hpp",
    "include/ecl/sigslots/sigslot.hpp",
    "include/ecl/sigslots/slot.hpp",
    "include/ecl/sigslots/topic.hpp",
]

# Header-only library (upstream builds no library target).
cc_library(
    name = "ecl_sigslots_library",
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "demo_sigslots",
    srcs = ["src/examples/sigslots.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":ecl_sigslots_library"],
)

cc_binary(
    name = "demo_sigslots_manager",
    srcs = ["src/examples/sigslots_manager.cpp"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":ecl_sigslots_library"],
)

cc_test(
    name = "ecl_test_sigslots",
    srcs = ["src/test/sigslots.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":ecl_sigslots_library",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "ecl_config",
        "ecl_threads",
    ],
    executables = [
        ":demo_sigslots",
        ":demo_sigslots_manager",
    ],
    headers = HEADERS,
    include_prefix = "",
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ecl_build//:ament_package",
        "@ecl_config//:ament_package",
        "@ecl_license//:ament_package",
        "@ecl_threads//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
