load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
    "@live555_vendor//:BasicUsageEnvironment_library",
    "@live555_vendor//:UsageEnvironment_library",
    "@live555_vendor//:groupsock_library",
    "@live555_vendor//:liveMedia_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "rtsp_image_transport_library",
    srcs = [":gen_rtsp_image_transport_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_libavcodec_avcodec_h",
        ":gen_libavcodec_bsf_h",
        ":gen_libavcodec_version_h",
        ":gen_libavformat_avformat_h",
        ":gen_libavutil_imgutils_h",
        ":gen_libavutil_pixdesc_h",
        ":gen_libswscale_swscale_h",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = ["_gen/include"],
    local_defines = ros_local_defines() + [
        "CURRENT_RCLCPP_VERSION=2097155",
        "FFMPEG_HAS_HWFRAME_SUPPORT",
        "LIVE555_HAS_H265_SUPPORT",
        "LIVE555_HAS_VPX_SUPPORT",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rtsp_image_transport",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":rtsp_image_transport_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "publish_rtsp_stream",
    srcs = [":gen_rtsp_image_transport_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_libavcodec_avcodec_h",
        ":gen_libavcodec_bsf_h",
        ":gen_libavcodec_version_h",
        ":gen_libavformat_avformat_h",
        ":gen_libavutil_imgutils_h",
        ":gen_libavutil_pixdesc_h",
        ":gen_libswscale_swscale_h",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["_gen/include"],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "rtsp_camera_proxy",
    srcs = [":gen_rtsp_image_transport_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_libavcodec_avcodec_h",
        ":gen_libavcodec_bsf_h",
        ":gen_libavcodec_version_h",
        ":gen_libavformat_avformat_h",
        ":gen_libavutil_imgutils_h",
        ":gen_libavutil_pixdesc_h",
        ":gen_libswscale_swscale_h",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["_gen/include"],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

write_file(
    name = "gen_rtsp_image_transport_stub_cpp",
    out = "_gen/rtsp_image_transport_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

