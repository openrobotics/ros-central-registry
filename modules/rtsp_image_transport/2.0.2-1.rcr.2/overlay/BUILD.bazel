load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rosdistro//cc:ffmpeg_swscale_shared": "@rosdistro//cc:ffmpeg_swscale",
    "@rosdistro//cc:ffmpeg_avformat_shared": "@rosdistro//cc:ffmpeg_avformat",
    "@rosdistro//cc:ffmpeg_avcodec_shared": "@rosdistro//cc:ffmpeg_avcodec",
    "@rosdistro//cc:ffmpeg_avutil_shared": "@rosdistro//cc:ffmpeg_avutil",
    "@rosdistro//cc:ffmpeg_swresample_shared": "@rosdistro//cc:ffmpeg_swresample",
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
    "@live555_vendor//:BasicUsageEnvironment_library",
    "@live555_vendor//:UsageEnvironment_library",
    "@live555_vendor//:groupsock_library",
    "@live555_vendor//:liveMedia_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

# Equivalent of CMake's generate_export_header(rtsp_image_transport).
genrule(
    name = "export_h",
    outs = ["_gen/include/rtsp_image_transport_export.h"],
    cmd = """cat > $@ <<'EOF'
#ifndef RTSP_IMAGE_TRANSPORT_EXPORT_H
#define RTSP_IMAGE_TRANSPORT_EXPORT_H

#define RTSP_IMAGE_TRANSPORT_EXPORT __attribute__((visibility("default")))
#define RTSP_IMAGE_TRANSPORT_NO_EXPORT __attribute__((visibility("hidden")))
#define RTSP_IMAGE_TRANSPORT_DEPRECATED __attribute__ ((__deprecated__))
#define RTSP_IMAGE_TRANSPORT_DEPRECATED_EXPORT RTSP_IMAGE_TRANSPORT_EXPORT RTSP_IMAGE_TRANSPORT_DEPRECATED
#define RTSP_IMAGE_TRANSPORT_DEPRECATED_NO_EXPORT RTSP_IMAGE_TRANSPORT_NO_EXPORT RTSP_IMAGE_TRANSPORT_DEPRECATED

#endif  // RTSP_IMAGE_TRANSPORT_EXPORT_H
EOF
""",
)

# Equivalent of upstream's `ld -r -b binary rtsp_only.png`: embeds the
# "RTSP Only" test image and defines the _binary_rtsp_only_png_{start,end}
# symbols the executables reference.
genrule(
    name = "rtsp_only_asm",
    srcs = ["rtsp_only.png"],
    outs = ["_gen/rtsp_only.S"],
    cmd = "(" +
          "echo '.section .rodata'; " +
          "echo '.global _binary_rtsp_only_png_start'; " +
          "echo '.global _binary_rtsp_only_png_end'; " +
          "echo '_binary_rtsp_only_png_start:'; " +
          "od -An -v -tx1 $< | sed -E -e 's/^ +//' -e 's/ +$$//' -e '/^$$/d' -e 's/ +/,0x/g' -e 's/^/.byte 0x/'; " +
          "echo '_binary_rtsp_only_png_end:'; " +
          "echo '.section .note.GNU-stack,\"\",@progbits'" +
          ") > $@",
)

cc_library(
    name = "rtsp_image_transport_library",
    srcs = [
        "src/frame_data.cpp",
        "src/frame_extractor.cpp",
        "src/frame_injector.cpp",
        "src/graph_monitor.cpp",
        "src/host_override.cpp",
        "src/init.cpp",
        "src/publisher_plugin.cpp",
        "src/stream_client.cpp",
        "src/stream_decoder.cpp",
        "src/stream_encoder.cpp",
        "src/stream_server.cpp",
        "src/subscriber_plugin.cpp",
        "src/video_codec.cpp",
    ],
    hdrs = [
        "src/frame_data.h",
        "src/frame_extractor.h",
        "src/frame_injector.h",
        "src/graph_monitor.h",
        "src/host_override.h",
        "src/init.h",
        "src/log_level.h",
        "src/publisher_plugin.h",
        "src/stream_client.h",
        "src/stream_decoder.h",
        "src/stream_encoder.h",
        "src/stream_server.h",
        "src/streaming_error.h",
        "src/subscriber_plugin.h",
        "src/video_codec.h",
    ] + [
        ":export_h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = ["_gen/include"],
    local_defines = ros_local_defines() + [
        "CURRENT_RCLCPP_VERSION=2097155",
        "FFMPEG_HAS_HWFRAME_SUPPORT",
        "LIVE555_HAS_H265_SUPPORT",
        "LIVE555_HAS_VPX_SUPPORT",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_shared_library(
    name = "rtsp_image_transport",
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":rtsp_image_transport_library"],
)

cc_binary(
    name = "publish_rtsp_stream",
    srcs = [
        "src/publish_rtsp_stream.cpp",
        ":rtsp_only_asm",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines() + [
        'ROS_PACKAGE_NAME=\\"rtsp_image_transport\\"',
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "rtsp_camera_proxy",
    srcs = [
        "src/host_override.cpp",
        "src/host_override.h",
        "src/rtsp_camera_proxy.cpp",
        ":rtsp_only_asm",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

ament_index(
    name = "ament_index",
    libraries = [":rtsp_image_transport"],
    package_xml = "package.xml",
    plugin_category = "image_transport",
    plugins = ["plugin.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@cv_bridge//:ament_package",
        "@image_transport//:ament_package",
        "@live555_vendor//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    libraries = [":rtsp_image_transport"],
    package_xml = "package.xml",
    programs = [
        ":publish_rtsp_stream",
        ":rtsp_camera_proxy",
    ],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@cv_bridge//:ament_package",
        "@image_transport//:ament_package",
        "@live555_vendor//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
