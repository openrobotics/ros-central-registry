load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:lz4": "@rosdistro//cc:lz4_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:protobuf": "@rosdistro//cc:protobuf_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
}

CC_DEPS = [
    "@@geometry_msgs+//:cc",
    "@easynav_common//:easynav_common_library",
    "@easynav_core//:easynav_core_library",
    "@easynav_sensors//:easynav_sensors_library",
    "@nav_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:pcl_common",
    "@rosdistro//cc:pcl_features",
    "@rosdistro//cc:pcl_filters",
    "@rosdistro//cc:pcl_io",
    "@rosdistro//cc:pcl_kdtree",
    "@rosdistro//cc:pcl_keypoints",
    "@rosdistro//cc:pcl_ml",
    "@rosdistro//cc:pcl_octree",
    "@rosdistro//cc:pcl_outofcore",
    "@rosdistro//cc:pcl_people",
    "@rosdistro//cc:pcl_recognition",
    "@rosdistro//cc:pcl_registration",
    "@rosdistro//cc:pcl_sample_consensus",
    "@rosdistro//cc:pcl_search",
    "@rosdistro//cc:pcl_segmentation",
    "@rosdistro//cc:pcl_surface",
    "@rosdistro//cc:pcl_tracking",
    "@rosdistro//cc:pcl_visualization",
    "@visualization_msgs//:cc",
]

cc_library(
    name = "vff_controller_library",
    srcs = ["src/easynav_vff_controller/VffController.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/easynav_vff_controller",
    ],
    local_defines = ros_local_defines() + [
        "EASYNAV_DEBUG_WITH_YAETS",
        "GLAD_API_CALL_EXPORT",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "vff_controller",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":vff_controller_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":vff_controller"],
    package_xml = "package.xml",
    plugin_category = "easynav_core",
    plugins = ["easynav_vff_controller_plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@easynav_common//:ament_package",
        "@easynav_core//:ament_package",
        "@easynav_sensors//:ament_package",
        "@nav_msgs//:ament_package",
        "@pcl_ros//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@tf2//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "rclcpp_lifecycle",
        "easynav_core",
        "easynav_common",
        "easynav_sensors",
        "pluginlib",
        "nav_msgs",
        "visualization_msgs",
        "tf2",
    ],
    cmake_export_name = "export_easynav_vff_controller",
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [":vff_controller"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@easynav_common//:ament_package",
        "@easynav_core//:ament_package",
        "@easynav_sensors//:ament_package",
        "@nav_msgs//:ament_package",
        "@pcl_ros//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@tf2//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
