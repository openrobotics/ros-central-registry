cc_library(
    name = "test_utils",
    testonly = True,
    hdrs = [
        "test_utils.hpp",
    ],
    includes = ["."],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_crop_box_state",
    srcs = ["test_crop_box_state.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":test_utils",
        "//:yasmin_pcl_states_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

