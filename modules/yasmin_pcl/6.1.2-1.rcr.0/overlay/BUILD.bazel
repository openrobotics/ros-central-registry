load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@pcl_conversions//:pcl_conversions": "@pcl_conversions//:pcl_conversions_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rosdistro//cc:boost.filesystem_shared": "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.iostreams_shared": "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:bzip2": "@rosdistro//cc:bzip2_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:lz4": "@rosdistro//cc:lz4_library",
    "@rosdistro//cc:pcl": "@rosdistro//cc:pcl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
    "@rosdistro//cc:zstd": "@rosdistro//cc:zstd_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@yasmin//:yasmin": "@yasmin//:yasmin_library",
}

CC_DEPS = [
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "yasmin_pcl_states_library",
    srcs = [
        "src/filters/crop_box_state.cpp",
        "src/filters/extract_indices_state.cpp",
        "src/filters/pass_through_state.cpp",
        "src/filters/project_inliers_state.cpp",
        "src/filters/radius_outlier_removal_state.cpp",
        "src/filters/random_sample_state.cpp",
        "src/filters/statistical_outlier_removal_state.cpp",
        "src/filters/voxel_grid_state.cpp",
        "src/io/load_pcd_state.cpp",
        "src/io/load_ply_state.cpp",
        "src/io/pcl_to_ros_point_cloud2_state.cpp",
        "src/io/ros_to_pcl_point_cloud2_state.cpp",
        "src/io/save_pcd_state.cpp",
        "src/io/save_ply_state.cpp",
    ],
    hdrs = [
        "include/yasmin_pcl/common/cloud_types.hpp",
        "include/yasmin_pcl/common/filter_state_utils.hpp",
        "include/yasmin_pcl/common/pcl_compat.hpp",
        "include/yasmin_pcl/common/transform_utils.hpp",
        "include/yasmin_pcl/filters/crop_box_state.hpp",
        "include/yasmin_pcl/filters/extract_indices_state.hpp",
        "include/yasmin_pcl/filters/pass_through_state.hpp",
        "include/yasmin_pcl/filters/project_inliers_state.hpp",
        "include/yasmin_pcl/filters/radius_outlier_removal_state.hpp",
        "include/yasmin_pcl/filters/random_sample_state.hpp",
        "include/yasmin_pcl/filters/statistical_outlier_removal_state.hpp",
        "include/yasmin_pcl/filters/voxel_grid_state.hpp",
        "include/yasmin_pcl/io/load_pcd_state.hpp",
        "include/yasmin_pcl/io/load_ply_state.hpp",
        "include/yasmin_pcl/io/pcl_to_ros_point_cloud2_state.hpp",
        "include/yasmin_pcl/io/ros_to_pcl_point_cloud2_state.hpp",
        "include/yasmin_pcl/io/save_pcd_state.hpp",
        "include/yasmin_pcl/io/save_ply_state.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/yasmin_pcl",
        "test",
    ],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "yasmin_pcl_states",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":yasmin_pcl_states_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":yasmin_pcl_states"],
)

ament_index(
    name = "ament_index",
    libraries = [":yasmin_pcl_states"],
    package_xml = "package.xml",
    plugin_category = "yasmin",
    plugins = ["plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@pcl_conversions//:ament_package",
        "@pluginlib//:ament_package",
        "@sensor_msgs//:ament_package",
        "@yasmin//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "pcl_conversions",
        "pluginlib",
        "sensor_msgs",
        "yasmin",
    ],
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    cmake_export_name = "yasmin_pclTargets",
    headers = [
        "include/yasmin_pcl/common/cloud_types.hpp",
        "include/yasmin_pcl/common/filter_state_utils.hpp",
        "include/yasmin_pcl/common/pcl_compat.hpp",
        "include/yasmin_pcl/common/transform_utils.hpp",
        "include/yasmin_pcl/filters/crop_box_state.hpp",
        "include/yasmin_pcl/filters/extract_indices_state.hpp",
        "include/yasmin_pcl/filters/pass_through_state.hpp",
        "include/yasmin_pcl/filters/project_inliers_state.hpp",
        "include/yasmin_pcl/filters/radius_outlier_removal_state.hpp",
        "include/yasmin_pcl/filters/random_sample_state.hpp",
        "include/yasmin_pcl/filters/statistical_outlier_removal_state.hpp",
        "include/yasmin_pcl/filters/voxel_grid_state.hpp",
        "include/yasmin_pcl/io/load_pcd_state.hpp",
        "include/yasmin_pcl/io/load_ply_state.hpp",
        "include/yasmin_pcl/io/pcl_to_ros_point_cloud2_state.hpp",
        "include/yasmin_pcl/io/ros_to_pcl_point_cloud2_state.hpp",
        "include/yasmin_pcl/io/save_pcd_state.hpp",
        "include/yasmin_pcl/io/save_ply_state.hpp",
    ],
    include_prefix = "",
    libraries = [":yasmin_pcl_states"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@pcl_conversions//:ament_package",
        "@pluginlib//:ament_package",
        "@sensor_msgs//:ament_package",
        "@yasmin//:ament_package",
    ],
)
