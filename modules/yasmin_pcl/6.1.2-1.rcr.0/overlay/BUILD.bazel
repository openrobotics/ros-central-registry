load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:lz4": "@rosdistro//cc:lz4_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
    "@yasmin//:yasmin": "@yasmin//:yasmin_library",
}

CC_DEPS = [
    "@pcl_conversions//:pcl_conversions_library",
    "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:pcl_common",
    "@rosdistro//cc:pcl_filters",
    "@rosdistro//cc:pcl_io",
    "@rosdistro//cc:pcl_kdtree",
    "@rosdistro//cc:pcl_octree",
    "@rosdistro//cc:pcl_sample_consensus",
    "@rosdistro//cc:pcl_search",
    "@sensor_msgs//:cc",
]

cc_library(
    name = "yasmin_pcl_states_library",
    srcs = [
        "src/filters/crop_box_state.cpp",
        "src/filters/extract_indices_state.cpp",
        "src/filters/pass_through_state.cpp",
        "src/filters/project_inliers_state.cpp",
        "src/filters/radius_outlier_removal_state.cpp",
        "src/filters/random_sample_state.cpp",
        "src/filters/statistical_outlier_removal_state.cpp",
        "src/filters/voxel_grid_state.cpp",
        "src/io/load_pcd_state.cpp",
        "src/io/load_ply_state.cpp",
        "src/io/pcl_to_ros_point_cloud2_state.cpp",
        "src/io/ros_to_pcl_point_cloud2_state.cpp",
        "src/io/save_pcd_state.cpp",
        "src/io/save_ply_state.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/yasmin_pcl",
        "test",
    ],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "yasmin_pcl_states",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":yasmin_pcl_states_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

