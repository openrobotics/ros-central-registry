load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@point_cloud_transport//:point_cloud_transport": "@point_cloud_transport//:point_cloud_transport_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "encoder_test",
    srcs = ["src/my_encoder.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "publisher_test",
    srcs = ["src/my_publisher.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "subscriber_test",
    srcs = ["src/my_subscriber.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

ament_index(
    name = "ament_index",
    data = [
        "resources/rosbag2_2023_08_05-16_08_51.tar.xz",
    ],
    lib_data = [
        ":encoder_test",
        ":publisher_test",
        ":subscriber_test",
        "scripts/publisher.py",
        "scripts/subscriber_old_school.py",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@point_cloud_transport//:ament_package",
        "@point_cloud_transport_plugins//:ament_package",
        "@rclcpp//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@point_cloud_transport//:ament_package",
        "@point_cloud_transport_plugins//:ament_package",
        "@rclcpp//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
