load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
]

cc_library(
    name = "cdds-util_library",
    srcs = [],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines() + [
        "DEBUG",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_library(
    name = "ddsc_library",
    srcs = [],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines() + [
        "DDSI_INCLUDE_DEADLINE_MISSED",
        "DDSI_INCLUDE_LIFESPAN",
        "DDSI_INCLUDE_NETWORK_PARTITIONS",
        "DDSI_INCLUDE_SECURITY",
        "DDSI_INCLUDE_SSM",
        "DDSRT_WITH_DNS=1",
        "DDSRT_WITH_FREERTOS=0",
        "DDSRT_WITH_LWIP=0",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = ["@ament_cmake//:ament_package"],
)

genrule(
    name = "tar",
    srcs = [":raw_tar"],
    outs = ["tar.tar.gz"],
    cmd = "tmpdir=$$(mktemp -d) && tar -xzf $(location :raw_tar) -C $$tmpdir && rm -rf $$tmpdir/opt/ros/lyrical/zenoh_bridge_dds/share/zenoh_bridge_dds/hook && tar -czf $@ -C $$tmpdir opt && rm -rf $$tmpdir",
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    install_package_xml = False,
    package_xml = "package.xml",
    tar_name = "raw_tar",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
    ],
)
