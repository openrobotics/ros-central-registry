# gz_dartsim_vendor: DART is consumed by gz-physics directly from the Bazel Central Registry module
# `dartsim` (statically linked into libgz-physics-dartsim-plugin.so, see
# gz_physics_vendor), so this package is metadata only (package.xml +
# environment hooks): no standalone libdart*.so / headers are installed.

load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc/gz:defs.bzl", "gz_vendor_hooks")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
        "@rules_license//licenses/spdx:BSD-2-Clause",
    ],
)

### INSTALL LAYOUT

ENV_HOOKS = gz_vendor_hooks(
    name = "install_hooks",
    gz_config_path = False,
    pythonpath = False,
    vendor = "gz_dartsim_vendor",
)

### PACKAGING

ament_package(
    name = "ament_package",
    env_hooks = ENV_HOOKS,
    install = [":install_hooks"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_vendor_package//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
