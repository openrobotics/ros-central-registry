load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

py_library(
    name = "nodl_schema",
    srcs = glob(["nodl_schema/**/*.py"]),
    data = glob(["nodl_schema/schemas/*.yaml"]),
    imports = ["."],
    deps = [
        requirement("pydantic"),
        requirement("pyyaml"),
        "@ament_index_python",
    ],
)

pkg_files(
    name = "share_schemas",
    srcs = glob(["nodl_schema/schemas/*.yaml"]),
    prefix = "share/nodl_schema/schemas",
)

ament_package(
    name = "ament_package",
    build_type = "ament_python",
    install = [":share_schemas"],
    package_xml = "package.xml",
    python = [":nodl_schema"],
    deps = [
        "@ament_index_python//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
