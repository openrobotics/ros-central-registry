load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

exports_files(["defs.bzl"])

HEADERS = [
    "include/class_loader/class_loader.hpp",
    "include/class_loader/class_loader_core.hpp",
    "include/class_loader/exceptions.hpp",
    "include/class_loader/interface_traits.hpp",
    "include/class_loader/meta_object.hpp",
    "include/class_loader/multi_library_class_loader.hpp",
    "include/class_loader/register_macro.hpp",
    "include/class_loader/visibility_control.hpp",
]

DEPENDENCIES = {
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
}

cc_library(
    name = "class_loader_headers",
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values(),
)

cc_library(
    name = "class_loader_library",
    srcs = [
        "src/class_loader.cpp",
        "src/class_loader_core.cpp",
        "src/meta_object.cpp",
        "src/multi_library_class_loader.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "class_loader",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":class_loader_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":class_loader"],
)

ament_package(
    name = "ament_package",
    cmake = [
        "cmake/class_loader_hide_library_symbols.cmake",
        "cmake/sanitizers.cmake",
    ] + ["class_loader-extras.cmake"],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_extras = ["class_loader-extras.cmake"],
    headers = HEADERS,
    libraries = [":class_loader"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@console_bridge_vendor//:ament_package",
        "@rcpputils//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
