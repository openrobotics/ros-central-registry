--- a/test/utest.cpp
+++ b/test/utest.cpp
@@ -455,6 +455,15 @@
   // In order to invoke graveyard behavior, this needs to be loaded first for global relocation.
 
   void * handle = dlopen(GLOBAL_PLUGINS.c_str(), RTLD_NOW | RTLD_GLOBAL);
+#ifdef __APPLE__
+  // Bazel exposes the test plugins under lib/ relative to the working directory
+  // (what LD_LIBRARY_PATH=lib provides on Linux), but macOS strips
+  // DYLD_LIBRARY_PATH from the test environment and a bare dlopen() only
+  // searches the caller's rpaths.
+  if (handle == nullptr) {
+    handle = dlopen(("lib/" + GLOBAL_PLUGINS).c_str(), RTLD_NOW | RTLD_GLOBAL);
+  }
+#endif
   ASSERT_NE(handle, nullptr);
 
   // This load will cause system to use globally relocatable library.
