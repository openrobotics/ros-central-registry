        "@auto_apms_util//:auto_apms_util_py",
        "@geometry_msgs//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@ros2cli",
        "@ros2param",
        "@std_srvs//:py",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_py",
    ],
