        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

py_pytest(
    name = "auto_apms_behavior_tree_unit_tests_py",
    srcs = ["unit/test_resource_discovery.py"],
    data = ["//:ament_index"],
    deps = [
        "//:auto_apms_behavior_tree_py",
        "@ament_index_python",
        "@auto_apms_behavior_tree_core//:auto_apms_behavior_tree_core_py",
