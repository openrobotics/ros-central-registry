genrule(
    name = "gen_behavior_tree_nodes_metadata",
    srcs = [
        ":auto_apms_behavior_tree_behavior_tree_nodes",
        ":nodes_transitive_dynamic_deps",
        ":standard_nodes_yaml",
    ],
    outs = [
        "_gen/include/auto_apms_behavior_tree/auto_apms_behavior_tree/behavior_tree_nodes.hpp",
        "_gen/share/auto_apms_behavior_tree/auto_apms/auto_apms_behavior_tree_core/metadata/node_manifest_behavior_tree_nodes.yaml",
        "_gen/share/auto_apms_behavior_tree/auto_apms/auto_apms_behavior_tree_core/metadata/node_model_behavior_tree_nodes.xml",
    ],
    cmd = """
set -e
LIB_FILE="$$(realpath $(location :auto_apms_behavior_tree_behavior_tree_nodes))"
export LD_LIBRARY_PATH="$$(for f in $(locations :nodes_transitive_dynamic_deps); do dirname $$(realpath $$f); done | sort -u | paste -sd: -):$${LD_LIBRARY_PATH:-}"
export DYLD_LIBRARY_PATH="$${LD_LIBRARY_PATH}:$${DYLD_LIBRARY_PATH:-}"
BUILD_INFOS=""
for cls in """ + " ".join(_NODE_CLASSES) + """; do
    if [ -n "$$BUILD_INFOS" ]; then BUILD_INFOS="$${BUILD_INFOS};"; fi
    BUILD_INFOS="$${BUILD_INFOS}$${cls}@$${LIB_FILE}@auto_apms_behavior_tree::core::NodeRegistrationTemplate<$${cls}>"
done
MANIFEST_OUT="$(location _gen/share/auto_apms_behavior_tree/auto_apms/auto_apms_behavior_tree_core/metadata/node_manifest_behavior_tree_nodes.yaml)"
MODEL_OUT="$(location _gen/share/auto_apms_behavior_tree/auto_apms/auto_apms_behavior_tree_core/metadata/node_model_behavior_tree_nodes.xml)"
HEADER_OUT="$(location _gen/include/auto_apms_behavior_tree/auto_apms_behavior_tree/behavior_tree_nodes.hpp)"
OUT_LINES="$$($(location :ament_prefix_wrapper) $(location @auto_apms_behavior_tree_core//:create_node_manifest) $(location :standard_nodes_yaml) "$$BUILD_INFOS" auto_apms_behavior_tree "$$MANIFEST_OUT")"
LIB_PATHS="$$(printf '%s\\n' "$$OUT_LINES" | sed -n '1p')"
REG_TYPES="$$(printf '%s\\n' "$$OUT_LINES" | sed -n '2p')"
$(location :ament_prefix_wrapper) $(location @auto_apms_behavior_tree_core//:create_node_model) "$$MANIFEST_OUT" "$$LIB_PATHS" "$$REG_TYPES" "$$MODEL_OUT"
$(location :ament_prefix_wrapper) $(location @auto_apms_behavior_tree_core//:create_node_model_header) "$$MANIFEST_OUT" "$$MODEL_OUT" auto_apms_behavior_tree "$$HEADER_OUT"
""",
    tools = [
        ":ament_prefix_wrapper",
        "@auto_apms_behavior_tree_core//:create_node_manifest",
        "@auto_apms_behavior_tree_core//:create_node_model",
        "@auto_apms_behavior_tree_core//:create_node_model_header",
    ],
)

# Upstream runs the auto_apms_behavior_tree_core generators with that
