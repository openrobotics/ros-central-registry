load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@slg_msgs//:cc_shared": "@slg_msgs//:cc",
    "@slg_msgs//:slg_core_dynamic_deps": "@slg_msgs//:slg_core",
    "@visualization_msgs//:cc_shared": "@visualization_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "laser_segmentation_core_library",
    srcs = [
        "src/laser_segmentation.cpp",
        "src/parameter_handler.cpp",
        "src/segmentation/jump_distance.cpp",
        "src/segmentation/jump_distance_merge.cpp",
    ],
    hdrs = [
        "include/laser_segmentation/laser_segmentation.hpp",
        "include/laser_segmentation/parameter_handler.hpp",
        "include/laser_segmentation/parula.hpp",
        "include/laser_segmentation/segmentation/jump_distance.hpp",
        "include/laser_segmentation/segmentation/jump_distance_merge.hpp",
        "include/laser_segmentation/segmentation/segmentation.hpp",
    ],
    includes = [
        "include",
        "include/laser_segmentation",
        "test",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "laser_segmentation_core",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":laser_segmentation_core_library"],
)

rclcpp_components_register_nodes(
    name = "laser_segmentation_core_components",
    component = ":laser_segmentation_core",
    plugins = ["laser_segmentation::LaserSegmentation"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":laser_segmentation_core"],
)

cc_binary(
    name = "laser_segmentation",
    srcs = ["src/main.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/laser_segmentation",
        "test",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":laser_segmentation_core_library"],
)

ament_index(
    name = "ament_index",
    components = [":laser_segmentation_core_components"],
    data = [
        "params/close_steps_detect.yml",
        "params/default_params.yml",
        "//launch:launch_files",
    ],
    lib_data = [":laser_segmentation"],
    libraries = [":laser_segmentation_core"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@sensor_msgs//:ament_package",
        "@slg_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "rclcpp_components",
        "rclcpp_lifecycle",
        "sensor_msgs",
        "slg_msgs",
        "visualization_msgs",
    ],
    cmake_export_targets = False,
    headers = [
        "include/laser_segmentation/laser_segmentation.hpp",
        "include/laser_segmentation/parameter_handler.hpp",
        "include/laser_segmentation/parula.hpp",
        "include/laser_segmentation/segmentation/jump_distance.hpp",
        "include/laser_segmentation/segmentation/jump_distance_merge.hpp",
        "include/laser_segmentation/segmentation/segmentation.hpp",
    ],
    libraries = [":laser_segmentation_core"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@sensor_msgs//:ament_package",
        "@slg_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
