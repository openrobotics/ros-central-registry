load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rosdistro//cc:proj": "@rosdistro//cc:proj_library",
    "@rosdistro//cc:curl": "@rosdistro//cc:curl_library",
    "@rosdistro//cc:sqlite3": "@rosdistro//cc:sqlite3_library",
    "@rosdistro//cc:ceres": "@rosdistro//cc:ceres_library",
    "@rosdistro//cc:glog": "@rosdistro//cc:glog_library",
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@rmf_utils//:rmf_utils": "@rmf_utils//:rmf_utils_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

CC_DEPS = [
    "//:_gen_textual_hdrs",
    "@rosdistro//cc:eigen",
    "@qtbase//:core",
    "@qtbase//:gui",
    "@qtsvg//:svg",
    "@qtbase//:widgets",
    "@qtbase//:concurrent",
    "@qtbase//:network",
    "@qtscxml//:statemachine",
]

exports_files([
    "CMakeLists.txt",
    "model_blacklist.yaml",
    "model_list.yaml",
    "test_gui.cpp",
])

cc_test(
    name = "test_gui",
    srcs = [
        "test_gui.cpp",
        "//:gen_qrc_resource_cpp",
    ] + [] + [
        "//:gen_ui_level_dialog_wgs84_h",
        "//:gen_ui_new_building_dialog_h",
        "//:gen_ui_transform_dialog_h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "CMakeLists.txt",
        "model_blacklist.yaml",
        "model_list.yaml",
    ],
    dynamic_deps = [
        "//:transitive_dynamic_deps",
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtsvg//:svg_shared",
        "@qtbase//:widgets_shared",
        "@qtbase//:concurrent_shared",
        "@qtbase//:network_shared",
        "@qtscxml//:statemachine_shared",
    ],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:gui_lib_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)
