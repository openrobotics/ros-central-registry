load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

py_library(
    name = "replay_testing",
    srcs = [
        "replay_testing/__init__.py",
        "replay_testing/cli.py",
        "replay_testing/decorators/__init__.py",
        "replay_testing/decorators/analyze.py",
        "replay_testing/decorators/fixtures.py",
        "replay_testing/decorators/run.py",
        "replay_testing/filter.py",
        "replay_testing/fixtures/__init__.py",
        "replay_testing/fixtures/base_fixture.py",
        "replay_testing/fixtures/local.py",
        "replay_testing/fixtures/nexus.py",
        "replay_testing/fixtures/s3.py",
        "replay_testing/junit_to_xml.py",
        "replay_testing/logging_config.py",
        "replay_testing/models.py",
        "replay_testing/reader.py",
        "replay_testing/replay_fixture.py",
        "replay_testing/replay_runner.py",
        "replay_testing/replay_test_result.py",
        "replay_testing/utils.py",
    ],
    imports = ["."],
    deps = [
        requirement("pydantic"),
        requirement("requests"),
        "@geometry_msgs//:py",
        "@launch",
        "@rclpy",
        "@ros2bag",
        "@rosbag2_py",
    ],
)

ament_package(
    name = "ament_package",
    cmake = ["cmake/add_replay_test.cmake"] + ["replay_testing-extras.cmake"],
    cmake_extras = ["replay_testing-extras.cmake"],
    console_scripts = {"replay_test": "replay_testing.cli:main"},
    package_xml = "package.xml",
    python = [":replay_testing"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch//:ament_package",
        "@rclpy//:ament_package",
        "@ros2bag//:ament_package",
        "@ros2run//:ament_package",
        "@ros2topic//:ament_package",
        "@rosbag2_py//:ament_package",
        "@rosbag2_storage_mcap//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
