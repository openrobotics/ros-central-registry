load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

py_library(
    name = "replay_testing",
    srcs = glob(["replay_testing/**/*.py"]),
    imports = ["."],
    deps = [
        requirement("pydantic"),
        requirement("requests"),
        "@geometry_msgs//:py",
        "@launch",
        "@rclpy",
        "@ros2bag",
        "@rosbag2_py",
    ],
)

py_pytest(
    name = "pytest",
    srcs = [
        "test/conftest.py",
        "test/test_cli.py",
        "test/test_filter.py",
        "test/test_junit.py",
        "test/test_replay_runner.py",
    ],
    data = glob(["test/**"]),
    tags = ["manual"],
    deps = [
        ":replay_testing",
    ],
)

py_pytest(
    name = "test_replay_tests_basic_replay.py",
    srcs = ["test/replay_tests/basic_replay.py"],
    data = glob(["test/**"]),
    tags = ["manual"],
    deps = [
        ":replay_testing",
    ],
)

ament_package(
    name = "ament_package",
    cmake = glob(["cmake/**"]) + ["replay_testing-extras.cmake"],
    cmake_extras = ["replay_testing-extras.cmake"],
    console_scripts = {"replay_test": "replay_testing.cli:main"},
    package_xml = "package.xml",
    python = [":replay_testing"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch//:ament_package",
        "@rclpy//:ament_package",
        "@ros2bag//:ament_package",
        "@ros2run//:ament_package",
        "@ros2topic//:ament_package",
        "@rosbag2_py//:ament_package",
        "@rosbag2_storage_mcap//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
