load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rmf_traffic//:rmf_traffic": "@rmf_traffic//:rmf_traffic_library",
    "@rmf_utils//:rmf_utils": "@rmf_utils//:rmf_utils_library",
}

CC_DEPS = ["@rosdistro//cc:eigen"]

cc_test(
    name = "test_rmf_battery",
    srcs = [
        "main.cpp",
        "unit/agv/test_BatterySystem.cpp",
        "unit/agv/test_MechanicalSystem.cpp",
        "unit/agv/test_PowerSystem.cpp",
        "unit/agv/test_battery_drain.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["NDEBUG"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:rmf_battery_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
