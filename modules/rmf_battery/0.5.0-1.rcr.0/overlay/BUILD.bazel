load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@rmf_traffic//:rmf_traffic": "@rmf_traffic//:rmf_traffic_library",
    "@rmf_utils//:rmf_utils": "@rmf_utils//:rmf_utils_library",
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "rmf_battery_library",
    srcs = [
        "src/rmf_battery/agv/BatterySystem.cpp",
        "src/rmf_battery/agv/MechanicalSystem.cpp",
        "src/rmf_battery/agv/PowerSystem.cpp",
        "src/rmf_battery/agv/SimpleDevicePowerSink.cpp",
        "src/rmf_battery/agv/SimpleMotionPowerSink.cpp",
    ],
    hdrs = [
        "include/rmf_battery/DevicePowerSink.hpp",
        "include/rmf_battery/MotionPowerSink.hpp",
        "include/rmf_battery/agv/BatterySystem.hpp",
        "include/rmf_battery/agv/MechanicalSystem.hpp",
        "include/rmf_battery/agv/PowerSystem.hpp",
        "include/rmf_battery/agv/SimpleDevicePowerSink.hpp",
        "include/rmf_battery/agv/SimpleMotionPowerSink.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        ".",
        "include",
        "include/rmf_battery",
    ],
    local_defines = ros_local_defines() + ["NDEBUG"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rmf_battery",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rmf_battery_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":rmf_battery"],
)

ament_index(
    name = "ament_index",
    libraries = [":rmf_battery"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_catch2//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@rmf_traffic//:ament_package",
        "@rmf_utils//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/rmf_battery/DevicePowerSink.hpp",
        "include/rmf_battery/MotionPowerSink.hpp",
        "include/rmf_battery/agv/BatterySystem.hpp",
        "include/rmf_battery/agv/MechanicalSystem.hpp",
        "include/rmf_battery/agv/PowerSystem.hpp",
        "include/rmf_battery/agv/SimpleDevicePowerSink.hpp",
        "include/rmf_battery/agv/SimpleMotionPowerSink.hpp",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [":rmf_battery"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_catch2//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@rmf_traffic//:ament_package",
        "@rmf_utils//:ament_package",
    ],
)
