load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@async_web_server_cpp//:async_web_server_cpp": "@async_web_server_cpp//:async_web_server_cpp_library",
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosdistro//cc:boost.asio_shared": "@rosdistro//cc:boost.asio",
    "@rosdistro//cc:boost.container_shared": "@rosdistro//cc:boost.container",
    "@rosdistro//cc:boringssl": "@rosdistro//cc:boringssl_crypto_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:ffmpeg_avcodec_shared": "@rosdistro//cc:ffmpeg_avcodec",
    "@rosdistro//cc:ffmpeg_avformat_shared": "@rosdistro//cc:ffmpeg_avformat",
    "@rosdistro//cc:ffmpeg_avutil_shared": "@rosdistro//cc:ffmpeg_avutil",
    "@rosdistro//cc:ffmpeg_swresample_shared": "@rosdistro//cc:ffmpeg_swresample",
    "@rosdistro//cc:ffmpeg_swscale_shared": "@rosdistro//cc:ffmpeg_swscale",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.algorithm",
    "@rosdistro//cc:boost.system",
    "@sensor_msgs//:cc",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_library(
    name = "web_video_server_library",
    srcs = [
        "src/multipart_stream.cpp",
        "src/streamer.cpp",
        "src/utils.cpp",
        "src/web_video_server.cpp",
    ],
    hdrs = [
        "include/web_video_server/multipart_stream.hpp",
        "include/web_video_server/streamer.hpp",
        "include/web_video_server/streamers/h264_streamer.hpp",
        "include/web_video_server/streamers/image_transport_streamer.hpp",
        "include/web_video_server/streamers/jpeg_streamers.hpp",
        "include/web_video_server/streamers/libav_streamer.hpp",
        "include/web_video_server/streamers/png_streamers.hpp",
        "include/web_video_server/streamers/ros_compressed_streamer.hpp",
        "include/web_video_server/streamers/vp8_streamer.hpp",
        "include/web_video_server/streamers/vp9_streamer.hpp",
        "include/web_video_server/utils.hpp",
        "include/web_video_server/web_video_server.hpp",
    ] + [
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "include/web_video_server",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "web_video_server",
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [":web_video_server_library"],
)

cc_library(
    name = "web_video_server_streamers_library",
    srcs = [
        "src/streamers/h264_streamer.cpp",
        "src/streamers/image_transport_streamer.cpp",
        "src/streamers/jpeg_streamers.cpp",
        "src/streamers/libav_streamer.cpp",
        "src/streamers/png_streamers.cpp",
        "src/streamers/ros_compressed_streamer.cpp",
        "src/streamers/vp8_streamer.cpp",
        "src/streamers/vp9_streamer.cpp",
    ],
    hdrs = [
        "include/web_video_server/multipart_stream.hpp",
        "include/web_video_server/streamer.hpp",
        "include/web_video_server/streamers/h264_streamer.hpp",
        "include/web_video_server/streamers/image_transport_streamer.hpp",
        "include/web_video_server/streamers/jpeg_streamers.hpp",
        "include/web_video_server/streamers/libav_streamer.hpp",
        "include/web_video_server/streamers/png_streamers.hpp",
        "include/web_video_server/streamers/ros_compressed_streamer.hpp",
        "include/web_video_server/streamers/vp8_streamer.hpp",
        "include/web_video_server/streamers/vp9_streamer.hpp",
        "include/web_video_server/utils.hpp",
        "include/web_video_server/web_video_server.hpp",
    ] + [
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "include/web_video_server",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":web_video_server_library"],
)

cc_shared_library(
    name = "web_video_server_streamers",
    dynamic_deps = [
        ":transitive_dynamic_deps",
        ":web_video_server",
    ],
    deps = [":web_video_server_streamers_library"],
)

rclcpp_components_register_nodes(
    name = "web_video_server_components",
    component = ":web_video_server",
    plugins = ["web_video_server::WebVideoServer"],
)

cc_binary(
    name = "_bin/web_video_server",
    srcs = ["src/web_video_server_node.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":web_video_server_library"],
)

ament_index(
    name = "ament_index",
    components = [":web_video_server_components"],
    lib_data = [
        ":_bin/web_video_server",
    ],
    libraries = [
        ":web_video_server",
        ":web_video_server_streamers",
    ],
    package_xml = "package.xml",
    plugins = ["plugins.xml"],
    deps = [
        "@ament_cmake_clang_tidy//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@async_web_server_cpp//:ament_package",
        "@cv_bridge//:ament_package",
        "@image_transport//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rmw//:ament_package",
        "@ros_environment//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)

ament_package(
    cmake = [
        "config-extras.cmake",
    ],
    cmake_export_dependencies_list = [
        "async_web_server_cpp",
        "cv_bridge",
        "image_transport",
        "pluginlib",
        "rclcpp",
        "rmw",
        "sensor_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_web_video_server",
    cmake_extras = ["config-extras.cmake"],
    cmake_strip_prefix = "",
    headers = [
        "include/web_video_server/multipart_stream.hpp",
        "include/web_video_server/streamer.hpp",
        "include/web_video_server/streamers/h264_streamer.hpp",
        "include/web_video_server/streamers/image_transport_streamer.hpp",
        "include/web_video_server/streamers/jpeg_streamers.hpp",
        "include/web_video_server/streamers/libav_streamer.hpp",
        "include/web_video_server/streamers/png_streamers.hpp",
        "include/web_video_server/streamers/ros_compressed_streamer.hpp",
        "include/web_video_server/streamers/vp8_streamer.hpp",
        "include/web_video_server/streamers/vp9_streamer.hpp",
        "include/web_video_server/utils.hpp",
        "include/web_video_server/web_video_server.hpp",
    ],
    include_prefix = "",
    libraries = [
        ":web_video_server",
        ":web_video_server_streamers",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_clang_tidy//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@async_web_server_cpp//:ament_package",
        "@cv_bridge//:ament_package",
        "@image_transport//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rmw//:ament_package",
        "@ros_environment//:ament_package",
