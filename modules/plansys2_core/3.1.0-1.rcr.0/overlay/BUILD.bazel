load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@plansys2_pddl_parser//:plansys2_pddl_parser": "@plansys2_pddl_parser//:plansys2_pddl_parser_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

CC_DEPS = [
    "@plansys2_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "plansys2_core_library",
    srcs = [
        "src/plansys2_core/Action.cpp",
        "src/plansys2_core/DerivedResolutionGraph.cpp",
        "src/plansys2_core/PlanSolverBase.cpp",
        "src/plansys2_core/State.cpp",
        "src/plansys2_core/Utils.cpp",
    ],
    hdrs = [
        "include/plansys2_core/Action.hpp",
        "include/plansys2_core/DerivedResolutionGraph.hpp",
        "include/plansys2_core/NodeVariant.hpp",
        "include/plansys2_core/PlanSolverBase.hpp",
        "include/plansys2_core/State.hpp",
        "include/plansys2_core/Types.hpp",
        "include/plansys2_core/Utils.hpp",
    ],
    includes = [
        "include",
        "include/plansys2_core",
        "test",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "plansys2_core",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":plansys2_core_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":plansys2_core"],
)

ament_index(
    name = "ament_index",
    data = ["//test:_root_test_files_0"],
    data_strip_prefix = "test",
    libraries = [":plansys2_core"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@plansys2_msgs//:ament_package",
        "@plansys2_pddl_parser//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "plansys2_msgs",
        "plansys2_pddl_parser",
        "rclcpp",
        "rclcpp_lifecycle",
    ],
    cmake_export_name = "export_plansys2_core",
    headers = [
        "include/plansys2_core/Action.hpp",
        "include/plansys2_core/DerivedResolutionGraph.hpp",
        "include/plansys2_core/NodeVariant.hpp",
        "include/plansys2_core/PlanSolverBase.hpp",
        "include/plansys2_core/State.hpp",
        "include/plansys2_core/Types.hpp",
        "include/plansys2_core/Utils.hpp",
    ],
    libraries = [":plansys2_core"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@plansys2_msgs//:ament_package",
        "@plansys2_pddl_parser//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
    ],
)
