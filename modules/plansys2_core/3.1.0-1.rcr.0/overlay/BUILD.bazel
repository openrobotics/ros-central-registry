load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@plansys2_pddl_parser//:plansys2_pddl_parser": "@plansys2_pddl_parser//:plansys2_pddl_parser_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
}

CC_DEPS = [
    "@plansys2_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "plansys2_core_library",
    srcs = [
        "src/plansys2_core/Action.cpp",
        "src/plansys2_core/DerivedResolutionGraph.cpp",
        "src/plansys2_core/PlanSolverBase.cpp",
        "src/plansys2_core/State.cpp",
        "src/plansys2_core/Utils.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++23"],
    includes = [
        "include",
        "include/plansys2_core",
        "test",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "plansys2_core",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":plansys2_core_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":plansys2_core"],
)

pkg_files(
    name = "pkg_files_share_0",
    srcs = ["test/pddl/domain_1_ok.pddl"],
