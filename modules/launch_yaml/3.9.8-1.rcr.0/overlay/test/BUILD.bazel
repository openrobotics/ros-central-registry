load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

exports_files([
    "launch_yaml/executable.yaml",
    "launch_yaml/parser_no_extensions.py",
    "launch_yaml/test_append_env.py",
    "launch_yaml/test_boolean_substitution.py",
    "launch_yaml/test_executable.py",
    "launch_yaml/test_for_loop.py",
    "launch_yaml/test_group.py",
    "launch_yaml/test_include.py",
    "launch_yaml/test_log.py",
    "launch_yaml/test_path_join_substitution.py",
    "launch_yaml/test_rep_env.py",
    "launch_yaml/test_reset.py",
    "launch_yaml/test_string_join_substitution.py",
    "test_copyright.py",
    "test_flake8.py",
    "test_pep257.py",
    "test_xmllint.py",
])

[py_pytest(
    name = f.split("/")[-1].removesuffix(".py"),
    srcs = [f],
    data = [
        "launch_yaml/executable.yaml",
        "launch_yaml/parser_no_extensions.py",
    ],
    deps = ["//:launch_yaml"],
) for f in [
    "launch_yaml/test_append_env.py",
    "launch_yaml/test_boolean_substitution.py",
    "launch_yaml/test_executable.py",
    "launch_yaml/test_for_loop.py",
    "launch_yaml/test_group.py",
    "launch_yaml/test_include.py",
    "launch_yaml/test_log.py",
    "launch_yaml/test_path_join_substitution.py",
    "launch_yaml/test_rep_env.py",
    "launch_yaml/test_reset.py",
    "launch_yaml/test_string_join_substitution.py",
]]
