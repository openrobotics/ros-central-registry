load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@can_msgs//:cc_shared": "@can_msgs//:cc",
    "@diagnostic_msgs//:cc_shared": "@diagnostic_msgs//:cc",
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:fmt",
]

cc_test(
    name = "unittests",
    srcs = ["unittests.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "benchmark.launch.xml",
        "comparison.launch.xml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["GTEST_HAS_PTHREAD=1"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:socketcan_bridge_component_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

launch_ros_binary(
    name = "benchmark_launch_xml",
    src = "benchmark.launch.xml",
    data = ["//:ament_index"],
    target_compatible_with = ["@platforms//os:linux"],
)

launch_ros_binary(
    name = "comparison_launch_xml",
    src = "comparison.launch.xml",
    data = [
        "//:ament_index",
        "@ros2_socketcan//:ament_index",
        "@ros2_socketcan//launch:socket_can_bridge_launch",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@ros2_socketcan//launch:socket_can_bridge_launch",
        "@ros2_socketcan//launch:socket_can_receiver_launch",
        "@ros2_socketcan//launch:socket_can_sender_launch",
    ],
)
