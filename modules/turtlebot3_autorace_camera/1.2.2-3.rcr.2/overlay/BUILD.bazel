load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "turtlebot3_autorace_camera",
    srcs = glob(["turtlebot3_autorace_camera/**/*.py"]),
    imports = ["."],
    deps = [
        "@cv_bridge//:cv_bridge_py",
        "@rclpy",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        requirement("numpy"),
        requirement("opencv-python"),
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "calibration/extrinsic_calibration/compensation.yaml",
        "calibration/extrinsic_calibration/projection.yaml",
        "launch/extrinsic_camera_calibration.launch.py",
        "launch/intrinsic_camera_calibration.launch.py",
    ],
    package_xml = "package.xml",
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [":ament_index"],
        deps = [":turtlebot3_autorace_camera"],
    )
    for f in glob(["launch/**"])
]

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "image_compensation": "turtlebot3_autorace_camera.image_compensation:main",
        "image_projection": "turtlebot3_autorace_camera.image_projection:main",
    },
    data = [
        "calibration/extrinsic_calibration/compensation.yaml",
        "calibration/extrinsic_calibration/projection.yaml",
        "launch/extrinsic_camera_calibration.launch.py",
        "launch/intrinsic_camera_calibration.launch.py",
    ],
    package_xml = "package.xml",
    python = [":turtlebot3_autorace_camera"],
    deps = [
        "@cv_bridge//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
