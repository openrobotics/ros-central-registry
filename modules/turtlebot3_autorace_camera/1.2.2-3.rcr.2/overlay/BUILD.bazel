load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

py_library(
    name = "turtlebot3_autorace_camera",
    srcs = [
        "turtlebot3_autorace_camera/__init__.py",
        "turtlebot3_autorace_camera/image_compensation.py",
        "turtlebot3_autorace_camera/image_projection.py",
    ],
    imports = ["."],
    deps = [
        "@cv_bridge//:cv_bridge_py",
        "@rclpy",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        requirement("numpy"),
        requirement("opencv-python"),
    ],
)

[
    py_binary(
        name = script,
        srcs = ["turtlebot3_autorace_camera/{}.py".format(script)],
        data = [":ament_index"],
        main = "turtlebot3_autorace_camera/{}.py".format(script),
        deps = [":turtlebot3_autorace_camera"],
    )
    for script in [
        "image_compensation",
        "image_projection",
    ]
]

ament_index(
    name = "ament_index",
    data = [
        "calibration/extrinsic_calibration/compensation.yaml",
        "calibration/extrinsic_calibration/projection.yaml",
        "//launch:launch_files",
    ],
    package_xml = "package.xml",
    deps = [
        "@image_proc//:ament_index",
        "@rclpy//:ament_index",
        "@sensor_msgs//:ament_index",
        "@std_msgs//:ament_index",
    ],
)

ament_package(
    name = "ament_package",
    console_scripts = {
        "image_compensation": "turtlebot3_autorace_camera.image_compensation:main",
        "image_projection": "turtlebot3_autorace_camera.image_projection:main",
    },
    package_xml = "package.xml",
    python = [":turtlebot3_autorace_camera"],
    deps = [":ament_index"] + [
        "@cv_bridge//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
