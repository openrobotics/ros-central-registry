load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {}

CC_DEPS = [
    "@rosdistro//cc:boost.test",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "testab_library",
    srcs = [
        "TestA.cpp",
        "TestB.cpp",
    ],
    hdrs = [
        "TestA.hpp",
        "TestB.hpp",
    ] + [
        "//:jrl_headers",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + ["//:eiquadprog_library"],
)

cc_shared_library(
    name = "testab",
    dynamic_deps = DEPENDENCIES.keys() + ["//:eiquadprog"],
    deps = [":testab_library"],
)

cc_test(
    name = "eiquadprog-basic",
    srcs = ["eiquadprog-basic.cpp"] + [
        "TestA.hpp",
        "TestB.hpp",
    ] + [
        "//:jrl_headers",
    ],
    data = [
        ":testab",
        "//:ament_index",
    ] + ["CMakeLists.txt"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:eiquadprog_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

