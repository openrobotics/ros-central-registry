cc_library(
    name = "eiquadprog_library",
    srcs = [
        "src/eiquadprog.cpp",
        "src/eiquadprog-fast.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_extra_0",
        ":gen_extra_1",
        ":gen_extra_7",
    ],
    includes = [
        "_gen/include",
        "_gen/include/eiquadprog",
        "include",
        "include/eiquadprog",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "eiquadprog",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["@@//:__subpackages__"],
    deps = [":eiquadprog_library"],
)

