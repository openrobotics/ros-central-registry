write_file(
    name = "gen_boost_unit_test_hpp",
    out = "_gen/include/boost/test/unit_test.hpp",
    content = [
        "#pragma once\n",
        "#include <algorithm>\n",
        "#include <cmath>\n",
        "#include <gtest/gtest.h>\n",
        "#define BOOST_AUTO_TEST_SUITE(name)\n",
        "#define BOOST_AUTO_TEST_SUITE_END()\n",
        "#define BOOST_AUTO_TEST_CASE(name) TEST(EiquadprogTest, name)\n",
        "#define BOOST_CHECK(cond) EXPECT_TRUE(cond)\n",
        "#define BOOST_CHECK_EQUAL(a, b) EXPECT_EQ(a, b)\n",
        "#define BOOST_CHECK_CLOSE(a, b, tol_pct) EXPECT_NEAR(static_cast<double>(a), static_cast<double>(b), (tol_pct) * 0.01 * std::max({std::abs(static_cast<double>(a)), std::abs(static_cast<double>(b)), 1.0}))\n",
        "#define BOOST_WARN(cond) (void)(cond)\n",
        "#define BOOST_WARN_EQUAL(a, b) (void)((a) == (b))\n",
        "#define BOOST_WARN_CLOSE(a, b, tol_pct) (void)((a) + (b) + (tol_pct))\n",
    ],
)

