load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_jrl_headers", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/eiquadprog/eiquadprog.hpp",
        "include/eiquadprog/eiquadprog-fast.hpp",
        "include/eiquadprog/eiquadprog-rt.hpp",
        "include/eiquadprog/eiquadprog-rt.hxx",
        "include/eiquadprog/eiquadprog-utils.hxx",
    ],
    includes = [],
    deps = ["@rosdistro//cc:boost.test"],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "eiquadprog_library",
    srcs = [
        "src/eiquadprog.cpp",
        "src/eiquadprog-fast.cpp",
    ],
    hdrs = [
        "include/eiquadprog/eiquadprog.hpp",
        "include/eiquadprog/eiquadprog-fast.hpp",
        "include/eiquadprog/eiquadprog-rt.hpp",
        "include/eiquadprog/eiquadprog-rt.hxx",
        "include/eiquadprog/eiquadprog-utils.hxx",
        ":jrl_headers",
    ],
    includes = [
        "_gen/include",
        "_gen/include/eiquadprog",
        "include",
        "include/eiquadprog",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "eiquadprog",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":eiquadprog_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":eiquadprog"],
)

ros_jrl_headers(
    name = "jrl_headers",
    outs = [
        "_gen/include/eiquadprog/config.hpp",
        "_gen/include/eiquadprog/deprecated.hpp",
        "_gen/include/eiquadprog/warning.hpp",
    ],
)

ament_index(
    name = "ament_index",
    libraries = [":eiquadprog"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@jrl_cmakemodules//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        ":jrl_headers",
        "include/eiquadprog/eiquadprog-fast.hpp",
        "include/eiquadprog/eiquadprog-rt.hpp",
        "include/eiquadprog/eiquadprog-rt.hxx",
        "include/eiquadprog/eiquadprog-utils.hxx",
        "include/eiquadprog/eiquadprog.hpp",
    ],
    include_prefix = "",
    libraries = [":eiquadprog"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@jrl_cmakemodules//:ament_package",
    ],
)
