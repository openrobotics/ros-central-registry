load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
}

CC_DEPS = [
    "@rosdistro//cc:turbojpeg",
]

cc_library(
    name = "turbojpeg_compressed_image_transport_library",
    srcs = [
        "src/manifest.cpp",
        "src/turbojpeg_compressed_publisher.cpp",
    ],
    hdrs = [
        "include/turbojpeg_compressed_image_transport/turbojpeg_compressed_common.hpp",
        "include/turbojpeg_compressed_image_transport/turbojpeg_compressed_publisher.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/turbojpeg_compressed_image_transport",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_shared_library(
    name = "turbojpeg_compressed_image_transport",
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@sensor_msgs//:cc_shared",
    ],
    deps = [":turbojpeg_compressed_image_transport_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":turbojpeg_compressed_image_transport"],
    package_xml = "package.xml",
    plugin_category = "image_transport",
    plugins = ["turbojpeg_compressed_plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@image_transport//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/turbojpeg_compressed_image_transport/turbojpeg_compressed_common.hpp",
        "include/turbojpeg_compressed_image_transport/turbojpeg_compressed_publisher.hpp",
    ],
    include_prefix = "",
    libraries = [":turbojpeg_compressed_image_transport"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@image_transport//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
