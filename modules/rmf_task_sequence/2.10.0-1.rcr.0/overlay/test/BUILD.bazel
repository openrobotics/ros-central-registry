load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {"@nlohmann_json_schema_validator_vendor//:nlohmann_json_schema_validator": "@nlohmann_json_schema_validator_vendor//:nlohmann_json_schema_validator_library"}

CC_DEPS = [
    "@rmf_api_msgs//:rmf_api_msgs",
    "@rmf_task//:rmf_task_library",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:nlohmann_json",
]

cc_test(
    name = "test_rmf_task_sequence",
    srcs = [
        "main.cpp",
        "mock/MockActivity.cpp",
        "unit/events/test_GoToPlace.cpp",
        "unit/events/test_PerformAction.cpp",
        "unit/test_ComposedTaskPlanning.cpp",
        "unit/test_Sequence.cpp",
    ] + [
        "mock/MockActivity.hpp",
        "unit/utils.hpp",
    ] + [
        "//:backup_EventSequence_v0_1_hpp",
        "//:backup_PhaseSequenceTask_v0_1_hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["NDEBUG"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:rmf_task_sequence_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
