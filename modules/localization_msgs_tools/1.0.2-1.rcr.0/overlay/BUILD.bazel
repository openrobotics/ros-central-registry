load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
    "@tf2_ros//:static_transform_broadcaster_node": "@tf2_ros//:static_transform_broadcaster_node_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@@rcl_interfaces+//:cc",
    "@geometry_msgs//:cc",
    "@nav_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@sensor_msgs//:cc",
]

cc_library(
    name = "pose_to_tf_node_library",
    srcs = ["src/pose_to_tf.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    local_defines = ros_local_defines() + ["ROS_HEADERS_HPP_EXTENSION"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "pose_to_tf_node",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["@@//:__subpackages__"],
    deps = [":pose_to_tf_node_library"],
)

cc_library(
    name = "with_covariance_node_library",
    srcs = ["src/with_covariance.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    local_defines = ros_local_defines() + ["ROS_HEADERS_HPP_EXTENSION"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":pose_to_tf_node_library"],
)

cc_shared_library(
    name = "with_covariance_node",
    dynamic_deps = DEPENDENCIES.keys() + [":pose_to_tf_node"],
    deps = [":with_covariance_node_library"],
)

rclcpp_components_register_node(
    name = "pose_to_tf",
    component = ":pose_to_tf_node",
    node_name = "pose_to_tf",
    plugin = "localization_msgs_tools::Pose2TF",
)

rclcpp_components_register_node(
    name = "with_covariance",
    component = ":pose_to_tf_node",
    node_name = "with_covariance",
    plugin = "localization_msgs_tools::Pose2TF",
)

rclcpp_components_register_nodes(
    name = "with_covariance_node_components",
    component = ":with_covariance_node",
    plugins = ["localization_msgs_tools::WithCovariance"],
)

ament_index(
    name = "ament_index",
    components = [
        ":pose_to_tf_record",
        ":with_covariance_record",
        ":with_covariance_node_components",
    ],
    data = [
        "example/example.launch",
        "example/sliders.yaml",
        "example/with_covariance.yaml",
    ],
    lib_data = [
        ":pose_to_tf",
        ":with_covariance",
    ],
    libraries = [
        ":pose_to_tf_node",
        ":with_covariance_node",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_eigen//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "rclcpp_components",
        "nav_msgs",
        "geometry_msgs",
        "sensor_msgs",
        "tf2_ros",
        "tf2_eigen",
    ],
    cmake_export_include_directories = False,
    cmake_export_targets = False,
    libraries = [
        ":pose_to_tf_node",
        ":with_covariance_node",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_eigen//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
