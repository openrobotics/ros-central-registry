load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

DEPENDENCIES = {
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@rcl_interfaces//:cc_shared": "@rcl_interfaces//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
    "@tf2_ros//:static_transform_broadcaster_node": "@tf2_ros//:static_transform_broadcaster_node_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "pose_to_tf_node_library",
    srcs = ["src/pose_to_tf.cpp"],
    hdrs = [
        "src/common.hpp",
        "src/other.hpp",
        "src/pose.hpp",
        "src/twist.hpp",
    ],
    local_defines = ros_local_defines() + ["ROS_HEADERS_HPP_EXTENSION"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "pose_to_tf_node",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":pose_to_tf_node_library"],
)

cc_library(
    name = "with_covariance_node_library",
    srcs = ["src/with_covariance.cpp"],
    hdrs = [
        "src/common.hpp",
        "src/other.hpp",
        "src/pose.hpp",
        "src/twist.hpp",
    ],
    local_defines = ros_local_defines() + ["ROS_HEADERS_HPP_EXTENSION"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":pose_to_tf_node_library"],
)

cc_shared_library(
    name = "with_covariance_node",
    dynamic_deps = DEPENDENCIES.keys() + [":pose_to_tf_node"],
    exports_filter = ["//:__subpackages__"],
    deps = [":with_covariance_node_library"],
)

rclcpp_components_register_node(
    name = "pose_to_tf",
    component = ":pose_to_tf_node",
    node_name = "pose_to_tf",
    plugin = "localization_msgs_tools::Pose2TF",
)

rclcpp_components_register_node(
    name = "with_covariance",
    component = ":pose_to_tf_node",
    data = [
        ":ament_index",
    ],
    node_name = "with_covariance",
    plugin = "localization_msgs_tools::Pose2TF",
)

rclcpp_components_register_nodes(
    name = "with_covariance_node_components",
    component = ":with_covariance_node",
    plugins = ["localization_msgs_tools::WithCovariance"],
)

launch_ros_binary(
    name = "example.launch",
    src = "example/example.launch.xml",
    data = [
        "@slider_publisher//:ament_index",
    ],
    deps = [
        ":with_covariance",
    ],
)

ament_index(
    name = "ament_index",
    components = [
        ":pose_to_tf_record",
        ":with_covariance_record",
        ":with_covariance_node_components",
    ],
    data = [
        "example/example.launch.xml",
        "example/sliders.yaml",
        "example/with_covariance.yaml",
    ],
    lib_data = [
        ":pose_to_tf",
    ],
    libraries = [
        ":pose_to_tf_node",
        ":with_covariance_node",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch_ros//:ament_package",
        "@nav_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@slider_publisher//:ament_package",
        "@tf2_eigen//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "rclcpp_components",
        "nav_msgs",
        "geometry_msgs",
        "sensor_msgs",
        "tf2_ros",
        "tf2_eigen",
    ],
    cmake_export_include_directories = False,
    cmake_export_targets = False,
    executables = [
        ":with_covariance",
    ],
    libraries = [
        ":pose_to_tf_node",
        ":with_covariance_node",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch_ros//:ament_package",
        "@nav_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@slider_publisher//:ament_package",
        "@tf2_eigen//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
