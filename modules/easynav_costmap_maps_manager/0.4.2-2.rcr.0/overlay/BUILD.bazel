    name = "gen_magick_h",
    out = "_gen/include/Magick++.h",
    content = ["#ifndef RCR_MAGICKPP_H_\n#define RCR_MAGICKPP_H_\n#include <cstddef>\n#include <cstdint>\n#include <cstring>\n#include <stdexcept>\n#include <string>\n#include <vector>\nnamespace Magick {\nusing Quantum = unsigned char;\nenum ImageType { GrayscaleType = 0, TrueColorMatteType = 1 };\nenum StorageType { CharPixel = 0 };\ninline void InitializeMagick(const char *) {}\nclass ErrorOption : public std::runtime_error {\n public:\n  explicit ErrorOption(const std::string & msg) : std::runtime_error(msg) {}\n};\nclass CoderInfo {\n public:\n  explicit CoderInfo(const std::string & fmt) : fmt_(fmt) {\n    if (fmt != \"png\" && fmt != \"pgm\" && fmt != \"bmp\" && fmt != \"jpg\" && fmt != \"jpeg\")\n      throw ErrorOption(\"Unsupported format: \" + fmt);\n  }\n  bool isWritable() const { return true; }\n private:\n  std::string fmt_;\n};\nclass Geometry {\n public:\n  Geometry(std::size_t w = 0, std::size_t h = 0) : w_(w), h_(h) {}\n  std::size_t width() const { return w_; }\n  std::size_t height() const { return h_; }\n private:\n  std::size_t w_, h_;\n};\nclass Color {\n public:\n  Color() : r_(0), g_(0), b_(0), a_(255) {}\n  Color(Quantum r, Quantum g, Quantum b, Quantum a = 255) : r_(r), g_(g), b_(b), a_(a) {}\n  void alphaQuantum(Quantum a) { a_ = static_cast<Quantum>(255 - a); }\n  Quantum r() const { return r_; }\n  Quantum a() const { return a_; }\n private:\n  Quantum r_, g_, b_, a_;\n};\nclass ColorGray : public Color {\n public:\n  explicit ColorGray(double shade)\n      : Color(static_cast<Quantum>(shade * 255.0 + 0.5),\n              static_cast<Quantum>(shade * 255.0 + 0.5),\n              static_cast<Quantum>(shade * 255.0 + 0.5), 255) {}\n};\nclass Image {\n public:\n  explicit Image(const std::string &) : w_(1), h_(1), matte_(false), gray_(1, 0), alpha_(1, 255) {}\n  Image(const Geometry & geom, const std::string &)\n      : w_(geom.width()), h_(geom.height()), matte_(false), gray_(w_ * h_, 0), alpha_(w_ * h_, 255) {}\n  Geometry size() const { return Geometry(w_, h_); }\n  void type(ImageType t) { matte_ = (t == TrueColorMatteType); }\n  std::size_t columns() const { return w_; }\n  std::size_t rows() const { return h_; }\n  bool matte() const { return matte_; }\n  void depth(std::size_t) {}\n  void pixelColor(std::size_t x, std::size_t y, const Color & c) {\n    if (x < w_ && y < h_) { gray_[y * w_ + x] = c.r(); alpha_[y * w_ + x] = c.a(); }\n  }\n  void write(std::size_t, std::size_t, std::size_t w, std::size_t h, const std::string & map, StorageType, void * data) const {\n    const auto & src = (map == \"A\") ? alpha_ : gray_;\n    std::memcpy(data, src.data(), w * h);\n  }\n  void write(const std::string &) const {}\n private:\n  std::size_t w_, h_;\n  bool matte_;\n  std::vector<uint8_t> gray_, alpha_;\n};\n}  // namespace Magick\nconstexpr Magick::Quantum TransparentOpacity = 255;\nconstexpr Magick::Quantum MaxRGB = 255;\n#endif\n"],
