load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

COPTS = ["-std=c++17"]

# Header-only msgpack-c (C++) bundled under external/.
cc_library(
    name = "msgpack",
    hdrs = glob(["external/msgpack-c/include/**/*.h*"]),
    includes = ["external/msgpack-c/include"],
    visibility = ["//visibility:private"],
    deps = [
        "@rosdistro//cc:boost.assert",
        "@rosdistro//cc:boost.config",
        "@rosdistro//cc:boost.fusion",
        "@rosdistro//cc:boost.mpl",
        "@rosdistro//cc:boost.numeric_conversion",
        "@rosdistro//cc:boost.optional",
        "@rosdistro//cc:boost.predef",
        "@rosdistro//cc:boost.preprocessor",
        "@rosdistro//cc:boost.utility",
        "@rosdistro//cc:boost.variant",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

cc_library(
    name = "msgpack_parser_lib_library",
    srcs = ["src/msgpack_parser.cpp"],
    hdrs = HEADERS,
    copts = COPTS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":msgpack",
        "@nao_lola_sensor_msgs//:cc",
    ],
)

cc_shared_library(
    name = "msgpack_parser_lib",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":msgpack_parser_lib_library"],
    deps = [":msgpack_parser_lib_library"],
)

cc_library(
    name = "msgpack_packer_lib_library",
    srcs = ["src/msgpack_packer.cpp"],
    hdrs = HEADERS,
    copts = COPTS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":msgpack",
        "@nao_lola_command_msgs//:cc",
    ],
)

cc_shared_library(
    name = "msgpack_packer_lib",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":msgpack_packer_lib_library"],
    deps = [":msgpack_packer_lib_library"],
)

NODE_DEPENDENCIES = {
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
}

cc_library(
    name = "nao_lola_client_node_library",
    srcs = [
        "src/connection.cpp",
        "src/conversion.cpp",
        "src/conversion.hpp",
        "src/nao_lola_client.cpp",
    ],
    hdrs = HEADERS,
    copts = COPTS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + NODE_DEPENDENCIES.values() + [
        ":msgpack_packer_lib_library",
        ":msgpack_parser_lib_library",
        "@rcl_interfaces//:cc",
        "@rosdistro//cc:boost.asio",
        "@sensor_msgs//:cc",
    ],
)

cc_shared_library(
    name = "nao_lola_client_node",
    dynamic_deps = DEPENDENCIES.keys() + NODE_DEPENDENCIES.keys() + [
        ":msgpack_packer_lib",
        ":msgpack_parser_lib",
    ],
    exports_filter = [":nao_lola_client_node_library"],
    deps = [":nao_lola_client_node_library"],
)

### COMPONENTS

rclcpp_components_register_node(
    name = "nao_lola_client",
    component = ":nao_lola_client_node",
    node_name = "nao_lola_client",
    plugin = "NaoLolaClient",
)

### TESTS

collect_transitive_dynamic_deps(
    name = "test_parser_dynamic_deps",
    dynamic_deps = [":msgpack_parser_lib"],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_msgpack_parser",
    srcs = ["test/test_msgpack_parser.cpp"],
    copts = COPTS,
    dynamic_deps = [":test_parser_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        ":msgpack_parser_lib_library",
        "@rosdistro//cc:googletest",
    ],
)

collect_transitive_dynamic_deps(
    name = "test_packer_dynamic_deps",
    dynamic_deps = [":msgpack_packer_lib"],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_msgpack_packer",
    srcs = ["test/test_msgpack_packer.cpp"],
    copts = COPTS,
    dynamic_deps = [":test_packer_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        ":msgpack_packer_lib_library",
        "@rosdistro//cc:googletest",
    ],
)

### AMENT INDEX

LIBRARIES = [
    ":msgpack_packer_lib",
    ":msgpack_parser_lib",
    ":nao_lola_client_node",
]

ament_index(
    name = "ament_index",
    components = [":nao_lola_client_record"],
    executables = [":nao_lola_client"],
    libraries = LIBRARIES,
    package_xml = "package.xml",
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rclcpp",
        "rclcpp_components",
        "nao_lola_sensor_msgs",
        "nao_lola_command_msgs",
        "sensor_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_nao_lola_client",
    components = [":nao_lola_client_record"],
    executables = [":nao_lola_client"],
    headers = HEADERS,
    include_prefix = "",
    libraries = LIBRARIES,
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@nao_lola_command_msgs//:ament_package",
        "@nao_lola_sensor_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
