load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosidl_default_generators//:defs.bzl", "py_ros_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

exports_files(["package.xml"])

### DATA

ament_index(
    name = "ament_index",
    data = ["resource/plugin_container.ui"],
    package_xml = "package.xml",
    deps = [
        "@qt_gui//:ament_index",
    ],
)

### LIBRARIES

py_library(
    name = "rqt_py_common",
    srcs = [
        "src/rqt_py_common/__init__.py",
        "src/rqt_py_common/data_items.py",
        "src/rqt_py_common/extended_combo_box.py",
        "src/rqt_py_common/ini_helper.py",
        "src/rqt_py_common/item_delegates.py",
        "src/rqt_py_common/layout_util.py",
        "src/rqt_py_common/message_helpers.py",
        "src/rqt_py_common/message_tree_model.py",
        "src/rqt_py_common/message_tree_widget.py",
        "src/rqt_py_common/plugin_container_widget.py",
        "src/rqt_py_common/rqt_ros_graph.py",
        "src/rqt_py_common/rqt_roscomm_util.py",
        "src/rqt_py_common/topic_completer.py",
        "src/rqt_py_common/topic_dict.py",
        "src/rqt_py_common/topic_helpers.py",
        "src/rqt_py_common/topic_tree_model.py",
        "src/rqt_py_common/tree_model_completer.py",
    ],
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@python_qt_binding",
        "@qt_gui",
        "@rclpy",
    ],
)

### TESTS

py_ros_library(
    name = "test_msgs",
    deps = [
        "//test/msg:ArrayVal",
        "//test/msg:Val",
        "//test/srv:AddTwoInts",
    ],
)

ament_index(
    name = "test_msgs_ament_index",
    data = [
        "//test/msg:ArrayVal.msg",
        "//test/msg:Val.msg",
        "//test/srv:AddTwoInts.srv",
    ],
    data_strip_prefix = "test",
    export_name = "rqt_py_common_test_interfaces",
)

### PACKAGING

genrule(
    name = "rosidl_cmake_extras",
    outs = [
        "rosidl_cmake-extras.cmake",
        "rosidl_cmake_aggregate_target-extras.cmake",
    ],
    cmd = "touch $(OUTS)",
)

ament_package(
    name = "ament_package",
    cmake = [":rosidl_cmake_extras"],
    cmake_export_dependencies_list = ["rosidl_default_runtime"],
    cmake_extras = [
        "rosidl_cmake-extras.cmake",
        "rosidl_cmake_aggregate_target-extras.cmake",
    ],
    cmake_strip_prefix = "",
    package_xml = "package.xml",
    python = [":rqt_py_common"],
    python_strip_prefix = "src",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@python_qt_binding//:ament_package",
        "@qt_gui//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
    ],
)
