load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

cc_library(
    name = "hls_lfcd_lds_driver",
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:boost.array",
        "@rosdistro//cc:boost.asio",
        "@sensor_msgs//:cc",
    ],
)

### EXECUTABLES

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "hlds_laser_publisher",
    srcs = ["src/hlds_laser_publisher.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [":hls_lfcd_lds_driver"],
)

### AMENT INDEX

DATA = glob([
    "launch/**",
    "rviz/**",
])

ament_index(
    name = "ament_index",
    data = DATA,
    executables = [":hlds_laser_publisher"],
    package_xml = "package.xml",
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [":ament_index"],
    )
    for f in glob(["launch/**"])
]

### PACKAGING

write_file(
    name = "_meta_file_0",
    out = "_gen_meta/share/hls_lfcd_lds_driver/cmake/ament_cmake_export_include_directories-extras.cmake",
    content = [
        "# generated from ament_cmake_export_include_directories/cmake/ament_cmake_export_include_directories-extras.cmake.in",
        "",
        "set(_exported_include_dirs \"${hls_lfcd_lds_driver_DIR}/../../../include\")",
        "",
        "# append include directories to hls_lfcd_lds_driver_INCLUDE_DIRS",
        "# warn about not existing paths",
        "if(NOT _exported_include_dirs STREQUAL \"\")",
        "  find_package(ament_cmake_core QUIET REQUIRED)",
        "  foreach(_exported_include_dir ${_exported_include_dirs})",
        "    if(NOT IS_DIRECTORY \"${_exported_include_dir}\")",
        "      message(WARNING \"Package 'hls_lfcd_lds_driver' exports the include directory '${_exported_include_dir}' which doesn't exist\")",
        "    endif()",
        "    normalize_path(_exported_include_dir \"${_exported_include_dir}\")",
        "    list(APPEND hls_lfcd_lds_driver_INCLUDE_DIRS \"${_exported_include_dir}\")",
        "  endforeach()",
        "endif()",
    ],
    is_executable = False,
)

pkg_files(
    name = "meta_files_0",
    srcs = [":_meta_file_0"],
    prefix = "share/hls_lfcd_lds_driver/cmake",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rclcpp",
        "std_msgs",
        "sensor_msgs",
    ],
    cmake_export_interface = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    cmake_extras = ["ament_cmake_export_include_directories-extras.cmake"],
    data = DATA,
    executables = [":hlds_laser_publisher"],
    install = [":meta_files_0"],
    # Upstream exports include/ but never installs it.
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
