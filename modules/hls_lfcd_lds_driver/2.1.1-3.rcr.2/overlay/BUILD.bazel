load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = [
    "include/hls_lfcd_lds_driver/hlds_laser_segment_publisher.hpp",
    "include/hls_lfcd_lds_driver/lfcd_laser.hpp",
]

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
}

cc_library(
    name = "hls_lfcd_lds_driver",
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:boost.array",
        "@rosdistro//cc:boost.asio",
    ],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "hlds_laser_publisher",
    srcs = ["src/hlds_laser_publisher.cpp"],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [":hls_lfcd_lds_driver"],
)

DATA = ["rviz/hlds_laser.rviz"] + ["//launch:launch_files"]

ament_index(
    name = "ament_index",
    data = DATA,
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rclcpp",
        "sensor_msgs",
        "std_msgs",
    ],
    cmake_export_interface = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    cmake_extras = ["ament_cmake_export_include_directories-extras.cmake"],
    executables = [
        ":hlds_laser_publisher",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
