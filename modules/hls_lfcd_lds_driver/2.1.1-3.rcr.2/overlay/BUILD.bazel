load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

cc_library(
    name = "hls_lfcd_lds_driver",
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:boost.array",
        "@rosdistro//cc:boost.asio",
        "@sensor_msgs//:cc",
    ],
)

### EXECUTABLES

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "hlds_laser_publisher",
    srcs = ["src/hlds_laser_publisher.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [":hls_lfcd_lds_driver"],
)

### AMENT INDEX

DATA = glob([
    "launch/**",
    "rviz/**",
])

ament_index(
    name = "ament_index",
    data = DATA,
    executables = [":hlds_laser_publisher"],
    package_xml = "package.xml",
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rclcpp",
        "std_msgs",
        "sensor_msgs",
    ],
    cmake_export_interface = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    data = DATA,
    executables = [":hlds_laser_publisher"],
    # Upstream exports include/ but never installs it.
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
