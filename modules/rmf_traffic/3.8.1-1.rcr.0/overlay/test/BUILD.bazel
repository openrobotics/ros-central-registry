load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {"@rmf_utils//:rmf_utils": "@rmf_utils//:rmf_utils_library"}

CC_DEPS = [
    "@rosdistro//cc:ccd",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:octomap",
]

cc_test(
    name = "test_rmf_traffic",
    srcs = [
        "main.cpp",
        "regression/regress_Negotiation_segfault.cpp",
        "unit/agv/planning/test_DifferentialDriveHeuristic.cpp",
        "unit/agv/planning/test_EuclideanHeuristic.cpp",
        "unit/agv/planning/test_ShortestPathHeuristic.cpp",
        "unit/agv/planning/test_Supergraph.cpp",
        "unit/agv/test_Graph.cpp",
        "unit/agv/test_Interpolate.cpp",
        "unit/agv/test_LaneClosure.cpp",
        "unit/agv/test_Negotiation_edgecases.cpp",
        "unit/agv/test_Negotiator.cpp",
        "unit/agv/test_Planner.cpp",
        "unit/agv/test_Rollout.cpp",
        "unit/agv/test_VehicleTraits.cpp",
        "unit/agv/test_compute_plan_starts.cpp",
        "unit/blockade/test_blockade_Constraint.cpp",
        "unit/blockade/test_blockade_Moderator.cpp",
        "unit/blockade/test_blockade_conflicts.cpp",
        "unit/blockade/test_blockade_geometry.cpp",
        "unit/blockade/utils_blockade_scenarios.cpp",
        "unit/schedule/test_Database.cpp",
        "unit/schedule/test_Mirror.cpp",
        "unit/schedule/test_Modular.cpp",
        "unit/schedule/test_Negotiation.cpp",
        "unit/schedule/test_Participant.cpp",
        "unit/schedule/test_Query.cpp",
        "unit/schedule/test_Region.cpp",
        "unit/schedule/test_Spacetime.cpp",
        "unit/test_Conflict.cpp",
        "unit/test_Profile.cpp",
        "unit/test_Shape.cpp",
        "unit/test_Space.cpp",
        "unit/test_Spline.cpp",
        "unit/test_Trajectory.cpp",
        "unit/test_make_shapes.cpp",
    ] + [
        "unit/blockade/utils_blockade_scenarios.hpp",
        "unit/blockade/utils_blockade_simulation.hpp",
        "unit/schedule/utils_Database.hpp",
        "unit/utils_Conflict.hpp",
        "unit/utils_Trajectory.hpp",
    ] + [
        "//:gen_fcl_fcl_config_h",
        "//:gen_fcl_fcl_export_h",
        "//:gen_fcl_fcl_fcl_h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
        "-include",
        "cassert",
    ],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "NDEBUG",
        "RMF_TRAFFIC__USING_FCL_0_6",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:fcl_library",
        "//:rmf_traffic_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:catch2",
    ] + ["//:_test_root_headers"],
)
