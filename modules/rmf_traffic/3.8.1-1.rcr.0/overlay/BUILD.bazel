    content = ["#pragma once\n#include <cstddef>\n#include <cmath>\n#include <cfloat>\ntypedef double ccd_real_t;\n#define CCD_REAL(x) (x)\n#define CCD_SQRT(x) std::sqrt(x)\n#define CCD_FABS(x) std::fabs(x)\n#define CCD_EPS DBL_EPSILON\n#define CCD_REAL_MAX DBL_MAX\n#define CCD_ZERO 0.0\n#define CCD_ONE 1.0\nstruct _ccd_vec3_t {\n  ccd_real_t v[3];\n  operator const _ccd_vec3_t *() const { return this; }\n};\ntypedef struct _ccd_vec3_t ccd_vec3_t;\n#define CCD_VEC3_STATIC(x, y, z) { { (x), (y), (z) } }\n#define CCD_VEC3(name, x, y, z) ccd_vec3_t name = CCD_VEC3_STATIC((x), (y), (z))\nstatic const ccd_vec3_t ccd_vec3_origin = CCD_VEC3_STATIC(0, 0, 0);\nstatic const ccd_vec3_t ccd_points_on_sphere[1] = { CCD_VEC3_STATIC(0, 0, 1) };\nstatic const size_t ccd_points_on_sphere_len = 1;\ninline int ccdIsZero(ccd_real_t val) { return std::fabs(val) < CCD_EPS; }\ninline int ccdSign(ccd_real_t val) { return ccdIsZero(val) ? 0 : (val < 0 ? -1 : 1); }\ninline int ccdEq(ccd_real_t a, ccd_real_t b) { return ccdIsZero(a - b); }\ninline ccd_real_t ccdVec3X(const ccd_vec3_t * v) { return v->v[0]; }\ninline ccd_real_t ccdVec3Y(const ccd_vec3_t * v) { return v->v[1]; }\ninline ccd_real_t ccdVec3Z(const ccd_vec3_t * v) { return v->v[2]; }\ninline int ccdVec3Eq(const ccd_vec3_t * a, const ccd_vec3_t * b) { return ccdEq(a->v[0], b->v[0]) && ccdEq(a->v[1], b->v[1]) && ccdEq(a->v[2], b->v[2]); }\ninline ccd_real_t ccdVec3Len2(const ccd_vec3_t * v) { return v->v[0]*v->v[0] + v->v[1]*v->v[1] + v->v[2]*v->v[2]; }\ninline ccd_real_t ccdVec3Dist2(const ccd_vec3_t * a, const ccd_vec3_t * b) { ccd_real_t dx=a->v[0]-b->v[0], dy=a->v[1]-b->v[1], dz=a->v[2]-b->v[2]; return dx*dx+dy*dy+dz*dz; }\ninline void ccdVec3Set(ccd_vec3_t * v, ccd_real_t x, ccd_real_t y, ccd_real_t z) { v->v[0]=x; v->v[1]=y; v->v[2]=z; }\ninline void ccdVec3Copy(ccd_vec3_t * d, const ccd_vec3_t * s) { *d = *s; }\ninline void ccdVec3Sub(ccd_vec3_t * d, const ccd_vec3_t * a) { d->v[0]-=a->v[0]; d->v[1]-=a->v[1]; d->v[2]-=a->v[2]