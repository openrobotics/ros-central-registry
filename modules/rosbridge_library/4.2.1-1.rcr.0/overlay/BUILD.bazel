load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "rosbridge_library",
    srcs = [
        "src/rosbridge_library/__init__.py",
        "src/rosbridge_library/capabilities/__init__.py",
        "src/rosbridge_library/capabilities/action_feedback.py",
        "src/rosbridge_library/capabilities/action_result.py",
        "src/rosbridge_library/capabilities/advertise.py",
        "src/rosbridge_library/capabilities/advertise_action.py",
        "src/rosbridge_library/capabilities/advertise_service.py",
        "src/rosbridge_library/capabilities/call_service.py",
        "src/rosbridge_library/capabilities/defragmentation.py",
        "src/rosbridge_library/capabilities/fragmentation.py",
        "src/rosbridge_library/capabilities/publish.py",
        "src/rosbridge_library/capabilities/send_action_goal.py",
        "src/rosbridge_library/capabilities/service_response.py",
        "src/rosbridge_library/capabilities/subscribe.py",
        "src/rosbridge_library/capabilities/unadvertise_action.py",
        "src/rosbridge_library/capabilities/unadvertise_service.py",
        "src/rosbridge_library/capability.py",
        "src/rosbridge_library/internal/__init__.py",
        "src/rosbridge_library/internal/actions.py",
        "src/rosbridge_library/internal/cbor_conversion.py",
        "src/rosbridge_library/internal/exceptions.py",
        "src/rosbridge_library/internal/executor_helpers.py",
        "src/rosbridge_library/internal/message_conversion.py",
        "src/rosbridge_library/internal/outgoing_message.py",
        "src/rosbridge_library/internal/pngcompression.py",
        "src/rosbridge_library/internal/publishers.py",
        "src/rosbridge_library/internal/qos_extraction.py",
        "src/rosbridge_library/internal/ros_loader.py",
        "src/rosbridge_library/internal/services.py",
        "src/rosbridge_library/internal/subscribers.py",
        "src/rosbridge_library/internal/subscription_modifiers.py",
        "src/rosbridge_library/internal/topics.py",
        "src/rosbridge_library/internal/type_support.py",
        "src/rosbridge_library/protocol.py",
        "src/rosbridge_library/rosbridge_protocol.py",
        "src/rosbridge_library/util/__init__.py",
        "src/rosbridge_library/util/ros.py",
    ],
    imports = ["src"],
    deps = [
        requirement("pillow"),
        "@action_msgs//:py",
        "@builtin_interfaces//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

ament_index(
    name = "ament_index_test",
    testonly = True,
    package_xml = "package.xml",
    deps = [
        "@action_msgs//:ament_index",
        "@builtin_interfaces//:ament_index",
        "@diagnostic_msgs//:ament_index",
        "@example_interfaces//:ament_index",
        "@geometry_msgs//:ament_index",
        "@nav_msgs//:ament_index",
        "@rcl_interfaces//:ament_index",
        "@rosbridge_test_msgs//:ament_index",
        "@sensor_msgs//:ament_index",
        "@std_msgs//:ament_index",
        "@std_srvs//:ament_index",
        "@stereo_msgs//:ament_index",
        "@tf2_msgs//:ament_index",
        "@trajectory_msgs//:ament_index",
        "@visualization_msgs//:ament_index",
    ],
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":rosbridge_library"],
    python_strip_prefix = "src",
    deps = [
        "@action_msgs//:ament_package",
        "@ament_cmake_mypy//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@control_msgs//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@example_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosbridge_test_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_pycommon//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@stereo_msgs//:ament_package",
        "@tf2_msgs//:ament_package",
        "@trajectory_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
