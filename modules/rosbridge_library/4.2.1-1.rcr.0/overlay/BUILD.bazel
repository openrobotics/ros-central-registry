load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

py_library(
    name = "rosbridge_library",
    srcs = glob(["src/rosbridge_library/**/*.py"]),
    imports = ["src"],
    deps = [
        requirement("pillow"),
        "@action_msgs//:py",
        "@builtin_interfaces//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

ament_index(
    name = "ament_index_test",
    testonly = True,
    package_xml = "package.xml",
    deps = [
        "@action_msgs//:ament_index",
        "@builtin_interfaces//:ament_index",
        "@diagnostic_msgs//:ament_index",
        "@example_interfaces//:ament_index",
        "@geometry_msgs//:ament_index",
        "@nav_msgs//:ament_index",
        "@rcl_interfaces//:ament_index",
        "@rosbridge_test_msgs//:ament_index",
        "@sensor_msgs//:ament_index",
        "@std_msgs//:ament_index",
        "@std_srvs//:ament_index",
        "@stereo_msgs//:ament_index",
        "@tf2_msgs//:ament_index",
        "@trajectory_msgs//:ament_index",
        "@visualization_msgs//:ament_index",
    ],
)

TEST_DEPS = [
    ":rosbridge_library",
    "@action_msgs//:py",
    "@builtin_interfaces//:py",
    "@diagnostic_msgs//:py",
    "@example_interfaces//:py",
    "@geometry_msgs//:py",
    "@nav_msgs//:py",
    "@rcl_interfaces//:py",
    "@rosbridge_test_msgs//:py",
    "@sensor_msgs//:py",
    "@std_msgs//:py",
    "@std_srvs//:py",
    "@stereo_msgs//:py",
    "@tf2_msgs//:py",
    "@trajectory_msgs//:py",
    "@visualization_msgs//:py",
]

py_pytest(
    name = "test_capabilities",
    srcs = [
        "test/capabilities/__init__.py",
        "test/capabilities/test_action_capabilities.py",
        "test/capabilities/test_advertise.py",
        "test/capabilities/test_call_service.py",
        "test/capabilities/test_publish.py",
        "test/capabilities/test_qos.py",
        "test/capabilities/test_service_capabilities.py",
        "test/capabilities/test_subscribe.py",
    ],
    data = [":ament_index_test"],
    tags = ["manual"],
    deps = TEST_DEPS,
)

py_pytest(
    name = "test_internal",
    srcs = [
        "test/internal/__init__.py",
        "test/internal/actions/test_actions.py",
        "test/internal/publishers/__init__.py",
        "test/internal/publishers/test_multi_publisher.py",
        "test/internal/publishers/test_publisher_manager.py",
        "test/internal/services/test_services.py",
        "test/internal/services/test_stress_service_clients.py",
        "test/internal/subscribers/__init__.py",
        "test/internal/subscribers/test_multi_subscriber.py",
        "test/internal/subscribers/test_subscriber_manager.py",
        "test/internal/subscribers/test_subscription_modifiers.py",
        "test/internal/test_cbor_conversion.py",
        "test/internal/test_compression.py",
        "test/internal/test_message_conversion.py",
        "test/internal/test_outgoing_message.py",
        "test/internal/test_ros_loader.py",
        "test/internal/test_ros_loader_concurrent.py",
    ],
    data = [":ament_index_test"],
    tags = ["manual"],
    deps = TEST_DEPS,
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":rosbridge_library"],
    python_strip_prefix = "src",
    deps = [
        "@action_msgs//:ament_package",
        "@ament_cmake_mypy//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@control_msgs//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@example_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosbridge_test_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_pycommon//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@stereo_msgs//:ament_package",
        "@tf2_msgs//:ament_package",
        "@trajectory_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
