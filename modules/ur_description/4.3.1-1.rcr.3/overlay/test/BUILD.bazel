load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "_root_test_files_0",
    srcs = [
        "test_ur_urdf_xacro.py",
        "test_view_ur_launch.py",
    ],
)

py_pytest(
    name = "ur_urdf_xacro",
    srcs = ["test_ur_urdf_xacro.py"],
    data = [
        "//:ament_index",
        "@urdfdom//:check_urdf",
        "@xacro",
        "@xacro//:ament_index",
    ],
    deps = ["@ament_index_python"],
)

launch_ros_test(
    name = "view_ur_launch",
    src = "test_view_ur_launch.py",
    data = [
        "//:ament_index",
        "//launch:view_ur_launch_py",
        "@joint_state_publisher_gui//:ament_index",
        "@robot_state_publisher",
        "@robot_state_publisher//:ament_index",
        "@rviz2",
        "@rviz2//:ament_index",
        "@xacro",
        "@xacro//:ament_index",
    ],
    tags = ["exclusive"],
    deps = [
        "@ament_index_python",
        "@joint_state_publisher_gui",
        "@launch_xml",
    ],
)
