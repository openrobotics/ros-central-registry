load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### DATA

ament_index(
    name = "ament_index",
    data = glob([
        "config/**",
        "launch/**",
        "meshes/**",
        "rviz/**",
        "urdf/**",
    ]),
    package_xml = "package.xml",
)

### TESTS

py_pytest(
    name = "ur_urdf_xacro",
    srcs = ["test/test_ur_urdf_xacro.py"],
    data = [
        ":ament_index",
        "@urdfdom//:check_urdf",
        "@xacro",
    ],
    deps = [
        "@ament_index_python",
    ],
)

py_pytest(
    name = "view_ur_launch",
    srcs = ["test/test_view_ur_launch.py"],
    data = [
        ":ament_index",
        "@robot_state_publisher//:ament_package",
        "@xacro",
    ],
    deps = [
        "@ament_index_python",
        "@launch",
        "@launch_ros",
        "@launch_testing",
        "@launch_testing_ros",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_index_python//:ament_package",
        "@joint_state_publisher_gui//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
        "@urdf//:ament_package",
        "@urdfdom//:ament_package",
        "@xacro//:ament_package",
    ],
)
