load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "view_ur.launch.py",
        "view_ur.launch.xml",
    ],
)

launch_ros_binary(
    name = "view_ur_launch_py",
    src = "view_ur.launch.py",
    data = [
        ":view_ur_launch_xml",
        "//:ament_index",
    ],
    deps = [
        ":view_ur_launch_xml",
    ],
)

launch_ros_binary(
    name = "view_ur_launch_xml",
    src = "view_ur.launch.xml",
    data = [
        "//:ament_index",
        "@joint_state_publisher_gui//:ament_index",
        "@robot_state_publisher//:ament_index",
        "@rviz2//:ament_index",
        "@xacro//:ament_index",
    ],
)
