load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            ".coveragerc",
            "CHANGELOG.rst",
            "package.xml",
            "resource/ros2trace_analysis",
            "ros2trace_analysis/__init__.py",
            "ros2trace_analysis/api/__init__.py",
            "ros2trace_analysis/command/__init__.py",
            "ros2trace_analysis/command/trace_analysis.py",
            "ros2trace_analysis/verb/__init__.py",
            "ros2trace_analysis/verb/convert.py",
            "ros2trace_analysis/verb/process.py",
            "setup.py",
            "test/test_copyright.py",
            "test/test_flake8.py",
            "test/test_mypy.py",
            "test/test_pep257.py",
            "test/test_xmllint.py",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "mypy",
        "pep257",
        "xmllint",
    ]
]

py_library(
    name = "ros2trace_analysis",
    srcs = [
        "ros2trace_analysis/__init__.py",
        "ros2trace_analysis/api/__init__.py",
        "ros2trace_analysis/command/__init__.py",
        "ros2trace_analysis/command/trace_analysis.py",
        "ros2trace_analysis/verb/__init__.py",
        "ros2trace_analysis/verb/convert.py",
        "ros2trace_analysis/verb/process.py",
    ],
    imports = ["."],
    deps = [
        "@ros2cli",
        "@tracetools_analysis",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":ros2trace_analysis"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@ros2cli//:ament_package",
        "@rosdistro//:ament_package",
        "@tracetools_analysis//:ament_package",
    ],
)
