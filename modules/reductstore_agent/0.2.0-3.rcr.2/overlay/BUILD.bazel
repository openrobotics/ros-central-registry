load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
    ]
]

py_library(
    name = "reductstore_agent",
    srcs = glob(["reductstore_agent/**/*.py"]),
    imports = ["."],
    deps = [
        "@rclpy",
        "@std_msgs//:py",
        "@std_srvs//:py",
        requirement("pydantic"),
    ],
)

py_pytest(
    name = "test_entry_point",
    srcs = ["test/test_entry_point.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":reductstore_agent"],
)

py_pytest(
    name = "test_recorder_params",
    srcs = ["test/test_recorder_params.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":reductstore_agent"],
)

py_pytest(
    name = "test_recorder_state",
    srcs = ["test/test_recorder_state.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":reductstore_agent"],
)

py_pytest(
    name = "test_si_units",
    srcs = ["test/test_si_units.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":reductstore_agent"],
)

py_pytest(
    name = "test_storage",
    srcs = ["test/test_storage.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":reductstore_agent"],
)

py_pytest(
    name = "test_topic_subscription",
    srcs = ["test/test_topic_subscription.py"],
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":reductstore_agent"],
)

ament_index(
    name = "ament_index",
    data = [
        "config/params.yml",
        "launch/reductstore_agent_launch.py",
    ],
    package_xml = "package.xml",
)

launch_ros_binary(
    name = "reductstore_agent_launch.py",
    src = "launch/reductstore_agent_launch.py",
    data = [":ament_index"],
    deps = [":reductstore_agent"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"recorder": "reductstore_agent.recorder:main"},
    data = [
        "config/params.yml",
        "launch/reductstore_agent_launch.py",
    ],
    package_xml = "package.xml",
    python = [":reductstore_agent"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
