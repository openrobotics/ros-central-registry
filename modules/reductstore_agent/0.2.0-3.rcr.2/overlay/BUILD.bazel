load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    args = ["--noconftest"],
    data = [
        ".github/workflows/ci.yml",
        ".pre-commit-config.yaml",
        "CHANGELOG.rst",
        "CONTRIBUTING.md",
        "LICENSE",
        "README.md",
        "config/params.yml",
        "package.xml",
        "pyproject.toml",
        "reductstore_agent/__init__.py",
        "reductstore_agent/config_models.py",
        "reductstore_agent/recorder.py",
        "reductstore_agent/utils.py",
        "resource/reductstore_agent",
        "setup.cfg",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
]]

py_library(
    name = "reductstore_agent",
    srcs = [
        "reductstore_agent/__init__.py",
        "reductstore_agent/config_models.py",
        "reductstore_agent/recorder.py",
        "reductstore_agent/utils.py",
    ],
    imports = ["."],
    deps = [
        "@rclpy",
        "@std_msgs//:py",
        "@std_srvs//:py",
        requirement("pydantic"),
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "config/params.yml",
        "//launch:launch_files",
    ],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    console_scripts = {"recorder": "reductstore_agent.recorder:main"},
    package_xml = "package.xml",
    python = [":reductstore_agent"],
    deps = [":ament_index"] + [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
