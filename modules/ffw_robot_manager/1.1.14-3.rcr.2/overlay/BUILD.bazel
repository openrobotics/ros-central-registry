load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

generate_parameter_library(
    name = "ffw_robot_manager_parameters",
    yaml_file = "src/ffw_robot_manager_parameters.yaml",
)

DEPENDENCIES = {
    "@controller_interface//:controller_interface": "@controller_interface//:controller_interface_library",
    "@dynamixel_hardware_interface//:dynamixel_hardware_interface": "@dynamixel_hardware_interface//:dynamixel_hardware_interface_library",
    "@generate_parameter_library//:rsl": "@generate_parameter_library//:rsl_library",
    "@hardware_interface//:hardware_interface": "@hardware_interface//:hardware_interface_library",
    "@hardware_interface//:mock_components": "@hardware_interface//:mock_components_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libcap": "@rosdistro//cc:libcap_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    ":ffw_robot_manager_parameters",
    "@dynamixel_interfaces//:cc",
    "@generate_parameter_library//:generate_parameter_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
    "@sensor_msgs//:cc",
    "@std_srvs//:cc",
]

cc_library(
    name = "ffw_robot_manager_library",
    srcs = [
        "src/battery_model.cpp",
        "src/ffw_robot_manager.cpp",
        "src/robot_type.cpp",
        "src/ubetter_battery_model.cpp",
    ],
    hdrs = [
        "include/ffw_robot_manager/battery_model.hpp",
        "include/ffw_robot_manager/ffw_robot_manager.hpp",
        "include/ffw_robot_manager/robot_type.hpp",
        "include/ffw_robot_manager/topic_watchdog.hpp",
        "include/ffw_robot_manager/ubetter_battery_model.hpp",
    ] + [":ffw_robot_manager_parameters_gen"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "_gen/include/ffw_robot_manager",
        "include",
        "include/ffw_robot_manager",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ffw_robot_manager",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":ffw_robot_manager_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":ffw_robot_manager"],
    package_xml = "package.xml",
    plugin_category = "controller_interface",
    plugins = ["ffw_robot_manager_plugin.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@controller_interface//:ament_package",
        "@dynamixel_hardware_interface//:ament_package",
        "@dynamixel_interfaces//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@hardware_interface//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "fmt",
        "rclcpp",
        "rclcpp_lifecycle",
        "rsl",
        "tcb_span",
        "tl-expected",
        "rclcpp",
        "controller_interface",
        "hardware_interface",
        "pluginlib",
        "std_srvs",
        "dynamixel_hardware_interface",
        "dynamixel_interfaces",
        "sensor_msgs",
        "generate_parameter_library",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_ffw_robot_manager",
    headers = [
        "include/ffw_robot_manager/battery_model.hpp",
        "include/ffw_robot_manager/ffw_robot_manager.hpp",
        "include/ffw_robot_manager/robot_type.hpp",
        "include/ffw_robot_manager/topic_watchdog.hpp",
        "include/ffw_robot_manager/ubetter_battery_model.hpp",
    ],
    libraries = [":ffw_robot_manager"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@controller_interface//:ament_package",
        "@dynamixel_hardware_interface//:ament_package",
        "@dynamixel_interfaces//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@hardware_interface//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
