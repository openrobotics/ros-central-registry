package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@controller_interface//:controller_interface_library",
    "@dynamixel_hardware_interface//:dynamixel_hardware_interface_library",
    "@dynamixel_interfaces//:cc",
    "@generate_parameter_library//:generate_parameter_library",
    "@hardware_interface//:hardware_interface_library",
    "@hardware_interface//:mock_components_library",
    "@rclcpp//:node_wrapper",
