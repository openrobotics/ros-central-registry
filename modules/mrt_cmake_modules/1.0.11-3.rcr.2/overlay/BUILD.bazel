load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

ament_package(
    name = "ament_package",
    cmake_extras = ["mrt_cmake_modules-extras.cmake"],
    data = [
        "ci_templates/CMakeLists.txt",
        "scripts/eval_coverage.py",
        "scripts/generate_cmake_dependency_file.py",
        "scripts/init_coverage.py",
        "scripts/run_test.py",
        "yaml/cmake.yaml",
    ] + glob(["cmake/**"]),
    package_xml = "package.xml",
    programs = [
        "scripts/generate_cmakelists.py",
    ],
    deps = [
        "@ament_cmake_core//:ament_package",
        "@gtest_vendor//:ament_package",
        "@ros_environment//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
