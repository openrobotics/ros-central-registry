load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_package")

package(default_visibility = ["//visibility:public"])

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_cmake//:ament_package",
        "@mola_bridge_ros2//:ament_package",
        "@mola_common//:ament_package",
        "@mola_imu_preintegration//:ament_package",
        "@mola_input_kitti360_dataset//:ament_package",
        "@mola_input_kitti_dataset//:ament_package",
        "@mola_input_mulran_dataset//:ament_package",
        "@mola_input_paris_luco_dataset//:ament_package",
        "@mola_input_rawlog//:ament_package",
        "@mola_input_rosbag2//:ament_package",
        "@mola_kernel//:ament_package",
        "@mola_launcher//:ament_package",
        "@mola_metric_maps//:ament_package",
        "@mola_pose_list//:ament_package",
        "@mola_state_estimation_simple//:ament_package",
        "@mola_state_estimation_smoother//:ament_package",
        "@mola_test_datasets//:ament_package",
        "@mola_viz//:ament_package",
        "@mola_yaml//:ament_package",
        "@mp2p_icp//:ament_package",
        "@ros_environment//:ament_package",
        "@rosbag2_storage_mcap//:ament_package",
        "@rosdistro//:ament_package",
    ],
)

launch_ros_binary(
    name = "ros2_launchs_kitti_ros2_lidar_odometry_launch_py",
    src = "ros2-launchs/kitti-ros2-lidar-odometry.launch.py",
    data = [
        "@mola_launcher//:ament_index",
        "@rviz2//:ament_index",
    ],
)

launch_ros_binary(
    name = "ros2_launchs_ros2_lidar_odometry_launch_py",
    src = "ros2-launchs/ros2-lidar-odometry.launch.py",
    data = [
        "@diagnostic_aggregator//:ament_index",
        "@mola_launcher//:ament_index",
        "@mola_state_estimation_smoother//:ament_package",
        "@rviz2//:ament_index",
    ],
)
