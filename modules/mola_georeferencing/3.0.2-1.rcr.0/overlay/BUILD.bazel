load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
)

DEPENDENCIES = {
    "@gtsam//:gtsam": "@gtsam//:gtsam_library",
    "@mola_gtsam_factors//:mola_gtsam_factors": "@mola_gtsam_factors//:mola_gtsam_factors_library",
    "@mola_yaml//:mola_yaml": "@mola_yaml//:mola_yaml_library",
    "@mp2p_icp//:mp2p_icp": "@mp2p_icp//:mp2p_icp_library",
    "@mp2p_icp//:mp2p_icp_common": "@mp2p_icp//:mp2p_icp_common_library",
    "@mp2p_icp//:mp2p_icp_map": "@mp2p_icp//:mp2p_icp_map_library",
    "@mrpt_maps//:mrpt_maps": "@mrpt_maps//:mrpt_maps_library",
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

HEADERS = [
    "include/mola_georeferencing/simplemap_georeference.h",
]

cc_library(
    name = "mola_georeferencing_library",
    srcs = [
        "src/simplemap_georeference.cpp",
    ],
    hdrs = HEADERS,
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    defines = [
        "MP2P_ICP_HAS_MOLA_IMU_PREINTEGRATION",
    ],
    includes = [
        "include",
        "include/mola_georeferencing",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=0",
        "MOLA_PATCH_VERSION=2",
        "NDEBUG",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_georeferencing",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mola_georeferencing_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":mola_georeferencing",
        "@rosdistro//cc:cli11_shared",
    ],
)

[
    cc_binary(
        name = app_name,
        srcs = ["apps/{}".format(app_src)],
        copts = ["-Wno-missing-template-arg-list-after-template-kw"],
        data = [":ament_index"],
        dynamic_deps = [":transitive_dynamic_deps"],
        deps = DEPENDENCIES.values() + CC_DEPS + [
            ":mola_georeferencing_library",
            "@rosdistro//cc:cli11",
        ],
    )
    for app_name, app_src in [
        ("mola-sm-georeferencing", "mola-sm-georeferencing-cli.cpp"),
        ("mola-trajectory-georef", "mola-trajectory-georef-cli.cpp"),
        ("mola-mm-add-geodetic", "mola-mm-add-geodetic-cli.cpp"),
    ]
]

### TESTS

[
    cc_test(
        name = test_name,
        srcs = ["tests/{}.cpp".format(test_name)],
        copts = ["-Wno-missing-template-arg-list-after-template-kw"],
        data = [":ament_index"],
        dynamic_deps = [":transitive_dynamic_deps"],
        deps = DEPENDENCIES.values() + CC_DEPS + [
            ":mola_georeferencing_library",
        ],
    )
    for test_name in [
        "test_gnss_and_imu_attitude",
        "test_gnss_degeneracy",
        "test_gnss_sensor_pose_offset",
        "test_imu_attitude",
        "test_imu_full_attitude",
        "test_recenter_georeference",
    ]
]

### PACKAGING

ament_index(
    name = "ament_index",
    libraries = [":mola_georeferencing"],
    package_xml = "package.xml",
    sonames = {"mola_georeferencing": [
        "libmola_georeferencing.so.3.0",
        "libmola_georeferencing.so.3.0.2",
    ]},
    deps = [
        "@gtsam//:ament_package",
        "@mola_common//:ament_package",
        "@mola_gtsam_factors//:ament_package",
        "@mola_yaml//:ament_package",
        "@mp2p_icp//:ament_package",
        "@mrpt_maps//:ament_package",
    ],
)

ament_package(
    name = "ament_package",
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    executables = [
        ":mola-mm-add-geodetic",
        ":mola-sm-georeferencing",
        ":mola-trajectory-georef",
    ],
    headers = HEADERS,
    include_prefix = "",
    install_package_xml = False,
    libraries = [":mola_georeferencing"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@gtsam//:ament_package",
        "@mola_common//:ament_package",
        "@mola_gtsam_factors//:ament_package",
        "@mola_yaml//:ament_package",
        "@mp2p_icp//:ament_package",
        "@mrpt_maps//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
