load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

ament_index(
    name = "ament_index",
    data = [
        "xml_cache/README.md",
        "xml_cache/xhtml-cache.xml",
        "xml_cache/xml.xsd",
    ],
    package_xml = "package.xml",
)

write_file(
    name = "pkg_info",
    out = "sros2-0.16.6.egg-info/PKG-INFO",
    content = [
        "Metadata-Version: 2.1",
        "Name: sros2",
        "Version: 0.16.6",
    ],
)

write_file(
    name = "entry_points_txt",
    out = "sros2-0.16.6.egg-info/entry_points.txt",
    content = [
        "[ros2cli.command]",
        "security = sros2.command.security:SecurityCommand",
        "",
        "[ros2cli.extension_point]",
        "sros2.verb = sros2.verb:VerbExtension",
        "",
        "[sros2.verb]",
        "create_enclave = sros2.verb.create_enclave:CreateEnclaveVerb",
        "create_keystore = sros2.verb.create_keystore:CreateKeystoreVerb",
        "create_permission = sros2.verb.create_permission:CreatePermissionVerb",
        "generate_artifacts = sros2.verb.generate_artifacts:GenerateArtifactsVerb",
        "generate_policy = sros2.verb.generate_policy:GeneratePolicyVerb",
        "list_enclaves = sros2.verb.list_enclaves:ListEnclavesVerb",
    ],
)

py_library(
    name = "sros2",
    srcs = [
        "sros2/__init__.py",
        "sros2/_utilities.py",
        "sros2/api/__init__.py",
        "sros2/api/_artifact_generation.py",
        "sros2/api/_policy.py",
        "sros2/command/__init__.py",
        "sros2/command/security.py",
        "sros2/errors.py",
        "sros2/keystore/__init__.py",
        "sros2/keystore/_enclave.py",
        "sros2/keystore/_keystore.py",
        "sros2/keystore/_permission.py",
        "sros2/policy/__init__.py",
        "sros2/policy/defaults/__init__.py",
        "sros2/policy/defaults/dds/__init__.py",
        "sros2/policy/schemas/__init__.py",
        "sros2/policy/schemas/dds/__init__.py",
        "sros2/policy/templates/__init__.py",
        "sros2/policy/templates/dds/__init__.py",
        "sros2/verb/__init__.py",
        "sros2/verb/create_enclave.py",
        "sros2/verb/create_keystore.py",
        "sros2/verb/create_permission.py",
        "sros2/verb/generate_artifacts.py",
        "sros2/verb/generate_policy.py",
        "sros2/verb/list_enclaves.py",
    ],
    data = [
        "sros2/policy/defaults/dds/governance.xml",
        "sros2/policy/defaults/policy.xml",
        "sros2/policy/schemas/dds/governance.xsd",
        "sros2/policy/schemas/dds/permissions.xsd",
        "sros2/policy/schemas/policy.xsd",
        "sros2/policy/templates/dds/permissions.xsl",
        "sros2/policy/templates/policy.xsl",
    ] + [
        ":ament_index",
        ":entry_points_txt",
        ":pkg_info",
    ],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@rclpy",
        "@ros2cli",
        requirement("argcomplete"),
        requirement("cryptography"),
        requirement("lxml"),
    ],
)

ament_package(
    name = "ament_package",
    data = [
        "xml_cache/README.md",
        "xml_cache/xhtml-cache.xml",
        "xml_cache/xml.xsd",
    ],
    package_xml = "package.xml",
    python = [":sros2"] + [
        "sros2/policy/defaults/dds/governance.xml",
        "sros2/policy/defaults/policy.xml",
        "sros2/policy/schemas/dds/governance.xsd",
        "sros2/policy/schemas/dds/permissions.xsd",
        "sros2/policy/schemas/policy.xsd",
        "sros2/policy/templates/dds/permissions.xsl",
        "sros2/policy/templates/policy.xsl",
    ],
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@rclpy//:ament_package",
        "@ros2cli//:ament_package",
        "@ros_testing//:ament_package",
        "@rosdistro//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
