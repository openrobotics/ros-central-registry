load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

_XFAIL_TESTS = [
    "test_generate_policy",
    "test_generate_policy_no_nodes",
]

[py_pytest(
    name = f.split("/")[-1].removesuffix(".py"),
    srcs = [f],
    data = [
        "conftest.py",
        "policies/add_two_ints.policy.xml",
        "policies/common/lifecycle_node.xml",
        "policies/common/node.xml",
        "policies/common/node/logging.xml",
        "policies/common/node/parameters.xml",
        "policies/common/node/time.xml",
        "policies/common/node/types.xml",
        "policies/invalid_policy_missing_topics_tag.xml",
        "policies/minimal_action.policy.xml",
        "policies/permissions/add_two_ints/permissions.xml",
        "policies/permissions/minimal_action/permissions.xml",
        "policies/permissions/sample/permissions.xml",
        "policies/permissions/single_context/permissions.xml",
        "policies/permissions/talker_listener/permissions.xml",
        "policies/policy_to_permissions.py",
        "policies/sample.policy.xml",
        "policies/single_context.policy.xml",
        "policies/talker_listener.policy.xml",
        "sros2/commands/security/verbs/fixtures/client_service_node.py",
        "sros2/commands/security/verbs/fixtures/pub_sub_node.py",
        "sros2/commands/security/verbs/test_create_enclave.py",
        "sros2/commands/security/verbs/test_create_keystore.py",
        "sros2/commands/security/verbs/test_create_permission.py",
        "sros2/commands/security/verbs/test_generate_artifacts.py",
        "sros2/commands/security/verbs/test_generate_policy.py",
        "sros2/commands/security/verbs/test_generate_policy_no_nodes.py",
        "sros2/commands/security/verbs/test_list_enclaves.py",
        "sros2/commands/security/verbs/test_no_verb.py",
        "sros2/commands/security/verbs/utilities/__init__.py",
        "sros2/commands/security/verbs/utilities/sros2_cli_test_case.py",
        "sros2/keystore/test_enclave.py",
        "sros2/test_utilities.py",
        "test_copyright.py",
        "test_flake8.py",
        "test_mypy.py",
        "test_pep257.py",
        "test_policy_to_permissions.py",
    ],
    tags = [
        "manual",
        "xfail",
    ] if f.split("/")[-1].removesuffix(".py") in _XFAIL_TESTS else [],
    deps = [
        "//:sros2",
        "@rclpy",
        "@ros2cli",
        "@rules_python//python/runfiles",
        "@test_msgs//:py",
    ],
) for f in [
    "sros2/commands/security/verbs/test_create_enclave.py",
    "sros2/commands/security/verbs/test_create_keystore.py",
    "sros2/commands/security/verbs/test_create_permission.py",
    "sros2/commands/security/verbs/test_generate_artifacts.py",
    "sros2/commands/security/verbs/test_generate_policy.py",
    "sros2/commands/security/verbs/test_generate_policy_no_nodes.py",
    "sros2/commands/security/verbs/test_list_enclaves.py",
    "sros2/commands/security/verbs/test_no_verb.py",
    "sros2/keystore/test_enclave.py",
    "sros2/test_utilities.py",
    "test_policy_to_permissions.py",
]]

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["test_{0}.py".format(linter)],
    data = [
        "conftest.py",
        "policies/add_two_ints.policy.xml",
