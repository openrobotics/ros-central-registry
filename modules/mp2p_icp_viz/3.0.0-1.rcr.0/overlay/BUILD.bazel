load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

cc_library(
    name = "imgui_app_common_library",
    srcs = [":gen_mp2p_icp_viz_stub_cpp"],
    hdrs = glob(
        [
            "apps/imgui_app_common/include/**/*.h",
        ],
        allow_empty = True,
    ),
    includes = ["apps/imgui_app_common/include"],
    local_defines = ros_local_defines(),
    deps = [
        "@mp2p_icp_core//:mp2p_icp_library",
        "@mrpt_gui//:mrpt_gui_library",
        "@mrpt_imgui//:mrpt_imgui_library",
        "@mrpt_imgui_vendor//:mrpt_imgui_vendor_library",
        "@mrpt_opengl//:mrpt_opengl_library",
    ],
)

cc_binary(
    name = "icp-log-viewer",
    srcs = [":gen_mp2p_icp_viz_stub_cpp"],
    deps = [":imgui_app_common_library"],
)

cc_binary(
    name = "mm-viewer",
    srcs = [":gen_mp2p_icp_viz_stub_cpp"],
    deps = [":imgui_app_common_library"],
)

write_file(
    name = "gen_mp2p_icp_viz_stub_cpp",
    out = "_gen/mp2p_icp_viz_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@mola_common//:ament_package",
        "@mp2p_icp_core//:ament_package",
        "@mrpt_gui//:ament_package",
        "@mrpt_imgui//:ament_package",
        "@mrpt_imgui_vendor//:ament_package",
        "@mrpt_opengl//:ament_package",
        "@ros_environment//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    install_package_xml = False,
    package_xml = "package.xml",
    programs = [
        ":icp-log-viewer",
        ":mm-viewer",
    ],
    deps = [
        ":ament_index",
        "@mola_common//:ament_package",
        "@mp2p_icp_core//:ament_package",
        "@mrpt_gui//:ament_package",
        "@mrpt_imgui//:ament_package",
        "@mrpt_imgui_vendor//:ament_package",
        "@mrpt_opengl//:ament_package",
        "@ros_environment//:ament_package",
    ],
)
