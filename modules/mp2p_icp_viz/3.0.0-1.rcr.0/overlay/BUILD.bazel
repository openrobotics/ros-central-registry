load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@mp2p_icp_core//:mp2p_icp": "@mp2p_icp_core//:mp2p_icp_library",
    "@mrpt_gui//:mrpt_gui": "@mrpt_gui//:mrpt_gui_library",
    "@mrpt_imgui//:mrpt_imgui": "@mrpt_imgui//:mrpt_imgui_library",
    "@mrpt_imgui_vendor//:mrpt_imgui_vendor": "@mrpt_imgui_vendor//:mrpt_imgui_vendor_library",
    "@mrpt_opengl//:mrpt_opengl": "@mrpt_opengl//:mrpt_opengl_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_library(
    name = "imgui_app_common_library",
    srcs = [
        "apps/imgui_app_common/src/ImGuiAppShell.cpp",
        "apps/imgui_app_common/src/SimpleFileDialog.cpp",
        "apps/libcfgpath/cfgpath.h",
    ],
    hdrs = [
        "apps/imgui_app_common/include/imgui_app_common/AsyncTask.h",
        "apps/imgui_app_common/include/imgui_app_common/ImGuiAppShell.h",
        "apps/imgui_app_common/include/imgui_app_common/SimpleFileDialog.h",
    ],
    includes = ["apps/imgui_app_common/include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_binary(
    name = "icp-log-viewer",
    srcs = ["apps/icp-log-viewer/main.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":imgui_app_common_library",
        "@rosdistro//cc:cli11",
    ],
)

cc_binary(
    name = "mm-viewer",
    srcs = [
        "apps/mm-viewer/CameraTravelling.cpp",
        "apps/mm-viewer/CameraTravelling.h",
        "apps/mm-viewer/main.cpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":imgui_app_common_library",
        "@rosdistro//cc:cli11",
    ],
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    deps = [
        "@mola_common//:ament_package",
        "@mp2p_icp_core//:ament_package",
        "@mrpt_gui//:ament_package",
        "@mrpt_imgui//:ament_package",
        "@mrpt_imgui_vendor//:ament_package",
        "@mrpt_opengl//:ament_package",
        "@ros_environment//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    install_package_xml = False,
    package_xml = "package.xml",
    programs = [
        ":icp-log-viewer",
        ":mm-viewer",
    ],
    deps = [
        ":ament_index",
        "@mola_common//:ament_package",
        "@mp2p_icp_core//:ament_package",
        "@mrpt_gui//:ament_package",
        "@mrpt_imgui//:ament_package",
        "@mrpt_imgui_vendor//:ament_package",
        "@mrpt_opengl//:ament_package",
        "@ros_environment//:ament_package",
    ],
)
