load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@behaviortree_cpp//:behaviortree_cpp": "@behaviortree_cpp//:behaviortree_cpp_library",
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@lifecycle_msgs//:cc_shared": "@lifecycle_msgs//:cc",
    "@plansys2_executor//:plansys2_executor": "@plansys2_executor//:plansys2_executor_library",
    "@plansys2_msgs//:cc_shared": "@plansys2_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@test_msgs//:cc_shared": "@test_msgs//:cc",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
}

CC_DEPS = [
    "@plansys2_executor//:_gen_textual_hdrs",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

exports_files([
    "CMakeLists.txt",
    "behavior_tree/CloseGripper.cpp",
    "behavior_tree/CloseGripper.hpp",
    "behavior_tree/FailureNodes.cpp",
    "behavior_tree/FailureNodes.hpp",
    "behavior_tree/Move.cpp",
    "behavior_tree/Move.hpp",
    "behavior_tree/OpenGripper.cpp",
    "behavior_tree/OpenGripper.hpp",
    "behavior_tree/assemble.xml",
    "behavior_tree/transport.xml",
    "unit/CMakeLists.txt",
    "unit/bt_action_test.cpp",
])

cc_library(
    name = "bt_test_node_hdrs",
    testonly = True,
    hdrs = glob([
        "behavior_tree/*.hpp",
    ]),
    visibility = ["//visibility:private"],
)

cc_test(
    name = "bt_action_test",
    srcs = ["unit/bt_action_test.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = ["//:ament_index"] + [
        "CMakeLists.txt",
        "behavior_tree/assemble.xml",
        "behavior_tree/transport.xml",
        "unit/CMakeLists.txt",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["unit"],
    local_defines = ros_local_defines() + [
        'BTCPP_LIBRARY_VERSION=\\"4.10.0\\"',
        "GTEST_HAS_PTHREAD=1",
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":bt_test_node_hdrs",
        "//:plansys2_bt_actions_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
