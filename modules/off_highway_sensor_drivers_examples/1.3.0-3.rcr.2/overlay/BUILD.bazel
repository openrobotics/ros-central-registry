load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@nav_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "off_highway_sensor_drivers_examples_library",
    srcs = ["src/off_highway_radar_examples/extract_velocity.cpp"],
    hdrs = ["src/off_highway_radar_examples/extract_velocity.hpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "off_highway_sensor_drivers_examples",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":off_highway_sensor_drivers_examples_library"],
)

rclcpp_components_register_node(
    name = "extract_velocity",
    component = ":off_highway_sensor_drivers_examples",
    node_name = "extract_velocity",
    plugin = "off_highway_sensor_drivers_examples::ExtractVelocity",
)

ament_index(
    name = "ament_index",
    components = [":extract_velocity_record"],
    data = [
        "config/off_highway_premium_radar_sample_filter.rviz",
        "//launch:launch_files",
    ],
    lib_data = [":extract_velocity"],
    libraries = [":off_highway_sensor_drivers_examples"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@off_highway_premium_radar//:ament_package",
        "@off_highway_radar//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "geometry_msgs",
        "nav_msgs",
        "rclcpp",
        "rclcpp_components",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_off_highway_sensor_drivers_examples",
    libraries = [":off_highway_sensor_drivers_examples"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@off_highway_premium_radar//:ament_package",
        "@off_highway_radar//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
    ],
)
