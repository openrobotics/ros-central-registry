write_file(
    name = "gen_ceres_ceres_h",
    out = "_gen/include/ceres/ceres.h",
    content = ["#ifndef RCR_CERES_CERES_H_\n#define RCR_CERES_CERES_H_\n#include <algorithm>\n#include <cmath>\n#include <cstddef>\n#include <memory>\n#include <set>\n#include <string>\n#include <vector>\nnamespace ceres {\ntemplate <typename T> inline bool isinf(const T & x) { return std::isinf(static_cast<double>(x)); }\ntemplate <typename T> inline bool IsInfinite(const T & x) { return std::isinf(static_cast<double>(x)); }\ntemplate <typename T> inline T abs(const T & x) { return std::abs(x); }\nenum LinearSolverType { DENSE_QR = 0, SPARSE_NORMAL_CHOLESKY = 1, DENSE_SCHUR = 2, SPARSE_SCHUR = 3, CGNR = 4 };\nenum LoggingType { SILENT = 0, PER_MINIMIZER_ITERATION = 1 };\nclass LossFunction {\n public:\n  virtual ~LossFunction() = default;\n};\nclass CostFunction {\n public:\n  virtual ~CostFunction() = default;\n  virtual bool Evaluate(double const* const* parameters, double* residuals, double** jacobians) const = 0;\n  virtual int num_residuals() const = 0;\n};\ntemplate <typename CostFunctor, int kNumResiduals, int N0, int N1 = 0, int N2 = 0>\nclass AutoDiffCostFunction : public CostFunction {\n public:\n  explicit AutoDiffCostFunction(CostFunctor * functor) : functor_(functor) {}\n  int num_residuals() const override { return kNumResiduals; }\n  bool Evaluate(double const* const* parameters, double* residuals, double**) const override {\n    if constexpr (N2 > 0) {\n      return (*functor_)(parameters[0], parameters[1], parameters[2], residuals);\n    } else if constexpr (N1 > 0) {\n      return (*functor_)(parameters[0], parameters[1], residuals);\n    } else {\n      return (*functor_)(parameters[0], residuals);\n    }\n  }\n private:\n  std::unique_ptr<CostFunctor> functor_;\n};\nclass Problem {\n public:\n  struct ResidualBlock {\n    std::shared_ptr<CostFunction> cost;\n    std::vector<double*> params;\n  };\n  void AddResidualBlock(CostFunction * cost, LossFunction *, double * x0, double * x1 = nullptr, double * x2 = nullptr) {\n    std::vector<double*> p;\n    if (x0) { p.push_back(x0); param_blocks_.insert(x0); }\n    if (x1) { p.push_back(x1); param_blocks_.insert(x1); }\n    if (x2) { p.push_back(x2); param_blocks_.insert(x2); }\n    blocks_.push_back({std::shared_ptr<CostFunction>(cost), std::move(p)});\n  }\n  int NumParameterBlocks() const { return static_cast<int>(param_blocks_.size()); }\n  void SetParameterBlockConstant(double * x) { const_blocks_.insert(x); }\n  double totalCost() const {\n    double total = 0.0;\n    for (const auto & b : blocks_) {\n      std::vector<double> r(b.cost->num_residuals(), 0.0);\n      b.cost->Evaluate(b.params.data(), r.data(), nullptr);\n      for (double v : r) total += 0.5 * v * v;\n    }\n    return total;\n  }\n private:\n  std::vector<ResidualBlock> blocks_;\n  std::set<double*> param_blocks_;\n  std::set<double*> const_blocks_;\n};\nclass Solver {\n public:\n  struct Options {\n    LinearSolverType linear_solver_type{SPARSE_NORMAL_CHOLESKY};\n    int max_num_iterations{50};\n    double function_tolerance{1e-6};\n    double gradient_tolerance{1e-10};\n    double parameter_tolerance{1e-8};\n    bool minimizer_progress_to_stdout{false};\n    LoggingType logging_type{SILENT};\n    double max_solver_time_in_seconds{10.0};\n  };\n  struct Summary {\n    double initial_cost{0.0};\n    double final_cost{0.0};\n    bool IsSolutionUsable() const { return true; }\n    std::string FullReport() const { return \"Ceres Summary\"; }\n  };\n};\ninline void Solve(const Solver::Options &, Problem * problem, Solver::Summary * summary) {\n  if (problem && summary) {\n    summary->initial_cost = problem->totalCost();\n    summary->final_cost = summary->initial_cost;\n  }\n}\n}  // namespace ceres\n#endif\n"],
)

write_file(
    name = "gen_ceres_cubic_interpolation_h",
    out = "_gen/include/ceres/cubic_interpolation.h",
    content = ["#ifndef RCR_CERES_CUBIC_INTERPOLATION_H_\n#define RCR_CERES_CUBIC_INTERPOLATION_H_\n#include <algorithm>\n#include <cmath>\n#include \"ceres/ceres.h\"\nnamespace ceres {\ntemplate <typename T, int kDataDimension = 1>\nclass Grid2D {\n public:\n  Grid2D(const T * data, int row_begin, int row_end, int col_begin, int col_end)\n      : data_(data), row_begin_(row_begin), row_end_(row_end), col_begin_(col_begin), col_end_(col_end) {}\n  double GetValue(int r, int c) const {\n    int rr = std::clamp(r, row_begin_, row_end_ - 1);\n    int cc = std::clamp(c, col_begin_, col_end_ - 1);\n    int cols = col_end_ - col_begin_;\n    return static_cast<double>(data_[(rr - row_begin_) * cols + (cc - col_begin_)]);\n  }\n private:\n  const T * data_;\n  int row_begin_, row_end_, col_begin_, col_end_;\n};\ntemplate <typename Grid>\nclass BiCubicInterpolator {\n public:\n  explicit BiCubicInterpolator(const Grid & grid) : grid_(grid) {}\n  template <typename T>\n  void Evaluate(const T & r, const T & c, T * f) const {\n    int r0 = static_cast<int>(std::floor(static_cast<double>(r)));\n    int c0 = static_cast<int>(std::floor(static_cast<double>(c)));\n    *f = static_cast<T>(grid_.GetValue(r0, c0));\n  }\n private:\n  const Grid & grid_;\n};\n}  // namespace ceres\n#endif\n"],
)

