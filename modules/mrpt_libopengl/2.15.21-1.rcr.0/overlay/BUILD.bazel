uctor  */\n  CGridPlaneXY(\n      float xMin = -10,\n      float xMax = 10,\n      float yMin = -10,\n      float yMax = 10,\n      float z = 0,\n      float frequency = 1,\n      float lineWidth = 1.3f,\n      bool antiAliasing = true);\n\n  /** Private, virtual destructor: only can be deleted from smart pointers */\n  ~CGridPlaneXY() override = default;\n};\n\n}  // namespace mrpt::opengl\n"],
