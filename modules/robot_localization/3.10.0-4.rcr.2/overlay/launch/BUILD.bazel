load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "dual_ekf_navsat_example.launch.py",
        "ekf.launch.py",
        "navsat_transform.launch.py",
        "ukf.launch.py",
    ],
)

launch_ros_binary(
    name = "dual_ekf_navsat_example_launch",
    src = "dual_ekf_navsat_example.launch.py",
    data = [
        "//:ament_index",
        "//:ament_index_extra",
        "//:ekf_node",
        "//:navsat_transform_node",
    ],
    deps = [
        "@ament_index_python",
        requirement("pyyaml"),
    ],
)

launch_ros_binary(
    name = "ekf_launch",
    src = "ekf.launch.py",
    data = [
        "//:ament_index",
        "//:ament_index_extra",
        "//:ekf_node",
    ],
    deps = [
        "@ament_index_python",
        requirement("pyyaml"),
    ],
)

launch_ros_binary(
    name = "navsat_transform_launch",
    src = "navsat_transform.launch.py",
    data = [
        "//:ament_index",
        "//:ament_index_extra",
        "//:navsat_transform_node",
    ],
    deps = [
        "@ament_index_python",
        requirement("pyyaml"),
    ],
)

launch_ros_binary(
    name = "ukf_launch",
    src = "ukf.launch.py",
    data = [
        "//:ament_index",
        "//:ament_index_extra",
        "//:ukf_node",
    ],
    deps = [
        "@ament_index_python",
        requirement("pyyaml"),
    ],
)
