cc_library(
    name = "rl_lib_library",
    srcs = [
        "src/ekf.cpp",
        "src/filter_base.cpp",
        "src/filter_utilities.cpp",
        "src/navsat_transform.cpp",
        "src/robot_localization_estimator.cpp",
        "src/ros_filter.cpp",
        "src/ros_filter_utilities.cpp",
        "src/ros_robot_localization_listener.cpp",
        "src/ukf.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_geocentric_h",
        ":gen_geographiclib_local_cartesian_hpp",
        ":gen_geographiclib_mgrs_hpp",
        ":gen_geographiclib_utmups_hpp",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/robot_localization",
        "_gen/include/robot_localization/robot_localization",
        "include",
        "include/robot_localization",
        "src",
    ],
    local_defines = ros_local_defines() + ["NDEBUG"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":cc",
    ],
)

cc_shared_library(
    name = "rl_lib",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":rl_lib_library"],
)

