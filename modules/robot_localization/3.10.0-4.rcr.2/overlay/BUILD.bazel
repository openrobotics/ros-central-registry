write_file(
    name = "gen_geographiclib_utmups_hpp",
    out = "_gen/include/GeographicLib/UTMUPS.hpp",
    content = ["#ifndef RCR_GEOGRAPHICLIB_UTMUPS_HPP_\n#define RCR_GEOGRAPHICLIB_UTMUPS_HPP_\n#include <cmath>\n#include <cctype>\n#include <stdexcept>\n#include <string>\nnamespace GeographicLib {\nclass GeographicErr : public std::runtime_error {\n public:\n  using std::runtime_error::runtime_error;\n};\nclass UTMUPS {\n public:\n  enum zonespec {\n    MINPSEUDOZONE = -4,\n    MATCH = -3,\n    UTM = -2,\n    STANDARD = -1,\n    MINZONE = 0,\n    MAXUTMZONE = 60,\n    MAXZONE = 60,\n  };\n  static void Forward(double lat, double lon, int & zone, bool & northp, double & x, double & y, double & gamma, double & k, int setzone = STANDARD, bool = false) {\n    zone = (setzone > 0) ? setzone : (static_cast<int>(std::floor((lon + 180.0) / 6.0)) + 1);\n    northp = (lat >= 0.0);\n    constexpr double kPi = 3.14159265358979323846;\n    constexpr double a = 6378137.0;\n    constexpr double f = 1.0 / 298.257223563;\n    constexpr double k0 = 0.9996;\n    double e2 = f * (2.0 - f);\n    double e4 = e2 * e2;\n    double e6 = e4 * e2;\n    double ep2 = e2 / (1.0 - e2);\n    double phi = lat * kPi / 180.0;\n    double lam = lon * kPi / 180.0;\n    double lam0 = ((zone - 1) * 6 - 180 + 3) * kPi / 180.0;\n    double sin_phi = std::sin(phi), cos_phi = std::cos(phi), tan_phi = std::tan(phi);\n    double N = a / std::sqrt(1.0 - e2 * sin_phi * sin_phi);\n    double T = tan_phi * tan_phi;\n    double C = ep2 * cos_phi * cos_phi;\n    double A = cos_phi * (lam - lam0);\n    double M = a * ((1.0 - e2 / 4.0 - 3.0 * e4 / 64.0 - 5.0 * e6 / 256.0) * phi\n      - (3.0 * e2 / 8.0 + 3.0 * e4 / 32.0 + 45.0 * e6 / 1024.0) * std::sin(2.0 * phi)\n      + (15.0 * e4 / 256.0 + 45.0 * e6 / 1024.0) * std::sin(4.0 * phi)\n      - (35.0 * e6 / 3072.0) * std::sin(6.0 * phi));\n    x = k0 * N * (A + (1.0 - T + C) * A * A * A / 6.0\n      + (5.0 - 18.0 * T + T * T + 72.0 * C - 58.0 * ep2) * A * A * A * A * A / 120.0) + 500000.0;\n    y = k0 * (M + N * tan_phi * (A * A / 2.0 + (5.0 - T + 9.0 * C + 4.0 * C * C) * A * A * A * A / 24.0\n      + (61.0 - 58.0 * T + T * T + 600.0 * C - 330.0 * ep2) * A * A * A * A * A * A / 720.0));\n    if (!northp) y += 10000000.0;\n    double dlam = lam - lam0;\n    gamma = std::atan(std::tan(dlam) * sin_phi) * 180.0 / kPi;\n    k = k0;\n  }\n  static void Forward(double lat, double lon, int & zone, bool & northp, double & x, double & y, int setzone = STANDARD, bool mgrslimits = false) {\n    double gamma = 0.0, k = 0.9996;\n    Forward(lat, lon, zone, northp, x, y, gamma, k, setzone, mgrslimits);\n  }\n  static void Reverse(int zone, bool northp, double x, double y, double & lat, double & lon, double & gamma, double & k, bool = false) {\n    constexpr double kPi = 3.14159265358979323846;\n    constexpr double a = 6378137.0;\n    constexpr double f = 1.0 / 298.257223563;\n    constexpr double k0 = 0.9996;\n    double e2 = f * (2.0 - f);\n    double e4 = e2 * e2;\n    double e6 = e4 * e2;\n    double ep2 = e2 / (1.0 - e2);\n    double e1 = (1.0 - std::sqrt(1.0 - e2)) / (1.0 + std::sqrt(1.0 - e2));\n    double x_rel = x - 500000.0;\n    double y_rel = northp ? y : (y - 10000000.0);\n    double M = y_rel / k0;\n    double mu = M / (a * (1.0 - e2 / 4.0 - 3.0 * e4 / 64.0 - 5.0 * e6 / 256.0));\n    double phi1 = mu + (3.0 * e1 / 2.0 - 27.0 * e1 * e1 * e1 / 32.0) * std::sin(2.0 * mu)\n      + (21.0 * e1 * e1 / 16.0 - 55.0 * e1 * e1 * e1 * e1 / 32.0) * std::sin(4.0 * mu)\n      + (151.0 * e1 * e1 * e1 / 96.0) * std::sin(6.0 * mu)\n      + (1097.0 * e1 * e1 * e1 * e1 / 512.0) * std::sin(8.0 * mu);\n    double sin_p1 = std::sin(phi1), cos_p1 = std::cos(phi1), tan_p1 = std::tan(phi1);\n    double N1 = a / std::sqrt(1.0 - e2 * sin_p1 * sin_p1);\n    double T1 = tan_p1 * tan_p1;\n    double C1 = ep2 * cos_p1 * cos_p1;\n    double R1 = a * (1.0 - e2) / std::pow(1.0 - e2 * sin_p1 * sin_p1, 1.5);\n    double D = x_rel / (N1 * k0);\n    double phi = phi1 - (N1 * tan_p1 / R1) * (D * D / 2.0\n      - (5.0 + 3.0 * T1 + 10.0 * C1 - 4.0 * C1 * C1 - 9.0 * ep2) * D * D * D * D / 24.0\n      + (61.0 + 90.0 * T1 + 298.0 * C1 + 45.0 * T1 * T1 - 252.0 * ep2 - 3.0 * C1 * C1) * D * D * D * D * D * D / 720.0);\n    double lam0 = ((zone - 1) * 6 - 180 + 3) * kPi / 180.0;\n    double dlam = (D - (1.0 + 2.0 * T1 + C1) * D * D * D / 6.0\n      + (5.0 - 2.0 * C1 + 28.0 * T1 - 3.0 * C1 * C1 + 8.0 * ep2 + 24.0 * T1 * T1) * D * D * D * D * D / 120.0) / cos_p1;\n    lat = phi * 180.0 / kPi;\n    lon = (lam0 + dlam) * 180.0 / kPi;\n    gamma = std::atan(std::tan(dlam) * std::sin(phi)) * 180.0 / kPi;\n    k = k0;\n  }\n  static void Reverse(int zone, bool northp, double x, double y, double & lat, double & lon, bool mgrslimits = false) {\n    double gamma = 0.0, k = 0.9996;\n    Reverse(zone, northp, x, y, lat, lon, gamma, k, mgrslimits);\n  }\n};\nclass MGRS {\n public:\n  static void Forward(int zone, bool northp, double x, double y, int, std::string & mgrs) {\n    double lat = 0.0, lon = 0.0;\n    UTMUPS::Reverse(zone, northp, x, y, lat, lon);\n    static constexpr const char * kBands = \"CDEFGHJKLMNPQRSTUVWX\";\n    int idx = static_cast<int>(std::floor((lat + 80.0) / 8.0));\n    if (idx < 0) idx = 0;\n    if (idx > 19) idx = 19;\n    mgrs = std::to_string(zone) + kBands[idx];\n  }\n  static void Forward(int zone, bool northp, double x, double y, double lat, int, std::string & mgrs) {\n    (void)x; (void)y; (void)northp;\n    static constexpr const char * kBands = \"CDEFGHJKLMNPQRSTUVWX\";\n    int idx = static_cast<int>(std::floor((lat + 80.0) / 8.0));\n    if (idx < 0) idx = 0;\n    if (idx > 19) idx = 19;\n    mgrs = std::to_string(zone) + kBands[idx];\n  }\n  static void Reverse(const std::string & mgrs, int & zone, bool & northp, double & x, double & y, int & prec, bool = true) {\n    zone = 0;\n    northp = true;\n    x = 0.0;\n    y = 0.0;\n    prec = -1;\n    std::size_t i = 0;\n    while (i < mgrs.size() && std::isdigit(static_cast<unsigned char>(mgrs[i]))) {\n      zone = zone * 10 + (mgrs[i] - '0');\n      ++i;\n    }\n    if (i < mgrs.size()) {\n      char c = static_cast<char>(std::toupper(static_cast<unsigned char>(mgrs[i])));\n      northp = (c >= 'N');\n    }\n  }\n};\n}  // namespace GeographicLib\n#endif\n"],
)

write_file(
    name = "gen_geographiclib_local_cartesian_hpp",
    out = "_gen/include/GeographicLib/LocalCartesian.hpp",
    content = ["#ifndef RCR_GEOGRAPHICLIB_LOCAL_CARTESIAN_HPP_\n#define RCR_GEOGRAPHICLIB_LOCAL_CARTESIAN_HPP_\n#include <cmath>\nnamespace GeographicLib {\nclass Geocentric {\npublic:\n  Geocentric() = default;\n  Geocentric(double, double) {}\n  static const Geocentric & WGS84() { static Geocentric g; return g; }\n  void Forward(double, double, double, double & X, double & Y, double & Z) const { X = 0; Y = 0; Z = 0; }\n  void Reverse(double, double, double, double & lat, double & lon, double & h) const { lat = 0; lon = 0; h = 0; }\n};\nclass LocalCartesian {\n public:\n  LocalCartesian() = default;\n  LocalCartesian(double lat0, double lon0, double h0 = 0.0, const Geocentric & = Geocentric::WGS84()) : lat0_(lat0), lon0_(lon0), h0_(h0) {}\n  explicit LocalCartesian(const Geocentric &) {}\n  void Reset(double lat0, double lon0, double h0 = 0.0) { lat0_ = lat0; lon0_ = lon0; h0_ = h0; }\n  double LatitudeOrigin() const { return lat0_; }\n  double LongitudeOrigin() const { return lon0_; }\n  double HeightOrigin() const { return h0_; }\n  void Forward(double lat, double lon, double h, double & x, double & y, double & z) const {\n    constexpr double kDegToRad = 3.14159265358979323846 / 180.0;\n    constexpr double kR = 6378137.0;\n    x = (lon - lon0_) * kDegToRad * kR * std::cos(lat0_ * kDegToRad);\n    y = (lat - lat0_) * kDegToRad * kR;\n    z = h - h0_;\n  }\n  void Reverse(double x, double y, double z, double & lat, double & lon, double & h) const {\n    constexpr double kRadToDeg = 180.0 / 3.14159265358979323846;\n    constexpr double kDegToRad = 3.14159265358979323846 / 180.0;\n    constexpr double kR = 6378137.0;\n    lat = lat0_ + (y / kR) * kRadToDeg;\n    lon = lon0_ + (x / (kR * std::cos(lat0_ * kDegToRad))) * kRadToDeg;\n    h = h0_ + z;\n  }\n private:\n  double lat0_{0.0}, lon0_{0.0}, h0_{0.0};\n};\n}  // namespace GeographicLib\n#endif\n"],
)

