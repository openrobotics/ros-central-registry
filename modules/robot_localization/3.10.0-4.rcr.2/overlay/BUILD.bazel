load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosidl_default_generators//:defs.bzl", "default_generators")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PACKAGING

default_generators(
    package_xml = "package.xml",
    deps = [
        "//srv:FromLL",
        "//srv:FromLLArray",
        "//srv:GetState",
        "//srv:SetDatum",
        "//srv:SetPose",
        "//srv:SetUTMZone",
        "//srv:ToLL",
        "//srv:ToggleFilterProcessing",
    ],
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@angles//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@geographic_msgs//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@message_filters//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_eigen//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@yaml_cpp_vendor//:ament_package",
    ],
)
