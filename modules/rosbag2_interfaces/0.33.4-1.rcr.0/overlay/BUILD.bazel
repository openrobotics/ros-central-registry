load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosidl_default_generators//:defs.bzl", "default_generators")

package(default_visibility = ["//visibility:public"])

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:MessagesLostEvent",
        "//msg:MessagesLostEventTopicStat",
        "//msg:ReadSplitEvent",
        "//msg:WriteSplitEvent",
        "//srv:Burst",
        "//srv:GetRate",
        "//srv:IsDiscoveryRunning",
        "//srv:IsPaused",
        "//srv:Pause",
        "//srv:Play",
        "//srv:PlayNext",
        "//srv:Record",
        "//srv:Resume",
        "//srv:Seek",
        "//srv:SetRate",
        "//srv:Snapshot",
        "//srv:SplitBagfile",
        "//srv:StartDiscovery",
        "//srv:Stop",
        "//srv:StopDiscovery",
        "//srv:TogglePaused",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
    ],
)
