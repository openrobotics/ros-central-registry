load("@rosidl_default_generators//:defs.bzl", "ros_service")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-2-Clause",
    ],
)

exports_files([
    "GetMgrsZone.srv",
    "GetOrigin.srv",
    "GetUtmZone.srv",
    "SetOrigin.srv",
])

ros_service(
    name = "GetMgrsZone",
    src = "GetMgrsZone.srv",
)

ros_service(
    name = "GetOrigin",
    src = "GetOrigin.srv",
)

ros_service(
    name = "GetUtmZone",
    src = "GetUtmZone.srv",
)

ros_service(
    name = "SetOrigin",
    src = "SetOrigin.srv",
)
