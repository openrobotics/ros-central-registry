load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

HEADERS = glob(["include/**/*.h"])

DEPENDENCIES = {
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@laser_geometry//:laser_geometry": "@laser_geometry//:laser_geometry_library",
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_kdl//:tf2_kdl": "@tf2_kdl//:tf2_kdl_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

cc_library(
    name = "laser_scan_filters_library",
    srcs = ["src/laser_scan_filters.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@angles",
        "@filters",
        "@sensor_msgs//:cc",
    ],
)

cc_shared_library(
    name = "laser_scan_filters",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":laser_scan_filters_library"],
    deps = [":laser_scan_filters_library"],
)

cc_library(
    name = "laser_filter_chains_library",
    srcs = [
        "src/scan_to_cloud_filter_chain.cpp",
        "src/scan_to_cloud_filter_chain.hpp",
        "src/scan_to_scan_filter_chain.cpp",
        "src/scan_to_scan_filter_chain.hpp",
    ],
    hdrs = HEADERS,
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@angles",
        "@filters",
        "@sensor_msgs//:cc",
    ],
)

cc_shared_library(
    name = "laser_filter_chains",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":laser_filter_chains_library"],
    deps = [":laser_filter_chains_library"],
)

### TRANSITIVE DYNAMIC DEPS

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":laser_scan_filters",
        ":laser_filter_chains",
    ],
    visibility = ["//visibility:private"],
)

### COMPONENTS

rclcpp_components_register_node(
    name = "scan_to_cloud_filter_chain",
    component = ":laser_filter_chains",
    executor = "SingleThreadedExecutor",
    node_name = "scan_to_cloud_filter_chain",
    plugin = "ScanToCloudFilterChain",
)

rclcpp_components_register_node(
    name = "scan_to_scan_filter_chain",
    component = ":laser_filter_chains",
    executor = "SingleThreadedExecutor",
    node_name = "scan_to_scan_filter_chain",
    plugin = "ScanToScanFilterChain",
)

### EXECUTABLE

cc_binary(
    name = "generic_laser_filter_node",
    srcs = ["src/generic_laser_filter_node.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":laser_filter_chains_library",
        ":laser_scan_filters_library",
        "@angles",
        "@filters//:filter_chain",
    ],
)

### AMENT INDEX

ament_index(
    name = "ament_index",
    components = [
        ":scan_to_cloud_filter_chain_record",
        ":scan_to_scan_filter_chain_record",
    ],
    data = glob([
        "examples/**",
        "test/**",
    ]),
    export_name = "laser_filters",
    libraries = [":laser_scan_filters"],
    package_xml = "package.xml",
    plugin_category = "filters",
    plugins = ["laser_filters_plugins.xml"],
)

### TESTS

cc_test(
    name = "test_scan_filter_chain",
    srcs = ["test/test_scan_filter_chain.cpp"],
    args = [
        "--ros-args",
        "--params-file",
        "$(location test/test_scan_filter_chain.yaml)",
    ],
    data = [
        "test/test_scan_filter_chain.yaml",
        ":ament_index",
        "@filters//:ament_package",
        "@filters//:increment",
        "@filters//:mean",
        "@filters//:median",
        "@filters//:transfer_function",
    ],
    dynamic_deps = [
        ":transitive_dynamic_deps",
    ],
    deps = DEPENDENCIES.values() + [
        ":laser_filter_chains_library",
        ":laser_scan_filters_library",
        "@angles",
        "@filters",
        "@rosdistro//cc:googletest",
        "@sensor_msgs//:cc",
    ],
)

cc_test(
    name = "test_shadow_detector",
    srcs = ["test/test_shadow_detector.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        ":laser_scan_filters_library",
        "@angles",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_speckle_filter",
    srcs = ["test/test_speckle_filter.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        ":laser_scan_filters_library",
        "@angles",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_scan_shadows_filter",
    srcs = ["test/test_scan_shadows_filter.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        ":laser_scan_filters_library",
        "@angles",
        "@rosdistro//cc:googletest",
        "@sensor_msgs//:cc",
    ],
)

# Upstream package.xml is missing <test_depend> on rclpy, launch_ros, launch_testing, and ament_index_python;
# test_speckle_filter.test.py also fails in the reference colcon run.
launch_ros_test(
    name = "test_test_polygon_filter.test.py",
    src = "test/test_polygon_filter.test.py",
    data = [
        ":ament_index",
        ":ament_package",
        ":scan_to_scan_filter_chain",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = ["@sensor_msgs//:py"],
)

launch_ros_test(
    name = "test_test_speckle_filter.test.py",
    src = "test/test_speckle_filter.test.py",
    data = [
        ":ament_index",
        ":ament_package",
        ":scan_to_scan_filter_chain",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = ["@sensor_msgs//:py"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_targets = False,
    executables = [
        ":generic_laser_filter_node",
        ":scan_to_cloud_filter_chain",
        ":scan_to_scan_filter_chain",
    ],
    headers = HEADERS,
    libraries = [
        ":laser_scan_filters",
        ":laser_filter_chains",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@angles//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@filters//:ament_package",
        "@laser_geometry//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@message_filters//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_kdl//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
