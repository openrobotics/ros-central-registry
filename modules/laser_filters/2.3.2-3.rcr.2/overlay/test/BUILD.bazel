load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@laser_geometry//:laser_geometry": "@laser_geometry//:laser_geometry_library",
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_kdl//:tf2_kdl": "@tf2_kdl//:tf2_kdl_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

filegroup(
    name = "_root_test_files_0",
    srcs = [
        "fake_laser.py",
        "test_polygon_filter.test.py",
        "test_polygon_filter.yaml",
        "test_scan_filter_chain.cpp",
        "test_scan_filter_chain.launch",
        "test_scan_filter_chain.yaml",
        "test_scan_shadows_filter.cpp",
        "test_shadow_detector.cpp",
        "test_speckle_filter.cpp",
        "test_speckle_filter.test.py",
        "test_speckle_filter.yaml",
    ],
)

cc_test(
    name = "test_scan_filter_chain",
    srcs = ["test_scan_filter_chain.cpp"],
    args = [
        "--ros-args",
        "--params-file",
        "$(location test_scan_filter_chain.yaml)",
    ],
    data = [
        "test_scan_filter_chain.yaml",
        "//:ament_index",
        "@filters//:ament_index",
        "@filters//:increment",
        "@filters//:mean",
        "@filters//:median",
        "@filters//:transfer_function",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        "//:laser_filter_chains_library",
        "//:laser_scan_filters_library",
        "@angles",
        "@filters",
        "@rosdistro//cc:googletest",
        "@sensor_msgs//:cc",
    ],
)

cc_test(
    name = "test_shadow_detector",
    srcs = ["test_shadow_detector.cpp"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        "//:laser_scan_filters_library",
        "@angles",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_speckle_filter",
