load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {"@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library"}

TEST_DEPENDENCIES = DEPENDENCIES | {"@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library"}

cc_test(
    name = "diagnostic_updater_test",
    srcs = ["diagnostic_updater_test.cpp"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    deps = TEST_DEPENDENCIES.values() + [
        "//:diagnostic_updater_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "diagnostic_status_wrapper_test",
    srcs = ["diagnostic_status_wrapper_test.cpp"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    deps = TEST_DEPENDENCIES.values() + [
        "//:diagnostic_updater_library",
        "@diagnostic_msgs//:cc",
        "@rosdistro//cc:googletest",
        "@std_msgs//:cc",
    ],
)

genrule(
    name = "diagnostic_updater_test_src",
    srcs = ["diagnostic_updater_test.py"],
    outs = ["run_diagnostic_updater_test.py"],
    cmd = "cp $< $@",
)

launch_ros_test(
    name = "test_diagnostic_updater_test",
    src = "run_diagnostic_updater_test.py",
    data = ["dummy_process.py"],
    deps = [
        "//:diagnostic_updater_py",
        "@diagnostic_msgs//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

py_pytest(
    name = "test_DiagnosticStatusWrapper.py",
    srcs = ["test_diagnostic_status_wrapper.py"],
    deps = [
        "//:diagnostic_updater_py",
        "@diagnostic_msgs//:py",
    ],
)
