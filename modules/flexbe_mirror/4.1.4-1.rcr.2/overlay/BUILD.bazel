load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "flexbe_mirror/__init__.py",
        "flexbe_mirror/behavior_mirror_sm.py",
        "flexbe_mirror/flexbe_mirror.py",
        "flexbe_mirror/mirror_concurrency_container.py",
        "flexbe_mirror/mirror_priority_container.py",
        "flexbe_mirror/mirror_state.py",
        "flexbe_mirror/mirror_state_machine.py",
        "package.xml",
        "resource/flexbe_mirror",
        "setup.cfg",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in ["flake8"]]

py_library(
    name = "flexbe_mirror",
    srcs = [
        "flexbe_mirror/__init__.py",
        "flexbe_mirror/behavior_mirror_sm.py",
        "flexbe_mirror/flexbe_mirror.py",
        "flexbe_mirror/mirror_concurrency_container.py",
        "flexbe_mirror/mirror_priority_container.py",
        "flexbe_mirror/mirror_state.py",
        "flexbe_mirror/mirror_state_machine.py",
    ],
    imports = ["."],
    deps = [
        "@flexbe_core",
        "@flexbe_msgs//:py",
        "@rclpy",
    ],
)

ament_package(
    name = "ament_package",
    console_scripts = {"behavior_mirror_sm": "flexbe_mirror.behavior_mirror_sm:main"},
    package_xml = "package.xml",
    python = [":flexbe_mirror"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@flexbe_core//:ament_package",
        "@flexbe_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
