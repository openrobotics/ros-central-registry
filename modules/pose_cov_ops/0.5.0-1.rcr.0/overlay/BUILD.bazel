load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@mrpt_libros_bridge//:mrpt_libros_bridge_library",
    "@mrpt_math//:mrpt_math_library",
    "@mrpt_poses//:mrpt_poses_library",
    "@mrpt_serialization//:mrpt_serialization_library",
    "@nav_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
    "@stereo_msgs//:cc",
]

cc_library(
    name = "pose_cov_ops_library",
    srcs = ["src/pose_cov_ops.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/pose_cov_ops",
    ],
    local_defines = ros_local_defines() + [
        "PACKAGE_ROS_VERSION=2",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "pose_cov_ops",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":pose_cov_ops_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    libraries = [
        ":pose_cov_ops",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mrpt_libros_bridge//:ament_package",
        "@mrpt_poses//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_environment//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@stereo_msgs//:ament_package",
        "@tf2//:ament_package",
    ],
)

cc_test(
    name = "pose_cov_ops-test",
    srcs = ["test/test_pose_cov_ops.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/pose_cov_ops",
    ],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "PACKAGE_ROS_VERSION=2",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":pose_cov_ops_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "mrpt_libros_bridge",
        "mrpt_poses",
    ],
    cmake_export_name = "export_pose_cov_ops",
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [
        ":pose_cov_ops",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mrpt_libros_bridge//:ament_package",
        "@mrpt_poses//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_environment//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@stereo_msgs//:ament_package",
        "@tf2//:ament_package",
    ],
)
