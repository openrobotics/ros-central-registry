load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = ["include/tf2_sensor_msgs/tf2_sensor_msgs.hpp"]

DEPENDENCIES = {
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

cc_library(
    name = "tf2_sensor_msgs_library",
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:eigen",
    ],
)

cc_shared_library(
    name = "tf2_sensor_msgs",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":tf2_sensor_msgs_library"],
)

py_library(
    name = "tf2_sensor_msgs_py",
    srcs = [
        "tf2_sensor_msgs/__init__.py",
        "tf2_sensor_msgs/tf2_sensor_msgs.py",
    ],
    imports = ["."],
    deps = [
        "@sensor_msgs_py",
        "@tf2_ros_py",
    ],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":tf2_sensor_msgs"],
)

ament_package(
    name = "ament_package",
    cmake_export_include_directories = False,
    cmake_export_name = "export_tf2_sensor_msgs",
    headers = HEADERS,
    package_xml = "package.xml",
    python = [":tf2_sensor_msgs_py"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@sensor_msgs_py//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@tf2_ros_py//:ament_package",
    ],
)
