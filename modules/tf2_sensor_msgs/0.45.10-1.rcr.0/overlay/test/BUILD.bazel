load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

TEST_DEPENDENCIES = DEPENDENCIES | {
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "//:tf2_sensor_msgs": "//:tf2_sensor_msgs_library",
}

[cc_test(
    name = name,
    srcs = srcs,
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = TEST_DEPENDENCIES.values() + [
        "@geometry_msgs//:cc",
        "@rosdistro//cc:googletest",
        "@sensor_msgs//:cc",
    ],
) for name, srcs in {
    "test_tf2_sensor_msgs_cpp": ["test_tf2_sensor_msgs.cpp"],
    "test_imu_transforms": ["test_imu_transforms.cpp"],
}.items()]

py_pytest(
    name = "test_tf2_sensor_msgs_py",
    srcs = ["test_tf2_sensor_msgs.py"],
    deps = [
        "//:tf2_sensor_msgs_py",
        "@tf2_ros_py",
    ],
)
