load("@launch_testing_ros//:defs.bzl", "launch_ros_test")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosidl_typesupport_introspection_c//:rosidl_typesupport_introspection_c": "@rosidl_typesupport_introspection_c//:rosidl_typesupport_introspection_c_library",
    "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp": "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp_library",
    "@trajectory_msgs//:cc_shared": "@trajectory_msgs//:cc",
    "@urdf//:urdf": "@urdf//:urdf_library",
    "@urdfdom//:urdfdom_world": "@urdfdom//:urdfdom_world_library",
}

CC_DEPS = [
    "@inverse_dynamics_solver//:inverse_dynamics_solver_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

exports_files([
    "bagfiles/metadata.yaml",
    "bagfiles/validation_trajectory.db3",
    "test_ur10_inverse_dynamics_solver.cpp",
    "test_ur10_inverse_dynamics_solver.py",
])

cc_binary(
    name = "ur10_inverse_dynamics_solver_test",
    srcs = ["test_ur10_inverse_dynamics_solver.cpp"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:ur10_inverse_dynamics_solver_library",
        "@rosdistro//cc:gtest_main",
    ],
)

launch_ros_test(
    name = "test_test_ur10_inverse_dynamics_solver",
    src = "test_ur10_inverse_dynamics_solver.py",
    data = [
        ":ur10_inverse_dynamics_solver_test",
        "//:ament_index",
    ],
    deps = [
        "@ament_index_python",
        "@rosbag2_storage_default_plugins//:rosbag2_storage_default_plugins_py",
        "@trajectory_msgs//:py",
    ],
)
