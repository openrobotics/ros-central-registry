load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@inverse_dynamics_solver//:transitive_dynamic_deps": "@inverse_dynamics_solver//:inverse_dynamics_solver_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosidl_typesupport_introspection_c//:rosidl_typesupport_introspection_c": "@rosidl_typesupport_introspection_c//:rosidl_typesupport_introspection_c_library",
    "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp": "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp_library",
    "@trajectory_msgs//:cc_shared": "@trajectory_msgs//:cc",
    "@urdf//:urdf": "@urdf//:urdf_library",
    "@urdfdom//:urdfdom": "@urdfdom//:urdfdom_library",
    "@urdfdom//:urdfdom_world": "@urdfdom//:urdfdom_world_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "ur10_inverse_dynamics_solver_library",
    srcs = [
        "src/getCoriolisCurrents.cpp",
        "src/getCurrents.cpp",
        "src/getGravityCurrents.cpp",
        "src/getInertiaCurrents.cpp",
        "src/ur10_inverse_dynamics_solver.cpp",
    ],
    hdrs = [
        "include/ur10_inverse_dynamics_solver/getCoriolisCurrents.hpp",
        "include/ur10_inverse_dynamics_solver/getCurrents.hpp",
        "include/ur10_inverse_dynamics_solver/getGravityCurrents.hpp",
        "include/ur10_inverse_dynamics_solver/getInertiaCurrents.hpp",
        "include/ur10_inverse_dynamics_solver/ur10_inverse_dynamics_solver.hpp",
    ],
    includes = [
        ".",
        "include",
        "include/ur10_inverse_dynamics_solver",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ur10_inverse_dynamics_solver",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":ur10_inverse_dynamics_solver_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ur10_inverse_dynamics_solver"],
)

ament_index(
    name = "ament_index",
    data = [
        "bagfiles/ur10_exciting_trajectory.db3",
        "//launch:launch_files",
        "//test:bagfiles/metadata.yaml",
        "//test:bagfiles/validation_trajectory.db3",
    ],
    data_strip_prefix = "test",
    lib_data = ["//test:ur10_inverse_dynamics_solver_test"],
    libraries = [":ur10_inverse_dynamics_solver"],
    package_xml = "package.xml",
    plugin_category = "inverse_dynamics_solver",
    plugins = ["ur10_inverse_dynamics_solver.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@inverse_dynamics_solver//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_testing//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_storage_default_plugins//:ament_package",
        "@rosidl_typesupport_introspection_c//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
        "@trajectory_msgs//:ament_package",
        "@ur_description//:ament_package",
        "@urdf//:ament_package",
        "@urdfdom//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "inverse_dynamics_solver",
        "pluginlib",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_ur10_inverse_dynamics_solver",
    headers = [
        "include/ur10_inverse_dynamics_solver/getCoriolisCurrents.hpp",
        "include/ur10_inverse_dynamics_solver/getCurrents.hpp",
        "include/ur10_inverse_dynamics_solver/getGravityCurrents.hpp",
        "include/ur10_inverse_dynamics_solver/getInertiaCurrents.hpp",
        "include/ur10_inverse_dynamics_solver/ur10_inverse_dynamics_solver.hpp",
    ],
    include_prefix = "",
    libraries = [":ur10_inverse_dynamics_solver"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@inverse_dynamics_solver//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_testing//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@rosbag2_storage//:ament_package",
        "@rosbag2_storage_default_plugins//:ament_package",
        "@rosidl_typesupport_introspection_c//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
        "@trajectory_msgs//:ament_package",
        "@ur_description//:ament_package",
        "@urdf//:ament_package",
        "@urdfdom//:ament_package",
    ],
)
