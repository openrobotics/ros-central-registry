package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

cc_library(
    name = "ublox_msgs_lib_library",
    srcs = [
        "src/ublox_msgs.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        "@ublox_serialization//:include/ublox_serialization/checksum.hpp",
        "@ublox_serialization//:include/ublox_serialization/serialization.hpp",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
        "-Iexternal/ublox_serialization+/include",
    ],
    includes = [
        "_gen/include",
        "_gen/include/ublox_msgs",
        "_gen/include/ublox_msgs/ublox_msgs",
        "include",
        "include/ublox_msgs",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":cc",
    ],
)

cc_shared_library(
    name = "ublox_msgs_lib",
    dynamic_deps = DEPENDENCIES.keys() + [
    ],
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":ublox_msgs_lib_library"],
)

pkg_files(
    name = "pkg_files_inc_1071",
    srcs = ["include/ublox_msgs/serialization.hpp"],
    prefix = "include/ublox_msgs/ublox_msgs",
)

