--- a/src/shared_library_UNIX.cpp
+++ b/src/shared_library_UNIX.cpp
@@ -1,7 +1,10 @@
 #include "behaviortree_cpp/exceptions.h"
 #include "behaviortree_cpp/utils/shared_library.h"
 
+#include <cstdlib>
+#include <filesystem>
 #include <mutex>
+#include <sstream>
 #include <string>
 
 #include <dlfcn.h>
@@ -23,8 +26,34 @@
   if(_handle == nullptr)
   {
     const char* err = dlerror();
-    throw RuntimeError("Could not load library: " +
-                       (err != nullptr ? std::string(err) : path));
+    std::string first_err = err != nullptr ? std::string(err) : path;
+    const char* ament_prefix = std::getenv("AMENT_PREFIX_PATH");
+    if(ament_prefix != nullptr && path.find('/') == std::string::npos)
+    {
+      std::stringstream ss(ament_prefix);
+      std::string prefix;
+      while(std::getline(ss, prefix, ':'))
+      {
+        if(prefix.empty())
+        {
+          continue;
+        }
+        std::filesystem::path candidate = std::filesystem::path(prefix) / "lib" / path;
+        std::error_code ec;
+        if(std::filesystem::exists(candidate, ec))
+        {
+          std::filesystem::path canonical_path = std::filesystem::canonical(candidate, ec);
+          const std::string& to_load = ec ? candidate.string() : canonical_path.string();
+          _handle = dlopen(to_load.c_str(), RTLD_NOW | RTLD_GLOBAL);
+          if(_handle != nullptr)
+          {
+            _path = to_load;
+            return;
+          }
+        }
+      }
+    }
+    throw RuntimeError("Could not load library: " + first_err);
   }
   _path = path;
 }
