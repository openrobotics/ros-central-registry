load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

# This is the python library that does the bulk of the work for converting
# the .msg, .srv, .action files to the generic .idl representation.
py_library(
    name = "rosidl_runtime_py",
    srcs = glob(["rosidl_runtime_py/**/*.py"]),
    deps = [
        requirement("numpy"),
        requirement("pyyaml"),
        "@rosidl_buffer_py",
        "@rosidl_parser",
    ],
)

# This makes the setup script executable, and ensures that eny downstream
# consumers of this script bring in the correct dependencies.
py_binary(
    name = "setup",
    srcs = ["setup.py"],
    deps = [
        requirement("setuptools"),
    ],
)

write_file(
    name = "conftest",
    out = "test/rosidl_runtime_py/conftest.py",
    content = [
        "import os",
        "import sys",
        "import test_msgs",
        "for _p in sys.path:",
        "    _cand = os.path.join(_p, 'test_msgs')",
        "    if os.path.isdir(_cand) and _cand not in test_msgs.__path__:",
        "        test_msgs.__path__.append(_cand)",
        "",
    ],
)

ament_index(
    name = "rosidl_parser_ament_index",
    export_name = "rosidl_parser",
    package_xml = "package.xml",
)

# All functional tests.
[
    py_pytest(
        name = test,
        srcs = ["test/rosidl_runtime_py/{}.py".format(test)],
        data = [
            ":conftest",
            ":rosidl_parser_ament_index",
            "@std_msgs//:ament_index",
            "@std_srvs//:ament_index",
            "@test_msgs//:ament_index",
        ],
        deps = [
            ":rosidl_runtime_py",
            "@std_msgs//:py",
            "@std_srvs//:py",
            "@test_msgs//:py",
            "@test_msgs//:test_msgs_py",
        ],
    )
    for test in [
        "test_convert",
        "test_get_interfaces",
        "test_import_message",
        "test_set_message",
        "test_utilities",
    ]
]

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":rosidl_runtime_py"] + glob(
        ["rosidl_runtime_py/py.typed"],
        allow_empty = True,
    ),
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_buffer_py//:ament_package",
        "@rosidl_parser//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
