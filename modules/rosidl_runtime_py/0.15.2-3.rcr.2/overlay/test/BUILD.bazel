load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

exports_files([
    "rosidl_runtime_py/test_convert.py",
    "rosidl_runtime_py/test_get_interfaces.py",
    "rosidl_runtime_py/test_import_message.py",
    "rosidl_runtime_py/test_set_message.py",
    "rosidl_runtime_py/test_utilities.py",
    "test_copyright.py",
    "test_flake8.py",
    "test_pep257.py",
    "test_xmllint.py",
])

write_file(
    name = "conftest",
    out = "rosidl_runtime_py/conftest.py",
    content = [
        "import os",
        "import sys",
        "import test_msgs",
        "for _p in sys.path:",
        "    _cand = os.path.join(_p, 'test_msgs')",
        "    if os.path.isdir(_cand) and _cand not in test_msgs.__path__:",
        "        test_msgs.__path__.append(_cand)",
        "",
    ],
)

[py_pytest(
    name = test.removesuffix(".py"),
    srcs = ["rosidl_runtime_py/{}.py".format(test)],
    data = [
        ":conftest",
        "//:rosidl_parser_ament_index",
        "@std_msgs//:ament_index",
        "@std_srvs//:ament_index",
        "@test_msgs//:ament_index",
    ],
    deps = [
        "//:rosidl_runtime_py",
        "@std_msgs//:py",
        "@std_srvs//:py",
        "@test_msgs//:py",
        "@test_msgs//:test_msgs_py",
    ],
) for test in [
    "test_convert",
    "test_get_interfaces",
    "test_import_message",
    "test_set_message",
    "test_utilities",
]]
