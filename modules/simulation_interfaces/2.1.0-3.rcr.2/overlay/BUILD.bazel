load("@rosidl_default_generators//:defs.bzl", "default_generators", "rosidl_ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PACKAGING

default_generators(
    dependencies = [
        "@geometry_msgs",
        "@std_msgs",
    ],
    package_xml = "package.xml",
    deps = [
        "//action:SimulateSteps",
        "//msg:Bounds",
        "//msg:EntityCategory",
        "//msg:EntityFilters",
        "//msg:EntityInfo",
        "//msg:EntityState",
        "//msg:NamedPose",
        "//msg:Resource",
        "//msg:Result",
        "//msg:SimulationState",
        "//msg:SimulatorFeatures",
        "//msg:SpawnEntity",
        "//msg:SpawnResult",
        "//msg:Spawnable",
        "//msg:TagsFilter",
        "//msg:WorldResource",
        "//srv:DeleteEntity",
        "//srv:GetAvailableWorlds",
        "//srv:GetCurrentWorld",
        "//srv:GetEntities",
        "//srv:GetEntitiesStates",
        "//srv:GetEntityBounds",
        "//srv:GetEntityInfo",
        "//srv:GetEntityState",
        "//srv:GetNamedPoseBounds",
        "//srv:GetNamedPoses",
        "//srv:GetSimulationState",
        "//srv:GetSimulatorFeatures",
        "//srv:GetSpawnables",
        "//srv:LoadWorld",
        "//srv:ResetSimulation",
        "//srv:SetEntityInfo",
        "//srv:SetEntityState",
        "//srv:SetSimulationState",
        "//srv:SpawnEntities",
        "//srv:SpawnEntity",
        "//srv:StepSimulation",
        "//srv:UnloadWorld",
    ],
)

rosidl_ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@action_msgs//:ament_package",
        "@ament_cmake//:ament_package",
        "@ament_lint_common//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
