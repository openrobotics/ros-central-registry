load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

write_file(
    name = "_extras_file_0",
    out = "_gen_extras/share/rosidl_generator_dds_idl/cmake/rosidl_generator_dds_idl-extras.cmake",
    content = [
        "# generated from",
        "# rosidl_generator_dds_idl/rosidl_generator_dds_idl-extras.cmake.in",
        "",
        "find_package(ament_cmake_core QUIET REQUIRED)",
        "",
        "set(rosidl_generator_dds_idl_BIN",
        "  \"${rosidl_generator_dds_idl_DIR}/../../../lib/rosidl_generator_dds_idl/rosidl_generator_dds_idl\")",
        "normalize_path(rosidl_generator_dds_idl_BIN",
        "  \"${rosidl_generator_dds_idl_BIN}\")",
        "",
        "set(rosidl_generator_dds_idl_GENERATOR_FILES",
        "  \"${rosidl_generator_dds_idl_DIR}/../../../lib/python3.14/site-packages/rosidl_generator_dds_idl/__init__.py\")",
        "normalize_path(rosidl_generator_dds_idl_GENERATOR_FILES",
        "  \"${rosidl_generator_dds_idl_GENERATOR_FILES}\")",
        "",
        "set(rosidl_generator_dds_idl_TEMPLATE_DIR",
        "  \"${rosidl_generator_dds_idl_DIR}/../resource\")",
        "normalize_path(rosidl_generator_dds_idl_TEMPLATE_DIR",
        "  \"${rosidl_generator_dds_idl_TEMPLATE_DIR}\")",
        "",
        "include(\"${rosidl_generator_dds_idl_DIR}/rosidl_generate_dds_interfaces.cmake\")",
    ],
    is_executable = False,
)

pkg_files(
    name = "extras_files_0",
    srcs = [":_extras_file_0"],
    prefix = "share/rosidl_generator_dds_idl/cmake",
)

write_file(
    name = "egg_pkg_info",
    out = "rosidl_generator_dds_idl.egg-info/PKG-INFO",
    content = [
        "Metadata-Version: 2.1",
        "Name: rosidl_generator_dds_idl",
        "Version: 0.12.1",
    ],
)

write_file(
    name = "egg_entry_points",
    out = "rosidl_generator_dds_idl.egg-info/entry_points.txt",
    content = [
        "[rosidl_cli.command.translate.extensions]",
        "idl2ddsidl = rosidl_generator_dds_idl.cli:TranslateIDLToDDSIDL",
    ],
)

py_library(
    name = "rosidl_generator_dds_idl",
    srcs = glob(["rosidl_generator_dds_idl/**/*.py"]),
    data = glob(["resource/**"]) + [
        ":egg_entry_points",
        ":egg_pkg_info",
    ],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@rosidl_cli",
        "@rosidl_pycommon",
    ],
)

ament_index(
    name = "ament_index",
    data = glob(["resource/**"]),
    executables = ["bin/rosidl_generator_dds_idl"],
    package_xml = "package.xml",
)

py_pytest(
    name = "pytest",
    srcs = ["test/test_cli_extensions.py"],
    data = glob(["test/data/**"]) + [
        ":ament_index",
        ":egg_entry_points",
        ":egg_pkg_info",
    ],
    deps = [
        ":rosidl_generator_dds_idl",
        "@rosidl_cli",
    ],
)

ament_package(
    name = "ament_package",
    cmake = [
        "cmake/rosidl_generate_dds_interfaces.cmake",
    ],
    cmake_extras = ["rosidl_generator_dds_idl-extras.cmake"],
    data = glob(["resource/**"]),
    executables = ["bin/rosidl_generator_dds_idl"],
    install = [":extras_files_0"],
    package_xml = "package.xml",
    python = [":rosidl_generator_dds_idl"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_cli//:ament_package",
        "@rosidl_pycommon//:ament_package",
    ],
)
