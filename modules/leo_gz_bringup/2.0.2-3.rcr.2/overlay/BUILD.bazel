load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = [
        "launch/leo_gz.launch.py",
        "launch/spawn_robot.launch.py",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_black//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_mypy//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@leo_description//:ament_package",
        "@leo_gz_plugins//:ament_package",
        "@leo_gz_worlds//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@ros_gz_bridge//:ament_package",
        "@ros_gz_image//:ament_package",
        "@ros_gz_sim//:ament_package",
        "@rosdistro//:ament_package",
        "@xacro//:ament_package",
    ],
)
