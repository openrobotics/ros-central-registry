load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "leo_gz.launch.py",
        "spawn_robot.launch.py",
    ],
)

launch_ros_binary(
    name = "leo_gz_launch",
    src = "leo_gz.launch.py",
    data = [
        "//:ament_index",
        "@leo_description//:ament_index",
        "@robot_state_publisher",
        "@robot_state_publisher//:ament_index",
        "@ros_gz_bridge//:ament_index",
        "@ros_gz_bridge//:parameter_bridge",
        "@ros_gz_image//:ament_index",
        "@ros_gz_image//:image_bridge",
        "@ros_gz_sim//:ament_index",
        "@ros_gz_sim//:create",
    ],
    deps = [
        "@ament_index_python",
        "@xacro//:xacro_lib",
    ],
)

launch_ros_binary(
    name = "spawn_robot_launch",
    src = "spawn_robot.launch.py",
    data = [
        "//:ament_index",
        "@leo_description//:ament_index",
        "@robot_state_publisher",
        "@robot_state_publisher//:ament_index",
        "@ros_gz_bridge//:ament_index",
        "@ros_gz_bridge//:parameter_bridge",
        "@ros_gz_image//:ament_index",
        "@ros_gz_image//:image_bridge",
        "@ros_gz_sim//:ament_index",
        "@ros_gz_sim//:create",
    ],
    deps = [
        "@ament_index_python",
        "@xacro//:xacro_lib",
    ],
)
