load("@qt//:qt.bzl", "qt_cc_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@fuse_constraints//:fuse_constraints": "@fuse_constraints//:fuse_constraints_library",
    "@fuse_core//:fuse_core": "@fuse_core//:fuse_core_library",
    "@fuse_msgs//:cc_shared": "@fuse_msgs//:cc",
    "@fuse_variables//:fuse_variables": "@fuse_variables//:fuse_variables_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rosdistro//cc:OgreMain": "@rosdistro//cc:OgreMain_library",
    "@rosdistro//cc:OgreOverlay": "@rosdistro//cc:OgreOverlay_library",
    "@rosdistro//cc:boost.chrono_shared": "@rosdistro//cc:boost.chrono",
    "@rosdistro//cc:boost.container_shared": "@rosdistro//cc:boost.container",
    "@rosdistro//cc:boost.iostreams_shared": "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:boost.serialization_shared": "@rosdistro//cc:boost.serialization",
    "@rosdistro//cc:boost.thread_shared": "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:ceres": "@rosdistro//cc:ceres_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:curl": "@rosdistro//cc:curl_library",
    "@rosdistro//cc:glog": "@rosdistro//cc:glog_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rviz_common//:rviz_common": "@rviz_common//:rviz_common_library",
    "@rviz_rendering//:rviz_rendering": "@rviz_rendering//:rviz_rendering_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
}

CC_DEPS = [
    "@qtbase//:core",
    "@qtbase//:gui",
    "@qtbase//:widgets",
    "@qtsvg//:svg",
    "@rosdistro//cc:eigen",
]

qt_cc_library(
    name = "fuse_viz_library",
    srcs = [
        "src/mapped_covariance_property.cpp",
        "src/mapped_covariance_visual.cpp",
        "src/pose_2d_stamped_property.cpp",
        "src/pose_2d_stamped_visual.cpp",
        "src/relative_pose_2d_stamped_constraint_property.cpp",
        "src/relative_pose_2d_stamped_constraint_visual.cpp",
        "src/serialized_graph_display.cpp",
    ],
    hdrs = [
        "include/fuse_viz/mapped_covariance_property.hpp",
        "include/fuse_viz/pose_2d_stamped_property.hpp",
        "include/fuse_viz/relative_pose_2d_stamped_constraint_property.hpp",
        "include/fuse_viz/serialized_graph_display.hpp",
    ] + [
        "include/fuse_viz/conversions.h",
        "include/fuse_viz/conversions.hpp",
        "include/fuse_viz/mapped_covariance_property.h",
        "include/fuse_viz/mapped_covariance_visual.h",
        "include/fuse_viz/mapped_covariance_visual.hpp",
        "include/fuse_viz/pose_2d_stamped_property.h",
        "include/fuse_viz/pose_2d_stamped_visual.h",
        "include/fuse_viz/pose_2d_stamped_visual.hpp",
        "include/fuse_viz/relative_pose_2d_stamped_constraint_property.h",
        "include/fuse_viz/relative_pose_2d_stamped_constraint_visual.h",
        "include/fuse_viz/relative_pose_2d_stamped_constraint_visual.hpp",
        "include/fuse_viz/serialized_graph_display.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/fuse_viz",
    ],
    local_defines = ros_local_defines() + [
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "_FILE_OFFSET_BITS=64",
    ],
    moc_hdrs = [
        "include/fuse_viz/mapped_covariance_property.hpp",
        "include/fuse_viz/pose_2d_stamped_property.hpp",
        "include/fuse_viz/relative_pose_2d_stamped_constraint_property.hpp",
        "include/fuse_viz/serialized_graph_display.hpp",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "fuse_viz",
    dynamic_deps = DEPENDENCIES.keys() + [
        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtsvg//:svg_shared",
        "@qtbase//:widgets_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":fuse_viz_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":fuse_viz"],
    package_xml = "package.xml",
    plugin_category = "rviz_common",
    plugins = ["rviz_plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@fuse_constraints//:ament_package",
        "@fuse_core//:ament_package",
        "@fuse_msgs//:ament_package",
        "@fuse_variables//:ament_package",
        "@geometry_msgs//:ament_package",
        "@gtest_vendor//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_rendering//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/fuse_viz/conversions.h",
        "include/fuse_viz/conversions.hpp",
        "include/fuse_viz/mapped_covariance_property.h",
        "include/fuse_viz/mapped_covariance_property.hpp",
        "include/fuse_viz/mapped_covariance_visual.h",
        "include/fuse_viz/mapped_covariance_visual.hpp",
        "include/fuse_viz/pose_2d_stamped_property.h",
        "include/fuse_viz/pose_2d_stamped_property.hpp",
        "include/fuse_viz/pose_2d_stamped_visual.h",
        "include/fuse_viz/pose_2d_stamped_visual.hpp",
        "include/fuse_viz/relative_pose_2d_stamped_constraint_property.h",
        "include/fuse_viz/relative_pose_2d_stamped_constraint_property.hpp",
        "include/fuse_viz/relative_pose_2d_stamped_constraint_visual.h",
        "include/fuse_viz/relative_pose_2d_stamped_constraint_visual.hpp",
        "include/fuse_viz/serialized_graph_display.h",
        "include/fuse_viz/serialized_graph_display.hpp",
    ],
    libraries = [":fuse_viz"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@fuse_constraints//:ament_package",
        "@fuse_core//:ament_package",
        "@fuse_msgs//:ament_package",
        "@fuse_variables//:ament_package",
        "@geometry_msgs//:ament_package",
        "@gtest_vendor//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_rendering//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
    ],
)
