load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            "CHANGELOG.rst",
            "LICENSE",
            "package.xml",
            "pytest.ini",
            "resource/ros2launch_security",
            "ros2launch_security/__init__.py",
            "ros2launch_security/node_action/__init__.py",
            "ros2launch_security/node_action/security.py",
            "ros2launch_security/option/__init__.py",
            "ros2launch_security/option/security.py",
            "setup.cfg",
            "setup.py",
            "test/test_copyright.py",
            "test/test_flake8.py",
            "test/test_node_action.py",
            "test/test_option.py",
            "test/test_pep257.py",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
    ]
]

py_library(
    name = "ros2launch_security",
    srcs = [
        "ros2launch_security/__init__.py",
        "ros2launch_security/node_action/__init__.py",
        "ros2launch_security/node_action/security.py",
        "ros2launch_security/option/__init__.py",
        "ros2launch_security/option/security.py",
    ],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@demo_nodes_py",
        "@launch_ros",
        "@ros2launch",
        "@sros2",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":ros2launch_security"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@demo_nodes_py//:ament_package",
        "@launch_ros//:ament_package",
        "@ros2launch//:ament_package",
        "@rosdistro//:ament_package",
        "@sros2//:ament_package",
    ],
)
