load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

DEPENDENCIES = {
    "@rcl_logging_interface//:rcl_logging_interface": "@rcl_logging_interface//:rcl_logging_interface_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
}

cc_library(
    name = "rcl_logging_implementation_library",
    srcs = ["src/functions.cpp"],
    hdrs = [
        "src/functions.hpp",
        "src/visibility_control.h",
    ],
    local_defines = ros_local_defines() + [
        "DEFAULT_RCL_LOGGING_IMPLEMENTATION=rcl_logging_spdlog",
        "RCL_LOGGING_IMPLEMENTATION_BUILDING_DLL",
        "RCL_LOGGING_INTERFACE_BUILDING_DLL",
        "RCL_LOGGING_IMPLEMENTATION_DEFAULT_VISIBILITY=RCL_LOGGING_IMPLEMENTATION_PUBLIC",
    ],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rcl_logging_implementation",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rcl_logging_implementation_library"],
    deps = [":rcl_logging_implementation_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rcl_logging_implementation"],
    visibility = ["//visibility:private"],
)

### TESTING

ament_index(
    name = "test_data",
    libraries = [
        "@rcl_logging_noop//:rcl_logging_noop",
        "@rcl_logging_spdlog//:rcl_logging_spdlog",
    ],
)

cc_test(
    name = "test_logging_implementation",
    timeout = "short",
    srcs = ["test/test_logging_implementation.cpp"],
    data = [":test_data"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":rcl_logging_implementation_library",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rcl_logging_interface",
        "rcutils",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    libraries = [":rcl_logging_implementation"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rcl_logging_interface//:ament_package",
        "@rcl_logging_noop//:ament_package",
        "@rcl_logging_spdlog//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
