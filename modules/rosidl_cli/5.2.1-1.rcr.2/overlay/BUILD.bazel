load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

py_library(
    name = "rosidl_cli",
    srcs = [
        "rosidl_cli/__init__.py",
        "rosidl_cli/cli.py",
        "rosidl_cli/command/__init__.py",
        "rosidl_cli/command/generate/__init__.py",
        "rosidl_cli/command/generate/api.py",
        "rosidl_cli/command/generate/extensions.py",
        "rosidl_cli/command/hash/__init__.py",
        "rosidl_cli/command/hash/api.py",
        "rosidl_cli/command/hash/extensions.py",
        "rosidl_cli/command/helpers.py",
        "rosidl_cli/command/translate/__init__.py",
        "rosidl_cli/command/translate/api.py",
        "rosidl_cli/command/translate/extensions.py",
        "rosidl_cli/common.py",
        "rosidl_cli/entry_points.py",
        "rosidl_cli/extensions.py",
    ],
    deps = [requirement("pyyaml")],
)

py_binary(
    name = "setup",
    srcs = ["setup.py"],
    deps = [requirement("setuptools")],
)

genrule(
    name = "entry_points",
    srcs = [
        "CHANGELOG.rst",
        "completion/rosidl-argcomplete.bash",
        "completion/rosidl-argcomplete.zsh",
        "package.xml",
        "py.typed",
        "pytest.ini",
        "resource/package.dsv",
        "resource/rosidl_cli",
        "rosidl_cli/__init__.py",
        "rosidl_cli/cli.py",
        "rosidl_cli/command/__init__.py",
        "rosidl_cli/command/generate/__init__.py",
        "rosidl_cli/command/generate/api.py",
        "rosidl_cli/command/generate/extensions.py",
        "rosidl_cli/command/hash/__init__.py",
        "rosidl_cli/command/hash/api.py",
        "rosidl_cli/command/hash/extensions.py",
        "rosidl_cli/command/helpers.py",
        "rosidl_cli/command/translate/__init__.py",
        "rosidl_cli/command/translate/api.py",
        "rosidl_cli/command/translate/extensions.py",
        "rosidl_cli/common.py",
        "rosidl_cli/entry_points.py",
        "rosidl_cli/extensions.py",
        "rosidl_cli/py.typed",
        "setup.py",
    ],
    outs = ["rosidl_cli.egg-info/entry_points.txt"],
    cmd = "$(location :setup) egg_info --egg-base=$(@D)/..",
    tools = [":setup"],
)

py_console_script_binary(
    name = "rosidl",
    entry_points_txt = ":entry_points",
    pkg = ":rosidl_cli",
    script = "rosidl",
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "completion/rosidl-argcomplete.bash",
        "completion/rosidl-argcomplete.zsh",
        "package.xml",
        "py.typed",
        "pytest.ini",
        "resource/package.dsv",
        "resource/rosidl_cli",
        "rosidl_cli/__init__.py",
        "rosidl_cli/cli.py",
        "rosidl_cli/command/__init__.py",
        "rosidl_cli/command/generate/__init__.py",
        "rosidl_cli/command/generate/api.py",
        "rosidl_cli/command/generate/extensions.py",
        "rosidl_cli/command/hash/__init__.py",
        "rosidl_cli/command/hash/api.py",
        "rosidl_cli/command/hash/extensions.py",
        "rosidl_cli/command/helpers.py",
        "rosidl_cli/command/translate/__init__.py",
        "rosidl_cli/command/translate/api.py",
        "rosidl_cli/command/translate/extensions.py",
        "rosidl_cli/common.py",
        "rosidl_cli/entry_points.py",
        "rosidl_cli/extensions.py",
        "rosidl_cli/py.typed",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "mypy",
    "pep257",
    "xmllint",
]]

ament_package(
    name = "ament_package",
    console_programs = {"rosidl": "rosidl_cli.cli:main"},
    env_hooks = [
        "environment/rosidl-argcomplete.bash",
        "environment/rosidl-argcomplete.zsh",
    ],
    package_xml = "package.xml",
    python = [":rosidl_cli"] + ["rosidl_cli/py.typed"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
