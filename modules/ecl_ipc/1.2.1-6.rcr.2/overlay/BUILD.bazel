load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@ecl_errors//:ecl_errors": "@ecl_errors//:ecl_errors_library",
    "@ecl_exceptions//:ecl_exceptions": "@ecl_exceptions//:ecl_exceptions_library",
    "@ecl_threads//:ecl_threads": "@ecl_threads//:ecl_threads_library",
    "@ecl_time//:ecl_time": "@ecl_time//:ecl_time_library",
    "@ecl_time_lite//:ecl_time_lite": "@ecl_time_lite//:ecl_time_lite_library",
}

CC_DEPS = [
    "@ecl_config",
]

HEADERS = [
    "include/ecl/ipc.hpp",
    "include/ecl/ipc/semaphore.hpp",
    "include/ecl/ipc/semaphore_pos.hpp",
    "include/ecl/ipc/shared_memory.hpp",
    "include/ecl/ipc/shared_memory_pos.hpp",
]

cc_library(
    name = "ecl_ipc_library",
    srcs = [
        "src/lib/semaphore_pos.cpp",
        "src/lib/shared_memory_pos.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ecl_ipc",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "libecl_ipc.so",
    deps = [":ecl_ipc_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ecl_ipc"],
)

cc_test(
    name = "ecl_test_shared_memory",
    srcs = ["src/test/shared_memory.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":ecl_ipc_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "ecl_test_semaphores",
    srcs = ["src/test/semaphores.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":ecl_ipc_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "ecl_test_semaphores_timed",
    srcs = ["src/test/semaphores_timed.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":ecl_ipc_library",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_index(
    name = "ament_index",
    libraries = [":ecl_ipc"],
    package_xml = "package.xml",
    sonames = {"ecl_ipc": ["libecl_ipc.so.1.2.1"]},
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "ecl_config",
        "ecl_errors",
        "ecl_exceptions",
        "ecl_threads",
        "ecl_time",
        "ecl_time_lite",
    ],
    headers = HEADERS,
    include_prefix = "",
    libraries = [":ecl_ipc"],
    package_xml = "package.xml",
    sonames = {"ecl_ipc": ["libecl_ipc.so.1.2.1"]},
    deps = [
        ":ament_index",
        "@ecl_build//:ament_package",
        "@ecl_config//:ament_package",
        "@ecl_errors//:ament_package",
        "@ecl_exceptions//:ament_package",
        "@ecl_license//:ament_package",
        "@ecl_threads//:ament_package",
        "@ecl_time//:ament_package",
        "@ecl_time_lite//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
