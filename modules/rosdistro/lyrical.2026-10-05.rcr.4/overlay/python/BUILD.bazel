load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "pytest_main.py",
])

py_console_script_binary(
    name = "clang-format",
    pkg = "@pip_ros//clang_format",
    script = "clang-format",
)

# lely-core's dcf-tools (same commit as the staged C libraries), with its
# runtime requirements (setup.py install_requires: PyYAML, empy).
py_library(
    name = "dcf_tools",
    deps = [
        "@lely-core//:dcf_tools",
        "@pip_ros//empy",
        "@pip_ros//pyyaml",
    ],
)

# `dcfgen` console script (dcfgen = dcfgen.cli:main), used by
# lely_core_libraries' generate_dcf/cogen_dcf equivalents.
py_binary(
    name = "dcfgen",
    srcs = ["@lely-core//:python/dcf-tools/dcfgen/cli.py"],
    main = "@lely-core//:python/dcf-tools/dcfgen/cli.py",
    deps = [":dcf_tools"],
)

alias(
    name = "babeltrace",
    actual = "@babeltrace//:babeltrace",
)

# `--run_under` wrapper that leases a unique ROS_DOMAIN_ID per test so tests
# can run concurrently in sandboxes that share the host loopback (see the
# module docstring). Enabled by the generated .bazelrc for every `bazel test`.
py_binary(
    name = "run_test_isolated",
    srcs = ["run_test_isolated.py"],
)
