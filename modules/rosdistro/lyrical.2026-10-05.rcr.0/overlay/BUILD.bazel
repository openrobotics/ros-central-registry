load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_python//python/uv:lock.bzl", "lock")

package(default_visibility = ["//visibility:public"])

# File exports

exports_files(["requirements.txt"])

# Arguments

string_flag(
    name = "rmw",
    build_setting_default = "dynamic",
)

config_setting(
    name = "rmw_dynamic",
    flag_values = {":rmw": "dynamic"},
)

# Python

lock(
    name = "requirements",
    srcs = ["pyproject.toml"],
    out = "requirements.txt",
    args = ["--universal"],
)

# Fails CI if requirements.txt is stale relative to pyproject.toml.
diff_test(
    name = "requirements_test",
    file1 = ":requirements.txt",
    file2 = ":requirements",
)

### PACKAGING

ament_package(
    name = "ament_package",
    deps = [],
)
