# BUILD file for @basalt_headers (https://github.com/luxonis/basalt-headers),
# the header-only half of Basalt. Mirrors upstream's basalt::basalt-headers
# INTERFACE target: include/ plus Eigen, Sophus and cereal.

load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
    license_text = "LICENSE",
)

cc_library(
    name = "basalt_headers",
    hdrs = glob(
        [
            "include/basalt/**/*.h",
            "include/basalt/**/*.hpp",
        ],
        # Only used by Basalt's Ceres-based calibration tools, which the SDK
        # doesn't build; it needs Ceres headers.
        exclude = ["include/basalt/spline/ceres_local_param.hpp"],
    ),
    includes = ["include"],
    deps = [
        "@cereal",
        "@eigen",
        "@sophus",
    ],
)
