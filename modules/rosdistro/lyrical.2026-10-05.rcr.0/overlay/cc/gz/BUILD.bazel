# gz-sim's own `gz-sim-<name>-system.so` targets are self-contained: each one
# statically links gz-sim, gz-msgs, protobuf, abseil, ... next to the plugin
# code. That only works where the dynamic loader interposes those copies
# against the host's (ELF); on macOS every plugin ends up with private
# protobuf/abseil state and gzserver aborts on the second registration of
# gz/msgs/*.proto. Relink them here against the same shared libraries
# gzserver itself uses, so there is exactly one copy of everything in the
# process on every platform.
GZ_SIM_SYSTEM_DYNAMIC_DEPS = [
    ":gz-sim",
    ":gz-sensors",
    ":gz-sensors-all",
    ":gz-common",
    ":gz-common-events",
    ":gz-common-geospatial",
    ":gz-common-graphics",
    ":gz-common-io",
    ":gz-common-profiler",
    ":gz-fuel-tools",
    ":gz-math",
    ":gz-msgs",
    ":gz-physics",
    ":gz-plugin",
    ":gz-plugin-loader",
    ":gz-rendering",
    ":gz-transport",
    ":gz-transport-parameters",
    ":gz-utils",
    ":gz-utils-log",
    ":sdformat",
    "//cc:boringssl",
    "//cc:bzip2",
    "//cc:libyaml",
    "//cc:libzip",
    "//cc:sqlite3",
    "//cc:tinyxml2",
    "//cc:zstd",
] + PROTOBUF_DEPS

[
    cc_binary(
        name = "gz-sim-%s-system.so" % system,
        srcs = ["@gz-sim//:gz-sim-%s-system.so.srcs" % upstream_name],
        dynamic_deps = GZ_SIM_SYSTEM_DYNAMIC_DEPS,
        linkshared = True,
        deps = ["@gz-sim//:gz-sim-%s-system.so.deps" % upstream_name],
    )
    for system, upstream_name in [(s, s) for s in GZ_SIM_SYSTEMS] + [
        # The BCR target for the free-space-explorer system has a typo'd name.
        ("free-space-explorer", "free-space_explorer-"),
    ]
]

filegroup(
    name = "gz-sim_systems",
    srcs = [":gz-sim-%s-system.so" % system for system in GZ_SIM_SYSTEMS + ["free-space-explorer"]],
)

