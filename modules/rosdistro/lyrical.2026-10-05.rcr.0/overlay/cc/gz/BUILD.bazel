"""Gazebo (gz-*) libraries from the Bazel Central Registry, as shared libraries.

The BCR gz modules only provide static `cc_library` targets (plus a few
`cc_binary(linkshared = True)` plugins). ROS packages link against shared
libraries, so this package wraps every Gazebo library that colcon's
gz_*_vendor packages install as `libgz-<name>.so` into a `cc_shared_library`,
chained through `dynamic_deps` exactly like upstream's CMake targets link each
other. Third-party dependencies already available as shared libraries from
`//cc` (protobuf, tinyxml2, zlib, sqlite3, ...) are reused; the remaining ones
(spdlog, libuuid, zeromq, assimp, curl, ...) are linked statically into -- and
exported from -- exactly one of the libraries below, so any binary can mix any
subset of them without "linked statically more than once" errors.

Naming follows upstream's CMake targets: `gz-sim` is the shared library
(`gz-sim::core`), `gz-sim_library` the static `cc_library` to put in `deps`.
The gz_*_vendor packages alias these as `@gz_sim_vendor//:gz_sim` etc.
"""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_shared_library")
load(":defs.bzl", "gz_proto_descriptor_set", "gz_runfiles")

package(default_visibility = ["//visibility:public"])

exports_files(["defs.bzl"])

# Third-party libraries from //cc that are already shared libraries.
PROTOBUF_DEPS = [
    "//cc:protobuf",
    "//cc:zlib",
]

### gz-utils

alias(
    name = "gz-utils_library",
    actual = "@gz-utils//:gz-utils",
)

cc_shared_library(
    name = "gz-utils",
    exports_filter = ["@gz-utils//:__pkg__"],
    deps = [":gz-utils_library"],
)

alias(
    name = "gz-utils-log_library",
    actual = "@gz-utils//log:log",
)

cc_shared_library(
    name = "gz-utils-log",
    dynamic_deps = [":gz-utils"],
    exports_filter = [
        "@gz-utils//log:__pkg__",
        # spdlog/fmt are linked into libgz-utils-log.so and exported from here.
        "@spdlog//:__subpackages__",
        "@fmt//:__subpackages__",
    ],
    deps = [":gz-utils-log_library"],
)

