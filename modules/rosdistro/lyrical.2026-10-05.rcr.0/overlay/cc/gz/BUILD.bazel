### gz-common

GZ_COMMON_DYNAMIC_DEPS = [
    ":gz-math",
    ":gz-utils",
    ":gz-utils-log",
]

alias(
    name = "gz-common_library",
    actual = "@gz-common//:gz-common",
)

cc_shared_library(
    name = "gz-common",
    dynamic_deps = GZ_COMMON_DYNAMIC_DEPS,
    exports_filter = [
        "@gz-common//:__pkg__",
        "@libuuid//:__subpackages__",
    ],
    deps = [":gz-common_library"],
)

[
    (
        alias(
            name = "gz-common-%s_library" % component,
            actual = "@gz-common//%s:%s" % (component, component),
        ),
        cc_shared_library(
            name = "gz-common-" + component,
            dynamic_deps = [":gz-common"] + GZ_COMMON_DYNAMIC_DEPS + extra_dynamic_deps,
            exports_filter = ["@gz-common//%s:__pkg__" % component] + extra_exports,
            deps = [":gz-common-%s_library" % component],
        ),
    )
    for component, extra_dynamic_deps, extra_exports in [
        ("events", [], []),
        (
            "graphics",
            [
                "//cc:tinyxml2",
                "//cc:zlib",
            ],
            [
                "@assimp//:__subpackages__",
                "@cdt//:__subpackages__",
                "@pugixml//:__subpackages__",
                "@rapidjson//:__subpackages__",
            ],
        ),
        (
            "geospatial",
            [
                ":gz-common-graphics",
                "//cc:tinyxml2",
            ],
            [],
        ),
        ("io", [], []),
        ("profiler", [], []),
        ("testing", [], []),
    ]
]

