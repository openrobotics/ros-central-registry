# BCR @suitesparse//:prefixed_headers keeps the source layout
# (<suitesparse/CCOLAMD/Include/ccolamd.h>); upstream installs every public
# header flat as <suitesparse/ccolamd.h>, which is what consumers include.
cc_public_headers(
    name = "suitesparse_public_headers",
    deps = ["@suitesparse//:prefixed_headers"],
)

genrule(
    name = "suitesparse_flat_header_files",
    srcs = [":suitesparse_public_headers"],
    outs = ["include/suitesparse_flat/suitesparse/" + h for h in [
        "SuiteSparse_config.h",
        "amd.h",
        "btf.h",
        "camd.h",
        "ccolamd.h",
        "cholmod.h",
        "cholmod_types.h",
        "colamd.h",
        "cs.h",
        "klu.h",
        "klu_version.h",
        "ldl.h",
    ]],
    cmd = "for f in $(execpaths :suitesparse_public_headers); do cp $$f $(RULEDIR)/include/suitesparse_flat/suitesparse/$$(basename $$f); done",
)

cc_library(
    name = "suitesparse_flat_headers",
    hdrs = [":suitesparse_flat_header_files"],
    includes = ["include/suitesparse_flat"],
)

