    name = "libyaml_library",
    actual = "@libyaml",
)

cc_shared_library(
    name = "libyaml",
    exports_filter = [":libyaml_library"],
    deps = [":libyaml_library"],
)

# bzip2

alias(
    name = "bzip2_library",
    actual = "@bzip2//:bz2",
)

cc_shared_library(
    name = "bzip2",
    exports_filter = [":bzip2_library"],
    deps = [":bzip2_library"],
)

# libzip

alias(
    name = "libzip_library",
    actual = "@libzip//:libzip",
)

cc_shared_library(
    name = "libzip",
    dynamic_deps = [
        ":boringssl",
        ":bzip2",
        ":zlib",
        ":zstd",
    ],
    exports_filter = [":libzip_library"],
    deps = [":libzip_library"],
)

# Helper library to set up writable ROS_HOME and TMPDIR from TEST_TMPDIR for tests at runtime

cc_library(
    name = "bazel_test_helper",
    srcs = ["bazel_test_helper.cpp"],
    visibility = ["//visibility:public"],
    alwayslink = True,
)

# Default gtest/gmock `main()`. Deliberately NOT alwayslink (unlike
# `@googletest//:gtest_main` since googletest 1.18) so that tests which
# define their own `main()` don't hit "duplicate symbol: main".

cc_library(
    name = "gtest_main",
    srcs = ["gtest_main.cpp"],
    deps = ["@googletest//:gtest"],
)

# Helper library to make sure a gtest cleans up background DDS threads before exiting

cc_library(
    name = "googletest",
    srcs = ["gtest_dds_cleanup.cpp"],
    deps = [
        ":gtest_main",
        "@googletest//:gtest",
    ],
    alwayslink = True,
)

