    deps = [":ffmpeg_library"],
)

# Per-component names (libavcodec, libavformat, ...) as packages' generated
# DEPENDENCIES spell them: <component> is the static library and
# <component>_shared the shared library to link against. Every component lives
# in the single :ffmpeg shared library above, so packages mixing component
# names and :ffmpeg still only ever load one copy of each ffmpeg symbol.
[
    [
        alias(
            name = "ffmpeg_{}".format(m),
            actual = "@ffmpeg//:{}".format(m),
        ),
        alias(
            name = "ffmpeg_{}_shared".format(m),
            actual = ":ffmpeg",
        ),
    ]
    for m in [
        "avcodec",
        "avformat",
        "avutil",
        "swresample",
        "swscale",
    ]
]

