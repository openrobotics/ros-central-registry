genrule(
    name = "fcl_umbrella_header",
    srcs = [":fcl_public_headers"],
    outs = ["include/fcl_umbrella/fcl/fcl.h"],
    cmd = """
        {
          echo '#ifndef FCL_FCL_H_'
          echo '#define FCL_FCL_H_'
          for f in $(execpaths :fcl_public_headers); do
            rel="$${f#*include/}"
            case "$$rel" in
              fcl/fcl.h) ;;
              fcl/*/detail/*|fcl/detail/*|*-inl.h) ;;
              fcl/*.h) echo "#include \\"$$rel\\"" ;;
            esac
          done | sort -u
          echo '#endif  // FCL_FCL_H_'
        } > $@
    """,
)

cc_library(
    name = "fcl_umbrella_headers",
    hdrs = [":fcl_umbrella_header"],
    includes = ["include/fcl_umbrella"],
    deps = ["@fcl"],
)

