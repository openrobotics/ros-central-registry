# cairo. Upstream BCR cairo exposes its headers as <cairo.h>; most consumers
# (e.g. cartographer) include <cairo/cairo.h> as installed by pkg-config's
# cairo includedir, so re-export them under a cairo/ prefix too.

cc_public_headers(
    name = "cairo_headers",
    deps = ["@cairo"],
)

cc_library(
    name = "cairo_library",
    hdrs = [":cairo_headers"],
    include_prefix = "cairo",
    strip_include_prefix = "/src",
    deps = ["@cairo"],
)

# libcairo.so also statically links (and so must export) cairo's own BCR
# dependencies (declared as bazel_deps in MODULE.bazel for this purpose).
cc_shared_library(
    name = "cairo",
    dynamic_deps = [
        ":libpng",
        ":zlib",
    ],
    exports_filter = [
        ":cairo_library",
        "@cairo//:__subpackages__",
        "@fontconfig//:__subpackages__",
        "@libexpat//:__subpackages__",
        "@libx11//:__subpackages__",
        "@libxau//:__subpackages__",
        "@libxcb//:__subpackages__",
        "@libxext//:__subpackages__",
        "@libxrender//:__subpackages__",
        "@pixman//:__subpackages__",
    ],
    deps = [":cairo_library"],
)

# abseil-cpp. libprotobuf.so (:protobuf above) already statically links and
# exports the compiled abseil libraries, so consumers that also link
# :protobuf dynamically resolve these against that single copy.

[
    alias(
        name = "absl_" + name,
        actual = actual,
    )
    for name, actual in {
        "base": "@abseil-cpp//absl/base",
        "flat_hash_map": "@abseil-cpp//absl/container:flat_hash_map",
        "flat_hash_set": "@abseil-cpp//absl/container:flat_hash_set",
        "memory": "@abseil-cpp//absl/memory",
        "optional": "@abseil-cpp//absl/types:optional",
        "str_format": "@abseil-cpp//absl/strings:str_format",
        "strings": "@abseil-cpp//absl/strings",
        "synchronization": "@abseil-cpp//absl/synchronization",
    }.items()
]

