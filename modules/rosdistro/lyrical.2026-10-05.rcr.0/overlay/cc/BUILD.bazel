# PCL as one shared library (libpcl.so). Packages that link PCL into their
# own cc_shared_library list ":pcl" in dynamic_deps (with ":pcl_library" for
# headers), so PCL and its statically-built deps (flann, qhull) are owned and
# exported in exactly one place.

cc_library(
    name = "pcl_library",
    deps = [
        "@pcl//:2d",
        "@pcl//:common",
        "@pcl//:features",
        "@pcl//:filters",
        "@pcl//:geometry",
        "@pcl//:io",
        "@pcl//:kdtree",
        "@pcl//:keypoints",
        "@pcl//:ml",
        "@pcl//:octree",
        "@pcl//:outofcore",
        "@pcl//:people",
        "@pcl//:recognition",
        "@pcl//:registration",
        "@pcl//:sample_consensus",
        "@pcl//:search",
        "@pcl//:segmentation",
        "@pcl//:surface",
        "@pcl//:tracking",
        "@pcl//:visualization",
    ],
)

cc_shared_library(
    name = "pcl",
    dynamic_deps = [
        ":boost.asio_shared",
        ":boost.filesystem_shared",
        ":boost.iostreams_shared",
        ":boost.serialization_shared",
        ":boost.thread_shared",
        ":libpng",
        ":lz4",
        ":lz4_hc",
        ":qhull_r_shared",
        ":vtk",
        ":zlib",
    ],
    exports_filter = [
        ":pcl_library",
        "@flann//:__subpackages__",
        "@pcl//:__subpackages__",
    ],
    deps = [":pcl_library"],
)

