# Build files and patches for the Luxonis Basalt sources fetched by
# rosdistro's MODULE.bazel (@basalt_headers and @basalt). depthai links the
# Basalt SDK for its BasaltVIO node, matching upstream's default
# DEPTHAI_BASALT_SUPPORT=ON.

load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

exports_files([
    "basalt.BUILD.bazel",
    "basalt_headers.BUILD.bazel",
    "basalt_headers_eigen_include.patch",
])
