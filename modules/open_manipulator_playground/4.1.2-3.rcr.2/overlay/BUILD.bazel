load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:boringssl": "@rosdistro//cc:boringssl_crypto_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@moveit_ros_planning_interface//:moveit_common_planning_interface_objects_library",
    "@moveit_ros_planning_interface//:moveit_move_group_interface_library",
    "@moveit_ros_planning_interface//:moveit_planning_scene_interface_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:boringssl_ssl_library",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
]

cc_library(
    name = "open_manipulator_playground_library",
    hdrs = [
        "include/open_manipulator_playground/omy_3m_hello_moveit.h",
        "include/open_manipulator_playground/omy_f3m_hello_moveit.h",
        "include/open_manipulator_playground/open_manipulator_x_hello_moveit.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        ".",
        "include",
        "include/open_manipulator_playground",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "omy_3m_hello_moveit",
    srcs = [
        "include/open_manipulator_playground/omy_3m_hello_moveit.h",
        "include/open_manipulator_playground/omy_f3m_hello_moveit.h",
        "include/open_manipulator_playground/open_manipulator_x_hello_moveit.h",
        "src/omy_3m_hello_moveit.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/open_manipulator_playground",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "omy_f3m_hello_moveit",
    srcs = [
        "include/open_manipulator_playground/omy_3m_hello_moveit.h",
        "include/open_manipulator_playground/omy_f3m_hello_moveit.h",
        "include/open_manipulator_playground/open_manipulator_x_hello_moveit.h",
        "src/omy_f3m_hello_moveit.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/open_manipulator_playground",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_binary(
    name = "open_manipulator_x_hello_moveit",
    srcs = [
        "include/open_manipulator_playground/omy_3m_hello_moveit.h",
        "include/open_manipulator_playground/omy_f3m_hello_moveit.h",
        "include/open_manipulator_playground/open_manipulator_x_hello_moveit.h",
        "src/open_manipulator_x_hello_moveit.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/open_manipulator_playground",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

ament_index(
    name = "ament_index",
    lib_data = [
        ":omy_3m_hello_moveit",
        ":omy_f3m_hello_moveit",
        ":open_manipulator_x_hello_moveit",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@moveit_ros_planning_interface//:ament_package",
        "@rclcpp//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/open_manipulator_playground/omy_3m_hello_moveit.h",
        "include/open_manipulator_playground/omy_f3m_hello_moveit.h",
        "include/open_manipulator_playground/open_manipulator_x_hello_moveit.h",
    ],
    include_prefix = "",
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@moveit_ros_planning_interface//:ament_package",
        "@rclcpp//:ament_package",
    ],
)
