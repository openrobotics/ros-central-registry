load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

ament_index(
    name = "ament_index",
    data = glob(["images/**"]),
    package_xml = "package.xml",
)

py_library(
    name = "rqt_robot_dashboard",
    srcs = glob(["src/rqt_robot_dashboard/**/*.py"]),
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@diagnostic_msgs//:py",
        "@python_qt_binding",
        "@qt_gui",
        "@rclpy",
        "@rqt_console",
        "@rqt_gui",
        "@rqt_gui_py",
        "@rqt_robot_monitor",
    ],
)

py_pytest(
    name = "test_battery_dash_widget",
    srcs = ["test/test_battery_dash_widget.py"],
    data = glob(["test/**"]),
    env = {"QT_QPA_PLATFORM": "offscreen"},
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":rqt_robot_dashboard"],
)

