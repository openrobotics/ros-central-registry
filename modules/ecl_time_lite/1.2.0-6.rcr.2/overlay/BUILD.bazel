load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

cmake_configure_file(
    name = "config_hpp",
    src = "include/ecl/time_lite/config.hpp.in",
    out = "include/ecl/time_lite/config.hpp",
    defines = [
        "ECL_PRIVATE_HAS_CLOCK_GETTIME=1",
        "ECL_PRIVATE_HAS_CLOCK_NANOSLEEP=1",
        "ECL_HAS_CLOCK_MONOTONIC=1",
        "ECL_HAS_CPUTIME=1",
        "ECL_HAS_RT_TIMERS=1",
    ],
    undefines = [
        "ECL_HAS_MACH_TIMERS",
        "ECL_HAS_WIN_TIMERS",
        "ECL_HAS_POSIX_TIMERS",
    ],
)

cc_library(
    name = "ecl_time_lite_library",
    srcs = glob(["src/lib/*.cpp"]),
    hdrs = glob(["include/**/*.hpp"]) + [":config_hpp"],
    includes = ["include"],
    linkopts = ["-lrt"],
    deps = [
        "@ecl_config",
        "@ecl_errors//:ecl_errors_library",
    ],
)

cc_shared_library(
    name = "ecl_time_lite",
    shared_lib_name = "libecl_time_lite.so",
    deps = [":ecl_time_lite_library"],
)

pkg_files(
    name = "libecl_time_lite_so_versioned",
    srcs = [":ecl_time_lite"],
    prefix = "lib",
    renames = {":ecl_time_lite": "libecl_time_lite.so.1.2.0"},
)

cc_binary(
    name = "demo_time_functions",
    srcs = ["src/examples/time_functions.cpp"],
    deps = [":ecl_time_lite_library"],
)

ament_index(
    name = "ament_index",
    executables = [":demo_time_functions"],
    libraries = [":ecl_time_lite"],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "ecl_config",
        "ecl_errors",
    ],
    executables = [":demo_time_functions"],
    headers = glob(["include/**/*.hpp"]) + [":config_hpp"],
    include_prefix = "",
    install = [":libecl_time_lite_so_versioned"],
    libraries = [":ecl_time_lite"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ecl_build//:ament_package",
        "@ecl_config//:ament_package",
        "@ecl_errors//:ament_package",
        "@ecl_license//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
