        "@qtbase//:core_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:widgets_shared",
        "@qtbase//:xml_shared",
        "@qtsvg//:svg_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":DataLoadROS2_library"],
)

