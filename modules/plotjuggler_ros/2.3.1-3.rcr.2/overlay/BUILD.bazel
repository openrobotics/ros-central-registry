load("@qt//:qt.bzl", "qt_cc_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@plotjuggler//:plotjuggler_base": "@plotjuggler//:plotjuggler_base_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosbag2_transport//:rosbag2_transport": "@rosbag2_transport//:rosbag2_transport_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp": "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp_library",
    "@rosx_introspection//:rosx_introspection": "@rosx_introspection//:rosx_introspection_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@plotjuggler//:_gen_textual_hdrs",
    "@plotjuggler_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.algorithm",
    "@rosdistro//cc:boost.smart_ptr",
    "@rosdistro//cc:boost.spirit",
    "@qtbase//:core",
    "@qtbase//:gui",
    "@qtbase//:widgets",
    "@qtbase//:xml",
    "@qtsvg//:svg",
    "@tf2_msgs//:cc",
]

qt_cc_library(
    name = "commonROS_library",
    srcs = [
        "src/dialog_select_ros_topics.cpp",
        "src/parser_configuration.cpp",
        "src/ros_parsers/ros2_parser.cpp",
    ],
    hdrs = [
        "src/TopicPublisherROS2/generic_publisher.h",
        "src/dialog_select_ros_topics.h",
        "src/dialog_with_itemlist.h",
        "src/parser_configuration.h",
        "src/publisher_select_dialog.h",
        "src/ros_parsers/ros2_parser.h",
        ":gen_ui_dialog_select_ros_topics_h",
        ":gen_ui_dialog_with_itemlist_h",
        ":gen_ui_publisher_select_dialog_h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "COMPILED_WITH_AMENT",
        "FMT_HEADER_ONLY",
        "NDEBUG",
        "PJ_MAJOR_VERSION=3",
        "PJ_MINOR_VERSION=17",
        "PJ_PATCH_VERSION=2",
        'PJ_PLUGIN_INSTALL_DIRECTORY=\\"./lib/plotjuggler/plugins\\"',
        "QWT_MOC_INCLUDE",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

qt_cc_library(
    name = "DataLoadROS2_library",
    srcs = ["src/DataLoadROS2/dataload_ros2.cpp"],
    hdrs = [
        "src/DataLoadROS2/dataload_ros2.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
