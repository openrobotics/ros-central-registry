genrule(
    name = "gen_ui_dialog_select_ros_topics_h",
    srcs = ["src/dialog_select_ros_topics.ui"],
    outs = ["_gen/include/ui_dialog_select_ros_topics.h"],
    cmd = select({
        "@rules_qt//:linux_x86_64": "$(location @qt_linux_x86_64//:uic) $(location src/dialog_select_ros_topics.ui) -o $@",
        "@rules_qt//:linux_aarch64": "$(location @qt_linux_aarch64//:uic) $(location src/dialog_select_ros_topics.ui) -o $@",
        "@platforms//os:windows": "$(location @qt_windows_x86_64//:uic) $(location src/dialog_select_ros_topics.ui) -o $@",
        "@rules_qt//:osx_x86_64": "$(location @qt_mac_x86_64//:uic) $(location src/dialog_select_ros_topics.ui) -o $@",
        "@rules_qt//:osx_arm64": "$(location @qt_mac_aarch64//:uic) $(location src/dialog_select_ros_topics.ui) -o $@",
    }),
    tools = select({
        "@rules_qt//:linux_x86_64": ["@qt_linux_x86_64//:uic"],
        "@rules_qt//:linux_aarch64": ["@qt_linux_aarch64//:uic"],
        "@platforms//os:windows": ["@qt_windows_x86_64//:uic"],
        "@rules_qt//:osx_arm64": ["@qt_mac_aarch64//:uic"],
        "@rules_qt//:osx_x86_64": ["@qt_mac_x86_64//:uic"],
    }),
)

