genrule(
    name = "gen_ui_dialog_select_ros_topics_h",
    srcs = ["src/dialog_select_ros_topics.ui"],
    outs = ["_gen/include/ui_dialog_select_ros_topics.h"],
    cmd = "$(execpath @qtbase//:uic) $(location src/dialog_select_ros_topics.ui) -o $@",
    tools = ["@qtbase//:uic"],
)

genrule(
    name = "gen_ui_dialog_with_itemlist_h",
    srcs = ["src/dialog_with_itemlist.ui"],
    outs = ["_gen/include/ui_dialog_with_itemlist.h"],
    cmd = "$(execpath @qtbase//:uic) $(location src/dialog_with_itemlist.ui) -o $@",
    tools = ["@qtbase//:uic"],
)

genrule(
    name = "gen_ui_publisher_select_dialog_h",
    srcs = ["src/publisher_select_dialog.ui"],
    outs = ["_gen/include/ui_publisher_select_dialog.h"],
    cmd = "$(execpath @qtbase//:uic) $(location src/publisher_select_dialog.ui) -o $@",
    tools = ["@qtbase//:uic"],
)

ament_index(
    name = "ament_index",
    data = ["//launch:launch_files"],
    lib_data = [
        ":DataLoadROS2",
        ":DataStreamROS2",
        ":TopicPublisherROS2",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@plotjuggler//:ament_package",
        "@plotjuggler_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rcpputils//:ament_package",
        "@rosbag2_transport//:ament_package",
        "@tf2_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@plotjuggler//:ament_package",
        "@plotjuggler_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rcpputils//:ament_package",
        "@rosbag2_transport//:ament_package",
        "@tf2_msgs//:ament_package",
        "@tf2_ros//:ament_package",
