        "PJ_PATCH_VERSION=2",
        'PJ_PLUGIN_INSTALL_DIRECTORY=\\"./lib/plotjuggler/plugins\\"',
        "QWT_MOC_INCLUDE",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":commonROS_library"],
)

