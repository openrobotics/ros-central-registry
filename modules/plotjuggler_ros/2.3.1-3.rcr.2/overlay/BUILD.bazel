}

CC_DEPS = [
    "@plotjuggler//:_gen_textual_hdrs",
    "@plotjuggler_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.algorithm",
    "@rosdistro//cc:boost.smart_ptr",
    "@rosdistro//cc:boost.spirit",
    "@rules_qt//:qt_core",
    "@rules_qt//:qt_gui",
    "@rules_qt//:qt_svg",
    "@rules_qt//:qt_widgets",
    "@tf2_msgs//:cc",
]

cc_library(
    name = "commonROS_library",
    srcs = [":gen_plotjuggler_ros_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_ui_dialog_select_ros_topics_h",
        ":gen_ui_dialog_with_itemlist_h",
        ":gen_ui_publisher_select_dialog_h",
        ":gen_ui_qnodedialog_h",
    ],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "COMPILED_WITH_AMENT",
        "FMT_HEADER_ONLY",
        "NDEBUG",
        "PJ_MAJOR_VERSION=3",
        "PJ_MINOR_VERSION=17",
        "PJ_PATCH_VERSION=2",
        "PJ_PLUGIN_INSTALL_DIRECTORY=\\\"./lib/plotjuggler/plugins\\\"",
        "QWT_MOC_INCLUDE",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_library(
    name = "DataLoadROS2_library",
