load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosidl_buffer_backend//:rosidl_buffer_backend": "@rosidl_buffer_backend//:rosidl_buffer_backend_library",
    "@rosidl_runtime_cpp//:rosidl_runtime_cpp": "@rosidl_runtime_cpp//:rosidl_runtime_cpp_library",
}

TEST_DEPENDENCIES = DEPENDENCIES | {
    "//:rosidl_buffer_backend_registry": "//:rosidl_buffer_backend_registry_library",
    "@rosidl_buffer//:rosidl_buffer": "@rosidl_buffer//:rosidl_buffer_library",
}

[cc_test(
    name = test.removesuffix(".py"),
    srcs = [
        "dummy_buffer_backend.hpp",
        "{}.cpp".format(test),
    ],
    dynamic_deps = ["//:transitive_dynamic_deps_test"],
    local_defines = ros_local_defines(),
    deps = TEST_DEPENDENCIES.values() + ["@rosdistro//cc:googletest"],
) for test in ["test_buffer_backend_registry"]]
