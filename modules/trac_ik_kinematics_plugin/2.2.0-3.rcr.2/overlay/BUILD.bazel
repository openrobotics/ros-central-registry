load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

generate_parameter_library(
    name = "trac_ik_kinematics_plugin_parameters",
    yaml_file = "src/trac_ik_kinematics_plugin_parameters.yaml",
)

DEPENDENCIES = {
    "@class_loader//:class_loader": "@class_loader//:class_loader_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@tf2_kdl//:tf2_kdl": "@tf2_kdl//:tf2_kdl_library",
    "@trac_ik_lib//:trac_ik": "@trac_ik_lib//:trac_ik_library",
    "@urdf//:urdf": "@urdf//:urdf_library",
}

CC_DEPS = [
    ":trac_ik_kinematics_plugin_parameters",
    "@class_loader//:class_loader_headers",
    "@generate_parameter_library//:generate_parameter_library",
    "@moveit_core//:moveit_exceptions_library",
    "@moveit_core//:moveit_kinematics_base_library",
    "@moveit_core//:moveit_robot_model_library",
    "@moveit_core//:moveit_robot_state_library",
    "@moveit_core//:moveit_transforms_library",
    "@moveit_core//:moveit_utils_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
]

cc_library(
    name = "trac_ik_kinematics_plugin_library",
    srcs = ["src/trac_ik_kinematics_plugin.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [":trac_ik_kinematics_plugin_parameters_gen"],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "_gen/include/trac_ik_kinematics_plugin",
        "include",
    ],
    local_defines = ros_local_defines() + [
        "NLOPT_DLL",
        "TRAC_IK_KINEMATICS_PLUGIN_BUILDING_DLL",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "trac_ik_kinematics_plugin",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":trac_ik_kinematics_plugin_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":trac_ik_kinematics_plugin"],
    package_xml = "package.xml",
    plugin_category = "moveit_core",
    plugins = ["trac_ik_kinematics_description.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@class_loader//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@moveit_core//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@tf2_kdl//:ament_package",
        "@trac_ik_lib//:ament_package",
        "@urdf//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "fmt",
        "rclcpp",
        "rclcpp_lifecycle",
        "rsl",
        "tcb_span",
        "tl-expected",
        "class_loader",
        "generate_parameter_library",
        "moveit_core",
        "pluginlib",
        "rclcpp",
        "tf2_kdl",
        "trac_ik_lib",
        "urdf",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_trac_ik_kinematics_plugin",
    headers = glob(["include/**"]),
    include_prefix = "",
    libraries = [":trac_ik_kinematics_plugin"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@class_loader//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@moveit_core//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@tf2_kdl//:ament_package",
        "@trac_ik_lib//:ament_package",
        "@urdf//:ament_package",
    ],
)
