cc_test(
    name = "foxglove_datatamer_relays_test",
    srcs = ["foxglove_datatamer_relays.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        "//:ament_index",
        "//:ament_index_extra",
        "//:data_tamer_tools_tools",
        "//:foxglove_relay",
        "//:log_rotation_coordinator_component",
        "//:mcap_sink",
        "//:rosout_logger_component",
    ] + [
        "data/capture.3026812782465800491.schema.txt",
        "data/capture.3026812782465800491.snapshot.bin",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    linkopts = ["-Wl,--allow-multiple-definition"],
    local_defines = ros_local_defines() + [
        'DATA_TAMER_VERSION=\\"1.0.0\\"',
        "GTEST_HAS_PTHREAD=1",
        "USING_ROS2=1",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:data_tamer_tools_tools_library",
        "//:foxglove_relay_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

