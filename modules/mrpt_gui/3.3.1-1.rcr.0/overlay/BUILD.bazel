# Mirrors the string(APPEND NANOGUI_CONFIG_FILE_CONTENT ...) logic in
# 3rdparty/nanogui/CMakeLists.txt for BUILD_SHARED_LIBS=ON, NANOGUI_USE_GLAD=OFF.
genrule(
    name = "nanogui_config_h",
    outs = ["_gen/include/mrpt/nanogui/include/nanogui-config.h"],
    cmd = " && ".join([
        "printf '// Automatically generated do not edit\\n\\n#pragma once\\n\\n' > $@",
        "printf '#define NANOGUI_BUILD\\n#define NVG_BUILD\\n' >> $@",
        "printf '#define NANOGUI_SHARED\\n' >> $@",
        "printf '#ifndef NVG_SHARED\\n# define NVG_SHARED\\n#endif\\n' >> $@",
    ]),
)

