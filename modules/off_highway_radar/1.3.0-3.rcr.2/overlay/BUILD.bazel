load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@off_highway_can//:off_highway_can": "@off_highway_can//:off_highway_can_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

CC_DEPS = [
    "@can_msgs//:cc",
    "@diagnostic_msgs//:cc",
    "@geometry_msgs//:cc",
    "@off_highway_radar_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

cc_library(
    name = "off_highway_radar_library",
    srcs = [
        "src/receiver.cpp",
        "src/sender.cpp",
    ],
    hdrs = [
        "include/off_highway_radar/pcl_point_object.hpp",
        "include/off_highway_radar/receiver.hpp",
        "include/off_highway_radar/sender.hpp",
        "src/converter/ros_message_conversion.hpp",
    ],
    includes = [
        ".",
        "include",
        "include/off_highway_radar",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "off_highway_radar",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":off_highway_radar_library"],
)

rclcpp_components_register_node(
    name = "receiver",
    component = ":off_highway_radar",
    node_name = "receiver",
    plugin = "off_highway_radar::Receiver",
)

rclcpp_components_register_node(
    name = "sender",
    component = ":off_highway_radar",
    node_name = "sender",
    plugin = "off_highway_radar::Receiver",
)

rclcpp_components_register_nodes(
    name = "off_highway_radar_components",
    component = ":off_highway_radar",
    plugins = ["off_highway_radar::Sender"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":off_highway_radar"],
)

ament_index(
    name = "ament_index",
    components = [
        ":receiver_record",
        ":sender_record",
        ":off_highway_radar_components",
    ],
    data = [
        "config/receiver_params.yaml",
        "config/sender_params.yaml",
        "//launch:launch_files",
    ],
    lib_data = [
        ":receiver",
        ":sender",
    ],
    libraries = [":off_highway_radar"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@can_msgs//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@geometry_msgs//:ament_package",
        "@off_highway_can//:ament_package",
        "@off_highway_radar_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "can_msgs",
        "off_highway_can",
        "off_highway_radar_msgs",
        "rclcpp",
        "rclcpp_components",
        "sensor_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    cmake_export_name = "export_off_highway_radar",
    headers = [
        "include/off_highway_radar/pcl_point_object.hpp",
        "include/off_highway_radar/receiver.hpp",
        "include/off_highway_radar/sender.hpp",
    ],
    include_prefix = "",
    libraries = [":off_highway_radar"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@can_msgs//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@geometry_msgs//:ament_package",
        "@off_highway_can//:ament_package",
        "@off_highway_radar_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
