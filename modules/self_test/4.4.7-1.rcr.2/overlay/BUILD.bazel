cc_test(
    name = "test_nominal_selftest",
    srcs = ["test/nominal_selftest.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    data = [":ament_index"] + glob(
        [
            "test/**",
