load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/rclcpp_lifecycle/lifecycle_node.hpp",
    "include/rclcpp_lifecycle/lifecycle_node_impl.hpp",
    "include/rclcpp_lifecycle/lifecycle_publisher.hpp",
    "include/rclcpp_lifecycle/managed_entity.hpp",
    "include/rclcpp_lifecycle/node_interfaces/lifecycle_node_interface.hpp",
    "include/rclcpp_lifecycle/state.hpp",
    "include/rclcpp_lifecycle/transition.hpp",
    "include/rclcpp_lifecycle/type_traits/is_manageable_node.hpp",
    "include/rclcpp_lifecycle/visibility_control.h",
]

DEPENDENCIES = {
    "@rcl//:rcl": "@rcl//:rcl_library",
    "@rcl_lifecycle//:rcl_lifecycle": "@rcl_lifecycle//:rcl_lifecycle_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosidl_typesupport_cpp//:rosidl_typesupport_cpp": "@rosidl_typesupport_cpp//:rosidl_typesupport_cpp_library",
}

cc_library(
    name = "rclcpp_lifecycle_library",
    srcs = [
        "src/lifecycle_node.cpp",
        "src/lifecycle_node_interface_impl.cpp",
        "src/lifecycle_node_interface_impl.hpp",
        "src/managed_entity.cpp",
        "src/node_interfaces/lifecycle_node_interface.cpp",
        "src/state.cpp",
        "src/transition.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@lifecycle_msgs//:cc",
        "@rcl_interfaces//:cc",
    ],
)

cc_shared_library(
    name = "rclcpp_lifecycle",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rclcpp_lifecycle_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rclcpp_lifecycle"],
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = True,
    cmake_export_dependencies_list = [
        "lifecycle_msgs",
        "rcl",
        "rcl_interfaces",
        "rcl_lifecycle",
        "rclcpp",
        "rcutils",
        "rmw",
        "rosidl_typesupport_cpp",
    ],
    headers = HEADERS,
    libraries = [":rclcpp_lifecycle"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@mimick_vendor//:ament_package",
        "@performance_test_fixture//:ament_package",
        "@rcl//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rcl_lifecycle//:ament_package",
        "@rclcpp//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_typesupport_cpp//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
