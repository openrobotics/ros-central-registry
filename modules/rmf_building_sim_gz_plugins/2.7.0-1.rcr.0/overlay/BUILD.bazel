load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@gz_msgs_vendor//:gz_msgs": "@gz_msgs_vendor//:gz_msgs_library",
    "@gz_plugin_vendor//:gz_plugin": "@gz_plugin_vendor//:gz_plugin_library",
    "@gz_rendering_vendor//:gz_rendering": "@gz_rendering_vendor//:gz_rendering_library",
    "@gz_sim_vendor//:gz_sim": "@gz_sim_vendor//:gz_sim_library",
    "@gz_transport_vendor//:gz_transport": "@gz_transport_vendor//:gz_transport_library",
    "@gz_transport_vendor//:gz_transport_log": "@gz_transport_vendor//:gz_transport_log_library",
    "@gz_transport_vendor//:gz_transport_parameters": "@gz_transport_vendor//:gz_transport_parameters_library",
    "@menge_vendor//:menge_vendor": "@menge_vendor//:menge_vendor_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rmf_door_msgs//:cc_shared": "@rmf_door_msgs//:cc",
    "@rmf_fleet_msgs//:cc_shared": "@rmf_fleet_msgs//:cc",
    "@rmf_lift_msgs//:cc_shared": "@rmf_lift_msgs//:cc",
    "@rosdistro//cc:protobuf": "@rosdistro//cc:protobuf_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
}

CC_DEPS = [
    "@gz_plugin_vendor//:gz_plugin_register_library",
    "@gz_rendering_vendor//:engine_plugins",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
    "@rosdistro//cc:spdlog",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_library(
    name = "headers",
    hdrs = [
        "include/rmf_building_sim_gz_plugins/components/Charger.hpp",
        "include/rmf_building_sim_gz_plugins/components/Door.hpp",
        "include/rmf_building_sim_gz_plugins/components/Lift.hpp",
        "include/rmf_building_sim_gz_plugins/utils.hpp",
    ],
    includes = [
        "include",
        "include/rmf_building_sim_gz_plugins",
    ],
)

cc_library(
    name = "crowd_simulator_library",
    srcs = ["src/crowd_simulator.cpp"],
    hdrs = [
        "include/rmf_building_sim_gz_plugins/components/Charger.hpp",
        "include/rmf_building_sim_gz_plugins/components/Door.hpp",
        "include/rmf_building_sim_gz_plugins/components/Lift.hpp",
        "include/rmf_building_sim_gz_plugins/utils.hpp",
        "src/crowd_simulator.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "include/rmf_building_sim_gz_plugins",
    ],
    local_defines = ros_local_defines() + ["HAVE_PYBIND11"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "crowd_simulator",
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@rmf_door_msgs//:cc_shared",
        "@rmf_fleet_msgs//:cc_shared",
        "@rmf_lift_msgs//:cc_shared",
    ],
    deps = [":crowd_simulator_library"],
)

cc_library(
    name = "door_library",
    srcs = ["src/door.cpp"],
    hdrs = [
        "include/rmf_building_sim_gz_plugins/components/Charger.hpp",
        "include/rmf_building_sim_gz_plugins/components/Door.hpp",
        "include/rmf_building_sim_gz_plugins/components/Lift.hpp",
        "include/rmf_building_sim_gz_plugins/utils.hpp",
        "src/crowd_simulator.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "include/rmf_building_sim_gz_plugins",
    ],
    local_defines = ros_local_defines() + ["HAVE_PYBIND11"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "door",
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@rmf_door_msgs//:cc_shared",
        "@rmf_fleet_msgs//:cc_shared",
        "@rmf_lift_msgs//:cc_shared",
    ],
    deps = [":door_library"],
)

cc_library(
    name = "lift_library",
    srcs = ["src/lift.cpp"],
    hdrs = [
        "include/rmf_building_sim_gz_plugins/components/Charger.hpp",
        "include/rmf_building_sim_gz_plugins/components/Door.hpp",
        "include/rmf_building_sim_gz_plugins/components/Lift.hpp",
        "include/rmf_building_sim_gz_plugins/utils.hpp",
        "src/crowd_simulator.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "include/rmf_building_sim_gz_plugins",
    ],
    local_defines = ros_local_defines() + ["HAVE_PYBIND11"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "lift",
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@rmf_door_msgs//:cc_shared",
        "@rmf_fleet_msgs//:cc_shared",
        "@rmf_lift_msgs//:cc_shared",
    ],
    deps = [":lift_library"],
)

cc_library(
    name = "register_component_library",
    srcs = ["src/register_component.cpp"],
    hdrs = [
        "include/rmf_building_sim_gz_plugins/components/Charger.hpp",
        "include/rmf_building_sim_gz_plugins/components/Door.hpp",
        "include/rmf_building_sim_gz_plugins/components/Lift.hpp",
        "include/rmf_building_sim_gz_plugins/utils.hpp",
        "src/crowd_simulator.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "_gen/include",
        "include",
        "include/rmf_building_sim_gz_plugins",
    ],
    local_defines = ros_local_defines() + ["HAVE_PYBIND11"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "register_component",
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@rmf_door_msgs//:cc_shared",
        "@rmf_fleet_msgs//:cc_shared",
        "@rmf_lift_msgs//:cc_shared",
    ],
    deps = [":register_component_library"],
)

ament_index(
    name = "ament_index",
    lib_data = [
        ":crowd_simulator",
        ":door",
        ":lift",
        ":register_component",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@gz_gui_vendor//:ament_package",
        "@gz_msgs_vendor//:ament_package",
        "@gz_plugin_vendor//:ament_package",
        "@gz_rendering_vendor//:ament_package",
        "@gz_sim_vendor//:ament_package",
        "@gz_transport_vendor//:ament_package",
        "@menge_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rmf_door_msgs//:ament_package",
        "@rmf_fleet_msgs//:ament_package",
        "@rmf_lift_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = [
        "include/rmf_building_sim_gz_plugins/components/Charger.hpp",
        "include/rmf_building_sim_gz_plugins/components/Door.hpp",
        "include/rmf_building_sim_gz_plugins/components/Lift.hpp",
        "include/rmf_building_sim_gz_plugins/utils.hpp",
    ],
    include_prefix = "",
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@gz_gui_vendor//:ament_package",
        "@gz_msgs_vendor//:ament_package",
        "@gz_plugin_vendor//:ament_package",
        "@gz_rendering_vendor//:ament_package",
        "@gz_sim_vendor//:ament_package",
        "@gz_transport_vendor//:ament_package",
        "@menge_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rmf_door_msgs//:ament_package",
        "@rmf_fleet_msgs//:ament_package",
        "@rmf_lift_msgs//:ament_package",
    ],
)
