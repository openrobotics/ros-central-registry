load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package", "register_ament_files")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

py_library(
    name = "nodl_generator_cpp",
    srcs = glob(["nodl_generator_cpp/**/*.py"]),
    data = glob([
        "nodl_generator_cpp/schemas/**",
        "nodl_generator_cpp/templates/**",
    ]),
    imports = ["."],
    deps = [
        requirement("jinja2"),
        requirement("pyyaml"),
        "@generate_parameter_library_py",
        "@nodl_schema",
    ],
)

register_ament_files(
    name = "ament_files_0",
    files = glob([
        "nodl_generator_cpp/schemas/**",
        "nodl_generator_cpp/templates/**",
    ]),
    prefix = "lib/python3.12/site-packages",
)

ament_package(
    name = "ament_package",
    cmake = glob(["cmake/**"]),
    cmake_export_dependencies = False,
    cmake_extras = ["nodl_generate_cpp-extras.cmake"],
    data = [
        ":ament_files_0",
    ],
    package_xml = "package.xml",
    python = [":nodl_generator_cpp"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@generate_parameter_library_py//:ament_package",
        "@nodl_schema//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
