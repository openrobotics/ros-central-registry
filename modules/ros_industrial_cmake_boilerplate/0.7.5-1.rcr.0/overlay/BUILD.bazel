load("@rosdistro//ament:defs.bzl", "ament_package", "register_ament_files")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PACKAGING

register_ament_files(
    name = "ament_files_0",
    files = [
        "cmake/clang_tidy_tools.cmake",
        "cmake/cmake_tools.cmake",
        "cmake/code_coverage.cmake",
        "cmake/cpack_tools.cmake",
        "cmake/cppcheck_tools.cmake",
        "cmake/create_debian_changelog.py",
        "cmake/extract_package_metadata.cmake",
        "cmake/iwyu_tools.cmake",
        "cmake/sanitizers.cmake",
    ],
    prefix = "lib/cmake/ros_industrial_cmake_boilerplate",
    strip_prefix = "cmake",
)

ament_package(
    name = "ament_package",
    build_type = "cmake",
    data = [
        ":ament_files_0",
    ],
    package_xml = "package.xml",
    deps = [
        "@rosdistro//:ament_package",
    ],
)
