load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@backward_ros//:backward": "@backward_ros//:backward_library",
    "@nlohmann_json_schema_validator_vendor//:nlohmann_json_schema_validator": "@nlohmann_json_schema_validator_vendor//:nlohmann_json_schema_validator_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rmf_task_msgs//:cc_shared": "@rmf_task_msgs//:cc",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosdistro//cc:zlib": "@rosdistro//cc:zlib_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rmf_api_msgs//:rmf_api_msgs",
    "@rmf_traffic//:rmf_traffic_library",
    "@rmf_traffic_ros2//:rmf_traffic_ros2_library",
    "@rmf_utils//:rmf_utils_library",
    "@rmf_websocket//:rmf_websocket_library",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:nlohmann_json",
]

cc_test(
    name = "test_rmf_task_ros2",
    srcs = [
        "bidding/test_Evaluator.cpp",
        "bidding/test_SelfBid.cpp",
        "dispatcher/test_Dispatcher.cpp",
        "main.cpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:rmf_task_ros2_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
