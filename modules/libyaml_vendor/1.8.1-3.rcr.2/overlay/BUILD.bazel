load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

write_file(
    name = "test_chdir",
    out = "test_chdir.cc",
    content = [
        "#include <unistd.h>",
        '__attribute__((constructor)) static void chdir_to_repo() { (void)chdir("../libyaml_vendor+"); }',
    ],
)

ament_package(
    name = "ament_package",
    cmake = ["cmake/Modules/Findyaml.cmake"] + ["libyaml_vendor-extras.cmake"],
    cmake_extras = ["libyaml_vendor-extras.cmake"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@performance_test_fixture//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
