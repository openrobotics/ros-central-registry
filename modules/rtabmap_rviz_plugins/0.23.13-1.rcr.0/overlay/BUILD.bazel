load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:lz4": "@rosdistro//cc:lz4_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:protobuf": "@rosdistro//cc:protobuf_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
}

CC_DEPS = [
    "@pcl_conversions//:pcl_conversions_library",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:opencv_library",
    "@rosdistro//cc:pcl_common",
    "@rosdistro//cc:pcl_features",
    "@rosdistro//cc:pcl_filters",
    "@rosdistro//cc:pcl_io",
    "@rosdistro//cc:pcl_kdtree",
    "@rosdistro//cc:pcl_ml",
    "@rosdistro//cc:pcl_octree",
    "@rosdistro//cc:pcl_registration",
    "@rosdistro//cc:pcl_sample_consensus",
    "@rosdistro//cc:pcl_search",
    "@rosdistro//cc:pcl_segmentation",
    "@rosdistro//cc:pcl_surface",
    "@rosdistro//cc:pcl_visualization",
    "@rtabmap_conversions//:rtabmap_conversions_library",
    "@rtabmap_msgs//:cc",
    "@rules_qt//:qt_core",
    "@rules_qt//:qt_gui",
    "@rules_qt//:qt_svg",
    "@rules_qt//:qt_widgets",
    "@rviz_common//:rviz_common_library",
    "@rviz_default_plugins//:rviz_default_plugins_library",
    "@rviz_rendering//:rviz_rendering_library",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
]

cc_library(
    name = "rtabmap_rviz_plugins_library",
    srcs = [":gen_rtabmap_rviz_plugins_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/rtabmap_rviz_plugins",
    ],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "RTABMAP_ROS_BUILDING_LIBRARY",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rtabmap_rviz_plugins",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":rtabmap_rviz_plugins_library"],
)

write_file(
    name = "gen_rtabmap_rviz_plugins_stub_cpp",
    out = "_gen/rtabmap_rviz_plugins_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    libraries = [":rtabmap_rviz_plugins"],
    package_xml = "package.xml",
    plugin_category = "rviz_common",
    plugins = ["rviz_plugins.xml"],
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@pcl_conversions//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_environment//:ament_package",
        "@rtabmap_conversions//:ament_package",
        "@rtabmap_msgs//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_default_plugins//:ament_package",
        "@rviz_rendering//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [":rtabmap_rviz_plugins"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@pcl_conversions//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@ros_environment//:ament_package",
        "@rtabmap_conversions//:ament_package",
        "@rtabmap_msgs//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_default_plugins//:ament_package",
        "@rviz_rendering//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2//:ament_package",
    ],
)
