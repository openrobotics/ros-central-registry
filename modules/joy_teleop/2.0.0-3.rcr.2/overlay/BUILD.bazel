### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "incrementer_server": "joy_teleop.incrementer_server:main",
        "joy_teleop": "joy_teleop.joy_teleop:main",
    },
    data = [
        "config/joy_teleop_example.yaml",
        "launch/example.launch.py",
    ],
    executables = ["resource/joy_teleop"],
    package_xml = "package.xml",
    python = [":joy_teleop"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@control_msgs//:ament_package",
        "@example_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_py//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@teleop_tools_msgs//:ament_package",
        "@test_msgs//:ament_package",
        "@trajectory_msgs//:ament_package",
    ],
)
