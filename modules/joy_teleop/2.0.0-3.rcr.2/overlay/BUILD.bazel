load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

# Tests tagged xfail + manual: known failures under Bazel (see reasons).
_xfail_names = [
    "test_copyright",  # test assertion fails under Bazel: AssertionError...
]

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "README.md",
        "config/joy_teleop_example.yaml",
        "joy_teleop/__init__.py",
        "joy_teleop/incrementer_server.py",
        "joy_teleop/joy_teleop.py",
        "package.xml",
        "resource/joy_teleop",
        "setup.cfg",
        "setup.py",
    ],
    tags = [
        "manual",
        "xfail",
    ] if "test_{0}".format(linter) in _xfail_names else [],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
    "xmllint",
]]

py_library(
    name = "joy_teleop",
    srcs = [
        "joy_teleop/__init__.py",
        "joy_teleop/incrementer_server.py",
        "joy_teleop/joy_teleop.py",
    ],
    imports = ["."],
    deps = [
        "@control_msgs//:py",
        "@example_interfaces//:py",
        "@geometry_msgs//:py",
        "@launch_ros",
        "@launch_testing",
        "@rclpy",
        "@rosidl_runtime_py",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        "@std_srvs//:py",
        "@teleop_tools_msgs//:py",
        "@test_msgs//:py",
        "@trajectory_msgs//:py",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "config/joy_teleop_example.yaml",
        "//launch:launch_files",
    ],
    executables = ["resource/joy_teleop"],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    console_scripts = {
        "incrementer_server": "joy_teleop.incrementer_server:main",
        "joy_teleop": "joy_teleop.joy_teleop:main",
    },
    package_xml = "package.xml",
    python = [":joy_teleop"],
    deps = [":ament_index"] + [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@control_msgs//:ament_package",
        "@example_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_py//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@teleop_tools_msgs//:ament_package",
        "@test_msgs//:ament_package",
        "@trajectory_msgs//:ament_package",
    ],
)
