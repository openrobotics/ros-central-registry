package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

py_library(
    name = "joy_teleop",
    srcs = glob(["joy_teleop/**/*.py"]),
    imports = ["."],
    deps = [
        "@control_msgs//:py",
        "@example_interfaces//:py",
        "@geometry_msgs//:py",
        "@launch_ros",
        "@launch_testing",
        "@rclpy",
        "@rosidl_runtime_py",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        "@std_srvs//:py",
        "@teleop_tools_msgs//:py",
        "@test_msgs//:py",
        "@trajectory_msgs//:py",
    ],
)

