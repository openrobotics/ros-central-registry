load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

ament_index(
    name = "ament_index",
    data = [
        "datasets/README.md",
        "datasets/driving_in_office.rawlog",
        "datasets/driving_in_office_obs.rawlog",
        "maps/demo_world2.png",
        "maps/demo_world2.yaml",
        "maps/gh25_real_top_laser.simplemap",
        "maps/gh25_simulated.simplemap",
        "mvsim/demo_world2.world.xml",
        "params/mvsim_ros2_params.yaml",
        "params/pf-initial-pose-demo_world2.yaml",
        "rviz2/gridmap.rviz",
        "rviz2/rnav_demo.rviz",
        "//launch:launch_files",
    ],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@mvsim//:ament_package",
        "@rosdistro//:ament_package",
        "@teleop_twist_keyboard//:ament_package",
    ],
)
