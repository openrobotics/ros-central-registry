load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "datasets/README.md",
        "datasets/driving_in_office.rawlog",
        "datasets/driving_in_office_obs.rawlog",
        "launch/demo_astar_planner_gridmap.launch.py",
        "launch/demo_astar_trajectory_follower_gridmap.launch.py",
        "launch/demo_composable_nodes.launch.py",
        "launch/demo_localization_pf_mvsim_2d_lidar.launch.py",
        "launch/demo_map_server_from_mm.launch.py",
        "launch/demo_map_server_gridmap_from_yaml.launch.py",
        "launch/demo_pointcloud_pipeline_mvsim.launch.py",
        "launch/demo_reactive_nav_mvsim.launch.py",
        "launch/demo_ro.launch",
        "maps/demo_world2.png",
        "maps/demo_world2.yaml",
        "maps/gh25_real_top_laser.simplemap",
        "maps/gh25_simulated.simplemap",
        "mvsim/demo_world2.world.xml",
        "params/mvsim_ros2_params.yaml",
        "params/pf-initial-pose-demo_world2.yaml",
        "rviz2/gridmap.rviz",
        "rviz2/rnav_demo.rviz",
    ],
    package_xml = "package.xml",
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [":ament_index"],
    )
    for f in [
        "launch/demo_astar_planner_gridmap.launch.py",
        "launch/demo_astar_trajectory_follower_gridmap.launch.py",
        "launch/demo_composable_nodes.launch.py",
        "launch/demo_localization_pf_mvsim_2d_lidar.launch.py",
        "launch/demo_map_server_from_mm.launch.py",
        "launch/demo_map_server_gridmap_from_yaml.launch.py",
        "launch/demo_pointcloud_pipeline_mvsim.launch.py",
        "launch/demo_reactive_nav_mvsim.launch.py",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    data = [
        "datasets/README.md",
        "datasets/driving_in_office.rawlog",
        "datasets/driving_in_office_obs.rawlog",
        "launch/demo_astar_planner_gridmap.launch.py",
        "launch/demo_astar_trajectory_follower_gridmap.launch.py",
        "launch/demo_composable_nodes.launch.py",
        "launch/demo_localization_pf_mvsim_2d_lidar.launch.py",
        "launch/demo_map_server_from_mm.launch.py",
        "launch/demo_map_server_gridmap_from_yaml.launch.py",
        "launch/demo_pointcloud_pipeline_mvsim.launch.py",
        "launch/demo_reactive_nav_mvsim.launch.py",
        "launch/demo_ro.launch",
        "maps/demo_world2.png",
        "maps/demo_world2.yaml",
        "maps/gh25_real_top_laser.simplemap",
        "maps/gh25_simulated.simplemap",
        "mvsim/demo_world2.world.xml",
        "params/mvsim_ros2_params.yaml",
        "params/pf-initial-pose-demo_world2.yaml",
        "rviz2/gridmap.rviz",
        "rviz2/rnav_demo.rviz",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@mvsim//:ament_package",
