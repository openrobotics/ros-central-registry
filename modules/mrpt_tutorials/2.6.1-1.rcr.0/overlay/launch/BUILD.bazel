launch_ros_binary(
    name = "demo_map_server_from_mm_launch",
    src = "demo_map_server_from_mm.launch.py",
    data = ["//:ament_index"],
    deps = [
        "@mrpt_map_server//:launch_mrpt_map_server_launch_py",
