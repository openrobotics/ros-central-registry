    deps = [
        "@mrpt_map_server//:launch_mrpt_map_server_launch_py",
        "@mrpt_pf_localization//:launch_localization_launch_py",
        "@mrpt_pointcloud_pipeline//:launch_pointcloud_pipeline_launch_py",
        "@mvsim//:mvsim_node",
        "@rclcpp_components//:component_container",
        "@rviz2",
    ],
)

launch_ros_binary(
    name = "demo_localization_pf_mvsim_2d_lidar_launch",
    src = "demo_localization_pf_mvsim_2d_lidar.launch.py",
