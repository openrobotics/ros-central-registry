load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "demo_astar_planner_gridmap.launch.py",
        "demo_astar_trajectory_follower_gridmap.launch.py",
        "demo_composable_nodes.launch.py",
        "demo_localization_pf_mvsim_2d_lidar.launch.py",
        "demo_map_server_from_mm.launch.py",
        "demo_map_server_gridmap_from_yaml.launch.py",
        "demo_pointcloud_pipeline_mvsim.launch.py",
        "demo_reactive_nav_mvsim.launch.py",
        "demo_ro.launch",
    ],
)

# Each launch file only needs this package's share/ data; the nodes it starts
# and the launch files it includes (which carry their own packages' data) are
# deps.

launch_ros_binary(
    name = "demo_astar_planner_gridmap_launch",
    src = "demo_astar_planner_gridmap.launch.py",
    data = ["//:ament_index"],
    deps = [
        "@mrpt_map_server//:launch_mrpt_map_server_launch_py",
        "@mrpt_pf_localization//:launch_localization_launch_py",
        "@mrpt_pointcloud_pipeline//:launch_pointcloud_pipeline_launch_py",
        "@mrpt_reactivenav2d//launch:rnav_launch",
        "@mrpt_tps_astar_planner//launch:tps_astar_planner_launch",
        "@mvsim//:mvsim_node",
        "@rviz2",
    ],
)

launch_ros_binary(
    name = "demo_astar_trajectory_follower_gridmap_launch",
    src = "demo_astar_trajectory_follower_gridmap.launch.py",
    data = ["//:ament_index"],
    deps = [
        "@mrpt_map_server//:launch_mrpt_map_server_launch_py",
        "@mrpt_pf_localization//:launch_localization_launch_py",
        "@mrpt_pointcloud_pipeline//:launch_pointcloud_pipeline_launch_py",
        "@mrpt_tps_astar_planner//launch:tps_astar_planner_launch",
        "@mrpt_trajectory_follower//launch:trajectory_follower_launch",
        "@mvsim//:mvsim_node",
        "@rviz2",
    ],
)

launch_ros_binary(
    name = "demo_composable_nodes_launch",
