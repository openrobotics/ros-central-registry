cc_test(
    name = "test_load_joint_trajectory_controller",
    srcs = ["test_load_joint_trajectory_controller.cpp"] + [
        "test_assets.hpp",
        "test_trajectory_controller_utils.hpp",
    ] + [
        "//:joint_trajectory_controller_parameters_gen",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + ["test_joint_trajectory_controller_params.yaml"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        'TEST_FILES_DIRECTORY=\\"../joint_trajectory_controller+/test\\"',
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:joint_trajectory_controller_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

