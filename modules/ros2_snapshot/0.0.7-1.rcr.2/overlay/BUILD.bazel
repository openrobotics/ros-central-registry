package(default_visibility = ["//visibility:public"])

py_library(
    name = "ros2_snapshot",
    srcs = glob(["ros2_snapshot/**/*.py"]),
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@demo_nodes_py",
        "@rclpy",
        "@ros2cli",
        "@ros2component",
        "@ros2node",
        "@ros2param",
        "@ros2pkg",
        "@ros2service",
        "@std_srvs//:py",
        requirement("psutil"),
        requirement("pydantic"),
        requirement("pyyaml"),
    ],
)

