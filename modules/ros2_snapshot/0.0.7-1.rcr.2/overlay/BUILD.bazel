### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "remote": "ros2_snapshot.snapshot.snapshot_remote:main",
        "running": "ros2_snapshot.snapshot.snapshot:main",
        "workspace": "ros2_snapshot.workspace_modeler.workspace_modeler:main",
    },
    data = ["VERSION"],
    package_xml = "package.xml",
    python = [":ros2_snapshot"],
    deps = [
        "@ament_index_python//:ament_package",
        "@demo_nodes_py//:ament_package",
        "@rclpy//:ament_package",
        "@ros2cli//:ament_package",
        "@ros2component//:ament_package",
