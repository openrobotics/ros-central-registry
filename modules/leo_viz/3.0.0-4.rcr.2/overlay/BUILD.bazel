load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

ament_index(
    name = "ament_index",
    data = [
        "launch/rviz.launch.xml",
        "launch/view_model.launch.xml",
        "rviz/robot.rviz",
    ],
    package_xml = "package.xml",
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [":ament_index"],
    )
    for f in glob(["launch/**"])
]

### PACKAGING

ament_package(
    name = "ament_package",
    data = [
        "launch/rviz.launch.xml",
        "launch/view_model.launch.xml",
        "rviz/robot.rviz",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@joint_state_publisher//:ament_package",
        "@joint_state_publisher_gui//:ament_package",
        "@leo_description//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
    ],
)
