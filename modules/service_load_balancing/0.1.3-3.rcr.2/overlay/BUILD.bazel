load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

exports_files([
    "src/common.cpp",
    "src/forward_management.cpp",
    "src/message_forward_process.cpp",
    "src/service_client_proxy_manager.cpp",
    "src/service_server_proxy.cpp",
])

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "src/common.hpp",
        "src/data_queues.hpp",
        "src/forward_management.hpp",
        "src/message_forward_process.hpp",
        "src/service_client_proxy_manager.hpp",
        "src/service_server_proxy.hpp",
    ],
    includes = ["src"],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp": "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp_library",
}

CC_DEPS = [
    "@example_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@std_msgs//:cc",
    "@std_srvs//:cc",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "service_load_balancing",
    srcs = [
        "src/common.cpp",
        "src/forward_management.cpp",
        "src/main.cpp",
        "src/message_forward_process.cpp",
        "src/service_client_proxy_manager.cpp",
        "src/service_server_proxy.cpp",
    ] + [
        "src/common.hpp",
        "src/data_queues.hpp",
        "src/forward_management.hpp",
        "src/message_forward_process.hpp",
        "src/service_client_proxy_manager.hpp",
        "src/service_server_proxy.hpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["test"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

ament_index(
    name = "ament_index",
    lib_data = [":service_load_balancing"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@example_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@example_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
    ],
)
