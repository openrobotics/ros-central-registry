load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_qt//:qt.bzl", "qt_cc_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.h"])

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rosdistro//cc:OgreMain": "@rosdistro//cc:OgreMain_library",
    "@rosdistro//cc:OgreOverlay": "@rosdistro//cc:OgreOverlay_library",
    "@rviz_common//:rviz_common": "@rviz_common//:rviz_common_library",
    "@rviz_rendering//:rviz_rendering": "@rviz_rendering//:rviz_rendering_library",
}

qt_cc_library(
    name = "snow_display_library",
    srcs = ["src/snow_display.cpp"],
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = ["include"],
    local_defines = ros_local_defines() + [
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "QT_NO_KEYWORDS",
    ],
    deps = DEPENDENCIES.values() + [
        "@geometry_msgs//:cc",
        "@rules_qt//:qt_widgets",
    ],
)

cc_shared_library(
    name = "snow_display",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [
        ":snow_display_library",
        ":snow_display_library_moc",
    ],
    deps = [":snow_display_library"],
)

### AMENT INDEX

DATA = ["icons/classes/Snow.png"]

ament_index(
    name = "ament_index",
    data = DATA,
    libraries = [":snow_display"],
    package_xml = "package.xml",
    plugin_category = "rviz_common",
    plugins = ["rviz_plugins.xml"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "geometry_msgs",
        "pluginlib",
        "rviz_common",
    ],
    cmake_export_name = "export_snow_display",
    data = DATA,
    headers = HEADERS,
    include_prefix = "",
    libraries = [":snow_display"],
    package_xml = "package.xml",
    plugin_category = "rviz_common",
    plugins = ["rviz_plugins.xml"],
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@geometry_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz_common//:ament_package",
        "@rviz_rendering//:ament_package",
    ],
)
