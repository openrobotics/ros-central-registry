load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

# Tests tagged xfail + manual: known failures under Bazel (see reasons).
_xfail_names = [
    "test_flake8",  # test assertion fails under Bazel: AssertionError: a...
]

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "flexbe_states",
    srcs = [
        "flexbe_states/__init__.py",
        "flexbe_states/calculation_state.py",
        "flexbe_states/check_condition_state.py",
        "flexbe_states/decision_state.py",
        "flexbe_states/flexible_calculation_state.py",
        "flexbe_states/flexible_check_condition_state.py",
        "flexbe_states/input_state.py",
        "flexbe_states/log_key_state.py",
        "flexbe_states/log_state.py",
        "flexbe_states/operator_decision_state.py",
        "flexbe_states/publisher_bool_state.py",
        "flexbe_states/publisher_empty_state.py",
        "flexbe_states/publisher_string_state.py",
        "flexbe_states/selection_state.py",
        "flexbe_states/subscriber_state.py",
        "flexbe_states/user_data_state.py",
        "flexbe_states/wait_state.py",
    ],
    imports = ["."],
    deps = [
        "@flexbe_core",
        "@flexbe_msgs//:py",
        "@flexbe_testing",
        "@geometry_msgs//:py",
        "@rclpy",
    ],
)

ament_index(
    name = "ament_index",
    data = ["//test:_root_test_files_0"] + ["//test:_root_test_files_1"],
    package_xml = "package.xml",
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "flexbe_states/__init__.py",
        "flexbe_states/calculation_state.py",
        "flexbe_states/check_condition_state.py",
        "flexbe_states/decision_state.py",
        "flexbe_states/flexible_calculation_state.py",
        "flexbe_states/flexible_check_condition_state.py",
        "flexbe_states/input_state.py",
        "flexbe_states/log_key_state.py",
        "flexbe_states/log_state.py",
        "flexbe_states/operator_decision_state.py",
        "flexbe_states/publisher_bool_state.py",
        "flexbe_states/publisher_empty_state.py",
        "flexbe_states/publisher_string_state.py",
        "flexbe_states/selection_state.py",
        "flexbe_states/subscriber_state.py",
        "flexbe_states/user_data_state.py",
        "flexbe_states/wait_state.py",
        "package.xml",
        "resource/flexbe_states",
        "ros2-conversion-best-practices.md",
        "setup.cfg",
        "setup.py",
        "timed_twist_state_conversion.png",
    ],
    tags = [
        "manual",
        "xfail",
    ] if "test_{0}".format(linter) in _xfail_names else [],
    deps = ["@ament_{0}".format(linter)],
) for linter in ["flake8"]]

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":flexbe_states"],
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@flexbe_core//:ament_package",
        "@flexbe_msgs//:ament_package",
        "@flexbe_testing//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
