    "test_subscriber_state_regressions.py",
    "test_user_data_state_regressions.py",
    "wait_state_short.test",
])

[py_pytest(
    name = test_name,
    srcs = ["{}.py".format(test_name)],
    data = ["//:ament_index"] + [
        "bags/pose3d.bag",
        "calculation_state_none.test",
        "calculation_state_simple.test",
        "check_condition_state_invalid.test",
        "check_condition_state_true.test",
        "decision_state_simple.test",
        "flexible_calculation_state_simple.test",
        "input_state_import.test",
        "log_state_int.test",
        "log_state_msg.test",
        "log_state_string.test",
        "operator_decision_state_suggested.test",
        "pub.launch.py",
        "run_colcon_test.py",
        "run_tests.launch.py",
        "subscriber_state_pose.test",
        "subscriber_state_unavailable.test",
        "test_calculation_state_regressions.py",
        "test_condition_state_regressions.py",
        "test_flake8.py",
        "test_input_selection_state_regressions.py",
        "test_log_key_state_regressions.py",
        "test_state_docstrings.py",
        "test_subscriber_state_regressions.py",
        "test_user_data_state_regressions.py",
        "wait_state_short.test",
    ],
    imports = [
        ".",
        "..",
    ],
    deps = ["//:flexbe_states"],
) for test_name in [
    "run_colcon_test",
    "test_calculation_state_regressions",
    "test_condition_state_regressions",
    "test_input_selection_state_regressions",
    "test_log_key_state_regressions",
    "test_state_docstrings",
