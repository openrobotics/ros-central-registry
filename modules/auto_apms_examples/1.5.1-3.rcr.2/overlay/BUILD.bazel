ament_index(
    name = "ament_index",
    components = [":simple_skill_server_record"],
    data = [
        "_gen/share/auto_apms_examples/auto_apms/auto_apms_behavior_tree_core/metadata/node_manifest_example_nodes.yaml",
        "_gen/share/auto_apms_examples/auto_apms/auto_apms_behavior_tree_core/metadata/node_model_example_nodes.xml",
        ":ament_files_0",
        ":ament_files_1",
        ":ament_files_2",
        ":plugins_xml",
        "//launch:launch_files",
    ],
    lib_data = [":simple_skill_server"],
    libraries = [
        ":auto_apms_examples_example_build_handlers",
        ":auto_apms_examples_example_nodes",
    ],
    package_xml = "package.xml",
    deps = [
        ":res_auto_apms_behavior_tree_core__behavior",
        ":res_auto_apms_behavior_tree_core__node_manifest",
        ":res_auto_apms_util__pluginlib__plugins",
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@auto_apms_behavior_tree//:ament_package",
        "@auto_apms_interfaces//:ament_package",
        "@auto_apms_mission//:ament_package",
        "@auto_apms_ros2behavior//:ament_package",
        "@auto_apms_util//:ament_package",
        "@rclcpp_components//:ament_package",
    ],
)

