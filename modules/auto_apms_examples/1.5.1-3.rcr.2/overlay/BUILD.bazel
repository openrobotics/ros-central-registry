cc_library(
    name = "auto_apms_examples_example_build_handlers_library",
    srcs = ["src/simple_skill_build_handler.cpp"],
    hdrs = ["_gen/include/auto_apms_examples/auto_apms_examples/example_nodes.hpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = _INCLUDES,
    local_defines = _LOCAL_DEFINES,
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "auto_apms_examples_example_build_handlers",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    user_link_flags = ["-Wl,-z,muldefs"],
    deps = [":auto_apms_examples_example_build_handlers_library"],
)

cc_library(
    name = "auto_apms_examples_example_nodes_library",
    srcs = ["src/simple_skill_node.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = _INCLUDES,
    local_defines = _LOCAL_DEFINES,
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "auto_apms_examples_example_nodes",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    user_link_flags = ["-Wl,-z,muldefs"],
    deps = [":auto_apms_examples_example_nodes_library"],
)

collect_transitive_dynamic_deps(
    name = "nodes_transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":auto_apms_examples_example_nodes",
        "@auto_apms_behavior_tree//:auto_apms_behavior_tree_behavior_tree_nodes",
    ],
)

genrule(
    name = "gen_example_nodes_metadata",
    srcs = [
        "behavior/simple_skill_node_manifest.yaml",
        ":auto_apms_examples_example_nodes",
        ":nodes_transitive_dynamic_deps",
        "@auto_apms_behavior_tree//:auto_apms_behavior_tree_behavior_tree_nodes",
    ],
    outs = [
        "_gen/include/auto_apms_examples/auto_apms_examples/example_nodes.hpp",
        "_gen/share/auto_apms_examples/auto_apms/auto_apms_behavior_tree_core/metadata/node_manifest_example_nodes.yaml",
        "_gen/share/auto_apms_examples/auto_apms/auto_apms_behavior_tree_core/metadata/node_model_example_nodes.xml",
    ],
    cmd = """
set -e
LIB_NODES="$$(realpath $(location :auto_apms_examples_example_nodes))"
LIB_BT_NODES="$$(realpath $(location @auto_apms_behavior_tree//:auto_apms_behavior_tree_behavior_tree_nodes))"
export LD_LIBRARY_PATH="$$(for f in $(locations :nodes_transitive_dynamic_deps); do dirname $$(realpath $$f); done | sort -u | paste -sd: -):$${LD_LIBRARY_PATH:-}"
BUILD_INFOS="auto_apms_examples::SimpleSkillClient@$${LIB_NODES}@auto_apms_behavior_tree::core::NodeRegistrationTemplate<auto_apms_examples::SimpleSkillClient>;auto_apms_behavior_tree::HasParameter@$${LIB_BT_NODES}@auto_apms_behavior_tree::core::NodeRegistrationTemplate<auto_apms_behavior_tree::HasParameter>"
MANIFEST_OUT="$(location _gen/share/auto_apms_examples/auto_apms/auto_apms_behavior_tree_core/metadata/node_manifest_example_nodes.yaml)"
MODEL_OUT="$(location _gen/share/auto_apms_examples/auto_apms/auto_apms_behavior_tree_core/metadata/node_model_example_nodes.xml)"
HEADER_OUT="$(location _gen/include/auto_apms_examples/auto_apms_examples/example_nodes.hpp)"
OUT_LINES="$$($(location @auto_apms_behavior_tree//:ament_prefix_wrapper) $(location @auto_apms_behavior_tree//:create_node_manifest) $(location behavior/simple_skill_node_manifest.yaml) "$$BUILD_INFOS" auto_apms_examples "$$MANIFEST_OUT")"
LIB_PATHS="$$(printf '%s\\n' "$$OUT_LINES" | sed -n '1p')"
REG_TYPES="$$(printf '%s\\n' "$$OUT_LINES" | sed -n '2p')"
$(location @auto_apms_behavior_tree//:ament_prefix_wrapper) $(location @auto_apms_behavior_tree//:create_node_model) "$$MANIFEST_OUT" "$$LIB_PATHS" "$$REG_TYPES" "$$MODEL_OUT"
$(location @auto_apms_behavior_tree//:ament_prefix_wrapper) $(location @auto_apms_behavior_tree//:create_node_model_header) "$$MANIFEST_OUT" "$$MODEL_OUT" auto_apms_examples "$$HEADER_OUT"
""",
    tools = [
        "@auto_apms_behavior_tree//:ament_prefix_wrapper",
        "@auto_apms_behavior_tree//:create_node_manifest",
        "@auto_apms_behavior_tree//:create_node_model",
        "@auto_apms_behavior_tree//:create_node_model_header",
    ],
)

rclcpp_components_register_node(
    name = "simple_skill_server",
    component = ":auto_apms_examples_example_nodes",
    node_name = "simple_skill_server",
    plugin = "auto_apms_examples::SimpleSkillServer",
)

register_ament_resource(
    name = "res_auto_apms_behavior_tree_core__behavior",
    category = "auto_apms_behavior_tree_core__behavior",
    content = "\n".join([
        "tree|simple_skill_tree::SimpleSkillDemo|auto_apms_behavior_tree::TreeFromStringBuildHandler|share/auto_apms_examples/auto_apms/auto_apms_behavior_tree_core/behavior/tree/tree__simple_skill_tree::SimpleSkillDemo__simple_skill_tree.xml|SimpleSkillDemo|share/auto_apms_examples/auto_apms/auto_apms_behavior_tree_core/metadata/node_manifest_example_nodes.yaml",
        "tree|demo::HelloWorld|auto_apms_behavior_tree::TreeFromStringBuildHandler|share/auto_apms_examples/auto_apms/auto_apms_behavior_tree_core/behavior/tree/tree__demo::HelloWorld__demo.xml|HelloWorld|share/auto_apms_behavior_tree/auto_apms/auto_apms_behavior_tree_core/metadata/node_manifest_behavior_tree_nodes.yaml",
        "tree|demo::HelloWorldWithEntryPoint|auto_apms_behavior_tree::TreeFromStringBuildHandler|share/auto_apms_examples/auto_apms/auto_apms_behavior_tree_core/behavior/tree/tree__demo::HelloWorldWithEntryPoint__demo.xml|HelloWorldWithEntryPoint|share/auto_apms_behavior_tree/auto_apms/auto_apms_behavior_tree_core/metadata/node_manifest_behavior_tree_nodes.yaml",
    ]) + "\n",
)

register_ament_resource(
    name = "res_auto_apms_behavior_tree_core__node_manifest",
    category = "auto_apms_behavior_tree_core__node_manifest",
    content = "example_nodes|share/auto_apms_examples/auto_apms/auto_apms_behavior_tree_core/metadata/node_manifest_example_nodes.yaml|share/auto_apms_examples/auto_apms/auto_apms_behavior_tree_core/metadata/node_model_example_nodes.xml\n",
)

auto_apms_util_register_plugins(
    name = "plugins_xml",
    out = "_gen/share/auto_apms_examples/auto_apms/auto_apms_examples_plugins.xml",
    plugins = [
        "auto_apms_examples_example_nodes|auto_apms_examples::SimpleSkillClient|auto_apms_behavior_tree::core::NodeRegistrationTemplate<auto_apms_examples::SimpleSkillClient>|auto_apms_behavior_tree::core::NodeRegistrationInterface",
        "auto_apms_examples_example_build_handlers|auto_apms_examples::SimpleSkillBuildHandler|auto_apms_behavior_tree::TreeBuildHandlerFactoryTemplate<auto_apms_examples::SimpleSkillBuildHandler>|auto_apms_behavior_tree::TreeBuildHandlerFactoryInterface",
    ],
)

register_ament_resource(
    name = "res_auto_apms_util__pluginlib__plugins",
    category = "auto_apms_util__pluginlib__plugins",
    content = "share/auto_apms_examples/auto_apms/auto_apms_examples_plugins.xml\n",
)

register_ament_files(
    name = "ament_files_0",
    files = ["behavior/demo.xml"],
    prefix = "auto_apms/auto_apms_behavior_tree_core/behavior/tree",
    renames = {"behavior/demo.xml": "tree__demo::HelloWorldWithEntryPoint__demo.xml"},
)

register_ament_files(
    name = "ament_files_1",
    files = ["behavior/demo.xml"],
    prefix = "auto_apms/auto_apms_behavior_tree_core/behavior/tree",
    renames = {"behavior/demo.xml": "tree__demo::HelloWorld__demo.xml"},
)

register_ament_files(
    name = "ament_files_2",
    files = ["behavior/simple_skill_tree.xml"],
    prefix = "auto_apms/auto_apms_behavior_tree_core/behavior/tree",
    renames = {"behavior/simple_skill_tree.xml": "tree__simple_skill_tree::SimpleSkillDemo__simple_skill_tree.xml"},
