load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### ENTRYPOINTS

py_binary(
    name = "setup",
    srcs = ["setup.py"],
    visibility = ["//visibility:private"],
    deps = [
        requirement("setuptools"),
    ],
)

genrule(
    name = "entry_points",
    srcs = [
        "CHANGELOG.rst",
        "ament_uncrustify/__init__.py",
        "ament_uncrustify/configuration/ament_code_style_0_72.cfg",
        "ament_uncrustify/configuration/ament_code_style_0_78.cfg",
        "ament_uncrustify/main.py",
        "ament_uncrustify/py.typed",
        "doc/index.rst",
        "package.xml",
        "pytest.ini",
        "resource/ament_uncrustify",
        "setup.py",
        "test/cases/test.cpp",
        "test/test_ament_uncrustify.py",
        "test/test_copyright.py",
        "test/test_flake8.py",
        "test/test_pep257.py",
        "test/test_pycodestyle.py",
        "test/test_xmllint.py",
    ],
    outs = [
        "ament_uncrustify.egg-info/PKG-INFO",
        "ament_uncrustify.egg-info/entry_points.txt",
        "ament_uncrustify.egg-info/top_level.txt",
    ],
    cmd = "$(location :setup) egg_info --egg-base=. && mkdir -p $(@D)/ament_uncrustify.egg-info && cp -r ament_uncrustify.egg-info/* $(@D)/ament_uncrustify.egg-info/",
    tools = [":setup"],
    visibility = ["//visibility:private"],
)

### PYTHON MODULE

alias(
    name = "uncrustify",
    actual = "@rosdistro//cc:uncrustify",
)

# Records the runfiles location of the hermetic uncrustify binary, so main.py
# can find it without relying on a system-installed copy on PATH.
genrule(
    name = "uncrustify_rlocation",
    srcs = [":uncrustify"],
    outs = ["ament_uncrustify/uncrustify_rlocation.py"],
    cmd = "echo 'UNCRUSTIFY_RLOCATIONPATH = \"$(rlocationpath :uncrustify)\"' > $@",
    visibility = ["//visibility:private"],
)

py_library(
    name = "ament_uncrustify",
    srcs = [
        "ament_uncrustify/__init__.py",
        "ament_uncrustify/main.py",
        ":uncrustify_rlocation",
    ],
    data = [
        "ament_uncrustify/configuration/ament_code_style_0_72.cfg",
        "ament_uncrustify/configuration/ament_code_style_0_78.cfg",
    ] + [
        ":entry_points",
        ":uncrustify",
    ],
    imports = ["."],
    deps = ["@rules_python//python/runfiles"],
)

### PYTHON EXECUTABLE

py_console_script_binary(
    name = "cli",
    entry_points_txt = ":entry_points",
    pkg = ":ament_uncrustify",
    script = "ament_uncrustify",
)

### TESTS

py_pytest(
    name = "test_ament_uncrustify",
    srcs = ["test/test_ament_uncrustify.py"],
    data = [
        "CHANGELOG.rst",
        "ament_uncrustify/__init__.py",
        "ament_uncrustify/configuration/ament_code_style_0_72.cfg",
        "ament_uncrustify/configuration/ament_code_style_0_78.cfg",
        "ament_uncrustify/main.py",
        "ament_uncrustify/py.typed",
        "doc/index.rst",
        "package.xml",
        "pytest.ini",
        "resource/ament_uncrustify",
        "setup.py",
        "test/cases/test.cpp",
        "test/test_ament_uncrustify.py",
        "test/test_copyright.py",
        "test/test_flake8.py",
        "test/test_pep257.py",
        "test/test_pycodestyle.py",
        "test/test_xmllint.py",
    ],
    deps = [":ament_uncrustify"],
)

[
    py_pytest(
        name = "test_{0}".format(test_name),
        srcs = ["test/test_{0}.py".format(test_name)],
        data = [
            "CHANGELOG.rst",
            "ament_uncrustify/__init__.py",
            "ament_uncrustify/configuration/ament_code_style_0_72.cfg",
            "ament_uncrustify/configuration/ament_code_style_0_78.cfg",
            "ament_uncrustify/main.py",
            "ament_uncrustify/py.typed",
            "doc/index.rst",
            "package.xml",
            "pytest.ini",
            "resource/ament_uncrustify",
            "setup.py",
            "test/cases/test.cpp",
            "test/test_ament_uncrustify.py",
            "test/test_copyright.py",
            "test/test_flake8.py",
            "test/test_pep257.py",
            "test/test_pycodestyle.py",
            "test/test_xmllint.py",
        ],
        deps = ["@ament_{0}".format(test_name)],
    )
    for test_name in [
        "copyright",
        "flake8",
        "pep257",
        "pycodestyle",
        "xmllint",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    console_programs = {"ament_uncrustify": "ament_uncrustify.main:main"},
    package_xml = "package.xml",
    python = [":ament_uncrustify"] + [
        "ament_uncrustify/configuration/ament_code_style_0_72.cfg",
        "ament_uncrustify/configuration/ament_code_style_0_78.cfg",
        "ament_uncrustify/py.typed",
    ],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_pycodestyle//:ament_package",
        "@ament_xmllint//:ament_package",
        "@rosdistro//:ament_package",
        "@uncrustify_vendor//:ament_package",
    ],
)
