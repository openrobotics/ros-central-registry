load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

HEADERS = glob([
    "include/**/*.hpp",
    "include/**/*.h",
])

cc_library(
    name = "rttest",
    srcs = ["src/rttest.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
)

cc_shared_library(
    name = "rttest_shared",
    exports_filter = [":rttest"],
    shared_lib_name = "librttest.so",
    deps = [":rttest"],
)

cc_test(
    name = "gtest_rttest_api",
    srcs = ["test/test_api.cpp"],
    deps = [
        ":rttest",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "gtest_math_utils",
    srcs = ["test/test_math_util.cpp"],
    deps = [
        ":rttest",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_rttest",
    executables = ["scripts/rttest_plot"],
    headers = HEADERS,
    libraries = [":rttest_shared"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
