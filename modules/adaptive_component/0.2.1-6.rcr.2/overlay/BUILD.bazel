load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

HEADERS = ["include/adaptive_component.hpp"]

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

cc_library(
    name = "adaptive_component_library",
    srcs = ["src/adaptive_component.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["COMPOSITION_BUILDING_DLL"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "adaptive_component",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":adaptive_component_library"],
)

### COMPONENTS

rclcpp_components_register_nodes(
    name = "adaptive_component_nodes",
    component = ":adaptive_component",
    plugins = ["composition::AdaptiveComponent"],
)

### AMENT INDEX

ament_index(
    name = "ament_index",
    components = [":adaptive_component_nodes"],
    libraries = [":adaptive_component"],
    package_xml = "package.xml",
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    cmake_export_has_library_target = True,
    cmake_export_name = "export_adaptive_component",
    components = [":adaptive_component_nodes"],
    headers = HEADERS,
    libraries = [":adaptive_component"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
