SensorPose) override\n  {\n    sensorPose = newSensorPose;\n  }\n  void getDescriptionAsText(std::ostream& o) const override;\n\n  void getVisualizationInto(mrpt::opengl::CSetOfObjects& o) const override;\n\n};  // End of class def.\n\n}  // namespace mrpt::obs\n"],
