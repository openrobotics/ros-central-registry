load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@plansys2_domain_expert//:plansys2_domain_expert": "@plansys2_domain_expert//:plansys2_domain_expert_library",
    "@plansys2_executor//:plansys2_executor": "@plansys2_executor//:plansys2_executor_library",
    "@plansys2_lifecycle_manager//:plansys2_lifecycle_manager": "@plansys2_lifecycle_manager//:plansys2_lifecycle_manager_library",
    "@plansys2_planner//:plansys2_planner": "@plansys2_planner//:plansys2_planner_library",
    "@plansys2_problem_expert//:plansys2_problem_expert": "@plansys2_problem_expert//:plansys2_problem_expert_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@plansys2_executor//:_gen_textual_hdrs",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "plansys2_node",
    srcs = ["src/plansys2_node.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++23",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines() + [
        "BTCPP_LIBRARY_VERSION=\\\"4.10.0\\\"",
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

ament_index(
    name = "ament_index",
    data = [
        "launch/plansys2_bringup_launch_distributed.py",
        "launch/plansys2_bringup_launch_monolithic.py",
        "params/plansys2_params.yaml",
    ],
    lib_data = [":plansys2_node"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@plansys2_domain_expert//:ament_package",
        "@plansys2_executor//:ament_package",
        "@plansys2_lifecycle_manager//:ament_package",
        "@plansys2_planner//:ament_package",
        "@plansys2_problem_expert//:ament_package",
        "@rclcpp//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "plansys2_domain_expert",
        "plansys2_problem_expert",
        "plansys2_planner",
        "plansys2_executor",
        "plansys2_lifecycle_manager",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@plansys2_domain_expert//:ament_package",
        "@plansys2_executor//:ament_package",
        "@plansys2_lifecycle_manager//:ament_package",
        "@plansys2_planner//:ament_package",
        "@plansys2_problem_expert//:ament_package",
        "@rclcpp//:ament_package",
    ],
)
