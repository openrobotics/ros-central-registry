load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "plansys2_bringup_launch_distributed.py",
        "plansys2_bringup_launch_monolithic.py",
    ],
)

launch_ros_binary(
    name = "plansys2_bringup_launch_distributed_launch",
    src = "plansys2_bringup_launch_distributed.py",
    data = [
        "//:ament_index",
        "@plansys2_domain_expert//:ament_index",
        "@plansys2_domain_expert//:domain_expert_node",
        "@plansys2_executor//:ament_index",
        "@plansys2_executor//:executor_node",
        "@plansys2_lifecycle_manager//:ament_index",
        "@plansys2_lifecycle_manager//:lifecycle_manager_node",
        "@plansys2_planner//:ament_index",
        "@plansys2_planner//:planner_node",
        "@plansys2_problem_expert//:ament_index",
        "@plansys2_problem_expert//:problem_expert_node",
    ],
    deps = ["@ament_index_python"],
)

launch_ros_binary(
    name = "plansys2_bringup_launch_monolithic_launch",
    src = "plansys2_bringup_launch_monolithic.py",
    data = [
        "//:ament_index",
        "//:plansys2_node",
        "@plansys2_executor//:ament_index",
    ],
    deps = ["@ament_index_python"],
)
