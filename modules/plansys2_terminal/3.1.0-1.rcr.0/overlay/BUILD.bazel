load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@plansys2_domain_expert//:plansys2_domain_expert": "@plansys2_domain_expert//:plansys2_domain_expert_library",
    "@plansys2_executor//:plansys2_executor": "@plansys2_executor//:plansys2_executor_library",
    "@plansys2_msgs//:cc_shared": "@plansys2_msgs//:cc",
    "@plansys2_pddl_parser//:plansys2_pddl_parser": "@plansys2_pddl_parser//:plansys2_pddl_parser_library",
    "@plansys2_planner//:plansys2_planner": "@plansys2_planner//:plansys2_planner_library",
    "@plansys2_problem_expert//:plansys2_problem_expert": "@plansys2_problem_expert//:plansys2_problem_expert_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:readline": "@rosdistro//cc:readline_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@plansys2_executor//:_gen_textual_hdrs",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "terminal_library",
    srcs = ["src/plansys2_terminal/Terminal.cpp"],
    hdrs = ["include/plansys2_terminal/Terminal.hpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/plansys2_terminal",
        "test",
    ],
    local_defines = ros_local_defines() + [
        'BTCPP_LIBRARY_VERSION=\\"4.10.0\\"',
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "terminal",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":terminal_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":terminal"],
)

cc_binary(
    name = "plansys2_terminal",
    srcs = ["src/terminal_node.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/plansys2_terminal",
        "test",
    ],
    local_defines = ros_local_defines() + [
        'BTCPP_LIBRARY_VERSION=\\"4.10.0\\"',
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":terminal_library"],
)

ament_index(
    name = "ament_index",
    data = [
        "//test:pddl/commands",
        "//test:pddl/plan",
        "//test:pddl/problem_charging.pddl",
        "//test:pddl/problem_empty_domain.pddl",
        "//test:pddl/simple_example.pddl",
    ],
    data_strip_prefix = "test",
    lib_data = [":plansys2_terminal"],
    libraries = [":terminal"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@plansys2_domain_expert//:ament_package",
        "@plansys2_executor//:ament_package",
        "@plansys2_msgs//:ament_package",
        "@plansys2_pddl_parser//:ament_package",
        "@plansys2_planner//:ament_package",
        "@plansys2_problem_expert//:ament_package",
        "@rclcpp//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    libraries = [":terminal"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@plansys2_domain_expert//:ament_package",
        "@plansys2_executor//:ament_package",
        "@plansys2_msgs//:ament_package",
        "@plansys2_pddl_parser//:ament_package",
        "@plansys2_planner//:ament_package",
        "@plansys2_problem_expert//:ament_package",
        "@rclcpp//:ament_package",
    ],
)
