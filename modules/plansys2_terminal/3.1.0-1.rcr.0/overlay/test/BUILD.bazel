load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@plansys2_domain_expert//:plansys2_domain_expert": "@plansys2_domain_expert//:plansys2_domain_expert_library",
    "@plansys2_executor//:plansys2_executor": "@plansys2_executor//:plansys2_executor_library",
    "@plansys2_pddl_parser//:plansys2_pddl_parser": "@plansys2_pddl_parser//:plansys2_pddl_parser_library",
    "@plansys2_planner//:plansys2_planner": "@plansys2_planner//:plansys2_planner_library",
    "@plansys2_problem_expert//:plansys2_problem_expert": "@plansys2_problem_expert//:plansys2_problem_expert_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@plansys2_executor//:_gen_textual_hdrs",
    "@plansys2_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

exports_files([
    "CMakeLists.txt",
    "pddl/commands",
    "pddl/plan",
    "pddl/problem_charging.pddl",
    "pddl/problem_empty_domain.pddl",
    "pddl/simple_example.pddl",
    "terminal_test.cpp",
])

cc_test(
    name = "terminal_test",
    srcs = ["terminal_test.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = ["//:ament_index"] + [
        "CMakeLists.txt",
        "pddl/commands",
        "pddl/plan",
        "pddl/problem_charging.pddl",
        "pddl/problem_empty_domain.pddl",
        "pddl/simple_example.pddl",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        'BTCPP_LIBRARY_VERSION=\\"4.10.0\\"',
        "GTEST_HAS_PTHREAD=1",
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    # Shells out to the `ros2` CLI (via std::system), which is not on PATH\nin the hermetic Bazel test environment.
    tags = ["manual"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:terminal_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
