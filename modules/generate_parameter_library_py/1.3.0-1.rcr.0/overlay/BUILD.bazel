load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### ENTRYPOINTS

py_binary(
    name = "setup",
    srcs = ["setup.py"],
    visibility = ["//visibility:private"],
    deps = [
        requirement("setuptools"),
    ],
)

genrule(
    name = "entry_points",
    srcs = glob(
        ["**/**"],
        exclude = [
            "*.bazel",
            "*.bzl",
        ],
    ),
    outs = [
        "generate_parameter_library_py.egg-info/PKG-INFO",
        "generate_parameter_library_py.egg-info/entry_points.txt",
        "generate_parameter_library_py.egg-info/top_level.txt",
    ],
    cmd = "$(location :setup) egg_info --egg-base=. && mkdir -p $(@D)/generate_parameter_library_py.egg-info && cp -r generate_parameter_library_py.egg-info/* $(@D)/generate_parameter_library_py.egg-info/",
    tools = [":setup"],
    visibility = ["//visibility:private"],
)

### PYTHON MODULE

py_library(
    name = "generate_parameter_library_py",
    srcs = glob(["generate_parameter_library_py/**/*.py"]),
    data = glob(["generate_parameter_library_py/jinja_templates/**/*"]) + [":entry_points"],
    imports = ["."],
    deps = [
        requirement("setuptools"),
        requirement("typeguard"),
        requirement("jinja2"),
        requirement("pyyaml"),
    ],
)

### PYTHON EXECUTABLE

py_console_script_binary(
    name = "generate_parameter_library_cpp",
    entry_points_txt = ":entry_points",
    pkg = ":generate_parameter_library_py",
    script = "generate_parameter_library_cpp",
)

py_console_script_binary(
    name = "generate_parameter_library_python",
    entry_points_txt = ":entry_points",
    pkg = ":generate_parameter_library_py",
    script = "generate_parameter_library_python",
)

py_console_script_binary(
    name = "generate_parameter_library_markdown",
    entry_points_txt = ":entry_points",
    pkg = ":generate_parameter_library_py",
    script = "generate_parameter_library_markdown",
)

### TESTS

py_pytest(
    name = "mapped_parameter_test",
    srcs = ["generate_parameter_library_py/test/mapped_parameter_test.py"],
    data = glob(["generate_parameter_library_py/test/*.yaml"]),
    deps = [":generate_parameter_library_py"],
)

py_pytest(
    name = "test_markdown_generation",
    srcs = ["generate_parameter_library_py/test/test_markdown_generation.py"],
    data = glob(["generate_parameter_library_py/test/*.yaml"]),
    deps = [":generate_parameter_library_py"],
)

py_pytest(
    name = "test_nested_map",
    srcs = ["generate_parameter_library_py/test/test_nested_map.py"],
    data = glob(["generate_parameter_library_py/test/*.yaml"]),
    deps = [":generate_parameter_library_py"],
)

py_pytest(
    name = "YAML_parse_error_test",
    srcs = ["generate_parameter_library_py/test/YAML_parse_error_test.py"],
    data = glob(["generate_parameter_library_py/test/*.yaml"]),
    deps = [":generate_parameter_library_py"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_programs = {
        "generate_parameter_library_cpp": "generate_parameter_library_py.generate_cpp_header:main",
        "generate_parameter_library_markdown": "generate_parameter_library_py.generate_markdown:main",
        "generate_parameter_library_python": "generate_parameter_library_py.generate_python_module:main",
    },
    data = glob(
        ["generate_parameter_library_py/test/*.yaml"],
        exclude = ["generate_parameter_library_py/test/validation_only_parameters.yaml"],
    ),
    package_xml = "package.xml",
    python = [":generate_parameter_library_py"] + glob(["generate_parameter_library_py/jinja_templates/**"]),
    deps = [
        "@rosdistro//:ament_package",
    ],
)
