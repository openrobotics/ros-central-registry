load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@mrpt_libapps//:mrpt-apps_library",
    "@mrpt_libapps//:mrpt-graphslam_library",
    "@mrpt_libgui//:_gen_textual_hdrs",
    "@mrpt_libgui//:mrpt-gui_library",
    "@mrpt_libgui//:mrpt-nanogui_library",
    "@mrpt_libnav//:mrpt-kinematics_library",
    "@mrpt_libnav//:mrpt-nav_library",
    "@mrpt_libslam//:mrpt-slam_library",
    "@mrpt_libslam//:mrpt-vision_library",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "fyaml_library",
    srcs = [],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    local_defines = ros_local_defines() + [
        "HAVE_CONFIG_H",
        "NDEBUG",
        "VERSION=\\\"0.9.0\\\"",
        "_GNU_SOURCE",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

