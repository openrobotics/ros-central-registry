load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

# trmb_cc_test(NAME trimble_driver_test ... ADD_GTEST_MAIN)
cc_test(
    name = "trimble_driver_test",
    srcs = [
        "gsof_record_builder.h",
        "streaming_test.h",
        "test_byteswap.cpp",
        "test_client.cpp",
        "test_gsof.cpp",
        "test_gsof_streaming.cpp",
        "test_ros_conversions.cpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = [
        "//:gsof_client_ros_library",
        "//:ros_conversions_library",
        "//:trimble_driver_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
        "@rosdistro//cc:gtest_main",
        "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    ],
)

