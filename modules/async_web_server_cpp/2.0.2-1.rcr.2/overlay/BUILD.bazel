load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rosdistro//cc:boringssl": "@rosdistro//cc:boringssl_crypto_library",
}

CC_DEPS = [
    "@rosdistro//cc:boost.algorithm",
    "@rosdistro//cc:boost.array",
    "@rosdistro//cc:boost.asio",
    "@rosdistro//cc:boost.bind",
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.function",
    "@rosdistro//cc:boost.lexical_cast",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:boost.smart_ptr",
    "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:boringssl_ssl_library",
]

cc_library(
    name = "async_web_server_cpp_library",
    srcs = [":gen_async_web_server_cpp_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/async_web_server_cpp",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "async_web_server_cpp",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":async_web_server_cpp_library"],
)

write_file(
    name = "gen_async_web_server_cpp_stub_cpp",
    out = "_gen/async_web_server_cpp_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":async_web_server_cpp",
    ],
    package_xml = "package.xml",
    sonames = {
        "async_web_server_cpp": [
            "libasync_web_server_cpp.so.1",
            "libasync_web_server_cpp.so.2.0.2",
        ],
    },
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@launch_testing//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "async_web_server_cppTargets",
    cmake_extras = ["find_dependencies.cmake"],
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [
        ":async_web_server_cpp",
    ],
    package_xml = "package.xml",
    sonames = {
        "async_web_server_cpp": [
            "libasync_web_server_cpp.so.1",
            "libasync_web_server_cpp.so.2.0.2",
        ],
    },
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@launch_testing//:ament_package",
    ],
)
