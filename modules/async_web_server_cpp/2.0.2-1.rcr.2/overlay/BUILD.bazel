load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rosdistro//cc:boost.asio_shared": "@rosdistro//cc:boost.asio",
    "@rosdistro//cc:boost.container_shared": "@rosdistro//cc:boost.container",
    "@rosdistro//cc:boringssl": "@rosdistro//cc:boringssl_crypto_library",
}

CC_DEPS = [
    "@rosdistro//cc:boost.algorithm",
    "@rosdistro//cc:boost.array",
    "@rosdistro//cc:boost.bind",
    "@rosdistro//cc:boost.date_time",
    "@rosdistro//cc:boost.filesystem",
    "@rosdistro//cc:boost.function",
    "@rosdistro//cc:boost.lexical_cast",
    "@rosdistro//cc:boost.regex",
    "@rosdistro//cc:boost.smart_ptr",
    "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:boringssl_ssl_library",
    "@rosdistro//cc:boost.logic",
    "@rosdistro//cc:boost.foreach",
    "@rosdistro//cc:boost.system",
]

cc_library(
    name = "async_web_server_cpp_library",
    srcs = [
        "src/http_connection.cpp",
        "src/http_reply.cpp",
        "src/http_request.cpp",
        "src/http_request_handler.cpp",
        "src/http_request_parser.cpp",
        "src/http_server.cpp",
        "src/websocket_connection.cpp",
        "src/websocket_message.cpp",
        "src/websocket_request_handler.cpp",
    ],
    hdrs = [
        "include/async_web_server_cpp/http_connection.hpp",
        "include/async_web_server_cpp/http_header.hpp",
        "include/async_web_server_cpp/http_reply.hpp",
        "include/async_web_server_cpp/http_request.hpp",
        "include/async_web_server_cpp/http_request_handler.hpp",
        "include/async_web_server_cpp/http_request_parser.hpp",
        "include/async_web_server_cpp/http_server.hpp",
        "include/async_web_server_cpp/websocket_connection.hpp",
        "include/async_web_server_cpp/websocket_message.hpp",
        "include/async_web_server_cpp/websocket_request_handler.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/async_web_server_cpp",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "async_web_server_cpp",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":async_web_server_cpp_library"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":async_web_server_cpp",
    ],
    package_xml = "package.xml",
    sonames = {
        "async_web_server_cpp": [
            "libasync_web_server_cpp.so.1",
            "libasync_web_server_cpp.so.2.0.2",
        ],
    },
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@launch_testing//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "async_web_server_cppTargets",
    cmake_extras = ["find_dependencies.cmake"],
    headers = [
        "include/async_web_server_cpp/http_connection.hpp",
        "include/async_web_server_cpp/http_header.hpp",
        "include/async_web_server_cpp/http_reply.hpp",
        "include/async_web_server_cpp/http_request.hpp",
        "include/async_web_server_cpp/http_request_handler.hpp",
        "include/async_web_server_cpp/http_request_parser.hpp",
        "include/async_web_server_cpp/http_server.hpp",
        "include/async_web_server_cpp/websocket_connection.hpp",
        "include/async_web_server_cpp/websocket_message.hpp",
        "include/async_web_server_cpp/websocket_request_handler.hpp",
    ],
    include_prefix = "",
    libraries = [
        ":async_web_server_cpp",
    ],
    package_xml = "package.xml",
    sonames = {
        "async_web_server_cpp": [
            "libasync_web_server_cpp.so.1",
            "libasync_web_server_cpp.so.2.0.2",
        ],
    },
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@launch_testing//:ament_package",
    ],
)
