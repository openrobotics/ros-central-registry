load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {"@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library"}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
    "@std_msgs//:cc",
]

cc_library(
    name = "py_binding_tools_test_library",
    srcs = ["test.cpp"],
    hdrs = [],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + ["//:py_binding_tools_library"],
)

cc_shared_library(
    name = "py_binding_tools_test",
    dynamic_deps = DEPENDENCIES.keys() + ["//:py_binding_tools"],
    shared_lib_name = "py_binding_tools_test.so",
    deps = [":py_binding_tools_test_library"],
)

py_pytest(
    name = "basic",
    srcs = ["test_basic.py"],
    data = [
        ":py_binding_tools_test",
        "//:ament_index",
        "//:rclcpp",
    ],
    deps = [
        "@geometry_msgs//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)
