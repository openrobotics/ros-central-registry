load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
    "@std_msgs//:cc",
]

cc_library(
    name = "py_binding_tools_library",
    srcs = [
        "src/initializer.cpp",
        "src/ros_msg_typecasters.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/py_binding_tools",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "py_binding_tools",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["@@//:__subpackages__"],
    deps = [":py_binding_tools_library"],
)

cc_library(
    name = "py_binding_tools_test.cpython-314-x86_64-linux-gnu_library",
    srcs = ["test/test.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/py_binding_tools",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":py_binding_tools_library"],
)

cc_shared_library(
    name = "py_binding_tools_test.cpython-314-x86_64-linux-gnu",
    dynamic_deps = DEPENDENCIES.keys() + [":py_binding_tools"],
    shared_lib_name = "py_binding_tools_test.so",
    deps = [":py_binding_tools_test.cpython-314-x86_64-linux-gnu_library"],
)

cc_library(
    name = "rclcpp.cpython-314-x86_64-linux-gnu_library",
    srcs = ["src/rclcpp.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/py_binding_tools",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":py_binding_tools_library"],
)

cc_shared_library(
    name = "rclcpp.cpython-314-x86_64-linux-gnu",
    dynamic_deps = DEPENDENCIES.keys() + [":py_binding_tools"],
    shared_lib_name = "rclcpp.so",
    deps = [":rclcpp.cpython-314-x86_64-linux-gnu_library"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":py_binding_tools",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

py_pytest(
    name = "basic",
    srcs = ["test/test_basic.py"],
    data = [
        ":ament_index",
        ":py_binding_tools_test.cpython-314-x86_64-linux-gnu",
        ":rclcpp.cpython-314-x86_64-linux-gnu",
    ],
    deps = [
        "@geometry_msgs//:py",
        "@rclpy",
        "@std_msgs//:py",
    ],
)

ament_package(
    cmake = [
        "ConfigExtras.cmake",
    ],
    cmake_export_dependencies_list = [
        "rclcpp",
        "geometry_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "py_binding_toolsTargets",
    cmake_extras = ["ConfigExtras.cmake"],
    cmake_strip_prefix = "",
    egg_info = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [
        ":py_binding_tools",
    ],
    package_xml = "package.xml",
    python = [
        ":py_binding_tools_test.cpython-314-x86_64-linux-gnu",
        ":rclcpp.cpython-314-x86_64-linux-gnu",
    ],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
