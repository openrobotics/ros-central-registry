load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
]

cc_library(
    name = "py_binding_tools_library",
    srcs = [
        "src/initializer.cpp",
        "src/ros_msg_typecasters.cpp",
    ],
    hdrs = [
        "include/py_binding_tools/geometry_msg_typecasters.h",
        "include/py_binding_tools/initializer.h",
        "include/py_binding_tools/ros_msg_typecasters.h",
    ],
    includes = [
        "include",
        "include/py_binding_tools",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "py_binding_tools",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":py_binding_tools_library"],
)

cc_library(
    name = "rclcpp_library",
    srcs = ["src/rclcpp.cpp"],
    hdrs = [
        "include/py_binding_tools/geometry_msg_typecasters.h",
        "include/py_binding_tools/initializer.h",
        "include/py_binding_tools/ros_msg_typecasters.h",
    ],
    includes = [
        "include",
        "include/py_binding_tools",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":py_binding_tools_library"],
)

cc_shared_library(
    name = "rclcpp",
    dynamic_deps = DEPENDENCIES.keys() + [":py_binding_tools"],
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "rclcpp.so",
    deps = [":rclcpp_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":py_binding_tools"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@std_msgs//:ament_package",
    ],
)

ament_package(
    cmake = ["ConfigExtras.cmake"],
    cmake_export_dependencies_list = [
        "geometry_msgs",
        "rclcpp",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "py_binding_toolsTargets",
    cmake_extras = ["ConfigExtras.cmake"],
    cmake_strip_prefix = "",
    egg_info = False,
    headers = [
        "include/py_binding_tools/geometry_msg_typecasters.h",
        "include/py_binding_tools/initializer.h",
        "include/py_binding_tools/ros_msg_typecasters.h",
    ],
    include_prefix = "",
    libraries = [":py_binding_tools"],
    package_xml = "package.xml",
    python = [
        ":rclcpp",
    ],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
