load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

HEADERS = [
    "include/urdf_parser_plugin/parser.h",
    "include/urdf_parser_plugin/parser.hpp",
]

DEPENDENCIES = {
    "@urdfdom_headers//:urdfdom_headers": "@urdfdom_headers//:urdfdom_headers_library",
}

cc_library(
    name = "urdf_parser_plugin_library",
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "urdf_parser_plugin",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":urdf_parser_plugin_library"],
)

ament_index(
    name = "ament_index",
    export_name = "urdf_parser_plugin",
    libraries = [":urdf_parser_plugin"],
    package_xml = "package.xml",
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_include_directories = False,
    cmake_export_name = "urdf_parser_plugin-export",
    headers = HEADERS,
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
        "@urdfdom_headers//:ament_package",
    ],
)
