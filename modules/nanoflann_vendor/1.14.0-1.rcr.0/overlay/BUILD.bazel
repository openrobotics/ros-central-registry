load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-2-Clause"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "examples/KDTreeVectorOfVectorsAdaptor.h",
        "examples/utils.h",
        "include/nanoflann.hpp",
    ],
    includes = [
        "_gen/include",
        "include",
    ],
)

DEPENDENCIES = {
}

cc_library(
    name = "nanoflann",
    hdrs = ["include/nanoflann.hpp"],
    includes = ["include"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = ["include/nanoflann.hpp"],
    include_prefix = "",
    install_package_xml = False,
    package_xml = "package.xml",
    pkgconfig_hook = False,
    deps = [":ament_index"],
)
