load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-2-Clause",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@googletest//:gtest",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "nanoflann",
    hdrs = ["include/nanoflann.hpp"],
    includes = ["include"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

cc_test(
    name = "nanoflann_unit_tests",
    srcs = [
        "tests/test_kdtree_basic.cpp",
        "tests/test_kdtree_concurrent_build.cpp",
        "tests/test_kdtree_dynamic.cpp",
        "tests/test_kdtree_incremental.cpp",
        "tests/test_kdtree_nodes.cpp",
        "tests/test_main.cpp",
    ] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
        exclude = ["tests/gtest-1.8.0/**"],
    ),
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [":ament_index"] + glob(
        [
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = [
            "tests/gtest-1.8.0/**",
            "**/*.cpp",
            "**/*.cc",
            "**/*.c",
            "**/*.h",
            "**/*.hpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "include",
    ],
    local_defines = ros_local_defines() + ["NANOFLANN_PATH=\\\".\\\""],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    install_package_xml = False,
    package_xml = "package.xml",
    pkgconfig_hook = False,
    deps = [":ament_index"],
)
