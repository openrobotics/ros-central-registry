load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {}

CC_DEPS = [
    "@googletest//:gtest",
    "@rosdistro//cc:eigen",
]

cc_test(
    name = "nanoflann_unit_tests",
    srcs = [
        "test_kdtree_basic.cpp",
        "test_kdtree_concurrent_build.cpp",
        "test_kdtree_dynamic.cpp",
        "test_kdtree_incremental.cpp",
        "test_kdtree_nodes.cpp",
        "test_main.cpp",
    ] + [
        "gtest-1.8.0/include/gtest/gtest.h",
        "gtest-1.8.0/include/gtest/gtest-death-test.h",
        "gtest-1.8.0/include/gtest/gtest-message.h",
        "gtest-1.8.0/include/gtest/gtest-param-test.h",
        "gtest-1.8.0/include/gtest/gtest-printers.h",
        "gtest-1.8.0/include/gtest/gtest-spi.h",
        "gtest-1.8.0/include/gtest/gtest-test-part.h",
        "gtest-1.8.0/include/gtest/gtest-typed-test.h",
        "gtest-1.8.0/include/gtest/gtest_pred_impl.h",
        "gtest-1.8.0/include/gtest/gtest_prod.h",
        "gtest-1.8.0/include/gtest/internal/custom/gtest.h",
        "gtest-1.8.0/include/gtest/internal/custom/gtest-port.h",
        "gtest-1.8.0/include/gtest/internal/custom/gtest-printers.h",
        "gtest-1.8.0/include/gtest/internal/gtest-death-test-internal.h",
        "gtest-1.8.0/include/gtest/internal/gtest-filepath.h",
        "gtest-1.8.0/include/gtest/internal/gtest-internal.h",
        "gtest-1.8.0/include/gtest/internal/gtest-linked_ptr.h",
        "gtest-1.8.0/include/gtest/internal/gtest-param-util.h",
        "gtest-1.8.0/include/gtest/internal/gtest-param-util-generated.h",
        "gtest-1.8.0/include/gtest/internal/gtest-port.h",
        "gtest-1.8.0/include/gtest/internal/gtest-port-arch.h",
        "gtest-1.8.0/include/gtest/internal/gtest-string.h",
        "gtest-1.8.0/include/gtest/internal/gtest-tuple.h",
        "gtest-1.8.0/include/gtest/internal/gtest-type-util.h",
        "gtest-1.8.0/src/gtest-internal-inl.h",
        "test_helpers.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = ["//:ament_index"] + [
        "CMakeLists.txt",
        "gtest-1.8.0/CMakeLists.txt",
        "gtest-1.8.0/CONTRIBUTORS",
        "gtest-1.8.0/README.md",
        "gtest-1.8.0/include/gtest/gtest-param-test.h.pump",
        "gtest-1.8.0/include/gtest/internal/gtest-param-util-generated.h.pump",
        "gtest-1.8.0/include/gtest/internal/gtest-tuple.h.pump",
        "gtest-1.8.0/include/gtest/internal/gtest-type-util.h.pump",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines() + ['NANOFLANN_PATH=\\".\\"'],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "@rosdistro//cc:bazel_test_helper",
