load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:ament_resource.bzl", "register_ament_resource")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rosidlcpp_generator_core//:rosidlcpp_generator_core": "@rosidlcpp_generator_core//:rosidlcpp_generator_core_library",
    "@rosidlcpp_parser//:rosidlcpp_parser": "@rosidlcpp_parser//:rosidlcpp_parser_library",
}

CC_DEPS = [
    "@rosdistro//cc:fmt",
    "@rosdistro//cc:nlohmann_json",
]

cc_library(
    name = "rosidlcpp_typesupport_fastrtps_cpp_library",
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++23",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/rosidlcpp_typesupport_fastrtps_cpp",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "rosidlcpp_typesupport_fastrtps_cpp",
    srcs = [":gen_rosidlcpp_typesupport_fastrtps_cpp_stub_cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++23",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/rosidlcpp_typesupport_fastrtps_cpp",
    ],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

register_ament_resource(
    name = "res_rosidl_generator_packages",
    category = "rosidl_generator_packages",
    content = "",
)

write_file(
    name = "gen_rosidlcpp_typesupport_fastrtps_cpp_stub_cpp",
    out = "_gen/rosidlcpp_typesupport_fastrtps_cpp_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

write_file(
    name = "gen_extra_0",
    out = "_gen/share/ament_index/resource_index/rosidl_generator_packages/rosidlcpp_typesupport_fastrtps_cpp",
    content = [""],
)

write_file(
    name = "gen_cmake_1",
    out = "_gen/share/rosidlcpp_typesupport_fastrtps_cpp/cmake/rosidlcpp_typesupport_fastrtps_cpp-extras.cmake",
    content = ["# generated from\n# rosidl_typesupport_fastrtps_cpp/\n#   rosidl_typesupport_fastrtps_cpp-extras.cmake.in\n\nfind_package(fastcdr 2 REQUIRED CONFIG)\n\nif(NOT fastcdr_FOUND)\n  message(STATUS\n    \"Could not find eProsima Fast CDR - skip rosidl_typesupport_fastrtps_cpp\"\n  )\nelse()\n  find_package(ament_cmake_core QUIET REQUIRED)\n\n  if(NOT USE_ROSIDL_GENERATORS)\n\n    # This generator generates code dependent on code generated by rosidl_generator_cpp\n    # Find it first so it registers it's extensions first\n    find_package(rosidl_generator_cpp REQUIRED)\n\n    # Replace rosidl_typesupport_fastrtps_cpp with rosidlcpp_typesupport_fastrtps_cpp\n    find_package(rosidl_typesupport_fastrtps_cpp QUIET)  # Needs to be loaded for its generator can be replace\n    list(\n      TRANSFORM AMENT_EXTENSIONS_rosidl_generate_idl_interfaces\n      REPLACE \"rosidl_typesupport_fastrtps_cpp:rosidl_typesupport_fastrtps_cpp_generate_interfaces.cmake\"\n      \"rosidlcpp_typesupport_fastrtps_cpp:rosidlcpp_typesupport_fastrtps_cpp_generate_interfaces.cmake\"\n    )\n\n\n    set(rosidlcpp_typesupport_fastrtps_cpp_BIN \"${rosidlcpp_typesupport_fastrtps_cpp_DIR}/../../../lib/rosidlcpp_typesupport_fastrtps_cpp/rosidlcpp_typesupport_fastrtps_cpp\")\n    normalize_path(rosidlcpp_typesupport_fastrtps_cpp_BIN \"${rosidlcpp_typesupport_fastrtps_cpp_BIN}\")\n\n    set(rosidlcpp_typesupport_fastrtps_cpp_TEMPLATE_DIR \"${rosidlcpp_typesupport_fastrtps_cpp_DIR}/../resource\")\n    normalize_path(rosidlcpp_typesupport_fastrtps_cpp_TEMPLATE_DIR \"${rosidlcpp_typesupport_fastrtps_cpp_TEMPLATE_DIR}\")\n  \n  endif()\nendif()\n"],
)

pkg_files(
    name = "pkg_files_extra_0",
    srcs = [":gen_extra_0"],
    prefix = "share/ament_index/resource_index/rosidl_generator_packages",
)

pkg_files(
    name = "pkg_files_cmake_1",
    srcs = [":gen_cmake_1"],
    prefix = "share/rosidlcpp_typesupport_fastrtps_cpp/cmake",
)

ament_index(
    name = "ament_index",
    data = [
        "resource/idl__rosidl_typesupport_fastrtps_cpp.hpp.template",
        "resource/idl__type_support.cpp.template",
        "resource/msg__rosidl_typesupport_fastrtps_cpp.hpp.template",
        "resource/msg__type_support.cpp.template",
        "resource/rosidl_typesupport_fastrtps_cpp__visibility_control.h.in",
        "resource/srv__rosidl_typesupport_fastrtps_cpp.hpp.template",
        "resource/srv__type_support.cpp.template",
    ],
    lib_data = [":rosidlcpp_typesupport_fastrtps_cpp"],
    package_xml = "package.xml",
    deps = [
        ":res_rosidl_generator_packages",
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@rmw//:ament_package",
        "@rosidl_generator_c//:ament_package",
        "@rosidl_generator_cpp//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
        "@rosidl_typesupport_interface//:ament_package",
        "@rosidlcpp_generator_core//:ament_package",
        "@rosidlcpp_parser//:ament_package",
    ],
)

ament_package(
    cmake = ["cmake/rosidlcpp_typesupport_fastrtps_cpp_generate_interfaces.cmake"],
    cmake_export_dependencies_list = [
        "rmw",
        "rosidl_runtime_c",
        "fastcdr",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    cmake_extras = ["rosidlcpp_typesupport_fastrtps_cpp-extras.cmake"],
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    install = [
        ":pkg_files_extra_0",
        ":pkg_files_cmake_1",
    ],
    package_xml = "package.xml",
    programs = [":rosidlcpp_typesupport_fastrtps_cpp"],
    deps = [":ament_index"] + [
        ":res_rosidl_generator_packages",
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@rmw//:ament_package",
        "@rosidl_generator_c//:ament_package",
        "@rosidl_generator_cpp//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
        "@rosidl_typesupport_interface//:ament_package",
        "@rosidlcpp_generator_core//:ament_package",
        "@rosidlcpp_parser//:ament_package",
    ],
)
