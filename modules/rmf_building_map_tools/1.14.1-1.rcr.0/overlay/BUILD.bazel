# Build-time tool used by map packages (rmf_demos_maps, ...) to turn
# *.building.yaml into Gazebo worlds / nav graphs, mirroring their CMake
# `ros2 run rmf_building_map_tools building_map_generator ...` custom targets.
py_binary(
    name = "building_map_generator_tool",
    srcs = ["bazel_building_map_generator.py"],
    data = ["building_map/templates/gz_world.sdf"] + TEXTURES,
    main = "bazel_building_map_generator.py",
    deps = [":rmf_building_map_tools"],
)

py_binary(
    name = "lib/building_map_server",
    srcs = ["building_map_server/building_map_server.py"],
    data = [":ament_index"],
    main = "building_map_server/building_map_server.py",
    deps = [":rmf_building_map_tools"],
)

alias(
    name = "building_map_server",
    actual = ":lib/building_map_server",
)

ament_index(
    name = "ament_index",
    data = ["building_map/templates/gz_world.sdf"] + TEXTURES,
    package_xml = "package.xml",
)

exports_files(TEXTURES)

ament_package(
    name = "ament_package",
    console_scripts = {
        "building_crowdsim": "building_crowdsim.building_crowdsim:main",
        "building_map_converter": "building_map_converter.building_map_converter:main",
        "building_map_generator": "building_map_generator.building_map_generator:main",
        "building_map_model_downloader": "building_map_model_downloader.building_map_model_downloader:main",
        "building_map_server": "building_map_server.building_map_server:main",
    },
    package_xml = "package.xml",
    python = [":rmf_building_map_tools"],
    setup_cfg = "setup.cfg",
    deps = [
        ":ament_index",
        "@ament_index_python//:ament_package",
        "@gz_fuel_tools_vendor//:ament_package",
        "@rclpy//:ament_package",
        "@rmf_building_map_msgs//:ament_package",
        "@rmf_site_map_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
