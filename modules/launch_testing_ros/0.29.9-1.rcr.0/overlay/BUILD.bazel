load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

exports_files(["defs.bzl"])

py_library(
    name = "launch_testing_ros",
    srcs = [
        "launch_testing_ros/__init__.py",
        "launch_testing_ros/actions/__init__.py",
        "launch_testing_ros/actions/enable_rmw_isolation.py",
        "launch_testing_ros/data_republisher.py",
        "launch_testing_ros/message_pump.py",
        "launch_testing_ros/pytest/__init__.py",
        "launch_testing_ros/pytest/hooks.py",
        "launch_testing_ros/test_runner.py",
        "launch_testing_ros/tools/__init__.py",
        "launch_testing_ros/tools/output.py",
        "launch_testing_ros/wait_for_topics.py",
    ] + ["launch_testing_ros_pytest_entrypoint.py"],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@launch_ros",
        "@launch_testing",
        "@rclpy",
        requirement("pytest"),
    ],
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "README.md",
        "defs.bzl",
        "launch_testing_ros/__init__.py",
        "launch_testing_ros/actions/__init__.py",
        "launch_testing_ros/actions/enable_rmw_isolation.py",
        "launch_testing_ros/data_republisher.py",
        "launch_testing_ros/message_pump.py",
        "launch_testing_ros/pytest/__init__.py",
        "launch_testing_ros/pytest/hooks.py",
        "launch_testing_ros/test_runner.py",
        "launch_testing_ros/tools/__init__.py",
        "launch_testing_ros/tools/output.py",
        "launch_testing_ros/wait_for_topics.py",
        "launch_testing_ros_pytest_entrypoint.py",
        "package.xml",
        "pytest.ini",
        "resource/launch_testing_ros",
        "setup.cfg",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in [
    "copyright",
    "flake8",
    "pep257",
    "xmllint",
]]

ament_package(
    name = "ament_package",
    data = ["//test:_root_test_files_0"],
    data_strip_prefix = "test",
    package_xml = "package.xml",
    python = [":launch_testing_ros"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@rclpy//:ament_package",
        "@rmw_test_fixture_implementation//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
