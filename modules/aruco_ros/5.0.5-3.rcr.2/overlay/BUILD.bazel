load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@aruco//:aruco": "@aruco//:aruco_library",
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

MSG_DEPENDENCIES = [
    "@aruco_msgs//:cc",
    "@geometry_msgs//:cc",
    "@sensor_msgs//:cc",
    "@visualization_msgs//:cc",
]

cc_library(
    name = "aruco_ros_utils_library",
    srcs = ["src/aruco_ros_utils.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + MSG_DEPENDENCIES,
)

cc_shared_library(
    name = "aruco_ros_utils",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":aruco_ros_utils_library"],
    deps = [":aruco_ros_utils_library"],
)

### EXECUTABLES

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "single",
    srcs = [
        "src/aruco_ros_utils.cpp",
        "src/simple_single.cpp",
    ] + HEADERS,
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + MSG_DEPENDENCIES,
)

cc_binary(
    name = "double",
    srcs = [
        "src/aruco_ros_utils.cpp",
        "src/simple_double.cpp",
    ] + HEADERS,
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + MSG_DEPENDENCIES,
)

cc_binary(
    name = "marker_publisher",
    srcs = [
        "src/aruco_ros_utils.cpp",
        "src/marker_publish.cpp",
    ] + HEADERS,
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + MSG_DEPENDENCIES,
)

### AMENT INDEX

DATA = glob([
    "etc/**",
    "launch/**",
])

EXECUTABLES = [
    ":double",
    ":marker_publisher",
    ":single",
]

ament_index(
    name = "ament_index",
    data = DATA,
    executables = EXECUTABLES,
    libraries = [":aruco_ros_utils"],
    package_xml = "package.xml",
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [":ament_index"],
    )
    for f in glob(["launch/**"])
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    data = DATA,
    executables = EXECUTABLES,
    libraries = [":aruco_ros_utils"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@aruco//:ament_package",
        "@aruco_msgs//:ament_package",
        "@cv_bridge//:ament_package",
        "@geometry_msgs//:ament_package",
        "@image_transport//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
