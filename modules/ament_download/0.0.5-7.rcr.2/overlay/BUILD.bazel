load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

write_file(
    name = "gen_ament_download_dependencies_extras",
    out = "_meta/share/ament_download/cmake/ament_download_dependencies-extras.cmake",
    content = [
        "find_package(ament_cmake_core QUIET REQUIRED)",
        "find_package(ament_cmake_include_directories QUIET REQUIRED)",
        "find_package(ament_cmake_libraries QUIET REQUIRED)",
        "",
        "include(\"${ament_download_DIR}/ament_download.cmake\")",
        "",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake = [
        "cmake/ament_download.cmake",
        ":gen_ament_download_dependencies_extras",
        "src/download_checkmd5.py",
    ],
    cmake_export_dependencies_list = ["ament_cmake"],
    cmake_extras = ["ament_download_dependencies-extras.cmake"],
    cmake_strip_prefix = "src",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
