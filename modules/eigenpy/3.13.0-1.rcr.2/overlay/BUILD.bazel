    name = "gen_extra_3",
    out = "_gen/include/eigenpy/config.hpp",
    content = ["/*\n * This file has been automatically generated by the jrl-cmakemodules.\n * Please see https://github.com/jrl-umi3218/jrl-cmakemodules/blob/master/config.hh.cmake for details.\n*/\n\n#ifndef EIGENPY_CONFIG_HH\n# define EIGENPY_CONFIG_HH\n\n// Package version (header).\n# define EIGENPY_VERSION_UNKNOWN_TAG 0 // Used to mention that the current version is unknown.\n# define EIGENPY_VERSION \"3.13.0\"\n# define EIGENPY_MAJOR_VERSION 3\n# define EIGENPY_MINOR_VERSION 13\n# define EIGENPY_PATCH_VERSION 0\n\n#define EIGENPY_VERSION_AT_LEAST(major, minor, patch) (EIGENPY_MAJOR_VERSION>major || (EIGENPY_MAJOR_VERSION>=major && \\\n                                                             (EIGENPY_MINOR_VERSION>minor || (EIGENPY_MINOR_VERSION>=minor && \\\n                                                                                                     EIGENPY_PATCH_VERSION>=patch))))\n\n#define EIGENPY_VERSION_AT_MOST(major, minor, patch) (EIGENPY_MAJOR_VERSION<major || (EIGENPY_MAJOR_VERSION<=major && \\\n                                                            (EIGENPY_MINOR_VERSION<minor || (EIGENPY_MINOR_VERSION<=minor && \\\n                                                                                                     EIGENPY_PATCH_VERSION<=patch))))\n\n// Handle portable symbol export.\n// Defining manually which symbol should be exported is required\n// under Windows whether MinGW or MSVC is used.\n//\n// The headers then have to be able to work in two different modes:\n// - dllexport when one is building the library,\n// - dllimport for clients using the library.\n//\n// On Linux, set the visibility accordingly. If C++ symbol visibility\n// is handled by the compiler, see: http://gcc.gnu.org/wiki/Visibility\n//\n// Explicit template instantiation on Windows need to add\n// dllexport on the definition and dllimport on the declaration.\n// The XXX_EXPLICIT_INSTANTIATION_DECLARATION_DLLAPI macro\n// should be set on the declaration while\n// the XXX_EXPLICIT_INSTANTIATION_DEFINITION_DLLAPI macro\n// should be set on the definition.\n# if defined _WIN32 || defined __CYGWIN__\n// On Microsoft Windows, use dllimport and dllexport to tag symbols.\n#  define EIGENPY_DLLIMPORT __declspec(dllimport)\n#  define EIGENPY_DLLEXPORT __declspec(dllexport)\n#  define EIGENPY_DLLLOCAL\n#  define EIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT __declspec(dllimport)\n#  define EIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT\n#  define EIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT __declspec(dllimport)\n#  define EIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT __declspec(dllexport)\n# else\n// On Linux, for GCC >= 4, tag symbols using GCC extension.\n#  if __GNUC__ >= 4\n#   define EIGENPY_DLLIMPORT __attribute__ ((visibility(\"default\")))\n#   define EIGENPY_DLLEXPORT __attribute__ ((visibility(\"default\")))\n#   define EIGENPY_DLLLOCAL  __attribute__ ((visibility(\"hidden\")))\n#   define EIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT __attribute__ ((visibility(\"default\")))\n#   define EIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT __attribute__ ((visibility(\"default\")))\n#   define EIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT\n#   define EIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT\n#  else\n// Otherwise (GCC < 4 or another compiler is used), export everything.\n#   define EIGENPY_DLLIMPORT\n#   define EIGENPY_DLLEXPORT\n#   define EIGENPY_DLLLOCAL\n#   define EIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT\n#   define EIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT\n#   define EIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT\n#   define EIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT\n#  endif // __GNUC__ >= 4\n# endif // defined _WIN32 || defined __CYGWIN__\n\n# ifdef EIGENPY_STATIC\n// If one is using the library statically, get rid of\n// extra information and use standard explicit template\n// instantiation keyword.\n#  define EIGENPY_DLLAPI\n#  define EIGENPY_LOCAL\n#  define EIGENPY_EXPLICIT_INSTANTIATION_DECLARATION extern template\n# else\n// Depending on whether one is building or using the\n// library define DLLAPI to import or export and\n// define the right explicit template instantiation keyword.\n#  ifdef eigenpy_EXPORTS\n#   define EIGENPY_DLLAPI EIGENPY_DLLEXPORT\n#   define EIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLAPI EIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT\n#   define EIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLAPI EIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT\n#  else\n#   define EIGENPY_DLLAPI EIGENPY_DLLIMPORT\n#   define EIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLAPI EIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT\n#   define EIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLAPI EIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT\n#  endif // EIGENPY_EXPORTS\n#  define EIGENPY_LOCAL EIGENPY_DLLLOCAL\n# endif // EIGENPY_STATIC\n#endif //! EIGENPY_CONFIG_HH\n"],
