load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

cc_library(
    name = "rcss3d_agent_msgs_to_soccer_interfaces_library",
    srcs = [
        "src/conversion.cpp",
        "src/deg2rad.hpp",
        "src/polar_to_point.hpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    deps = [
        "@rcss3d_agent_msgs//:cc",
        "@soccer_vision_3d_msgs//:cc",
    ],
)

cc_shared_library(
    name = "rcss3d_agent_msgs_to_soccer_interfaces",
    exports_filter = [":rcss3d_agent_msgs_to_soccer_interfaces_library"],
    deps = [":rcss3d_agent_msgs_to_soccer_interfaces_library"],
)

### TESTS

[
    cc_test(
        name = test,
        srcs = ["test/{}.cpp".format(test)],
        dynamic_deps = [":rcss3d_agent_msgs_to_soccer_interfaces"],
        includes = ["src"],
        deps = [
            ":rcss3d_agent_msgs_to_soccer_interfaces_library",
            "@rosdistro//cc:googletest",
        ],
    )
    for test in [
        "test_conversion",
        "test_polar_to_point",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rcss3d_agent_msgs",
        "soccer_vision_3d_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_rcss3d_agent_msgs_to_soccer_interfaces",
    headers = HEADERS,
    include_prefix = "",
    libraries = [":rcss3d_agent_msgs_to_soccer_interfaces"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rcss3d_agent_msgs//:ament_package",
        "@rosdistro//:ament_package",
        "@soccer_vision_3d_msgs//:ament_package",
    ],
)
