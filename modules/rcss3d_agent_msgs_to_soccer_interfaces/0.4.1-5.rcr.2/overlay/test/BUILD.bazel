load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

[cc_test(
    name = test.removesuffix(".py"),
    srcs = ["{}.cpp".format(test)],
    dynamic_deps = ["//:rcss3d_agent_msgs_to_soccer_interfaces"],
    deps = [
        "//:_test_root_headers",
        "//:rcss3d_agent_msgs_to_soccer_interfaces_library",
        "@rosdistro//cc:googletest",
    ],
) for test in [
    "test_conversion",
    "test_polar_to_point",
]]
