load("@rosidl_default_generators//:defs.bzl", "ros_service")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

exports_files([
    "CheckPath.srv",
    "CheckPoint.srv",
    "CheckPose.srv",
    "FindValidPose.srv",
    "SetTestRobotState.srv",
])

ros_service(
    name = "CheckPath",
    src = "CheckPath.srv",
    deps = [
        "@nav_msgs//msg:Path",
    ],
)

ros_service(
    name = "CheckPoint",
    src = "CheckPoint.srv",
    deps = [
        "@geometry_msgs//msg:PointStamped",
    ],
)

ros_service(
    name = "CheckPose",
    src = "CheckPose.srv",
    deps = [
        "@geometry_msgs//msg:PoseStamped",
    ],
)

ros_service(
    name = "FindValidPose",
    src = "FindValidPose.srv",
    deps = [
        "@geometry_msgs//msg:PoseStamped",
    ],
)

ros_service(
    name = "SetTestRobotState",
    src = "SetTestRobotState.srv",
    deps = [
        "@geometry_msgs//msg:TransformStamped",
        "@geometry_msgs//msg:TwistStamped",
    ],
)
