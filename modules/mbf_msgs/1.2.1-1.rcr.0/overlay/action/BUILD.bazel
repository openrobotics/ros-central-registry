load("@rosidl_default_generators//:defs.bzl", "ros_action")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

exports_files(glob(["*.action"]))

ros_action(
    name = "ExePath",
    src = "ExePath.action",
    deps = [
        "@geometry_msgs//msg:PoseStamped",
        "@geometry_msgs//msg:TwistStamped",
        "@nav_msgs//msg:Path",
    ],
)

ros_action(
    name = "GetPath",
    src = "GetPath.action",
    deps = [
        "@geometry_msgs//msg:PoseStamped",
        "@nav_msgs//msg:Path",
    ],
)

ros_action(
    name = "MoveBase",
    src = "MoveBase.action",
    deps = [
        "@geometry_msgs//msg:PoseStamped",
        "@geometry_msgs//msg:TwistStamped",
    ],
)

ros_action(
    name = "Recovery",
    src = "Recovery.action",
)

ros_action(
    name = "RefinePath",
    src = "RefinePath.action",
    deps = [
        "@nav_msgs//msg:Path",
    ],
)
