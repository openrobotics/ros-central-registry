load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@diagnostic_msgs//:cc_shared": "@diagnostic_msgs//:cc",
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@mrpt_msgs//:cc_shared": "@mrpt_msgs//:cc",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@mrpt_hwdrivers//:mrpt_hwdrivers_library",
    "@mrpt_libros_bridge//:mrpt_libros_bridge_library",
]

cc_library(
    name = "mrpt_sensorlib_library",
    srcs = ["src/mrpt_sensorlib.cpp"],
    hdrs = ["include/mrpt_sensorlib/mrpt_sensorlib.h"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/mrpt_sensorlib",
        "src",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_sensorlib",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mrpt_sensorlib_library"],
)

ament_index(
    name = "ament_index",
    lib_data = [
        ":mrpt_sensorlib",
    ],
    libraries = [
        ":mrpt_sensorlib",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mrpt_hwdrivers//:ament_package",
        "@mrpt_libros_bridge//:ament_package",
        "@mrpt_msgs//:ament_package",
        "@rclcpp_components//:ament_package",
        "@ros_environment//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = ["diagnostic_updater"],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    headers = ["include/mrpt_sensorlib/mrpt_sensorlib.h"],
    include_prefix = "",
    libraries = [
        ":mrpt_sensorlib",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mrpt_hwdrivers//:ament_package",
        "@mrpt_libros_bridge//:ament_package",
        "@mrpt_msgs//:ament_package",
        "@rclcpp_components//:ament_package",
        "@ros_environment//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
