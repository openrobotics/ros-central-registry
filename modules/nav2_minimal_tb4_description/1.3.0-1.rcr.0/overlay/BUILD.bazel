load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

write_file(
    name = "meta_share_nav2_minimal_tb4_description_environment_tb4_description_dsv",
    out = "_meta/share/nav2_minimal_tb4_description/environment/tb4_description.dsv",
    content = ["prepend-non-duplicate;GZ_SIM_RESOURCE_PATH;share/"],
)

ament_index(
    name = "ament_index",
    data = [
        ":meta_share_nav2_minimal_tb4_description_environment_tb4_description_dsv",
    ] + glob([
        "launch/**",
        "meshes/**",
        "rviz/**",
        "urdf/**",
    ]),
    package_xml = "package.xml",
)

launch_ros_binary(
    name = "robot_description.launch.py",
    src = "launch/robot_description.launch.py",
    data = [":ament_index"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    data = glob([
        "launch/**",
        "meshes/**",
        "rviz/**",
        "urdf/**",
    ]),
    env_hooks = ["environment/tb4_description.dsv"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@joint_state_publisher//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@urdf//:ament_package",
        "@xacro//:ament_package",
    ],
)
