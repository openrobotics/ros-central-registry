load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

write_file(
    name = "meta_share_nav2_minimal_tb4_description_environment_tb4_description_dsv",
    out = "_meta/share/nav2_minimal_tb4_description/environment/tb4_description.dsv",
    content = ["prepend-non-duplicate;GZ_SIM_RESOURCE_PATH;share/"],
)

ament_index(
    name = "ament_index",
    data = [":meta_share_nav2_minimal_tb4_description_environment_tb4_description_dsv"] + ([
        "meshes/body_visual.dae",
        "meshes/bumper_collision.dae",
        "meshes/bumper_visual.dae",
        "meshes/camera_bracket.dae",
        "meshes/oakd_pro.dae",
        "meshes/rplidar.dae",
        "meshes/shell.dae",
        "meshes/shell_collision.dae",
        "meshes/tower.dae",
        "meshes/tower_sensor_plate.dae",
        "meshes/tower_standoff.dae",
        "meshes/weight_block.dae",
        "rviz/config.rviz",
        "urdf/icreate/bumper.urdf.xacro",
        "urdf/icreate/caster.urdf.xacro",
        "urdf/icreate/common_properties.urdf.xacro",
        "urdf/icreate/create3.urdf.xacro",
        "urdf/icreate/sensors/imu.urdf.xacro",
        "urdf/icreate/wheel.urdf.xacro",
        "urdf/sensors/camera_bracket.urdf.xacro",
        "urdf/sensors/oakd.urdf.xacro",
        "urdf/sensors/rplidar.urdf.xacro",
        "urdf/standard/tower_sensor_plate.urdf.xacro",
        "urdf/standard/tower_standoff.urdf.xacro",
        "urdf/standard/turtlebot4.urdf.xacro",
        "urdf/standard/weight_block.urdf.xacro",
    ] + ["//launch:launch_files"]),
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    data = [
        "meshes/body_visual.dae",
        "meshes/bumper_collision.dae",
        "meshes/bumper_visual.dae",
        "meshes/camera_bracket.dae",
        "meshes/oakd_pro.dae",
        "meshes/rplidar.dae",
        "meshes/shell.dae",
        "meshes/shell_collision.dae",
        "meshes/tower.dae",
        "meshes/tower_sensor_plate.dae",
        "meshes/tower_standoff.dae",
        "meshes/weight_block.dae",
        "rviz/config.rviz",
        "urdf/icreate/bumper.urdf.xacro",
        "urdf/icreate/caster.urdf.xacro",
        "urdf/icreate/common_properties.urdf.xacro",
        "urdf/icreate/create3.urdf.xacro",
        "urdf/icreate/sensors/imu.urdf.xacro",
        "urdf/icreate/wheel.urdf.xacro",
        "urdf/sensors/camera_bracket.urdf.xacro",
        "urdf/sensors/oakd.urdf.xacro",
