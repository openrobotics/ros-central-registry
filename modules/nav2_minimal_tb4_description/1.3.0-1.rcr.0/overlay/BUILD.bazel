load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

write_file(
    name = "meta_share_nav2_minimal_tb4_description_environment_tb4_description_dsv",
    out = "_meta/share/nav2_minimal_tb4_description/environment/tb4_description.dsv",
    content = ["prepend-non-duplicate;GZ_SIM_RESOURCE_PATH;share/"],
)

pkg_files(
    name = "meta_files",
    srcs = [":meta_share_nav2_minimal_tb4_description_environment_tb4_description_dsv"],
    strip_prefix = strip_prefix.from_pkg("_meta"),
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    data = glob([
        "launch/**",
        "meshes/**",
        "rviz/**",
        "urdf/**",
    ]),
    env_hooks = ["environment/tb4_description.dsv"],
    install = [":meta_files"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@joint_state_publisher//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@urdf//:ament_package",
        "@xacro//:ament_package",
    ],
)
