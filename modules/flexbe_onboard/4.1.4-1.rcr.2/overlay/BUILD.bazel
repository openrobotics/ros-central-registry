load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "flexbe_onboard",
    srcs = [
        "flexbe_onboard/__init__.py",
        "flexbe_onboard/flexbe_onboard.py",
        "flexbe_onboard/start_behavior.py",
    ],
    imports = ["."],
    deps = [
        "@flexbe_core",
        "@flexbe_msgs//:py",
        "@flexbe_states",
        "@launch_ros",
        "@rclpy",
    ],
)

ament_index(
    name = "ament_index",
    data = ["//launch:launch_files"] + ["//test:_root_test_files_0"],
    package_xml = "package.xml",
)

[py_pytest(
    name = "test_{0}".format(linter),
    srcs = ["//test:test_{0}.py".format(linter)],
    data = [
        "CHANGELOG.rst",
        "flexbe_onboard/__init__.py",
        "flexbe_onboard/flexbe_onboard.py",
        "flexbe_onboard/start_behavior.py",
        "package.xml",
        "resource/flexbe_onboard",
        "setup.cfg",
        "setup.py",
    ],
    deps = ["@ament_{0}".format(linter)],
) for linter in ["flake8"]]

ament_package(
    name = "ament_package",
    console_scripts = {"start_behavior": "flexbe_onboard.start_behavior:main"},
    package_xml = "package.xml",
    python = [":flexbe_onboard"],
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@flexbe_core//:ament_package",
        "@flexbe_msgs//:ament_package",
        "@flexbe_states//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
