load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

py_library(
    name = "flexbe_onboard",
    srcs = glob(["flexbe_onboard/**/*.py"]),
    imports = ["."],
    deps = [
        "@flexbe_core",
        "@flexbe_msgs//:py",
        "@flexbe_states",
        "@launch_ros",
        "@rclpy",
    ],
)

ament_index(
    name = "ament_index",
    data = glob([
        "test/flexbe_onboard_test_data/*.py",
        "test/flexbe_onboard_test_data/*.xml",
    ]),
    package_xml = "package.xml",
)

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["tests/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "flake8",
    ]
]

py_pytest(
    name = "test_onboard",
    srcs = [
        "test/flexbe_onboard_test.py",
        "test/test_onboard.py",
    ],
    data = [":ament_index"] + glob(["test/**"]),
    imports = ["test"],
    deps = [
        ":flexbe_onboard",
        "@launch_ros",
        "@launch_testing",
    ],
)

py_pytest(
    name = "test_start_behavior",
    srcs = [
        "test/flexbe_onboard_test.py",
        "test/test_start_behavior.py",
    ],
    data = [":ament_index"] + glob(["test/**"]),
    imports = ["test"],
    deps = [
        ":flexbe_onboard",
        "@launch_ros",
        "@launch_testing",
    ],
)

pkg_files(
    name = "share_root_files",
    srcs = glob(["launch/*.launch.py"]) + glob(["test/*.py"]) + glob(["test/flexbe_onboard_test_data/*.py"]),
    prefix = "share/flexbe_onboard",
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"start_behavior": "flexbe_onboard.start_behavior:main"},
    install = [":share_root_files"],
    package_xml = "package.xml",
    python = [":flexbe_onboard"],
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@flexbe_core//:ament_package",
        "@flexbe_msgs//:ament_package",
        "@flexbe_states//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
