load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_package")

package(default_visibility = ["//visibility:public"])

### PACKAGING

ament_package(
    name = "ament_package",
    data = [
        "config/ids_xcpe.bias",
        "config/silky_ev_cam.bias",
        "config/trigger_pins.yaml",
        "config/trigger_pins_stereo.yaml",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_flake8//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@event_camera_msgs//:ament_package",
        "@openeb_vendor//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@ros_environment//:ament_package",
        "@rosdistro//:ament_package",
        "@std_srvs//:ament_package",
    ],
)

launch_ros_binary(
    name = "launch_driver_composition_launch_py",
    src = "launch/driver_composition.launch.py",
    data = [
        "@event_camera_renderer//:ament_index",
        "@event_image_reconstruction_fibar//:ament_index",
    ],
)

launch_ros_binary(
    name = "launch_driver_node_launch_py",
    src = "launch/driver_node.launch.py",
)

launch_ros_binary(
    name = "launch_recorder_node_launch_py",
    src = "launch/recorder_node.launch.py",
)

launch_ros_binary(
    name = "launch_recording_driver_launch_py",
    src = "launch/recording_driver.launch.py",
)

launch_ros_binary(
    name = "launch_recording_stereo_driver_launch_py",
    src = "launch/recording_stereo_driver.launch.py",
)

launch_ros_binary(
    name = "launch_start_recording_launch_py",
    src = "launch/start_recording.launch.py",
    data = ["@rosbag2_transport//:ament_index"],
)

launch_ros_binary(
    name = "launch_stereo_driver_launch_py",
    src = "launch/stereo_driver.launch.py",
    data = [
        "@event_camera_renderer//:ament_index",
        "@event_image_reconstruction_fibar//:ament_index",
    ],
)

launch_ros_binary(
    name = "launch_sync_test_launch_py",
    src = "launch/sync_test.launch.py",
)
