load("@rosdistro//ament:defs.bzl", "ament_package", "register_ament_resource")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARY

HEADERS = glob(["include/**/*.h"])

DEPENDENCIES = {
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosidl_buffer//:rosidl_buffer": "@rosidl_buffer//:rosidl_buffer_library",
    "@rosidl_typesupport_interface//:rosidl_typesupport_interface": "@rosidl_typesupport_interface//:rosidl_typesupport_interface_library",
}

cc_library(
    name = "rosidl_runtime_c_library",
    srcs = glob(["src/**/*.c"]),
    hdrs = HEADERS,
    includes = ["include"],
    # src/type_description/*.c is vendored from rosidl_generator_c's
    # templates and uses ROSIDL_GENERATOR_C_PUBLIC (a distinct macro family
    # also defined in this package's own visibility_control.h), not
    # ROSIDL_RUNTIME_C_PUBLIC, so it needs its own BUILDING_DLL define too.
    local_defines = ros_local_defines() + ["ROSIDL_GENERATOR_C_BUILDING_DLL"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rosidl_runtime_c",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rosidl_runtime_c_library"],
    deps = [":rosidl_runtime_c_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rosidl_runtime_c"],
    # Public so the rosidl generator aspects can link a message fragment against
    # the full transitive DLL closure on Windows (see rosidl_generator_c's
    # _cc_shared_dep), where a DLL may not contain undefined symbols.
    visibility = ["//visibility:public"],
)

### TESTING

[
    cc_test(
        name = test,
        timeout = "moderate",
        srcs = ["test/{}.cpp".format(test)],
        dynamic_deps = [":transitive_dynamic_deps"],
        local_defines = ros_local_defines(),
        deps = [
            ":rosidl_runtime_c_library",
            "@rosdistro//cc:googletest",
        ],
    )
    for test in [
        "test_message_type_support",
        "test_primitives_sequence_functions",
        "test_sequence_bound",
        "test_service_type_support",
        "test_string_functions",
        "test_type_description_utils",
        "test_type_hash",
        "test_u16string_functions",
    ]
]

[
    cc_test(
        name = name,
        timeout = "moderate",
        srcs = ["test/benchmark/{}.cpp".format(name)],
        dynamic_deps = DEPENDENCIES.keys() + [
            ":rosidl_runtime_c",
        ],
        local_defines = ros_local_defines(),
        tags = ["manual"],
        deps = [
            ":rosidl_runtime_c_library",
            "@google_benchmark//:benchmark_main",
            "@performance_test_fixture",
        ],
    )
    for name in [
        "benchmark_string_conversion",
    ]
]

# ament_index_register_resource() registrations, as ament_cmake installs them.

### PACKAGING

register_ament_resource(
    name = "res_rosidl_runtime_packages",
    category = "rosidl_runtime_packages",
    content = "",
)

ament_package(
    name = "ament_package",
    data = [
        ":res_rosidl_runtime_packages",
    ],
    headers = HEADERS,
    include_prefix = "",
    libraries = [
        ":rosidl_runtime_c",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros_core//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@performance_test_fixture//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_buffer//:ament_package",
        "@rosidl_typesupport_interface//:ament_package",
    ],
)
