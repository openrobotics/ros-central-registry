cc_library(
    name = "lanelet2_core_library",
    srcs = [
        "src/Attribute.cpp",
        "src/BasicRegulatoryElements.cpp",
        "src/Lanelet.cpp",
        "src/LaneletMap.cpp",
        "src/LaneletSequence.cpp",
        "src/LineStringGeometry.cpp",
        "src/PolygonTriangulationGeometry.cpp",
        "src/RegulatoryElement.cpp",
        "src/RegulatoryElementGeometry.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "lanelet2_core",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":lanelet2_core_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":lanelet2_core"],
)

