+  // Defined out-of-line (RegulatoryElement.cpp) so that this final class has a
+  // key function. Without one, its vtable and type_info are emitted as hidden,
+  // weak duplicates in every binary that includes this header. Clang's exact
+  // dynamic_cast optimization for final classes then compares vtable addresses,
+  // which differ across a shared-library boundary (e.g. macOS), making
+  // std::dynamic_pointer_cast<GenericRegulatoryElement> on objects created by
+  // RegulatoryElementFactory return nullptr.
+  ~GenericRegulatoryElement() override;
