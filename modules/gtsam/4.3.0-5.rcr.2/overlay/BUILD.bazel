    content = ["#pragma once\n#include \"ImathVec.h\"\nnamespace Imath {\ntemplate <typename V> struct Box {\n  V min, max;\n  Box() { makeEmpty(); }\n  explicit Box(const V & p) : min(p), max(p) {}\n  Box(const V & minV, const V & maxV) : min(minV), max(maxV) {}\n  void makeEmpty() { min = V(1); max = V(-1); }\n  void extendBy(const V & p) {\n    if (isEmpty()) { min = max = p; return; }\n    if (p.x < min.x) min.x = p.x;\n    if (p.y < min.y) min.y = p.y;\n    if (p.x > max.x) max.x = p.x;\n    if (p.y > max.y) max.y = p.y;\n  }\n  void extendBy(const Box & b) { if (!b.isEmpty()) { extendBy(b.min); extendBy(b.max); } }\n  V size() const { return isEmpty() ? V(0) : (max - min); }\n  V center() const { return (max + min) / 2; }\n  bool intersects(const V & p) const { return p.x >= min.x && p.x <= max.x && p.y >= min.y && p.y <= max.y; }\n  bool intersects(const Box & b) const { return min.x <= b.max.x && max.x >= b.min.x && min.y <= b.max.y && max.y >= b.min.y; }\n  bool isEmpty() const { return max.x < min.x || max.y < min.y; }\n  bool hasVolume() const { return max.x > min.x && max.y > min.y; }\n  bool operator==(const Box & o) const { return min == o.min && max == o.max; }\n  bool operator!=(const Box & o) const { return !(*this == o); }\n};\nusing Box2s = Box<V2s>;\nusing Box2i = Box<V2i>;\nusing Box2f = Box<V2f>;\nusing Box2d = Box<V2d>;\nusing Box3s = Box<V3s>;\nusing Box3i = Box<V3i>;\nusing Box3f = Box<V3f>;\nusing Box3d = Box<V3d>;\n}  // namespace Imath\n"],
