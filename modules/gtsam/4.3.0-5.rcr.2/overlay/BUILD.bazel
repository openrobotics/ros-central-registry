    cc_test(
        name = src.removesuffix(".cpp"),
        size = "medium",
        srcs = [src],
        data = [":example_data"] + (
            glob(["gtsam_unstable/discrete/examples/**"]) if src.startswith("gtsam_unstable/discrete/") else []
        ),
        dynamic_deps = [":transitive_dynamic_deps"],
        local_defines = [
            "TOPSRCDIR=\\\"{}\\\"".format(GTSAM_SOURCE_DIR),
        ] if src.startswith("gtsam_unstable/discrete/") else [],
        deps = [
            ":CppUnitLite_library",
            ":_example_hdrs",
            ":_test_hdrs",
            ":gtsam_library",
        ] + ([":gtsam_unstable_library"] if src.startswith("gtsam_unstable/") else []),
    )
    for src in GTSAM_TESTS + GTSAM_UNSTABLE_TESTS
]

