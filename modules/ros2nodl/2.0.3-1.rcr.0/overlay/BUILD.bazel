load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "ros2nodl",
    srcs = [
        "ros2nodl/__init__.py",
        "ros2nodl/__main__.py",
        "ros2nodl/command/__init__.py",
        "ros2nodl/command/nodl.py",
        "ros2nodl/conformance.py",
        "ros2nodl/describe/__init__.py",
        "ros2nodl/describe/_source.py",
        "ros2nodl/describe/_transform.py",
        "ros2nodl/verb/__init__.py",
        "ros2nodl/verb/conform.py",
        "ros2nodl/verb/describe.py",
        "ros2nodl/verb/rewrite.py",
        "ros2nodl/verb/validate.py",
    ],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@builtin_interfaces//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@ros2cli",
        "@rosgraph_msgs//:py",
        "@rosidl_runtime_py",
        "@std_msgs//:py",
        requirement("pyyaml"),
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":ros2nodl"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_index_python//:ament_package",
        "@builtin_interfaces//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@ros2cli//:ament_package",
        "@rosdistro//:ament_package",
        "@rosgraph_msgs//:ament_package",
        "@rosidl_runtime_py//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
