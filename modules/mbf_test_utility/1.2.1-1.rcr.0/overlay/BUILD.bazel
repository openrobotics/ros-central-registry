load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:static_transform_broadcaster_node": "@tf2_ros//:static_transform_broadcaster_node_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@mbf_msgs//:cc",
    "@nav_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "mbf_test_utility_sim_library",
    srcs = ["src/robot_simulator.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    includes = [
        "include",
        "include/mbf_test_utility",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mbf_test_utility_sim",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mbf_test_utility_sim_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":mbf_test_utility_sim"],
)

cc_binary(
    name = "mbf_test_utility_sim_node",
    srcs = ["src/robot_simulator_node.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/mbf_test_utility",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":mbf_test_utility_sim_library"],
)

ament_index(
    name = "ament_index",
    lib_data = [":mbf_test_utility_sim_node"],
    libraries = [":mbf_test_utility_sim"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mbf_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "geometry_msgs",
        "mbf_msgs",
        "nav_msgs",
        "rclcpp",
        "tf2_geometry_msgs",
        "tf2_ros",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_mbf_test_utility",
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [":mbf_test_utility_sim"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@mbf_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
