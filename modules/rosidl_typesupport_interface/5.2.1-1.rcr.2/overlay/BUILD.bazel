load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARY

HEADERS = glob(["include/**/*.h"])

cc_library(
    name = "rosidl_typesupport_interface_library",
    hdrs = HEADERS,
    includes = ["include"],
)

cc_shared_library(
    name = "rosidl_typesupport_interface",
    exports_filter = [":rosidl_typesupport_interface_library"],
    deps = [":rosidl_typesupport_interface_library"],
)

### TESTING

cc_test(
    name = "test_macros",
    srcs = ["test/test_macros.cpp"],
    # rosidl_typesupport_interface_library is header-only (no srcs), so the
    # cc_shared_library wrapping it produces an empty DLL with no exported
    # symbols. Unlike a .so/.dylib, a Windows DLL with nothing to export
    # doesn't get an import library generated at all, so any dynamic_deps
    # reference to it fails at link time ("unable to find library
    # -lrosidl_typesupport_interface"). The test already gets everything it
    # needs from the direct deps on the header-only library below.
    dynamic_deps = select({
        "@platforms//os:windows": [],
        "//conditions:default": [":rosidl_typesupport_interface"],
    }),
    deps = [
        ":rosidl_typesupport_interface_library",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_libraries = False,
    headers = HEADERS,
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
