load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "mypy",
        "pep257",
        "xmllint",
    ]
]

py_library(
    name = "tracetools_trace",
    srcs = glob(["tracetools_trace/**/*.py"]),
    imports = ["."],
    deps = [
        requirement("packaging"),
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"trace": "tracetools_trace.trace:main"},
    package_xml = "package.xml",
    python = [":tracetools_trace"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@lttngpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
