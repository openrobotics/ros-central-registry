load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = [
        "meshes/flange.dae",
        "meshes/flange.stl",
        "meshes/foot.dae",
        "meshes/foot.stl",
        "meshes/link_1.dae",
        "meshes/link_1.stl",
        "meshes/link_2.dae",
        "meshes/link_2.stl",
        "meshes/link_3.dae",
        "meshes/link_3.stl",
        "meshes/link_4.dae",
        "meshes/link_4.stl",
        "meshes/link_5.dae",
        "meshes/link_5.stl",
        "urdf/prbt.ros2_control.xacro",
        "urdf/prbt.xacro",
        "urdf/prbt_macro.xacro",
        "urdf/simple_gripper_brackets.urdf.xacro",
    ] + [
        "config/manipulator_controller.yaml",
        "config/manipulator_driver.yaml",
        "config/prbt_0_1.dcf",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@rosdistro//:ament_package",
        "@xacro//:ament_package",
    ],
)
