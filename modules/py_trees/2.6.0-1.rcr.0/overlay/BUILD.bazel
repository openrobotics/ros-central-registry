load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "py_trees",
    srcs = [
        "py_trees/__init__.py",
        "py_trees/behaviour.py",
        "py_trees/behaviours.py",
        "py_trees/blackboard.py",
        "py_trees/common.py",
        "py_trees/composites.py",
        "py_trees/console.py",
        "py_trees/decorators.py",
        "py_trees/demos/__init__.py",
        "py_trees/demos/action.py",
        "py_trees/demos/blackboard.py",
        "py_trees/demos/blackboard_namespaces.py",
        "py_trees/demos/blackboard_remappings.py",
        "py_trees/demos/context_switching.py",
        "py_trees/demos/display_modes.py",
        "py_trees/demos/dot_graphs.py",
        "py_trees/demos/either_or.py",
        "py_trees/demos/eternal_guard.py",
        "py_trees/demos/lifecycle.py",
        "py_trees/demos/logging.py",
        "py_trees/demos/pick_up_where_you_left_off.py",
        "py_trees/demos/ports/__init__.py",
        "py_trees/demos/ports/basic.py",
        "py_trees/demos/ports/nested_subtrees.py",
        "py_trees/demos/ports/remapping.py",
        "py_trees/demos/ports/xml_tree.py",
        "py_trees/demos/selector.py",
        "py_trees/demos/sequence.py",
        "py_trees/demos/stewardship.py",
        "py_trees/display.py",
        "py_trees/idioms.py",
        "py_trees/logging.py",
        "py_trees/meta.py",
        "py_trees/parsers/__init__.py",
        "py_trees/parsers/behaviour_tree_xml.py",
        "py_trees/ports.py",
        "py_trees/ports_utils.py",
        "py_trees/programs/__init__.py",
        "py_trees/programs/render.py",
        "py_trees/syntax_highlighting.py",
        "py_trees/tests.py",
        "py_trees/timers.py",
        "py_trees/trees.py",
        "py_trees/utilities.py",
        "py_trees/version.py",
        "py_trees/visitors.py",
    ],
    imports = ["."],
    deps = [requirement("pydot")],
)

ament_package(
    name = "ament_package",
    console_programs = {
        "py-trees-demo-action-behaviour": "py_trees.demos.action:main",
        "py-trees-demo-behaviour-lifecycle": "py_trees.demos.lifecycle:main",
        "py-trees-demo-blackboard": "py_trees.demos.blackboard:main",
        "py-trees-demo-blackboard-namespaces": "py_trees.demos.blackboard_namespaces:main",
        "py-trees-demo-blackboard-remappings": "py_trees.demos.blackboard_remappings:main",
        "py-trees-demo-context-switching": "py_trees.demos.context_switching:main",
        "py-trees-demo-display-modes": "py_trees.demos.display_modes:main",
        "py-trees-demo-dot-graphs": "py_trees.demos.dot_graphs:main",
        "py-trees-demo-either-or": "py_trees.demos.either_or:main",
        "py-trees-demo-eternal-guard": "py_trees.demos.eternal_guard:main",
        "py-trees-demo-logging": "py_trees.demos.logging:main",
        "py-trees-demo-pick-up-where-you-left-off": "py_trees.demos.pick_up_where_you_left_off:main",
        "py-trees-demo-ports-basic": "py_trees.demos.ports.basic:main",
        "py-trees-demo-ports-nested-subtrees": "py_trees.demos.ports.nested_subtrees:main",
        "py-trees-demo-ports-remapping": "py_trees.demos.ports.remapping:main",
        "py-trees-demo-ports-xml-tree": "py_trees.demos.ports.xml_tree:main",
        "py-trees-demo-selector": "py_trees.demos.selector:main",
        "py-trees-demo-sequence": "py_trees.demos.sequence:main",
        "py-trees-demo-tree-stewardship": "py_trees.demos.stewardship:main",
        "py-trees-render": "py_trees.programs.render:main",
    },
    package_xml = "package.xml",
    python = [":py_trees"],
    deps = ["@rosdistro//:ament_package"],
)
