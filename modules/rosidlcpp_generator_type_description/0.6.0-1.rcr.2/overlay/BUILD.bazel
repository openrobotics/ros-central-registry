load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:ament_resource.bzl", "register_ament_resource")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
    "@rosidlcpp_generator_core//:rosidlcpp_generator_core": "@rosidlcpp_generator_core//:rosidlcpp_generator_core_library",
    "@rosidlcpp_parser//:rosidlcpp_parser": "@rosidlcpp_parser//:rosidlcpp_parser_library",
}

CC_DEPS = [
    "@rosdistro//cc:fmt",
    "@rosdistro//cc:nlohmann_json",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "rosidlcpp_generator_type_description",
    srcs = [
        "src/rosidlcpp_generator_type_description/json_utils.cpp",
        "src/rosidlcpp_generator_type_description/rosidlcpp_generator_type_description.cpp",
    ] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/rosidlcpp_generator_type_description",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

register_ament_resource(
    name = "res_rosidl_generator_packages",
    category = "rosidl_generator_packages",
    content = "",
)

write_file(
    name = "gen_extra_0",
    out = "_gen/share/ament_index/resource_index/rosidl_generator_packages/rosidlcpp_generator_type_description",
    content = [""],
)

write_file(
    name = "gen_cmake_1",
    out = "_gen/share/rosidlcpp_generator_type_description/cmake/rosidlcpp_generator_type_description-extras.cmake",
    content = ["find_package(ament_cmake_core QUIET REQUIRED)\n  \nif(NOT USE_ROSIDL_GENERATORS)\n\n  # Replace rosidl_generator_cpp with rosidlcpp_generator_cpp\n  find_package(rosidl_generator_type_description QUIET)  # Needs to be loaded for its generator can be replace\n  list(\n    TRANSFORM AMENT_EXTENSIONS_rosidl_generate_idl_interfaces\n    REPLACE \"rosidl_generator_type_description:rosidl_generator_type_description_generate_interfaces.cmake\"\n    \"rosidlcpp_generator_type_description:rosidlcpp_generator_type_description_generate_interfaces.cmake\"\n  )\n\n  set(rosidlcpp_generator_type_description_BIN \"${rosidlcpp_generator_type_description_DIR}/../../../lib/rosidlcpp_generator_type_description/rosidlcpp_generator_type_description\")\n  normalize_path(rosidlcpp_generator_type_description_BIN \"${rosidlcpp_generator_type_description_BIN}\")\n\nendif()\n"],
)

pkg_files(
    name = "pkg_files_extra_0",
    srcs = [":gen_extra_0"],
    prefix = "share/ament_index/resource_index/rosidl_generator_packages",
)

pkg_files(
    name = "pkg_files_cmake_1",
    srcs = [":gen_cmake_1"],
    prefix = "share/rosidlcpp_generator_type_description/cmake",
)

ament_index(
    name = "ament_index",
    data = ["resource/HashedTypeDescription.schema.json"],
    lib_data = [":rosidlcpp_generator_type_description"],
    package_xml = "package.xml",
    deps = [
        ":res_rosidl_generator_packages",
        "@ament_cmake//:ament_package",
        "@ament_cmake_core//:ament_package",
        "@rcutils//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidlcpp_generator_core//:ament_package",
        "@rosidlcpp_parser//:ament_package",
    ],
)

ament_package(
    cmake = ["cmake/rosidlcpp_generator_type_description_generate_interfaces.cmake"],
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    cmake_extras = ["rosidlcpp_generator_type_description-extras.cmake"],
    install = [
        ":pkg_files_extra_0",
        ":pkg_files_cmake_1",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        ":res_rosidl_generator_packages",
        "@ament_cmake//:ament_package",
        "@ament_cmake_core//:ament_package",
        "@rcutils//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidlcpp_generator_core//:ament_package",
        "@rosidlcpp_parser//:ament_package",
    ],
)
