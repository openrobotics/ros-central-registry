    srcs = ["tests/test_incomplete_cholesky.py"],
    tags = ["manual"],
    deps = [
        ":nanoeigenpy_py",
        requirement("numpy"),
    ],
)

ament_package(
    name = "ament_package",
    build_type = "cmake",
    headers = glob(
        ["include/nanoeigenpy/**/*.hpp"],
        exclude = [
            "include/nanoeigenpy/decompositions/sparse/accelerate/**",
            "include/nanoeigenpy/decompositions/sparse/cholmod/**",
        ],
    ),
    include_prefix = "",
    install = [
        ":meta_files_0",
        ":meta_files_1",
        ":meta_files_2",
        ":meta_files_3",
        ":meta_files_4",
    ],
    package_xml = "package.xml",
    python = [":nanoeigenpy"],
    deps = [
        "@rosdistro//:ament_package",
    ],
)
