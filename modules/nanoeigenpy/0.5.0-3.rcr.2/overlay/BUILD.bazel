    name = "nanoeigenpy_ext_library",
    srcs = ["src/module.cpp"],
    hdrs = ["src/internal.h"],
    copts = [
        "-fvisibility=hidden",
        "-fno-strict-aliasing",
    ],
    includes = ["src"],
    deps = [":nanoeigenpy_headers"],
)

