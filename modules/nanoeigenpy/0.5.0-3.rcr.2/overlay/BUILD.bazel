        "*/",
        "",
        "#ifndef NANOEIGENPY_CONFIG_HH",
        "# define NANOEIGENPY_CONFIG_HH",
        "",
        "// Package version (header).",
        "# define NANOEIGENPY_VERSION_UNKNOWN_TAG 0 // Used to mention that the current version is unknown.",
        "# define NANOEIGENPY_VERSION \"0.5.0\"",
        "# define NANOEIGENPY_MAJOR_VERSION 0",
        "# define NANOEIGENPY_MINOR_VERSION 5",
        "# define NANOEIGENPY_PATCH_VERSION 0",
        "",
        "#define NANOEIGENPY_VERSION_AT_LEAST(major, minor, patch) (NANOEIGENPY_MAJOR_VERSION>major || (NANOEIGENPY_MAJOR_VERSION>=major && \\",
        "                                                             (NANOEIGENPY_MINOR_VERSION>minor || (NANOEIGENPY_MINOR_VERSION>=minor && \\",
        "                                                                                                     NANOEIGENPY_PATCH_VERSION>=patch))))",
        "",
        "#define NANOEIGENPY_VERSION_AT_MOST(major, minor, patch) (NANOEIGENPY_MAJOR_VERSION<major || (NANOEIGENPY_MAJOR_VERSION<=major && \\",
        "                                                            (NANOEIGENPY_MINOR_VERSION<minor || (NANOEIGENPY_MINOR_VERSION<=minor && \\",
        "                                                                                                     NANOEIGENPY_PATCH_VERSION<=patch))))",
        "",
        "// Handle portable symbol export.",
        "// Defining manually which symbol should be exported is required",
        "// under Windows whether MinGW or MSVC is used.",
        "//",
        "// The headers then have to be able to work in two different modes:",
        "// - dllexport when one is building the library,",
        "// - dllimport for clients using the library.",
        "//",
        "// On Linux, set the visibility accordingly. If C++ symbol visibility",
        "// is handled by the compiler, see: http://gcc.gnu.org/wiki/Visibility",
        "//",
        "// Explicit template instantiation on Windows need to add",
        "// dllexport on the definition and dllimport on the declaration.",
        "// The XXX_EXPLICIT_INSTANTIATION_DECLARATION_DLLAPI macro",
        "// should be set on the declaration while",
        "// the XXX_EXPLICIT_INSTANTIATION_DEFINITION_DLLAPI macro",
        "// should be set on the definition.",
        "# if defined _WIN32 || defined __CYGWIN__",
        "// On Microsoft Windows, use dllimport and dllexport to tag symbols.",
        "#  define NANOEIGENPY_DLLIMPORT __declspec(dllimport)",
        "#  define NANOEIGENPY_DLLEXPORT __declspec(dllexport)",
        "#  define NANOEIGENPY_DLLLOCAL",
        "#  define NANOEIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT __declspec(dllimport)",
        "#  define NANOEIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT",
        "#  define NANOEIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT __declspec(dllimport)",
        "#  define NANOEIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT __declspec(dllexport)",
        "# else",
        "// On Linux, for GCC >= 4, tag symbols using GCC extension.",
        "#  if __GNUC__ >= 4",
        "#   define NANOEIGENPY_DLLIMPORT __attribute__ ((visibility(\"default\")))",
        "#   define NANOEIGENPY_DLLEXPORT __attribute__ ((visibility(\"default\")))",
        "#   define NANOEIGENPY_DLLLOCAL  __attribute__ ((visibility(\"hidden\")))",
        "#   define NANOEIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT __attribute__ ((visibility(\"default\")))",
        "#   define NANOEIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT __attribute__ ((visibility(\"default\")))",
        "#   define NANOEIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT",
        "#   define NANOEIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT",
        "#  else",
        "// Otherwise (GCC < 4 or another compiler is used), export everything.",
        "#   define NANOEIGENPY_DLLIMPORT",
        "#   define NANOEIGENPY_DLLEXPORT",
        "#   define NANOEIGENPY_DLLLOCAL",
        "#   define NANOEIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT",
        "#   define NANOEIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT",
        "#   define NANOEIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT",
        "#   define NANOEIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT",
        "#  endif // __GNUC__ >= 4",
        "# endif // defined _WIN32 || defined __CYGWIN__",
        "",
        "# ifdef NANOEIGENPY_STATIC",
        "// If one is using the library statically, get rid of",
        "// extra information and use standard explicit template",
        "// instantiation keyword.",
        "#  define NANOEIGENPY_DLLAPI",
        "#  define NANOEIGENPY_LOCAL",
        "#  define NANOEIGENPY_EXPLICIT_INSTANTIATION_DECLARATION extern template",
        "# else",
        "// Depending on whether one is building or using the",
        "// library define DLLAPI to import or export and",
        "// define the right explicit template instantiation keyword.",
        "#  ifdef nanoeigenpy_EXPORTS",
        "#   define NANOEIGENPY_DLLAPI NANOEIGENPY_DLLEXPORT",
        "#   define NANOEIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLAPI NANOEIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLEXPORT",
        "#   define NANOEIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLAPI NANOEIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLEXPORT",
        "#  else",
        "#   define NANOEIGENPY_DLLAPI NANOEIGENPY_DLLIMPORT",
        "#   define NANOEIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLAPI NANOEIGENPY_EXPLICIT_INSTANTIATION_DECLARATION_DLLIMPORT",
        "#   define NANOEIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLAPI NANOEIGENPY_EXPLICIT_INSTANTIATION_DEFINITION_DLLIMPORT",
        "#  endif // NANOEIGENPY_EXPORTS",
        "#  define NANOEIGENPY_LOCAL NANOEIGENPY_DLLLOCAL",
        "# endif // NANOEIGENPY_STATIC",
        "#endif //! NANOEIGENPY_CONFIG_HH",
    ],
    is_executable = False,
)

write_file(
    name = "_meta_file_1",
    out = "_gen_meta/include/nanoeigenpy/deprecated.hpp",
    content = [
        "/*",
        " * This file has been automatically generated by the jrl-cmakemodules.",
        " * Please see https://github.com/jrl-umi3218/jrl-cmakemodules/blob/master/deprecated.hh.cmake for details.",
        "*/",
        "",
        "#ifndef NANOEIGENPY_DEPRECATED_HH",
        "# define NANOEIGENPY_DEPRECATED_HH",
        "",
        "// Define a suffix which can be used to tag a type, a function or a a",
        "// variable as deprecated (i.e. it will emit a warning when using it).",
        "//",
        "// Tagging a function as deprecated:",
        "//  void foo () NANOEIGENPY_DEPRECATED;",
        "//",
        "// Tagging a type as deprecated:",
        "//  class Foo {};",
        "//  typedef Foo Bar NANOEIGENPY_DEPRECATED;",
        "//",
        "// Tagging a variable as deprecated:",
        "//  int a NANOEIGENPY_DEPRECATED = 0;",
        "//",
        "// The use of a macro is required as this is /not/ a standardized",
        "// feature of C++ language or preprocessor, even if most of the",
        "// compilers support it.",
        "# if defined(__cplusplus) && (__cplusplus >= 201402L)",
        "#  define NANOEIGENPY_DEPRECATED [[deprecated]]",
        "#  define NANOEIGENPY_DEPRECATED_MESSAGE(message) [[deprecated(#message)]]",
        "# elif defined(__GNUC__) || defined(__clang__)",
        "#  define NANOEIGENPY_DEPRECATED __attribute__ ((deprecated))",
        "#  define NANOEIGENPY_DEPRECATED_MESSAGE(message) __attribute__ (( deprecated(#message) ))",
        "# else",
        "#  if defined(_MSC_VER) && !defined(__INTEL_COMPILER)",
        "#   define NANOEIGENPY_DEPRECATED __declspec (deprecated)",
        "#   define NANOEIGENPY_DEPRECATED_MESSAGE(message) __declspec ( deprecated(#message) )",
        "#  else",
        "// If the compiler is not recognized, drop the feature.",
        "#   define NANOEIGENPY_DEPRECATED /* nothing */",
        "#   define NANOEIGENPY_DEPRECATED_MESSAGE(message)",
        "#  endif // __MSVC__",
        "# endif // __cplusplus",
        "",
        "# if defined(__GNUC__) || defined(__clang__)",
        "#  ifndef NANOEIGENPY_PRAGMA",
        "#   define NANOEIGENPY_PRAGMA(X) _Pragma(#X)",
        "#  endif",
        "#  define NANOEIGENPY_DEPRECATED_HEADER(MSG) NANOEIGENPY_PRAGMA(GCC warning MSG)",
        "# elif defined(_MSC_VER) && !defined(__INTEL_COMPILER)",
        "#  define NANOEIGENPY_STRINGIZE_(MSG) #MSG",
        "#  define NANOEIGENPY_STRINGIZE(MSG) NANOEIGENPY_STRINGIZE_(MSG)",
        "#  define NANOEIGENPY_DEPRECATED_HEADER(MSG) \\",
        "    __pragma(message(__FILE__ \"(\" NANOEIGENPY_STRINGIZE(__LINE__) \") : Warning: \" MSG))",
        "# else",
        "#  define NANOEIGENPY_DEPRECATED_HEADER(MSG)",
        "# endif",
        "",
        "#endif //! NANOEIGENPY_DEPRECATED_HH",
    ],
    is_executable = False,
)

