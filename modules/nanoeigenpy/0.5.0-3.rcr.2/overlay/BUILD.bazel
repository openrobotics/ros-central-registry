    name = "nanoeigenpy",
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "nanoeigenpy.so",
    user_link_flags = select({
        "@platforms//os:linux": ["-Wl,--gc-sections"],
        "//conditions:default": [],
    }),
    deps = [":nanoeigenpy_ext_library"],
)

