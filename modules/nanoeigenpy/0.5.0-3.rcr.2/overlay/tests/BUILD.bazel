load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

cc_library(
    name = "quaternion_ext_library",
    testonly = True,
    srcs = ["quaternion.cpp"],
    copts = [
        "-fvisibility=hidden",
        "-fno-strict-aliasing",
    ],
    deps = ["//:nanoeigenpy_headers"],
)

cc_shared_library(
    name = "quaternion",
    testonly = True,
    exports_filter = [
        "//:nanobind_library",
        ":quaternion_ext_library",
    ],
    shared_lib_name = "quaternion.so",
    user_link_flags = select({
        "@platforms//os:linux": ["-Wl,--gc-sections"],
        "//conditions:default": [],
    }),
    deps = [":quaternion_ext_library"],
)

py_pytest(
    name = "nanoeigenpy-test-eigen-solver",
