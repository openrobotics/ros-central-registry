load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

ament_package(
    name = "ament_package",
    data = [
        "config/airport_terminal/cleanerBotA_config.yaml",
        "config/airport_terminal/cleanerBotE_config.yaml",
        "config/airport_terminal/deliveryRobot_config.yaml",
        "config/airport_terminal/tinyRobot_config.yaml",
        "config/battle_royale/tinyRobot_config.yaml",
        "config/campus/deliveryRobot_config.yaml",
        "config/clinic/deliveryRobot_config.yaml",
        "config/clinic/tinyRobot_config.yaml",
        "config/hotel/cleanerBotA_config.yaml",
        "config/hotel/deliveryRobot_config.yaml",
        "config/hotel/meals_to_master_suites.json",
        "config/hotel/tinyRobot_config.yaml",
        "config/office/tinyRobot_config.yaml",
        "config/office_mock_traffic_light/tinyRobot1_config.yaml",
        "sros2/office.params.yaml",
        "sros2/office_deploy.bash",
        "sros2/policies/node.xml",
        "sros2/policies/node/logging.xml",
        "sros2/policies/node/parameters.xml",
        "sros2/policies/node/time.xml",
