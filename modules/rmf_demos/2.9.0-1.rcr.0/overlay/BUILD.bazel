load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

pkg_files(
    name = "stripped_share",
    srcs = glob(["launch/**"]),
    prefix = "share/rmf_demos",
    strip_prefix = strip_prefix.from_pkg("launch"),
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = glob([
        "config/**",
        "sros2/**",
    ]),
    install = [":stripped_share"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@launch_xml//:ament_package",
        "@rmf_building_map_tools//:ament_package",
        "@rmf_demos_assets//:ament_package",
        "@rmf_demos_fleet_adapter//:ament_package",
        "@rmf_demos_maps//:ament_package",
        "@rmf_demos_tasks//:ament_package",
        "@rmf_fleet_adapter//:ament_package",
        "@rmf_reservation_node//:ament_package",
        "@rmf_task_ros2//:ament_package",
        "@rmf_traffic_ros2//:ament_package",
        "@rmf_visualization//:ament_package",
        "@rosdistro//:ament_package",
        "@rviz2//:ament_package",
    ],
)
