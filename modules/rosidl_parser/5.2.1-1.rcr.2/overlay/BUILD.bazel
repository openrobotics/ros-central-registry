load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

# This is the python library that does the bulk of the work for converting
# the .msg, .srv, .action files to the generic .idl representation.
py_library(
    name = "rosidl_parser",
    srcs = glob(["rosidl_parser/**/*.py"]),
    data = glob(
        ["rosidl_parser/**"],
        exclude = ["rosidl_parser/**/*.py"],
    ),
    deps = [
        requirement("lark"),
    ],
)

# All functional tests.
py_pytest(
    name = "test_parser",
    srcs = ["test/test_parser.py"],
    data = glob(["test/**/*.idl"]),
    deps = [":rosidl_parser"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    lib_data = ["bin/idl2png"],
    package_xml = "package.xml",
    python = glob(["rosidl_parser/**"]),
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_mypy//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_adapter//:ament_package",
    ],
)
