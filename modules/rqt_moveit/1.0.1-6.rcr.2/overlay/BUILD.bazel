load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "rqt_moveit",
    srcs = [
        "src/rqt_moveit/__init__.py",
        "src/rqt_moveit/moveit_plugin.py",
        "src/rqt_moveit/moveit_widget.py",
    ],
    imports = ["src"],
    deps = [
        "@python_qt_binding",
        "@rclpy",
        "@rqt_gui",
        "@rqt_gui_py",
        "@rqt_py_common",
        "@rqt_topic",
        "@sensor_msgs//:py",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = [
        "plugin.xml",
        "resource/moveit_top.ui",
    ],
    executables = ["resource/rqt_moveit"],
    package_xml = "package.xml",
    python = [":rqt_moveit"],
    python_strip_prefix = "src",
    setup_cfg = "setup.cfg",
    deps = [
        "@python_qt_binding//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_py//:ament_package",
        "@rqt_py_common//:ament_package",
        "@rqt_topic//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
