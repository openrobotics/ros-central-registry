load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

py_library(
    name = "plansys2_tui_cli",
    srcs = glob(["plansys2_tui_cli/**/*.py"]),
    data = glob(
        ["plansys2_tui_cli/vendor/**"],
        exclude = ["**/*.py"],
    ),
    imports = ["."],
    deps = [
        "@plansys2_msgs//:py",
        "@rclpy",
        "@ros2cli",
    ],
)

ament_package(
    name = "ament_package",
    build_type = "ament_python",
    console_scripts = {
        "plansys2_tui": "plansys2_tui_cli.tui.app:run_app",
    },
    package_xml = "package.xml",
    python = [":plansys2_tui_cli"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@plansys2_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@ros2cli//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
