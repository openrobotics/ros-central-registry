load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load(":vendor_install.bzl", "vendor_install_tree")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

vendor_install_tree(
    name = "cc_files",
    deps = [
        "@google_benchmark//:benchmark",
        "@google_benchmark//:benchmark_main",
    ],
)

[
    write_file(
        name = "meta_" + f.replace("/", "_").replace(".", "_").replace("-", "_"),
        out = "_meta/" + f,
        content = [""],
    )
    for f in [
        "lib/cmake/benchmark/benchmarkConfig.cmake",
        "lib/cmake/benchmark/benchmarkConfigVersion.cmake",
        "lib/cmake/benchmark/benchmarkTargets-noconfig.cmake",
        "lib/cmake/benchmark/benchmarkTargets.cmake",
        "lib/pkgconfig/benchmark.pc",
        "share/doc/benchmark/AssemblyTests.md",
        "share/doc/benchmark/_config.yml",
        "share/doc/benchmark/assets/images/icon.png",
        "share/doc/benchmark/assets/images/icon.xcf",
        "share/doc/benchmark/assets/images/icon_black.png",
        "share/doc/benchmark/assets/images/icon_black.xcf",
        "share/doc/benchmark/dependencies.md",
        "share/doc/benchmark/index.md",
        "share/doc/benchmark/perf_counters.md",
        "share/doc/benchmark/platform_specific_build_instructions.md",
        "share/doc/benchmark/python_bindings.md",
        "share/doc/benchmark/random_interleaving.md",
        "share/doc/benchmark/reducing_variance.md",
        "share/doc/benchmark/releasing.md",
        "share/doc/benchmark/tools.md",
        "share/doc/benchmark/user_guide.md",
    ]
]

pkg_files(
    name = "meta_files",
    srcs = [
        ":meta_lib_cmake_benchmark_benchmarkConfigVersion_cmake",
        ":meta_lib_cmake_benchmark_benchmarkConfig_cmake",
        ":meta_lib_cmake_benchmark_benchmarkTargets_cmake",
        ":meta_lib_cmake_benchmark_benchmarkTargets_noconfig_cmake",
        ":meta_lib_pkgconfig_benchmark_pc",
        ":meta_share_doc_benchmark_AssemblyTests_md",
        ":meta_share_doc_benchmark__config_yml",
        ":meta_share_doc_benchmark_assets_images_icon_black_png",
        ":meta_share_doc_benchmark_assets_images_icon_black_xcf",
        ":meta_share_doc_benchmark_assets_images_icon_png",
        ":meta_share_doc_benchmark_assets_images_icon_xcf",
        ":meta_share_doc_benchmark_dependencies_md",
        ":meta_share_doc_benchmark_index_md",
        ":meta_share_doc_benchmark_perf_counters_md",
        ":meta_share_doc_benchmark_platform_specific_build_instructions_md",
        ":meta_share_doc_benchmark_python_bindings_md",
        ":meta_share_doc_benchmark_random_interleaving_md",
        ":meta_share_doc_benchmark_reducing_variance_md",
        ":meta_share_doc_benchmark_releasing_md",
        ":meta_share_doc_benchmark_tools_md",
        ":meta_share_doc_benchmark_user_guide_md",
    ],
    strip_prefix = strip_prefix.from_pkg("_meta"),
)

### PACKAGING

ament_package(
    name = "ament_package",
    build_type = "cmake",
    install = [
        ":cc_files",
        ":meta_files",
    ],
    package_xml = "package.xml",
    pkgconfig_hook = False,
    deps = [
        "@rosdistro//:ament_package",
    ],
)
