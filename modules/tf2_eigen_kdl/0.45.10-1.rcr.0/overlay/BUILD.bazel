load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

HEADERS = [
    "include/tf2_eigen_kdl/tf2_eigen_kdl.hpp",
    "include/tf2_eigen_kdl/visibility_control.h",
]

DEPENDENCIES = {
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
}

cc_library(
    name = "tf2_eigen_kdl_library",
    srcs = ["src/tf2_eigen_kdl.cpp"],
    hdrs = HEADERS,
    copts = [
        "-Wall",
        "-Wextra",
        "-Wpedantic",
    ],
    includes = ["include"],
    local_defines = ros_local_defines() + ["TF2_EIGEN_KDL_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + ["@rosdistro//cc:eigen"],
)

cc_shared_library(
    name = "tf2_eigen_kdl",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":tf2_eigen_kdl_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_test",
    dynamic_deps = DEPENDENCIES.keys() + [":tf2_eigen_kdl"],
)

ament_package(
    name = "ament_package",
    cmake_export_name = "export_tf2_eigen_kdl",
    headers = HEADERS,
    libraries = [":tf2_eigen_kdl"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
        "@tf2//:ament_package",
    ],
)
