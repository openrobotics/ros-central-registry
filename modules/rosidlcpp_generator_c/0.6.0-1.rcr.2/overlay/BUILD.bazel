load("@rosdistro//ament:ament_resource.bzl", "register_ament_resource")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rosidlcpp_generator_core//:rosidlcpp_generator_core": "@rosidlcpp_generator_core//:rosidlcpp_generator_core_library",
    "@rosidlcpp_parser//:rosidlcpp_parser": "@rosidlcpp_parser//:rosidlcpp_parser_library",
}

CC_DEPS = [
    "@rosdistro//cc:fmt",
    "@rosdistro//cc:nlohmann_json",
]

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "rosidlcpp_generator_c",
    srcs = ["src/rosidlcpp_generator_c/rosidlcpp_generator_c.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++23",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/rosidlcpp_generator_c",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

register_ament_resource(
    name = "res_rosidl_generator_packages",
    category = "rosidl_generator_packages",
    content = "",
)

ament_index(
    name = "ament_index",
    data = [
        "resource/action__type_support.c.template",
        "resource/action__type_support.h.template",
        "resource/empty__description.c.template",
        "resource/full__description.c.template",
        "resource/idl.h.template",
        "resource/idl__description.c.template",
        "resource/idl__functions.c.template",
        "resource/idl__functions.h.template",
        "resource/idl__struct.h.template",
        "resource/idl__type_support.c.template",
        "resource/idl__type_support.h.template",
        "resource/msg__functions.c.template",
        "resource/msg__functions.h.template",
        "resource/msg__struct.h.template",
        "resource/msg__type_support.h.template",
        "resource/rosidl_generator_c__visibility_control.h.in",
        "resource/srv__type_support.c.template",
        "resource/srv__type_support.h.template",
    ],
    lib_data = [
        ":rosidlcpp_generator_c",
    ],
    package_xml = "package.xml",
    deps = [
        ":res_rosidl_generator_packages",
        "@ament_cmake//:ament_package",
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_ros_core//:ament_package",
        "@rcutils//:ament_package",
        "@ros_environment//:ament_package",
        "@rosidl_cmake//:ament_package",
        "@rosidl_generator_type_description//:ament_package",
        "@rosidl_typesupport_interface//:ament_package",
        "@rosidlcpp_generator_core//:ament_package",
        "@rosidlcpp_parser//:ament_package",
    ],
)

ament_package(
    cmake = [
        "cmake/register_c.cmake",
        "cmake/rosidlcpp_generator_c_generate_interfaces.cmake",
    ],
    cmake_export_dependencies_list = [
        "fmt",
        "nlohmann_json",
        "rosidlcpp_parser",
        "rosidlcpp_generator_core",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    cmake_extras = ["rosidlcpp_generator_c-extras.cmake"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        ":res_rosidl_generator_packages",
        "@ament_cmake//:ament_package",
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_ros_core//:ament_package",
        "@rcutils//:ament_package",
        "@ros_environment//:ament_package",
        "@rosidl_cmake//:ament_package",
        "@rosidl_generator_type_description//:ament_package",
        "@rosidl_typesupport_interface//:ament_package",
        "@rosidlcpp_generator_core//:ament_package",
        "@rosidlcpp_parser//:ament_package",
    ],
)
