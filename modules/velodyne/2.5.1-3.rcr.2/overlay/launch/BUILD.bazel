load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@pip_ros//:requirements.bzl", "requirement")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "velodyne-all-nodes-VLP16-composed-launch.py",
        "velodyne-all-nodes-VLP16-launch.py",
        "velodyne-all-nodes-VLP32C-composed-launch.py",
        "velodyne-all-nodes-VLP32C-launch.py",
        "velodyne-all-nodes-VLS128-composed-launch.py",
        "velodyne-all-nodes-VLS128-launch.py",
    ],
)

launch_ros_binary(
    name = "velodyne_all_nodes_VLP16_composed_launch",
    src = "velodyne-all-nodes-VLP16-composed-launch.py",
    data = [
        "//:ament_index",
        "@rclcpp_components//:ament_index",
        "@rclcpp_components//:component_container",
        "@velodyne_driver",
        "@velodyne_driver//:ament_index",
        "@velodyne_laserscan",
        "@velodyne_laserscan//:ament_index",
        "@velodyne_pointcloud//:ament_index",
        "@velodyne_pointcloud//:transform",
    ],
    deps = [
        "@ament_index_python",
        requirement("pyyaml"),
    ],
)

