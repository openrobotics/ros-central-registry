load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

py_library(
    name = "examples_rclpy_executors_library",
    srcs = glob(["examples_rclpy_executors/**/*.py"]),
    imports = ["."],
    deps = [
        "@rclpy",
        "@std_msgs//:py",
    ],
)

EXECUTABLES = {
    "listener": "examples_rclpy_executors/listener.py",
    "talker": "examples_rclpy_executors/talker.py",
    "callback_group": "examples_rclpy_executors/callback_group.py",
    "composed": "examples_rclpy_executors/composed.py",
    "custom_executor": "examples_rclpy_executors/custom_executor.py",
    "custom_callback_group": "examples_rclpy_executors/custom_callback_group.py",
}

[
    py_binary(
        name = name,
        srcs = [src],
        deps = [":examples_rclpy_executors_library"],
    )
    for name, src in EXECUTABLES.items()
]

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        name: "examples_rclpy_executors.{0}:main".format(name)
        for name in EXECUTABLES.keys()
    },
    package_xml = "package.xml",
    python = [":examples_rclpy_executors_library"],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
