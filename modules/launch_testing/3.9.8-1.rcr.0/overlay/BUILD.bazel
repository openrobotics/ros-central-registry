load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

filegroup(
    name = "_test_data_0",
    srcs = [
        "example_processes/exit_code_proc.py",
        "example_processes/good_proc.py",
        "example_processes/terminating_proc.py",
    ],
)

filegroup(
    name = "_test_data_1",
    srcs = [
        "example_processes/exit_code_proc.py",
        "example_processes/good_proc.py",
        "example_processes/terminating_proc.py",
    ],
)

exports_files(["defs.bzl"])

ament_index(
    name = "ament_index",
    data = ["//test:_root_test_files_0"],
    data_strip_prefix = "test/launch_testing",
    lib_data = [
        "example_processes/exit_code_proc.py",
        "example_processes/good_proc.py",
        "example_processes/terminating_proc.py",
    ],
    package_xml = "package.xml",
)

py_library(
    name = "launch_testing",
    srcs = [
        "launch_testing/__init__.py",
        "launch_testing/actions/__init__.py",
        "launch_testing/actions/gtest.py",
        "launch_testing/actions/pytest.py",
        "launch_testing/actions/ready.py",
        "launch_testing/actions/test.py",
        "launch_testing/asserts/__init__.py",
        "launch_testing/asserts/assert_exit_codes.py",
        "launch_testing/asserts/assert_output.py",
        "launch_testing/asserts/assert_sequential_output.py",
        "launch_testing/decorator.py",
        "launch_testing/event_handlers/__init__.py",
        "launch_testing/event_handlers/stdout_ready_listener.py",
        "launch_testing/io_handler.py",
        "launch_testing/junitxml.py",
        "launch_testing/launch_test.py",
        "launch_testing/legacy/__init__.py",
        "launch_testing/legacy/output.py",
        "launch_testing/loader.py",
        "launch_testing/markers.py",
        "launch_testing/parametrize.py",
        "launch_testing/parse_arguments.py",
        "launch_testing/print_arguments.py",
        "launch_testing/proc_info_handler.py",
        "launch_testing/pytest/__init__.py",
        "launch_testing/pytest/hooks.py",
        "launch_testing/pytest/hookspecs.py",
        "launch_testing/ready_aggregator.py",
        "launch_testing/ready_to_test_action_timeout.py",
        "launch_testing/test_result.py",
        "launch_testing/test_runner.py",
        "launch_testing/tools/__init__.py",
        "launch_testing/tools/output.py",
        "launch_testing/tools/process.py",
        "launch_testing/tools/text.py",
        "launch_testing/util/__init__.py",
        "launch_testing/util/proc_lookup.py",
    ],
    data = ["launch_testing/py.typed"] + [":ament_index"],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@launch",
        requirement("osrf-pycommon"),
        requirement("pytest"),
    ],
)

ament_package(
    name = "ament_package",
    console_programs = {"launch_test": "launch_testing.launch_test:main"},
    data = ["//test:_root_test_files_1"],
    package_xml = "package.xml",
    python = [":launch_testing"] + ["launch_testing/py.typed"],
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@launch//:ament_package",
        "@launch_xml//:ament_package",
        "@launch_yaml//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
