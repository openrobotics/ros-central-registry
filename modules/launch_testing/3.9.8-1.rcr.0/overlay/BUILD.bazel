load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### DATA

ament_index(
    name = "ament_index",
    data = glob(
        ["test/launch_testing/examples/*"],
        exclude = ["test/launch_testing/examples/_*"],
    ),
    data_strip_prefix = "test/launch_testing",
    lib_data = glob(["example_processes/**"]),
    package_xml = "package.xml",
)

### PYTHON MODULE

py_library(
    name = "launch_testing",
    srcs = glob(["launch_testing/**/*.py"]),
    data = glob(
        ["launch_testing/**"],
        exclude = ["launch_testing/**/*.py"],
    ) + [":ament_index"],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@launch",
        requirement("osrf-pycommon"),
        requirement("pytest"),
    ],
)

### TEST

[
    py_pytest(
        name = f.split("/")[-1].removesuffix(".py"),
        srcs = [f],
        data = glob([
            "test/launch_testing/**",
            "example_processes/**",
        ]) + ["test/conftest.py"],
        deps = [
            ":launch_testing",
            "@rules_python//python/runfiles",
        ],
    )
    for f in glob(
        ["test/launch_testing/**/test_*.py"],
        allow_empty = True,
        exclude = [
            "**/test_flake8.py",
            "**/test_pep257.py",
            "**/test_copyright.py",
        ],
    )
]

# Example launch tests: collected through the launch_testing pytest plugin
# (registered via the pytest11 entry point upstream) with the extra launch
# arguments from upstream's pytest.ini addopts.
[
    py_pytest(
        name = f.split("/")[-1].removesuffix(".py"),
        srcs = [f],
        args = [
            "-p",
            "launch_testing.pytest.hooks",
            "--launch-args",
            "dut_arg:=test",
            "--",
        ],
        data = glob([
            "test/launch_testing/examples/**",
            "example_processes/**",
        ]),
        deps = [
            ":launch_testing",
            "@rules_python//python/runfiles",
        ],
    )
    for f in glob(
        ["test/launch_testing/examples/*_test.py"],
        allow_empty = True,
    )
]

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/launch_testing/test_{0}.py".format(linter)],
        data = glob(
            ["**/*"],
            exclude = ["pytest.ini"],
        ),
        deps = [
            ":launch_testing",
            "@ament_{0}".format(linter),
        ],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
    ]
]

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(
            ["**/*"],
            exclude = ["pytest.ini"],
        ),
        deps = [
            ":launch_testing",
            "@ament_{0}".format(linter),
        ],
    )
    for linter in [
        "xmllint",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    console_programs = {"launch_test": "launch_testing.launch_test:main"},
    # setup.py: ('share/launch_testing/examples', glob('test/launch_testing/examples/[!_]**'))
    data = glob(
        ["test/launch_testing/examples/*"],
        exclude = ["test/launch_testing/examples/_*"],
    ),
    data_strip_prefix = "test/launch_testing",
    package_xml = "package.xml",
    python = [":launch_testing"] + glob(
        ["launch_testing/py.typed"],
        allow_empty = True,
    ),
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@launch//:ament_package",
        "@launch_xml//:ament_package",
        "@launch_yaml//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
