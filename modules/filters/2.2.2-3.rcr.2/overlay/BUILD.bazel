    name = "transfer_function",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":transfer_function_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":mean",
        ":params",
        ":increment",
        ":median",
        ":transfer_function",
    ],
)

ament_index(
    name = "ament_index",
    export_name = "filters",
    libraries = [
        ":mean",
        ":increment",
        ":median",
        ":transfer_function",
    ],
    package_xml = "package.xml",
    plugins = ["default_plugins.xml"],
)

HEADERS = [
    "include/filters/filter_base.h",
    "include/filters/filter_base.hpp",
    "include/filters/filter_chain.h",
    "include/filters/filter_chain.hpp",
    "include/filters/increment.h",
    "include/filters/increment.hpp",
    "include/filters/mean.h",
    "include/filters/mean.hpp",
    "include/filters/median.h",
    "include/filters/median.hpp",
    "include/filters/param_test.h",
    "include/filters/param_test.hpp",
    "include/filters/realtime_circular_buffer.h",
    "include/filters/realtime_circular_buffer.hpp",
    "include/filters/transfer_function.h",
    "include/filters/transfer_function.hpp",
]

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "Boost",
        "pluginlib",
        "rclcpp",
    ],
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    cmake_export_name = "export_filters",
    headers = HEADERS,
    libraries = [
        ":mean",
        ":params",
        ":increment",
        ":median",
        ":transfer_function",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
