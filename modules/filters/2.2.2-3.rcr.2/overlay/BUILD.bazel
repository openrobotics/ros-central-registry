### PACKAGING

HEADERS = glob([
    "include/**/*.h",
    "include/**/*.hpp",
])

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "Boost",
        "pluginlib",
        "rclcpp",
    ],
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    cmake_export_name = "export_filters",
    headers = HEADERS,
    libraries = [
        ":mean",
        ":params",
        ":increment",
        ":median",
        ":transfer_function",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
