load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

cc_library(
    name = "realtime_circular_buffer",
    hdrs = [
        "include/filters/realtime_circular_buffer.h",
        "include/filters/realtime_circular_buffer.hpp",
    ],
    includes = ["include"],
    deps = ["@rosdistro//cc:boost.circular_buffer"],
)

cc_library(
    name = "filter_base",
    hdrs = [
        "include/filters/filter_base.h",
        "include/filters/filter_base.hpp",
    ],
    includes = ["include"],
    deps = ["@rclcpp//:rclcpp_library"],
)

cc_library(
    name = "filter_chain",
    hdrs = [
        "include/filters/filter_chain.h",
        "include/filters/filter_chain.hpp",
    ],
    includes = ["include"],
    deps = [
        ":filter_base",
        "@pluginlib//:pluginlib_library",
    ],
)

cc_library(
    name = "filters",
    hdrs = [
        "include/filters/filter_base.h",
        "include/filters/filter_base.hpp",
        "include/filters/filter_chain.h",
        "include/filters/filter_chain.hpp",
        "include/filters/increment.h",
        "include/filters/increment.hpp",
        "include/filters/mean.h",
        "include/filters/mean.hpp",
        "include/filters/median.h",
        "include/filters/median.hpp",
        "include/filters/param_test.h",
        "include/filters/param_test.hpp",
        "include/filters/realtime_circular_buffer.h",
        "include/filters/realtime_circular_buffer.hpp",
        "include/filters/transfer_function.h",
        "include/filters/transfer_function.hpp",
    ],
    includes = ["include"],
    deps = [
        ":filter_base",
        ":filter_chain",
        ":realtime_circular_buffer",
    ],
)

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

cc_library(
    name = "mean_library",
    srcs = ["src/mean.cpp"],
    hdrs = [
        "include/filters/mean.h",
        "include/filters/mean.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":filter_base",
        ":realtime_circular_buffer",
    ],
)

cc_shared_library(
    name = "mean",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mean_library"],
)

cc_library(
    name = "params_library",
    srcs = ["src/test_params.cpp"],
    hdrs = [
        "include/filters/param_test.h",
        "include/filters/param_test.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [":filter_base"],
)

cc_shared_library(
    name = "params",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":params_library"],
)

cc_library(
    name = "increment_library",
    srcs = ["src/increment.cpp"],
    hdrs = [
        "include/filters/increment.h",
        "include/filters/increment.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":filter_base",
        ":realtime_circular_buffer",
    ],
)

cc_shared_library(
    name = "increment",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":increment_library"],
)

cc_library(
    name = "median_library",
    srcs = ["src/median.cpp"],
    hdrs = [
        "include/filters/median.h",
        "include/filters/median.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":filter_base",
        ":realtime_circular_buffer",
    ],
)

cc_shared_library(
    name = "median",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":median_library"],
)

cc_library(
    name = "transfer_function_library",
    srcs = ["src/transfer_function.cpp"],
    hdrs = [
        "include/filters/transfer_function.h",
        "include/filters/transfer_function.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
