load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### INTERFACE LIBRARIES

cc_library(
    name = "realtime_circular_buffer",
    hdrs = [
        "include/filters/realtime_circular_buffer.h",
        "include/filters/realtime_circular_buffer.hpp",
    ],
    includes = ["include"],
    deps = [
        "@rosdistro//cc:boost.circular_buffer",
    ],
)

cc_library(
    name = "filter_base",
    hdrs = [
        "include/filters/filter_base.h",
        "include/filters/filter_base.hpp",
    ],
    includes = ["include"],
    deps = [
        "@rclcpp//:rclcpp_library",
    ],
)

cc_library(
    name = "filter_chain",
    hdrs = [
        "include/filters/filter_chain.h",
        "include/filters/filter_chain.hpp",
    ],
    includes = ["include"],
    deps = [
        ":filter_base",
        "@pluginlib//:pluginlib_library",
    ],
)

cc_library(
    name = "filters",
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.hpp",
    ]),
    includes = ["include"],
    deps = [
        ":filter_base",
        ":filter_chain",
        ":realtime_circular_buffer",
    ],
)

### PLUGIN LIBRARIES

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

cc_library(
    name = "mean_library",
    srcs = ["src/mean.cpp"],
    hdrs = [
        "include/filters/mean.h",
        "include/filters/mean.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":filter_base",
        ":realtime_circular_buffer",
    ],
)

cc_shared_library(
    name = "mean",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":mean_library"],
    deps = [":mean_library"],
)

cc_library(
    name = "params_library",
    srcs = ["src/test_params.cpp"],
    hdrs = [
        "include/filters/param_test.h",
        "include/filters/param_test.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":filter_base",
    ],
)

cc_shared_library(
    name = "params",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":params_library"],
    deps = [":params_library"],
)

cc_library(
    name = "increment_library",
    srcs = ["src/increment.cpp"],
    hdrs = [
        "include/filters/increment.h",
        "include/filters/increment.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":filter_base",
        ":realtime_circular_buffer",
    ],
)

cc_shared_library(
    name = "increment",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":increment_library"],
    deps = [":increment_library"],
)

cc_library(
    name = "median_library",
    srcs = ["src/median.cpp"],
    hdrs = [
        "include/filters/median.h",
        "include/filters/median.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":filter_base",
        ":realtime_circular_buffer",
    ],
)

cc_shared_library(
    name = "median",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":median_library"],
    deps = [":median_library"],
)

cc_library(
    name = "transfer_function_library",
    srcs = ["src/transfer_function.cpp"],
    hdrs = [
        "include/filters/transfer_function.h",
        "include/filters/transfer_function.hpp",
    ],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":filter_base",
        ":realtime_circular_buffer",
    ],
)

cc_shared_library(
    name = "transfer_function",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":transfer_function_library"],
    deps = [":transfer_function_library"],
)

### TRANSITIVE DYNAMIC DEPS

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":mean",
        ":params",
        ":increment",
        ":median",
        ":transfer_function",
    ],
    visibility = ["//visibility:private"],
)

### AMENT INDEX

ament_index(
    name = "ament_index",
    export_name = "filters",
    libraries = [
        ":mean",
        ":increment",
        ":median",
        ":transfer_function",
    ],
    package_xml = "package.xml",
    plugins = ["default_plugins.xml"],
)

### TESTS

cc_test(
    name = "median_test",
    srcs = ["test/test_median.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        ":median_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "transfer_function_test",
