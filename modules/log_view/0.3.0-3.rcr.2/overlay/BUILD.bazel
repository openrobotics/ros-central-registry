load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:ncurses": "@rosdistro//cc:ncurses_library",
    "@rosdistro//cc:ncurses_panel": "@rosdistro//cc:ncurses_panel_library",
}

CC_DEPS = [
    "@rcl_interfaces//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "log_view_library",
    srcs = [
        "src/log_filter.cpp",
        "src/log_store.cpp",
        "src/log_view.cpp",
        "src/panel_interface.cpp",
        "src/panels/details_panel.cpp",
        "src/panels/exclude_panel.cpp",
        "src/panels/filter_panel.cpp",
        "src/panels/help_panel.cpp",
        "src/panels/level_panel.cpp",
        "src/panels/log_panel.cpp",
        "src/panels/node_panel.cpp",
        "src/panels/search_panel.cpp",
        "src/panels/status_panel.cpp",
        "src/utils.cpp",
    ],
    hdrs = [
        "include/log_view/datatypes.h",
        "include/log_view/log_filter.h",
        "include/log_view/log_store.h",
        "include/log_view/log_view.h",
        "include/log_view/panel_interface.h",
        "include/log_view/panels/details_panel.h",
        "include/log_view/panels/exclude_panel.h",
        "include/log_view/panels/filter_panel.h",
        "include/log_view/panels/help_panel.h",
        "include/log_view/panels/level_panel.h",
        "include/log_view/panels/log_panel.h",
        "include/log_view/panels/node_panel.h",
        "include/log_view/panels/search_panel.h",
        "include/log_view/panels/status_panel.h",
        "include/log_view/utils.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/log_view",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "log_view",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":log_view_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":log_view"],
)

cc_binary(
    name = "log_viewer",
    srcs = ["src/main.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/log_view",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":log_view_library"],
)

ament_index(
    name = "ament_index",
    data = ["CONTRIBUTING.md"],
    lib_data = [":log_viewer"],
    libraries = [":log_view"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "rcl_interfaces",
    ],
    cmake_export_include_directories = False,
    cmake_export_targets = False,
    libraries = [":log_view"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
    ],
)
