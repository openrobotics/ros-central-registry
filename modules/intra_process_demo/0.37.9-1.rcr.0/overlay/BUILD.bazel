load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/image_pipeline/camera_node.hpp",
    "include/image_pipeline/common.hpp",
    "include/image_pipeline/image_view_node.hpp",
    "include/image_pipeline/watermark_node.hpp",
]

PIPELINE_DEPENDENCIES = {
    "@example_interfaces//:cc_shared": "@example_interfaces//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
}

IMAGE_PIPELINE_DEPENDENCIES = PIPELINE_DEPENDENCIES | {
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
}

collect_transitive_dynamic_deps(
    name = "pipeline_transitive_dynamic_deps",
    dynamic_deps = PIPELINE_DEPENDENCIES.keys(),
)

collect_transitive_dynamic_deps(
    name = "image_pipeline_transitive_dynamic_deps",
    dynamic_deps = IMAGE_PIPELINE_DEPENDENCIES.keys(),
)

# Mirrors upstream CMakeLists.txt: these only link rclcpp + example_interfaces.
PIPELINE_EXECUTABLES = {
    "cyclic_pipeline": "src/cyclic_pipeline/cyclic_pipeline.cpp",
    "two_node_pipeline": "src/two_node_pipeline/two_node_pipeline.cpp",
}

IMAGE_PIPELINE_EXECUTABLES = {
    "camera_node": "src/image_pipeline/camera_node.cpp",
    "image_pipeline_all_in_one": "src/image_pipeline/image_pipeline_all_in_one.cpp",
    "image_pipeline_with_two_image_view": "src/image_pipeline/image_pipeline_with_two_image_view.cpp",
    "image_view_node": "src/image_pipeline/image_view_node.cpp",
    "watermark_node": "src/image_pipeline/watermark_node.cpp",
}

EXECUTABLES = PIPELINE_EXECUTABLES | IMAGE_PIPELINE_EXECUTABLES

[cc_binary(
    name = name,
    srcs = [src],
    dynamic_deps = [":pipeline_transitive_dynamic_deps"],
    deps = PIPELINE_DEPENDENCIES.values(),
) for name, src in PIPELINE_EXECUTABLES.items()]

[cc_binary(
    name = name,
    srcs = HEADERS + [src],
    dynamic_deps = [":image_pipeline_transitive_dynamic_deps"],
    includes = ["include"],
    deps = IMAGE_PIPELINE_DEPENDENCIES.values(),
) for name, src in IMAGE_PIPELINE_EXECUTABLES.items()]

write_file(
    name = "rmw_test_fixture_implementation_py",
    out = "rmw_test_fixture_implementation.py",
    content = [
        "def rmw_test_isolation_start(): pass",
        "def rmw_test_isolation_stop(): pass",
    ],
)

py_library(
    name = "rmw_test_fixture_implementation",
    srcs = [":rmw_test_fixture_implementation_py"],
    imports = ["."],
)

ament_package(
    name = "ament_package",
    cmake_export_targets = False,
    executables = [":{0}".format(e) for e in EXECUTABLES.keys()],
    headers = HEADERS,
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@example_interfaces//:ament_package",
        "@launch//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rmw_implementation_cmake//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
