load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@launch_testing_ros//:defs.bzl", "launch_ros_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

[cmake_configure_file(
    name = "test_demo_{}_py".format(exe),
    src = "test_executables_demo.py.in",
    out = "test_demo_{}.py".format(exe),
    defines = [
        "RCLCPP_DEMOS_EXECUTABLE=../intra_process_demo+/{}".format(exe),
        "RCLCPP_DEMOS_EXPECTED_OUTPUT=../intra_process_demo+/test/{}".format(exe),
    ],
) for exe in [
    "cyclic_pipeline",
    "two_node_pipeline",
]]

launch_ros_test(
    name = "test_demo_cyclic_pipeline",
    src = "test_demo_cyclic_pipeline_py",
    data = [
        "cyclic_pipeline.regex",
    ],
    deps = [
        "//:cyclic_pipeline",
        "//:rmw_test_fixture_implementation",
        "@rules_python//python/runfiles",
    ],
)

launch_ros_test(
    name = "test_demo_two_node_pipeline",
    src = "test_demo_two_node_pipeline_py",
    data = [
        "two_node_pipeline.regex",
    ],
    deps = [
        "//:rmw_test_fixture_implementation",
        "//:two_node_pipeline",
        "@rules_python//python/runfiles",
    ],
)
