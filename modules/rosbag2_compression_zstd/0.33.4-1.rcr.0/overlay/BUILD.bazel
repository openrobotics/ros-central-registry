load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/rosbag2_compression_zstd/visibility_control.hpp",
    "include/rosbag2_compression_zstd/zstd_compressor.hpp",
    "include/rosbag2_compression_zstd/zstd_decompressor.hpp",
]

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosbag2_compression//:rosbag2_compression": "@rosbag2_compression//:rosbag2_compression_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosdistro//cc:zstd": "@rosdistro//cc:zstd_library",
}

cc_library(
    name = "rosbag2_compression_zstd_library",
    srcs = [
        "src/rosbag2_compression_zstd/compression_utils.cpp",
        "src/rosbag2_compression_zstd/compression_utils.hpp",
        "src/rosbag2_compression_zstd/logging.hpp",
        "src/rosbag2_compression_zstd/zstd_compressor.cpp",
        "src/rosbag2_compression_zstd/zstd_decompressor.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rosbag2_compression_zstd",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rosbag2_compression_zstd_library"],
)

ament_index(
    name = "ament_index_package",
    package_xml = "package.xml",
)

ament_index(
    name = "ament_index_plugin",
    libraries = [":rosbag2_compression_zstd"],
    package_xml = "package.xml",
    plugin_category = "rosbag2_compression",
    plugins = ["plugin_description.xml"],
)

TEST_DEPENDENCIES = DEPENDENCIES | {
    ":rosbag2_compression_zstd": ":rosbag2_compression_zstd_library",
    "@rosbag2_test_common": "@rosbag2_test_common//:rosbag2_test_common_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
)

ament_package(
    name = "ament_package",
    cmake_export_name = "export_rosbag2_compression_zstd",
    headers = HEADERS,
    libraries = [":rosbag2_compression_zstd"],
    package_xml = "package.xml",
    deps = [
        ":ament_index_package",
        ":ament_index_plugin",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rcutils//:ament_package",
        "@rosbag2_compression//:ament_package",
        "@rosbag2_test_common//:ament_package",
        "@rosdistro//:ament_package",
        "@zstd_cmake_module//:ament_package",
    ],
)
