load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

alias(
    name = "mrpt_core",
    actual = "@mrpt_core//:mrpt_core",
)

alias(
    name = "mrpt_core_library",
    actual = "@mrpt_core//:mrpt_core_library",
)

DEPENDENCIES = {
    "@mrpt_core//:mrpt_core": "@mrpt_core//:mrpt_core_library",
}

CC_DEPS = [
    "@mrpt_typemeta//:mrpt_typemeta_library",
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
]

cc_library(
    name = "mrpt_rtti_library",
    srcs = [
        "src/CListOfClasses.cpp",
        "src/CObject.cpp",
        "src/internal_class_registry.cpp",
    ],
    hdrs = [
        "include/mrpt/rtti/CListOfClasses.h",
        "include/mrpt/rtti/CObject.h",
        "include/mrpt/rtti/registerAllClasses.h",
        "src/internal_class_registry.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_rtti",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mrpt_rtti_library"],
)

cc_library(
    name = "_bindings.cpython-314-x86_64-linux-gnu_library",
    srcs = ["python_bindings/mrpt_rtti_py.cpp"],
    hdrs = [
        "include/mrpt/rtti/CListOfClasses.h",
        "include/mrpt/rtti/CObject.h",
        "include/mrpt/rtti/registerAllClasses.h",
        "src/internal_class_registry.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":mrpt_rtti_library"],
)

cc_shared_library(
    name = "_bindings.cpython-314-x86_64-linux-gnu",
    dynamic_deps = DEPENDENCIES.keys() + [":mrpt_rtti"],
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "mrpt/rtti/_bindings.so",
    deps = [":_bindings.cpython-314-x86_64-linux-gnu_library"],
)

py_library(
    name = "mrpt",
    srcs = ["python/mrpt/rtti/__init__.py"],
    imports = ["python"],
    deps = ["@mrpt_core//:mrpt"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_rtti",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_rtti": [
            "libmrpt_rtti.so.3.3",
            "libmrpt_rtti.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_common//:ament_package",
        "@mrpt_core//:ament_package",
        "@mrpt_typemeta//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    egg_info = False,
    headers = [
        "include/mrpt/rtti/CListOfClasses.h",
        "include/mrpt/rtti/CObject.h",
        "include/mrpt/rtti/registerAllClasses.h",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mrpt_rtti",
    ],
    package_xml = "package.xml",
    python = [
        ":mrpt",
        ":_bindings.cpython-314-x86_64-linux-gnu",
    ],
    python_strip_prefix = "python",
    sonames = {
        "mrpt_rtti": [
            "libmrpt_rtti.so.3.3",
            "libmrpt_rtti.so.3.3.1",
        ],
    },
    deps = [":ament_index"] + [
        "@mrpt_common//:ament_package",
        "@mrpt_core//:ament_package",
        "@mrpt_typemeta//:ament_package",
    ],
)
