load("@qt//:qt.bzl", "qt_cc_library", "qt_cc_shared_library")
load("@rosdistro//ament:ament_resource.bzl", "register_ament_resource")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
)

DEPENDENCIES = {}

# Mirrors find_package(Qt6 COMPONENTS Core Quick Multimedia).
QT_DEPS = [
    "@qtbase//:core",
    "@qtbase//:gui",
    "@qtdeclarative//:qml",
    "@qtdeclarative//:quick",
    "@qtmultimedia//:multimedia",
]

CC_DEPS = QT_DEPS

qt_cc_library(
    name = "rqml_default_plugins_cpp_library",
    srcs = ["RQml/DefaultPlugins/depth_image_processor.cpp"],
    hdrs = ["RQml/DefaultPlugins/depth_image_processor.hpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = ["RQml/DefaultPlugins"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

qt_cc_shared_library(
    name = "rqml_default_plugins_cpp",
    dynamic_deps = DEPENDENCIES.keys(),
    qt_deps = QT_DEPS,
    deps = [":rqml_default_plugins_cpp_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

register_ament_resource(
    name = "res_rqml_plugin",
    category = "rqml_plugin",
    content = 'plugins:\n  - id: default_plugins.action_caller\n    name: "Action Caller"\n    group: "Communication"\n    path: "share/rqml_default_plugins/qml/ActionCaller.qml"\n    single_instance: false\n  - id: default_plugins.console\n    name: "Console"\n    group: "Introspection"\n    path: "share/rqml_default_plugins/qml/Console.qml"\n    single_instance: false\n  - id: default_plugins.controller_manager\n    name: "Controller Manager"\n    group: "Control"\n    path: "share/rqml_default_plugins/qml/ControllerManager.qml"\n    single_instance: false\n  - id: default_plugins.controller_manager_statistics\n    name: "Controller Manager Statistics"\n    group: "Introspection"\n    path: "share/rqml_default_plugins/qml/ControllerManagerStatistics.qml"\n    single_instance: false\n  - id: default_plugins.image_view\n    name: "Image View"\n    group: "Video"\n    path: "share/rqml_default_plugins/qml/ImageView.qml"\n    single_instance: false\n  - id: default_plugins.joint_trajectory_controller\n    name: "Joint Trajectory Controller"\n    group: "Control"\n    path: "share/rqml_default_plugins/qml/JointTrajectoryController.qml"\n    single_instance: false\n  - id: default_plugins.moveit_controller\n    name: "MoveIt Controller"\n    group: "Control"\n    path: "share/rqml_default_plugins/qml/MoveItController.qml"\n    single_instance: false\n  - id: default_plugins.message_publisher\n    name: "Message Publisher"\n    group: "Communication"\n    path: "share/rqml_default_plugins/qml/MessagePublisher.qml"\n    single_instance: false\n  - id: default_plugins.parameter_editor\n    name: "Parameter Editor"\n    group: "Configuration"\n    path: "share/rqml_default_plugins/qml/ParameterEditor.qml"\n    single_instance: false\n  - id: default_plugins.robot_steering\n    name: "Robot Steering"\n    group: "Control"\n    path: "share/rqml_default_plugins/qml/RobotSteering.qml"\n    single_instance: false\n  - id: default_plugins.service_caller\n    name: "Service Caller"\n    group: "Communication"\n    path: "share/rqml_default_plugins/qml/ServiceCaller.qml"\n    single_instance: false\n  - id: default_plugins.tf_tree_viewer\n    name: "TF Tree Viewer"\n    group: "Introspection"\n    path: "share/rqml_default_plugins/qml/TfTreeViewer.qml"\n    single_instance: false\n  - id: default_plugins.topic_monitor\n    name: "Topic Monitor"\n    group: "Introspection"\n    path: "share/rqml_default_plugins/qml/TopicMonitor.qml"\n    single_instance: false\n',
)

register_ament_files(
    name = "ament_files_0",
    files = [":rqml_default_plugins_cpp"],
    prefix = "RQml/DefaultPlugins",
    strip_prefix = "*",
)

ament_index(
    name = "ament_index",
    data = [
        "qml/ActionCaller.qml",
        "qml/Console.qml",
        "qml/ControllerManager.qml",
        "qml/ControllerManagerStatistics.qml",
        "qml/ImageView.qml",
        "qml/JointTrajectoryController.qml",
        "qml/MessagePublisher.qml",
        "qml/MoveItController.qml",
        "qml/ParameterEditor.qml",
        "qml/ParameterModelLogic.js",
        "qml/RobotSteering.qml",
        "qml/ServiceCaller.qml",
        "qml/TfTreeViewer.qml",
        "qml/TopicMonitor.qml",
        "qml/elements/BoxPlotItem.qml",
        "qml/elements/ControllerInfoDialog.qml",
        "qml/elements/HardwareComponentInfoDialog.qml",
        "qml/elements/LogLevelIndicator.qml",
        "qml/elements/ParameterEditor/ArrayEditDialog.qml",
        "qml/elements/ParameterEditor/ArrayParameterEditor.qml",
        "qml/elements/ParameterEditor/BoolParameterEditor.qml",
        "qml/elements/ParameterEditor/NumericParameterEditor.qml",
        "qml/elements/ParameterEditor/StringParameterEditor.qml",
        "qml/elements/TfGraphView.qml",
        "qml/elements/TfListView.qml",
        "qml/elements/TfTransformDisplay.qml",
        "qml/interfaces/ControllerManagerInterface.qml",
        "qml/interfaces/JointTrajectoryControllerInterface.qml",
        "qml/interfaces/MoveItInterface.qml",
        "qml/interfaces/ParameterService.qml",
        "qml/interfaces/TfTreeInterface.qml",
        "qml/interfaces/XmlUtils.js",
        "qml/interfaces/qmldir",
        "qml/shaders/README.md",
        "qml/shaders/depthimage.frag",
        "qml/shaders/depthimage.frag.qsb",
        "qml/shaders/transparency.frag",
        "qml/shaders/transparency.frag.qsb",
        "qml/shaders/turbo.png",
        ":ament_files_0",
        "//test:mocks/Ros2/qmldir",
    ],
    data_strip_prefixes = ["//test:mocks/Ros2->RQml/DefaultPlugins"],
    package_xml = "package.xml",
    deps = [
        ":res_rqml_plugin",
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@control_msgs//:ament_package",
        "@controller_manager_msgs//:ament_package",
