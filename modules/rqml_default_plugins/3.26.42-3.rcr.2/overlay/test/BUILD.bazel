load("@qt//:qt.bzl", "qt_cc_test")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@qml6_ros2_plugin//:qml6_ros2_plugin": "@qml6_ros2_plugin//:qml6_ros2_plugin_library",
}

# Mirrors find_package(Qt6 COMPONENTS QuickTest) + Qt6::Qml/Qt6::Quick.
CC_DEPS = [
    "@qtbase//:core",
    "@qtbase//:gui",
    "@qtdeclarative//:qml",
    "@qtdeclarative//:quick",
    "@qtdeclarative//:quicktest",
]

exports_files([
    "Utils.qml",
    "mock_classes.cpp",
    "mock_classes.hpp",
    "mock_ros2.cpp",
    "mock_ros2.hpp",
    "mocks/QtQuick/Dialogs/FileDialog.qml",
    "mocks/QtQuick/Dialogs/MessageDialog.qml",
    "mocks/QtQuick/Dialogs/qmldir",
    "mocks/Ros2/ImageTransportSubscription.qml",
    "mocks/Ros2/TfBuffer.qml",
    "mocks/Ros2/TfTransform.qml",
    "mocks/Ros2/qmldir",
    "test_plugins.cpp",
    "tst_ActionCaller.qml",
    "tst_Console.qml",
    "tst_ControllerManager.qml",
    "tst_ControllerManagerStatistics.qml",
    "tst_ImageView.qml",
    "tst_JointTrajectoryController.qml",
    "tst_MessagePublisher.qml",
    "tst_MoveItController.qml",
    "tst_ParameterEditor.qml",
    "tst_RobotSteering.qml",
    "tst_ServiceCaller.qml",
    "tst_TfTreeViewer.qml",
    "tst_TopicMonitor.qml",
])

cc_library(
    name = "test_helpers",
    testonly = True,
    hdrs = [
        "mock_classes.hpp",
        "mock_ros2.hpp",
    ],
    includes = ["."],
    visibility = ["//visibility:private"],
)

collect_transitive_dynamic_deps(
    name = "test_dynamic_deps",
    testonly = True,
    dynamic_deps = DEPENDENCIES.keys(),
)

qt_cc_test(
    name = "test_plugins",
    srcs = [
        "mock_classes.cpp",
        "mock_ros2.cpp",
        "test_plugins.cpp",
    ],
    hdrs = [
        "mock_classes.hpp",
        "mock_ros2.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        "//:ament_index",
        "//:rqml_default_plugins_cpp",
    ] + [
        "Utils.qml",
        "mocks/QtQuick/Dialogs/FileDialog.qml",
        "mocks/QtQuick/Dialogs/MessageDialog.qml",
        "mocks/QtQuick/Dialogs/qmldir",
        "mocks/Ros2/ImageTransportSubscription.qml",
        "mocks/Ros2/TfBuffer.qml",
        "mocks/Ros2/TfTransform.qml",
        "mocks/Ros2/qmldir",
        "tst_ActionCaller.qml",
        "tst_Console.qml",
        "tst_ControllerManager.qml",
        "tst_ControllerManagerStatistics.qml",
        "tst_ImageView.qml",
        "tst_JointTrajectoryController.qml",
        "tst_MessagePublisher.qml",
        "tst_MoveItController.qml",
        "tst_ParameterEditor.qml",
        "tst_RobotSteering.qml",
        "tst_ServiceCaller.qml",
        "tst_TfTreeViewer.qml",
        "tst_TopicMonitor.qml",
    ],
    dynamic_deps = [
        ":test_dynamic_deps",
        "//:transitive_dynamic_deps",
    ],
    includes = ["."],
    local_defines = ros_local_defines() + [
        'QUICK_TEST_SOURCE_DIR=\\"test\\"',
        "RCLCPP_VERSION_MAJOR=32",
    ],
    moc_srcs = [
        "mock_classes.cpp",
        "test_plugins.cpp",
    ],
    # xfail: fails under Bazel: double free or corruption (out)
    tags = [
        "manual",
        "xfail",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:rqml_default_plugins_cpp_library",
        "@rosdistro//cc:bazel_test_helper",
    ],
)
