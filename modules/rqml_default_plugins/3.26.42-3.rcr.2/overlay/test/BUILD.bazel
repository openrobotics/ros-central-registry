load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {}

CC_DEPS = []

exports_files([
    "Utils.qml",
    "mock_classes.cpp",
    "mock_classes.hpp",
    "mock_ros2.cpp",
    "mock_ros2.hpp",
    "mocks/QtQuick/Dialogs/FileDialog.qml",
    "mocks/QtQuick/Dialogs/MessageDialog.qml",
    "mocks/QtQuick/Dialogs/qmldir",
    "mocks/Ros2/ImageTransportSubscription.qml",
    "mocks/Ros2/TfBuffer.qml",
    "mocks/Ros2/TfTransform.qml",
    "mocks/Ros2/qmldir",
    "test_plugins.cpp",
    "tst_ActionCaller.qml",
    "tst_Console.qml",
    "tst_ControllerManager.qml",
    "tst_ControllerManagerStatistics.qml",
    "tst_ImageView.qml",
    "tst_JointTrajectoryController.qml",
    "tst_MessagePublisher.qml",
    "tst_MoveItController.qml",
    "tst_ParameterEditor.qml",
    "tst_RobotSteering.qml",
    "tst_ServiceCaller.qml",
    "tst_TfTreeViewer.qml",
    "tst_TopicMonitor.qml",
])

cc_test(
    name = "test_plugins",
    srcs = [
        "mock_classes.cpp",
        "mock_ros2.cpp",
        "test_plugins.cpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        "//:ament_index",
        "//:rqml_default_plugins_cpp",
    ] + [
        "Utils.qml",
        "mocks/QtQuick/Dialogs/FileDialog.qml",
        "mocks/QtQuick/Dialogs/MessageDialog.qml",
        "mocks/QtQuick/Dialogs/qmldir",
        "mocks/Ros2/ImageTransportSubscription.qml",
        "mocks/Ros2/TfBuffer.qml",
        "mocks/Ros2/TfTransform.qml",
        "mocks/Ros2/qmldir",
        "tst_ActionCaller.qml",
        "tst_Console.qml",
        "tst_ControllerManager.qml",
        "tst_ControllerManagerStatistics.qml",
        "tst_ImageView.qml",
        "tst_JointTrajectoryController.qml",
        "tst_MessagePublisher.qml",
        "tst_MoveItController.qml",
        "tst_ParameterEditor.qml",
        "tst_RobotSteering.qml",
        "tst_ServiceCaller.qml",
        "tst_TfTreeViewer.qml",
        "tst_TopicMonitor.qml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines() + [
        'QUICK_TEST_SOURCE_DIR=\\"test\\"',
        "RCLCPP_VERSION_MAJOR=32",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:rqml_default_plugins_cpp_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)
