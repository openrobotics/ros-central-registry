load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "smach",
    srcs = [
        "smach/__init__.py",
        "smach/concurrence.py",
        "smach/container.py",
        "smach/exceptions.py",
        "smach/iterator.py",
        "smach/log.py",
        "smach/sequence.py",
        "smach/state.py",
        "smach/state_machine.py",
        "smach/user_data.py",
        "smach/util.py",
    ],
    imports = ["."],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":smach"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
