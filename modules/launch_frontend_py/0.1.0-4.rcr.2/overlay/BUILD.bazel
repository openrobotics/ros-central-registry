load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PYTHON LIBRARY

py_library(
    name = "launch_frontend_py",
    srcs = glob(["launch_frontend_py/**/*.py"]),
    data = ["launch_frontend_py/mypy.ini"],
    imports = ["."],
    deps = ["@launch"],
)

### TESTS

py_pytest(
    name = "test_pytests",
    srcs = glob(["test/test_*.py"]),
    data = glob(["test/launch/**"]),
    deps = [
        ":launch_frontend_py",
        "@launch",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    package_xml = "package.xml",
    python = [
        ":launch_frontend_py",
        "launch_frontend_py/mypy.ini",
    ],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_mypy//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@launch//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
