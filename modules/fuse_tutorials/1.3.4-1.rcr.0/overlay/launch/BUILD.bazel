load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "fuse_simple_tutorial.launch.py",
        "range_sensor_tutorial.launch.py",
    ],
)

launch_ros_binary(
    name = "fuse_simple_tutorial_launch",
    src = "fuse_simple_tutorial.launch.py",
    data = [
        "//:ament_index",
    ],
    deps = [
        "@fuse_optimizers//:fixed_lag_smoother_node",
        "@rviz2",
    ],
)

launch_ros_binary(
    name = "range_sensor_tutorial_launch",
    src = "range_sensor_tutorial.launch.py",
    deps = [
        "//:range_sensor_simulator",
        "@fuse_optimizers//:fixed_lag_smoother_node",
        "@rviz2",
        "@tf2_ros//:static_transform_publisher",
    ],
)
