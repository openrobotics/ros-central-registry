load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@fuse_constraints//:fuse_constraints": "@fuse_constraints//:fuse_constraints_library",
    "@fuse_core//:fuse_core": "@fuse_core//:fuse_core_library",
    "@fuse_models//:fuse_models": "@fuse_models//:fuse_models_library",
    "@fuse_msgs//:cc_shared": "@fuse_msgs//:cc",
    "@fuse_publishers//:fuse_publishers": "@fuse_publishers//:fuse_publishers_library",
    "@fuse_variables//:fuse_variables": "@fuse_variables//:fuse_variables_library",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:boost.chrono_shared": "@rosdistro//cc:boost.chrono",
    "@rosdistro//cc:boost.container_shared": "@rosdistro//cc:boost.container",
    "@rosdistro//cc:boost.iostreams_shared": "@rosdistro//cc:boost.iostreams",
    "@rosdistro//cc:boost.serialization_shared": "@rosdistro//cc:boost.serialization",
    "@rosdistro//cc:boost.thread_shared": "@rosdistro//cc:boost.thread",
    "@rosdistro//cc:ceres": "@rosdistro//cc:ceres_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:glog": "@rosdistro//cc:glog_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "fuse_tutorials_library",
    srcs = [
        "src/beacon_publisher.cpp",
        "src/range_constraint.cpp",
        "src/range_sensor_model.cpp",
    ],
    hdrs = [
        "include/fuse_tutorials/beacon_publisher.h",
        "include/fuse_tutorials/beacon_publisher.hpp",
        "include/fuse_tutorials/range_constraint.h",
        "include/fuse_tutorials/range_constraint.hpp",
        "include/fuse_tutorials/range_cost_functor.h",
        "include/fuse_tutorials/range_cost_functor.hpp",
        "include/fuse_tutorials/range_sensor_model.h",
        "include/fuse_tutorials/range_sensor_model.hpp",
    ] + [
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/fuse_tutorials",
    ],
    local_defines = ros_local_defines() + [
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "fuse_tutorials",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":fuse_tutorials_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":fuse_tutorials"],
)

cc_binary(
    name = "range_sensor_simulator",
    srcs = ["src/range_sensor_simulator.cpp"] + [
        "include/fuse_tutorials/beacon_publisher.h",
        "include/fuse_tutorials/beacon_publisher.hpp",
        "include/fuse_tutorials/range_constraint.h",
        "include/fuse_tutorials/range_constraint.hpp",
        "include/fuse_tutorials/range_cost_functor.h",
        "include/fuse_tutorials/range_cost_functor.hpp",
        "include/fuse_tutorials/range_sensor_model.h",
        "include/fuse_tutorials/range_sensor_model.hpp",
    ] + [
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "include",
        "include/fuse_tutorials",
    ],
    local_defines = ros_local_defines() + [
        "GLOG_CUSTOM_PREFIX_SUPPORT",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":fuse_tutorials_library"],
)

ament_index(
    name = "ament_index",
    data = [
        "config/fuse_simple_tutorial.rviz",
        "config/fuse_simple_tutorial.yaml",
        "config/range_sensor_tutorial.rviz",
        "config/range_sensor_tutorial.yaml",
        "data/turtlebot3.bag",
        "//launch:launch_files",
    ],
    lib_data = [":range_sensor_simulator"],
    libraries = [":fuse_tutorials"],
    package_xml = "package.xml",
    plugin_category = "fuse_core",
    plugins = ["fuse_plugins.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@fuse_constraints//:ament_package",
        "@fuse_core//:ament_package",
        "@fuse_models//:ament_package",
        "@fuse_msgs//:ament_package",
        "@fuse_optimizers//:ament_package",
        "@fuse_publishers//:ament_package",
        "@fuse_variables//:ament_package",
        "@gtest_vendor//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rviz2//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "ament_cmake_ros",
        "fuse_constraints",
        "fuse_core",
        "fuse_models",
        "fuse_variables",
        "nav_msgs",
        "rclcpp",
        "sensor_msgs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "fuse_tutorials-export",
    headers = [
        "include/fuse_tutorials/beacon_publisher.h",
        "include/fuse_tutorials/beacon_publisher.hpp",
        "include/fuse_tutorials/range_constraint.h",
        "include/fuse_tutorials/range_constraint.hpp",
        "include/fuse_tutorials/range_cost_functor.h",
        "include/fuse_tutorials/range_cost_functor.hpp",
        "include/fuse_tutorials/range_sensor_model.h",
        "include/fuse_tutorials/range_sensor_model.hpp",
    ],
    libraries = [":fuse_tutorials"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@fuse_constraints//:ament_package",
        "@fuse_core//:ament_package",
        "@fuse_models//:ament_package",
        "@fuse_msgs//:ament_package",
        "@fuse_optimizers//:ament_package",
        "@fuse_publishers//:ament_package",
        "@fuse_variables//:ament_package",
        "@gtest_vendor//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rviz2//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
