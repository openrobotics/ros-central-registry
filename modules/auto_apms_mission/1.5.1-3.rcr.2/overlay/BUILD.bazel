register_ament_resource(
    name = "res_auto_apms_behavior_tree_core__behavior",
    category = "auto_apms_behavior_tree_core__behavior",
    content = "\n".join([
        "tree__internal|orchestrator_base::{}|auto_apms_behavior_tree::TreeFromStringBuildHandler|share/auto_apms_mission/auto_apms/auto_apms_behavior_tree_core/behavior/tree__internal/tree__internal__orchestrator_base::{}__{}|{}|share/auto_apms_behavior_tree/auto_apms/auto_apms_behavior_tree_core/metadata/node_manifest_behavior_tree_nodes.yaml".format(
            tree_id,
            tree_id,
            "orchestrator_base.xml",
            tree_id,
        )
        for tree_id in [
            "MissionOrchestrator",
            "__BringUp__",
            "__HandleContingency__",
            "__HandleEmergency__",
            "__IsContingency__",
            "__IsEmergency__",
            "__MonitorEvents__",
            "__RunMission__",
            "__ShutDown__",
        ]
    ]) + "\n",
)

auto_apms_util_register_plugins(
    name = "plugins_xml",
    out = "_gen/share/auto_apms_mission/auto_apms/auto_apms_mission_plugins.xml",
    plugins = [
        "auto_apms_mission_mission_builders|{}|auto_apms_behavior_tree::TreeBuildHandlerFactoryTemplate<{}>|auto_apms_behavior_tree::TreeBuildHandlerFactoryInterface".format(cls, cls)
        for cls in [
            "auto_apms_mission::MissionFromResourceBuildHandler",
            "auto_apms_mission::MissionFromStringBuildHandler",
            "auto_apms_mission::MultiNodeMissionBuildHandler",
        ]
    ],
)

