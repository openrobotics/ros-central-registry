load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosidl_default_generators//:defs.bzl", "default_generators")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### PACKAGING

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:AIMPlusStatus",
        "//msg:AttCovEuler",
        "//msg:AttEuler",
        "//msg:BaseVectorCart",
        "//msg:BaseVectorGeod",
        "//msg:ExtSensorMeas",
        "//msg:GALAuthStatus",
        "//msg:IMUSetup",
        "//msg:INSNavCart",
        "//msg:INSNavGeod",
        "//msg:MeasEpoch",
        "//msg:MeasEpochChannelType1",
        "//msg:MeasEpochChannelType2",
        "//msg:PVTCartesian",
        "//msg:PVTGeodetic",
        "//msg:PosCovCartesian",
        "//msg:PosCovGeodetic",
        "//msg:RFBand",
        "//msg:RFStatus",
        "//msg:ReceiverTime",
        "//msg:VectorInfoCart",
        "//msg:VectorInfoGeod",
        "//msg:VelCovCartesian",
        "//msg:VelCovGeodetic",
        "//msg:VelSensorSetup",
        "//msg_ros2/msg:BlockHeader",
    ],
)

ament_package(
    name = "ament_package",
    data = glob(["config/**"]),
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@geometry_msgs//:ament_package",
        "@gps_msgs//:ament_package",
        "@gtest_vendor//:ament_package",
        "@nav_msgs//:ament_package",
        "@nmea_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@ros_environment//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_eigen//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
