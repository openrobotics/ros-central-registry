write_file(
    name = "gen_pcap_h",
    out = "_gen/include/pcap.h",
    content = ["#ifndef RCR_PCAP_H_\n#define RCR_PCAP_H_\nstruct pcap {};\ntypedef struct pcap pcap_t;\ninline void pcap_close(pcap_t *) {}\ninline pcap_t * pcap_open_offline(const char *, char *) { return nullptr; }\ninline int pcap_get_selectable_fd(pcap_t *) { return -1; }\n#endif\n"],
)

write_file(
    name = "gen_geographiclib_utmups_hpp",
    out = "_gen/include/GeographicLib/UTMUPS.hpp",
    content = ["#ifndef RCR_GEOGRAPHICLIB_UTMUPS_HPP_\n#define RCR_GEOGRAPHICLIB_UTMUPS_HPP_\n#include <cmath>\n#include <cctype>\n#include <string>\nnamespace GeographicLib {\nclass UTMUPS {\n public:\n  static void Forward(double lat, double lon, int & zone, bool & northp, double & x, double & y, int setzone = -1) {\n    zone = (setzone > 0) ? setzone : (static_cast<int>((lon + 180.0) / 6.0) + 1);\n    northp = (lat >= 0.0);\n    constexpr double kPi = 3.14159265358979323846;\n    constexpr double a = 6378137.0;\n    constexpr double f = 1.0 / 298.257223563;\n    constexpr double k0 = 0.9996;\n    double e2 = f * (2.0 - f);\n    double ep2 = e2 / (1.0 - e2);\n    double phi = lat * kPi / 180.0;\n    double lam = lon * kPi / 180.0;\n    double lam0 = ((zone - 1) * 6 - 180 + 3) * kPi / 180.0;\n    double sin_phi = std::sin(phi), cos_phi = std::cos(phi), tan_phi = std::tan(phi);\n    double N = a / std::sqrt(1.0 - e2 * sin_phi * sin_phi);\n    double T = tan_phi * tan_phi;\n    double C = ep2 * cos_phi * cos_phi;\n    double A = cos_phi * (lam - lam0);\n    double M = a * ((1.0 - e2 / 4.0 - 3.0 * e2 * e2 / 64.0) * phi\n      - (3.0 * e2 / 8.0 + 3.0 * e2 * e2 / 32.0) * std::sin(2.0 * phi)\n      + (15.0 * e2 * e2 / 256.0) * std::sin(4.0 * phi));\n    x = k0 * N * (A + (1.0 - T + C) * A * A * A / 6.0) + 500000.0;\n    y = k0 * (M + N * tan_phi * (A * A / 2.0 + (5.0 - T + 9.0 * C + 4.0 * C * C) * A * A * A * A / 24.0));\n    if (!northp) y += 10000000.0;\n  }\n  static void Forward(double lat, double lon, int & zone, bool & northp, double & x, double & y, double & gamma, double & k, int setzone = -1) {\n    Forward(lat, lon, zone, northp, x, y, setzone);\n    gamma = 0.0;\n    k = 0.9996;\n  }\n  static void DecodeZone(const std::string & zonestr, int & zone, bool & northp) {\n    zone = 0;\n    northp = true;\n    std::size_t i = 0;\n    while (i < zonestr.size() && std::isdigit(static_cast<unsigned char>(zonestr[i]))) {\n      zone = zone * 10 + (zonestr[i] - '0');\n      ++i;\n    }\n    if (i < zonestr.size()) {\n      char c = static_cast<char>(std::toupper(static_cast<unsigned char>(zonestr[i])));\n      northp = (c >= 'N');\n    }\n  }\n  static std::string EncodeZone(int zone, bool northp, bool = true) {\n    return std::to_string(zone) + (northp ? \"n\" : \"s\");\n  }\n};\n}  // namespace GeographicLib\n#endif\n"],
)

write_file(
    name = "gen_atomic_shared_ptr_shim_hpp",
    out = "_gen/include/atomic_shared_ptr_shim.hpp",
    content = ["#if !defined(__cpp_lib_atomic_shared_ptr) && !defined(RCR_ATOMIC_SHARED_PTR_SHIM_HPP_)\n#define RCR_ATOMIC_SHARED_PTR_SHIM_HPP_\n#include <atomic>\n#ifdef __cplusplus\n#include <memory>\n#endif\nnamespace std {\ntemplate <class T>\nstruct atomic<shared_ptr<T>> {\n  shared_ptr<T> ptr_;\n  atomic() noexcept = default;\n  atomic(shared_ptr<T> desired) noexcept : ptr_(std::move(desired)) {}\n  atomic(const atomic&) = delete;\n  void operator=(const atomic&) = delete;\n  void store(shared_ptr<T> desired, memory_order order = memory_order_seq_cst) noexcept {\n    atomic_store_explicit(&ptr_, std::move(desired), order);\n  }\n  shared_ptr<T> load(memory_order order = memory_order_seq_cst) const noexcept {\n    return atomic_load_explicit(&ptr_, order);\n  }\n  operator shared_ptr<T>() const noexcept { return load(); }\n  shared_ptr<T> exchange(shared_ptr<T> desired, memory_order order = memory_order_seq_cst) noexcept {\n    return atomic_exchange_explicit(&ptr_, std::move(desired), order);\n  }\n  void operator=(shared_ptr<T> desired) noexcept { store(std::move(desired)); }\n};\n}  // namespace std\n#endif\n"],
)

