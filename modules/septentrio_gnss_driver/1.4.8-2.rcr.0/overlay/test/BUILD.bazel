cc_test(
    name = "test_parsing_utilities",
    srcs = ["test_parsing_utilities.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [
        "//:ament_index",
        "//:ament_index_extra",
        "//:septentrio_gnss_driver_core",
    ] + ["CMakeLists.txt"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "NDEBUG",
        "ROS2",
        "ROS2_VER_N520",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:septentrio_gnss_driver_core_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

