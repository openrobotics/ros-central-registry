load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {"@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library"}

CC_DEPS = [
    "@can_msgs//:cc",
    "@diagnostic_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "robstride_vcan_test_support_library",
    srcs = [
        "support/fake_robstride_motor.cpp",
        "support/vcan_socket.cpp",
    ],
    hdrs = [
        "support/fake_robstride_motor.hpp",
        "support/vcan_socket.hpp",
    ],
    includes = [
        ".",
        "support",
    ],
    local_defines = ros_local_defines(),
    target_compatible_with = ["@platforms//os:linux"],
    deps = DEPENDENCIES.values() + CC_DEPS + ["//:_test_root_headers"],
)

cc_test(
    name = "test_can_transport",
    srcs = ["test_can_transport.cpp"],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = [
        ".",
        "support",
    ],
    local_defines = ros_local_defines(),
    target_compatible_with = ["@platforms//os:linux"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:robstride_driver_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

