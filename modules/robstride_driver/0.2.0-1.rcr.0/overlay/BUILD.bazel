load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

CC_DEPS = [
    "@can_msgs//:cc",
    "@diagnostic_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "robstride_driver_library",
    srcs = [
        "src/can_transport.cpp",
        "src/driver.cpp",
        "src/metrics.cpp",
        "src/motor_profile.cpp",
        "src/protocol.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        ".",
        "include",
        "include/robstride_driver",
        "test/support",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "robstride_driver",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":robstride_driver_library"],
)

cc_library(
    name = "robstride_vcan_test_support_library",
    srcs = [
        "test/support/fake_robstride_motor.cpp",
        "test/support/vcan_socket.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        ".",
        "include",
        "include/robstride_driver",
        "test/support",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":robstride_driver"],
)

ament_index(
    name = "ament_index",
    data = [
        "CHANGELOG.rst",
        "LICENSE",
        "README.md",
    ],
    libraries = [":robstride_driver"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@can_msgs//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@rclcpp//:ament_package",
    ],
)

cc_test(
    name = "test_can_transport",
    srcs = ["test/test_can_transport.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/robstride_driver",
        "test/support",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":robstride_driver_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

