load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
)

cc_library(
    name = "_test_root_headers",
    hdrs = [
        "include/robstride_driver/can_transport.hpp",
        "include/robstride_driver/config.hpp",
        "include/robstride_driver/driver.hpp",
        "include/robstride_driver/joint_data.hpp",
        "include/robstride_driver/metrics.hpp",
        "include/robstride_driver/motor_profile.hpp",
        "include/robstride_driver/protocol.hpp",
    ],
    includes = [
        ".",
        "include",
        "include/robstride_driver",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

DEPENDENCIES = {
    "@can_msgs//:cc_shared": "@can_msgs//:cc",
    "@diagnostic_msgs//:cc_shared": "@diagnostic_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "robstride_driver_library",
    srcs = [
        "src/can_transport.cpp",
        "src/driver.cpp",
        "src/metrics.cpp",
        "src/motor_profile.cpp",
        "src/protocol.cpp",
    ],
    hdrs = [
        "include/robstride_driver/can_transport.hpp",
        "include/robstride_driver/config.hpp",
        "include/robstride_driver/driver.hpp",
        "include/robstride_driver/joint_data.hpp",
        "include/robstride_driver/metrics.hpp",
        "include/robstride_driver/motor_profile.hpp",
        "include/robstride_driver/protocol.hpp",
    ],
    includes = [
        ".",
        "include",
        "include/robstride_driver",
        "test/support",
    ],
    local_defines = ros_local_defines(),
    target_compatible_with = ["@platforms//os:linux"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "robstride_driver",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":robstride_driver_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":robstride_driver"],
)

ament_index(
    name = "ament_index",
    data = [
        "CHANGELOG.rst",
        "LICENSE",
        "README.md",
    ],
    libraries = [":robstride_driver"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@can_msgs//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@rclcpp//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "can_msgs",
        "diagnostic_msgs",
        "rclcpp",
    ],
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    cmake_export_name = "export_robstride_driver",
    headers = [
        "include/robstride_driver/can_transport.hpp",
        "include/robstride_driver/config.hpp",
        "include/robstride_driver/driver.hpp",
        "include/robstride_driver/joint_data.hpp",
        "include/robstride_driver/metrics.hpp",
        "include/robstride_driver/motor_profile.hpp",
        "include/robstride_driver/protocol.hpp",
    ],
    include_prefix = "",
    libraries = [":robstride_driver"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@can_msgs//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@rclcpp//:ament_package",
    ],
)
