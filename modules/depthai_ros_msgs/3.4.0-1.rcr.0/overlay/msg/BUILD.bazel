load("@rosidl_default_generators//:defs.bzl", "ros_message")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

exports_files([
    "AutoFocusCtrl.msg",
    "HandLandmark.msg",
    "HandLandmarkArray.msg",
    "ImageMarker.msg",
    "ImageMarkerArray.msg",
    "ImuWithMagneticField.msg",
    "SpatialDetection.msg",
    "SpatialDetectionArray.msg",
    "TrackDetection2D.msg",
    "TrackDetection2DArray.msg",
    "TrackedFeature.msg",
    "TrackedFeatures.msg",
])

ros_message(
    name = "AutoFocusCtrl",
    src = "AutoFocusCtrl.msg",
)

ros_message(
    name = "HandLandmark",
    src = "HandLandmark.msg",
    deps = [
        "@geometry_msgs//msg:Point",
        "@vision_msgs//msg:Pose2D",
    ],
)

ros_message(
    name = "HandLandmarkArray",
    src = "HandLandmarkArray.msg",
    deps = [
        ":HandLandmark",
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "ImuWithMagneticField",
    src = "ImuWithMagneticField.msg",
    deps = [
        "@sensor_msgs//msg:Imu",
        "@sensor_msgs//msg:MagneticField",
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "SpatialDetection",
    src = "SpatialDetection.msg",
    deps = [
        "@geometry_msgs//msg:Point",
        "@vision_msgs//msg:BoundingBox2D",
        "@vision_msgs//msg:ObjectHypothesis",
    ],
)

ros_message(
    name = "SpatialDetectionArray",
    src = "SpatialDetectionArray.msg",
    deps = [
        ":SpatialDetection",
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "TrackDetection2D",
    src = "TrackDetection2D.msg",
    deps = [
        "@vision_msgs//msg:BoundingBox2D",
        "@vision_msgs//msg:ObjectHypothesisWithPose",
    ],
)

ros_message(
    name = "TrackDetection2DArray",
    src = "TrackDetection2DArray.msg",
    deps = [
        ":TrackDetection2D",
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "TrackedFeature",
    src = "TrackedFeature.msg",
    deps = [
        "@geometry_msgs//msg:Point",
        "@std_msgs//msg:Header",
    ],
)

ros_message(
    name = "TrackedFeatures",
    src = "TrackedFeatures.msg",
    deps = [
        ":TrackedFeature",
        "@std_msgs//msg:Header",
    ],
)
