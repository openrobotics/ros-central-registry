cc_library(
    name = "rtabmap_slam_plugins_library",
    srcs = ["src/CoreWrapper.cpp"],
    hdrs = [
        "include/rtabmap_slam/CoreWrapper.h",
        "include/rtabmap_slam/visibility.h",
    ] + [
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
