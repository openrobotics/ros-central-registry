cc_test(
    name = "test_core_wrapper_inputs",
    srcs = ["test_core_wrapper_inputs.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "GTEST_LINKED_AS_SHARED_LIBRARY=1",
        "WITH_APRILTAG_MSGS",
        "WITH_ARUCO_MSGS",
        "WITH_ARUCO_OPENCV_MSGS",
        "WITH_NAV2_MSGS",
        "WITH_OCTOMAP_MSGS",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:rtabmap_slam_plugins_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

