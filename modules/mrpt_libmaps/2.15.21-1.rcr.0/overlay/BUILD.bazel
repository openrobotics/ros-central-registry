const unsigned y,\n      const unsigned z,\n      const cell_t logodd_obs,\n      const cell_t thres)\n  {\n    updateCell_fast_free(m_grid.cellByIndex(x, y, z), logodd_obs, thres);\n  }\n};\n\n}  // namespace mrpt::maps\n"],
