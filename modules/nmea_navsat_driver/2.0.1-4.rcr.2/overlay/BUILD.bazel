package(default_visibility = ["//visibility:public"])

py_library(
    name = "nmea_navsat_driver",
    srcs = glob(["src/libnmea_navsat_driver/**/*.py"]),
    imports = ["src"],
    deps = [
        "@geometry_msgs//:py",
        "@nmea_msgs//:py",
        "@rclpy",
        "@sensor_msgs//:py",
        "@tf_transformations",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "nmea_serial_driver": "libnmea_navsat_driver.nodes.nmea_serial_driver:main",
        "nmea_socket_driver": "libnmea_navsat_driver.nodes.nmea_socket_driver:main",
        "nmea_tcpclient_driver": "libnmea_navsat_driver.nodes.nmea_tcpclient_driver:main",
        "nmea_topic_driver": "libnmea_navsat_driver.nodes.nmea_topic_driver:main",
        "nmea_topic_serial_reader": "libnmea_navsat_driver.nodes.nmea_topic_serial_reader:main",
    },
    data = [
        "config/nmea_serial_driver.yaml",
        "config/nmea_socket_driver.yaml",
        "config/nmea_tcpclient_driver.yaml",
        "launch/nmea_serial_driver.launch.py",
        "launch/nmea_socket_driver.launch.py",
        "launch/nmea_tcpclient_driver.launch.py",
    ],
    package_xml = "package.xml",
    python = [":nmea_navsat_driver"],
    python_strip_prefix = "src",
    deps = [
        "@geometry_msgs//:ament_package",
        "@nmea_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf_transformations//:ament_package",
    ],
)
