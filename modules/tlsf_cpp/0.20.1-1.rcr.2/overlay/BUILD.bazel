load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
        "@rules_license//licenses/spdx:LGPL-2.1-only",
    ],
)

HEADERS = glob(["include/**/*.hpp"])

cc_library(
    name = "tlsf_cpp",
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = [
        "@tlsf",
    ],
)

cc_binary(
    name = "tlsf_allocator_example",
    srcs = ["example/allocator_example.cpp"],
    local_defines = ros_local_defines(),
    deps = [
        ":tlsf_cpp",
        "@rclcpp//:rclcpp_library",
        "@std_msgs//:cc",
    ],
)

cc_test(
    name = "test_tlsf",
    srcs = ["test/test_tlsf.cpp"],
    local_defines = ros_local_defines(),
    deps = [
        ":tlsf_cpp",
        "@rclcpp//:rclcpp_library",
        "@rcpputils//:rcpputils_library",
        "@rosdistro//cc:googletest",
        "@std_msgs//:cc",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rcl",
        "tlsf",
    ],
    cmake_export_include_directories = False,
    cmake_export_name = "export_tlsf_cpp",
    executables = [":tlsf_allocator_example"],
    headers = HEADERS,
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rcl//:ament_package",
        "@rclcpp//:ament_package",
        "@rcpputils//:ament_package",
        "@rmw//:ament_package",
        "@rmw_implementation_cmake//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
        "@tlsf//:ament_package",
    ],
)
