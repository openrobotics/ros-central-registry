# Imports

load("@ament_cmake_gen_version_h//:defs.bzl", "generate_version_h")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### LIBRARY

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
}

cc_library(
    name = "rcpputils_library",
    srcs = [
        "src/asserts.cpp",
        "src/env.cpp",
        "src/filesystem_helper.cpp",
        "src/find_library.cpp",
        "src/process.cpp",
        "src/shared_library.cpp",
        "src/thread_name.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rcpputils",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rcpputils_library"],
    deps = [":rcpputils_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rcpputils"],
    visibility = ["//visibility:private"],
)

# Real rcpputils relies on ament_cmake_gen_version_h's CMake macro
# (ament_generate_version_header()) to generate and install this.
generate_version_h(
    name = "version_h",
    out = "include/rcpputils/version.h",
)

### TESTING

cc_test(
    name = "test_asserts_ndebug",
    srcs = ["test/test_asserts.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ["NDEBUG"],
    deps = [
        ":rcpputils_library",
        "@rcutils//:rcutils_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_asserts_debug",
    srcs = ["test/test_asserts.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":rcpputils_library",
        "@rcutils//:rcutils_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "test_env",
    srcs = ["test/test_env.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    env = {
        "EMPTY_TEST": "",
        "NORMAL_TEST": "foo",
    },
    deps = [
        ":rcpputils_library",
        "@rcutils//:rcutils_library",
        "@rosdistro//cc:googletest",
    ],
)

[
    cc_test(
        name = test,
        srcs = ["test/" + test + ".cpp"],
        dynamic_deps = [":transitive_dynamic_deps"],
        deps = [
            ":rcpputils_library",
            "@rcutils//:rcutils_library",
            "@rosdistro//cc:googletest",
        ],
    )
    for test in [
        "test_accumulator",
        "test_endian",
        "test_filesystem_helper",
        "test_filesystem_helper_std",
        "test_find_and_replace",
        "test_join",
        "test_pointer_traits",
        "test_process",
        "test_scope_exit",
        "test_split",
        "test_thread_name",
        "test_thread_safety_annotations",
        "test_time",
        "test_unique_lock",
    ]
]

cc_library(
    name = "dummy_shared_library_lib",
    srcs = [
        "test/dummy_shared_library/dummy_shared_library.c",
        "test/dummy_shared_library/dummy_shared_library.h",
    ],
)

cc_shared_library(
    name = "dummy_shared_library",
    exports_filter = [":dummy_shared_library_lib"],
    deps = [":dummy_shared_library_lib"],
)

collect_transitive_dynamic_deps(
    name = "test_shared_library_dynamic_deps",
    dynamic_deps = [
        ":dummy_shared_library",
        ":rcpputils",
    ],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_shared_library",
    srcs = ["test/test_shared_library.cpp"],
    data = [":dummy_shared_library"],
    dynamic_deps = [":test_shared_library_dynamic_deps"],
    linkopts = ["-Wl,--no-as-needed"],
    deps = [
        ":dummy_shared_library_lib",
        ":rcpputils_library",
        "@rcutils//:rcutils_library",
        "@rosdistro//cc:googletest",
    ],
)

cc_library(
    name = "test_library_lib",
    srcs = ["test/test_library.cpp"],
    deps = [":rcpputils_library"],
)

cc_shared_library(
    name = "test_library",
    dynamic_deps = [":rcpputils"],
    exports_filter = [":test_library_lib"],
    deps = [":test_library_lib"],
)

collect_transitive_dynamic_deps(
    name = "test_find_library_dynamic_deps",
    dynamic_deps = [
        ":rcpputils",
        ":test_library",
    ],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_find_library",
    srcs = ["test/test_find_library.cpp"],
    data = [":test_library"],
    dynamic_deps = [":test_find_library_dynamic_deps"],
    env = {
        "_TEST_LIBRARY": "../rcpputils+/libtest_library.so",
        "_TEST_LIBRARY_DIR": "../rcpputils+",
    },
    deps = [
        ":rcpputils_library",
        ":test_library_lib",
        "@rcutils//:rcutils_library",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS + [":version_h"],
    libraries = [":rcpputils"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_ros_core//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
