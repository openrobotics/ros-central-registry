load("@ament_cmake_gen_version_h//:defs.bzl", "generate_version_h")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/rcpputils/asserts.hpp",
    "include/rcpputils/compile_warnings.hpp",
    "include/rcpputils/endian.hpp",
    "include/rcpputils/env.hpp",
    "include/rcpputils/filesystem_helper.hpp",
    "include/rcpputils/find_and_replace.hpp",
    "include/rcpputils/find_library.hpp",
    "include/rcpputils/join.hpp",
    "include/rcpputils/pointer_traits.hpp",
    "include/rcpputils/process.hpp",
    "include/rcpputils/rolling_mean_accumulator.hpp",
    "include/rcpputils/scope_exit.hpp",
    "include/rcpputils/shared_library.hpp",
    "include/rcpputils/split.hpp",
    "include/rcpputils/thread_name.hpp",
    "include/rcpputils/thread_safety_annotations.hpp",
    "include/rcpputils/time.hpp",
    "include/rcpputils/tl_expected/expected.hpp",
    "include/rcpputils/unique_lock.hpp",
    "include/rcpputils/visibility_control.hpp",
]

DEPENDENCIES = {
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
}

cc_library(
    name = "rcpputils_library",
    srcs = [
        "src/asserts.cpp",
        "src/env.cpp",
        "src/filesystem_helper.cpp",
        "src/find_library.cpp",
        "src/process.cpp",
        "src/shared_library.cpp",
        "src/thread_name.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rcpputils",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rcpputils_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rcpputils"],
)

generate_version_h(
    name = "version_h",
    out = "include/rcpputils/version.h",
)

ament_package(
    name = "ament_package",
    headers = HEADERS + [":version_h"],
    libraries = [":rcpputils"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_copyright//:ament_package",
        "@ament_cmake_cppcheck//:ament_package",
        "@ament_cmake_cpplint//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_lint_cmake//:ament_package",
        "@ament_cmake_ros_core//:ament_package",
        "@ament_cmake_uncrustify//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
