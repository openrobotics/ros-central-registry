load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "rc_reason_clients",
    srcs = [
        "rc_reason_clients/__init__.py",
        "rc_reason_clients/cadmatch.py",
        "rc_reason_clients/custom_mappings.py",
        "rc_reason_clients/hand_eye_calib.py",
        "rc_reason_clients/load_carrier.py",
        "rc_reason_clients/message_conversion.py",
        "rc_reason_clients/pick.py",
        "rc_reason_clients/rest_client.py",
        "rc_reason_clients/ros_loader.py",
        "rc_reason_clients/silhouettematch.py",
        "rc_reason_clients/tagdetect.py",
        "rc_reason_clients/transform_helpers.py",
    ],
    imports = ["."],
    deps = [
        "@geometry_msgs//:py",
        "@rc_reason_msgs//:py",
        "@rclpy",
        "@ros2pkg",
        "@tf2_msgs//:py",
        "@visualization_msgs//:py",
        requirement("numpy"),
        requirement("requests"),
    ],
)

ament_package(
    name = "ament_package",
    console_scripts = {
        "rc_april_tag_detect_client": "rc_reason_clients.tagdetect:rc_april_tag_detect_client",
        "rc_boxpick_client": "rc_reason_clients.pick:rc_boxpick_client",
        "rc_cadmatch_client": "rc_reason_clients.cadmatch:main",
        "rc_hand_eye_calibration_client": "rc_reason_clients.hand_eye_calib:main",
        "rc_itempick_client": "rc_reason_clients.pick:rc_itempick_client",
        "rc_load_carrier_client": "rc_reason_clients.load_carrier:main",
        "rc_qr_code_detect_client": "rc_reason_clients.tagdetect:rc_qr_code_detect_client",
        "rc_silhouettematch_client": "rc_reason_clients.silhouettematch:main",
    },
    package_xml = "package.xml",
    python = [":rc_reason_clients"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rc_reason_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@ros2pkg//:ament_package",
        "@rosdistro//:ament_package",
        "@tf2_msgs//:ament_package",
        "@visualization_msgs//:ament_package",
    ],
)
