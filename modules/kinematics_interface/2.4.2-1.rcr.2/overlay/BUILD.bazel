load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "kinematics_interface_library",
    srcs = ["src/kinematics_interface.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/kinematics_interface",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "kinematics_interface",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":kinematics_interface_library"],
)

cc_library(
    name = "kinematics_interface_tests",
    hdrs = ["test/kinematics_interface_common_tests.hpp"],
    include_prefix = "kinematics_interface_tests",
    strip_include_prefix = "test",
    deps = [
        ":kinematics_interface_library",
        "@ros2_control_test_assets",
    ],
)

pkg_files(
    name = "pkg_files_inc_0",
    srcs = ["include/kinematics_interface/kinematics_interface.hpp"],
    prefix = "include/kinematics_interface/kinematics_interface",
)

pkg_files(
    name = "pkg_files_inc_1",
    srcs = ["test/kinematics_interface_common_tests.hpp"],
    prefix = "include/kinematics_interface/kinematics_interface_tests",
)

ament_index(
    name = "ament_index",
    libraries = [":kinematics_interface"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@backward_ros//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@ros2_control_test_assets//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "ros2_control_test_assets",
        "pluginlib",
        "rclcpp",
        "rclcpp_lifecycle",
        "Eigen3",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_kinematics_interface",
    install = [
        ":pkg_files_inc_0",
        ":pkg_files_inc_1",
    ],
    libraries = [":kinematics_interface"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@backward_ros//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@ros2_control_test_assets//:ament_package",
    ],
)
