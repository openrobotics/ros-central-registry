load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

py_library(
    name = "nav2_common",
    srcs = [
        "nav2_common/__init__.py",
        "nav2_common/launch/__init__.py",
        "nav2_common/launch/has_node_params.py",
        "nav2_common/launch/launch_config_as_bool.py",
        "nav2_common/launch/replace_string.py",
        "nav2_common/launch/rewritten_yaml.py",
    ],
    imports = ["."],
    deps = [
        requirement("pyyaml"),
        "@launch",
        "@launch_ros",
        "@osrf_pycommon",
        "@rclpy",
    ],
)

ament_package(
    name = "ament_package",
    cmake = ["cmake/nav2_package.cmake"],
    cmake_export_dependencies = False,
    cmake_extras = ["nav2_common-extras.cmake"],
    data = ["//test:_root_test_files_0"],
    package_xml = "package.xml",
    python = [":nav2_common"],
    deps = [
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_cmake_test//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ament_mypy//:ament_package",
        "@backward_ros//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@osrf_pycommon//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
