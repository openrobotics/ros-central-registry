load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

write_file(
    name = "_meta_file_0",
    out = "_gen_meta/share/nav2_common/cmake/nav2_common-extras.cmake",
    content = [
        "# Copyright 2019 Intel Corporation",
        "#",
        "# Licensed under the Apache License, Version 2.0 (the \"License\");",
        "# you may not use this file except in compliance with the License.",
        "# You may obtain a copy of the License at",
        "#",
        "#     http://www.apache.org/licenses/LICENSE-2.0",
        "#",
        "# Unless required by applicable law or agreed to in writing, software",
        "# distributed under the License is distributed on an \"AS IS\" BASIS,",
        "# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.",
        "# See the License for the specific language governing permissions and",
        "# limitations under the License.",
        "",
        "set(AMENT_BUILD_CONFIGURATION_KEYWORD_SEPARATOR \":\")",
        "",
        "include(\"${nav2_common_DIR}/nav2_package.cmake\")",
    ],
    is_executable = False,
)

pkg_files(
    name = "meta_files_0",
    srcs = [":_meta_file_0"],
    prefix = "share/nav2_common/cmake",
)

py_library(
    name = "nav2_common",
    srcs = glob(["nav2_common/**/*.py"]),
    imports = ["."],
    deps = [
        requirement("pyyaml"),
        "@launch",
        "@launch_ros",
        "@osrf_pycommon",
        "@rclpy",
    ],
)

[
    py_pytest(
        name = test,
        srcs = ["test/{}.py".format(test)],
        deps = [":nav2_common"],
    )
    for test in [
        "test_rewritten_yaml",
        "test_has_node_params",
        "test_launch_config_as_bool",
    ]
]

ament_package(
    name = "ament_package",
    cmake = glob(["cmake/**"]),
    cmake_export_dependencies = False,
    cmake_extras = ["nav2_common-extras.cmake"],
    data = glob(["test/**"]),
    install = [":meta_files_0"],
    package_xml = "package.xml",
    python = [":nav2_common"],
    deps = [
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_cmake_test//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@ament_mypy//:ament_package",
        "@backward_ros//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@osrf_pycommon//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
