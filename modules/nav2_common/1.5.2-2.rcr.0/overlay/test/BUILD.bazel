load("@rosdistro//python:defs.bzl", "py_pytest")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "_root_test_files_0",
    srcs = [
        "test_has_node_params.py",
        "test_launch_config_as_bool.py",
        "test_rewritten_yaml.py",
    ],
)

[py_pytest(
    name = test.removesuffix(".py"),
    srcs = ["{}.py".format(test)],
    deps = ["//:nav2_common"],
) for test in [
    "test_rewritten_yaml",
    "test_has_node_params",
    "test_launch_config_as_bool",
]]
