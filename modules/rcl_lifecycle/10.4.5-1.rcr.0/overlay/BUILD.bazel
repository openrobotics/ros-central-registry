load("@ament_cmake_gen_version_h//:defs.bzl", "generate_version_h")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

HEADERS = [
    "include/rcl_lifecycle/data_types.h",
    "include/rcl_lifecycle/default_state_machine.h",
    "include/rcl_lifecycle/rcl_lifecycle.h",
    "include/rcl_lifecycle/transition_map.h",
    "include/rcl_lifecycle/visibility_control.h",
]

DEPENDENCIES = {
    "@lifecycle_msgs//:c_shared": "@lifecycle_msgs//:c",
    "@rcl//:rcl": "@rcl//:rcl_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
    "@tracetools//:tracetools": "@tracetools//:tracetools_library",
}

cc_library(
    name = "rcl_lifecycle_library",
    srcs = [
        "src/com_interface.c",
        "src/com_interface.h",
        "src/default_state_machine.c",
        "src/rcl_lifecycle.c",
        "src/transition_map.c",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "rcl_lifecycle",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rcl_lifecycle_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":rcl_lifecycle",
        "@lifecycle_msgs//:c_shared",
    ],
)

generate_version_h(
    name = "version_h",
    out = "include/rcl_lifecycle/version.h",
)

ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "lifecycle_msgs",
        "rcl",
    ],
    headers = HEADERS + [":version_h"],
    libraries = [":rcl_lifecycle"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@osrf_testing_tools_cpp//:ament_package",
        "@rcl//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@tracetools//:ament_package",
    ],
)
