load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@rcl//:rcl": "@rcl//:rcl_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
    "@tracetools//:tracetools": "@tracetools//:tracetools_library",
}

[cc_test(
    name = test.removesuffix(".py"),
    timeout = "moderate",
    srcs = ["{}.cpp".format(test)],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "//:rcl_lifecycle_library",
        "@osrf_testing_tools_cpp//:memory_tools",
        "@rosdistro//cc:googletest",
    ],
) for test in [
    "test_default_state_machine",
    "test_multiple_instances",
    "test_rcl_lifecycle",
    "test_transition_map",
]]
