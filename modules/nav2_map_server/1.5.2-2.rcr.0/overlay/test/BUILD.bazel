cc_test(
    name = "test_map_saver_cli",
    srcs = [
        "map_saver_cli/test_map_saver_cli.cpp",
        "test_constants.cpp",
    ] + ["test_constants/test_constants.h"] + [
    ],
    data = ["//:ament_index"] + [
        "CMakeLists.txt",
        "component/CMakeLists.txt",
        "component/test_map_saver_launch.py",
        "component/test_map_server_launch.py",
        "invalid_image.yaml",
        "map_saver_cli/CMakeLists.txt",
        "map_saver_params.yaml",
        "map_server_params.yaml",
        "test_launch_files/map_saver_node.launch.py",
        "test_launch_files/map_server_node.launch.py",
        "testmap.bmp",
        "testmap.pgm",
        "testmap.png",
        "testmap.yaml",
        "unit/CMakeLists.txt",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = [
        ".",
        "component",
        "map_saver_cli",
        "unit",
    ],
    local_defines = ros_local_defines() + [
        'TEST_DIRECTORY=\\"test\\"',
        "_FILE_OFFSET_BITS=64",
    ],
    # Shells out to the `ros2` CLI (via std::system), which is not on PATH\nin the hermetic Bazel test environment.
    tags = ["manual"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:map_io_library",
        "//:map_server_core_library",
        "//:vector_object_core_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

