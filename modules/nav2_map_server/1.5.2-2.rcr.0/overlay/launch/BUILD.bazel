load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "map_saver_server.launch.py",
        "vector_object_server.launch.py",
    ],
)

launch_ros_binary(
    name = "map_saver_server_launch",
    src = "map_saver_server.launch.py",
    deps = [
        "//:map_saver_server",
        "@nav2_lifecycle_manager//:lifecycle_manager",
    ],
)

launch_ros_binary(
    name = "vector_object_server_launch",
    src = "vector_object_server.launch.py",
    deps = [
        "//:costmap_filter_info_server",
        "//:vector_object_server",
        "@ament_index_python",
        "@nav2_common",
        "@nav2_lifecycle_manager//:lifecycle_manager",
        "@rclcpp_components//:component_container",
    ],
)
