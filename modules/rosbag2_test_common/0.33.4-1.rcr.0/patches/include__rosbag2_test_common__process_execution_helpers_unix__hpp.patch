+#ifdef __APPLE__
+/// \brief Absolute library search path for child processes on macOS.
+/// The Bazel test environment sets a relative DYLD_LIBRARY_PATH ("lib"), which
+/// stops resolving as soon as the helpers below chdir() elsewhere.
+inline std::string macos_absolute_library_path(const fs::path & runfiles_main_dir)
+{
+  std::string lib_path = (runfiles_main_dir / "lib").generic_string();
+  const char * existing = getenv("DYLD_LIBRARY_PATH");
+  if (existing != nullptr && existing[0] != '\0') {
+    lib_path += std::string(":") + existing;
+  }
+  return lib_path;
+}
+
+/// \brief Hermetic interpreter of the mock `ros2` py_binary, if present.
+/// macOS System Integrity Protection strips DYLD_* variables from the
+/// environment of protected binaries such as /bin/sh and /usr/bin/env. The
+/// mock `ros2` script's `#!/usr/bin/env python3` shebang therefore loses
+/// DYLD_LIBRARY_PATH and can't dlopen() the RMW implementation, so we run the
+/// script through its (unprotected) interpreter directly instead.
+inline std::string macos_ros2_interpreter(const fs::path & ros2bag_dir)
+{
+  const fs::path interpreter = ros2bag_dir / "_ros2.venv" / "bin" / "python3";
+  std::error_code ec;
+  return fs::exists(interpreter, ec) ? interpreter.generic_string() : std::string();
+}
+#endif  // __APPLE__
 
