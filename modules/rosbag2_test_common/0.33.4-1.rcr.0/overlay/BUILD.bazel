load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

HEADERS = [
    "include/rosbag2_test_common/action_client_manager.hpp",
    "include/rosbag2_test_common/action_server_manager.hpp",
    "include/rosbag2_test_common/bag_files_helpers.hpp",
    "include/rosbag2_test_common/client_manager.hpp",
    "include/rosbag2_test_common/memory_management.hpp",
    "include/rosbag2_test_common/process_execution_helpers.hpp",
    "include/rosbag2_test_common/process_execution_helpers_unix.hpp",
    "include/rosbag2_test_common/process_execution_helpers_windows.hpp",
    "include/rosbag2_test_common/publication_manager.hpp",
    "include/rosbag2_test_common/service_manager.hpp",
    "include/rosbag2_test_common/subscription_manager.hpp",
    "include/rosbag2_test_common/temporary_directory_fixture.hpp",
    "include/rosbag2_test_common/tested_storage_ids.hpp",
    "include/rosbag2_test_common/wait_for.hpp",
]

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@test_msgs//:cc_shared": "@test_msgs//:cc",
}

cc_library(
    name = "rosbag2_test_common_library",
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@test_msgs//:test_msgs_cc",
    ],
)

cc_shared_library(
    name = "rosbag2_test_common",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":rosbag2_test_common_library"],
)

### PYTHON MODULE

py_library(
    name = "rosbag2_test_common_py",
    srcs = ["rosbag2_test_common/__init__.py"],
    imports = ["."],
)

### PACKAGING

# Upstream's rosbag2_test_common is an INTERFACE (header-only) library plus an
# ament_python_install_package(); nothing is installed under lib/.
ament_package(
    name = "ament_package",
    cmake_export_dependencies_list = [
        "rclcpp",
        "rclcpp_action",
        "rcutils",
        "test_msgs",
    ],
    cmake_export_name = "export_rosbag2_test_common",
    headers = HEADERS,
    package_xml = "package.xml",
    python = [":rosbag2_test_common_py"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rosdistro//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
