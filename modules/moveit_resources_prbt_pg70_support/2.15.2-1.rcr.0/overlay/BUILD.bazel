load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = [
        "meshes/pg70/pg70.dae",
        "meshes/pg70/pg70.stl",
        "urdf/common.xacro",
        "urdf/pg70.urdf.xacro",
        "urdf/pg70/pg70.gazebo.xacro",
        "urdf/pg70/pg70.transmission.xacro",
        "urdf/pg70/pg70.urdf.xacro",
    ] + [
        "config/controllers_manipulator_gripper.yaml",
        "config/fake_controllers.yaml",
        "config/gripper_controller.yaml",
        "config/gripper_driver_canopen_motor_node.yaml",
        "config/joint_limits.yaml",
        "config/pg70.srdf.xacro",
        "config/pg70_tcp_offset.xacro",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@moveit_resources_prbt_ikfast_manipulator_plugin//:ament_package",
        "@moveit_resources_prbt_moveit_config//:ament_package",
        "@moveit_resources_prbt_support//:ament_package",
        "@rosdistro//:ament_package",
        "@xacro//:ament_package",
    ],
)
