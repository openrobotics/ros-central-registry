load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@mrpt_config//:mrpt_config": "@mrpt_config//:mrpt_config_library",
    "@mrpt_math//:mrpt_math": "@mrpt_math//:mrpt_math_library",
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:pybind11",
    "@rules_python//python/cc:current_py_cc_headers",
]

cc_library(
    name = "mrpt_bayes_library",
    srcs = [
        "src/CParticleFilter.cpp",
        "src/CParticleFilterCapable.cpp",
    ],
    hdrs = [
        "include/mrpt/bayes.h",
        "include/mrpt/bayes/CKalmanFilterCapable.h",
        "include/mrpt/bayes/CKalmanFilterCapable_impl.h",
        "include/mrpt/bayes/CParticleFilter.h",
        "include/mrpt/bayes/CParticleFilterCapable.h",
        "include/mrpt/bayes/CParticleFilterData.h",
        "include/mrpt/bayes/CProbabilityParticle.h",
        "include/mrpt/bayes/CRejectionSamplingCapable.h",
        "include/mrpt/bayes/registerAllClasses.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_bayes",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mrpt_bayes_library"],
)

cc_library(
    name = "_bindings_library",
    srcs = ["python_bindings/mrpt_bayes_py.cpp"],
    hdrs = [
        "include/mrpt/bayes.h",
        "include/mrpt/bayes/CKalmanFilterCapable.h",
        "include/mrpt/bayes/CKalmanFilterCapable_impl.h",
        "include/mrpt/bayes/CParticleFilter.h",
        "include/mrpt/bayes/CParticleFilterCapable.h",
        "include/mrpt/bayes/CParticleFilterData.h",
        "include/mrpt/bayes/CProbabilityParticle.h",
        "include/mrpt/bayes/CRejectionSamplingCapable.h",
        "include/mrpt/bayes/registerAllClasses.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":mrpt_bayes_library"],
)

cc_shared_library(
    name = "_bindings",
    dynamic_deps = DEPENDENCIES.keys() + [":mrpt_bayes"],
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = "mrpt/bayes/_bindings.so",
    deps = [":_bindings_library"],
)

py_library(
    name = "mrpt",
    srcs = ["python/mrpt/bayes/__init__.py"],
    imports = ["python"],
    deps = [
        "@mrpt_config//:mrpt",
        "@mrpt_math//:mrpt",
    ],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_bayes",
    ],
    package_xml = "package.xml",
    sonames = {
        "mrpt_bayes": [
            "libmrpt_bayes.so.3.3",
            "libmrpt_bayes.so.3.3.1",
        ],
    },
    deps = [
        "@mrpt_common//:ament_package",
        "@mrpt_config//:ament_package",
        "@mrpt_math//:ament_package",
    ],
)

ament_package(
    build_type = "cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    egg_info = False,
    headers = [
        "include/mrpt/bayes.h",
        "include/mrpt/bayes/CKalmanFilterCapable.h",
        "include/mrpt/bayes/CKalmanFilterCapable_impl.h",
        "include/mrpt/bayes/CParticleFilter.h",
        "include/mrpt/bayes/CParticleFilterCapable.h",
        "include/mrpt/bayes/CParticleFilterData.h",
        "include/mrpt/bayes/CProbabilityParticle.h",
        "include/mrpt/bayes/CRejectionSamplingCapable.h",
        "include/mrpt/bayes/registerAllClasses.h",
    ],
    include_prefix = "",
    install_package_xml = False,
    libraries = [
        ":mrpt_bayes",
    ],
    package_xml = "package.xml",
    python = [
        ":mrpt",
        ":_bindings",
    ],
    python_strip_prefix = "python",
    sonames = {
        "mrpt_bayes": [
            "libmrpt_bayes.so.3.3",
            "libmrpt_bayes.so.3.3.1",
        ],
    },
    deps = [":ament_index"] + [
        "@mrpt_common//:ament_package",
        "@mrpt_config//:ament_package",
        "@mrpt_math//:ament_package",
    ],
)
