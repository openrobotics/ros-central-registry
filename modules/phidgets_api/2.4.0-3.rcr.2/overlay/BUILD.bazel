load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@libphidget22//:libphidget22_library",
]

cc_library(
    name = "phidgets_api_library",
    srcs = [
        "src/accelerometer.cpp",
        "src/analog_input.cpp",
        "src/analog_inputs.cpp",
        "src/analog_output.cpp",
        "src/analog_outputs.cpp",
        "src/digital_input.cpp",
        "src/digital_inputs.cpp",
        "src/digital_output.cpp",
        "src/digital_outputs.cpp",
        "src/encoder.cpp",
        "src/encoders.cpp",
        "src/gyroscope.cpp",
        "src/ir.cpp",
        "src/magnetometer.cpp",
        "src/motor.cpp",
        "src/motors.cpp",
        "src/phidget22.cpp",
        "src/spatial.cpp",
        "src/stepper.cpp",
        "src/temperature.cpp",
    ],
    hdrs = [
        "include/phidgets_api/accelerometer.hpp",
        "include/phidgets_api/analog_input.hpp",
        "include/phidgets_api/analog_inputs.hpp",
        "include/phidgets_api/analog_output.hpp",
        "include/phidgets_api/analog_outputs.hpp",
        "include/phidgets_api/digital_input.hpp",
        "include/phidgets_api/digital_inputs.hpp",
        "include/phidgets_api/digital_output.hpp",
        "include/phidgets_api/digital_outputs.hpp",
        "include/phidgets_api/encoder.hpp",
        "include/phidgets_api/encoders.hpp",
        "include/phidgets_api/gyroscope.hpp",
        "include/phidgets_api/ir.hpp",
        "include/phidgets_api/magnetometer.hpp",
        "include/phidgets_api/motor.hpp",
        "include/phidgets_api/motors.hpp",
        "include/phidgets_api/phidget22.hpp",
        "include/phidgets_api/spatial.hpp",
        "include/phidgets_api/stepper.hpp",
        "include/phidgets_api/temperature.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/phidgets_api",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "phidgets_api",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":phidgets_api_library"],
)

ament_index(
    name = "ament_index",
    libraries = [":phidgets_api"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@libphidget22//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "ament_cmake",
        "libphidget22",
    ],
    cmake_export_name = "export_phidgets_api",
    headers = [
        "include/phidgets_api/accelerometer.hpp",
        "include/phidgets_api/analog_input.hpp",
        "include/phidgets_api/analog_inputs.hpp",
        "include/phidgets_api/analog_output.hpp",
        "include/phidgets_api/analog_outputs.hpp",
        "include/phidgets_api/digital_input.hpp",
        "include/phidgets_api/digital_inputs.hpp",
        "include/phidgets_api/digital_output.hpp",
        "include/phidgets_api/digital_outputs.hpp",
        "include/phidgets_api/encoder.hpp",
        "include/phidgets_api/encoders.hpp",
        "include/phidgets_api/gyroscope.hpp",
        "include/phidgets_api/ir.hpp",
        "include/phidgets_api/magnetometer.hpp",
        "include/phidgets_api/motor.hpp",
        "include/phidgets_api/motors.hpp",
        "include/phidgets_api/phidget22.hpp",
        "include/phidgets_api/spatial.hpp",
        "include/phidgets_api/stepper.hpp",
        "include/phidgets_api/temperature.hpp",
    ],
    include_prefix = "",
    libraries = [":phidgets_api"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@libphidget22//:ament_package",
    ],
)
