load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@libphidget22//:libphidget22_library",
]

cc_library(
    name = "phidgets_api_library",
    srcs = [":gen_phidgets_api_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        "include",
        "include/phidgets_api",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "phidgets_api",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":phidgets_api_library"],
)

write_file(
    name = "gen_phidgets_api_stub_cpp",
    out = "_gen/phidgets_api_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

ament_index(
    name = "ament_index",
    libraries = [":phidgets_api"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@libphidget22//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "ament_cmake",
        "libphidget22",
    ],
    cmake_export_name = "export_phidgets_api",
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hh",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
            "include/**/*.txx",
            "include/**/*.tcc",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    libraries = [":phidgets_api"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake_ros//:ament_package",
        "@libphidget22//:ament_package",
    ],
)
