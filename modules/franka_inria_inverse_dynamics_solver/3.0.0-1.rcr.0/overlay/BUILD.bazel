load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

DEPENDENCIES = {
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
}

CC_DEPS = [
    "@inverse_dynamics_solver//:inverse_dynamics_solver_library",
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "franka_inria_inverse_dynamics_solver_library",
    srcs = [
        "src/franka_inria_inverse_dynamics_solver.cpp",
        "src/get_CoriolisMatrix.cpp",
        "src/get_FrictionTorque.cpp",
        "src/get_GravityVector_eigen.cpp",
        "src/get_MassMatrix_parziale.cpp",
    ],
    hdrs = [
        "include/franka_inria_inverse_dynamics_solver/franka_inria_inverse_dynamics_solver.hpp",
        "include/franka_inria_inverse_dynamics_solver/get_CoriolisMatrix.hpp",
        "include/franka_inria_inverse_dynamics_solver/get_FrictionTorque.hpp",
        "include/franka_inria_inverse_dynamics_solver/get_GravityVector.hpp",
        "include/franka_inria_inverse_dynamics_solver/get_MassMatrix.hpp",
    ],
    includes = [
        "include",
        "include/franka_inria_inverse_dynamics_solver",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "franka_inria_inverse_dynamics_solver",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":franka_inria_inverse_dynamics_solver_library"],
)

ament_index(
    name = "ament_index",
    data = [
        "bagfiles/panda_exciting_trajectory.db3",
        "//launch:launch_files",
    ],
    libraries = [":franka_inria_inverse_dynamics_solver"],
    package_xml = "package.xml",
    plugin_category = "inverse_dynamics_solver",
    plugins = ["franka_inria_inverse_dynamics_solver.xml"],
    deps = [
        "@ament_cmake//:ament_package",
        "@inverse_dynamics_solver//:ament_package",
        "@pluginlib//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "inverse_dynamics_solver",
        "pluginlib",
    ],
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_franka_inria_inverse_dynamics_solver",
    headers = [
        "include/franka_inria_inverse_dynamics_solver/franka_inria_inverse_dynamics_solver.hpp",
        "include/franka_inria_inverse_dynamics_solver/get_CoriolisMatrix.hpp",
        "include/franka_inria_inverse_dynamics_solver/get_FrictionTorque.hpp",
        "include/franka_inria_inverse_dynamics_solver/get_GravityVector.hpp",
        "include/franka_inria_inverse_dynamics_solver/get_MassMatrix.hpp",
    ],
    include_prefix = "",
    libraries = [":franka_inria_inverse_dynamics_solver"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@inverse_dynamics_solver//:ament_package",
        "@pluginlib//:ament_package",
    ],
)
