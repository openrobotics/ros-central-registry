load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

py_library(
    name = "webots_ros2_husarion",
    srcs = [
        "webots_ros2_husarion/__init__.py",
    ],
    imports = ["."],
)

### PACKAGING

ament_index(
    name = "ament_index",
    data = [
        "launch/rosbot_launch.py",
        "launch/rosbot_xl_launch.py",
        "resource/ekf.yaml",
        "resource/laser_filter.yaml",
        "resource/rosbot_controllers.yaml",
        "resource/rosbot_links_remappings.yaml",
        "resource/rosbot_webots.urdf",
        "resource/rosbot_xl_controllers.yaml",
        "worlds/meshes/husarion_world.dae",
        "worlds/rosbot.wbt",
        "worlds/rosbot_xl.wbt",
    ],
    package_xml = "package.xml",
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":webots_ros2_husarion"],
    deps = [
        ":ament_index",
        "@controller_manager//:ament_package",
        "@diff_drive_controller//:ament_package",
        "@joint_state_broadcaster//:ament_package",
        "@laser_filters//:ament_package",
        "@robot_localization//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@rosdistro//:ament_package",
        "@webots_ros2_control//:ament_package",
        "@webots_ros2_driver//:ament_package",
    ],
)

launch_ros_binary(
    name = "launch_rosbot_launch_py",
    src = "launch/rosbot_launch.py",
    data = [
        ":ament_index",
        "@controller_manager//:ament_index",
        "@diff_drive_controller//:ament_index",
        "@joint_state_broadcaster//:ament_index",
        "@robot_localization//:ament_index_extra",
        "@robot_state_publisher//:ament_index",
        "@webots_ros2_control//:ament_index",
        "@webots_ros2_driver//:ament_index",
    ],
    deps = [
        ":webots_ros2_husarion",
        "@controller_manager//:spawner",
        "@robot_localization//:ekf_node",
        "@robot_state_publisher",
        "@webots_ros2_driver",
        "@webots_ros2_driver//:driver",
        "@webots_ros2_driver//:ros2_supervisor.py",
    ],
)

launch_ros_binary(
    name = "launch_rosbot_xl_launch_py",
    src = "launch/rosbot_xl_launch.py",
    data = [
        ":ament_index",
        "@controller_manager//:ament_index",
        "@diff_drive_controller//:ament_index",
        "@joint_state_broadcaster//:ament_index",
        "@laser_filters//:ament_index",
        "@robot_localization//:ament_index_extra",
        "@robot_state_publisher//:ament_index",
        "@webots_ros2_control//:ament_index",
        "@webots_ros2_driver//:ament_index",
    ],
    deps = [
        ":webots_ros2_husarion",
        "@controller_manager//:spawner",
        "@laser_filters//:scan_to_scan_filter_chain",
        "@robot_localization//:ekf_node",
        "@robot_state_publisher",
        "@webots_ros2_driver",
        "@webots_ros2_driver//:driver",
        "@webots_ros2_driver//:ros2_supervisor.py",
    ],
)
