load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

py_library(
    name = "py_trees_ros",
    srcs = [
        "py_trees_ros/__init__.py",
        "py_trees_ros/action_clients.py",
        "py_trees_ros/actions.py",
        "py_trees_ros/battery.py",
        "py_trees_ros/blackboard.py",
        "py_trees_ros/conversions.py",
        "py_trees_ros/exceptions.py",
        "py_trees_ros/mock/__init__.py",
        "py_trees_ros/mock/actions.py",
        "py_trees_ros/mock/dock.py",
        "py_trees_ros/mock/services.py",
        "py_trees_ros/mock/set_bool.py",
        "py_trees_ros/programs/__init__.py",
        "py_trees_ros/programs/blackboard_watcher.py",
        "py_trees_ros/programs/echo.py",
        "py_trees_ros/programs/multi_talker.py",
        "py_trees_ros/programs/tree_watcher.py",
        "py_trees_ros/publishers.py",
        "py_trees_ros/service_clients.py",
        "py_trees_ros/subscribers.py",
        "py_trees_ros/transforms.py",
        "py_trees_ros/trees.py",
        "py_trees_ros/utilities.py",
        "py_trees_ros/version.py",
        "py_trees_ros/visitors.py",
    ],
    imports = ["."],
    deps = [
        "@geometry_msgs//:py",
        "@py_trees",
        "@py_trees_ros_interfaces//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@ros2topic",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        "@std_srvs//:py",
        "@tf2_ros_py",
        "@unique_identifier_msgs//:py",
    ],
)

ament_package(
    name = "ament_package",
    console_programs = {
        "py-trees-blackboard-watcher": "py_trees_ros.programs.blackboard_watcher:main",
        "py-trees-tree-watcher": "py_trees_ros.programs.tree_watcher:main",
    },
    package_xml = "package.xml",
    python = [":py_trees_ros"],
    deps = [
        "@geometry_msgs//:ament_package",
        "@py_trees//:ament_package",
        "@py_trees_ros_interfaces//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@ros2topic//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2_ros_py//:ament_package",
        "@unique_identifier_msgs//:ament_package",
    ],
)
