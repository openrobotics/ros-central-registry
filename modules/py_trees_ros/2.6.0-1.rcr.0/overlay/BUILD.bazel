package(default_visibility = ["//visibility:public"])

py_library(
    name = "py_trees_ros",
    srcs = glob(["py_trees_ros/**/*.py"]),
    imports = ["."],
    deps = [
        "@geometry_msgs//:py",
        "@py_trees",
        "@py_trees_ros_interfaces//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@ros2topic",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        "@std_srvs//:py",
        "@tf2_ros_py",
        "@unique_identifier_msgs//:py",
    ],
)

py_pytest(
    name = "test_action_client",
    srcs = ["tests/test_action_client.py"],
    data = glob(["tests/**"]),
    imports = [
        ".",
        "tests",
    ],
    deps = [":py_trees_ros"],
)

py_pytest(
    name = "test_expand_topic_name",
    srcs = ["tests/test_expand_topic_name.py"],
    data = glob(["tests/**"]),
    imports = [
        ".",
        "tests",
    ],
    deps = [":py_trees_ros"],
)

py_pytest(
    name = "test_publishers",
    srcs = ["tests/test_publishers.py"],
    data = glob(["tests/**"]),
    imports = [
        ".",
        "tests",
    ],
    deps = [":py_trees_ros"],
)

py_pytest(
    name = "test_service_client",
    srcs = ["tests/test_service_client.py"],
    data = glob(["tests/**"]),
    imports = [
        ".",
        "tests",
    ],
    deps = [":py_trees_ros"],
)

py_pytest(
    name = "test_subscribers",
    srcs = ["tests/test_subscribers.py"],
    data = glob(["tests/**"]),
    imports = [
        ".",
        "tests",
    ],
    deps = [":py_trees_ros"],
)

py_pytest(
    name = "test_transforms",
    srcs = ["tests/test_transforms.py"],
    data = glob(["tests/**"]),
    imports = [
        ".",
        "tests",
    ],
    deps = [":py_trees_ros"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_programs = {
        "py-trees-blackboard-watcher": "py_trees_ros.programs.blackboard_watcher:main",
        "py-trees-tree-watcher": "py_trees_ros.programs.tree_watcher:main",
    },
    package_xml = "package.xml",
    python = [":py_trees_ros"],
    deps = [
        "@geometry_msgs//:ament_package",
        "@py_trees//:ament_package",
        "@py_trees_ros_interfaces//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@ros2topic//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2_ros_py//:ament_package",
        "@unique_identifier_msgs//:ament_package",
    ],
)
