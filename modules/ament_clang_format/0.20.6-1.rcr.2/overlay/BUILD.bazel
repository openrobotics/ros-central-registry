load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

package(default_visibility = ["//visibility:public"])

### ENTRYPOINTS

py_binary(
    name = "setup",
    srcs = ["setup.py"],
    visibility = ["//visibility:private"],
    deps = [
        requirement("setuptools"),
    ],
)

genrule(
    name = "entry_points",
    srcs = [
        "CHANGELOG.rst",
        "ament_clang_format/__init__.py",
        "ament_clang_format/configuration/.clang-format",
        "ament_clang_format/main.py",
        "ament_clang_format/py.typed",
        "doc/index.rst",
        "package.xml",
        "pytest.ini",
        "resource/ament_clang_format",
        "setup.py",
        "test/test_copyright.py",
        "test/test_flake8.py",
        "test/test_pep257.py",
        "test/test_xmllint.py",
    ],
    outs = [
        "ament_clang_format.egg-info/PKG-INFO",
        "ament_clang_format.egg-info/entry_points.txt",
        "ament_clang_format.egg-info/top_level.txt",
    ],
    cmd = "$(location :setup) egg_info --egg-base=. && mkdir -p $(@D)/ament_clang_format.egg-info && cp -r ament_clang_format.egg-info/* $(@D)/ament_clang_format.egg-info/",
    tools = [":setup"],
    visibility = ["//visibility:private"],
)

### PYTHON MODULE

alias(
    name = "clang-format",
    actual = "@rosdistro//cc:clang-format",
)

# Records the runfiles location of the hermetic clang-format binary, so main.py
# can find it without relying on a system-installed copy on PATH.
genrule(
    name = "clang_format_rlocation",
    srcs = [":clang-format"],
    outs = ["ament_clang_format/clang_format_rlocation.py"],
    cmd = "echo 'CLANG_FORMAT_RLOCATIONPATH = \"$(rlocationpath :clang-format)\"' > $@",
    visibility = ["//visibility:private"],
)

py_library(
    name = "ament_clang_format",
    srcs = [
        "ament_clang_format/__init__.py",
        "ament_clang_format/main.py",
        ":clang_format_rlocation",
    ],
    data = [
        "ament_clang_format/configuration/.clang-format",
        ":clang-format",
        ":entry_points",
    ],
    imports = ["."],
    deps = [
        requirement("pyyaml"),
        "@rules_python//python/runfiles",
    ],
)

### PYTHON EXECUTABLE

py_console_script_binary(
    name = "cli",
    entry_points_txt = ":entry_points",
    pkg = ":ament_clang_format",
    script = "ament_clang_format",
)

### TESTS

[
    py_pytest(
        name = "test_{0}".format(test_name),
        srcs = ["test/test_{0}.py".format(test_name)],
        data = [
            "CHANGELOG.rst",
            "ament_clang_format/__init__.py",
            "ament_clang_format/configuration/.clang-format",
            "ament_clang_format/main.py",
            "ament_clang_format/py.typed",
            "doc/index.rst",
            "package.xml",
            "pytest.ini",
            "resource/ament_clang_format",
            "setup.py",
            "test/test_copyright.py",
            "test/test_flake8.py",
            "test/test_pep257.py",
            "test/test_xmllint.py",
        ],
        deps = ["@ament_{0}".format(test_name)],
    )
    for test_name in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    console_programs = {"ament_clang_format": "ament_clang_format.main:main"},
    package_xml = "package.xml",
    python = [
        ":ament_clang_format",
        "ament_clang_format/configuration/.clang-format",
        "ament_clang_format/py.typed",
    ],
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
