+def find_runfiles_executable():
+    # Prefer the hermetic clang-format shipped in our runfiles over one on PATH.
+    try:
+        from ament_clang_format.clang_format_rlocation import CLANG_FORMAT_RLOCATIONPATH
+        from python.runfiles import runfiles
+    except ImportError:
+        return None
+    r = runfiles.Create()
+    path = r.Rlocation(CLANG_FORMAT_RLOCATIONPATH) if r else None
+    if path and os.path.isfile(path) and os.access(path, os.X_OK):
+        return os.path.abspath(path)
+    return None
