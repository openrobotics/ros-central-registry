collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "logger",
    srcs = ["src/logger.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_rcr_qt_libc_shim_hpp",
        ":gen_ui_rqt_plansys2_knowledge_h",
        ":gen_ui_rqt_plansys2_performers_h",
        ":gen_ui_rqt_plansys2_plan_h",
    ],
    copts = [
        "-std=c++23",
        "-Wno-missing-template-arg-list-after-template-kw",
        "-include",
        "rcr_qt_libc_shim.hpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "_gen/include",
        "include",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":plansys2_logger_library"],
)

write_file(
    name = "gen_rcr_qt_libc_shim_hpp",
    out = "_gen/include/rcr_qt_libc_shim.hpp",
    content = ["#pragma once\n#ifdef __cplusplus\n#include <QByteArray>\n#include <QJsonObject>\n#include <QJsonValue>\n#include <QObject>\n#include <QString>\n#include <QTimer>\n#include <chrono>\n#include <initializer_list>\n#include <string>\n#include <utility>\ninline QByteArray QByteArray::fromStdString(const std::string &s) { return QByteArray(s.data(), s.size()); }\ninline std::string QByteArray::toStdString() const { return std::string(constData(), size()); }\ninline QJsonObject::QJsonObject(std::initializer_list<std::pair<QString, QJsonValue>> args) : QJsonObject() {\n  for (const auto &arg : args) { insert(arg.first, arg.second); }\n}\nextern \"C\" void _ZN6QTimer14singleShotImplENSt6chrono8durationIlSt5ratioILl1ELl1000000000EEEEN2Qt9TimerTypeEPK7QObjectPN9QtPrivate15QSlotObjectBaseE(\n    long ns, Qt::TimerType timerType, const QObject *receiver, QtPrivate::QSlotObjectBase *slotObj);\ninline void QTimer::singleShotImpl(std::chrono::nanoseconds ns, Qt::TimerType timerType, const QObject *receiver, QtPrivate::QSlotObjectBase *slotObj) {\n  _ZN6QTimer14singleShotImplENSt6chrono8durationIlSt5ratioILl1ELl1000000000EEEEN2Qt9TimerTypeEPK7QObjectPN9QtPrivate15QSlotObjectBaseE(\n      ns.count(), timerType, receiver, slotObj);\n}\n#endif\n"],
)

genrule(
    name = "gen_ui_rqt_plansys2_knowledge_h",
    srcs = ["src/rqt_plansys2_knowledge/rqt_plansys2_knowledge.ui"],
    outs = ["_gen/include/ui_rqt_plansys2_knowledge.h"],
    cmd = select({
        "@rules_qt//:linux_x86_64": "$(location @qt_linux_x86_64//:uic) $(location src/rqt_plansys2_knowledge/rqt_plansys2_knowledge.ui) -o $@",
        "@rules_qt//:linux_aarch64": "$(location @qt_linux_aarch64//:uic) $(location src/rqt_plansys2_knowledge/rqt_plansys2_knowledge.ui) -o $@",
        "@platforms//os:windows": "$(location @qt_windows_x86_64//:uic) $(location src/rqt_plansys2_knowledge/rqt_plansys2_knowledge.ui) -o $@",
        "@rules_qt//:osx_x86_64": "$(location @qt_mac_x86_64//:uic) $(location src/rqt_plansys2_knowledge/rqt_plansys2_knowledge.ui) -o $@",
        "@rules_qt//:osx_arm64": "$(location @qt_mac_aarch64//:uic) $(location src/rqt_plansys2_knowledge/rqt_plansys2_knowledge.ui) -o $@",
    }),
    tools = select({
        "@rules_qt//:linux_x86_64": ["@qt_linux_x86_64//:uic"],
        "@rules_qt//:linux_aarch64": ["@qt_linux_aarch64//:uic"],
        "@platforms//os:windows": ["@qt_windows_x86_64//:uic"],
        "@rules_qt//:osx_arm64": ["@qt_mac_aarch64//:uic"],
        "@rules_qt//:osx_x86_64": ["@qt_mac_x86_64//:uic"],
    }),
)

