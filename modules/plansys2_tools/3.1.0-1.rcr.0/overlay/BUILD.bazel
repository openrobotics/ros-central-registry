load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@qt//:qt.bzl", "qt_cc_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@plansys2_problem_expert//:plansys2_problem_expert": "@plansys2_problem_expert//:plansys2_problem_expert_library",
    "@qt_gui_cpp//:qt_gui_cpp_shared": "@qt_gui_cpp//:qt_gui_cpp",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rqt_gui_cpp//:rqt_gui_cpp_shared": "@rqt_gui_cpp//:rqt_gui_cpp",
}

CC_DEPS = [
    "@plansys2_msgs//:cc",
    "@qtbase//:widgets",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "plansys2_logger_library",
    srcs = ["src/plansys2_logger/LoggerNode.cpp"],
    hdrs = [
        "include/plansys2_logger/LoggerNode.hpp",
        "include/rqt_plansys2_knowledge/KnowledgeTree.hpp",
        "include/rqt_plansys2_knowledge/RQTKnowledge.hpp",
        "include/rqt_plansys2_performers/PerformersTree.hpp",
        "include/rqt_plansys2_performers/RQTPerformers.hpp",
        "include/rqt_plansys2_plan/PlanTree.hpp",
        "include/rqt_plansys2_plan/RQTPlan.hpp",
    ] + [
        ":gen_ui_rqt_plansys2_knowledge_h",
        ":gen_ui_rqt_plansys2_performers_h",
        ":gen_ui_rqt_plansys2_plan_h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        ".",
        "_gen/include",
        "include",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "plansys2_logger",
    dynamic_deps = DEPENDENCIES.keys() + [
        "@qtbase//:widgets_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":plansys2_logger_library"],
)

qt_cc_library(
    name = "rqt_plansys2_knowledge_library",
    srcs = [
        "src/rqt_plansys2_knowledge/KnowledgeTree.cpp",
        "src/rqt_plansys2_knowledge/RQTKnowledge.cpp",
    ],
    hdrs = ["include/rqt_plansys2_knowledge/RQTKnowledge.hpp"] + [
        "include/plansys2_logger/LoggerNode.hpp",
        "include/rqt_plansys2_knowledge/KnowledgeTree.hpp",
        "include/rqt_plansys2_performers/PerformersTree.hpp",
        "include/rqt_plansys2_performers/RQTPerformers.hpp",
        "include/rqt_plansys2_plan/PlanTree.hpp",
        "include/rqt_plansys2_plan/RQTPlan.hpp",
        ":gen_ui_rqt_plansys2_knowledge_h",
        ":gen_ui_rqt_plansys2_performers_h",
        ":gen_ui_rqt_plansys2_plan_h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        ".",
        "_gen/include",
        "include",
    ],
    local_defines = ros_local_defines() + [
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    moc_hdrs = ["include/rqt_plansys2_knowledge/RQTKnowledge.hpp"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rqt_plansys2_knowledge",
    dynamic_deps = DEPENDENCIES.keys() + [
        "@qtbase//:widgets_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":rqt_plansys2_knowledge_library"],
)

qt_cc_library(
    name = "rqt_plansys2_performers_library",
    srcs = [
        "src/rqt_plansys2_performers/PerformersTree.cpp",
        "src/rqt_plansys2_performers/RQTPerformers.cpp",
    ],
    hdrs = ["include/rqt_plansys2_performers/RQTPerformers.hpp"] + [
        "include/plansys2_logger/LoggerNode.hpp",
        "include/rqt_plansys2_knowledge/KnowledgeTree.hpp",
        "include/rqt_plansys2_knowledge/RQTKnowledge.hpp",
        "include/rqt_plansys2_performers/PerformersTree.hpp",
        "include/rqt_plansys2_plan/PlanTree.hpp",
        "include/rqt_plansys2_plan/RQTPlan.hpp",
        ":gen_ui_rqt_plansys2_knowledge_h",
        ":gen_ui_rqt_plansys2_performers_h",
        ":gen_ui_rqt_plansys2_plan_h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        ".",
        "_gen/include",
        "include",
    ],
    local_defines = ros_local_defines() + [
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "_FILE_OFFSET_BITS=64",
    ],
    moc_hdrs = ["include/rqt_plansys2_performers/RQTPerformers.hpp"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rqt_plansys2_performers",
    dynamic_deps = DEPENDENCIES.keys() + [
        "@qtbase//:widgets_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":rqt_plansys2_performers_library"],
)

qt_cc_library(
    name = "rqt_plansys2_plan_library",
    srcs = [
        "src/rqt_plansys2_plan/PlanTree.cpp",
        "src/rqt_plansys2_plan/RQTPlan.cpp",
    ],
    hdrs = ["include/rqt_plansys2_plan/RQTPlan.hpp"] + [
        "include/plansys2_logger/LoggerNode.hpp",
        "include/rqt_plansys2_knowledge/KnowledgeTree.hpp",
        "include/rqt_plansys2_knowledge/RQTKnowledge.hpp",
        "include/rqt_plansys2_performers/PerformersTree.hpp",
        "include/rqt_plansys2_performers/RQTPerformers.hpp",
        "include/rqt_plansys2_plan/PlanTree.hpp",
        ":gen_ui_rqt_plansys2_knowledge_h",
        ":gen_ui_rqt_plansys2_performers_h",
        ":gen_ui_rqt_plansys2_plan_h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        ".",
        "_gen/include",
        "include",
    ],
    local_defines = ros_local_defines() + ["_FILE_OFFSET_BITS=64"],
    moc_hdrs = ["include/rqt_plansys2_plan/RQTPlan.hpp"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rqt_plansys2_plan",
    dynamic_deps = DEPENDENCIES.keys() + [
        "@qtbase//:widgets_shared",
    ],
    exports_filter = ["//:__subpackages__"],
    deps = [":rqt_plansys2_plan_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":plansys2_logger",
        ":rqt_plansys2_knowledge",
        ":rqt_plansys2_performers",
        ":rqt_plansys2_plan",
    ],
)

cc_binary(
    name = "logger",
    srcs = ["src/logger.cpp"] + [
        "include/plansys2_logger/LoggerNode.hpp",
        "include/rqt_plansys2_knowledge/KnowledgeTree.hpp",
        "include/rqt_plansys2_knowledge/RQTKnowledge.hpp",
        "include/rqt_plansys2_performers/PerformersTree.hpp",
        "include/rqt_plansys2_performers/RQTPerformers.hpp",
        "include/rqt_plansys2_plan/PlanTree.hpp",
        "include/rqt_plansys2_plan/RQTPlan.hpp",
    ] + [
        ":gen_ui_rqt_plansys2_knowledge_h",
        ":gen_ui_rqt_plansys2_performers_h",
        ":gen_ui_rqt_plansys2_plan_h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    dynamic_deps = [
        ":transitive_dynamic_deps",
        "@qtbase//:widgets_shared",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS + [":plansys2_logger_library"],
)

genrule(
    name = "gen_ui_rqt_plansys2_knowledge_h",
    srcs = ["src/rqt_plansys2_knowledge/rqt_plansys2_knowledge.ui"],
    outs = ["_gen/include/ui_rqt_plansys2_knowledge.h"],
    cmd = "$(execpath @qtbase//:uic) $(location src/rqt_plansys2_knowledge/rqt_plansys2_knowledge.ui) -o $@",
    tools = ["@qtbase//:uic"],
)

genrule(
    name = "gen_ui_rqt_plansys2_performers_h",
    srcs = ["src/rqt_plansys2_performers/rqt_plansys2_performers.ui"],
    outs = ["_gen/include/ui_rqt_plansys2_performers.h"],
    cmd = "$(execpath @qtbase//:uic) $(location src/rqt_plansys2_performers/rqt_plansys2_performers.ui) -o $@",
    tools = ["@qtbase//:uic"],
)

genrule(
    name = "gen_ui_rqt_plansys2_plan_h",
    srcs = ["src/rqt_plansys2_plan/rqt_plansys2_plan.ui"],
    outs = ["_gen/include/ui_rqt_plansys2_plan.h"],
    cmd = "$(execpath @qtbase//:uic) $(location src/rqt_plansys2_plan/rqt_plansys2_plan.ui) -o $@",
    tools = ["@qtbase//:uic"],
)

ament_index(
    name = "ament_index",
    executables = [
        "scripts/rqt_plansys2_knowledge",
        "scripts/rqt_plansys2_performers",
        "scripts/rqt_plansys2_plan",
    ],
    libraries = [
        ":plansys2_logger",
        ":rqt_plansys2_knowledge",
        ":rqt_plansys2_performers",
        ":rqt_plansys2_plan",
    ],
    package_xml = "package.xml",
    plugin_category = "rqt_gui",
    plugins = [
        "plugin_knowledge.xml",
        "plugin_performers.xml",
        "plugin_plan.xml",
    ],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@plansys2_msgs//:ament_package",
        "@plansys2_problem_expert//:ament_package",
        "@qt_gui_cpp//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_cpp//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "Qt6",
        "plansys2_msgs",
        "plansys2_problem_expert",
        "qt_gui_cpp",
        "rclcpp",
        "rqt_gui_cpp",
    ],
    cmake_export_include_directories = False,
    cmake_export_name = "rqt_plansys2",
    libraries = [
        ":plansys2_logger",
        ":rqt_plansys2_knowledge",
        ":rqt_plansys2_performers",
        ":rqt_plansys2_plan",
    ],
    package_xml = "package.xml",
    programs = [
        ":logger",
        "scripts/rqt_plansys2_knowledge",
        "scripts/rqt_plansys2_performers",
        "scripts/rqt_plansys2_plan",
    ],
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@plansys2_msgs//:ament_package",
        "@plansys2_problem_expert//:ament_package",
        "@qt_gui_cpp//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rqt_gui//:ament_package",
        "@rqt_gui_cpp//:ament_package",
    ],
)
