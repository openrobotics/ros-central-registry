    "@plansys2_msgs//:cc",
    "@qt_gui_cpp//:qt_gui_cpp",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rqt_gui_cpp//:rqt_gui_cpp",
    "@rules_qt//:qt_widgets",
]

cc_library(
    name = "plansys2_logger_library",
    srcs = ["src/plansys2_logger/LoggerNode.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_rcr_qt_libc_shim_hpp",
        ":gen_ui_rqt_plansys2_knowledge_h",
        ":gen_ui_rqt_plansys2_performers_h",
        ":gen_ui_rqt_plansys2_plan_h",
    ],
    copts = [
        "-std=c++23",
        "-Wno-missing-template-arg-list-after-template-kw",
        "-include",
        "rcr_qt_libc_shim.hpp",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "plansys2_logger",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":plansys2_logger_library"],
)

