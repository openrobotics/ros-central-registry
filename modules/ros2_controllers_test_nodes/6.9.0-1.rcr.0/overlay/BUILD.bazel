load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

py_library(
    name = "ros2_controllers_test_nodes",
    srcs = [
        "ros2_controllers_test_nodes/__init__.py",
        "ros2_controllers_test_nodes/publisher_forward_position_controller.py",
        "ros2_controllers_test_nodes/publisher_joint_trajectory_controller.py",
    ],
    imports = ["."],
    deps = [
        "@launch_ros",
        "@launch_testing_ros",
        "@rclpy",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        "@trajectory_msgs//:py",
    ],
)

ament_package(
    name = "ament_package",
    console_scripts = {
        "publisher_forward_position_controller": "ros2_controllers_test_nodes.publisher_forward_position_controller:main",
        "publisher_joint_trajectory_controller": "ros2_controllers_test_nodes.publisher_joint_trajectory_controller:main",
    },
    data = [
        "//test:rrbot_forward_position_publisher.yaml",
        "//test:rrbot_joint_trajectory_publisher.yaml",
    ],
    package_xml = "package.xml",
    python = [":ros2_controllers_test_nodes"],
    deps = [
        "@launch_ros//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@trajectory_msgs//:ament_package",
    ],
)
