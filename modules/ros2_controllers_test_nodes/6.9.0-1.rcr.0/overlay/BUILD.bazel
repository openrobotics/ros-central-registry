load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "ros2_controllers_test_nodes",
    srcs = glob(["ros2_controllers_test_nodes/**/*.py"]),
    imports = ["."],
    deps = [
        "@launch_ros",
        "@launch_testing_ros",
        "@rclpy",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        "@trajectory_msgs//:py",
    ],
)

launch_ros_test(
    name = "test_publisher_forward_position_controller_launch",
    src = "test/test_publisher_forward_position_controller_launch.py",
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":ros2_controllers_test_nodes"],
)

launch_ros_test(
    name = "test_publisher_joint_trajectory_controller_launch",
    src = "test/test_publisher_joint_trajectory_controller_launch.py",
    data = glob(["test/**"]),
    imports = [
        ".",
        "test",
    ],
    tags = [
        "manual",
        "xfail",
    ],
    deps = [":ros2_controllers_test_nodes"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        "publisher_forward_position_controller": "ros2_controllers_test_nodes.publisher_forward_position_controller:main",
        "publisher_joint_trajectory_controller": "ros2_controllers_test_nodes.publisher_joint_trajectory_controller:main",
    },
    data = [
        "test/rrbot_forward_position_publisher.yaml",
        "test/rrbot_joint_trajectory_publisher.yaml",
    ],
    package_xml = "package.xml",
    python = [":ros2_controllers_test_nodes"],
    deps = [
        "@launch_ros//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@trajectory_msgs//:ament_package",
    ],
)
