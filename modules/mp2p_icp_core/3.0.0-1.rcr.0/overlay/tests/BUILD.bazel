[
    cc_test(
        name = "run_test-" + name,
        srcs = ["test-" + name + ".cpp"],
        copts = [
            "-Wno-missing-template-arg-list-after-template-kw",
        ],
        data = ["//:ament_index"] + ["CMakeLists.txt"],
        dynamic_deps = ["//:transitive_dynamic_deps"],
        includes = ["."],
        local_defines = ros_local_defines() + [
            'MOLA_MODULE_SOURCE_DIR=\\"tests\\"',
            'MP2P_DATASET_DIR=\\"demos/\\"',
            "MP2P_ICP_HAS_MOLA_IMU_PREINTEGRATION",
            "NDEBUG",
        ],
        tags = [
            "manual",
            "xfail",
        ] if ("run_test-" + name) in _xfail_names else [],
        deps = DEPENDENCIES.values() + CC_DEPS + [
            "//:mp2p_icp_common_library",
            "//:mp2p_icp_library",
            "//:mp2p_icp_map_library",
            "@rosdistro//cc:bazel_test_helper",
            "@rosdistro//cc:googletest",
        ] + (["//:mp2p_icp_filters_library"] if name in FILTER_TESTS else []),
    )
    for name in TESTS + FILTER_TESTS
]
