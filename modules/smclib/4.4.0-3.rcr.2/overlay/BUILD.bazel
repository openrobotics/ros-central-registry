load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MPL-1.1",
    ],
)

cc_library(
    name = "smclib_header",
    hdrs = ["include/smclib/statemap.hpp"],
    includes = ["include"],
)

py_library(
    name = "smclib",
    srcs = glob(["smclib/**/*.py"]),
    imports = ["."],
)

### PACKAGING

ament_package(
    name = "ament_package",
    cmake_export_dependencies = False,
    cmake_export_libraries = False,
    cmake_export_name = "smclib_header",
    headers = ["include/smclib/statemap.hpp"],
    libraries = [":smclib_header"],
    package_xml = "package.xml",
    python = [":smclib"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
