cc_library(
    name = "obstacle1_library",
    srcs = ["src/obstacle1.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/turtlebot3_gazebo",
    ],
    local_defines = ros_local_defines() + ["HAVE_PYBIND11"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "obstacle1",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":obstacle1_library"],
)

