load("@launch_ros//:defs.bzl", "launch_ros_binary")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "launch_files",
    srcs = [
        "empty_world.launch.py",
        "robot_state_publisher.launch.py",
        "spawn_turtlebot3.launch.py",
        "turtlebot3_dqn_stage1.launch.py",
        "turtlebot3_dqn_stage2.launch.py",
        "turtlebot3_dqn_stage3.launch.py",
        "turtlebot3_dqn_stage4.launch.py",
        "turtlebot3_house.launch.py",
        "turtlebot3_world.launch.py",
    ],
)

launch_ros_binary(
    name = "empty_world_launch",
    src = "empty_world.launch.py",
    deps = [
        ":robot_state_publisher_launch",
        ":spawn_turtlebot3_launch",
        "@ament_index_python",
        "@ros_gz_sim//launch:gz_sim_launch",
    ],
)

launch_ros_binary(
    name = "robot_state_publisher_launch",
    src = "robot_state_publisher.launch.py",
    data = ["//:ament_index"],
    deps = [
        "@ament_index_python",
        "@robot_state_publisher",
    ],
)

launch_ros_binary(
    name = "spawn_turtlebot3_launch",
    src = "spawn_turtlebot3.launch.py",
    data = ["//:ament_index"],
    deps = [
        "@ament_index_python",
        "@ros_gz_bridge//:parameter_bridge",
        "@ros_gz_image//:image_bridge",
        "@ros_gz_sim//:create",
    ],
)

launch_ros_binary(
    name = "turtlebot3_dqn_stage1_launch",
    src = "turtlebot3_dqn_stage1.launch.py",
    deps = [
        ":robot_state_publisher_launch",
        ":spawn_turtlebot3_launch",
        "@ament_index_python",
        "@ros_gz_sim//launch:gz_sim_launch",
    ],
)

launch_ros_binary(
    name = "turtlebot3_dqn_stage2_launch",
    src = "turtlebot3_dqn_stage2.launch.py",
    deps = [
        ":robot_state_publisher_launch",
        ":spawn_turtlebot3_launch",
        "@ament_index_python",
        "@ros_gz_sim//launch:gz_sim_launch",
    ],
)

launch_ros_binary(
    name = "turtlebot3_dqn_stage3_launch",
    src = "turtlebot3_dqn_stage3.launch.py",
    deps = [
        ":robot_state_publisher_launch",
        ":spawn_turtlebot3_launch",
        "@ament_index_python",
        "@ros_gz_sim//launch:gz_sim_launch",
    ],
)

launch_ros_binary(
    name = "turtlebot3_dqn_stage4_launch",
    src = "turtlebot3_dqn_stage4.launch.py",
    deps = [
        ":robot_state_publisher_launch",
        ":spawn_turtlebot3_launch",
        "@ament_index_python",
        "@ros_gz_sim//launch:gz_sim_launch",
    ],
)

launch_ros_binary(
    name = "turtlebot3_house_launch",
    src = "turtlebot3_house.launch.py",
    deps = [
        ":robot_state_publisher_launch",
        ":spawn_turtlebot3_launch",
        "@ament_index_python",
        "@ros_gz_sim//launch:gz_sim_launch",
    ],
)

launch_ros_binary(
    name = "turtlebot3_world_launch",
    src = "turtlebot3_world.launch.py",
    deps = [
        ":robot_state_publisher_launch",
        ":spawn_turtlebot3_launch",
        "@ament_index_python",
        "@ros_gz_sim//launch:gz_sim_launch",
    ],
)
