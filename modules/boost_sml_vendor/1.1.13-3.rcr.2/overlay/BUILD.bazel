load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:ament_resource.bzl", "register_ament_resource")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
]

cc_library(
    name = "boost_sml_vendor_library",
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ) + [
        ":gen_extra_0",
        ":gen_extra_1",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = ["_gen/opt/boost_sml_vendor/include"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

register_ament_resource(
    name = "res_vendor_packages",
    category = "vendor_packages",
    content = "opt/boost_sml_vendor",
)

