load("@launch_ros//:defs.bzl", "launch_ros_binary")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@nav_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@sensor_msgs//:cc",
    "@tf2_msgs//:cc",
    "@turtlebot3_msgs//:cc",
]

cc_library(
    name = "turtlebot3_fake_node_library",
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        "include",
        "include/turtlebot3_fake_node",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "turtlebot3_fake_node",
    srcs = ["src/turtlebot3_fake_node.cpp"] + glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "include",
        "include/turtlebot3_fake_node",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

ament_index(
    name = "ament_index",
    data = [
        "launch/rviz2.launch.py",
        "launch/turtlebot3_fake_node.launch.py",
        "param/burger.yaml",
        "param/waffle.yaml",
        "param/waffle_pi.yaml",
    ],
    lib_data = [":turtlebot3_fake_node"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_msgs//:ament_package",
        "@turtlebot3_msgs//:ament_package",
    ],
)

[
    launch_ros_binary(
        name = f.split("/")[-1],
        src = f,
        data = [":ament_index"],
    )
    for f in glob(["launch/**"])
]

ament_package(
    cmake_export_dependencies_list = [
        "geometry_msgs",
        "nav_msgs",
        "rclcpp",
        "sensor_msgs",
        "tf2",
        "tf2_msgs",
        "turtlebot3_msgs",
    ],
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.hxx",
            "include/**/*.ipp",
            "include/**/*.inl",
        ],
        allow_empty = True,
    ),
    include_prefix = "",
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_msgs//:ament_package",
        "@turtlebot3_msgs//:ament_package",
    ],
)
