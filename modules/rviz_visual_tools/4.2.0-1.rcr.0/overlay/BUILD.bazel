    "@trajectory_msgs//:cc",
    "@visualization_msgs//:cc",
]

cc_library(
    name = "rviz_visual_tools_remote_control_library",
    srcs = ["src/remote_control.cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        ".",
        "include",
        "include/rviz_visual_tools",
    ],
    local_defines = ros_local_defines() + ["_USE_MATH_DEFINES"],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rviz_visual_tools_remote_control",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["@@//:__subpackages__"],
    deps = [":rviz_visual_tools_remote_control_library"],
)

cc_library(
    name = "rviz_visual_tools_library",
    srcs = [
        "src/rviz_visual_tools.cpp",
        "src/tf_visual_tools.cpp",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
        ],
        allow_empty = True,
    ),
    copts = ["-std=c++20"],
    includes = [
        ".",
        "include",
        "include/rviz_visual_tools",
    ],
    local_defines = ros_local_defines() + ["_USE_MATH_DEFINES"],
    deps = DEPENDENCIES.values() + CC_DEPS + [":rviz_visual_tools_remote_control_library"],
)

cc_shared_library(
    name = "rviz_visual_tools",
    dynamic_deps = DEPENDENCIES.keys() + [":rviz_visual_tools_remote_control"],
    exports_filter = ["@@//:__subpackages__"],
    deps = [":rviz_visual_tools_library"],
)

qt_cc_library(
    name = "rviz_visual_tools_gui_library",
    srcs = [
        "src/key_tool.cpp",
        "src/remote_control.cpp",
        "src/rviz_visual_tools_gui.cpp",
    ],
    hdrs = [
        "include/rviz_visual_tools/key_tool.hpp",
        "include/rviz_visual_tools/remote_control.hpp",
        "include/rviz_visual_tools/remote_reciever.hpp",
        "include/rviz_visual_tools/rviz_visual_tools_gui.hpp",
    ],
    copts = ["-std=c++20"],
    includes = [
        ".",
        "include",
        "include/rviz_visual_tools",
    ],
    local_defines = ros_local_defines() + [
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        "QT_NO_KEYWORDS",
        "_FILE_OFFSET_BITS=64",
    ],
    normal_hdrs = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
        ],
        allow_empty = True,
        exclude = [
            "include/rviz_visual_tools/key_tool.hpp",
            "include/rviz_visual_tools/remote_control.hpp",
            "include/rviz_visual_tools/remote_reciever.hpp",
            "include/rviz_visual_tools/rviz_visual_tools_gui.hpp",
        ],
    ),
    deps = DEPENDENCIES.values() + CC_DEPS + ["@rules_qt//:qt_widgets"],
)

cc_shared_library(
    name = "rviz_visual_tools_gui",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [
        ":rviz_visual_tools_gui_library",
        "//:__subpackages__",
    ],
    deps = [":rviz_visual_tools_gui_library"],
)

cc_library(
    name = "rviz_visual_tools_imarker_simple_library",
