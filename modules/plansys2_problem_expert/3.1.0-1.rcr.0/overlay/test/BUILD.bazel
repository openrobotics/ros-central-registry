load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@lifecycle_msgs//:cc_shared": "@lifecycle_msgs//:cc",
    "@plansys2_domain_expert//:plansys2_domain_expert": "@plansys2_domain_expert//:plansys2_domain_expert_library",
    "@plansys2_msgs//:cc_shared": "@plansys2_msgs//:cc",
    "@plansys2_pddl_parser//:plansys2_pddl_parser": "@plansys2_pddl_parser//:plansys2_pddl_parser_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

exports_files([
    "CMakeLists.txt",
    "pddl/domain_charging.pddl",
    "pddl/domain_exists.pddl",
    "pddl/domain_simple.pddl",
    "pddl/domain_simple_constants.pddl",
    "pddl/domain_simple_derived.pddl",
    "pddl/problem_charging.pddl",
    "pddl/problem_empty_domain.pddl",
    "pddl/problem_simple_1.pddl",
    "pddl/problem_simple_constants_1.pddl",
    "pddl/problem_simple_constants_2.pddl",
    "pddl/problem_unexpected_syntax.pddl",
    "unit/CMakeLists.txt",
    "unit/problem_expert_node_test.cpp",
    "unit/problem_expert_test.cpp",
    "unit/utils_test.cpp",
])

cc_test(
    name = "problem_expert_node_test",
    srcs = ["unit/problem_expert_node_test.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = ["//:ament_index"] + [
        "CMakeLists.txt",
        "pddl/domain_charging.pddl",
        "pddl/domain_exists.pddl",
        "pddl/domain_simple.pddl",
        "pddl/domain_simple_constants.pddl",
        "pddl/domain_simple_derived.pddl",
        "pddl/problem_charging.pddl",
        "pddl/problem_empty_domain.pddl",
        "pddl/problem_simple_1.pddl",
        "pddl/problem_simple_constants_1.pddl",
        "pddl/problem_simple_constants_2.pddl",
        "pddl/problem_unexpected_syntax.pddl",
        "unit/CMakeLists.txt",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["unit"],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:plansys2_problem_expert_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

