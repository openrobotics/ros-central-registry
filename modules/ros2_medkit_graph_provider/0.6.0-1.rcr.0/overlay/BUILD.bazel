load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

exports_files(["src/graph_provider_plugin.cpp"])

DEPENDENCIES = {
    "@diagnostic_msgs//:cc_shared": "@diagnostic_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@ros2_medkit_gateway//:test_bad_version_plugin": "@ros2_medkit_gateway//:test_bad_version_plugin_library",
    "@ros2_medkit_gateway//:test_gateway_plugin": "@ros2_medkit_gateway//:test_gateway_plugin_library",
    "@ros2_medkit_gateway//:test_minimal_plugin": "@ros2_medkit_gateway//:test_minimal_plugin_library",
    "@ros2_medkit_gateway//:test_no_symbols_plugin": "@ros2_medkit_gateway//:test_no_symbols_plugin_library",
    "@ros2_medkit_gateway//:test_null_factory_plugin": "@ros2_medkit_gateway//:test_null_factory_plugin_library",
    "@ros2_medkit_gateway//:test_update_backend": "@ros2_medkit_gateway//:test_update_backend_library",
    "@ros2_medkit_gateway//:test_version_only_plugin": "@ros2_medkit_gateway//:test_version_only_plugin_library",
    "@ros2_medkit_msgs//:cc_shared": "@ros2_medkit_msgs//:cc",
    "@rosdistro//cc:boringssl": "@rosdistro//cc:boringssl_crypto_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:sqlite3": "@rosdistro//cc:sqlite3_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
    "@rosdistro//cc:boringssl_ssl_library",
    "@rosdistro//cc:nlohmann_json",
]

cc_library(
    name = "ros2_medkit_graph_provider_plugin_library",
    srcs = [
        "src/graph_provider_plugin.cpp",
        "src/graph_provider_plugin_exports.cpp",
    ],
    hdrs = ["include/ros2_medkit_graph_provider/graph_provider_plugin.hpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "include",
        "include/ros2_medkit_graph_provider",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ros2_medkit_graph_provider_plugin",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":ros2_medkit_graph_provider_plugin_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ros2_medkit_graph_provider_plugin"],
)

ament_index(
    name = "ament_index",
    lib_data = [":ros2_medkit_graph_provider_plugin"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@ros2_medkit_cmake//:ament_package",
        "@ros2_medkit_gateway//:ament_package",
        "@ros2_medkit_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@ros2_medkit_cmake//:ament_package",
        "@ros2_medkit_gateway//:ament_package",
        "@ros2_medkit_msgs//:ament_package",
    ],
)
