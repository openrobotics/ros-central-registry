 #include "off_highway_can/helper.hpp"
 
+namespace
+{
+// Converting an out-of-range double straight to uint8_t is undefined behaviour:
+// x86 wraps (-1.0 -> 255, which the invalid-temperature encoding relies on)
+// while arm64 saturates (-1.0 -> 0). Go through a wide integer first so the
+// final narrowing is the well-defined modulo conversion on every platform.
+inline uint8_t to_uint8(double value)
+{
+  return static_cast<uint8_t>(static_cast<int64_t>(value));
+}
+}  // namespace
