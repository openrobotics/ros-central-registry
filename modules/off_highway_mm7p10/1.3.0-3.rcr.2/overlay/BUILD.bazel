load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@can_msgs//:cc_shared": "@can_msgs//:cc",
    "@diagnostic_msgs//:cc_shared": "@diagnostic_msgs//:cc",
    "@off_highway_can//:off_highway_can": "@off_highway_can//:off_highway_can_library",
    "@off_highway_mm7p10_msgs//:cc_shared": "@off_highway_mm7p10_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:component_manager": "@rclcpp_components//:component_manager_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
}

CC_DEPS = [
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "off_highway_mm7p10_library",
    srcs = ["src/receiver.cpp"],
    hdrs = ["include/off_highway_mm7p10/receiver.hpp"],
    includes = [
        ".",
        "include",
        "include/off_highway_mm7p10",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "off_highway_mm7p10",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":off_highway_mm7p10_library"],
)

rclcpp_components_register_node(
    name = "receiver",
    component = ":off_highway_mm7p10",
    data = [
        ":ament_index",
    ],
    node_name = "receiver",
    plugin = "off_highway_mm7p10::Receiver",
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":off_highway_mm7p10"],
)

ament_index(
    name = "ament_index",
    components = [":receiver_record"],
    data = [
        "config/receiver_params.yaml",
        "//launch:launch_files",
    ],
    libraries = [":off_highway_mm7p10"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@can_msgs//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@off_highway_can//:ament_package",
        "@off_highway_mm7p10_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "can_msgs",
        "off_highway_can",
        "off_highway_mm7p10_msgs",
        "rclcpp",
        "rclcpp_components",
        "sensor_msgs",
        "tf2",
    ],
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_name = "export_off_highway_mm7p10",
    executables = [
        ":receiver",
    ],
    headers = ["include/off_highway_mm7p10/receiver.hpp"],
    include_prefix = "",
    libraries = [":off_highway_mm7p10"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@can_msgs//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@off_highway_can//:ament_package",
        "@off_highway_mm7p10_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
    ],
)
