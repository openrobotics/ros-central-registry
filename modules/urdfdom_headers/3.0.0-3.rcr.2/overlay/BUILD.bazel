load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### LIBRARIES

HEADERS = glob(["include/**/*.h"])

cc_library(
    name = "urdfdom_headers_library",
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
)

# urdfdom_headers is header-only upstream (an INTERFACE target); this empty
# shared library only exists so dependents can keep listing it in
# dynamic_deps, and is deliberately not installed.
cc_shared_library(
    name = "urdfdom_headers",
    exports_filter = [":urdfdom_headers_library"],
    deps = [":urdfdom_headers_library"],
)

### PKG-CONFIG & CMAKE

# configure_file(cmake/pkgconfig/urdfdom_headers.pc.in ...) installed to
# lib/pkgconfig/ (plain CMake package, CMAKE_INSTALL_INCLUDEDIR=include/urdfdom_headers).
expand_template(
    name = "pkgconfig_pc",
    out = "pkgconfig/urdfdom_headers.pc",
    substitutions = {
        "@PROJECT_NAME@": "urdfdom_headers",
        "@RELATIVE_PATH_LIBDIR_TO_PREFIX@": "..",
        "@CMAKE_INSTALL_INCLUDEDIR@": "include/urdfdom_headers",
        "@PACKAGE_NAME@": "urdfdom_headers",
        "@PACKAGE_DESC@": "Unified Robot Description Format",
        "@URDF_VERSION@": "3.0.0",
    },
    template = "cmake/pkgconfig/urdfdom_headers.pc.in",
)

pkg_files(
    name = "pkgconfig",
    srcs = [":pkgconfig_pc"],
    prefix = "lib/pkgconfig",
)

expand_template(
    name = "cmake_config",
    out = "cmake_out/urdfdom_headers-config.cmake",
    substitutions = {
        "@PROJECT_NAME@": "urdfdom_headers",
        "@PACKAGE_NAME@": "urdfdom_headers",
        "@RELATIVE_PATH_CMAKE_DIR_TO_PREFIX@": "../../..",
        "@CMAKE_INSTALL_INCLUDEDIR@": "include/urdfdom_headers",
        "@TARGET_NAME@": "urdfdom_headers",
    },
    template = "cmake/urdfdom_headers-config.cmake.in",
)

write_file(
    name = "cmake_config_version",
    out = "cmake_out/urdfdom_headers-config-version.cmake",
    content = [
        'set(PACKAGE_VERSION "3.0.0")',
        "if(PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION)",
        "  set(PACKAGE_VERSION_COMPATIBLE FALSE)",
        "else()",
        '  if(PACKAGE_FIND_VERSION_MAJOR STREQUAL "3")',
        "    set(PACKAGE_VERSION_COMPATIBLE TRUE)",
        "  else()",
        "    set(PACKAGE_VERSION_COMPATIBLE FALSE)",
        "  endif()",
        "  if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)",
        "    set(PACKAGE_VERSION_EXACT TRUE)",
        "  endif()",
        "endif()",
        "",
    ],
)

write_file(
    name = "cmake_export",
    out = "cmake_out/urdfdom_headersExport.cmake",
    content = [
        "if(NOT TARGET urdfdom_headers::urdfdom_headers)",
        '  get_filename_component(_IMPORT_PREFIX "${CMAKE_CURRENT_LIST_FILE}" PATH)',
        '  get_filename_component(_IMPORT_PREFIX "${_IMPORT_PREFIX}" PATH)',
        '  get_filename_component(_IMPORT_PREFIX "${_IMPORT_PREFIX}" PATH)',
        '  get_filename_component(_IMPORT_PREFIX "${_IMPORT_PREFIX}" PATH)',
        "  add_library(urdfdom_headers::urdfdom_headers INTERFACE IMPORTED)",
        "  set_target_properties(urdfdom_headers::urdfdom_headers PROPERTIES",
        '    INTERFACE_INCLUDE_DIRECTORIES "${_IMPORT_PREFIX}/include/urdfdom_headers"',
        "  )",
        "  set(_IMPORT_PREFIX)",
        "endif()",
        "",
    ],
)

pkg_files(
    name = "cmake_files",
    srcs = [
        ":cmake_config",
        ":cmake_config_version",
        ":cmake_export",
    ],
    prefix = "lib/urdfdom_headers/cmake",
)

### PACKAGING

ament_package(
    name = "ament_package",
    build_type = "cmake",
    headers = HEADERS,
    install = [
        ":cmake_files",
        ":pkgconfig",
    ],
    deps = [
        "@rosdistro//:ament_package",
    ],
)
