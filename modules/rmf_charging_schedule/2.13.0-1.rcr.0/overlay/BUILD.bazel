load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "rmf_charging_schedule",
    srcs = [
        "rmf_charging_schedule/__init__.py",
        "rmf_charging_schedule/main.py",
    ],
    imports = ["."],
    deps = [
        "@rclpy",
        "@rmf_fleet_msgs//:py",
        requirement("pyyaml"),
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {"charging_schedule": "rmf_charging_schedule.main:main"},
    package_xml = "package.xml",
    python = [":rmf_charging_schedule"],
    setup_cfg = "setup.cfg",
    deps = [
        "@rclpy//:ament_package",
        "@rmf_fleet_msgs//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
