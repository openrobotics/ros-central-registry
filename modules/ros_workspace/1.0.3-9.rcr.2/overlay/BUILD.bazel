load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PACKAGING

# ros_workspace only contributes environment hooks (library_path, pythonpath)
# and the top-level setup.* files generated by ament_generate_environment(); it
# has no headers, libraries or executables of its own.
ament_package(
    name = "ament_package",
    # package.xml says build_type cmake, but upstream calls ament_package()
    # from ament_cmake_core and installs the usual ament_cmake metadata.
    build_type = "ament_cmake",
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_core//:ament_package",
        "@ament_package",
        "@rosdistro//:ament_package",
    ],
)
