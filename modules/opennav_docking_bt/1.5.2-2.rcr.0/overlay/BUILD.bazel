load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

DEPENDENCIES = {
    "@backward_ros//:backward": "@backward_ros//:backward_library",
    "@behaviortree_cpp//:behaviortree_cpp": "@behaviortree_cpp//:behaviortree_cpp_library",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@nav2_behavior_tree//:nav2_behavior_tree": "@nav2_behavior_tree//:nav2_behavior_tree_library",
    "@nav2_msgs//:cc_shared": "@nav2_msgs//:cc",
    "@nav2_util//:nav2_util_core": "@nav2_util//:nav2_util_core_library",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:libyaml": "@rosdistro//cc:libyaml_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:sqlite3": "@rosdistro//cc:sqlite3_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:zmq": "@rosdistro//cc:zmq_library",
}

CC_DEPS = [
    "@nav2_ros_common//:nav2_ros_common",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "opennav_dock_action_bt_node_library",
    srcs = ["src/dock_robot.cpp"],
    hdrs = [
        "include/opennav_docking_bt/dock_robot.hpp",
        "include/opennav_docking_bt/undock_robot.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/opennav_docking_bt",
        "test",
    ],
    local_defines = ros_local_defines() + [
        'BTCPP_LIBRARY_VERSION=\\"4.10.0\\"',
        "BT_PLUGIN_EXPORT",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "opennav_dock_action_bt_node",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":opennav_dock_action_bt_node_library"],
)

cc_library(
    name = "opennav_undock_action_bt_node_library",
    srcs = ["src/undock_robot.cpp"],
    hdrs = [
        "include/opennav_docking_bt/dock_robot.hpp",
        "include/opennav_docking_bt/undock_robot.hpp",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "include",
        "include/opennav_docking_bt",
        "test",
    ],
    local_defines = ros_local_defines() + [
        'BTCPP_LIBRARY_VERSION=\\"4.10.0\\"',
        "BT_PLUGIN_EXPORT",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "opennav_undock_action_bt_node",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":opennav_undock_action_bt_node_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":opennav_dock_action_bt_node",
        ":opennav_undock_action_bt_node",
    ],
)

ament_index(
    name = "ament_index",
    data = ["behavior_trees/application_example.xml"],
    libraries = [
        ":opennav_dock_action_bt_node",
        ":opennav_undock_action_bt_node",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@backward_ros//:ament_package",
        "@behaviortree_cpp//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav2_behavior_tree//:ament_package",
        "@nav2_common//:ament_package",
        "@nav2_core//:ament_package",
        "@nav2_msgs//:ament_package",
        "@nav2_ros_common//:ament_package",
        "@nav2_util//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "behaviortree_cpp",
        "geometry_msgs",
        "nav2_behavior_tree",
        "nav2_msgs",
        "nav2_ros_common",
    ],
    cmake_export_targets = False,
    headers = [
        "include/opennav_docking_bt/dock_robot.hpp",
        "include/opennav_docking_bt/undock_robot.hpp",
    ],
    libraries = [
        ":opennav_dock_action_bt_node",
        ":opennav_undock_action_bt_node",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@backward_ros//:ament_package",
        "@behaviortree_cpp//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav2_behavior_tree//:ament_package",
        "@nav2_common//:ament_package",
        "@nav2_core//:ament_package",
        "@nav2_msgs//:ament_package",
        "@nav2_ros_common//:ament_package",
        "@nav2_util//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
    ],
)
