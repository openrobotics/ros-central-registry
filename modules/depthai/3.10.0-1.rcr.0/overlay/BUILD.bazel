        "DEPTHAI_HAVE_OPENCV_SUPPORT",
        "DEPTHAI_TARGET_CORE",
        "DEPTHAI_TARGET_OPENCV",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "depthai-core",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":depthai-core_library"],
)

