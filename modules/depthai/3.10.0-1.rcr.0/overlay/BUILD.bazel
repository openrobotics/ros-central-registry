genrule(
    name = "gen_housing_coordinates",
    srcs = glob(["shared/depthai_boards/batch/housing/*.json"]),
    outs = ["src/HousingCoordinates.cpp"],
    cmd = """python3 -c '
import json, os, sys
out = sys.argv[1]
files = sorted(sys.argv[2:])
map_init = []
for f in files:
    name = os.path.splitext(os.path.basename(f))[0]
    with open(f) as fp:
        data = json.load(fp)
    pts = []
    for k, v in data.get("points", {}).items():
        x, y, z = v["x"], v["y"], v["z"]
        pts.append(f"            {{dai::HousingCoordinateSystem::{k}, {{{x}f, {y}f, {z}f}}}},")
    pts_str = "\\n".join(pts)
    map_init.append(f"    {{\\n        \\"{name}\\",\\n        {{\\n{pts_str}\\n        }}\\n    }},")
map_init_str = "\\n".join(map_init)
with open(out, "w") as fp:
    fp.write("// depthai\\n#include \\"depthai/common/HousingCoordinateSystem.hpp\\"\\n\\nnamespace dai {\\n\\nstatic const std::unordered_map<std::string, std::unordered_map<dai::HousingCoordinateSystem, std::array<float, 3>>> HOUSING_COORDINATES = {\\n" + map_init_str + "\\n};\\n\\nconst std::unordered_map<std::string, std::unordered_map<dai::HousingCoordinateSystem, std::array<float, 3>>>& getHousingCoordinates() {\\n    return HOUSING_COORDINATES;\\n}\\n\\n} // namespace dai\\n")
' $@ $(SRCS)""",
)

