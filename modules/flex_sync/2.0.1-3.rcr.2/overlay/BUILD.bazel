load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

cc_library(
    name = "flex_sync",
    hdrs = [
        "include/flex_sync/approximate_sync.hpp",
        "include/flex_sync/exact_sync.hpp",
        "include/flex_sync/live_sync.hpp",
        "include/flex_sync/msg_pack.hpp",
    ],
    includes = ["include"],
    deps = ["@rclcpp//:rclcpp_library"],
)

ament_package(
    name = "ament_package",
    cmake_export_has_library_target = True,
    cmake_export_include_directories = False,
    cmake_export_name = "flex_sync_export",
    headers = [
        "include/flex_sync/approximate_sync.hpp",
        "include/flex_sync/exact_sync.hpp",
        "include/flex_sync/live_sync.hpp",
        "include/flex_sync/msg_pack.hpp",
    ],
    include_prefix = "",
    package_xml = "package.xml",
    deps = [
        "@ament_clang_format//:ament_package",
        "@ament_cmake//:ament_package",
        "@ament_cmake_clang_format//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
