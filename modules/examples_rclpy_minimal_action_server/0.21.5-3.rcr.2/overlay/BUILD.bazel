load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

py_library(
    name = "examples_rclpy_minimal_action_server_library",
    srcs = [
        "examples_rclpy_minimal_action_server/__init__.py",
        "examples_rclpy_minimal_action_server/server.py",
        "examples_rclpy_minimal_action_server/server_defer.py",
        "examples_rclpy_minimal_action_server/server_not_composable.py",
        "examples_rclpy_minimal_action_server/server_queue_goals.py",
        "examples_rclpy_minimal_action_server/server_single_goal.py",
    ],
    imports = ["."],
    deps = [
        "@example_interfaces//:py",
        "@rclpy",
    ],
)

EXECUTABLES = {
    "server": "examples_rclpy_minimal_action_server/server.py",
    "server_defer": "examples_rclpy_minimal_action_server/server_defer.py",
    "server_not_composable": "examples_rclpy_minimal_action_server/server_not_composable.py",
    "server_queue_goals": "examples_rclpy_minimal_action_server/server_queue_goals.py",
    "server_single_goal": "examples_rclpy_minimal_action_server/server_single_goal.py",
}

[
    py_binary(
        name = name,
        srcs = [src],
        deps = [":examples_rclpy_minimal_action_server_library"],
    )
    for name, src in EXECUTABLES.items()
]

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = [
            "CHANGELOG.rst",
            "examples_rclpy_minimal_action_server/__init__.py",
            "examples_rclpy_minimal_action_server/server.py",
            "examples_rclpy_minimal_action_server/server_defer.py",
            "examples_rclpy_minimal_action_server/server_not_composable.py",
            "examples_rclpy_minimal_action_server/server_queue_goals.py",
            "examples_rclpy_minimal_action_server/server_single_goal.py",
            "package.xml",
            "resource/examples_rclpy_minimal_action_server",
            "setup.cfg",
            "setup.py",
            "test/test_copyright.py",
            "test/test_flake8.py",
            "test/test_pep257.py",
            "test/test_xmllint.py",
        ],
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    console_scripts = {
        name: "examples_rclpy_minimal_action_server.{0}:main".format(name)
        for name in EXECUTABLES.keys()
    },
    package_xml = "package.xml",
    python = [":examples_rclpy_minimal_action_server_library"],
    setup_cfg = "setup.cfg",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@example_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
