        "MOLA_PATCH_VERSION=0",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

write_file(
    name = "gen_mola_launcher_stub_cpp",
    out = "_gen/mola_launcher_stub.cpp",
