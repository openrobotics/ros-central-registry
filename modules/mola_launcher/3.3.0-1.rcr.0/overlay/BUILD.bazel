load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@mola_kernel//:mola_kernel_library",
    "@mrpt_core//:mrpt_core_library",
]

cc_library(
    name = "mola_launcher_library",
    srcs = [":gen_mola_launcher_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/mola_launcher",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "BUILDTIME_MOLA_MODULES_LIB_PATH=\\\"/usr/local/google/home/simmers/development/ros-central-registry/release/lyrical/2026-10-05/build/mola_launcher/lib/\\\"",
        "BUILDTIME_MOLA_MODULES_SHARED_PATH=\\\"modules\\\"",
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=3",
        "MOLA_PATCH_VERSION=0",
        "STD_FS_IS_EXPERIMENTAL=0",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_launcher",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mola_launcher_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "mola-cli",
    srcs = [":gen_mola_launcher_stub_cpp"] + glob(
