load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
)

DEPENDENCIES = {
}

CC_DEPS = [
    "@mola_kernel//:mola_kernel_library",
    "@mrpt_core//:mrpt_core_library",
    "@rosdistro//cc:cli11",
]

cc_library(
    name = "mola_launcher_library",
    srcs = [
        "src/MolaDLL_Loader.cpp",
        "src/MolaLauncherApp.cpp",
    ],
    hdrs = [
        "include/mola_launcher/MolaLauncherApp.h",
        "src/MolaDLL_Loader.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        "_gen/include",
        "include",
        "include/mola_launcher",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "BUILDTIME_MOLA_MODULES_LIB_PATH=\\\"lib/\\\"",
        "BUILDTIME_MOLA_MODULES_SHARED_PATH=\\\"modules\\\"",
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=3",
        "MOLA_PATCH_VERSION=0",
        "STD_FS_IS_EXPERIMENTAL=0",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mola_launcher",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":mola_launcher_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "mola-cli",
    srcs = ["apps/mola-cli.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "include",
        "include/mola_launcher",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=3",
        "MOLA_PATCH_VERSION=0",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":mola_launcher_library"],
)

cc_binary(
    name = "mola-dir",
    srcs = ["apps/mola-dir.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "include",
        "include/mola_launcher",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=3",
        "MOLA_PATCH_VERSION=0",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":mola_launcher_library"],
)

cc_binary(
    name = "mola-yaml-parser",
    srcs = [
        "apps/mola-yaml-parser.cpp",
        "include/mola_launcher/MolaLauncherApp.h",
        "src/MolaDLL_Loader.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        "_gen/include",
        "include",
        "include/mola_launcher",
        "src",
    ],
    local_defines = ros_local_defines() + [
        "MOLA_MAJOR_VERSION=3",
        "MOLA_MINOR_VERSION=3",
        "MOLA_PATCH_VERSION=0",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

ament_index(
    name = "ament_index",
    lib_data = [
        ":mola-cli",
    ],
    libraries = [
        ":mola_launcher",
    ],
    package_xml = "package.xml",
    sonames = {
        "mola_launcher": [
            "libmola_launcher.so.3.3",
            "libmola_launcher.so.3.3.0",
        ],
    },
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pep257//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@mola_kernel//:ament_package",
        "@mrpt_core//:ament_package",
        "@ros_environment//:ament_package",
    ],
)

ament_package(
    cmake_export_dependencies = False,
    cmake_export_include_directories = False,
    cmake_export_libraries = False,
    cmake_export_targets = False,
    headers = ["include/mola_launcher/MolaLauncherApp.h"],
    include_prefix = "",
    libraries = [
        ":mola_launcher",
    ],
    package_xml = "package.xml",
    programs = [
        ":mola-cli",
        ":mola-dir",
        ":mola-yaml-parser",
    ],
    sonames = {
        "mola_launcher": [
            "libmola_launcher.so.3.3",
            "libmola_launcher.so.3.3.0",
        ],
    },
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pep257//:ament_package",
        "@ament_cmake_xmllint//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@mola_kernel//:ament_package",
        "@mrpt_core//:ament_package",
        "@ros_environment//:ament_package",
    ],
)
