load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_test")

# Tests run with cwd = <runfiles>/_main, but this repository's own test data
# lives under <runfiles>/<canonical repo name>/ when it is an external module.
REPO_RUNFILES_PREFIX = "../%s/" % (repo_name() or "_main")

package(
    default_applicable_licenses = ["//:package_license"],
    default_visibility = ["//visibility:public"],
)

DEPENDENCIES = {
    "@action_msgs//:cc_shared": "@action_msgs//:cc",
    "@builtin_interfaces//:cc_shared": "@builtin_interfaces//:cc",
    "@control_msgs//:cc_shared": "@control_msgs//:cc",
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@lifecycle_msgs//:cc_shared": "@lifecycle_msgs//:cc",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@std_srvs//:cc_shared": "@std_srvs//:cc",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
    "@trajectory_msgs//:cc_shared": "@trajectory_msgs//:cc",
    "@ur_dashboard_msgs//:cc_shared": "@ur_dashboard_msgs//:cc",
    "@ur_msgs//:cc_shared": "@ur_msgs//:cc",
}

CC_DEPS = [
    "@angles//:angles",
    "@controller_interface//:controller_interface_library",
    "@controller_manager//:controller_manager_library",
    "@generate_parameter_library//:generate_parameter_library",
    "@hardware_interface//:hardware_interface_library",
    "@joint_trajectory_controller//:joint_trajectory_controller_library",
    "@rosdistro//cc:eigen",
    "@rosdistro//cc:fmt",
]

cc_test(
    name = "test_load_force_mode_controller",
    srcs = ["test_load_force_mode_controller.cpp"] + [] + [
        "//:force_mode_controller_parameters_gen",
        "//:freedrive_mode_controller_parameters_gen",
        "//:friction_model_controller_parameters_gen",
        "//:gpio_controller_parameters_gen",
        "//:gravity_update_controller_parameters_gen",
        "//:passthrough_trajectory_controller_parameters_gen",
        "//:speed_scaling_state_broadcaster_parameters_gen",
        "//:tool_contact_controller_parameters_gen",
        "//:twist_controller_parameters_gen",
        "//:ur_configuration_controller_parameters_gen",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "force_mode_controller_params.yaml",
        "freedrive_mode_controller_params.yaml",
        "friction_model_controller_params.yaml",
        "twist_controller_params.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        'TEST_FILES_DIRECTORY=\\"%stest\\"' % REPO_RUNFILES_PREFIX,
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        "//:ur_controllers_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ] + ["//:_test_root_headers"],
)

