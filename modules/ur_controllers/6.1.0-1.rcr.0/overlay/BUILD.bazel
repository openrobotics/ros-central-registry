    hdrs = [
        "include/ur_controllers/force_mode_controller.hpp",
        "include/ur_controllers/freedrive_mode_controller.hpp",
        "include/ur_controllers/friction_model_controller.hpp",
        "include/ur_controllers/gpio_controller.hpp",
        "include/ur_controllers/gravity_update_controller.hpp",
        "include/ur_controllers/passthrough_trajectory_controller.hpp",
        "include/ur_controllers/speed_scaling_state_broadcaster.hpp",
        "include/ur_controllers/tool_contact_controller.hpp",
        "include/ur_controllers/twist_controller.hpp",
        "include/ur_controllers/ur_configuration_controller.hpp",
    ] + [
        ":force_mode_controller_parameters_gen",
        ":freedrive_mode_controller_parameters_gen",
        ":friction_model_controller_parameters_gen",
        ":gpio_controller_parameters_gen",
        ":gravity_update_controller_parameters_gen",
        ":passthrough_trajectory_controller_parameters_gen",
        ":speed_scaling_state_broadcaster_parameters_gen",
        ":tool_contact_controller_parameters_gen",
        ":twist_controller_parameters_gen",
        ":ur_configuration_controller_parameters_gen",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "_gen/include",
        "_gen/include/ur_controllers",
        "include",
        "include/ur_controllers",
    ],
    local_defines = ros_local_defines() + [
        "PLUGINLIB__DISABLE_BOOST_FUNCTIONS",
        'TEST_FILES_DIRECTORY=\\"%stest\\"' % REPO_RUNFILES_PREFIX,
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "ur_controllers",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":ur_controllers_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":ur_controllers"],
)

