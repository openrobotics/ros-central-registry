load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
)

ament_index(
    name = "ament_index",
    data = [
        "default_configs/chomp_planning.yaml",
        "default_configs/ompl_defaults.yaml",
        "default_configs/ompl_planning.yaml",
        "default_configs/pilz_industrial_motion_planner_planning.yaml",
        "default_configs/stomp_planning.yaml",
    ],
    package_xml = "package.xml",
)

py_library(
    name = "moveit_configs_utils",
    srcs = [
        "moveit_configs_utils/__init__.py",
        "moveit_configs_utils/launch_utils.py",
        "moveit_configs_utils/launches.py",
        "moveit_configs_utils/moveit_configs_builder.py",
        "moveit_configs_utils/substitutions/__init__.py",
        "moveit_configs_utils/substitutions/xacro.py",
    ],
    data = [":ament_index"],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@launch",
        "@launch_param_builder",
        "@launch_ros",
        "@srdfdom//:srdfdom_py",
    ],
)

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    python = [":moveit_configs_utils"],
    deps = [
        ":ament_index",
        "@ament_index_python//:ament_package",
        "@launch//:ament_package",
        "@launch_param_builder//:ament_package",
        "@launch_ros//:ament_package",
        "@rosdistro//:ament_package",
        "@srdfdom//:ament_package",
    ],
)
