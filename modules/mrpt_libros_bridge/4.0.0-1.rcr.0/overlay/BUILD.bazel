load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

DEPENDENCIES = {
    "@geometry_msgs//:cc_shared": "@geometry_msgs//:cc",
    "@gps_msgs//:cc_shared": "@gps_msgs//:cc",
    "@mrpt_maps//:mrpt_maps": "@mrpt_maps//:mrpt_maps_library",
    "@mrpt_obs//:mrpt_obs": "@mrpt_obs//:mrpt_obs_library",
    "@nav_msgs//:cc_shared": "@nav_msgs//:cc",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosdistro//cc:console_bridge": "@rosdistro//cc:console_bridge_library",
    "@rosdistro//cc:orocos-kdl": "@rosdistro//cc:orocos-kdl_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@sensor_msgs//:cc_shared": "@sensor_msgs//:cc",
    "@std_msgs//:cc_shared": "@std_msgs//:cc",
    "@stereo_msgs//:cc_shared": "@stereo_msgs//:cc",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_msgs//:cc_shared": "@tf2_msgs//:cc",
}

CC_DEPS = [
    "@rosdistro//cc:eigen",
]

cc_library(
    name = "mrpt_libros_bridge_library",
    srcs = [
        "src/gps.cpp",
        "src/image.cpp",
        "src/imu.cpp",
        "src/laser_scan.cpp",
        "src/map.cpp",
        "src/point_cloud2.cpp",
        "src/pose.cpp",
        "src/range.cpp",
        "src/ros_to_mrpt_obs.cpp",
        "src/rosbag2_to_mrpt.cpp",
        "src/stereo_image.cpp",
        "src/time.cpp",
    ],
    hdrs = [
        "include/mrpt/ros2bridge/gps.h",
        "include/mrpt/ros2bridge/image.h",
        "include/mrpt/ros2bridge/imu.h",
        "include/mrpt/ros2bridge/laser_scan.h",
        "include/mrpt/ros2bridge/map.h",
        "include/mrpt/ros2bridge/point_cloud2.h",
        "include/mrpt/ros2bridge/pose.h",
        "include/mrpt/ros2bridge/range.h",
        "include/mrpt/ros2bridge/ros_to_mrpt_obs.h",
        "include/mrpt/ros2bridge/rosbag2_to_mrpt.h",
        "include/mrpt/ros2bridge/stereo_image.h",
        "include/mrpt/ros2bridge/time.h",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        ".",
        "include",
    ],
    local_defines = ros_local_defines() + [
        "CV_BRIDGE_VERSION=0x000",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "mrpt_libros_bridge",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = ["//:__subpackages__"],
    deps = [":mrpt_libros_bridge_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":mrpt_libros_bridge"],
)

ament_index(
    name = "ament_index",
    libraries = [
        ":mrpt_libros_bridge",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@geometry_msgs//:ament_package",
        "@gps_msgs//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_obs//:ament_package",
        "@nav_msgs//:ament_package",
        "@ros_environment//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@stereo_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_msgs//:ament_package",
    ],
)

cc_test(
    name = "test_mrpt_libros_bridge",
    srcs = [
        "test/gps_unittest.cpp",
        "test/image_unittest.cpp",
        "test/map_unittest.cpp",
        "test/pointcloud2_unittest.cpp",
        "test/pose_unittest.cpp",
        "test/time_unittest.cpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [
        ":ament_index",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
    ],
    local_defines = ros_local_defines() + [
        "GTEST_HAS_PTHREAD=1",
        "_FILE_OFFSET_BITS=64",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":mrpt_libros_bridge_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "geometry_msgs",
        "sensor_msgs",
        "gps_msgs",
        "nav_msgs",
        "stereo_msgs",
        "std_msgs",
        "tf2",
        "tf2_geometry_msgs",
        "rosbag2_cpp",
        "mrpt_maps",
        "mrpt_obs",
    ],
    cmake_export_has_library_target = True,
    cmake_export_libraries = False,
    cmake_export_name = "export_mrpt_libros_bridge",
    headers = [
        "include/mrpt/ros2bridge/gps.h",
        "include/mrpt/ros2bridge/image.h",
        "include/mrpt/ros2bridge/imu.h",
        "include/mrpt/ros2bridge/laser_scan.h",
        "include/mrpt/ros2bridge/map.h",
        "include/mrpt/ros2bridge/point_cloud2.h",
        "include/mrpt/ros2bridge/pose.h",
        "include/mrpt/ros2bridge/range.h",
        "include/mrpt/ros2bridge/ros_to_mrpt_obs.h",
        "include/mrpt/ros2bridge/rosbag2_to_mrpt.h",
        "include/mrpt/ros2bridge/stereo_image.h",
        "include/mrpt/ros2bridge/time.h",
    ],
    include_prefix = "",
    libraries = [
        ":mrpt_libros_bridge",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@geometry_msgs//:ament_package",
        "@gps_msgs//:ament_package",
        "@mrpt_maps//:ament_package",
        "@mrpt_obs//:ament_package",
        "@nav_msgs//:ament_package",
        "@ros_environment//:ament_package",
        "@rosbag2_cpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@stereo_msgs//:ament_package",
        "@tf2//:ament_package",
        "@tf2_geometry_msgs//:ament_package",
        "@tf2_msgs//:ament_package",
    ],
)
