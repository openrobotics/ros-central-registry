load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "boost_geometry_util_library",
    srcs = [":gen_boost_geometry_util_stub_cpp"],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.ipp",
            "**/*.inl",
            "**/*.txx",
            "**/*.tcc",
        ],
        allow_empty = True,
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/boost_geometry_util",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "boost_geometry_util",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":boost_geometry_util_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":boost_geometry_util"],
)

write_file(
    name = "gen_boost_geometry_util_stub_cpp",
    out = "_gen/boost_geometry_util_stub.cpp",
    content = ["int main() { return 0; }\n"],
)

write_file(
    name = "gen_cmake_10",
    out = "_gen/share/boost_geometry_util/cmake/ament_cmake_export_include_directories-extras.cmake",
    content = ["# generated from ament_cmake_export_include_directories/cmake/ament_cmake_export_include_directories-extras.cmake.in\n\nset(_exported_include_dirs \"${boost_geometry_util_DIR}/../../../include/boost_geometry_util\")\n\n# append include directories to boost_geometry_util_INCLUDE_DIRS\n# warn about not existing paths\nif(NOT _exported_include_dirs STREQUAL \"\")\n  find_package(ament_cmake_core QUIET REQUIRED)\n  foreach(_exported_include_dir ${_exported_include_dirs})\n    if(NOT IS_DIRECTORY \"${_exported_include_dir}\")\n      message(WARNING \"Package 'boost_geometry_util' exports the include directory '${_exported_include_dir}' which doesn't exist\")\n    endif()\n    normalize_path(_exported_include_dir \"${_exported_include_dir}\")\n    list(APPEND boost_geometry_util_INCLUDE_DIRS \"${_exported_include_dir}\")\n  endforeach()\nendif()\n"],
)

pkg_files(
    name = "pkg_files_inc_0",
    srcs = ["include/boost_geometry_util/geometries/box.hpp"],
    prefix = "include/boost_geometry_util/boost_geometry_util/geometries",
)

pkg_files(
    name = "pkg_files_inc_1",
    srcs = ["include/boost_geometry_util/geometries/geometries.hpp"],
    prefix = "include/boost_geometry_util/boost_geometry_util/geometries",
)

pkg_files(
    name = "pkg_files_inc_2",
    srcs = ["include/boost_geometry_util/geometries/linestring.hpp"],
    prefix = "include/boost_geometry_util/boost_geometry_util/geometries",
)

pkg_files(
    name = "pkg_files_inc_3",
    srcs = ["include/boost_geometry_util/geometries/point.hpp"],
    prefix = "include/boost_geometry_util/boost_geometry_util/geometries",
)

pkg_files(
    name = "pkg_files_inc_4",
    srcs = ["include/boost_geometry_util/geometries/polygon.hpp"],
    prefix = "include/boost_geometry_util/boost_geometry_util/geometries",
)

pkg_files(
    name = "pkg_files_inc_5",
    srcs = ["include/boost_geometry_util/geometries/box.hpp"],
    prefix = "include/boost_geometry_util/geometries",
)

pkg_files(
    name = "pkg_files_inc_6",
    srcs = ["include/boost_geometry_util/geometries/geometries.hpp"],
    prefix = "include/boost_geometry_util/geometries",
)

pkg_files(
    name = "pkg_files_inc_7",
    srcs = ["include/boost_geometry_util/geometries/linestring.hpp"],
    prefix = "include/boost_geometry_util/geometries",
)

pkg_files(
    name = "pkg_files_inc_8",
    srcs = ["include/boost_geometry_util/geometries/point.hpp"],
    prefix = "include/boost_geometry_util/geometries",
)

pkg_files(
    name = "pkg_files_inc_9",
    srcs = ["include/boost_geometry_util/geometries/polygon.hpp"],
    prefix = "include/boost_geometry_util/geometries",
)

pkg_files(
    name = "pkg_files_cmake_10",
    srcs = [":gen_cmake_10"],
    prefix = "share/boost_geometry_util/cmake",
)

ament_index(
    name = "ament_index",
    libraries = [":boost_geometry_util"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@geometry_msgs//:ament_package",
        "@ouxt_common//:ament_package",
        "@rclcpp//:ament_package",
    ],
)

cc_test(
    name = "test_boost_geometry_util",
    srcs = [":gen_boost_geometry_util_stub_cpp"],
    copts = [
        "-std=c++20",
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/boost_geometry_util",
    ],
    local_defines = ros_local_defines() + ["GTEST_HAS_PTHREAD=1"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":boost_geometry_util_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "geometry_msgs",
    ],
    cmake_export_include_directories = False,
    cmake_export_targets = False,
    install = [
        ":pkg_files_inc_0",
        ":pkg_files_inc_1",
        ":pkg_files_inc_2",
        ":pkg_files_inc_3",
        ":pkg_files_inc_4",
        ":pkg_files_inc_5",
        ":pkg_files_inc_6",
        ":pkg_files_inc_7",
        ":pkg_files_inc_8",
        ":pkg_files_inc_9",
        ":pkg_files_cmake_10",
    ],
    libraries = [":boost_geometry_util"],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@geometry_msgs//:ament_package",
        "@ouxt_common//:ament_package",
        "@rclcpp//:ament_package",
    ],
)
