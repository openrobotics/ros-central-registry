load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":package_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "package_license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

CC_DEPS = [
    "@geometry_msgs//:cc",
    "@rclcpp//:node_wrapper",
    "@rclcpp//:type_adapter",
]

cc_library(
    name = "boost_geometry_util_library",
    srcs = [
        "src/geometries/box.cpp",
        "src/geometries/linestring.cpp",
        "src/geometries/point.cpp",
        "src/geometries/polygon.cpp",
    ],
    hdrs = [
        "include/boost_geometry_util/geometries/box.hpp",
        "include/boost_geometry_util/geometries/geometries.hpp",
        "include/boost_geometry_util/geometries/linestring.hpp",
        "include/boost_geometry_util/geometries/point.hpp",
        "include/boost_geometry_util/geometries/polygon.hpp",
    ],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    includes = [
        ".",
        "include",
        "include/boost_geometry_util",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "boost_geometry_util",
    dynamic_deps = DEPENDENCIES.keys(),
    user_link_flags = [
        "-Wl,--allow-shlib-undefined",
        "-Wl,--unresolved-symbols=ignore-all",
    ],
    deps = [":boost_geometry_util_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [":boost_geometry_util"],
)

register_ament_files(
    name = "ament_files_0",
    files = [
        "include/boost_geometry_util/geometries/box.hpp",
    ],
    prefix = "include/boost_geometry_util/boost_geometry_util/geometries",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_1",
    files = [
        "include/boost_geometry_util/geometries/geometries.hpp",
    ],
    prefix = "include/boost_geometry_util/boost_geometry_util/geometries",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_2",
    files = [
        "include/boost_geometry_util/geometries/linestring.hpp",
    ],
    prefix = "include/boost_geometry_util/boost_geometry_util/geometries",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_3",
    files = [
        "include/boost_geometry_util/geometries/point.hpp",
    ],
    prefix = "include/boost_geometry_util/boost_geometry_util/geometries",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_4",
    files = [
        "include/boost_geometry_util/geometries/polygon.hpp",
    ],
    prefix = "include/boost_geometry_util/boost_geometry_util/geometries",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_5",
    files = [
        "include/boost_geometry_util/geometries/box.hpp",
    ],
    prefix = "include/boost_geometry_util/geometries",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_6",
    files = [
        "include/boost_geometry_util/geometries/geometries.hpp",
    ],
    prefix = "include/boost_geometry_util/geometries",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_7",
    files = [
        "include/boost_geometry_util/geometries/linestring.hpp",
    ],
    prefix = "include/boost_geometry_util/geometries",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_8",
    files = [
        "include/boost_geometry_util/geometries/point.hpp",
    ],
    prefix = "include/boost_geometry_util/geometries",
    strip_prefix = "*",
)

register_ament_files(
    name = "ament_files_9",
    files = [
        "include/boost_geometry_util/geometries/polygon.hpp",
    ],
    prefix = "include/boost_geometry_util/geometries",
    strip_prefix = "*",
)

ament_index(
    name = "ament_index",
    libraries = [
        ":boost_geometry_util",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@geometry_msgs//:ament_package",
        "@ouxt_common//:ament_package",
        "@rclcpp//:ament_package",
    ],
)

cc_test(
    name = "test_boost_geometry_util",
    srcs = ["test/src/test.cpp"],
    copts = ["-Wno-missing-template-arg-list-after-template-kw"],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/boost_geometry_util",
    ],
    local_defines = ros_local_defines() + ["GTEST_HAS_PTHREAD=1"],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":boost_geometry_util_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

ament_package(
    cmake_export_dependencies_list = [
        "rclcpp",
        "geometry_msgs",
    ],
    cmake_export_include_directories = False,
    cmake_export_targets = False,
    headers = [
        ":ament_files_0",
        ":ament_files_1",
        ":ament_files_2",
        ":ament_files_3",
        ":ament_files_4",
        ":ament_files_5",
        ":ament_files_6",
        ":ament_files_7",
        ":ament_files_8",
        ":ament_files_9",
    ],
    include_prefix = "",
    libraries = [
        ":boost_geometry_util",
    ],
    package_xml = "package.xml",
    deps = [":ament_index"] + [
        "@ament_cmake//:ament_package",
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@geometry_msgs//:ament_package",
        "@ouxt_common//:ament_package",
        "@rclcpp//:ament_package",
    ],
)
