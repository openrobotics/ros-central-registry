    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "WITH_OCTOMAP_MSGS",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":rtabmap_odom_library",
        ":rtabmap_odom_plugins_library",
    ],
)

ament_index(
    name = "ament_index",
    components = [":rtabmap_odom_plugins_components"],
    libraries = [
        ":rtabmap_odom",
        ":rtabmap_odom_plugins",
    ],
    package_xml = "package.xml",
    deps = ["@rtabmap_sync//:ament_index"],
)

