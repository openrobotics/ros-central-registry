cc_library(
    name = "rtabmap_odom_library",
    srcs = ["src/OdometryROS.cpp"],
    hdrs = [
        "include/rtabmap_odom/OdometryROS.h",
        "include/rtabmap_odom/icp_odometry.hpp",
        "include/rtabmap_odom/rgbd_odometry.hpp",
        "include/rtabmap_odom/stereo_odometry.hpp",
        "include/rtabmap_odom/visibility.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/rtabmap_odom",
        "test",
    ],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "WITH_OCTOMAP_MSGS",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS,
)

cc_shared_library(
    name = "rtabmap_odom",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":rtabmap_odom_library"],
)

cc_library(
    name = "rtabmap_odom_plugins_library",
    srcs = [
        "src/nodelets/icp_odometry.cpp",
        "src/nodelets/rgbd_odometry.cpp",
        "src/nodelets/stereo_odometry.cpp",
    ],
    hdrs = [
        "include/rtabmap_odom/OdometryROS.h",
        "include/rtabmap_odom/icp_odometry.hpp",
        "include/rtabmap_odom/rgbd_odometry.hpp",
        "include/rtabmap_odom/stereo_odometry.hpp",
        "include/rtabmap_odom/visibility.h",
    ],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    includes = [
        ".",
        "include",
        "include/rtabmap_odom",
        "test",
    ],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "WITH_OCTOMAP_MSGS",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [":rtabmap_odom_library"],
)

cc_shared_library(
    name = "rtabmap_odom_plugins",
    dynamic_deps = DEPENDENCIES.keys(),
    deps = [":rtabmap_odom_plugins_library"],
)

rclcpp_components_register_nodes(
    name = "rtabmap_odom_plugins_components",
    component = ":rtabmap_odom_plugins",
    plugins = [
        "rtabmap_odom::RGBDOdometry",
        "rtabmap_odom::StereoOdometry",
        "rtabmap_odom::ICPOdometry",
    ],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys(),
)

cc_binary(
    name = "icp_odometry",
    srcs = ["src/ICPOdometryNode.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = [":ament_index"],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = [
        ".",
        "include",
        "include/rtabmap_odom",
        "test",
    ],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "WITH_OCTOMAP_MSGS",
        "kiss_fft_scalar=double",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":rtabmap_odom_library",
        ":rtabmap_odom_plugins_library",
    ],
)

cc_binary(
    name = "rgbd_odometry",
    srcs = ["src/RGBDOdometryNode.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
