cc_library(
    name = "test_helpers",
    testonly = True,
    textual_hdrs = glob(["*.hpp"]),
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_icp_odometry",
    srcs = ["test_icp_odometry.cpp"],
    copts = [
        "-Wno-missing-template-arg-list-after-template-kw",
    ],
    data = ["//:ament_index"] + [
        "data/README.md",
        "data/lidar/ouster_half_turn/metadata.yaml",
        "data/lidar/ouster_half_turn/ouster_half_turn.mcap",
        "data/rgbd/calib/154.yaml",
        "data/rgbd/calib/17.yaml",
        "data/rgbd/depth/154.png",
        "data/rgbd/depth/17.png",
        "data/rgbd/rgb/154.jpg",
        "data/rgbd/rgb/17.jpg",
        "data/stereo/raw/left/420.jpg",
        "data/stereo/raw/left/425.jpg",
        "data/stereo/raw/right/420.jpg",
        "data/stereo/raw/right/425.jpg",
        "data/stereo/raw/stereo_left.yaml",
        "data/stereo/raw/stereo_pose.yaml",
        "data/stereo/raw/stereo_right.yaml",
        "data/stereo/rect/left/50.jpg",
        "data/stereo/rect/left/60.jpg",
        "data/stereo/rect/right/50.jpg",
        "data/stereo/rect/right/60.jpg",
        "data/stereo/rect/stereo_left.yaml",
        "data/stereo/rect/stereo_right.yaml",
    ],
    dynamic_deps = ["//:transitive_dynamic_deps"],
    includes = ["."],
    local_defines = ros_local_defines() + [
        "GLAD_API_CALL_EXPORT",
        "GTEST_LINKED_AS_SHARED_LIBRARY=1",
        'RTABMAP_ODOM_TEST_DATA_ROOT=\\"test/data\\"',
        "WITH_OCTOMAP_MSGS",
        "_FILE_OFFSET_BITS=64",
        "kiss_fft_scalar=double",
    ],
    # xfail: gtest failures under Bazel: IcpOdometryTest.deskewing_is_what_lets_a_half_turn_pair_register
    tags = [
        "manual",
        "xfail",
    ],
    deps = DEPENDENCIES.values() + CC_DEPS + [
        ":test_helpers",
        "//:rtabmap_odom_library",
        "//:rtabmap_odom_plugins_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

